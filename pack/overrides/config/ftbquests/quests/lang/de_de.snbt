	]
	quest.42000000001D047F.title: "Terminal"
	quest.42000000001D0480.quest_desc: [
		"Fertige direkt aus dem, was das Netzwerk lagert.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0480.title: "Fertigungsterminal (Netzwerk)"
	quest.42000000001D0481.quest_desc: [
		"Schreibt das Rezept, dem ein Muster folgen wird.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0481.title: "Musterkodierung"
	quest.42000000001D0482.quest_desc: [
		"Zeigt jedes Muster, das das Netzwerk gerade kennt.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0482.title: "Musterzugriff"
	quest.42000000001D0483.quest_desc: [
		"Liefert Muster an Maschinen, die von selbst fertigen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0483.title: "Musteranbieter (Netzwerk)"
	quest.42000000001D0484.quest_desc: [
		"Setzt gefertigte Gegenstände nach einem gespeicherten Muster zusammen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0484.title: "Molekularassembler (Netzwerk)"
	quest.42000000001D0485.quest_desc: [
		"Ein Speicherblock, den das Netzwerk beim Fertigen nutzt.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0485.title: "Fertigungseinheit (Netzwerk)"
	quest.42000000001D0486.quest_desc: [
		"Beschleunigt einen Fertigungsauftrag, der durch das Netzwerk läuft.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0486.title: "Fertigungsbeschleuniger"
	quest.42000000001D0487.quest_desc: [
		"Gibt einer Fertigungseinheit Fertigungsspeicher dazu.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0487.title: "1k-Fertigungsspeicher"
	quest.42000000001D0488.quest_desc: [
		"Mehr Fertigungsspeicher für größere Aufträge.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0488.title: "4k-Fertigungsspeicher"
	quest.42000000001D0489.quest_desc: [
		"Ein ernsthafter Brocken Fertigungsspeicher.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0489.title: "16k-Fertigungsspeicher"
	quest.42000000001D048A.quest_desc: [
		"Genug Fertigungsspeicher für die größten Aufträge des Netzwerks.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D048A.title: "64k-Fertigungsspeicher"
	quest.42000000001D048B.quest_desc: [
		"Fertigungsspeicher in Archivgüte, selten nötig, aber da, wenn er es ist.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D048B.title: "256k-Fertigungsspeicher"
	quest.42000000001D048C.quest_desc: [
		"Gibt Redstone, sobald ein verfolgter Gegenstand eine Menge überschreitet.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D048C.title: "Füllstandsemitter (Netzwerk)"
	quest.42000000001D048D.quest_desc: [
		"Setzt Blöcke aus dem Netzwerk in die Welt.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D048D.title: "Formungsebene (Netzwerk)"
	quest.42000000001D048E.quest_desc: [
		"Bricht Blöcke und zieht, was fällt, ins Netzwerk.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D048E.title: "Vernichtungsebene (Netzwerk)"
	quest.42000000001D048F.quest_desc: [
		"Trägt einen Netzwerkkanal über eine Lücke in der Kabelstrecke.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D048F.title: "P2P-Tunnel"
	quest.42000000001D0490.quest_desc: [
		"Faltet ein kleines Stück Raum in eine tragbare Zelle.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0490.title: "Raum 2"
	quest.42000000001D0491.quest_desc: [
		"Durchsuche den Speicher des Netzwerks von überall, mit einem Verstärker in der Nähe.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0491.title: "Drahtlosterminal (Netzwerk)"
	quest.42000000001D0492.quest_desc: [
		"Fertige aus dem Netzwerk, ohne zu einem Terminal zurückzulaufen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0492.title: "Drahtlosfertigung"
	quest.42000000001D0493.quest_desc: [
		"Feuert Materiekugeln; lade es auf, bevor du es brauchst.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0493.title: "Materiekanone"
	quest.42000000001D0494.quest_desc: [
		"Ein klarer Block für Controllerhüllen und Kabelstrecken.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0494.title: "Quarzglas"
	quest.42000000001D0495.quest_desc: [
		"Glas, das von selbst leuchtet, keine Fackel nötig.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0495.title: "Lebhafter Quarz"
	quest.42000000001D0496.quest_desc: [
		"Ein fester Speicherblock, vier Kristalle zu einem verdichtet.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0496.title: "Fluixblock"
	quest.42000000001D0497.quest_desc: [
		"Teilt eine Speicherzelle in mehrere kleinere Pools.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0497.title: "Speicherzellenwerkbank"
	quest.42000000001E0498.quest_desc: [
		"Ton und Knochenmehl, ein Schritt zu Porzellanwerkzeugen.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Tonklumpen + Knochenmehl, formlos. Ton kommt aus dem Spannungsfass."
	]
	quest.42000000001E0498.title: "Porzellan-Ton (Leerenwerk)"
	quest.42000000001E0499.quest_desc: [
		"Ein leichterer Eimer, schonender für ein frühes Kiesbudget.",
		"So: forme Porzellan-Ton zu einem ungebrannten Eimer, dann schmilz ihn."
	]
	quest.42000000001E0499.title: "Porcelain Bucket"
	quest.42000000001E049A.quest_desc: [
		"Schmilzt Blöcke über einem Feuer zu Flüssigkeit.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E049A.title: "Porzellan-Schmelztiegel (Leerenwerk)"
	quest.42000000001E049B.quest_desc: [
		"Das erste Siebnetz; langsam, aber es funktioniert.",
		"So: neun Schnur im 3x3. Der Stand der Splittsänger verkauft das Fadennetz (Schnur) des Leerenwebstuhls, das genauso siebt."
	]
	quest.42000000001E049B.title: "Schnurnetz (Leerenwerk)"
	quest.42000000001E049C.quest_desc: [
		"Siebt schneller als Schnur, die Verbesserung lohnt sich.",
		"So: vier Feuerstein und fünf Schnur im Schachbrettmuster. Feuerstein kommt aus Kies, oder Faden + Kies."
	]
	quest.42000000001E049C.title: "Feuersteinnetz (Leerenwerk)"
	quest.42000000001E049D.quest_desc: [
		"Ein solides mittleres Netz für stetiges Sieben.",
		"So: vier Eisenbarren und fünf Schnur im Schachbrettmuster. Kein Stand verkauft es."
	]
	quest.42000000001E049D.title: "Eisennetz (Voidcraft)"
	quest.42000000001E049E.quest_desc: [
		"Bringt seltenere Funde als Eisen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E049E.title: "Goldnetz (Voidcraft)"
	quest.42000000001E049F.quest_desc: [
		"Siebt schnell genug, um eine Trichterreihe gefüttert zu halten.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E049F.title: "Diamantnetz (Voidcraft)"
	quest.42000000001E04A0.quest_desc: [
		"Das beste Netz, das ein Sieb je halten wird.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04A0.title: "Netheritnetz (Voidcraft)"
	quest.42000000001E04A1.quest_desc: [
		"Aus Schnur gesponnen, die eigene Faser des Webstuhls.",
		"So: vier Schnüre → zwei Garn. Spannungsfass: Schnur + Perle. Vier Webflusen."
	]
	quest.42000000001E04A1.title: "Leerengarnvorrat"
	quest.42000000001E04A2.quest_desc: [
		"Das weiche Tor des Webstuhls: Pfosten, Pressen und Controller wollen alle einen.",
		"So: Leerengarn-Ring um einen Schleimball."
	]
	quest.42000000001E04A2.title: "Bindungsknotenvorrat"
	quest.42000000001E04A3.quest_desc: [
		"Die Leerenwebstuhl-Fassung des einfachen Siebnetzes.",
		"So: Schnur um Garn. Der Stand der Splittsänger verkauft eins."
	]
	quest.42000000001E04A3.title: "Fadennetz (Schnur)"
	quest.42000000001E04A4.quest_desc: [
		"Ein Leerenwebstuhl-Netz, eine Stufe über schlichter Schnur.",
		"So: Feuerstein um ein Fadennetz (Schnur)."
	]
	quest.42000000001E04A4.title: "Fadennetz (Feuerstein)"
	quest.42000000001E04A5.quest_desc: [
		"Ein Leerenwebstuhl-Netz für stetigen Ausstoß.",
		"So: Eisen um ein Fadennetz (Feuerstein). Hier beginnt das Strangfilament."
	]
	quest.42000000001E04A5.title: "Fadennetz (Eisen)"
	quest.42000000001E04A6.quest_desc: [
		"Bricht Grus eine Stufe feiner: Bruchstein zu Kies, Kies zu Sand, Sand zu Staub.",
		"So: Bruchstein + Stöcke. Brich Grus zu Kies, Sand und Staub."
	]
	quest.42000000001E04A6.title: "Spindelhammer (Voidcraft)"
	quest.42000000001E04A7.quest_desc: [
		"Streift Laub für Setzlinge und Seidenraupen ab.",
		"So: vier Stöcke. Der Stand der Splittsänger verkauft einen."
	]
	quest.42000000001E04A7.title: "Spindelkrücke"
	quest.42000000001E04A8.quest_desc: [
		"Der Siebrahmen des Webstuhls: spann ein Netz darauf und füttere ihn mit Grus.",
		"So: Bretter um einen Bindungsknoten. Spann ein Netz, füttere Grus mit einem Trichter, setz ihn auf einen Trichter."
	]
	quest.42000000001E04A8.title: "Webrahmen"
	quest.42000000001E04A9.quest_desc: [
		"Wasser und Erde werden zu Ton; Schnur und eine Perle werden zu Garn.",
		"So: Bretter, Schnur und Leerengarn. Gieß Wasser (Eimer kommt zurück), gib Erde dazu → Ton."
	]
	quest.42000000001E04A9.title: "Spannungsfass (Voidcraft)"
	quest.42000000001E04AA.quest_desc: [
		"Neun Erdblöcke zu einem gefaltet, für den Weg nach oben.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04AA.title: "Compressed Dirt"
	quest.42000000001E04AB.quest_desc: [
		"Neun Bruchstein fest gepackt, billig und endlos.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04AB.title: "Komprimierter Bruchstein (Voidcraft)"
	quest.42000000001E04AC.quest_desc: [
		"Neun Kies verdichtet; ein komprimiertes Sieb nimmt ihn im Ganzen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04AC.title: "Compressed Gravel"
	quest.42000000001E04AD.quest_desc: [
		"Neun Sandblöcke zu einem gepresst, zum Schleppen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04AD.title: "Compressed Sand"
	quest.42000000001E04AE.quest_desc: [
		"Neun Staubblöcke gepresst, aus demselben Grund.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04AE.title: "Compressed Dust"
	quest.42000000001E04AF.quest_desc: [
		"Netherstein verdichtet, für ein leichteres Inventar.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04AF.title: "Compressed Netherrack"
	quest.42000000001E04B0.quest_desc: [
		"Endstein verdichtet, nützlich, sobald die Leere Futter braucht.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04B0.title: "Compressed End Stone"
	quest.42000000001E04B1.quest_desc: [
		"Tiefenschiefer verdichtet, neun zu eins, und doch nur Stein.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04B1.title: "Compressed Deepslate"
	quest.42000000001E04B2.quest_desc: [
		"Zerschlägt auf einmal einen ganzen Stapel komprimierter Blöcke.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04B2.title: "Komprimierter Hammer"
	quest.42000000001E04B3.quest_desc: [
		"Ein schwächerer Hammer, um komprimierte Blöcke zu brechen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04B3.title: "Compressed Iron Hammer"
	quest.42000000001E04B4.quest_desc: [
		"Ein breites Sieb, mehrere Kieshaufen auf einmal.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04B4.title: "Komprimiertes Sieb (Voidcraft)"
	quest.42000000001E04B5.quest_desc: [
		"Siebt wie Eiche, nur eine andere Maserung.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04B5.title: "Birch Sieve"
	quest.42000000001E04B6.quest_desc: [
		"Gärt wie jedes andere Fass.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04B6.title: "Birch Barrel"
	quest.42000000001E04B7.quest_desc: [
		"Schmilzt Blöcke wie jeder andere Schmelztiegel.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000001E04B7.title: "Birch Crucible"
	quest.42000000001E04B8.quest_desc: [
		"Die Währung des Strangs: verdiene sie, gib sie aus, verschwende sie nie.",
		"So: Aufgabenbelohnungen, Erde mit Feuersteinnetz auf einem Webrahmen, Hütervorräte."
	]
	quest.42000000001E04B8.title: "Ausgefranster-Faden-Vorrat"
	quest.42000000001E04B9.quest_desc: [
		"Archivseiten und Notizen.",
		"So: setze einen Strang am Pfosten ein, oder am Stand der Siegelschneider bei /clowder hub (8 Faden). Rechtsklick zum Lesen; sie bleiben, sie werden nicht ausgegeben."
	]
	quest.42000000001E04B9.title: "Kodexseiten"
	quest.42000000001E04BA.quest_desc: [
		"Rechtsklick und öffne Hier anfangen. Gravis (`): die Auftragsliste. Das Buch vergibt keine Aufgaben.",
		"So: Startpaket / Dock-Truhe. Rechtsklick auf das Buch; Gravis (`) ist die Auftragsliste."
	]
	quest.42000000001E04BA.title: "Schnurrhaar-Kodex"
	quest.42000000001F04BB.quest_desc: [
		"Das Papier in einem Paket, bevor es fest versiegelt ist.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Goldbarren und Bretter um ein Ender-Auge. Erstes Packaged Auto-Rezept."
	]
	quest.42000000001F04BB.title: "Paketkomponente"
	quest.42000000001F04BC.quest_desc: [
		"Eine Pakethülle, diesmal um ein gespeichertes Muster gebaut.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04BC.title: "ME-Paketkomponente"
	quest.42000000001F04BD.quest_desc: [
		"Versiegelt Gegenstände zu einem Paket, damit die Linie sie bewegt.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04BD.title: "Verpacker (verpackt)"
	quest.42000000001F04BE.quest_desc: [
		"Gibt einem Verpacker einen weiteren Verpackungsplatz.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04BE.title: "Verpacker-Erweiterung"
	quest.42000000001F04BF.quest_desc: [
		"Öffnet ein Paket wieder zu losen Gegenständen.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04BF.title: "Unpackager"
	quest.42000000001F04C0.quest_desc: [
		"Schreibt ein Fertigungsrezept auf ein Paketmuster.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04C0.title: "Kodierer"
	quest.42000000001F04C1.quest_desc: [
		"Baut ein Paket nach seinem kodierten Rezept.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04C1.title: "Fertiger"
	quest.42000000001F04C2.quest_desc: [
		"Leitet Pakete zu der Adresse, die passt.",
		"So: Verteilermarkierer, Verpackungskomponente, zwei Shulker-Schalen, vier Enderperlen und ein Eisenblock. Schalen: Pack-Rezept, sechs Purpurblöcke, zwei Enderperlen und ein Bindungsknoten."
	]
	quest.42000000001F04C2.title: "Verteiler"
	quest.42000000001F04C3.quest_desc: [
		"Markiert ein Ziel, wohin ein Verteiler Pakete schicken kann.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04C3.title: "Distributor Marker"
	quest.42000000001F04C4.quest_desc: [
		"Speist fertige Pakete in die Linie, zum Abholen.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04C4.title: "Verpackungsanbieter"
	quest.42000000001F04C5.quest_desc: [
		"Lässt einen fernen Fertiger stattdessen über diesen Block anfragen.",
		"So: Stellvertretermarkierer, Verpackungskomponente, zwei Shulker-Schalen, zwei Enderperlen, zwei weinende Obsidiane und ein Eisenblock. Schalen: Pack-Rezept, sechs Purpurblöcke, zwei Enderperlen und ein Bindungsknoten."
	]
	quest.42000000001F04C5.title: "Fertigungsstellvertreter"
	quest.42000000001F04C6.quest_desc: [
		"Speichert einen Schwung Paketrezepte zum Wiederverwenden.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04C6.title: "Rezepthalter"
	quest.42000000001F04C7.quest_desc: [
		"Kopiert die Einstellungen eines Blocks auf einen anderen und spart viel Klicken.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04C7.title: "Einstellungskloner"
	quest.42000000001F04C8.quest_desc: [
		"Füllt ein Paket mit Flüssigkeit statt mit Gegenständen.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04C8.title: "Fluid Package Filler"
	quest.42000000001F04C9.quest_desc: [
		"Ein versiegeltes Bündel aus Gegenständen, bereit zum Bewegen oder Lagern.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04C9.title: "Paketgegenstand"
	quest.42000000001F04CA.quest_desc: [
		"Packt weit mehr in ein Paket als die einfache Sorte.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04CA.title: "Volume Package"
	quest.42000000001F04CB.quest_desc: [
		"Markiert, wohin ein Fertigungsstellvertreter reichen soll.",
		"So: Paketkomponente, dann Verpacker / Kodierer. Braucht ein AE2-Netz für das ME-Teil."
	]
	quest.42000000001F04CB.title: "Proxy Marker"
	quest.42000000001F04CC.quest_desc: [
		"Verbindet die Verpackungslinie mit dem digitalen Webstuhl.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001F04CC.title: "AE-Schnittstelle"
	quest.42000000001F04CD.quest_desc: [
		"Liefert Fertigungsmuster an die Verpackungslinie.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001F04CD.title: "Musteranbieter (verpackt)"
	quest.42000000001F04CE.quest_desc: [
		"Fertigt Gegenstände für die eigenen Muster des digitalen Webstuhls.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001F04CE.title: "Molekularassembler (verpackt)"
	quest.42000000001F04CF.quest_desc: [
		"Zuerst ein Netz des digitalen Webstuhls, sonst läuft nichts von dieser Verpackung.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001F04CF.title: "ME-Controller"
	quest.42000000001F04D0.quest_desc: [
		"Leite Energie oder Signale.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001F04D0.title: "Fluixkabel (verpackt)"
	quest.42000000001F04D1.quest_desc: [
		"Verpackt Gegenstände auf der Create-Seite, mechanisch.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001F04D1.title: "Create-Verpacker"
	quest.42000000001F04D2.quest_desc: [
		"Sammelt geteilte Pakete wieder zu ganzen Bestellungen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001F04D2.title: "Create-Neuverpacker"
	quest.42000000001F04D3.quest_desc: [
		"Fordert verpackte Gegenstände aus einem verknüpften Bestandsnetz an.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001F04D3.title: "Bestandsticker (verpackt)"
	quest.42000000001F04D4.quest_desc: [
		"Eine große Puffertruhe für Pakete, die auf ihren Zug warten.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001F04D4.title: "Gegenstandstresor (verpackt)"
	quest.42000000002004D5.quest_desc: [
		"Eine einfache Quantenspeicherplatte für das QIO-Netz.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004D5.title: "QIO-Laufwerkbasis"
	quest.42000000002004D6.quest_desc: [
		"Packt weit mehr Speicher auf eine einzige Quantenscheibe.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004D6.title: "QIO hyperdicht"
	quest.42000000002004D7.quest_desc: [
		"Eine Quantenscheibe, die Größe gegen rohe Dichte eintauscht.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004D7.title: "QIO zeitdehnend"
	quest.42000000002004D8.quest_desc: [
		"Die größte Quantenscheibe, die Mekanism herstellt.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004D8.title: "QIO supermassiv"
	quest.42000000002004D9.quest_desc: [
		"Hält mehrere Quantenscheiben in einem Gehäuse.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004D9.title: "QIO Laufwerk Reihe"
	quest.42000000002004DA.quest_desc: [
		"Durchsuche alles, was das QIO-Netz speichert.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004DA.title: "QIO-Dashboard"
	quest.42000000002004DB.quest_desc: [
		"Trägt die QIO-Übersicht in deiner Tasche.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004DB.title: "Tragbares QIO"
	quest.42000000002004DC.quest_desc: [
		"Das Grundgehäuse der meisten fortgeschrittenen Mekanism-Maschinen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004DC.title: "Stahlgehäuse (QIO)"
	quest.42000000002004DD.quest_desc: [
		"Speichert eine enorme Menge Energie in einem Block.",
		"Seltene Belohnung: ein geteiltes Clowder-Leben, einmal für das ganze Team. Nur sechs solche Belohnungen gibt es in der Kampagne.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004DD.title: "Ultimativ-Würfel"
	quest.42000000002004DE.quest_desc: [
		"Hält einen riesigen Stapel eines einzigen Gegenstands.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004DE.title: "Ultimative Tonne"
	quest.42000000002004DF.quest_desc: [
		"Schmilzt mehrere Stapel auf einmal, so schnell, wie Mekanism nur kann.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004DF.title: "Ultimativ-Schmelzfabrik"
	quest.42000000002004E0.quest_desc: [
		"Reichert Erz mit der höchsten Geschwindigkeit an, die Mekanism bietet.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E0.title: "Ultimativ-Anreicherungsfabrik"
	quest.42000000002004E1.quest_desc: [
		"Zerkleinert Erz mit der höchsten Geschwindigkeit, die Mekanism bietet.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E1.title: "Ultimativ-Zerkleinerungsfabrik"
	quest.42000000002004E2.quest_desc: [
		"Gräbt einen ganzen Chunk von selbst ab, geradewegs in die Leere.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E2.title: "Digitaler Bergmann (QIO)"
	quest.42000000002004E3.quest_desc: [
		"Ein modulares Werkzeug, das seinen Arbeitskopf selbst wechselt.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E3.title: "Atomarer Zerleger (QIO)"
	quest.42000000002004E4.quest_desc: [
		"Dreht Seiten und kopiert Einstellungen zwischen Mekanism-Maschinen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E4.title: "Konfigurator (QIO)"
	quest.42000000002004E5.quest_desc: [
		"Versetzt dich im Nu zwischen zwei verknüpften Sockeln.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E5.title: "Teleporter (QIO)"
	quest.42000000002004E6.quest_desc: [
		"Rahmt das Portal ein, das ein Teleporter öffnet.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E6.title: "Teleporterrahmen"
	quest.42000000002004E7.quest_desc: [
		"Gehäuse für den Reaktor, der Antimaterie erzeugt.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E7.title: "SPS-Gehäuse"
	quest.42000000002004E8.quest_desc: [
		"Speist Chemikalien ein und zieht Antimaterie aus dem Reaktor.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E8.title: "SPS-Port"
	quest.42000000002004E9.quest_desc: [
		"Beschleunigt den Ausstoß eines Antimateriereaktors.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004E9.title: "Hochaufgeladene Spule"
	quest.42000000002004EA.quest_desc: [
		"Schleudert Isotope auseinander, für die späte Chemie.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004EA.title: "Isotopenzentrifuge"
	quest.42000000002004EB.quest_desc: [
		"Löst Erz zu einem chemischen Schlamm auf.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004EB.title: "Chemische Auflösung"
	quest.42000000002004EC.quest_desc: [
		"Wäscht den Schlamm sauber, bevor er kristallisiert wird.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004EC.title: "Chemischer Wäscher"
	quest.42000000002004ED.quest_desc: [
		"Macht aus einer Chemikalie wieder einen festen Kristall.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004ED.title: "Chemischer Kristallisator"
	quest.42000000002004EE.quest_desc: [
		"Beschießt Material mit Neutronen, getrieben vom Sonnenlicht.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004EE.title: "Sonnenneutron"
	quest.42000000002004EF.quest_desc: [
		"Wandelt Energie direkt in Wärme für einen Kessel um.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004EF.title: "Widerstandsfähiger Heizer"
	quest.42000000002004F0.quest_desc: [
		"Verbrennt Holz für Wärme statt für Energie.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F0.title: "Brennholzheizer"
	quest.42000000002004F1.quest_desc: [
		"Späte Synthese von Stoffen, die sonst unmöglich wären.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F1.title: "Antiprotonisch"
	quest.42000000002004F2.quest_desc: [
		"Ein modulares Werkzeug zum Abbauen, Graben und mehr.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F2.title: "Meka-Werkzeug"
	quest.42000000002004F3.quest_desc: [
		"Anzugsrüstung für den Kopf, Modul für Modul aufgewertet.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F3.title: "Meka-Helm"
	quest.42000000002004F4.quest_desc: [
		"Anzugsrüstung für die Brust, Modul für Modul aufgewertet.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F4.title: "Meka-Brust"
	quest.42000000002004F5.quest_desc: [
		"Anzugsrüstung für die Beine, Modul für Modul aufgewertet.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F5.title: "Meka-Hose"
	quest.42000000002004F6.quest_desc: [
		"Anzugsrüstung für die Füße, Modul für Modul aufgewertet.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F6.title: "Meka-Stiefel"
	quest.42000000002004F7.quest_desc: [
		"Hülle für einen Dampfkessel.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F7.title: "Kesselgehäuse"
	quest.42000000002004F8.quest_desc: [
		"Speichert eine große Menge Energie.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F8.title: "Elitärer Energiekubus"
	quest.42000000002004F9.quest_desc: [
		"Speichert eine mittlere Menge Energie.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004F9.title: "Fortgeschrittener Energiewürfel"
	quest.42000000002004FA.quest_desc: [
		"Speichert wenig Energie, gut für den Anfang.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004FA.title: "Basis-Energiewürfel (QIO)"
	quest.42000000002004FB.quest_desc: [
		"Tränkt Metall mit einer Chemikalie für neue Legierungen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004FB.title: "Metallurgischer Infusor (QIO)"
	quest.42000000002004FC.quest_desc: [
		"Verdoppelt die Ausbeute von Roherz, bevor es geschmolzen wird.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004FC.title: "Anreicherungskammer (QIO)"
	quest.42000000002004FD.quest_desc: [
		"Mahl oder zerkleiner Material in Menge.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004FD.title: "Zerkleinerer (QIO)"
	quest.42000000002004FE.quest_desc: [
		"Schmilzt schneller als ein Ofen, mit Energie statt Brennstoff.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004FE.title: "Energieschmelze (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Schneidet Holz mit Mekanisms eigener Präzisionsklinge.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000002004FF.title: "Präzisionssägewerk"
	quest.4200000000200500.quest_desc: [
		"Spaltet Wasser in seine zwei Bestandteilsgase.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.4200000000200500.title: "Elektrolytseparator"
	quest.4200000000200501.quest_desc: [
		"Vereint zwei Chemikalien zu einer neuen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.4200000000200501.title: "Chemischer Injektor"
	quest.4200000000200502.quest_desc: [
		"Reinige Fluide oder Erze.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.4200000000200502.title: "Reinigung"
	quest.4200000000200503.quest_desc: [
		"Spritzt eine Chemikalie ins Erz für mehr Ausbeute.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.4200000000200503.title: "Chemische Injektion"
	quest.4200000000200504.quest_desc: [
		"Presst Osmium auf Gegenstände, für härtere Ausrüstung.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.4200000000200504.title: "Osmiumkompressor (QIO)"
	quest.4200000000200505.quest_desc: [
		"Fügt mehrere Bauteile zu einem fertigen Stück.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.4200000000200505.title: "Kombinierer"
	quest.4200000000210506.quest_desc: [
		"Zombies lassen es fallen, ob du es willst oder nicht.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: töte Zombies nachts auf der Plattform, oder in einem dunklen Loch."
	]
	quest.4200000000210506.title: "Vorrat verrotteten Fleischs"
	quest.4200000000210507.quest_desc: [
		"Skelette lassen sie zurück; mahl sie später zu Knochenmehl.",
		"So: Skelette bei Nacht, oder /clowder hub Plattformhüter (16 Faden für 8)."
	]
	quest.4200000000210507.title: "Knochenvorrat"
	quest.4200000000210508.quest_desc: [
		"Creeper zahlen das aus, manchmal explosiv.",
		"So: siebe Staub oder Seelensand, oder Creeper auf der Plattform bei Nacht. Halt die Ränder beleuchtet, sobald du welches hast."
	]
	quest.4200000000210508.title: "Schwarzpulvervorrat"
	quest.4200000000210509.quest_desc: [
		"Spinnen lassen es fallen, ein Sieb nie.",
		"So: entwirre Ausgefransten Faden (1 → 3). Spinnen. Webflusen an einer Echobindung. Umgekehrte Garn-Senke."
	]
	quest.4200000000210509.title: "Schnurvorrat"
	quest.420000000021050A.quest_desc: [
		"Braut Gift und geht in ein paar schräge Rezepte.",
		"So: Spinnen auf der Plattform bei Nacht."
	]
	quest.420000000021050A.title: "Spinnenaugenvorrat"
	quest.420000000021050B.quest_desc: [
		"Endermen lassen sie fallen; eine Farm schlägt das Betteln bei der Leere.",
		"So: Endermen, oder der Stand der Randgänger bei /clowder hub."
	]
	quest.420000000021050B.title: "Enderperlenfarm"
	quest.420000000021050C.quest_desc: [
		"Brennstoff für Braustände und Lohenbrenner gleichermaßen.",
		"So: Netherfestung nach Obsidian aus Klaue. Das Brauen will eine Rute; Ars und Occultism warten nicht darauf."
	]
	quest.420000000021050C.title: "Lohenrutenfarm"
	quest.420000000021050D.quest_desc: [
		"Ein seltener Fund, der Schlüssel für Regenerationstränke.",
		"So: Nether-Ghasts nach Klauen-Obsidian."
	]
	quest.420000000021050D.title: "Ghasttränenfarm"
	quest.420000000021050E.quest_desc: [
		"Braut Feuerresistenz und speist ein paar Rezepte.",
		"So: ein Schleimball in ein Lavafass geworfen, Schleim plus Lohenstaub, oder Magmawürfel."
	]
	quest.420000000021050E.title: "Magmacremefarm"
	quest.420000000021050F.quest_desc: [
		"Klebrig genug für Kolben, Schleimblöcke und Leinen.",
		"So: zwei Erde + Weizensamen + Knochenmehl (Plattformkompost), oder /clowder hub Plattformhüter."
	]
	quest.420000000021050F.title: "Schleimballfarm"
	quest.4200000000210510.quest_desc: [
		"Drei davon beschwören einen Boss, für den sich der Kampf lohnt.",
		"So: Netherfestung nach Obsidian aus Klaue. Drei Schädel starten einen Wither."
	]
	quest.4200000000210510.title: "Witherskelettschädel"
	quest.4200000000210511.quest_desc: [
		"Des Withers eigene Steuer, selten und schwer von Macht.",
		"So: Wither (drei Schädel auf Seelensand), oder der Stand der Trommelherzen bei /clowder hub einmal, für 12 Fadenballen (972 Faden). Optionale Trophäe — sie sperrt weder das End noch die Monsterfarm zu 100%."
	]
	quest.4200000000210511.title: "Netherstern"
	quest.4200000000210512.quest_desc: [
		"Wird zur Shulker-Kiste, Stauraum, der den Tod übersteht.",
		"Optional — hier gibt es keine Shulker, also fertigt das Pack die Panzer.",
		"So: Pack-Rezept, sechs Purpurblöcke, zwei Enderperlen und ein Bindungsknoten. Shulker erscheinen hier nie. Optional."
	]
	quest.4200000000210512.title: "Shulkerpanzerfarm"
	quest.4200000000210513.quest_desc: [
		"Repariert Elytren, wenn sonst nichts mehr hilft.",
		"So: überspringe drei Nächte Schlaf, dann töte Phantome. Optional."
	]
	quest.4200000000210513.title: "Phantomhaut"
	quest.4200000000210514.quest_desc: [
		"Tintenfischtinte, gut zum Färben und für altmodisches Schreiben.",
		"So: Holzkohle plus eine Glasflasche. Tintenfische erscheinen hier nie."
	]
	quest.4200000000210514.title: "Tintenbeutel-Farm"
	quest.4200000000210515.quest_desc: [
		"Lässt Schilder und Rahmen im Dunkeln leuchten.",
		"So: Leuchttintenfische erscheinen nie auf der Plattform. Optional."
	]
	quest.4200000000210515.title: "Leuchttinte"
	quest.4200000000210516.quest_desc: [
		"Wächter lassen sie fallen, für Prismarinblöcke und Laternen.",
		"So: Ozeanmonumente sind weg. Optional, außer wenn du einen Prismarinsamen ziehst."
	]
	quest.4200000000210516.title: "Prismarinscherbe"
	quest.4200000000210517.quest_desc: [
		"Wächterbeute, die das Meer erhellt und ein paar Rezepte speist.",
		"So: Ozeanmonumente sind weg. Optional."
	]
	quest.4200000000210517.title: "Prismarinkristall"
	quest.4200000000210518.quest_desc: [
		"Umringt einen Aquisator; sammle acht, um den Rahmen zu schließen.",
		"Optional — die Leere bietet dir vielleicht nie einen.",
		"So: nur Ozean. Optional."
	]
	quest.4200000000210518.title: "Nautilusschale (Jagd)"
	quest.4200000000210519.quest_desc: [
		"Überlistet den Tod einmal, dann ist er weg.",
		"So: nur Aufgabenbelohnungen. Uhr einsetzen und Siegel einsetzen geben je eines, und die Gaben der späten Strangknoten bieten mehr. Überfälle und Magier kommen nie zur Plattform. Optional."
	]
	quest.4200000000210519.title: "Totem (Jagd)"
	quest.420000000021051A.quest_desc: [
		"Golems lassen Eisen fallen, während sie Wache stehen.",
		"So: schmelze Roheisen / Eisengrus (Ofen oder Glutofen). Siebe Kies nach Brocken."
	]
	quest.420000000021051A.title: "Eisengolem-Gabe"
	quest.420000000021051B.quest_desc: [
		"Wirft Schneebälle; nützliche Munition, kaum ein Kämpfer.",
		"So: ein Eis (Set / Eisgenerator), formlos, zu vier Schneebällen."
	]
	quest.420000000021051B.title: "Schneegolem"
	quest.420000000021051C.quest_desc: [
		"Skelette halten die Plattform mit Munition versorgt.",
		"So: Feuerstein, Stock, Feder. Skelette lassen Extra fallen."
	]
	quest.420000000021051C.title: "Pfeilfarm"
	quest.420000000021051D.quest_desc: [
		"Markiert, was er trifft, mit einem kurzen Leuchten.",
		"So: Glowstone-Staub um einen Pfeil."
	]
	quest.420000000021051D.title: "Spektralpfeil"
	quest.420000000021051E.quest_desc: [
		"Steig auf, wenn du einen Sattel findest.",
		"Optional — die Plattformhüter in der Clowder-Halle verkaufen einen.",
		"So: tausche einen Diamantblock bei den Plattformhütern in ihrem Laden in der Clowder-Halle (/clowder hub). Der Chocobo-Sattel ist ein anderer Gegenstand."
	]
	quest.420000000021051E.title: "Sattel (Jagd)"
	quest.420000000021051F.quest_desc: [
		"Gibt einer Kreatur einen Namen, damit sie nie verschwindet.",
		"Optional — die Siegelschneider in der Clowder-Halle verkaufen eins.",
		"So: Angeln / seltene Truhen, oder der Stand der Siegelschneider bei /clowder hub (24 Faden). Optional."
	]
	quest.420000000021051F.title: "Namensschild-Farm"
	quest.4200000000210520.quest_desc: [
		"Bindet ein Glied oder ein Kabel fest.",
		"So: vier Schnur um einen Schleimball. Schleim ist Plattformkompost (Erde, Samen, Knochenmehl)."
	]
	quest.4200000000210520.title: "Leine (Jagd)"
	quest.4200000000210521.quest_desc: [
		"Hühner legen sie schneller, als du sie einsammeln kannst.",
		"So: Weizensamen an Hühner auf der Plattform, oder der Hühnerstall im Kapitel Monsterfarm."
	]
	quest.4200000000210521.title: "Eivorrat"
	quest.4200000000210522.quest_desc: [
		"Vorrat an Leder und Rindfleisch.",
		"So: schmelze verrottetes Fleisch oder gare es am Lagerfeuer. Siebe Erde mit einem Feuersteinnetz. /clowder hub Die Plattformhüter verkaufen zwei für 18 Faden."
	]
	quest.4200000000210522.title: "Ledervorrat"
	quest.4200000000210523.quest_desc: [
		"Schafe lassen sie nach dem Scheren nachwachsen.",
		"So: schere Schafe, nachdem du ihnen Gras gegeben hast, oder vier Schnur."
	]
	quest.4200000000210523.title: "Wollevorrat"
	quest.4200000000210524.quest_desc: [
		"Essensvorrat für die Küche.",
		"So: Weizen an Kühe auf der Plattform."
	]
	quest.4200000000210524.title: "Rindfleischvorrat"
	quest.4200000000210525.quest_desc: [
		"Schweine liefern es; koch es, bevor du isst.",
		"So: Kartoffeln oder Karotten an Schweine auf der Plattform."
	]
	quest.4200000000210525.title: "Schweinefleischvorrat"
	quest.4200000000210526.quest_desc: [
		"Huhn für Mahlzeiten und Federn.",
		"So: Samen an Hühner auf der Plattform."
	]
	quest.4200000000210526.title: "Hähnchenvorrat"
	quest.4200000000210527.quest_desc: [
		"Schaffleisch, besser gebraten als roh.",
		"So: Weizen an Schafe auf der Plattform."
	]
	quest.4200000000210527.title: "Hammelfleischvorrat"
	quest.4200000000210528.quest_desc: [
		"Braut einen Trank des Glücks, falls du eine entbehren kannst.",
		"Optional — die Leere bietet dir vielleicht nie einen.",
		"So: Kaninchen erscheinen nicht auf der Plattform. Optional."
	]
	quest.4200000000210528.title: "Hasenpfote"
	quest.4200000000210529.quest_desc: [
		"Ein Schaustück, das neben ein Drachenei gehört.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000210529.title: "Zombiekopf"
	quest.420000000021052A.quest_desc: [
		"Passt gut zu einem Drachenei im Regal.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000021052A.title: "Skelettschädel"
	quest.420000000021052B.quest_desc: [
		"Noch ein Kopf fürs Trophäenregal beim Ei.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000021052B.title: "Creeperkopf"
	quest.420000000021052C.quest_desc: [
		"Noch ein Kopf, zu Hause neben einem Drachenei.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000021052C.title: "Piglinkopf"
	quest.420000000021052D.quest_desc: [
		"Der seltenste Kopf, verdient erst, wenn der Kampf vorbei ist.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000021052D.title: "Drachenkopf"
	quest.420000000021052E.quest_desc: [
		"Nur wenn einem Spieler zufällig eine runterfällt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000021052E.title: "Spielerkopf"
	quest.420000000022052F.quest_desc: [
		"Die erste Fertigung gibt 2 — behalte einen später für den Kodex.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: ein Knochen, Schnur, Amethyst. /clowder hub Die Plattformhüter verkaufen Knochen. Tor Funke / Summen."
	]
	quest.420000000022052F.title: "Knochenklang"
	quest.4200000000220530.quest_desc: [
		"Scherbe alten Stammesgesangs — braucht einen Knochenklang.",
		"So: Knochenklang, Amethyst und Redstone, formlos. Ergibt zwei."
	]
	quest.4200000000220530.title: "Geistscherbe"
	quest.4200000000220531.quest_desc: [
		"Stimm Metall auf Geist — Kupfer um einen Knochenklang.",
		"So: Kupfer um einen Knochenklang. Ergibt zwei."
	]
	quest.4200000000220531.title: "Kupferresonator"
	quest.4200000000220532.quest_desc: [
		"Markiere die Gitterlinien — die Kreide braucht eine Scherbe.",
		"So: zwei Knochenmehl, Lapislazuli und eine Geisterscherbe, formlos. Ergibt vier."
	]
	quest.4200000000220532.title: "Ritualkreide (Stammes)"
	quest.4200000000220533.quest_desc: [
		"Setze das Herz — zwei Knochenklänge, eine Geisterscherbe, zwei Leder und vier Bretter (die Plattformhüter verkaufen Leder).",
		"So: zwei Knochenklänge, eine Geisterscherbe, zwei Leder und vier Bretter. Schlag mit leeren Händen im Takt (17–23 Ticks) für 24 Puls."
	]
	quest.4200000000220533.title: "Trommelherzschlag"
	quest.4200000000220534.quest_desc: [
		"Neun Stämme summten einmal — ein Knochenklang und eine Scherbe in Reserve.",
		"So: fertige es, oder hol es als Belohnung von Funke/Stammesweben. Rechtsklick: wie das Gitter arbeitet."
	]
	quest.4200000000220534.title: "Geisterkodex"
	quest.4200000000220535.quest_desc: [
		"Zieh Ley in die Schläge.",
		"So: stell ihn unter den Himmel, nah an Wasser/Grün. Langsamer Puls. Funke-Leiter."
	]
	quest.4200000000220535.title: "Leysammler"
	quest.4200000000220536.quest_desc: [
		"Trägt Puls für Werkzeuge, Zauber und Reisen. Fülle sie an einem Trommelherz.",
		"So: fertige sie, dann fülle sie an einem Trommelherz (Klick mit der Zelle). Werkzeuge, Zauber und Reise ziehen aus der Zelle."
	]
	quest.4200000000220536.title: "Pulszelle"
	quest.4200000000220537.quest_desc: [
		"Setze einen Echo-Katalysator ein, der sich bei der Arbeit abnutzt; füge zwei verschiedene Totemstimmen innerhalb von acht Blöcken hinzu. Mehr Stimmen stärken das Lied. Redstone pausiert ihn.",
		"So: setze einen Echo-Katalysator ein, zwei verschiedene Totems innerhalb von 8. Redstone pausiert ihn."
	]
	quest.4200000000220537.title: "Pulsresonator"
	quest.4200000000220538.quest_desc: [
		"Der Stamm des Steins antwortet.",
		"So: ein Knochenklang, zwei Stämme, Erde und ein Kupferresonator."
	]
	quest.4200000000220538.title: "Erd-Totem"
	quest.4200000000220539.quest_desc: [
		"Der Stamm der Flamme antwortet.",
		"So: ein Knochenklang, zwei Stämme, Holzkohle und ein Kupferresonator."
	]
	quest.4200000000220539.title: "Feuer-Totem"
	quest.420000000022053A.quest_desc: [
		"Der Stamm der Gezeit antwortet.",
		"So: ein Knochenklang, zwei Stämme, ein Wassereimer (oder ein Porzellan-Wassereimer) und ein Kupferresonator."
	]
	quest.420000000022053A.title: "Wasser-Totem"
	quest.420000000022053B.quest_desc: [
		"Der Stamm des Winds antwortet.",
		"So: ein Knochenklang, zwei Stämme, eine Feder und ein Kupferresonator."
	]
	quest.420000000022053B.title: "Luft-Totem"
	quest.420000000022053C.quest_desc: [
		"Fünfter Stamm — Kern des Hüters.",
		"So: ein Knochenklang, zwei Stämme, eine Geisterscherbe und ein Kupferresonator."
	]
	quest.420000000022053C.title: "Geist-Totem"
	quest.420000000022053D.quest_desc: [
		"Starte das Lied des Gitters. Es wartet auf Stein oder einen Gegenstand der Echo-Stufe; Rohmetall ist Grus im Echobrecher.",
		"So: Geisterkodex + Stammesweben. Setze Stein oder einen Gegenstand der Echo-Stufe ein. Rohmetall gehört in den Echobrecher."
	]
	quest.420000000022053D.title: "Liedbank"
	quest.420000000022053E.quest_desc: [
		"Leite Harmonien zwischen Totems.",
		"So: vier Kupferresonatoren um Redstone. Ergibt vier."
	]
	quest.420000000022053E.title: "Gitterkonduktor"
	quest.420000000022053F.quest_desc: [
		"Summ Stufe eins — brich das Erz. Stein wird Scherben; Bruchstein wird Kies; Rohmetall wird Grus. Grusbruch dauert 4 Sekunden bei 40 Puls/s.",
		"So: Stein + Knochenklang + Kupferresonator. Erd-Totem innerhalb von 8. Stein → Scherben; Bruchstein → Kies; Rohmetall → Grus. Vier Sekunden bei 40 Puls/s."
	]
	quest.420000000022053F.title: "Echozermalmer"
	quest.4200000000220540.quest_desc: [
		"Scherbe, die den Bruch gehört hat.",
		"So: Stein im Echobrecher (nicht Bruchstein). Stein der Quell-Stufe, oder mit Behutsamkeit berührter Stein."
	]
	quest.4200000000220540.title: "Echoscherbe (Stammes)"
	quest.4200000000220541.quest_desc: [
		"Summ Stufe zwei — stimm ein.",
		"So: sieben Stein, eine Geisterscherbe und ein Kupferresonator."
	]
	quest.4200000000220541.title: "Echoabstimmer"
	quest.4200000000220542.quest_desc: [
		"Echo, das einen Schlüssel fand.",
		"So: Geisterkodex + Stammesweben. Station, Totem und Pulskosten stehen auf der Kodexseite."
	]
	quest.4200000000220542.title: "Abgestimmtes Echo"
	quest.4200000000220543.quest_desc: [
		"Bindestufe — knote den Geist ans Metall.",
		"So: sieben Stein, eine Amethystscherbe und ein Kupferresonator."
	]
	quest.4200000000220543.title: "Echobinder"
	quest.4200000000220544.quest_desc: [
		"Echo, das nicht abrutscht.",
		"So: Geisterkodex + Stammesweben. Station, Totem und Pulskosten stehen auf der Kodexseite."
	]
	quest.4200000000220544.title: "Gebundenes Echo"
	quest.4200000000220545.quest_desc: [
		"Neuwebestufe — ruf den Barren.",
		"So: fünf Stein, ein Goldbarren, zwei Kupferresonatoren und eine Geisterscherbe."
	]
	quest.4200000000220545.title: "Echomanifestierer"
	quest.4200000000220546.quest_desc: [
		"Metall, vom Geisterpuls ins Sein gewollt, nicht von einem Ofen.",
		"So: Geisterkodex + Stammesweben. Station, Totem und Pulskosten stehen auf der Kodexseite."
	]
	quest.4200000000220546.title: "Manifestierter Barren"
	quest.4200000000220547.quest_desc: [
		"Behalte, was die Stämme hinterließen.",
		"So: sieben Bretter, eine Truhe und ein Knochenklang."
	]
	quest.4200000000220547.title: "Ahnenspeicher"
	quest.4200000000220548.quest_desc: [
		"Gewölbe, zur Mark hin verknüpft.",
		"So: ein Ahnenversteck, vier Eisenbarren, eine Geisterscherbe, zwei Kupferresonatoren und eine Pulszelle."
	]
	quest.4200000000220548.title: "Tiefspeicher"
	quest.4200000000220549.quest_desc: [
		"Ein ungeschriebenes Siegel, das auf einen Ritus wartet, der es füllt.",
		"So: sieben Papier, eine Geisterscherbe und ein Knochenklang. Ergibt zwei."
	]
	quest.4200000000220549.title: "Leersiegel"
	quest.420000000022054A.quest_desc: [
		"Siegel des Stamms des Steins.",
		"So: ein Leeres Siegel und Erde, formlos."
	]
	quest.420000000022054A.title: "Erd-Siegel"
	quest.420000000022054B.quest_desc: [
		"Siegel des Stamms der Flamme.",
		"So: ein Leeres Siegel und Holzkohle, formlos."
	]
	quest.420000000022054B.title: "Feuer-Siegel"
	quest.420000000022054C.quest_desc: [
		"Siegel des Stamms der Gezeit.",
		"So: ein Leeres Siegel und ein Wassereimer (oder ein Porzellan-Wassereimer), formlos."
	]
	quest.420000000022054C.title: "Wasser-Siegel"
	quest.420000000022054D.quest_desc: [
		"Siegel des Stamms des Winds.",
		"So: ein Leeres Siegel und eine Feder, formlos."
	]
	quest.420000000022054D.title: "Luft-Siegel"
	quest.420000000022054E.quest_desc: [
		"Siegel des Stamms des Hüters.",
		"So: ein Leeres Siegel und eine Geisterscherbe, formlos."
	]
	quest.420000000022054E.title: "Geist-Siegel"
	quest.420000000022054F.quest_desc: [
		"Biete Siegel an. Frag den Webstuhl.",
		"So: fünf Stein, eine Amethystscherbe und ein Knochenklang."
	]
	quest.420000000022054F.title: "Ritussockel"
	quest.4200000000220550.quest_desc: [
		"Benutze sie mit leeren Händen und spiele den Torritus: triff die fallenden Schläge auf A, S, D, F. Erreiche 60% und sie öffnet sich; kein Puls nötig.",
		"So: benutze die Tortrommel mit leeren Händen und spiele den Torritus: triff die fallenden Schläge auf A, S, D, F. Erreiche 60% und sie öffnet sich; kein Puls nötig. Binde zuerst einen Rückkehrkompass."
	]
	quest.4200000000220550.title: "Tortrommel (Stammes)"
	quest.4200000000220551.quest_desc: [
		"Kleide die Schwelle deines Lagers mit einem geschnitzten Geisterrahmen. Kompasse und die Tortrommel vollziehen die Reise.",
		"So: vier Eisenbarren, zwei Geisterscherben, zwei Kupferresonatoren und eine Amethystscherbe."
	]
	quest.4200000000220551.title: "Geistertür"
	quest.4200000000220552.quest_desc: [
		"Werkzeug, das Puls verbraucht.",
		"So: drei Manifestierte Barren, ein Knochenklang und ein Stock."
	]
	quest.4200000000220552.title: "Spitzhacke der Geisterausrüstung"
	quest.4200000000220553.quest_desc: [
		"Schneide, die Puls verbraucht.",
		"So: zwei Manifestierte Barren, ein Knochenklang und ein Stock."
	]
	quest.4200000000220553.title: "Geistergerätklinge"
	quest.4200000000220554.quest_desc: [
		"Stein aus der Mark, unter den Füßen, an einem Ort, den es nicht geben dürfte.",
		"So: schmelze Bruchstein der Mark. Baue ihn in der Mark ab, durch eine Tortrommel."
	]
	quest.4200000000220554.title: "Stein der Mark (Stammes)"
	quest.4200000000220555.quest_desc: [
		"Geröll aus der Mark, schlicht, aber reichlich.",
		"So: Baue Stein der Mark in der Mark ab, durch eine Tortrommel."
	]
	quest.4200000000220555.title: "Marschbruchstein"
	quest.4200000000220556.quest_desc: [
		"Holz, gewachsen, wo die Sonne nicht hinkommt.",
		"So: Fälle Bäume der Mark, durch eine Tortrommel."
	]
	quest.4200000000220556.title: "Marsch-Stamm"
	quest.4200000000220557.quest_desc: [
		"Gesägtes Holz aus der Mark, standfest trotz seiner Herkunft.",
		"So: Ein Stamm der Mark ergibt vier Bretter."
	]
	quest.4200000000220557.title: "Marsch-Bretter"
	quest.4200000000220558.quest_desc: [
		"Blätter, die murmeln, auch ganz ohne Wind.",
		"So: Bäume der Mark, durch eine Tortrommel. Schere oder Behutsamkeit behalten die Blätter."
	]
	quest.4200000000220558.title: "Marschblatt"
	quest.4200000000220559.quest_desc: [
		"Ein Rohr, das von übrigem Geisterpuls summt.",
		"So: wächst wild in der Mark, liegt in Schilfwehr-Kisten, und ein Ältester der Wurzelbinder handelt damit."
	]
	quest.4200000000220559.title: "Geisterrohr (Stammes)"
	quest.420000000022055A.quest_desc: [
		"Gib Roheisen in den Echobrecher neben einem Erd-Totem. Zwei Grus kommen heraus; schmelze sie im Ofen oder im Schmelzofen zu Barren. Andere Mods können Rohmetalle mit Tag liefern.",
		"So: Geisterkodex + Stammesweben. Station, Totem und Pulskosten stehen auf der Kodexseite."
	]
	quest.420000000022055A.title: "Erz erinnert sich zweimal"
	quest.420000000022055B.quest_desc: [
		"Wasser bindet Wolle zu Geistergewebe. Füttere die Station von oben oder von den Seiten und zieh die fertige Arbeit unten heraus.",
		"So: Geisterkodex + Stammesweben. Station, Totem und Pulskosten stehen auf der Kodexseite."
	]
	quest.420000000022055B.title: "Tuch mit Stimme"
	quest.420000000022055C.quest_desc: [
		"Manifestiere einen manifestierten Barren noch einmal unter Geist. Der Resonanzkern öffnet stärkere Ausrüstung und ferne Wege.",
		"So: Geisterkodex + Stammesweben. Station, Totem und Pulskosten stehen auf der Kodexseite."
	]
	quest.420000000022055C.title: "Das lebende Herz"
	quest.420000000022055D.quest_desc: [
		"Trag 4,800 Puls in einer Großen Zelle, oder 19,200 in einer Gewaltigen Zelle. Lade sie an einem Trommelherz oder Resonator auf, bevor du aufbrichst.",
		"So: eine Pulszelle, zwei Resonanzkerne und zwei manifestierte Barren."
	]
	quest.420000000022055D.title: "Ein längeres Lied"
	quest.420000000022055E.quest_desc: [
		"Sechzehn Eimer in einer Zisterne. Eimer und Flüssigkeitsrohre funktionieren beide. Ein Komparator liest den Füllstand; Redstone sperrt Befüllen und Entleeren. Baue sie ab, und die Flüssigkeit bleibt am Block, der herunterfällt. Himmelssteintanks schütten aus.",
		"So: fertige sie, fülle mit Eimer oder Rohr, heb sie auf — die Flüssigkeit bleibt. Himmelssteintanks von AE2 werden leer, wenn du sie abbaust."
	]
	quest.420000000022055E.title: "Regen in Kupfer gehalten"
	quest.420000000022055F.quest_desc: [
		"Markiere eine Maschinenseite mit dem Stimmgerät, dann benutze es an einer Relaisplatte. Benutze es an einer anderen Maschine, um die Markierung zu ersetzen. Markiere nicht die Platte.",
		"So: eine Geisterscherbe über zwei Kupferresonatoren."
	]
	quest.420000000022055F.title: "Benenne das ferne Ende"
	quest.4200000000220560.quest_desc: [
		"Lass die Platte an der Seite einer Kiste oder Maschine einrasten. Verbinde zwei Platten mit demselben einzigartigen Bindungsgegenstand, oder binde ein Ziel mit dem Stimmgerät. Lokale Fracht reicht 32 Blöcke weit, 16 Gegenstände pro Sekunde für 8 Puls. Redstone pausiert sie. Seit 5.0 will die Platte ein waches Luft-Resonanztotem innerhalb von acht Blöcken, sonst steht sie still und sagt, welche Stimme ihr fehlt.",
		"So: ein Trichter, ein Kupferresonator, zwei Ritualkreiden und ein Manifestbarren."
	]
	quest.4200000000220560.title: "Ein Weg für Vorräte"
	quest.4200000000220561.quest_desc: [
		"Lass die Platte an der Seite eines Tanks einrasten. Verbinde zwei Platten, oder binde ein Ziel mit dem Stimmgerät. Lokale Flüssigkeit reicht 32 Blöcke weit: 250 mB pro Sekunde für 8 Puls. Beide Enden müssen geladen sein. Seit 5.0 will die Platte ein waches Luft-Resonanztotem innerhalb von acht Blöcken, sonst steht sie still und sagt, welche Stimme ihr fehlt.",
		"So: eine Geisterzisterne, ein Kupferresonator, zwei Ritualkreiden und ein Manifestbarren."
	]
	quest.4200000000220561.title: "Ein Weg für den Regen"
	quest.4200000000220562.quest_desc: [
		"Die Langreichweite trägt Gegenstände bis zu 128 Blöcke weit, für 16 Puls pro gelungenem Schlag. Nutze gewöhnliche Inventare aus jedem passenden Mod. Seit 5.0 will die Platte ein waches Luft-Resonanztotem innerhalb von acht Blöcken, sonst steht sie still und sagt, welche Stimme ihr fehlt.",
		"So: ein Gegenstandsrelais, zwei Resonanzkerne und zwei Enderperlen."
	]
	quest.4200000000220562.title: "Quer durch die Werkstatt"
	quest.4200000000220563.quest_desc: [
		"Die Langreichweite trägt Flüssigkeiten bis zu 128 Blöcke weit, für 16 Puls pro Schlag. Volle Empfänger pausieren sicher; Redstone kann die empfangende Zisterne sperren. Seit 5.0 will die Platte ein waches Luft-Resonanztotem innerhalb von acht Blöcken, sonst steht sie still und sagt, welche Stimme ihr fehlt.",
		"So: ein Flüssigkeitsrelais, zwei Resonanzkerne und zwei Enderperlen."
	]
	quest.4200000000220563.title: "Quer durch die Wasserwerke"
	quest.4200000000220564.quest_desc: [
		"Überbrücke Tribal Power zu den Energieakzeptoren von Mekanism, Powah oder AE2. Jeder Puls wird zu 100 FE. Ohne Rang sind es 60 Puls pro Sekunde (6,000 FE/s); stufe den Adapter an Echostationen auf, und der Status mit leerer Hand nennt die aktuelle Rate. Er kann weiterhin kein FE empfangen. Redstone stoppt Umwandlung und Export.",
		"So: fünf Kupferbarren, drei Redstone und ein Resonanzkern."
	]
	quest.4200000000220564.title: "Der Takt wird Strom"
	quest.4200000000220565.quest_desc: [
		"Der Sechsfache Stab. Schleichen und benutzen, um Erde, Feuer, Wasser, Luft, Geist und Webstuhl durchzuschalten. Benutzen, um zu wirken; die Webstuhl-Stimme ist Halteseil und zieht ein Ziel acht Blöcke zu dir, und ein Schleichzauber ohne Ziel ist Stich, ein Sprung von sechs Blöcken. Trag geladene Zellen; der Geisterkodex erklärt jeden Zauber und seine Kosten.",
		"So: ein Geistessiegel, ein Resonanzkern, ein Manifestierter Barren und zwei Stämme."
	]
	quest.4200000000220565.title: "Sechs Stimmen in einer Hand"
	quest.4200000000220566.quest_desc: [
		"In der Haupthand eine Steinfläche schleichend benutzen: ein bewusster Schnitt von drei mal drei, 8 Puls je Block. Normaler Abbauschutz und Werkzeuganforderungen gelten weiter.",
		"So: zwei Manifestierte Barren, ein Resonanzkern und zwei Kupferresonatoren."
	]
	quest.4200000000220566.title: "Stein gibt einen Durchgang"
	quest.4200000000220567.quest_desc: [
		"Die Kapuze leiht Nachtsicht, solange geladene Zellen sie tragen. Unverbundene Teile ziehen 2 Puls alle vier Sekunden; eine gebundene Stimme kostet 3.",
		"So: fünf Geistergewebe, helmförmig. Eine Leylinse darauf lässt es später die Ley sehen."
	]
	quest.4200000000220567.title: "Augen in der Stille"
	quest.4200000000220568.quest_desc: [
		"Die Robe gewährt Resistenz. Trag sie in die Arbeit und halte deine Zellen geladen.",
		"So: sieben Geistergewebe und ein Resonanzkern."
	]
	quest.4200000000220568.title: "Ein gewebter Schutz"
	quest.4200000000220569.quest_desc: [
		"Gewebte Beinschienen leihen Tempo. Ihr Pulskosten steht getrennt von den anderen Teilen.",
		"So: sechs Geistergewebe und ein Resonanzkern."
	]
	quest.4200000000220569.title: "Das Lager hält Schritt"
	quest.420000000022056A.quest_desc: [
		"Stiefel können beim Abstieg Langsamen Fall leihen, solange Puls bleibt. Ein gebundener Rückweg lohnt das Mitnehmen.",
		"So: vier Geistergewebe, stiefelförmig."
	]
	quest.420000000022056A.title: "Ein sanfterer Abstieg"
	quest.420000000022056B.quest_desc: [
		"Setze ein wiederverwendbares Siegel neben sein passendes Totem. Ein Segen von sechs Blöcken kostet 8 Puls alle zwei Sekunden. Hohes Redstone pausiert ihn; schleiche mit leeren Händen, um das Siegel zurückzuholen.",
		"So: zwei Manifestierte Barren, zwei Kupferbarren, ein Resonanzkern und drei Stein."
	]
	quest.420000000022056B.title: "Ein Segen, der bleibt"
	quest.420000000022056C.quest_desc: [
		"Schleichend die Oberseite eines festen Bodens benutzen, um ihn zu binden. Kehre innerhalb von 128 Blöcken in derselben Welt zurück, für 20 Puls. Gib dem Landeboden Energie, um Ankünfte zu sperren.",
		"So: ein Kompass inmitten von vier Manifestierten Barren."
	]
	quest.420000000022056C.title: "Der erste Rückweg"
	quest.420000000022056D.quest_desc: [
		"Kehre über jede Entfernung innerhalb einer Dimension zurück, für 40 Puls. Lass eine trockene Landung mit zwei freien Blöcken darüber.",
		"So: ein Wegsteinkompass inmitten von vier Resonanzkernen."
	]
	quest.420000000022056D.title: "Jenseits des Horizonts"
	quest.420000000022056E.quest_desc: [
		"Such Kristall der Mark jenseits der Tortrommel. Astralwege für Leute, Gegenstände und Flüssigkeiten zehren alle vom selben späten Material.",
		"So: baue Kristall in Grotten der Mark ab, oder finde ihn in Truhen der Mark. Zuerst die Tortrommel."
	]
	quest.420000000022056E.title: "Eine Stimme jenseits des Schleiers"
	quest.420000000022056F.quest_desc: [
		"Der letzte Kompass kreuzt Dimensionen für 100 Puls. Binde eine sichere Rückkehr, bevor du erkundest. Die Reise wartet fünf Sekunden zwischen den Einsätzen.",
		"So: ein Horizontkompass, zwei Geistessiegel und zwei Kristalle der Mark."
	]
	quest.420000000022056F.title: "Ein Weg zwischen Welten"
	quest.4200000000220570.quest_desc: [
		"Astralfracht quert Dimensionen ohne Entfernungsgrenze. Jeder gelungene Schlag kostet 32 Puls. Der Empfänger muss schon geladen sein; kein verstecktes Chunk-Laden. Seit 5.0 will die Platte ein waches Resonanztotem (Webstuhl) innerhalb von acht Blöcken, sonst steht sie still und sagt, welche Stimme ihr fehlt.",
		"So: ein Weitreich-Gegenstandsrelais, zwei Geist-Siegel und zwei Kristalle der Mark."
	]
	quest.4200000000220570.title: "Vorräte kreuzen den Schleier"
	quest.4200000000220571.quest_desc: [
		"Astralflüssigkeit folgt derselben Dimensionsstufe wie Spieler und Gegenstände. Halte den Zieltank geladen. Ein voller Tank oder eine ungeladene Welt pausiert, ohne Fracht zu verbrauchen. Seit 5.0 will die Platte ein waches Resonanztotem (Webstuhl) innerhalb von acht Blöcken, sonst steht sie still und sagt, welche Stimme ihr fehlt.",
		"So: ein Weitreich-Flüssigkeitsrelais, zwei Geist-Siegel und zwei Kristalle der Mark."
	]
	quest.4200000000220571.title: "Regen kreuzt den Schleier"
	quest.4200000000220572.quest_desc: [
		"Öffne von der Straße aus deinen persönlichen Tiefenspeicher mit 54 Plätzen. Das ist derselbe Tresor, geteilt zwischen deinen Speichern und der Umhängetasche. Die Abstimmung auf die Mark nimmt die Kosten beim Öffnen weg.",
		"So: sechs Geistergewebe, zwei Resonanzkerne und ein Tiefenspeicher."
	]
	quest.4200000000220572.title: "Das Lager in deiner Hut"
	quest.4200000000220573.quest_desc: [
		"Das Tor öffnet sich auf ein lebendiges Land. Manche Wesen tragen noch das alte Lied; andere hüten seine zerbrochenen Stücke. Bürste die sanften. Stell dich den Wächtern mit geladenen Pulszellen und einem Rückweg.",
		"So: fertige es, oder hol es als Belohnung von Funke/Stammesweben. Rechtsklick: wie das Gitter arbeitet."
	]
	quest.4200000000220573.title: "Das Lied der Rückkehr"
	quest.4200000000220574.quest_desc: [
		"Ein Dämmergrasfresser, der das alte Waldlied im Geweih trägt. Züchte sie mit Weizen; bürste Erwachsene für Dämmersamt.",
		"Such ihn in den Wäldern der Oberwelt und in der Mark. Bring sein Reagenz zur Echobindung unter der Stimme Wasser zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: bürste einen erwachsenen Dämmerhirsch. Züchte sie mit Weizen."
	]
	quest.4200000000220574.title: "Dämmerhirsch: ein Lied zurück"
	quest.4200000000220575.quest_desc: [
		"Ein scheuer Dämmerungssammler, dessen Schwanz sichere Pfade markiert. Züchte sie mit Süßbeeren; bürste Erwachsene für Laternenflaum.",
		"Such ihn in den Wäldern der Oberwelt und in der Mark. Bring sein Reagenz zur Echobindung unter der Stimme Wasser zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: bürste einen erwachsenen Laternenfuchs. Züchte sie mit Süßbeeren."
	]
	quest.4200000000220575.title: "Laternenfuchs: ein Lied zurück"
	quest.4200000000220576.quest_desc: [
		"Ein geduldiger Feuchtlandgärtner mit lebendiger Schale. Züchte sie mit Seegras; bürste Erwachsene für eine von selbst abgeworfene Moosrückenschuppe.",
		"Such ihn in den Sümpfen der Oberwelt und in der Mark. Bring sein Reagenz zur Echobindung unter der Stimme Wasser zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: bürste einen erwachsenen Moosrücken. Züchte sie mit Seegras."
	]
	quest.4200000000220576.title: "Moosrücken: ein Lied zurück"
	quest.4200000000220577.quest_desc: [
		"Die Überreste eines gebrochenen Feuerritus. Seine Nahschläge entzünden kurz; halte Wasser nah.",
		"Such ihn in den Wäldern der Oberwelt und in der Mark. Bring sein Reagenz zur Echoabstimmung unter der Stimme Geist zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt vom Aschenbund. Feindliche Geister brauchen Dunkelheit."
	]
	quest.4200000000220577.title: "Aschenbund: ein Lied zurück"
	quest.4200000000220578.quest_desc: [
		"Ein Hainwächter, verdreht von einer gekappten Ley-Linie. Langsam, aber standfest; seine Schläge wurzeln Reisende kurz.",
		"Such ihn in den Wäldern der Oberwelt und in der Mark. Bring sein Reagenz zur Echoabstimmung unter der Stimme Geist zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt vom Wurzelbund. Feindliche Geister brauchen Dunkelheit."
	]
	quest.4200000000220578.title: "Wurzelbund: ein Lied zurück"
	quest.4200000000220579.quest_desc: [
		"Ein Marschjäger, verborgen zwischen Geisterrohr. Schnelle Schläge tragen ein kurzes Gift.",
		"Such ihn in den Sümpfen der Oberwelt und in der Mark. Bring sein Reagenz zur Echoabstimmung unter der Stimme Geist zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt vom Schilfpirscher. Feindliche Geister brauchen Dunkelheit."
	]
	quest.4200000000220579.title: "Schilfpirscher: ein Lied zurück"
	quest.420000000022057A.quest_desc: [
		"Ein Aasfresser der Kristallfelder, gepanzert in singendem Stein. Halt Abstand von seinem schweren Stoß.",
		"Such ihn in der Mark. Bring sein Reagenz zur Echoabstimmung unter der Stimme Geist zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt vom Splitterrücken. Feindliche Geister brauchen Dunkelheit."
	]
	quest.420000000022057A.title: "Splitterrücken: ein Lied zurück"
	quest.420000000022057B.quest_desc: [
		"Ein leerer Wächter, der noch die alten Straßen hütet. Seine Berührung schwächt den Griff der Angreifer.",
		"Such ihn in der Mark. Bring sein Reagenz zur Echoabstimmung unter der Stimme Geist zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt vom Hohlen Wächter. Feindliche Geister brauchen Dunkelheit."
	]
	quest.420000000022057B.title: "Hohler Wächter: ein Lied zurück"
	quest.420000000022057C.quest_desc: [
		"Ein sturmgenährter Geist mit weiten Schleierflügeln. Eine helle Sammlung von Stäubchen warnt vor seiner Bö; Deckung bricht den Angriff.",
		"Such sie in der Mark. Bring ihr Reagenz zur Echobindung unter der Stimme Wasser zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt von der Sturmmotte. Feindliche Geister brauchen Dunkelheit."
	]
	quest.420000000022057C.title: "Sturmmotte: ein Lied zurück"
	quest.420000000022057D.quest_desc: [
		"Ein flinker Glutgeist. Er sammelt Funken vor einem brennenden Geschoss; der Zauber entzündet nie das Gelände.",
		"Such ihn in der Mark. Bring sein Reagenz zur Echoabstimmung unter der Stimme Geist zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt vom Glutkobold. Feindliche Geister brauchen Dunkelheit."
	]
	quest.420000000022057D.title: "Glutkobold: ein Lied zurück"
	quest.420000000022057E.quest_desc: [
		"Ein schwebendes Relikt, das sich an die verlorenen Stämme erinnert. Sein angekündigter Klang verlangsamt; Unterschlupf unterbricht das Lied.",
		"Such ihn in der Mark. Bring sein Reagenz zur Echoabstimmung unter der Stimme Geist zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt von der Trauerglocke. Feindliche Geister brauchen Dunkelheit."
	]
	quest.420000000022057E.title: "Trauerglocke: ein heimgekehrtes Lied"
	quest.420000000022057F.quest_desc: [
		"Ein Jäger, den Risse im Gitter anziehen. Er überbrückt die Distanz schnell, kann Welten aber nicht allein wechseln.",
		"Such ihn in der Mark. Bring sein Reagenz zur Echoabstimmung unter der Stimme Geist zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt vom Risshund. Feindliche Geister brauchen Dunkelheit."
	]
	quest.420000000022057F.title: "Risshund: ein heimgekehrtes Lied"
	quest.4200000000220580.quest_desc: [
		"Ein achtbeiniger Wächter zerbrochener Lieder. Sein Biss verlangsamt die Beute, ohne Netze zu legen oder das Lager zu beschädigen.",
		"Such sie in der Mark. Bring ihr Reagenz zur Echobindung unter der Stimme Wasser zurück, für ein nützliches Material. Bau beleuchtete Wege; feindliche Geister verlangen Dunkelheit.",
		"So: fällt vom Echoweber. Feindliche Geister brauchen Dunkelheit."
	]
	quest.4200000000220580.title: "Echoweber: ein heimgekehrtes Lied"
	quest.4200000000220581.quest_desc: [
		"Die Feldnotizen sind vollständig. Die sanften Ernten und die geborgenen Relikte sind wieder Tuch und Echos. Unter dem Nachtschleier antwortet das Lager mit einem volleren Lied.",
		"Seltene Belohnung: ein geteiltes Clowder-Leben, einmal für das ganze Team. Nur sechs solche Belohnungen gibt es in der Kampagne.",
		"So: Geisterkodex + Stammesweben. Station, Totem und Pulskosten stehen auf der Kodexseite."
	]
	quest.4200000000220581.title: "Dreizehn Stimmen, ein Himmel"
	quest.4200000000220582.quest_desc: [
		"Häng das Lied des Lagers in Kupfer. Eine Geisterlaterne gibt volles Licht ohne Brennstoff; Redstone dämpft sie. Markier sichere Wege zurück aus dem Dunkel.",
		"So: drei Kupferbarren, eine Geisterscherbe und ein Brett."
	]
	quest.4200000000220582.title: "Ein Licht für die Heimkehrenden"
	quest.4200000000220583.quest_desc: [
		"Das Geläut ist Zier und Instrument zugleich. Sein Komparator gibt 0 bei klarem Himmel, 8 bei Regen und 15 bei Gewitter. Redstone bringt es zum Schweigen.",
		"So: drei Bretter, drei Kupferbarren und ein Knochenklang."
	]
	quest.4200000000220583.title: "Hör dem Wetter zu"
	quest.4200000000220584.quest_desc: [
		"Ein geschnitzter Tisch hält 27 Stapel. Übliche Gegenstandsröhren und Relais können seine Gaben teilen; Komparatoren lesen die Füllung, und Redstone sperrt den Zugang.",
		"So: eine Truhe, ein Gebundenes Echo, zwei Bretter und zwei Stein."
	]
	quest.4200000000220584.title: "Ein Platz am Herd"
	quest.4200000000220585.quest_desc: [
		"Setze den Hainhüter auf Höhe der Feldfrucht in ein Beet von 9 mal 9. Lege die Samen in die erste Reihe; die Ernten füllen die unteren zwei Reihen. Pflanzen kostet 4 Puls, Ernten und Neupflanzen kostet 12. Liefere Energie innerhalb von acht Blöcken. Ein voller Ausgang bewahrt die Feldfrucht; Redstone pausiert die Arbeit. Seit 5.0 will er ein waches Erd-Resonanztotem innerhalb von acht Blöcken, sonst steht er still und sagt, welche Stimme ihm fehlt. Halte auch ein Wasser-Totem in der Nähe, dann bewässert er jede Furche des Beetes.",
		"So: eine Eisenhacke, ein Erdsiegel, ein Gebundenes Echo, zwei Kupferbarren und zwei Bretter."
	]
	quest.4200000000220585.title: "Der Garten singt weiter"
	quest.4200000000220586.quest_desc: [
		"Acht Puls jede Sekunde halten feindliches Erscheinen innerhalb von 24 Blöcken fern. Vorhandene Kreaturen bleiben. Der Schutz verhindert auch feindliche Beschwörungen der Wiege, also halte deinen Beschwörungsplatz draußen. Redstone bringt den Schutz sofort zum Schweigen. Seit 5.0 will er ein waches Geist-Resonanztotem innerhalb von acht Blöcken, sonst steht er still und sagt, welche Stimme ihm fehlt.",
		"So: ein Geistsiegel, zwei Gebundene Echos, eine Echoscherbe und drei Bretter der Mark."
	]
	quest.4200000000220586.title: "Ruhe am Lagerrand"
	quest.4200000000220587.quest_desc: [
		"Der Weganker hält seinen eigenen Chunk für 16 Puls je Sekunde wach. Setze einen an einen fernen Relaisempfänger und halte seine örtliche Versorgung aufrecht. Höchstens 32 Anker dürfen in einer Dimension laufen. Redstone oder ein leerer Puffer gibt den Chunk frei. Seit 5.0 will er ein waches Erd-Resonanztotem innerhalb von acht Blöcken, sonst steht er still und sagt, welche Stimme ihm fehlt.",
		"So: zwei Kristalle der Mark, ein Enderauge, zwei Manifestierte Barren, ein Resonanzkern und drei Steine der Mark."
	]
	quest.4200000000220587.title: "Ein Lager, das sich erinnert"
	quest.4200000000220588.quest_desc: [
		"Benutze eine ungeladene Effigie schleichend an einer unterstützten Kreatur, um einen harmlosen Abdruck zu nehmen. Die Effigie merkt sich die Art. Bosse lassen sich nicht binden; der Kodex erklärt passende Geister und die Erneuerung.",
		"So: ein Knochenklang, zwei Geistergewebe, ein Resonanzkern und ein Gebundenes Echo."
	]
	quest.4200000000220588.title: "Leih dir eine lebende Stimme"
	quest.4200000000220589.quest_desc: [
		"Setze eine erweckte Effigie in den ersten Slot und Geistergewebe in den zweiten. Jede gelungene Beschwörung verbraucht 80 Puls, ein Geistergewebe und einen Bindefaden. Lass sicheren Boden innerhalb von drei Blöcken. Acht Wesen in der Nähe pausieren die Beschwörungswiege; Redstone pausiert alle Arbeit und die Automatisierung. Seit 5.0 will sie ein Geist-Resonanztotem, das innerhalb von acht Blöcken stehen bleibt, sonst steht sie still und sagt, welche Stimme fehlt.",
		"So: zwei Manifestierte Barren, ein Kristall der Mark, zwei Gebundene Echos, ein Resonanzkern und drei Markbretter."
	]
	quest.4200000000220589.title: "Eine Herdstelle für geliehenes Leben"
	quest.420000000022058A.quest_desc: [
		"Setze ein Geistssiegel in ein Ritualbecken. Bring Erd-, Luft- und Geisttotems innerhalb von acht Blöcken, 200 Puls in der Nähe und drei Geistergewebe in deinem Inventar. Benutze die geprägte Effigie auf dem Ritualbecken, um 512 Beschwörungsfäden zu wecken. Wenn alle verbraucht sind, wiederhole diesen Ritus, um die Bindung zu erneuern.",
		"So: Geistssiegel in einem Ritualbecken; Erd-, Luft- und Geisttotems innerhalb von 8; 200 Puls; drei Geistergewebe; benutze die geprägte Effigie."
	]
	quest.420000000022058A.title: "Drei Stimmen wecken den Faden"
	quest.420000000022058B.quest_desc: [
		"Schließe eine gelungene Beschwörung ab. Fehlgeschlagene oder blockierte Versuche verbrauchen keine Fäden und keine Gaben. Jede Bindung hält 512 gelungene Beschwörungen; die Beschwörungswiege abzubauen und neu zu setzen erneuert die Bindung nie. Der Tooltip der Effigie zeigt die übrigen Nutzungen, und ein Komparator liest die verbliebene Bindekraft der Wiege.",
		"So: schließe eine gelungene Beschwörung von der Beschwörungswiege ab. Fehlversuche verbrauchen nichts."
	]
	quest.420000000022058B.title: "Eine Antwort aus der Wiege"
	quest.4200000000228001.quest_desc: [
		"Jenseits der Tortrommel verbergen Steppe und Hochland der Mark versunkene Ahnenhallen. Hineingehen hakt das ab. Vier Überlieferungstafeln säumen jede Halle; lies jede. Die Truhen halten Webstuhlfaden, Echos, Geistergewebe und Siegel. Hohle Wächter stehen noch Wache.",
		"So: Tortrommel in die Mark und geh in eine Ahnenhalle; dann lies ihre vier Überlieferungstafeln."
	]
	quest.4200000000228001.title: "Die Hallen, die die Zeit hielten"
	quest.4200000000228002.quest_desc: [
		"Webstuhlfaden ist der Webstuhl, in der Hand: Truhen der Ahnenhallen halten zwei bis vier, der Unbesungene reißt sechzehn oder mehr los, und ein Ältester der Webstuhlnäher tauscht einen beim Stand Freund. Er ist das Reagenz der sechsten Stimme.",
		"So: Truhen der Ahnenhallen, der Unbesungene oder ein Ältester der Webstuhlnäher bei Freund."
	]
	quest.4200000000228002.title: "Ein Strang des Fadens selbst"
	quest.4200000000228003.quest_desc: [
		"Acht Stein der Mark um eine Echoscherbe ergeben zwei Überlieferungstafeln. Gesetzt zeigt eine Tafel ein Bruchstück der neun Stämme; Schleichnutzung im Kreativmodus wechselt, welche. Säum deine eigene Halle damit.",
		"So: acht Stein der Mark um eine Echoscherbe. Ergibt zwei."
	]
	quest.4200000000228003.title: "Schnitz, was du liest"
	quest.4200000000228004.quest_desc: [
		"Leder über Markbrettern um einen Resonanzkern. Der Trommelkreis im Hochland der Mark hält schon eine; diese setzt du daheim ein. Schlag sie viermal, einen Atemzug auseinander, und etwas Altes erhebt sich.",
		"So: drei Leder, fünf Markbretter und ein Resonanzkern."
	]
	quest.4200000000228004.title: "Eine Trommel, die nicht klingt"
	quest.4200000000228005.quest_desc: [
		"Der Unbesungene ist ein Trommelgeist in drei Phasen. Schlag: stemm dich schleichend gegen seine Schockwelle. Chor: hau die Echoweber nieder, die er ruft. Stille: er kann nicht verletzt werden, bis du die Stille Trommel mit demselben Rhythmus aus vier Schlägen triffst, der ihn betäubt und deinen Schaden verdoppelt. Bring geladene Pulszellen und einen Rückweg mit.",
		"So: kämpfe gegen den Unbesungenen an der Stillen Trommel. Schleich im Schlag; vier Schläge in der Stille."
	]
	quest.4200000000228005.title: "Die Trommel erinnert sich"
	quest.4200000000228006.quest_desc: [
		"Ein Herz des Unbesungenen pro Tod, neben Webstuhlfaden und Resonanzkernen. Es fertigt das Webstuhltotem und sonst nichts, also gib es mit Bedacht aus.",
		"So: der Unbesungene an der Stillen Trommel lässt eines pro Tod fallen."
	]
	quest.4200000000228006.title: "Die verstummte Trommel"
	quest.4200000000228007.quest_desc: [
		"Ein Herz des Unbesungenen zwischen Webstuhlfaden und Kristall der Mark, auf Brettern der Mark. Der Webstuhl tritt zu Erde, Feuer, Wasser, Luft und Geist: eine eigene Stimme für den Pulsresonator und die Abstimmung, die das Echo-Entweben und die Leybindung verlangen.",
		"So: ein Herz des Unbesungenen, vier Kristalle der Mark, zwei Webstuhlfaden und zwei Bretter der Mark."
	]
	quest.4200000000228007.title: "Die sechste Stimme"
	quest.4200000000228008.quest_desc: [
		"Ein Leeres Siegel und Webstuhlfaden. In eine Ritualfeuerschale eingesetzt, segnet das Webstuhlsiegel die Spannung: alle zwei Sekunden füllt es zwei Puls in die getragenen Zellen aller in Reichweite nach und leiht Glück.",
		"So: ein Leeres Siegel und Webstuhlfaden, formlos."
	]
	quest.4200000000228008.title: "Ein Siegel der Spannung"
	quest.4200000000228009.quest_desc: [
		"Webstuhlfaden und Kupferresonatoren auf Stein der Mark. Unter einer Stimme des Webstuhls lässt das Echo-Entweben das Gitter rückwärts laufen: ein Manifestierter Barren zu zwei Gebundenen Echos, Gebunden zu zwei Abgestimmten, Abgestimmt zu zwei Scherben, Geistergewebe zu zwei Wolle, ein Resonanzkern zu drei Manifestierten Barren, und jedes abgenutzte Werkzeug der Geisterausrüstung zu einem Manifestierten Barren.",
		"So: fünf Stein der Mark, Webstuhlfaden, zwei Kupferresonatoren und eine Geisterscherbe."
	]
	quest.4200000000228009.title: "Das Gitter, umgekehrt"
	quest.420000000022800A.quest_desc: [
		"Dreh den Sechsfachstab auf seine Webstuhlstimme. Anker zieht ein Ziel acht Blöcke auf dich zu, für sechs Puls; ein Schleichwurf ohne Ziel ist Stich, ein Blinzeln von sechs Blöcken durch die Luft für zehn. Hake dies ab, wenn du beide benutzt hast.",
		"So: Sechsfachstab auf Webstuhlstimme. Binde ein Ziel mit Anker, dann schleiche für Stich. Hake ab, wenn beide ausgelöst haben."
	]
	quest.420000000022800A.title: "Anker und Stich"
	quest.420000000022800B.quest_desc: [
		"Neun Stammeslager stehen in der Mark, eines je Strang: Hütten, ein Feuer, ein Stammesherd, ein Totem, ein Banner und vier Stammesverwandte. Rechtsklick auf einen Herd mit dem, was dieser Stamm bevorzugt, oder mit einer geladenen Pulszelle, und dein Ansehen bei ihnen steigt. Einen Verwandten zu verletzen kostet 25. Ein Stammbanner zu zerbrechen kostet 5, der Herd 40. Gewöhnliche Lagerblöcke kosten nichts.",
		"So: Rechtsklick auf einen Stammesherd der Mark mit dem, was dieser Stamm begünstigt, oder mit einer geladenen Pulszelle."
	]
	quest.420000000022800B.title: "Warm gehalten"
	quest.420000000022800C.quest_desc: [
		"Gast bei 50, Freund bei 150, Verwandter bei 400, Stimme bei 800. Tötungen nahe einem Herd und abgeschlossene Tauschgeschäfte zählen auch. Älteste handeln zwei Angebote je Rang: Splittsänger verkaufen Echos für Roherz, Siegelschneider verkaufen Siegel und Ritentafeln, Webstuhlnäher verkaufen Webstuhlfaden und einen Wegsteinkompass, und ab Rang Verwandter einen Webstuhlanker und ein Webstuhlsiegel. `/tribalpower standing` gibt alle neun aus.",
		"So: erreiche Freund (150) bei einem Stamm. /tribalpower standing."
	]
	quest.420000000022800C.title: "Auf gutem Fuß"
	quest.420000000022800D.quest_desc: [
		"Beim Stand Stimme drückt dir ein Ältester ein Stammesmal in die Hand, einmal. Es öffnet die Kodexseite dieses Stammes und ist die eine Zutat, ohne die ein Verwandtschaftstotem nicht auskommt.",
		"So: Stimme (800) bei einem Stamm; der Älteste gibt einmal ein Stammesmal."
	]
	quest.420000000022800D.title: "Neun einig"
	quest.420000000022800E.quest_desc: [
		"Halte ein Stammesmal. Das eines jeden Stammes ist anders; neun sind möglich.",
		"So: erreiche Stimme (800) bei einem Stamm; sein Ältester gibt das Mal einmal."
	]
	quest.420000000022800E.title: "Mal des Stammes"
	quest.420000000022800F.quest_desc: [
		"Ein Stammesmal, das Resonanztotem der Einstimmung dieses Stammes und zwei Geistergewebe. Ein Verwandtschaftstotem zählt als eine weitere eigene Stimme für den Pulsresonator und leiht den Stationen die Einstimmung seines Stammes, sodass neun Stämme das Lied des Lagers auf fünfzehn Stimmen tragen können.",
		"So: ein Stammesmal, das Resonanztotem dieses Stammes und zwei Geistergewebe im Fertigungsgitter."
	]
	quest.420000000022800F.title: "Eine Stimme, die keine Stimme ist"
	quest.4200000000228010.quest_desc: [
		"Der Trommler eines Lagers spielt alle paar Sekunden; stelle ein Trommelherz innerhalb von acht Blöcken neben einen, und jeder Schlag speist es mit zwei Puls. Hake dies ab, wenn ein Trommler dein Gitter speist.",
		"So: stelle ein Trommelherz innerhalb von 8 zu einem Lagertrommler; hake ab, wenn er Puls einspeist."
	]
	quest.4200000000228010.title: "Das Lager hält den Takt"
	quest.4200000000228011.quest_desc: [
		"Zwei Stein und das Reagenz um das Siegel; das Siegel wird zurückgegeben. Knotenwurzel neben einem Erdsiegel; 600 Puls. Zwanzig Minuten lang wachsen Feldfrüchte, Setzlinge und Stiele in den neun Chunks um das Becken schneller. Benutze die Ritustafel schleichend auf einem Ritualbecken mit diesem Siegel eingesetzt, in seinem Rituskreis (vier Sockel auf den Diagonalen, Kreide verbindet sie); der Puls wird aus dem Gitter im Umkreis von acht Blöcken gezogen.",
		"So: zwei Stein, eine Knotenwurzel und ein Erdsiegel, formlos; das Siegel kommt zurück."
	]
	quest.4200000000228011.title: "Ritentafel: Grüner Segen"
	quest.4200000000228012.quest_desc: [
		"Zwei Stein und das Reagenz um das Siegel; das Siegel wird zurückgegeben. Schilfzahn neben einem Wassersiegel; 400 Puls. Zwanzig Minuten Regen, für die Zisternen und die Feldfrüchte. Benutze die Ritustafel schleichend auf einem Ritualbecken mit diesem Siegel eingesetzt, in seinem Rituskreis (vier Sockel auf den Diagonalen, Kreide verbindet sie); der Puls wird aus dem Gitter im Umkreis von acht Blöcken gezogen.",
		"So: zwei Stein, ein Schilfzahn und ein Wassersiegel, formlos; das Siegel kommt zurück."
	]
	quest.4200000000228012.title: "Ritentafel: Regenruf"
	quest.4200000000228013.quest_desc: [
		"Zwei Stein und das Reagenz um das Siegel; das Siegel wird dir zurückgegeben. Sturmflügel neben einem Luftsiegel; 400 Puls. Vierzig Minuten klarer Himmel. Benutze die Tafel schleichend auf einer Ritualfeuerschale, in der dieses Siegel sitzt, in ihrem Rituskreis (vier Sockel auf den Diagonalen, Kreide verbindet sie); der Puls wird aus dem Gitter innerhalb von acht Blöcken gezogen.",
		"So: zwei Stein, ein Sturmflügel und ein Luftsiegel, formlos; das Siegel kommt zurück."
	]
	quest.4200000000228013.title: "Ritentafel: Aufklaren des Himmels"
	quest.4200000000228014.quest_desc: [
		"Zwei Stein und das Reagenz um das Siegel; das Siegel wird dir zurückgegeben. Glutherz neben einem Feuersiegel; 800 Puls. Treibt die Nacht zum nächsten Sonnenaufgang, für die ganze Welt. Benutze die Tafel schleichend auf einer Ritualfeuerschale, in der dieses Siegel sitzt, in ihrem Rituskreis (vier Sockel auf den Diagonalen, Kreide verbindet sie); der Puls wird aus dem Gitter innerhalb von acht Blöcken gezogen.",
		"So: zwei Stein, ein Glutherz und ein Feuersiegel, formlos; das Siegel kommt zurück."
	]
	quest.4200000000228014.title: "Ritentafel: Morgenruf"
	quest.4200000000228015.quest_desc: [
		"Zwei Stein und das Reagenz um das Siegel; das Siegel wird dir zurückgegeben. Wächtersiegel neben einem Geistersiegel; 600 Puls. Fünfzehn Minuten ohne feindliche Erscheinungen innerhalb von vierundsechzig Blöcken. Benutze die Tafel schleichend auf einer Ritualfeuerschale, in der dieses Siegel sitzt, in ihrem Rituskreis (vier Sockel auf den Diagonalen, Kreide verbindet sie); der Puls wird aus dem Gitter innerhalb von acht Blöcken gezogen.",
		"So: zwei Stein, ein Wächtersiegel und ein Geistersiegel, formlos; das Siegel kommt zurück."
	]
	quest.4200000000228015.title: "Ritentafel: Stille Nacht"
	quest.4200000000228016.quest_desc: [
		"Zwei Stein und das Reagenz um das Siegel; das Siegel wird dir zurückgegeben. Webstuhlfaden neben einem Webstuhlsiegel; 1.200 Puls. Verbindet das nächste Totem mit einem anderen innerhalb von vierundsechzig Blöcken durch eine dreißigminütige Leylinie, die Puls zwischen ihnen leitet. Benutze die Tafel schleichend auf einer Ritualfeuerschale, in der dieses Siegel sitzt, in ihrem Rituskreis (vier Sockel auf den Diagonalen, Kreide verbindet sie); der Puls wird aus dem Gitter innerhalb von acht Blöcken gezogen.",
		"So: zwei Stein, Webstuhlfaden und ein Webstuhlsiegel, formlos; das Siegel kommt zurück."
	]
	quest.4200000000228016.title: "Ritentafel: Leybindung"
	quest.4200000000228017.quest_desc: [
		"Führe irgendeinen Ritus aus. Hält das Gitter um die Feuerschale zu wenig Puls, wird nichts verbraucht, und die Schale sagt es.",
		"So: benutze schleichend eine beliebige Ritustafel auf einer Ritualfeuerschale in ihrem Rituskreis, mit passendem Siegel und Puls."
	]
	quest.4200000000228017.title: "Erster Ritus"
	quest.4200000000228018.quest_desc: [
		"Zwei Geistergewebe, eine Geisterscherbe und das Reagenz der Art. Benutze es an einem erwachsenen Vertrauten. Tiere: sechzig Prozent, der Zauber bleibt bei Fehlschlag. Überreste wollen Stimme bei ihrem Stamm, vierzig Prozent, der Zauber wird bei Fehlschlag verbraucht.",
		"So: zwei Geistergewebe, eine Geisterscherbe und ein Vertrautenreagenz (Dämmerungsamt, Laternenflaum, Sturmflügel und Ähnliches)."
	]
	quest.4200000000228018.title: "Ein Zauber für ein wildes Wesen"
	quest.4200000000228019.quest_desc: [
		"Ein gebundener Vertrauter folgt dir, teleportiert dir nach, verschwindet nie, du kannst ihn nicht verletzen, und er gibt das Doppelte, wenn du ihn bürstest. Laternenfuchs, Moosrücken und Dämmerhirsch bringen dich in Gang. Überreste brauchen Stimme. Ein Kämpfer und zwei Helfer dürfen folgen; Sitzende zählen nicht.",
		"So: benutze einen Bindungszauber an einem erwachsenen Vertrauten. Der Fortschritt löst beim ersten Bund aus."
	]
	quest.4200000000228019.title: "Ein Freund im Dunkel"
	quest.420000000022801A.quest_desc: [
		"Papier, Geistergewebe und eine Geisterscherbe. Benutze die Urkunde auf einem Spieler, um ihn in dein Lager einzuladen, oder in der Luft, um es zu sehen. `/tribalpower camp` erstellt, lädt ein, tritt bei, verlässt, wirft hinaus und benennt um.",
		"So: Papier, Geistergewebe und eine Geisterscherbe, formlos."
	]
	quest.420000000022801A.title: "Ein Lager vieler Stimmen"
	quest.420000000022801B.quest_desc: [
		"Lagergefährten teilen einen Lagertresor mit vierundfünfzig Plätzen hinter jedem Tiefenspeicher und jeder Wanderer-Umhängetasche, gelten als Besitzer der Geräte der anderen, bündeln zwölf Weganker und spiegeln ein Viertel ihres Stammesansehens auf das Lager. Ein Clowder ist nicht dieses Lager — /tribalpower camp create <name> ist es.",
		"So: /tribalpower camp create <name> (kein Clowder). Der Fortschritt löst beim ersten Lager aus."
	]
	quest.420000000022801B.title: "Ein Tresor, ein Budget"
	quest.420000000022801C.quest_desc: [
		"Eine Glasscheibe über einem Kupferresonator und einer Geisterscherbe. Gehalten zeigt die Linse die Leystärke, wo du stehst, und malt sie auf den Boden um dich; Schleich-Benutzung an einem Leysammler oder einem Vertrauten zeigt seine Zahlen.",
		"So: eine Glasscheibe, ein Kupferresonator und eine Geisterscherbe in einer Spalte."
	]
	quest.420000000022801C.title: "Die Ley sehen"
	quest.420000000022801D.quest_desc: [
		"Quarz über Redstone und einem Kupferresonator auf Stein der Mark. Auf einen beliebigen Pulshalter gerichtet gibt er Redstone von 0 bis 15 im Verhältnis zum Gespeicherten aus.",
		"So: Quarz, zwei Redstone, ein Kupferresonator und Stein der Mark."
	]
	quest.420000000022801D.title: "Eine Nadel für den Puls"
	quest.420000000022801E.quest_desc: [
		"Eine Redstonefackel über Redstone und einem Kupferresonator auf Stein der Mark. Er gibt Signal, wenn der anvisierte Halter seine Schwelle erreicht oder darüber liegt; Rechtsklick schaltet durch 25, 50, 75 und 100 Prozent. Die Teile einer von Puls getriebenen Automation.",
		"So: eine Redstonefackel, zwei Redstone, ein Kupferresonator und Stein der Mark."
	]
	quest.420000000022801E.title: "Eine Zeile im Lied"
	quest.420000000022801F.quest_desc: [
		"Benutze den Geisterkodex schleichend an einem beliebigen Stammesblock für einen schlichten Bericht: gespeicherter Puls, die Generatoren, die ihn speisen, die Einstimmungen innerhalb von acht Blöcken, was für das aktuelle Rezept fehlt, ein voller Ausgang, eine Redstone-Pause, ein ungeladenes Relaisende. Hake dies ab, wenn er dir etwas gesagt hat, das du nicht wusstest.",
		"So: benutze den Geisterkodex schleichend an einem Stammesblock; hake ab, wenn der Bericht einen echten Fehler nennt."
	]
	quest.420000000022801F.title: "Frag den Kodex, warum"
	quest.4200000000228020.quest_desc: [
		"Bitte einen Steinquell um Bruchstein. Stein wird nicht gemacht; Stein wird gebeten zu bleiben. Bruchstein braucht nur die Form und Puls; ein Erd-Totem innerhalb von acht Blöcken lässt ihn um Stein bitten.",
		"So: fünf Bruchstein, eine Echoscherbe und ein Trommelherz."
	]
	quest.4200000000228020.title: "Ein Quell aus Stein"
	quest.4200000000228021.quest_desc: [
		"Schließe irgendein Muster ab. Das Setzen ist das Ritual: verstreute Geräte sind kein Ritus.",
		"So: setze ein Ritusmuster aus dem Geisterkodex; der Fortschritt löst beim ersten vollen Kreis aus."
	]
	quest.4200000000228021.title: "Zieh den Kreis"
	quest.4200000000228022.quest_desc: [
		"Bitte einen Steinquell um seinen ersten Bruchstein. Stein wird nicht gemacht; Stein wird gebeten zu bleiben.",
		"So: lass den Steinquell laufen, bis Bruchstein erscheint. Fortschritt beim ersten Bleiben."
	]
	quest.4200000000228022.title: "Stein bleibt"
	quest.4200000000228023.quest_desc: [
		"Benutze den Geisterkodex schleichend am Quell, wenn er arbeitet. Hake dies ab, wenn der Bericht gespeicherten Puls oder ein fehlendes Totem nennt.",
		"So: benutze den Geisterkodex schleichend am Steinquell; hake ab, wenn der Bericht einen echten Fehler oder einen vollen Puffer nennt."
	]
	quest.4200000000228023.title: "Der Quell antwortet"
	quest.4200000000228024.quest_desc: [
		"Halte eine geladene Zelle am Quell, damit das Bitten nicht stockt.",
		"So: fülle eine Pulszelle an einem Trommelherz, dann hake dies ab, wenn der Quell gespeist ist."
	]
	quest.4200000000228024.title: "Eine Zelle am Quell"
	quest.4200000000228025.quest_desc: [
		"Das Netz findet das Erz nicht; das Netz gibt dem Erz einen Ort zum Landen. Setze es über eine Horchgrube.",
		"So: vier Stein der Mark, zwei Abgestimmte Echos, zwei Geistergewebe und ein Kupferresonator."
	]
	quest.4200000000228025.title: "Ein Netz, das hört"
	quest.4200000000228026.quest_desc: [
		"Vier Ankersteine halten die Ecken der Grube. Ohne sie hat das Netz keinen Stand.",
		"So: vier Stein der Mark über einer Echoscherbe. Ergibt vier."
	]
	quest.4200000000228026.title: "Vier Anker"
	quest.4200000000228027.quest_desc: [
		"Ruf das erste Erz durch eine Horchgrube herauf.",
		"So: Resonanznetz über einer Grube mit Ankersteinen; der Fortschritt löst beim ersten Erz aus."
	]
	quest.4200000000228027.title: "Frag den Boden"
	quest.4200000000228028.quest_desc: [
		"Goldgrus aus der Grube ist die nächste Stimme nach Eisen.",
		"So: frag den Boden weiter; hake ab, wenn Goldgrus in der Hand ist."
	]
	quest.4200000000228028.title: "Gold aus der Grube"
	quest.4200000000228029.quest_desc: [
		"Die Grube verbraucht Puls. Halte eine Zelle auf dem Netz, damit das Bitten nicht stockt.",
		"So: fülle eine Pulszelle an einem Trommelherz und setze sie dorthin, wo der Kodex es zeigt."
	]
	quest.4200000000228029.title: "Die Grube hält den Takt"
	quest.420000000022802A.quest_desc: [
		"Elf Torrahmen und der Schlussstein umringen den Weg. Ein fehlender Rahmen ist ein fehlender Schritt.",
		"So: sechs Stein der Mark, zwei Kupferbarren und eine Echoscherbe. Ergibt vier."
	]
	quest.420000000022802A.title: "Ein Rahmen für den Weg"
	quest.420000000022802B.quest_desc: [
		"Der Schlussstein ist der zwölfte Stein. Ohne ihn ist der Ring nur ein Muster.",
		"So: vier Torrahmen, ein Resonanzkern, eine Geisterscherbe und eine Pulszelle."
	]
	quest.420000000022802B.title: "Der Schlussstein"
	quest.420000000022802C.quest_desc: [
		"Zünde ein Wegtor. Elf Rahmen, ein Schlussstein und irgendwohin.",
		"So: schließe den Ring und zünde ihn; der Fortschritt löst aus, wenn der Weg sich öffnet."
	]
	quest.420000000022802C.title: "Öffne den Weg"
	quest.420000000022802D.quest_desc: [
		"Benutze das Siegel schleichend an einem Schlussstein, um ihn aufzuschreiben. Benutze es an einem zweiten Schlussstein, um die beiden zu binden.",
		"So: ein Leeres Siegel, Webstuhlfaden und eine Geisterscherbe, formlos."
	]
	quest.420000000022802D.title: "Schreib das Ziel"
	quest.420000000022802E.quest_desc: [
		"Reise durch ein Ferntor von einer Dimension in eine andere. Der Webstuhl war nie ein einziger Faden.",
		"So: binde zwei Schlusssteine mit einem Torsiegel, dann geh durch das Ferntor."
	]
	quest.420000000022802E.title: "Der lange Faden"
	quest.420000000022802F.quest_desc: [
		"Der Generator des Feuers. Setze ihn nahe an sein Totem; ein Trommelherz in der Hand kann diese Stimme nicht führen.",
		"So: drei Kupferbarren, ein Glutknoten, ein Feuersiegel und zwei Bretter der Mark."
	]
	quest.420000000022802F.title: "Die Stimme des Feuers"
	quest.4200000000228030.quest_desc: [
		"Der Generator des Winds. Setze ihn nahe an sein Totem, damit die sechs einander hören.",
		"So: vier Geistergewebe, ein Sturmflügel, ein Luftsiegel und zwei Bretter der Mark."
	]
	quest.4200000000228030.title: "Die Stimme des Winds"
	quest.4200000000228031.quest_desc: [
		"Der Generator des Wassers. Setze ihn nahe an sein Totem; Zisternen und Quellen hören diese Stimme.",
		"So: zwei Leder, drei Bretter der Mark, eine Knotenwurzel und ein Wassersiegel."
	]
	quest.4200000000228031.title: "Die Stimme des Wassers"
	quest.4200000000228032.quest_desc: [
		"Die Weckglocke ist der lange Ton des Geistes. Setze sie nahe an ihr Totem, mit den anderen fünf.",
		"So: ein Glockenfragment, vier Kupferbarren, ein Geistsiegel und eine Geisterscherbe."
	]
	quest.4200000000228032.title: "Das Erwachen der Erde"
	quest.4200000000228033.quest_desc: [
		"Der sechste Generator. Die Stimme des Webstuhls braucht Webstuhlfaden; der Unbesungene und die Ältesten der Webstuhlnäher bewahren ihn.",
		"So: vier Kristalle der Mark, zwei Webstuhlfäden, zwei Geistergewebe und ein Resonanzkern."
	]
	quest.4200000000228033.title: "Der sechste Generator"
	quest.4200000000228034.quest_desc: [
		"Ein Steinmal speichert Puls im Feld, damit sechs Stimmen sich einen Puffer teilen.",
		"So: sechs Stein der Mark, zwei Gebundene Echos und eine Pulszelle."
	]
	quest.4200000000228034.title: "Ein Steinmal aus Puls"
	quest.4200000000228035.quest_desc: [
		"Halte alle sechs Generatoren innerhalb von 32 Blöcken voneinander am Laufen, einen je Stimme.",
		"So: Gluthorn, Windharfe, Wellentrommel, Wachglocke, Webstuhlanker und Trommelherz innerhalb von 32. Fortschritt bei sechs Stimmen."
	]
	quest.4200000000228035.title: "Sechs Stimmen singen"
	quest.4200000000228036.quest_desc: [
		"Bittet eine Zisterne, weiterzugeben. Zehn Minuten Wasser, und das Siegel bleibt.",
		"So: benutze schleichend die Tafel auf einer Ritualfeuerschale in ihrem Rituskreis, mit passendem Siegel und Puls."
	]
	quest.4200000000228036.title: "Eine Quelle, die weitergibt"
	quest.4200000000228037.quest_desc: [
		"Der Trommelkreis, an den sich der Unbesungene noch erinnert. Optionales Andenken.",
		"So: der Unbesungene an der Stillen Trommel kann ihn fallen lassen. Wahlweise."
	]
	quest.4200000000228037.title: "Der Trommelkreis"
	quest.4200000000228038.quest_desc: [
		"Ein leeres Siegel nach dem ersten Ritus, bereit für den nächsten Kreis.",
		"So: Erster Ritus an der Feuerschale; hake ab, wenn ein leeres Ersatzsiegel in der Hand ist."
	]
	quest.4200000000228038.title: "Ein Ersatzsiegel"
	quest.4200000000228039.quest_desc: [
		"Die Feuerwerkstatt. Ein Feuer-Totem innerhalb von acht und Puls lassen jedes Ofenrezept laufen, auch Mineralgrus. Ein Trommelherz in der Hand kann diesen Ofen nicht halten.",
		"So: Ofen + Resonatoren + Klang. Feuer-Totem. Schmilzt Grus für Puls — ein Trommelherz in der Hand kann ihn nicht betreiben."
	]
	quest.4200000000228039.title: "Grus im Ofen"
	quest.420000000022803A.quest_desc: [
		"Webe ein Rezeptsiegel für eine Werkstatt. Leere Flaschen kehren in den Slot zurück, der sie hielt. Seiten-IO weist Zuschauer und andere Lager ab. Seit 5.0 will er ein waches Resonanztotem (Webstuhl) innerhalb von acht Blöcken, sonst steht er still und sagt, welche Stimme ihm fehlt.",
		"So: der Geisterkodex nennt die Fertigung des Siegelwebstuhls. Setze die Flaschen ein; sie kehren in diesen Slot zurück."
	]
	quest.420000000022803A.title: "Ein Webstuhl für Siegel"
	quest.420000000022803B.quest_desc: [
		"Vier billige Pulslampen (Leuchtschilf, Scherbenlampe, Echoleuchter, Glutschale) ziehen 1–2 Puls pro Sekunde aus dem Gitter. Redstone dimmt sie.",
		"So: fertige eine Scherbenlampe, setze sie innerhalb von acht Blöcken von Puls, dann dimme sie mit Redstone, wenn du Nacht willst."
	]
	quest.420000000022803B.title: "Eine Lampe, die Puls trinkt"
	quest.420000000022803C.quest_desc: [
		"Zehn Geisteramulette trägst du in drei Stammesplätzen, kein Curios. Himmel mit Luft ist kreativer Flug. Benutze schleichend ein Resonanztotem, um eine Stimme zu binden; Chor bindet jede nahe Stimme an einer Feuerschale.",
		"So: fertige das Himmelsamulett, dann benutze es schleichend an einem Lufttotem. Geisterkodex: Geisteramulette."
	]
	quest.420000000022803C.title: "Ein Amulett mit Stimme"
	quest.420000000022803D.quest_desc: [
		"Die Wasserwerkstatt. Stuf sie an Echostationen auf, genau wie Geisterausrüstung; höherer Rang verbraucht mehr Puls, während sie schneller wird. Der Rang bleibt beim Aufheben. Seit 5.0 will sie ein waches Wasser-Resonanztotem innerhalb von acht Blöcken, sonst steht sie still und sagt, welche Stimme ihr fehlt.",
		"So: Werkstattseiten des Geisterkodex. Setze die Gezeitenpumpe an eine Zisternenseite, dann benutze den Kodex schleichend, wenn sie stumm bleibt."
	]
	quest.420000000022803D.title: "Eine Pumpe für die Zisterne"
	quest.420000000022803E.quest_desc: [
		"Jeder Puls wird weiterhin zu 100 FE. Ohne Rang sind es 60 Puls pro Sekunde. Stuf den Adapter an der Echoabstimmung auf, dann an der Echobindung, dann am Echomanifest, und der Status mit leerer Hand nennt die aktuelle Rate. Er kann weiterhin kein FE empfangen.",
		"So: benutze schleichend einen Harmonischen Energetisierer an der Echoabstimmung, dann an der Echobindung, dann am Echomanifest. Hake ab, wenn die Diagnose eine Rate über 60 nennt."
	]
	quest.420000000022803E.title: "Den Strom stufen"
	quest.420000000022803F.quest_desc: [
		"Benutze schleichend jedes Teil der Geisterausrüstung oder ein Amulett an einem gesetzten Resonanztotem (40 Puls), um diese Stimme zu binden. Gemischte Sätze sind gewollt. Das Totem wird nicht verbraucht. Der Webstuhl braucht ein Webstuhl-Totem.",
		"So: benutze schleichend ein Werkzeug, ein Rüstungsteil oder ein Amulett an einem Totem mit 40 Puls in der Nähe. Hake ab, wenn der Tooltip die gebundene Stimme nennt."
	]
	quest.420000000022803F.title: "Binde eine Stimme"
	quest.4200000000228040.quest_desc: [
		"Eine Schilflampe. Billiges Pulslicht für einen Lagerpfad. Optional.",
		"So: fertige Leuchtschilf. Setze es nahe an Puls. Optional."
	]
	quest.4200000000228040.title: "Schilflicht"
	quest.4200000000228041.quest_desc: [
		"Eine Wandleuchte, die Puls trinkt. Optional.",
		"So: fertige den Echoleuchter und häng ihn auf. Optional."
	]
	quest.4200000000228041.title: "Echowandleuchte"
	quest.4200000000228042.quest_desc: [
		"Eine Schale Lagerfeuerlicht auf Puls. Optional.",
		"So: fertige die Glutschale. Optional."
	]
	quest.4200000000228042.title: "Glutschale"
	quest.4200000000228043.quest_desc: [
		"Häng ein Windamulett von der Decke. Lagermöbel der Mark: Hocker, Tisch, Urne, Matte, Regal und dieses. Optional.",
		"So: fertige das Windamulett und häng es auf. Optionales Andenken."
	]
	quest.4200000000228043.title: "Ein Amulett im Wind"
	quest.4200000000228044.quest_desc: [
		"Chor bindet jede nahe Totemstimme an einer Ritualfeuerschale. Optional, sobald Himmel in der Hand ist.",
		"So: fertige das Choramulett, dann benutze es schleichend an einer Feuerschale mit Stimmen in Reichweite. Optional."
	]
	quest.4200000000228044.title: "Jede Stimme in der Nähe"
	quest.4200000000228045.quest_desc: [
		"Die Axt verbraucht Puls wie die Spitzhacke. Stuf sie an Echostationen auf; benutze schleichend ein Totem, um eine Stimme zu binden. Optional.",
		"So: fertige die Axt der Geisterausrüstung. Optional, sobald die Spitzhacke da ist."
	]
	quest.4200000000228045.title: "Schneide fürs Holz"
	quest.4200000000228046.quest_desc: [
		"Ziegel und eine Schüssel über drei Kupfer. Stell ihn über ein brennendes Lagerfeuer, Feuer, Magma, Lava oder eine Glutschale; er verlangt überhaupt keinen Puls. Bis zu vier Zutaten und eine Schüssel, in beliebiger Reihenfolge, etwa zwölf Sekunden je Mahlzeit. Trichter speisen ihn von oben und von den Seiten und nehmen die Mahlzeit von unten.",
		"So: Ziegel und eine Schüssel über drei Kupfer. Stell ihn über ein Lagerfeuer, Feuer, Magma, Lava oder eine Glutschale; kein Puls."
	]
	quest.4200000000228046.title: "Ein Topf fürs Lager"
	quest.4200000000228047.quest_desc: [
		"Eine heiße rote Knolle aus der Glutöde. Was du pflückst, ist der Samen; pflanze ihn auf Ackerboden wie eine Kartoffel. Die Hacke der Geisterausrüstung erntet und pflanzt in einem Schwung neu.",
		"So: wächst wild in der Glutöde, durch eine Tortrommel. Was du pflückst, ist der Samen; pflanze ihn auf Ackerboden."
	]
	quest.4200000000228047.title: "Glutwurzel"
	quest.4200000000228048.quest_desc: [
		"Wächst wild im Schilfmoor. Pflücke ein Büschel und pflanze, was du gepflückt hast; vier Stufen auf geackerter Erde, und Bienen bestäuben es.",
		"So: wächst wild im Schilfmoor, durch eine Tortrommel. Pflanze, was du gepflückt hast, auf Ackerboden."
	]
	quest.4200000000228048.title: "Fennreis"
	quest.4200000000228049.quest_desc: [
		"Aus den Schneefeldern. Es zählt auch als Kraut für den Geisterkessel.",
		"So: wächst wild auf den Schneefeldern, durch eine Tortrommel. Pflanze, was du gepflückt hast, auf Ackerboden."
	]
	quest.4200000000228049.title: "Frostbeere"
	quest.420000000022804A.quest_desc: [
		"Vom Schimmergrat. Ein Kraut für den Kessel und zugleich eine Feldfrucht.",
		"So: wächst wild auf dem Schimmergrat, durch eine Tortrommel. Pflanze, was du gepflückt hast, auf Ackerboden."
	]
	quest.420000000022804A.title: "Schimmerbohne"
	quest.420000000022804B.quest_desc: [
		"Aus der Steppe, und das Korn, auf dem die meisten Stammesgerichte aufbauen. Zieh ein Beet davon, bevor du den Rest anbaust.",
		"So: wächst wild in der Steppe, durch eine Tortrommel. Pflanze, was du gepflückt hast, auf Ackerboden."
	]
	quest.420000000022804B.title: "Steppenkorn"
	quest.420000000022804C.quest_desc: [
		"Zwei Steppenkorn und ein Eisengrus im Herdtopf. Das Gericht eines Stammes zu essen trägt seine Gabe fünf Minuten; die der Splittsänger bricht mehr aus Erz. Sobald ein Stamm dich Freund nennt, verkaufen seine Verwandten das Gericht für vier seiner Feldfrucht, und einem Stamm sein eigenes Gericht an seinem Herd anzubieten bringt sechs Ansehen.",
		"So: zwei Steppenkorn und ein Eisengrus in einem Herdtopf über Hitze. Verwandte der Splittsänger verkaufen es bei Freund."
	]
	quest.420000000022804C.title: "Der Laib der Splittsänger"
	quest.420000000022804D.quest_desc: [
		"Zweimal Rohes Wild und eine Glutwurzel. Rohes Wild fällt von den Wildtieren der Mark. Die Gabe der Randgänger: du fällst nie, solange du schleichst. Jeder Stamm hat ein Gericht; JEI listet alle neun unter dem Topf.",
		"So: zweimal Rohes Wild und eine Glutwurzel in einem Herdtopf. Rohes Wild fällt von Wildtieren der Mark."
	]
	quest.420000000022804D.title: "Das Dörrfleisch der Randgänger"
	quest.420000000022804E.quest_desc: [
		"Hüterwurzelbrei, Grusgebackenes Brot, eine Glutwurzel und Steppenkorn in den Topf. Setz das Festmahl auf einen festen Block, und es hält sechs Portionen; jede macht dich satt und gewährt den Segen der Erde für acht Minuten — du gräbst schneller, du stehst fest. Jede Stimme hat ein Festmahl aus ihren eigenen Gerichten.",
		"So: Hüterwurzelbrei, Grusgebackenes Brot, Glutwurzel und Steppenkorn in einem Herdtopf. Stell es hin; sechs Portionen."
	]
	quest.420000000022804E.title: "Ein Tisch fürs Lager"
	quest.420000000022804F.quest_desc: [
		"Knochen und Eisen um einen Kessel, ein Knochenklang darunter. Setz ihn über Hitze. Drei Sitze: ein rohes Reagenz aus deinem Beutel, ein Kraut der Mark und eine Basis — eine Glasflasche ergibt zwei Tinkturen, eine Wabe zwei Salben, Holzkohle vier Räucherwerk. Eine Charge dauert zehn Sekunden und 24 Puls aus dem Gitter. Das nächste Totem innerhalb von acht Blöcken singt in den Sud.",
		"So: Knochen und Eisen um einen Kessel, ein Knochenklang darunter. Setz ihn über Hitze; ein Totem innerhalb von 8 formt den Sud."
	]
	quest.420000000022804F.title: "Ein Kessel über dem Feuer"
	quest.4200000000228050.quest_desc: [
		"Die Familie des Reagenzes wählt das Mittel: Zunder ist Stärke, Kühlung ist Feuerresistenz, Gegengift hebt Vergiftung auf, Flicken ist Regeneration, und so weiter. Eine Tinktur hält drei Minuten und gibt die Flasche zurück. Jedes Mittel hebt Geistkrankheit, die Unbesungene Stille, Ausgefranst und Leykrankheit auf.",
		"So: Geisterkessel — ein rohes Reagenz, ein Kraut der Mark und eine Glasflasche. Zehn Sekunden, 24 Puls, zwei Tinkturen."
	]
	quest.4200000000228050.title: "Trink es"
	quest.4200000000228051.quest_desc: [
		"Wabe als Basis. Benutze eine Salbe an dir, oder an einem Freund, einem Dorfbewohner oder deinem Vertrauten: drei Herzen auf einmal, jeder schädliche Effekt weg, und das Mittel für die halbe Zeit einer Tinktur. Ein Stapel davon ist der Unterschied zwischen einer harten Nacht in der Mark und einem Heimweg.",
		"So: Geisterkessel — ein rohes Reagenz, ein Kraut der Mark und eine Wabe. Zwei Salben je Sud."
	]
	quest.4200000000228051.title: "Trag es auf"
	quest.4200000000228052.quest_desc: [
		"Holzkohle als Basis. Setze Räucherwerk in eine Ritualfeuerschale — bis zu sechzehn Stäbchen, ohne Siegel und ohne Puls — und alle zwei Sekunden erhält jeder innerhalb von acht Blöcken das Mittel, und Vertraute werden um ein Herz geflickt. Jedes Stäbchen brennt dreißig Sekunden. Redstone löscht es; schleiche mit leeren Händen, um es zurückzunehmen.",
		"So: Geisterkessel — ein rohes Reagenz, ein Kraut der Mark und Holzkohle. Vier Räucherwerke je Sud; verbrenne sie in einer Ritualfeuerschale."
	]
	quest.4200000000228052.title: "Brenne es für alle"
	quest.4200000000228053.quest_desc: [
		"Zwei Knochenklänge um einen Manifestierten Barren auf einem Stock. Halte Benutzen, und jede halbe Sekunde flickt es, wen du innerhalb von sechs Blöcken ansiehst, oder dich: drei Viertel eines Herzens für 2 Puls. Es wird an den Echo-Stationen eingestuft wie die übrige Geisterausrüstung; ab Gebunden nimmt jedes Schütteln die Geistkrankheit um eine Stufe zurück.",
		"So: zwei Knochenklänge um einen Manifestierten Barren auf einem Stock. Halte Benutzen, um zu flicken, wen du ansiehst."
	]
	quest.4200000000228053.title: "Schüttle es"
	quest.4200000000228054.quest_desc: [
		"Bruchstein über einem Magmablock ergibt vier. Über Hitze dampfen sie. Schlaf die ganze Nacht in einem Bett, mit heißen Steinen innerhalb von fünf Blöcken und einem Dach über dir: du wachst voll geheilt und gereinigt auf, mit zehn Minuten Geistsegen, damit die Krankheit nicht Fuß fasst.",
		"So: Bruchstein über einem Magmablock ergibt vier. Setz sie über Hitze, innerhalb von fünf Blöcken eines überdachten Bettes."
	]
	quest.4200000000228054.title: "Eine Nacht in der Hütte"
	quest.4200000000228055.quest_desc: [
		"Zwei Stein, eine Moosrückenschuppe und Geisterrohr um ein Geistersiegel; das Siegel wird zurückgegeben. Wirke es auf einer Feuerschale mit sitzendem Geistersiegel, in ihrem Rituskreis, für 500 Puls: alle innerhalb von zwölf Blöcken werden um zehn Herzen geheilt, gereinigt und gesegnet, und der Kreis bleibt zehn Minuten offen. Leg zuerst den Geisterüberrest eines gefallenen Vertrauten auf einen Sockel, dann kommt er ganz zurück.",
		"So: zwei Stein, eine Moosrückenschuppe, Geisterrohr und ein Geistersiegel, formlos; das Siegel kommt zurück. Wirke es auf einer versiegelten Feuerschale in ihrem Rituskreis."
	]
	quest.4200000000228055.title: "Ritentafel: Heilkreis"
	quest.4200000000228056.quest_desc: [
		"Ein Manifestierter Barren, ein Knochenklang und ein Stock auf der Diagonale. Sieben Schaden, Reichweite plus eineinhalb, und ein Stoß im Sprint trifft 35 Prozent härter. Darunter steht Klinge: sie wird an den Echo-Stationen eingestuft, gibt Puls für Echo-Schläge aus und nimmt eine Totemstimme an. Sie hält einen Risshund auf Armeslänge.",
		"So: Manifestierter Barren, Knochenklang und ein Stock auf der Diagonale. Wird an den Echo-Stationen eingestuft wie die Klinge."
	]
	quest.4200000000228056.title: "Zuerst die Reichweite"
	quest.4200000000228057.quest_desc: [
		"Vier Manifestierte Barren als T über einem Knochenklang. Zehn Schaden, Reichweite plus ein Halbes, schwer — es bremst deinen Gang, solange es in der Hand ist — und der weiteste, stärkste Schwung der Familie. Hellebarde, Streitaxt, Kriegshammer, Dolch, Sense und Dreizack werden genauso gemacht; jedes tauscht Reichweite, Tempo und Gewicht gegen die anderen.",
		"So: vier Manifestierte Barren als T über einem Knochenklang. Schwer; der weiteste Schwung."
	]
	quest.4200000000228057.title: "Der weiteste Schwung"
	quest.4200000000228058.quest_desc: [
		"Faden und Kupferresonatoren um einen Knochenklang. Er schießt Schallbolzen mit Puls aus den Zellen, die du trägst, und nimmt Verspfeile. Schnell wieder zu lösen, und ein halber Auszug, wenn du es eilig hast.",
		"So: Faden und Kupferresonatoren um einen Knochenklang. Schießt Schallbolzen mit getragenem Puls."
	]
	quest.4200000000228058.title: "Ein Bogen, der singt"
	quest.4200000000228059.quest_desc: [
		"Manifestierte Barren zu beiden Seiten eines Pulsbogens, ein Stolperdrahthaken und Stöcke darunter. Halte Benutzen gedrückt zum Laden — 10 Puls im Voraus, etwas länger als ein voller Zug — dann noch einmal benutzen, um zu schießen. Es trifft etwa anderthalbmal so hart, fliegt fast gerade und hält den Schuss, solange du willst.",
		"So: Manifestierte Barren zu beiden Seiten eines Pulsbogens, Stolperdrahthaken und Stöcke darunter. Halte Benutzen zum Laden, benutze zum Schießen."
	]
	quest.4200000000228059.title: "Die schwerere Schwester des Bogens"
	quest.420000000022805A.quest_desc: [
		"Die Gesangsbank hat einen Waffensitz neben der Ausgabe. Stelle ein Totem in Reichweite mit Puls im Gitter, halte deinen Reagenzbeutel in der Schnellleiste mit vier gestärkten Reagenzien einer Art, setze eine Waffe der Geisterausrüstung in den Sitz, wähle das Reagenz und drücke Salbung: vier Reagenzien und 32 Puls. Sengung brennt, Sturmruf schlägt Blitze im Bogen, Blutdurst stiehlt Leben, Flicken repariert die Waffe — elf insgesamt, eine nach der anderen; ein anderes Reagenz ersetzt sie. Nur Geisterausrüstung nimmt die Arbeit der Bank an, es sei denn, ein Pack öffnet tribalpower:anointable. Hake dies ab, wenn eine Waffe eine trägt.",
		"So: Waffe der Geisterausrüstung im Waffensitz der Gesangsbank, vier gestärkte Reagenzien im Beutel, 32 Puls; drücke Salbung. Hake ab, wenn sie gesalbt ist."
	]
	quest.420000000022805A.title: "Ein Reagenz in der Klinge"
	quest.420000000022805B.quest_desc: [
		"Ranken um Geisterrohr und eine Enderperle ergeben zwei. Setze je einen auf jede Etage derselben Säule; sie finden einander, ohne Verknüpfung und ohne Energie. Springe, um zum nächsten Aufzug darüber zu steigen, schleiche, um zum unteren zu sinken, bis zu 48 Blöcke in jede Richtung. Ein Aufzug mit einer Decke darauf wird übersprungen.",
		"So: Ranken um Geisterrohr und eine Enderperle ergeben zwei. Staple sie in einer Säule; springe hoch, schleiche runter."
	]
	quest.420000000022805B.title: "Die Säule hinauf"
	quest.420000000022805C.quest_desc: [
		"Geisterrohr unter einer Schnur. Benutze es an einer Kreatur, um sie zu nehmen, und an einem Block, um sie abzusetzen, heil und ganz. Nie ein Spieler, ein Boss oder eine Elite der Mark. Gewebt hat zwei Nutzungen — eine Fahrt; Urnen aus Kupfer, manifestierte und resonante tragen mehr, und die resonante nutzt sich nie ab. Es nimmt keine Kreatur, wenn nur noch eine Nutzung übrig ist.",
		"So: Geisterrohr unter einer Schnur. Benutze es an einer Kreatur, um sie zu nehmen, an einem Block, um sie abzusetzen. Zwei Nutzungen."
	]
	quest.420000000022805C.title: "Trag eine Kreatur heim"
	quest.420000000022805D.quest_desc: [
		"Leder über Brettern um einen Notenblock. Der Torritus als Spiel ohne Portal am Ende: jede Spur, die er enthält, gespielt auf A, S, D, F, wenn die Schläge die Linie erreichen. Er merkt deine beste Punktzahl je Spur und eine Liste der fünf Besten des Servers. Übe hier, bevor du eine echte Tortrommel spielst.",
		"So: Leder über Brettern um einen Notenblock. Benutze ihn, um eine Spur zu wählen und A, S, D, F zu spielen."
	]
	quest.420000000022805D.title: "Trommeln aus Freude"
	quest.420000000022805E.quest_desc: [
		"Vier Leuchtstein um ein Geist-Siegel, zwei Manifestierte Barren, eine goldene Karotte und Geistergewebe. Benutze es, um es zu tragen; Schleich-Benutzung öffnet die drei Amulettplätze. Das Laternenamulett trägt die Geist-Stimme: Nachtsicht, und jeder Stimmensegen auf dir hält um die Hälfte länger. Getragene Amulette kosten 2 Puls je Stimme alle zwei Sekunden aus einer getragenen Pulszelle.",
		"So: vier Leuchtstein um ein Geist-Siegel, zwei Manifestierte Barren, eine goldene Karotte und Geistergewebe. Benutze es, um es zu tragen; Schleich-Benutzung öffnet die Plätze."
	]
	quest.420000000022805E.title: "Ein Licht, das du trägst"
	quest.420000000022805F.quest_desc: [
		"Sobald ein Stamm dich Gast nennt, rechtsklicke seinen Ältesten und rede. Bitte um Arbeit, und sie geben dir eine Bitte — drei offen am Tag, eine gehalten je Stamm, jede zahlt Ansehen und jede dritte ein Stammesmal. Bitte um ihre Geschichte, und ein Weg von sieben Schritten beginnt: Freund, das, was sie schätzen, Jagd nahe ihren Feuern, ein Ritus in ihrem Lager, ihr Gericht gekocht, und wohin sie dich schicken. Der letzte Schritt ist eine Prüfung gegen einen Wächter. Beende eine Geschichte und halte ihre Reliquie.",
		"So: rechtsklicke den Ältesten eines Stammes ab Gast oder besser und bitte um ihre Geschichte; sieben Schritte enden bei einem Wächter. Der Fortschritt löst bei der ersten Reliquie aus."
	]
	quest.420000000022805F.title: "Eine erzählte Geschichte"
	quest.4200000000228060.quest_desc: [
		"Das Relikt der Plattformhüter. Ihre Geschichte endet beim Stampedegeist am Zertretenen Ring auf der Steppe; gewinne die Prüfung, und der Älteste händigt es dir aus. Irgendwo im Inventar getragen hält es ihren Segen auf dir, egal wie dein Ansehen steht: du zertrittst nie ein Feld.",
		"So: beende die Geschichte der Plattformhüter mit ihrem Ältesten; die Prüfung ist der Stampedegeist auf der Steppe."
	]
	quest.4200000000228060.title: "Behütete Glut"
	quest.4200000000228061.quest_desc: [
		"Das Relikt der Splittsänger. Ihre Geschichte endet bei der Prismenschlange, am Singenden Riss in den Kristallfeldern; gewinne die Prüfung, und der Älteste gibt dir das Relikt. Irgendwo im Inventar getragen, hält es ihren Segen auf dir, egal wie dein Ansehen steht: du brichst mehr aus Erz.",
		"So: beende die Geschichte der Splittsänger mit ihrem Ältesten; die Prüfung ist die Prismenschlange in den Kristallfeldern."
	]
	quest.4200000000228061.title: "Klingerstein"
	quest.4200000000228062.quest_desc: [
		"Das Relikt der Wurzelbinder. Ihre Geschichte endet bei der Sumpfmatriarchin, an der Ertrunkenen Wurzel im Schilfmoor; gewinne die Prüfung, und der Älteste gibt dir das Relikt. Irgendwo im Inventar getragen, hält es ihren Segen auf dir, egal wie dein Ansehen steht: die Feldfrüchte beeilen sich um dich.",
		"So: beende die Geschichte der Wurzelbinder mit ihrem Ältesten; die Prüfung ist die Sumpfmatriarchin im Schilfmoor."
	]
	quest.4200000000228062.title: "Erste Wurzel"
	quest.4200000000228063.quest_desc: [
		"Das Relikt der Randgänger. Ihre Geschichte endet beim Sturmroc, am Horst auf dem Hochland; gewinne die Prüfung, und der Älteste gibt dir das Relikt. Irgendwo im Inventar getragen, hält es ihren Segen auf dir, egal wie dein Ansehen steht: du fällst nie, solange du schleichst.",
		"So: beende die Geschichte der Randgänger mit ihrem Ältesten; die Prüfung ist der Sturmroc auf dem Hochland."
	]
	quest.4200000000228063.title: "Brückennagel"
	quest.4200000000228064.quest_desc: [
		"Das Relikt der Trommelherzen. Ihre Geschichte endet beim Schlacketitan, am Schlackenthron in der Glutöde; gewinne die Prüfung, und der Älteste gibt dir das Relikt. Irgendwo im Inventar getragen, hält es ihren Segen auf dir, egal wie dein Ansehen steht: du schwingst schneller.",
		"So: beende die Geschichte der Trommelherzen mit ihrem Ältesten; die Prüfung ist der Schlacketitan in der Glutöde."
	]
	quest.4200000000228064.title: "Stete Trommel"
	quest.4200000000228065.quest_desc: [
		"Das Relikt der Musterweber. Ihre Geschichte endet beim Gezeitentrommler, am Gezeitenstein im Flachwasser; gewinne die Prüfung, und der Älteste gibt sie dir. Irgendwo im Inventar getragen, hält sie ihren Segen auf dir, egal wie dein Ansehen steht: Echo-Stationen in deiner Nähe leisten das Doppelte.",
		"So: beende die Geschichte der Musterweber bei ihrem Ältesten; die Prüfung ist der Gezeitentrommler im Flachwasser."
	]
	quest.4200000000228065.title: "Stilles Zahnrad"
	quest.4200000000228066.quest_desc: [
		"Das Relikt der Koloniehüter. Ihre Geschichte endet beim Grabhügelgeist, am Grabhügelring auf den Schneefeldern; gewinne die Prüfung, und der Älteste gibt sie dir. Irgendwo im Inventar getragen, hält sie ihren Segen auf dir, egal wie dein Ansehen steht: du wirst nie gestochen.",
		"So: beende die Geschichte der Koloniehüter bei ihrem Ältesten; die Prüfung ist der Grabhügelgeist auf den Schneefeldern."
	]
	quest.4200000000228066.title: "Stocksiegel"
	quest.4200000000228067.quest_desc: [
		"Das Relikt der Siegelschneider. Ihre Geschichte endet beim Gewölbewächter, am Versiegelten Tor auf dem Schimmergrat; gewinne die Prüfung, und der Älteste gibt sie dir. Irgendwo im Inventar getragen, hält sie ihren Segen auf dir, egal wie dein Ansehen steht: deine Amulette verlangen den halben Puls.",
		"So: beende die Geschichte der Siegelschneider bei ihrem Ältesten; die Prüfung ist der Gewölbewächter auf dem Schimmergrat."
	]
	quest.4200000000228067.title: "Höfliches Siegel"
	quest.4200000000228068.quest_desc: [
		"Das Relikt der Webstuhlnäher. Ihre Geschichte endet beim Unbesungenen, an der Stillen Trommel; gewinne die Prüfung, und der Älteste gibt sie dir. Irgendwo im Inventar getragen, hält sie ihren Segen auf dir, egal wie dein Ansehen steht: du singst billiger.",
		"So: beende die Geschichte der Webstuhlnäher bei ihrem Ältesten; die Prüfung ist der Unbesungene an der Stillen Trommel."
	]
	quest.4200000000228068.title: "Neunter Faden"
	quest.4200000000228069.quest_desc: [
		"Jede Stammesgeschichte ist zu Ende: acht Wächter gestellt und der Unbesungene. Mit allen neun Relikten im Inventar liegt das Neunte Abkommen in Reichweite. `/tribalpower standing` zeigt, wo du bei jedem Stamm stehst.",
		"So: beende alle neun Geschichten. Der Fortschritt löst aus, wenn das neunte Relikt in der Hand ist."
	]
	quest.4200000000228069.title: "Neun Relikte"
	quest.420000000022806A.quest_desc: [
		"Der Schlackenthron in der Glutöde: ein Ring aus Stein mit einem Wächteraltar in der Mitte, auf poliertem Tiefenschiefer, zwischen vier brennenden Kerzen, unter freiem Himmel. Benutze den Altar schleichend mit leerer Hand, und er sagt dir, was er will — acht Magmaschuppen — dann leg sie darauf und tritt zurück. Schleiche, um dich gegen seine Schläge zu stemmen; wird er wild, entzünden sich die Ringe, und Glutkobolde steigen aus der Schlacke. Bei halber Gesundheit wird er wild und ruft die Kreaturen seines Landes, die nichts fallen lassen. Lass ihn eine halbe Minute in Ruhe, und er schläft wieder ein; der Altar ruht zwanzig Minuten zwischen den Rufen. Er lässt den Schlackekern fallen, und sein Fall beendet die Geschichte der Trommelherzen.",
		"So: benutze den Wächteraltar des Landes schleichend mit leerer Hand, lege acht von dem Reagenz darauf, das er nennt, und siege. Der Fortschritt löst beim Töten aus."
	]
	quest.420000000022806A.title: "Schlacketitan gestillt"
	quest.420000000022806B.quest_desc: [
		"Die Ertrunkene Wurzel im Schilfmoor: ein Ring aus Stein mit einem Wächteraltar in der Mitte, auf poliertem Tiefenschiefer, zwischen vier brennenden Kerzen, unter freiem Himmel. Benutze den Altar schleichend mit leerer Hand, und er sagt dir, was er will — acht Schilfzähne — dann leg sie darauf und tritt zurück. Ihre Schlinge zieht dich heran und verlangsamt dich; bleib auf festem Boden und schlag die Schilfpirscher nieder, die sie ruft. Bei halber Gesundheit wird sie wild und ruft die Kreaturen ihres Landes, die nichts fallen lassen. Lass sie eine halbe Minute in Ruhe, und sie schläft wieder ein; der Altar ruht zwanzig Minuten zwischen den Rufen. Sie lässt das Moorherz fallen, und ihr Fall beendet die Geschichte der Wurzelbinder.",
		"So: benutze den Wächteraltar des Landes schleichend mit leerer Hand, lege acht von dem Reagenz darauf, das er nennt, und siege. Der Fortschritt löst beim Töten aus."
	]
	quest.420000000022806B.title: "Sumpfmatriarchin gestillt"
	quest.420000000022806C.quest_desc: [
		"Der Grabhügelring auf den Schneefeldern: ein Ring aus Stein mit einem Wächteraltar in der Mitte, auf poliertem Tiefenschiefer, zwischen vier brennenden Kerzen, unter freiem Himmel. Benutze den Altar schleichend mit leerer Hand, und er sagt dir, was er will — acht Reifmandibeln — dann leg sie darauf und tritt zurück. Sein Atem gefriert alles vor ihm. Geh hinter ihn; die Reifkriecher, die er ruft, sind langsam. Bei halber Gesundheit wird er wild und ruft die Kreaturen seines Landes, die nichts fallen lassen. Lass ihn eine halbe Minute in Ruhe, und er schläft wieder ein; der Altar ruht zwanzig Minuten zwischen den Rufen. Er lässt den Grabhügelstein fallen, und sein Fall beendet die Geschichte der Koloniehüter.",
		"So: benutze den Wächteraltar des Landes schleichend mit leerer Hand, lege acht von dem Reagenz darauf, das er nennt, und siege. Der Fortschritt löst beim Töten aus."
	]
	quest.420000000022806C.title: "Grabhügelgeist gestillt"
	quest.420000000022806D.quest_desc: [
		"Der Singende Riss in den Kristallfeldern: ein Ring aus Stein mit einem Wächteraltar in der Mitte, auf poliertem Tiefenschiefer, zwischen vier brennenden Kerzen, unter freiem Himmel. Benutze den Altar schleichend mit leerer Hand, und er sagt dir, was er will — acht Prismenpanzer — dann leg sie darauf und tritt zurück. Sie schießt Lichtblitze, die dich leuchtend markieren. Weiche seitlich aus, geh ran und achte auf den zweiten Blitz, den sie hinzufügt, sobald sie wild wird. Bei halber Gesundheit wird sie wild und ruft die Kreaturen ihres Landes, die nichts fallen lassen. Lass sie eine halbe Minute in Ruhe, und sie schläft wieder ein; der Altar ruht zwanzig Minuten zwischen den Rufen. Sie lässt den Prismenkern fallen, und ihr Fall beendet die Geschichte der Splittsänger.",
		"So: benutze den Wächteraltar des Landes schleichend mit leerer Hand, lege acht von dem Reagenz darauf, das er nennt, und siege. Der Fortschritt löst beim Töten aus."
	]
	quest.420000000022806D.title: "Prismenschlange gestillt"
	quest.420000000022806E.quest_desc: [
		"Das Versiegelte Tor auf dem Schimmergrat: ein Ring aus Stein mit einem Wächteraltar in der Mitte, auf poliertem Tiefenschiefer, zwischen vier brennenden Kerzen, unter freiem Himmel. Benutze den Altar schleichend mit leerer Hand, und er sagt dir, was er will — acht Wächtersiegel — dann leg sie darauf und tritt zurück. Die schwerste Rüstung der Mark und ein Schwung, der dich vom Grat wirft. Wild geworden schützt er sich jeweils drei Sekunden: warte es ab. Bei halber Gesundheit wird er wild und ruft die Kreaturen seines Landes, die nichts fallen lassen. Lass ihn eine halbe Minute in Ruhe, und er schläft wieder ein; der Altar ruht zwanzig Minuten zwischen den Rufen. Er lässt das Gewölbesiegel fallen, und sein Fall beendet die Geschichte der Siegelschneider.",
		"So: benutze den Wächteraltar des Landes schleichend mit leerer Hand, lege acht von dem Reagenz darauf, das er nennt, und siege. Der Fortschritt löst beim Töten aus."
	]
	quest.420000000022806E.title: "Gewölbewächter gestillt"
	quest.420000000022806F.quest_desc: [
		"Der Gezeitenstein im Flachwasser: ein Ring aus Stein mit einem Wächteraltar in der Mitte, auf poliertem Tiefenschiefer, zwischen vier brennenden Kerzen, unter freiem Himmel. Benutze den Altar schleichend mit leerer Hand, und er nennt, was er will — acht Solezähne — dann lege sie darauf und tritt zurück. Jeder Schlag zieht alle zu ihm und tut weh. Kämpfe vom Ufer aus, den Rücken an etwas Festem. Bei halber Gesundheit ist er erwacht und ruft die Kreaturen seines Landes, die nichts fallen lassen. Lass ihn eine halbe Minute in Ruhe, und er schläft wieder ein; der Altar ruht zwanzig Minuten zwischen den Rufen. Er lässt die Gezeitenschale fallen, und sein Fall beendet die Geschichte der Musterweber.",
		"So: benutze den Wächteraltar des Landes schleichend mit leerer Hand, lege acht von dem Reagenz darauf, das er nennt, und siege. Der Fortschritt löst beim Töten aus."
	]
	quest.420000000022806F.title: "Gezeitentrommler gestillt"
	quest.4200000000228070.quest_desc: [
		"Der Zertretene Ring auf der Steppe: ein Ring aus Stein mit einem Wächteraltar in der Mitte, auf poliertem Tiefenschiefer, zwischen vier brennenden Kerzen, unter freiem Himmel. Benutze den Altar schleichend mit leerer Hand, und er nennt, was er will — acht Schienbeinsehnen — dann lege sie darauf und tritt zurück. Er stürmt. Weiche zur Seite aus und triff ihn, wenn er vorbeizieht; wenn Bauknirscher auftauchen, stell dich auf einen Block. Bei halber Gesundheit ist er erwacht und ruft die Kreaturen seines Landes, die nichts fallen lassen. Lass ihn eine halbe Minute in Ruhe, und er schläft wieder ein; der Altar ruht zwanzig Minuten zwischen den Rufen. Er lässt das Herdenhorn fallen, und sein Fall beendet die Geschichte der Plattformhüter.",
		"So: benutze den Wächteraltar des Landes schleichend mit leerer Hand, lege acht von dem Reagenz darauf, das er nennt, und siege. Der Fortschritt löst beim Töten aus."
	]
	quest.4200000000228070.title: "Stampedegeist gestillt"
	quest.4200000000228071.quest_desc: [
		"Der Horst auf dem Hochland: ein Ring aus Stein mit einem Wächteraltar in der Mitte, auf poliertem Tiefenschiefer, zwischen vier brennenden Kerzen, unter freiem Himmel. Benutze den Altar schleichend mit leerer Hand, und er nennt, was er will — acht Sturmflügel — dann lege sie darauf und tritt zurück. Er stürzt herab und wirft dich in die Luft; ist er erwacht, folgt jedem Sturzflug ein Blitz. Ein Bogen und ein Dach helfen mehr als ein Schild. Bei halber Gesundheit ist er erwacht und ruft die Kreaturen seines Landes, die nichts fallen lassen. Lass ihn eine halbe Minute in Ruhe, und er schläft wieder ein; der Altar ruht zwanzig Minuten zwischen den Rufen. Er lässt die Sturmfeder fallen, und sein Fall beendet die Geschichte der Randgänger.",
		"So: benutze den Wächteraltar des Landes schleichend mit leerer Hand, lege acht von dem Reagenz darauf, das er nennt, und siege. Der Fortschritt löst beim Töten aus."
	]
	quest.4200000000228071.title: "Sturmroc gestillt"
	quest.4200000000228072.quest_desc: [
		"Alle acht Wächterkerne und ein Herz des Unbesungenen, formlos. Ein Kern mit einem Webstuhlfaden ergäbe stattdessen sechs Resonanzkerne; nimm also einen zweiten Satz Beute, wenn du beides willst. Die Bossleiste jedes Wächters trägt die Farbe seines Stammes.",
		"So: alle acht Wächterkerne und ein Herz des Unbesungenen, formlos. Wirke sie in einem Webstuhlkreis mit neun Relikten bei dir."
	]
	quest.4200000000228072.title: "Die Tafel der Neun"
	quest.4200000000228073.quest_desc: [
		"Zeichne einen Webstuhlkreis — ein Webstuhlsiegel in der Feuerschale eingesetzt, in ihrem Rituskreis — und wirke die Tafel mit allen neun Relikten bei dir; der Ritus zieht seinen Puls, bevor er greift. Neun Lichter steigen auf, je eines in der Farbe eines Stammes. Von da an behandelt dich jeder Stamm mindestens als Sippe, alle neun Gaben legen sich eine Weile auf dich, und die Aurora brennt voll in jeder Nacht, die du unter ihr stehst. Einmal pro Spieler; ein zweites Wirken zündet nur den Kreis.",
		"So: Webstuhlsiegel in einer Feuerschale in ihrem Rituskreis, neun Relikte im Inventar; benutze die Tafel schleichend auf der Feuerschale."
	]
	quest.4200000000228073.title: "Der Webstuhl stimmt zu"
	quest.4200000000228074.quest_desc: [
		"Sechzehn Bruchstücke der Geschichte des Webstuhls sind in die Mark gemeißelt: acht Gemeißelte Steine in den Wänden ihrer Ruinen, acht Wandbilder von zwei mal zwei an den Stätten der Wächter. Rechtsklick auf eines, um es zu lesen; der Geisterkodex behält es, und sein Chronik-Abschnitt bringt es in Ordnung. Lies alle sechzehn, und die Geschichte ist ganz.",
		"So: Rechtsklick auf alle acht Gemeißelten Steine in den Ruinen der Mark und auf alle acht Wandbilder an den Stätten der Wächter."
	]
	quest.4200000000228074.title: "Die Chronik, ganz"
	quest.4200000000228075.quest_desc: [
		"In die Wände der Ruinen der Mark gesetzt — die alten Werke, der versunkene Schrein, die Hügelgräber, die Grüfte, die Gewölbe. Lies ihn, wo du ihn findest, dann nimm ihn auf und setze ihn an eine eigene Wand; was du gelesen hast, bleibt gelesen.",
		"So: in die Wände der Ruinen der Mark gesetzt. Lies ihn, dann brich ihn ab und setze ihn an deine eigene Wand."
	]
	quest.4200000000228075.title: "Ein Stein, der sich erinnert"
	quest.4200000000228076.quest_desc: [
		"Zwei Blöcke breit und zwei hoch an der Stätte jedes Wächters; jedes malt das Land, in dem es steht. Wer einen Teil liest, liest das Ganze. Als ein Stück gesetzt, kommt es als eines herunter; ein im Kreativmodus geschnittenes Wandbild wechselt sein Kapitel mit einem Schleichklick.",
		"So: steht zwei mal zwei an der Stätte jedes Wächters. Lies es, dann nimm es im Ganzen ab und stell es daheim auf."
	]
	quest.4200000000228076.title: "Eine Wand, die ihr Land malt"
	quest.4200000000228077.quest_desc: [
		"Die Mark handelt von selbst. Aschenfall, ein Schimmersturm, eine Weißblendung und Schilfnebel schließen ein Land ein und lassen Geister am Tag aufsteigen; jedes nährt die Generatoren einer Stimme und hemmt die einer anderen. Hin und wieder schießen die Leyfäden einer Stimme hoch: Sammler, die sie tragen, geben das Doppelte, doch steh auf einer nackten Kreuzung ohne Sammler, und die Leykrankheit wiegt den Boden und leert deinen Puls. Jeder Stamm hält einen Festtag im Wechsel — komm zum Mahl für ein Geschenk. Ein warmes Licht, das nahe an dich herantreibt, ist ein wandernder Geist; erreich es für eine Zeile der Geschichte seines Landes und ein kleines Geschenk. Stürme und Schübe werden zwei Minuten voraus angesagt, im Chat und über der Schnellleiste. Hake dies ab, wenn du eines überstanden hast.",
		"So: sei in der Mark während eines Wetters, eines Schubs oder eines Festtags; hake es ab, wenn du es hinter dir hast."
	]
	quest.4200000000228077.title: "Die Mark atmet"
	quest.420000000023058C.quest_desc: [
		"Die Splittsänger schneiden einen Stein nie zweimal gleich. Diese Werkbank merkt sich jeden Schnitt.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Stein + Tischteile in JEI. Leg einen Block ein und wähl eine Variante."
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"Derselbe Trick für Holz — hundert Bretter aus einem.",
		"So: Chipped-Zimmermannstisch in JEI. Dieselbe Idee wie der Steinmetztisch, für Holz."
	]
	quest.420000000023058D.title: "Zimmermannstisch"
	quest.420000000023058E.quest_desc: [
		"Sand zu Glas, dann Glas in jede Form, die das Licht annimmt.",
		"So: Chipped-Werkbank in JEI (Steinmetz, Zimmermann, Glasbläser…). Leg den Block in den Tisch und wähl einen Schnitt."
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"Wolle und Tuch, neu gewebt — passend, für eine Plattform, die einen Webstuhl flickt.",
		"So: Chipped-Werkbank in JEI (Steinmetz, Zimmermann, Glasbläser…). Leg den Block in den Tisch und wähl einen Schnitt."
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"Blätter, Setzlinge und wachsende Dinge, sortiert in ihre Varianten.",
		"So: Chipped-Werkbank in JEI (Steinmetz, Zimmermann, Glasbläser…). Leg den Block in den Tisch und wähl einen Schnitt."
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"Farbige Blöcke und seltsamerer Stein. Wähl eine Variante; die Werkbank hält den Rest.",
		"So: Chipped-Werkbank in JEI (Steinmetz, Zimmermann, Glasbläser…). Leg den Block in den Tisch und wähl einen Schnitt."
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"Metall und Blöcke mit Maschinenfront, nach Geschmack geschnitten.",
		"So: Chipped-Werkbank in JEI (Steinmetz, Zimmermann, Glasbläser…). Leg den Block in den Tisch und wähl einen Schnitt."
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"Gib einen Block in den Steinmetztisch und wähl aus der Wand der Varianten.",
		"So: vier Stein im Quadrat, oder die Steinsäge."
	]
	quest.4200000000230593.title: "Ein Steinschnitt"
	quest.4200000000230594.quest_desc: [
		"Der Zimmermannstisch tut dasselbe für Holz.",
		"So: ein Stamm im Fertigungsgitter ergibt vier."
	]
	quest.4200000000230594.title: "Ein Bretterschnitt"
	quest.4200000000230595.quest_desc: [
		"Jede Scheibe, die der Glasbläser kennt, fängt hier an.",
		"So: schmelze Sand. Hämmere Bruchstein zu Kies, Kies zu Sand, dann in den Ofen."
	]
	quest.4200000000230595.title: "Ein Glasschnitt"
	quest.4200000000230596.quest_desc: [
		"Der Lieblingsstein der Splittsänger, über den sie streiten.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000230596.title: "Tiefenschiefer-Vielfalt"
	quest.4200000000230597.quest_desc: [
		"Gebrannter Ton, auf hundert Arten.",
		"So: vier Ziegel. Tonklumpen schmelzen zu Ziegeln."
	]
	quest.4200000000230597.title: "Ziegelvielfalt"
	quest.4200000000230598.quest_desc: [
		"Plattformsplitt, fein geschnitten.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000230598.title: "Sandstein-Vielfalt"
	quest.4200000000240599.quest_desc: [
		"Das Erste, das aus einer Plattform einen Ort macht, an dem jemand lebt.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Eichenholzbretter in JEI. Erstes Handcrafted-Stück."
	]
	quest.4200000000240599.title: "Ein Stuhl"
	quest.420000000024059A.quest_desc: [
		"Ein Platz, den Kodex abzulegen, während du nachdenkst.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.420000000024059A.title: "Ein Tisch"
	quest.420000000024059B.quest_desc: [
		"Platz, damit ein Clowder sitzt, während das Fass arbeitet.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.420000000024059B.title: "Eine Bank"
	quest.420000000024059C.quest_desc: [
		"Für die Kodexseiten, die du immer noch einmal lesen wolltest.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.420000000024059C.title: "Ein Regal"
	quest.420000000024059D.quest_desc: [
		"Handcrafted-Lager, das aussieht, als gehöre es dahin.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.420000000024059D.title: "Ein Schrank"
	quest.420000000024059E.quest_desc: [
		"Die Plattformhüter schliefen gut. Du solltest es auch.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.420000000024059E.title: "Ein feines Bett"
	quest.420000000024059F.quest_desc: [
		"Eine Laterne, eine Seite, ein Platz für beides.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.420000000024059F.title: "Ein Nachttisch"
	quest.42000000002405A0.quest_desc: [
		"Schneide einen Rahmen, dann kleide ihn in jeden Block. Eine Form, jede Haut.",
		"So: ein Eisenbarren über drei gerahmten Würfeln. Schneidet gerahmte Blöcke."
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"Ein blanker Würfel, der auf einen Tarnblock wartet.",
		"So: Rahmensäge, dann gerahmter Würfel/Stufe/Treppe. Tarnung ist Rechtsklick mit einem Block."
	]
	quest.42000000002405A1.title: "Framed Cube"
	quest.42000000002405A2.quest_desc: [
		"Ein halber Rahmen; doppelt so viele Optionen.",
		"So: Rahmensäge, dann gerahmter Würfel/Stufe/Treppe. Tarnung ist Rechtsklick mit einem Block."
	]
	quest.42000000002405A2.title: "Framed Slab"
	quest.42000000002405A3.quest_desc: [
		"Stufen, die die Wand anziehen, in der sie sitzen.",
		"So: Rahmensäge, dann gerahmter Würfel/Stufe/Treppe. Tarnung ist Rechtsklick mit einem Block."
	]
	quest.42000000002405A3.title: "Framed Stairs"
	quest.42000000002405A4.quest_desc: [
		"Für Dächer und Dachlinien, die dir die Leere nie gegeben hat.",
		"So: Rahmensäge, dann gerahmter Würfel/Stufe/Treppe. Tarnung ist Rechtsklick mit einem Block."
	]
	quest.42000000002405A4.title: "Framed Slope"
	quest.42000000002405A5.quest_desc: [
		"Die Randgänger überspannten die Leere mit weniger. Erreich die nächste Plattform mit Stil.",
		"So: Macaw-Brücken aus dem passenden Stein/Holz in JEI."
	]
	quest.42000000002405A5.title: "Seilbrücke"
	quest.42000000002405A6.quest_desc: [
		"Ein Dach über der Plattform. Der Regen hier oben ist immer nur Ehrgeiz.",
		"So: Macaw-Dächer aus dem passenden Holz in JEI."
	]
	quest.42000000002405A6.title: "Dachbodendach"
	quest.42000000002405A7.quest_desc: [
		"Komfort ist auch Infrastruktur.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.42000000002405A7.title: "Sofa"
	quest.42000000002405A8.quest_desc: [
		"Eine Küchenkante für die Reihe von Farmer's Delight.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.42000000002405A8.title: "Anrichte"
	quest.42000000002405A9.quest_desc: [
		"Wo der Schnurrhaar-Kodex seine Seitenränder bekommt.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.42000000002405A9.title: "Schreibtisch"
	quest.42000000002405AA.quest_desc: [
		"Kleiner Stauraum, passend zum Tisch.",
		"So: Handcrafted-Möbel aus Brettern in JEI. Der erste Stuhl ist aus Eiche."
	]
	quest.42000000002405AA.title: "Schublade"
	quest.42000000002405AB.quest_desc: [
		"Eine Schwelle, die in der Wand verschwindet.",
		"So: Rahmensäge, dann gerahmter Würfel/Stufe/Treppe. Tarnung ist Rechtsklick mit einem Block."
	]
	quest.42000000002405AB.title: "Framed Door"
	quest.42000000002405AC.quest_desc: [
		"Dünne Hülle; volle Tarnung.",
		"So: Rahmensäge, dann gerahmter Würfel/Stufe/Treppe. Tarnung ist Rechtsklick mit einem Block."
	]
	quest.42000000002405AC.title: "Framed Panel"
	quest.42000000002405AD.quest_desc: [
		"Ein Randgeländer, das du nach Geschmack kleidest.",
		"So: Rahmensäge, dann gerahmter Würfel/Stufe/Treppe. Tarnung ist Rechtsklick mit einem Block."
	]
	quest.42000000002405AD.title: "Framed Fence"
	quest.42000000002405AE.quest_desc: [
		"Grau und ehrlich, wie der Splitt, aus dem sie stammt.",
		"So: Macaw-Brücken aus dem passenden Stein/Holz in JEI."
	]
	quest.42000000002405AE.title: "Andesitbrücke"
	quest.42000000002505AF.quest_desc: [
		"Ein Wandlicht, keine aus Scham hineingesteckte Fackel. Die Hüter hatten Ansprüche.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Fackel + Eisennuggets. Erste Fertigung der Hütereien."
	]
	quest.42000000002505AF.title: "Wandfackel"
	quest.42000000002505B0.quest_desc: [
		"Fallender Sand. Die einzige ehrliche Uhr vor dem Uhr-Strang.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B0.title: "Sanduhr"
	quest.42000000002505B1.quest_desc: [
		"Tropfe eine Flüssigkeit aus einem Block. Klein; seltsam befriedigend.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B1.title: "Wasserhahn"
	quest.42000000002505B2.quest_desc: [
		"Dreh sie von Hand. Die Trommelherzen haben auch irgendwo angefangen.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B2.title: "Kurbel"
	quest.42000000002505B3.quest_desc: [
		"Zeig etwas her. Eine Marke, eine Seite, eine Trophäe.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B3.title: "Regal"
	quest.42000000002505B4.quest_desc: [
		"Ein Sack, der Säcke hält. Das Durcheinander der Bergung, aufgeräumt.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B4.title: "Sack"
	quest.42000000002505B5.quest_desc: [
		"Schließ den Ausgefransten Faden weg, fort von deinen schlechteren Ideen.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B5.title: "Tresor"
	quest.42000000002505B6.quest_desc: [
		"Heft eine Seite fest, wo der ganze Clowder sie liest.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B6.title: "Schwarzes Brett"
	quest.42000000002505B7.quest_desc: [
		"Ein Topf mit Ambitionen. Zieh ein wenig, wo die Plattform dünn ist.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B7.title: "Vase"
	quest.42000000002505B8.quest_desc: [
		"Heb das Spindel-Webstuhlfragment dorthin, wo man es bewundern kann.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B8.title: "Podest"
	quest.42000000002505B9.quest_desc: [
		"Verstau Kekse, Bienen oder die kleine Würde der Ordnung.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505B9.title: "Einmachglas (37)"
	quest.42000000002505BA.quest_desc: [
		"Setz einen Startpunkt, ohne ein ganzes Bett die Leiter hochzuschleppen.",
		"So: Wolle in JEI. Weißer Schlafsack; gefärbte Varianten gibt es. Setzt den Startpunkt ohne ein ganzes Bett."
	]
	quest.42000000002505BA.title: "Schlafsack"
	quest.42000000002505BB.quest_desc: [
		"Schlaf durch den Tag, damit die Kreaturen einen ausgeruhten Skybound treffen.",
		"So: Wolle + Faden in JEI. Häng sie an Seil und Nagel."
	]
	quest.42000000002505BB.title: "Hängematte"
	quest.42000000002505BC.quest_desc: [
		"Häng die Hängematte zwischen zwei Pfosten, über den Abgrund, und wag es.",
		"So: Schnur und ein Eisenbarren. Stell zwei hin, dann häng die Hängematte auf."
	]
	quest.42000000002505BC.title: "Seil und Nägel"
	quest.42000000002505BD.quest_desc: [
		"Eine ruhigere Flamme für die langen Nächte der Plattform.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505BD.title: "Kerzenständer"
	quest.42000000002505BE.quest_desc: [
		"Klettere, häng dich dran oder bau eine Brücke. Die Randgänger schworen darauf.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505BE.title: "Seil (37)"
	quest.42000000002505BF.quest_desc: [
		"Hol das Seil rauf und runter, ganz nach Redstone-Laune.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505BF.title: "Pulley Block"
	quest.42000000002505C0.quest_desc: [
		"Fall darauf, und die Leere vergisst, dich zu strafen.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505C0.title: "Feather Block"
	quest.42000000002505C1.quest_desc: [
		"Kreide einen Plan an, über den das ganze Clowder streiten kann.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505C1.title: "Tafel"
	quest.42000000002505C2.quest_desc: [
		"Trag ein kleines Ding, das lieber nicht von dir getragen würde.",
		"So: Supplementaries-Fertigung in JEI (Wandleuchter, Sack, Tresor, Seil…). Die Hütereien nennen die Station."
	]
	quest.42000000002505C2.title: "Mobkäfig"
	quest.42000000002605C3.quest_desc: [
		"Der erste Draht. Der Puls, den die Trommelherzen hielten, hat jetzt irgendwohin zu gehen.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: walze Kupferbleche in einem Walzwerk. Das aktuelle Kapitel beginnt hier."
	]
	quest.42000000002605C3.title: "Kupferkabel"
	quest.42000000002605C4.quest_desc: [
		"Rotation auf der einen Seite, Forge-Energie auf der anderen. Zwei Stränge geben sich die Hand.",
		"So: Create Crafts & Additions — Kupferdraht aus dem Walzwerk, dann Verbinder und Motor."
	]
	quest.42000000002605C4.title: "Verbinder"
	quest.42000000002605C5.quest_desc: [
		"Energie zurück in Rotation. Der Uhr-Strang läuft jetzt auf dem Funke-Strang.",
		"So: Create Crafts & Additions — Kupferdraht aus dem Walzwerk, dann Verbinder und Motor."
	]
	quest.42000000002605C5.title: "Elektromotor"
	quest.42000000002605C6.quest_desc: [
		"Halte eine Ladung zwischen dem Draht und der Arbeit.",
		"So: Create Crafts & Additions — Kupferdraht aus dem Walzwerk, dann Verbinder und Motor."
	]
	quest.42000000002605C6.title: "Kondensator"
	quest.42000000002605C7.quest_desc: [
		"Eine Wand gespeicherten Stroms, so groß, wie die Plattform es erlaubt.",
		"So: Create Crafts & Additions — Kupferdraht aus dem Walzwerk, dann Verbinder und Motor."
	]
	quest.42000000002605C7.title: "Modularer Akkumulator"
	quest.42000000002605C8.quest_desc: [
		"Stangen und Draht aus Barren — die Antwort von Create auf die Presse.",
		"So: Create Crafts & Additions — Kupferdraht aus dem Walzwerk, dann Verbinder und Motor."
	]
	quest.42000000002605C8.title: "Walzwerk"
	quest.42000000002605C9.quest_desc: [
		"Verzaubere ohne den Aberglauben des Tisches. Fütter ihn mit Erfahrung, nimm dir Absicht.",
		"So: Create Enchantment Industry nach einem Lohenbrenner. JEI nennt den Drucker und den Erfahrungseimer."
	]
	quest.42000000002605C9.title: "Lohen-Verzaubrerer"
	quest.42000000002605CA.quest_desc: [
		"Flüssige Übung, mitgenommen. Die Hüter hätten das vulgär und nützlich gefunden.",
		"So: Create Enchantment Industry nach einem Lohenbrenner. JEI nennt den Drucker und den Erfahrungseimer."
	]
	quest.42000000002605CA.title: "Erfahrungseimer"
	quest.42000000002605CB.quest_desc: [
		"Kopiere ein Buch, einen Plan, eine Seite. Der Schnurrhaar-Kodex stimmt leise zu.",
		"So: Create Enchantment Industry nach einem Lohenbrenner. JEI nennt den Drucker und den Erfahrungseimer."
	]
	quest.42000000002605CB.title: "Drucker"
	quest.42000000002605CC.quest_desc: [
		"Lava und Hitze zu Energie. Eine Brücke, nicht das Summen selbst.",
		"So: Osmium + Ofen + Kupfer. Der erste Mekanism-Generator."
	]
	quest.42000000002605CC.title: "Wärmegenerator"
	quest.42000000002605CD.quest_desc: [
		"Auf einer Plattform, die nur Himmel ist, ist die Sonne die eine Ressource, die niemand rationiert.",
		"So: Mekanism-Generatoren nach der Linie Mekanism-Werke. Der Wärmeerzeuger ist das erste Rezept."
	]
	quest.42000000002605CD.title: "Solargenerator"
	quest.42000000002605CE.quest_desc: [
		"Je höher die Plattform, desto stärker dreht er. Bau hoch.",
		"So: Mekanism-Generatoren nach der Linie Mekanism-Werke. Der Wärmeerzeuger ist das erste Rezept."
	]
	quest.42000000002605CE.title: "Windgenerator"
	quest.42000000002605CF.quest_desc: [
		"Verbrenn den Überschuss des Spross-Strangs. Auf einer Plattform ist nichts Abfall.",
		"So: Mekanism-Generatoren nach der Linie Mekanism-Werke. Der Wärmeerzeuger ist das erste Rezept."
	]
	quest.42000000002605CF.title: "Biogenerator"
	quest.42000000002605D0.quest_desc: [
		"Späte Energie für ein Clowder, das tief in Mekanism eingestiegen ist.",
		"So: Mekanism-Generatoren nach der Linie Mekanism-Werke. Der Wärmeerzeuger ist das erste Rezept."
	]
	quest.42000000002605D0.title: "Gasverbrennender Generator"
	quest.42000000002605D1.quest_desc: [
		"Der digitale Webstuhl, in deiner Tasche. Neuwebe von überall auf der Plattform.",
		"So: Drahtlosterminal nach einem AE2-Netz und einem geladenen Drahtlos-Kit. JEI nennt das Rezept."
	]
	quest.42000000002605D1.title: "Drahtlosterminal (38)"
	quest.42000000002605D2.quest_desc: [
		"Die Chemikalien von Mekanism, gespeichert im AE2-Netz. Zwei späte Pfeiler, geflochten.",
		"So: Applied Mekanistics-Chemiezellen nach AE2-Gehäuse + Mekanism-Chemikalien."
	]
	quest.42000000002605D2.title: "Chemiezelle"
	quest.42000000002605D3.quest_desc: [
		"Für dann, wenn der Kupferdraht nicht den ganzen Puls tragen kann.",
		"So: Create Crafts & Additions — Kupferdraht aus dem Walzwerk, dann Verbinder und Motor."
	]
	quest.42000000002605D3.title: "Hochspannungsverbinder"
	quest.42000000002605D4.quest_desc: [
		"Ein Kuchen, der dich eine Stufe hebt. Sag es nicht der Küchenlinie.",
		"So: Create Enchantment Industry nach einem Lohenbrenner. JEI nennt den Drucker und den Erfahrungseimer."
	]
	quest.42000000002605D4.title: "Erfahrungskuchen"
	quest.42000000002605D5.quest_desc: [
		"Ein größerer Bissen vom selben freien Himmel.",
		"So: Mekanism-Generatoren nach der Linie Mekanism-Werke. Der Wärmeerzeuger ist das erste Rezept."
	]
	quest.42000000002605D5.title: "Fortgeschrittenes Solar"
	quest.42000000002605D6.quest_desc: [
		"Die Hülle, die jede Chemiezelle braucht.",
		"So: Applied Mekanistics-Chemiezellen nach AE2-Gehäuse + Mekanism-Chemikalien."
	]
	quest.42000000002605D6.title: "Chemische Hülle"
	quest.42000000002605D7.quest_desc: [
		"Trag ein Maß Gas vom Netz fort.",
		"So: Applied Mekanistics-Chemiezellen nach AE2-Gehäuse + Mekanism-Chemikalien."
	]
	quest.42000000002605D7.title: "Tragbare Chemiezelle"
	quest.42000000002705D8.quest_desc: [
		"Jeder Strang hat einen Wächter, den der Schnitt zerrissen hat: ein Gebilde des Webstuhls, das wild geworden ist. Du mordest kein Monster; du gibst dem Strang die Spannung zurück, indem du ihn schlägst. Fertige seinen Ausgefransten Totem, sobald der Strang eingesetzt ist, benutz ihn irgendwo außerhalb einer Arena, und du und jeder Clowder-Gefährte im Umkreis von 32 Blöcken werdet auf seine Bühne gezogen. Gewinnst du, trägt jeder von euch das Gewebte Relikt dieses Wächters nach Hause. Verlierst du, werdet ihr wieder ausgespuckt, das Totem verbraucht.",
		"Relikte wirken aus dem Curios-Reliktplatz, der Nebenhand oder der Schnellleiste: ein Passiv, solange getragen, und eine Rechtsklick-Kraft mit Abklingzeit. `/guardians leave` bricht einen Kampf ab; `/guardians status` zeigt die Bilanz des Clowder.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: abhaken. Fertige jeden Ausgefransten Totem, nachdem dieser Strang eingesetzt ist; benutz ihn außerhalb einer Arena."
	]
	quest.42000000002705D8.title: "Antwort für den Schnitt"
	quest.42000000002705D9.quest_desc: [
		"Die Schale des Baus: eine versenkte Schale aus vier Erdstufen, die zu einer Schlammgrube hinabsteigen, unter sechs Wurzelbögen aus Schwarzeiche, mit sieben petrolfarbenen Wurzelnähten, die über den Grubenboden leuchten.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705D9.title: "Totem: Die Lagerstatt"
	quest.42000000002705DA.quest_desc: [
		"Bei jedem Viertel ihrer Gesundheit schlägt Die Lagerstatt zu und flutet die Grube mit einer Schicht Erde, darin immun. Eine der sieben Nähte leuchtet: grabe einen Kanal zu ihr, leg den Kern frei und triff ihn, um die Verschüttung zu brechen. Das erste Tor, und ein nachsichtiges.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705DA.title: "Spannung zurück: Die Lagerstatt"
	quest.42000000002705DB.quest_desc: [
		"Wurzelherz: erlittener Rückstoß sinkt um sechzig Prozent und nichts kann dich ziehen. Wurzelgriff pflanzt dich fünf Sekunden lang hinter acht Herzen Absorption fest.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705DB.title: "Relikt: Wurzelherz"
	quest.42000000002705DC.quest_desc: [
		"Die Mahlgrube: ein Steinbruch aus Tiefenschiefer mit einem drehenden Schleifsteinring im Boden und vier Steinsieb-Rutschen, die Kies in die zentrale Splittgrube schütten.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705DC.title: "Totem: Das Mahlmaul"
	quest.42000000002705DD.quest_desc: [
		"Das Mahlmaul ist immun, solange sein Maul geschlossen ist. Jede Rutsche lässt alle fünfzehn Sekunden einen Splittblock fallen; trag einen auf den Ring und lass ihn in den Mund der Grube fahren, um das Maul zwölf Sekunden lang offen zu verklemmen. Der Ring kehrt in jeder Phase um und schiebt den Unachtsamen in die Grube.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705DD.title: "Spannung zurück: Das Mahlmaul"
	quest.42000000002705DE.quest_desc: [
		"Mahlkern: immun gegen Abbaulähmung, und deine Handsiebe bekommen einen extra Glückswurf. Zerfetzen zieht dem Nächsten, das du triffst, zwei Rüstung ab.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705DE.title: "Relikt: Mahlkern"
	quest.42000000002705DF.quest_desc: [
		"Die Wucherterrasse: vier Gartenterrassen unter einem Blätterdach, acht Spalierpfosten und vier Schnittstationen auf der zweiten Ebene.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705DF.title: "Totem: Die Dornenmutter"
	quest.42000000002705E0.quest_desc: [
		"Die Dornenmutter schlägt nie; sie sät Dornenhecke, die sich ausbreitet und bei Berührung brennt, und sie heilt, wann immer eine Schnittstation zugewuchert ist. Schere und Äxte räumen sie. Kompostiere acht Hecke an einer Station, um eine Schnittwelle abzufeuern, die den Boden freiräumt und sie betäubt — das einzige saubere Schadensfenster.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705E0.title: "Spannung zurück: Die Dornenmutter"
	quest.42000000002705E1.quest_desc: [
		"Dornensamen: Dornen, und kein Schaden von Beeren oder Kakteen. Blüte hebt einen Heckenring und gibt Regeneration II dir und deinem Clowder darin.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705E1.title: "Relikt: Dornensamen"
	quest.42000000002705E2.quest_desc: [
		"Die Himmelssplitter: zehn Tiefenschiefer-Splitter, die über der Leere schweben, bröckelnde Brücken dazwischen, goldene Klauenmale auf dem Hauptsplitter, wo der Boss landet.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705E2.title: "Totem: Der Randgänger"
	quest.42000000002705E3.quest_desc: [
		"Ein reines Duell. Der Randgänger springt von Splitter zu Splitter und stürzt sich auf den, der am weitesten von einer Wand steht; eine goldene Klauenmarke zeigt wo, einen Atemzug bevor er landet — tritt von ihr herunter. Die Brücken bröckeln hinter dir und kehren später zurück. Fallen kostet sechs Herzen und den Weg zurück auf deine Plattform.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705E3.title: "Spannung zurück: Der Randgänger"
	quest.42000000002705E4.quest_desc: [
		"Randschritt: kein Fallschaden bei weniger als zwölf Blöcken und kein Abrutschen von Kanten. Randschritt stürmt sechs Blöcke weit, zweimal, mit einem stärkeren Treffer am Ende.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705E4.title: "Relikt: Randschritt"
	quest.42000000002705E5.quest_desc: [
		"Die Schmiedetrommel: ein Messing-Trommelpodest über einem Lavakrater, acht Kupferkolbenhämmer mit Schlagpolstern davor, vier Lavakanäle durch den Boden.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705E5.title: "Totem: Das Trommelherz"
	quest.42000000002705E6.quest_desc: [
		"Das Trommelherz kann nur einen Moment lang verletzt werden, nach jedem vierten Schlag. Steh beim Grundschlag auf einer Schlagplatte, um einen Funken zu laden, der dreifach zählt; beim vierten Schlag steigen die Lavakanäle, also bleib auf den Platten, nicht in den Kanälen. Das Tempo steigt mit jeder Phase.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705E6.title: "Spannung zurück: Das Trommelherz"
	quest.42000000002705E7.quest_desc: [
		"Trommelpuls: jeder vierte Treffer landet zwei Herzen extra. Der Grundschlag betäubt und wirft alles im Umkreis von sieben Blöcken zurück.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705E7.title: "Relikt: Trommelpuls"
	quest.42000000002705E8.quest_desc: [
		"Die Hemmung: vier drehende Kupferringe mit Sequenzkacheln aus Schwarzeiche um eine Eisennabe, sechs Zahnradtürme und ein Pendel von sechzehn Blöcken, das die Zeit hält.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705E8.title: "Totem: Der Räderbauer"
	quest.42000000002705E9.quest_desc: [
		"In jeder Phase zieht Der Räderbauer auf: Kacheln leuchten der Reihe nach über die drehenden Ringe, und du hast zwölf Sekunden, sie in der Reihenfolge zu betreten. Erfolg öffnet sein Gehäuse für acht Sekunden; ein Fehlschlag lässt jeden Zahnradturm feuern. Das Pendel ist das Metronom; die Ringe kehren um, wenn es weit ausschlägt.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705E9.title: "Spannung zurück: Der Räderbauer"
	quest.42000000002705EA.quest_desc: [
		"Zahnradschleife: Eile I, und Werkzeuge verschleißen ein Fünftel langsamer. Rücklauf setzt jede andere Reliquie, die du trägst, zurück und schnappt dich dorthin zurück, wo du vor drei Sekunden warst.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705EA.title: "Relikt: Zahnradschleife"
	quest.42000000002705EB.quest_desc: [
		"Die Wabe: eine sechseckige Wachsarena aus steigenden und fallenden Wabenzellen, Honiglachen und sechs Drohnenzellen in der Wand.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705EB.title: "Totem: Der Schwarmgeist"
	quest.42000000002705EC.quest_desc: [
		"Der Schwarmgeist ist zerbrechlich, doch in jeder Welle schütten seine sechs Zellen Drohnen. Ein Lagerfeuer auf einer Drohnenzelle versiegelt sie für dreißig Sekunden; versiegle alle sechs, und die Königskammer öffnet sich für zehn Sekunden. Deine eigenen Productive Bees greifen die Drohnen bei Sicht an.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705EC.title: "Neu spannen: Der Schwarmgeist"
	quest.42000000002705ED.quest_desc: [
		"Schwarmruf: Bienen wenden sich nie gegen dich, und Bienenstöcke innerhalb von sechzehn Blöcken arbeiten ein Zehntel schneller. Ruf den Schwarm: schickt vier Reliktbienen hinter dem her, was du triffst.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705ED.title: "Relikt: Schwarmruf"
	quest.42000000002705EE.quest_desc: [
		"Der Schutzkreis: ein Steinsanktum aus Goldkreisen und neun Glyphenpfeilern mit Amethystspitzen, in der Mitte ein neunseitiges Podest aus Goldstiften.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705EE.title: "Totem: Der Siegelbrecher"
	quest.42000000002705EF.quest_desc: [
		"Der Siegelbrecher verbirgt sich hinter drei aktiven Wachen. Die Stifte des Podests zünden die Reihenfolge einmal je Phase — schau zuerst. Löse die Pfeiler in dieser Reihenfolge mit einem Ars-Bann oder einem Gegenstand des Siegel-Strangs; ein falscher spannt alle drei wieder, und das Wachglas beißt. Drei richtig, und er ist zwölf Sekunden offen. Spätere Phasen mischen die Runen und setzen einen Köder dazu.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705EF.title: "Neu spannen: Der Siegelbrecher"
	quest.42000000002705F0.quest_desc: [
		"Siegelmal: erlittener magischer Schaden sinkt um ein Fünftel. Siegelmal schützt dich oder einen Clowder-Gefährten, den du ansiehst, vor einem schweren Treffer.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705F0.title: "Relikt: Siegelmal"
	quest.42000000002705F1.quest_desc: [
		"Der einstürzende Webstuhl: ein Webstuhl, sechsundsechzig Blöcke breit, dessen Boden die Kette ist — Dielenstreifen, die sich in Fadenbrücken auflösen, wenn die Litzenstäbe fallen.",
		"Vier Ausgefranster Faden und vier vom Block des Strangs um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705F1.title: "Totem: Der Ungewebte"
	quest.42000000002705F2.quest_desc: [
		"Fünf Phasen. Jede zitiert dreißig Sekunden lang zwei der anderen acht Mechaniken, dann fällt ein Litzenstab und drei weitere Streifen lösen sich auf. In seiner wahren Gestalt bleiben die letzten vier Streifen, und die Kettfäden sind der einzige Weg hinauf zum Balken, wo er steht. Töte ihn dort: das Neuweben.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705F2.title: "Neu spannen: Der Ungewebte"
	quest.42000000002705F3.quest_desc: [
		"Webstuhlfaden: zwei zusätzliche Webstuhlspannung für deinen Clowder und ein langsamerer Verfall. Der Webstuhlfaden bindet deinen Clowder an deine Seite. Er ist der Schlussstein des wahren Neuwebens und der Schlüssel zu den zwei versiegelten Arenen.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705F3.title: "Relikt: Webstuhlfaden"
	quest.42000000002705F4.quest_desc: [
		"Der Mülleimer des Docks: eine Ecke des Docks selbst — ein Bretterhof, eine Wäscheleine mit Stofftüchern, Körbe mit Wolle, ein roter Teppich.",
		"Vier Ausgefranste Fäden und vier Wolle um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705F4.title: "Totem: Der Fusselgolem"
	quest.42000000002705F5.quest_desc: [
		"Der eine Kampf ohne Risiko. Der Golem wirft Fusselbälle, die nur einen Moment blenden, und versteckt sich hinter der Wäsche; klopf den Teppich, dann niest er und taumelt. Er lehrt Totem, Arena und Tor.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705F5.title: "Neu spannen: Der Fusselgolem"
	quest.42000000002705F6.quest_desc: [
		"Fusselhauch: immun gegen Schaden von Kakteen, Beeren und Hecken und dagegen, gestoßen zu werden. Puff blendet nahe Kreaturen, damit du fliehen kannst.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705F6.title: "Relikt: Fusselhauch"
	quest.42000000002705F7.quest_desc: [
		"Der Knotengarten: eine Grasinsel unter vier Ringen Heckenlabyrinth, mit Lücken und Ausläufern, Bruchsteinpfaden und darüber hängenden Seilknotenringen.",
		"Vier Ausgefranster Faden und vier Blätter um ein Leerengarn.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705F7.title: "Totem: Das Gewirr"
	quest.42000000002705F8.quest_desc: [
		"Die Spinne versperrt die Pfade hinter dir mit Seilknoten, die drei Treffer zum Durchschneiden brauchen, und beißt, wer allein in einer Sackgasse steht. Bleib zusammen im Labyrinth. Optional, zur Spielmitte, ein kosmetischer Preis.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705F8.title: "Neu spannen: Das Gewirr"
	quest.42000000002705F9.quest_desc: [
		"Knotenamulett: kein Abbremsen auf Spinnennetz, Seelensand, Honig oder Pulverschnee, und halb so viel Rutschen auf Eis. Gewirr verwurzelt das erste Wesen, das es trifft.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705F9.title: "Relikt: Knotenamulett"
	quest.42000000002705FA.quest_desc: [
		"Die zwei wahnsinnigen Arenen warten hinter einer Tür, die nur das Neuweben öffnet. Ihre Totems brauchen das Relikt Webstuhlfaden im Fertigungsraster und antworten nur einem Clowder, der seinen Himmel geschlossen hat. Die Bosse sind zehn- bis zwanzigmal so groß wie du. Bring alle mit.",
		"So: setze alle neun Stränge ein, dann neuwebe. Der Fortschritt löst aus, wenn der Himmel sich schließt."
	]
	quest.42000000002705FA.title: "Die versiegelte Tür"
	quest.42000000002705FB.quest_desc: [
		"Die Abtrennung: ein großer Obsidiansplitter, den der leuchtende Schnitt kreuzt, zwanzig Weltsplitter, die darum treiben, blaugrüne Leerentränen in der Luft.",
		"Ausgefranster Faden und Obsidian um das Relikt Webstuhlfaden; das Relikt wird zurückgegeben.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705FB.title: "Totem: Der Erste Schnitt"
	quest.42000000002705FC.quest_desc: [
		"Eine Form, die der Schnitt auf dem Splitter ließ, kein Geständnis, wer ausholte. Alle zwanzig Sekunden schneidet sie eine Linie über den Splitter, und die Blöcke fallen fünfzehn Sekunden lang weg; die Naht gibt Schnelligkeit, doch ihr Strahl folgt der Naht. Treibende Splitter zerquetschen, Leerentränen ziehen, und bei einem Fünftel seiner Gesundheit spaltet sich der Splitter entlang des Schnitts in zwei. Erst nach dem Neuweben.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705FC.title: "Neuspannung: Der Erste Schnitt"
	quest.42000000002705FD.quest_desc: [
		"Splitter des Ersten Schnitts: schneidet durch die Bannphasen. Das Beste im Paket, vorbehalten denen, die bestanden haben.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705FD.title: "Relikt: Splitter des Ersten Schnitts"
	quest.42000000002705FE.quest_desc: [
		"Der Webstuhl oben: ein Purpurgewebe, neun Strangbrücken zu neun Pfeilerplattformen, siebenundzwanzig Kathedralenfäden zu einem Schlussstein, vierundsechzig Blöcke hoch.",
		"Ausgefranster Faden und Purpur um das Relikt Webstuhlfaden; das Relikt bekommst du zurück.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.42000000002705FE.title: "Totem: Der Überweber"
	quest.42000000002705FF.quest_desc: [
		"Dein eigener wiederhergestellter Webstuhl hat sich gegen dich gekehrt. Der Überweber wirft Schatten der neun Wächter auf ihre Stränge; töte einen Schatten, dann spannt sich sein Faden für fünfundzwanzig Sekunden, und erst dann lässt sich der Webstuhl selbst verletzen. Später wirft er drei, dann alle neun.",
		"So: benutz den passenden Ausgefransten Totem und gewinn dann die Arena. Der Fortschritt schließt dies ab."
	]
	quest.42000000002705FF.title: "Neuspannung: Der Überweber"
	quest.4200000000270600.quest_desc: [
		"Schiffchen des Überwebers: ein Echo jeder Strang-Reliquie in einem, und es neuwebt einen gefallenen Clowder-Gefährten.",
		"Eines je anwesendem Clowder-Mitglied beim Sieg, direkt ins Inventar.",
		"So: Schnurrhaar-Kodex, Gerissene Wächter — Totem, Arena, Relikt. Das Totem antwortet auf der Plattform."
	]
	quest.4200000000270600.title: "Relikt: Schiffchen des Überwebers"
	quest.42000000002805E3.quest_desc: [
		"Wilde Plattformläufer erscheinen nicht auf einer Leerenplattform. Spiele den Torritus auf einer Tortrommel (benutze sie mit leeren Händen, triff die Schläge auf A, S, D, F) und geh die Mark. Die Gelben weiden in der Steppe und im Schilfmoor. Das Hochland neigt zum Grad Großartig. Die Schneefelder verbergen Grade Wundervoll. Die Glutöde hält Flammenvögel.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: benutze die Tortrommel mit leeren Händen und spiele den Torritus: triff die fallenden Schläge auf A, S, D, F. Erreiche 60% und sie öffnet sich; kein Puls nötig. Binde zuerst einen Rückkehrkompass."
	]
	quest.42000000002805E3.title: "Tor zur Mark"
	quest.42000000002805E4.quest_desc: [
		"Wildes Gysahl wächst im Schilfmoor, in der Steppe und im Hochland, am dichtesten im Moor. Beim Pflücken fallen auch Samen, und Blatt der Mark oder Gras, mit einer Hacke gebrochen, gibt mehr her. Pflanze die Samen zu Hause auf Ackerboden.",
		"So: pflücke wildes Gysahl in der Mark (das Schilfmoor ist am dichtesten). Beim Pflücken fallen auch Samen; pflanze sie zu Hause auf Ackerboden."
	]
	quest.42000000002805E4.title: "Gysahl Green"
	quest.42000000002805E5.quest_desc: [
		"Ein Buch und ein Gysahl-Blatt. Benutze ihn überall: seine Seiten listen Farbe, Grad, Klasse, Rennsiege und die letzte Nuss jedes deiner Vögel.",
		"So: ein Buch und ein Gysahl. Benutze ihn überall; seine Seiten listen deine eigenen Vögel."
	]
	quest.42000000002805E5.title: "Chocobo Almanac"
	quest.42000000002805E6.quest_desc: [
		"Füttere Gysahl, um ein wildes Gelbes zu zähmen. Fertige einen Sattel aus Leder, Faden und Eisen, dann reite. Sprinten macht einen Satz; lass nach, um Ausdauer zu holen.",
		"So: Leder, Faden und Eisen. Zähme ein wildes Gelbes mit Gysahl und sattle es dann."
	]
	quest.42000000002805E6.title: "Chocobo Saddle"
	quest.42000000002805E7.quest_desc: [
		"Goldklumpen um eine Uhr, mit einem Gysahl. Aufgezogen bringt sie dich zum Schnurrhaarwind und zurück. Wenn du die Mark durchwandert hast, steht Esther auch in der Clowder-Halle: reite einen gesattelten Vogel zu ihr, oder frag den Führer vom Schnurrhaarwind.",
		"So: Goldklumpen um eine Uhr, mit einem Gysahl. Benutze sie, um dich zum Schnurrhaarwind aufzuziehen und zurück; ein gesattelter Vogel kommt mit."
	]
	quest.42000000002805E7.title: "Chocobo Pocketwatch"
	quest.42000000002805E8.quest_desc: [
		"Ein Köder in der Hand lockt wilde Vögel an und zeichnet sie über ein Feld hinweg nach.",
		"So: fertige den Köder. Halte ihn, um die Gelben der Mark zu finden."
	]
	quest.42000000002805E8.title: "Chocobo Lure"
	quest.42000000002805E9.quest_desc: [
		"Pflanze Gysahl-Samen auf Ackerboden. Ein Beet zu Hause ist der Anfang der Farmlinie.",
		"So: wildes Gysahl pflücken lässt Samen fallen, und Gras und Blatt der Mark, mit einer Hacke gebrochen, auch. Pflanze auf Ackerboden."
	]
	quest.42000000002805E9.title: "Gysahl Seeds"
	quest.42000000002805EA.quest_desc: [
		"Füttere zwei Erwachsene unterschiedlichen Geschlechts mit einer Carob-Nuss. Zwei Gelbe mit Grad Gut oder besser plus Carob können als Grün oder Blau schlüpfen. Jedes Elternteil braucht 5 erste Plätze in Klasse C; 16 zusammen machen die Farbe sicher. Ein Grün mit Grad Großartig und ein Blau mit Grad Großartig, jedes mit 8 ersten Plätzen der Klasse B, schlüpfen als Schwarz (ein Fehlschlag ist Weiß; 24 zusammen für einen sicheren Wurf).",
		"So: Bilo der Nusswart am Schnurrhaarwind verkauft Carob. Klasse-A-Rennen zahlen es auch aus."
	]
	quest.42000000002805EA.title: "Carob Nut"
	quest.42000000002805EB.quest_desc: [
		"Ein Grünzeug auf halber Leiter. Trainiere Tempo, Ausdauer, Intelligenz oder Kooperation; der Vogel wird von jeder Sorte satt.",
		"So: Weiser Wynn am Schnurrhaarwind."
	]
	quest.42000000002805EB.title: "Curiel-Grünzeug"
	quest.42000000002805EC.quest_desc: [
		"Das höchste Trainingsgrün. Steig die Leiter hinauf, sobald der Vogel von den billigeren Blättern satt ist.",
		"So: Weiser Wynn am Schnurrhaarwind, oder ein Preis aus Klasse-S-Rennen."
	]
	quest.42000000002805EC.title: "Sylkis-Grünzeug"
	quest.42000000002805ED.quest_desc: [
		"Gold schlüpft nie ohne Zeio. Ein Schwarz mit Grad Wundervoll plus ein Gelb mit Grad Wundervoll, jedes mit 10 ersten Plätzen in Klasse A (32 zusammen für einen sicheren Wurf).",
		"So: Bilo der Nusswart am Schnurrhaarwind verkauft Zeio. Klasse-S-Rennen zahlen es selten aus."
	]
	quest.42000000002805ED.title: "Zeio Nut"
	quest.42000000002805EE.quest_desc: [
		"GP, gewonnen auf der Bahn. Die Stände am Platz rechnen alles in GP ab.",
		"So: lande unter den ersten drei eines Laufs am Schnurrhaarwind. Reite einen gesattelten Vogel zu Esther, um mitzumachen."
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"Die erste Paarungsnuss. Das Talent folgt der Nuss; die Farbe folgt den Eltern, außer wenn Carob oder Zeio dabei ist.",
		"So: Bilo der Nusswart am Schnurrhaarwind verkauft Pepio. Ein Klasse-C-Sieg kann es auch auszahlen."
	]
	quest.42000000002805EF.title: "Pepio Nut"
	quest.42000000002805F0.quest_desc: [
		"Zwei Gysahl und Knochenmehl. Die erste Stufe über dem schlichten Grünzeug.",
		"So: formlos — zwei Gysahl und Knochenmehl."
	]
	quest.42000000002805F0.title: "Krakka-Grünzeug"
	quest.42000000002805F1.quest_desc: [
		"Das nächste Trainingsgrün. Freiwillig, sobald der Hof läuft.",
		"So: Weiser Wynn, oder das Rezept in JEI."
	]
	quest.42000000002805F1.title: "Tantal-Grünzeug"
	quest.42000000002805F2.quest_desc: [
		"Noch ein Trainingsgrün. Freiwillig.",
		"So: Weiser Wynn am Platz."
	]
	quest.42000000002805F2.title: "Pahsana-Grünzeug"
	quest.42000000002805F3.quest_desc: [
		"Noch ein Trainingsgrün. Freiwillig.",
		"So: Weiser Wynn am Platz."
	]
	quest.42000000002805F3.title: "Mimett-Grünzeug"
	quest.42000000002805F4.quest_desc: [
		"Noch ein Trainingsgrün. Freiwillig.",
		"So: Weiser Wynn am Platz."
	]
	quest.42000000002805F4.title: "Reagan-Grünzeug"
	quest.42000000002805F5.quest_desc: [
		"Eine mittlere Nuss. Freiwillig.",
		"So: Bilo der Nusswart am Schnurrhaarwind verkauft Luchile."
	]
	quest.42000000002805F5.title: "Luchile Nut"
	quest.42000000002805F6.quest_desc: [
		"Eine mittlere Nuss. Freiwillig.",
		"So: Bilo der Nusswart am Schnurrhaarwind verkauft Saraha."
	]
	quest.42000000002805F6.title: "Saraha Nut"
	quest.42000000002805F7.quest_desc: [
		"Eine mittlere Nuss. Freiwillig.",
		"So: Bilo der Nusswart am Schnurrhaarwind verkauft Lasan."
	]
	quest.42000000002805F7.title: "Lasan Nut"
	quest.42000000002805F8.quest_desc: [
		"Eine Paarungsnuss der mittleren Spätphase. Freiwillig. Bilo der Nusswart verkauft sie.",
		"So: Bilo der Nusswart am Schnurrhaarwind verkauft Pram."
	]
	quest.42000000002805F8.title: "Pram Nut"
	quest.42000000002805F9.quest_desc: [
		"Der Jahrmarktsstand am Schnurrhaarwind verkauft Feuerwerk, Leinen, Taschenuhren und den Chocobo-Almanach für GP.",
		"So: Papier plus Schießpulver. Optionaler Knall."
	]
	quest.42000000002805F9.title: "Jahrmarktsfeuerwerk"
	quest.42000000002805FA.quest_desc: [
		"Eine späte Paarungsnuss. Freiwillig.",
		"So: Bilo der Nusswart am Schnurrhaarwind verkauft Porov."
	]
	quest.42000000002805FA.title: "Porov Nut"
	quest.42000000002905FB.quest_desc: [
		"Die Leere hat nie Pam's-Büsche wachsen lassen. Siebe Erde mit einem Schnurnetz. Brich den Garten für trockene Samen — Chili, Mais, Kaktusfrucht.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: siebe Erde mit einem Schnurnetz oder besser (Ex Deorum oder Leerenwebstuhl)."
	]
	quest.42000000002905FB.title: "Arid Garden"
	quest.42000000002905FC.quest_desc: [
		"Kaltkulturen aus derselben Erde. Brich den Busch; pflanze, was du brauchst.",
		"So: siebe Erde mit einem Schnurnetz oder besser."
	]
	quest.42000000002905FC.title: "Frost Garden"
	quest.42000000002905FD.quest_desc: [
		"Kulturen unterm Laub. Dasselbe Sieb, anderer Busch.",
		"So: siebe Erde mit einem Schnurnetz oder besser."
	]
	quest.42000000002905FD.title: "Shaded Garden"
	quest.42000000002905FE.quest_desc: [
		"Nasskulturen. Reis und der Rest der moorgesinnten Samen leben hier.",
		"So: siebe Erde mit einem Schnurnetz oder besser."
	]
	quest.42000000002905FE.title: "Soggy Garden"
	quest.42000000002905FF.quest_desc: [
		"Warmkulturen. Behalte einen Busch in einer Kiste; sie breiten sich trotzdem aus, wenn du sie pflanzt.",
		"So: siebe Erde mit einem Schnurnetz oder besser."
	]
	quest.42000000002905FF.title: "Tropical Garden"
	quest.4200000000290600.quest_desc: [
		"Der letzte der sechs. Jede HarvestCraft-Saat auf der Plattform beginnt als einer dieser Büsche.",
		"So: siebe Erde mit einem Schnurnetz oder besser."
	]
	quest.4200000000290600.title: "Windy Garden"
	quest.4200000000290601.quest_desc: [
		"Nicht das Schneidebrett von Farmer's Delight. Kupfer, ein Stock und ein Brett. Bereite Obst und Gemüse vor, bevor sie in den Topf kommen.",
		"So: Kupfer, ein Stock und ein Brett. Nicht das Schneidebrett von Farmer's Delight."
	]
	quest.4200000000290601.title: "Erntetafel"
	quest.4200000000290602.quest_desc: [
		"Suppen, Eintöpfe und Brühe. Kupfer und ein Stock. Der Topf kommt nach jeder Fertigung zurück.",
		"So: Kupfer und ein Stock. Der Topf kommt nach jedem formlosen Kochen zurück."
	]
	quest.4200000000290602.title: "Erntetopf"
	quest.4200000000290603.quest_desc: [
		"Pfannengerichte. Kupfer und Stöcke. Anderes Herstellen als die Delight-Pfanne; JEI hält sie auseinander.",
		"So: Kupfer und Stöcke. Anders als die Delight-Pfanne."
	]
	quest.4200000000290603.title: "Erntepfanne"
	quest.4200000000290604.quest_desc: [
		"Soßen und Reduktionen. Kupfer und ein Stock. Stell ihn neben den Topf.",
		"So: Kupfer und ein Stock."
	]
	quest.4200000000290604.title: "Saucepan"
	quest.4200000000290605.quest_desc: [
		"Terrakotta-Ring. Kuchen, Brote und alles, was eine Ofenform will.",
		"So: acht Terrakotta um eine leere Mitte."
	]
	quest.4200000000290605.title: "Bakeware"
	quest.4200000000290606.quest_desc: [
		"Bretter und ein Stock. Rührteige, Teige, Salate. Die stille Station.",
		"So: Bretter und ein Stock."
	]
	quest.4200000000290606.title: "Mixing Bowl"
	quest.4200000000290607.quest_desc: [
		"Terrakotta. Obst rein, Saft raus. Stell ihn zu einem Baum, nicht zu einem Beet.",
		"So: Terrakotta. Vier im T."
	]
	quest.4200000000290607.title: "Juicer"
	quest.4200000000290608.quest_desc: [
		"Stöcke und ein Stamm. Drück den Teig flach. Die Backform wartet.",
		"So: Stöcke links und rechts von einem Stamm."
	]
	quest.4200000000290608.title: "Roller"
	quest.4200000000290609.quest_desc: [
		"Andesit-Kiesel aus einem Feuersteinsieb, dann ein Stock. Mehl, Gewürze, Pasten.",
		"So: Andesit (Kiesel aus Erde oder Kies im Feuersteinsieb) und ein Stock."
	]
	quest.4200000000290609.title: "Grinder"
	quest.420000000029060A.quest_desc: [
		"Ein Wassereimer, geteilt in acht. Die meisten Rezepte wollen das, nicht einen Vanilla-Eimer.",
		"So: ein Wassereimer → acht Süßwasser."
	]
	quest.420000000029060A.title: "Fresh Water"
	quest.420000000029060B.quest_desc: [
		"Keine Kühe auf der Plattform. Kokosnuss (Erde mit Eisennetz) plus Süßwasser, oder teile später einen Milcheimer.",
		"So: Kokosnuss (Erde mit Eisennetz) plus Süßwasser, oder teile einen Milcheimer."
	]
	quest.420000000029060B.title: "Fresh Milk"
	quest.420000000029060C.quest_desc: [
		"Wasser in einem Topf, oder ein Mahlgang. Fast jedes herzhafte Rezept will es.",
		"So: Topf plus Wasser oder Süßwasser. Der Topf kommt zurück."
	]
	quest.420000000029060C.title: "Salt"
	quest.420000000029060D.quest_desc: [
		"Weizen durch das Mahlwerk. Hier fängt der Teig an.",
		"So: Mahlwerk plus Weizen (oder eine andere Mehlpflanze). Das Mahlwerk kommt zurück."
	]
	quest.420000000029060D.title: "Flour"
	quest.420000000029060E.quest_desc: [
		"Mehl, Salz und Süßwasser. Kuchen und Brote teilen sich diesen Klumpen.",
		"So: Rührschüssel, Mehl, Wasser, Salz."
	]
	quest.420000000029060E.title: "Dough"
	quest.420000000029060F.quest_desc: [
		"Knochen oder Gemüse im Topf. Suppen wollen eine Flasche davon, keine vage Brühe.",
		"So: Topf plus ein Knochen (Plattformhüter verkaufen Knochen) oder Gemüsereste."
	]
	quest.420000000029060F.title: "Stock"
	quest.4200000000290610.quest_desc: [
		"Erde mit Eisennetz. Zieh ihn auf der Plattform; die Vanilla-Eiche lässt keine Äpfel von Pam's fallen.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.4200000000290610.title: "Apfelbaum"
	quest.4200000000290611.quest_desc: [
		"Säure für Dressings und Fisch. Dasselbe Eisensieb.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.4200000000290611.title: "Zitronenbaum"
	quest.4200000000290612.quest_desc: [
		"Rindengewürz. Gebäck und Tees.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.4200000000290612.title: "Zimtbaum"
	quest.4200000000290613.quest_desc: [
		"Milch, Öl und tropisches Kochen.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.4200000000290613.title: "Kokospalme"
	quest.4200000000290614.quest_desc: [
		"Schoten für Süßes. Pflanz sie wie die anderen.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.4200000000290614.title: "Vanilleranke"
	quest.4200000000290615.quest_desc: [
		"Der Apfelbaum von Pam's trägt normale Äpfel, weit mehr, als Eichenlaub fallen lässt. Entsafter und Backform wollen sie beide.",
		"So: Eichenlaub lässt ein paar fallen; ein Pam's-Apfelbaum (Setzling aus Erde mit Eisennetz) trägt viele."
	]
	quest.4200000000290615.title: "Pam's-Apfel"
	quest.4200000000290616.quest_desc: [
		"Backform, Teig, Zucker, Äpfel. Das erste fertige Gebäck von HarvestCraft.",
		"So: Backform, Teig, Zucker, Äpfel von Pam's vom Apfelbaum."
	]
	quest.4200000000290616.title: "Apfelkuchen (Ernte)"
	quest.4200000000290617.quest_desc: [
		"Entsafter plus gemischtes Obst. Ein Getränk der Plattform, das kein Melonensaft ist.",
		"So: Entsafter und gemischtes Obst."
	]
	quest.4200000000290617.title: "Fruit Punch"
	quest.4200000000290618.quest_desc: [
		"Pfanne, Brot, Käse. Ein schnelles Mittagessen, während die Bäume wachsen.",
		"So: Pfanne, Brot, Butter und Käse — alles aus Süßwasser, Kokosmilch und Mehl."
	]
	quest.4200000000290618.title: "Grilled Cheese"
	quest.4200000000290619.quest_desc: [
		"Trockene Chilis, Tomate, Zwiebel, Bohne, Gewürzblatt und Fleisch oder Seidentofu. Food Extended fängt an, sich zu lohnen.",
		"So: Topf, trockene Chili, Tomate, Zwiebel, Bohne, Gewürzblatt und Fleisch oder Seidentofu."
	]
	quest.4200000000290619.title: "Chili-Schale"
	quest.420000000029061A.quest_desc: [
		"Gewürze aus der Mühle, Gemüse aus den Gärten, Arbeit am Topf.",
		"So: Stieltopf, Reis, Kokosnuss, Chili, schwarzer Pfeffer, Currypulver (Gewürzblatt + Senf + Zimt)."
	]
	quest.420000000029061A.title: "Curryteller"
	quest.420000000029061B.quest_desc: [
		"Teig, Soße, Fleisch. Backform. Eine ganze HarvestCraft-Mahlzeit.",
		"So: Backform, Teig, Tomate, Käse, Peperoni (Speck vom Schwein, oder Tofu-Speck aus Ahorn + Soja)."
	]
	quest.420000000029061B.title: "Pepperoni Pizza"
	quest.420000000029061C.quest_desc: [
		"Reis aus dem Nassgarten, Karotte, Zwiebel, Erbsen und ein Ei — Seidentofu springt ein, bis es Hühner gibt.",
		"So: Pfanne, Reis aus dem Nassgarten, Karotte, Zwiebel, Erbsen und ein Ei — Seidentofu zählt als Ei."
	]
	quest.420000000029061C.title: "Garten-Bratreis"
	quest.420000000029061D.quest_desc: [
		"Teeblatt und Gewürzblatt im Topf. Schattengarten und Nassgarten decken beides ab.",
		"So: Topf, Teeblatt und Gewürzblatt. Der Schattengarten lässt Tee und Gewürz fallen."
	]
	quest.420000000029061D.title: "Green Tea"
	quest.420000000029061E.quest_desc: [
		"Öl und würzige Frucht. Freiwilliger Fang am Eisennetz.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.420000000029061E.title: "Olivenbaum"
	quest.420000000029061F.quest_desc: [
		"Saft und Abrieb. Freiwillig.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.420000000029061F.title: "Orangenbaum"
	quest.4200000000290620.quest_desc: [
		"Sommerfrucht. Freiwillig.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.4200000000290620.title: "Pfirsichbaum"
	quest.4200000000290621.quest_desc: [
		"Pfeffer für die Mühle. Freiwillig.",
		"So: siebe Erde mit einem Eisennetz für Küchen-Setzlinge, dann zieh die Frucht."
	]
	quest.4200000000290621.title: "Pfefferbaum"
	quest.4200000000290622.quest_desc: [
		"Frittierfett. Freiwillige Grundzutat.",
		"So: presse Samen oder Oliven in JEI. Freiwillige Grundzutat."
	]
	quest.4200000000290622.title: "Cooking Oil"
	quest.4200000000290623.quest_desc: [
		"Milch und Salz. Freiwillige Grundzutat.",
		"So: Topf und Milch (Kokosmilch aus Süßwasser geht)."
	]
	quest.4200000000290623.title: "Butter"
	quest.4200000000290624.quest_desc: [
		"Ein Ei durch den Entsafter. Freiwillig.",
		"So: Entsafter und ein Ei (Seidentofu zählt). Freiwillig."
	]
	quest.4200000000290624.title: "Mayonnaise"
	quest.4200000000290625.quest_desc: [
		"Schneidebrett, gemischtes Obst. Freiwillig.",
		"So: Schneidebrett und gemischtes Obst. Freiwillig."
	]
	quest.4200000000290625.title: "Fruit Salad"
	quest.4200000000290626.quest_desc: [
		"Pasta-Abend. Freiwillig.",
		"So: Gärten und Obstbäume liefern die Zutaten. Soja-Tofu ersetzt Fleisch und Ei. JEI nennt die Station."
	]
	quest.4200000000290626.title: "Spaghetti-Essen"
	quest.4200000000290627.quest_desc: [
		"Frühstück zum Angeben. Freiwillig.",
		"So: Gärten und Obstbäume liefern die Zutaten. Soja-Tofu ersetzt Fleisch und Ei. JEI nennt die Station."
	]
	quest.4200000000290627.title: "Bacon Pancakes"
	quest.4200000000290628.quest_desc: [
		"Erde mit Eisennetz für einen Avocado-Setzling, dann Pfanne, Toast, Salz, Knoblauch, Gewürzblatt.",
		"So: Avocado-Setzling vom Eisennetz, dann Pfanne mit Toast, Salz, Knoblauch, Gewürzblatt."
	]
	quest.4200000000290628.title: "Avocado-Toast"
	quest.4200000000290629.quest_desc: [
		"Nicht der Delight-Hamburger. Freiwillig.",
		"So: Gärten und Obstbäume liefern die Zutaten. Soja-Tofu ersetzt Fleisch und Ei. JEI nennt die Station."
	]
	quest.4200000000290629.title: "Zwiebelburger"
	quest.420000000029062A.quest_desc: [
		"Entsafter, Äpfel. Freiwillig.",
		"So: Entsafter und Pam's Äpfel. Freiwillig."
	]
	quest.420000000029062A.title: "Apple Juice"
	quest.420000000029062B.quest_desc: [
		"Pfanne, Brot und Butter. Freiwillig.",
		"So: Pfanne, Brot und Butter. Freiwillig."
	]
	quest.420000000029062B.title: "Toastscheibe"
	quest.42000000002A062C.quest_desc: [
		"Vier Stöcke im Quadrat. Setze sie auf Ackerboden. Die Samen des Grundspiels wandeln sich um, wenn du sie pflanzt — die von Mystical Agriculture nicht.",
		"Stecke einen zweiten Satz Stöcke in denselben Block, um eine Kreuzung zu machen — ein leeres Paar, das nach dem reifen Nachbarn gerät. Umgib sie auf allen vier Seiten mit Eltern, dann sät sie sich in wenigen Minuten selbst; Knochenmehl auf der Kreuzung erzwingt sofort einen Versuch.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: vier Stöcke im Quadrat. Auf Ackerboden setzen, dann eine Saat pflanzen."
	]
	quest.42000000002A062C.title: "Hölzerne Anbaustöcke"
	quest.42000000002A062D.quest_desc: [
		"Ein Buch und Feder (Buch, Tintenbeutel, Feder) plus Weizensamen. Lass es im Analysator.",
		"So: Buch und Feder (Buch, Tintenbeutel, Feder) plus Weizensamen. Holzkohle plus eine Glasflasche ergeben die Tinte."
	]
	quest.42000000002A062D.title: "Anbautagebuch"
	quest.42000000002A062E.quest_desc: [
		"Glasscheibe und Stöcke. Schau eine Pflanze an, um Wachstum, Ertrag und Stärke zu lesen, ohne sie zu ernten.",
		"So: Glasscheibe zwischen Stöcken, dann ein Stockgriff. Schau eine gepflanzte Pflanze an."
	]
	quest.42000000002A062E.title: "Magnifying Glass"
	quest.42000000002A062F.quest_desc: [
		"Glas, Steinstufe, Bretter, Stöcke. Leg einen Samen mit dem Tagebuch hinein. Die Zucht wird sichtbar.",
		"Fruchtbarkeit ist der Wert, der die Kreuzung antreibt: ein frischer Samen steht bei 1 von 10, und jeder Punkt hebt die Chance, dass eine Pflanze als Elternteil gewählt wird. Analysiere, pflanze die besten neu, und die Kreuzungen kommen schneller.",
		"So: Glasscheiben, Steinstufe, Bretter und Stöcke. Setze das Tagebuch ein, dann einen Samen."
	]
	quest.42000000002A062F.title: "Seed Analyzer"
	quest.42000000002A0630.quest_desc: [
		"Unkraut ist in diesem Paket aus, aber die Harke räumt trotzdem einen Stock ab. Trag trotzdem eine bei dir.",
		"So: Holzzaun über einem Stock. Unkraut ist aus; sie räumt trotzdem einen Stock ab."
	]
	quest.42000000002A0630.title: "Holzharke"
	quest.42000000002A0631.quest_desc: [
		"Hebe eine Pflanze auf und setze sie mit intakten Werten wieder ab. Verschiebe eine 10-10, ohne sie zu zerstören.",
		"So: zwei Eisenbarren und ein Stock. Hebe eine Pflanze mit intakten Werten auf."
	]
	quest.42000000002A0631.title: "Pflanzkelle"
	quest.42000000002A0632.quest_desc: [
		"Schneide eine reife Pflanze für ihr Schnittprodukt und setze sie zurück. Blumen und einige HarvestCraft-Pflanzen.",
		"So: Schere, Eisen und ein Stock. Schneide eine reife Pflanze und setze sie zurück."
	]
	quest.42000000002A0632.title: "Pflanzenschneider"
	quest.42000000002A0633.quest_desc: [
		"Trag eine Zuchtlinie. Füll sie aus dem Analysator, leere sie auf die Stöcke.",
		"So: Leder und Schnur. Aus dem Analysator füllen."
	]
	quest.42000000002A0633.title: "Samentasche"
	quest.42000000002A0634.quest_desc: [
		"Stabilere Stöcke. Dieselben Pflanzregeln, weniger Ärger, wenn du sie anstößt.",
		"So: zwei Eisenklumpen in einer Spalte ergeben acht."
	]
	quest.42000000002A0634.title: "Iron Crop Sticks"
	quest.42000000002A0635.quest_desc: [
		"Die bessere Harke. Immer noch eine Gewohnheit, auch ohne Unkraut.",
		"So: Eisengitter über einem Stock."
	]
	quest.42000000002A0635.title: "Eisenharke"
	quest.42000000002A0636.quest_desc: [
		"Hält Wasser für die Kanäle. Eine Farm auf der Plattform, die nicht jeden Morgen Eimer schleppt.",
		"So: Bretter. Hält Wasser für die Kanäle."
	]
	quest.42000000002A0636.title: "Irrigation Tank"
	quest.42000000002A0637.quest_desc: [
		"Leit das Wasser vom Tank die Reihe entlang. Die Pflanzen trinken aus dem Kanal, nicht von dir.",
		"So: formlos aus einem Tank — ein Tank wird zu acht Kanälen."
	]
	quest.42000000002A0637.title: "Irrigation Channel"
	quest.42000000002A0638.quest_desc: [
		"Stoppe und starte eine Leitung, ohne den Tank zu zerstören.",
		"So: Eisengitter, roter Farbstoff und ein Eisenbarren. Stoppe und starte eine Leitung, ohne den Tank zu zerstören."
	]
	quest.42000000002A0638.title: "Channel Valve"
	quest.42000000002A0639.quest_desc: [
		"Regen im Quadrat. Setz ihn auf einen Kanal über den Stöcken.",
		"So: setz ihn auf einen Kanal über den Stöcken. JEI nennt das Rezept."
	]
	quest.42000000002A0639.title: "Sprinkler"
	quest.42000000002A063A.quest_desc: [
		"Deck einen Kanal ab, damit du die Reihe entlanggehen kannst.",
		"So: deck einen Kanal ab, damit du die Reihe entlanggehen kannst."
	]
	quest.42000000002A063A.title: "Kanalrost"
	quest.42000000002A063B.quest_desc: [
		"Lies den Raum ab. Licht, Feuchte, der Grund, warum eine Pflanze stockte.",
		"So: herstellen, dann im Raum platzieren, um Licht und Feuchte zu lesen."
	]
	quest.42000000002A063B.title: "Greenhouse Monitor"
	quest.42000000002A063C.quest_desc: [
		"Späte Stöcke. Feuerfest, stur, für Pflanzen, die dem Holz zu viel abverlangen. Zwei benachbarte reife Pflanzen können sich kreuzen.",
		"So: zwei Obsidian in einer Spalte ergeben acht. Zwei benachbarte reife Pflanzen können sich kreuzen."
	]
	quest.42000000002A063C.title: "Obsidian Crop Sticks"
	quest.42000000002A063D.quest_desc: [
		"Ein Kanal, den du begehen kannst. Freiwillig.",
		"So: ein Kanal, den du begehen kannst. Freiwillig."
	]
	quest.42000000002A063D.title: "Hohlkanal"
	quest.42000000002A063E.quest_desc: [
		"Erzpflanzen lassen diese fallen. Freiwillige Zuchtlinie.",
		"So: hölzerne Anbaustöcke aus Stöcken; das Tagebuch ist ein Buch und Feder plus Samen; der Analysator ist Glas und Holz. Auf Ackerboden pflanzen."
	]
	quest.42000000002A063E.title: "Kupferklumpen-Pflanze"
	quest.42000000002A063F.quest_desc: [
		"Quarz von einem Stock. Freiwillig.",
		"So: hölzerne Anbaustöcke aus Stöcken; das Tagebuch ist ein Buch und Feder plus Samen; der Analysator ist Glas und Holz. Auf Ackerboden pflanzen."
	]
	quest.42000000002A063F.title: "Quarzsplitter-Pflanze"
	quest.42000000002A0640.quest_desc: [
		"Brennstoff aus einer Pflanze. Freiwillig.",
		"So: hölzerne Anbaustöcke aus Stöcken; das Tagebuch ist ein Buch und Feder plus Samen; der Analysator ist Glas und Holz. Auf Ackerboden pflanzen."
	]
	quest.42000000002A0640.title: "Coal Pebble"
	quest.42000000002A0641.quest_desc: [
		"Späte Erzpflanze. Freiwillig.",
		"So: hölzerne Anbaustöcke aus Stöcken; das Tagebuch ist ein Buch und Feder plus Samen; der Analysator ist Glas und Holz. Auf Ackerboden pflanzen."
	]
	quest.42000000002A0641.title: "Smaragdscherbenpflanze"
	quest.42000000002A0642.quest_desc: [
		"Späte Erzpflanze. Freiwillig.",
		"So: hölzerne Anbaustöcke aus Stöcken; das Tagebuch ist ein Buch und Feder plus Samen; der Analysator ist Glas und Holz. Auf Ackerboden pflanzen."
	]
	quest.42000000002A0642.title: "Diamantscherbenpflanze"
	quest.42000000002A0643.quest_desc: [
		"Spitzen-Erzpflanze. Freiwillig und langsam.",
		"So: hölzerne Anbaustöcke aus Stöcken; das Tagebuch ist ein Buch und Feder plus Samen; der Analysator ist Glas und Holz. Auf Ackerboden pflanzen."
	]
	quest.42000000002A0643.title: "Netherite Sliver"
	quest.42000000002A0644.quest_desc: [
		"Die eigene Blume von AgriCraft. Freiwillig.",
		"So: hölzerne Anbaustöcke aus Stöcken; das Tagebuch ist ein Buch und Feder plus Samen; der Analysator ist Glas und Holz. Auf Ackerboden pflanzen."
	]
	quest.42000000002A0644.title: "Amathyllis Petal"
	reward.5000000000060135.title: "Rückkehrfaden: +1 Clowder-Leben"
	reward.5000000000080193.title: "Rückkehrfaden: +1 Clowder-Leben"
	reward.50000000000901CC.title: "Rückkehrfaden: +1 Clowder-Leben"
	reward.5000000000170337.title: "Rückkehrfaden: +1 Clowder-Leben"
	reward.50000000002004DD.title: "Rückkehrfaden: +1 Clowder-Leben"
	reward.5000000000220581.title: "Rückkehrfaden: +1 Clowder-Leben"
	reward.7200000000000101.title: "Rückkehrfaden: +1 Clowder-Leben (Rechtsklick zum Ausgeben)"
	reward.7200000000000102.title: "Vorräte der Plattformhüter (vier Würfe)"
	reward.7200000000000201.title: "Rückkehrfaden: +1 Clowder-Leben (Rechtsklick zum Ausgeben)"
	reward.7200000000000202.title: "Vorräte der Splittsänger (vier Würfe)"
	reward.7200000000000301.title: "Rückkehrfaden: +1 Clowder-Leben (Rechtsklick zum Ausgeben)"
	reward.7200000000000302.title: "Vorräte der Wurzelbinder (vier Würfe)"
	reward.7200000000000401.title: "Rückkehrfaden: +1 Clowder-Leben (Rechtsklick zum Ausgeben)"
