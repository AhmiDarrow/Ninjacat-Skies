	quest.42000000001D047B.title: "Schnittstelle (Netzwerk)"
	quest.42000000001D047C.quest_desc: [
		"Zieh Gegenstände in den Speicher.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D047C.title: "Importbus (Netzwerk)"
	quest.42000000001D047D.quest_desc: [
		"Schiebt Gegenstände aus dem Netzwerk in einen Behälter.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D047D.title: "Exportbus (Netzwerk)"
	quest.42000000001D047E.quest_desc: [
		"Lässt das Netzwerk ein äußeres Inventar als sein eigenes lesen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D047E.title: "Speicherbus (Netzwerk)"
	quest.42000000001D047F.quest_desc: [
		"Durchsuche und zieh alles, was das Netzwerk lagert.",
