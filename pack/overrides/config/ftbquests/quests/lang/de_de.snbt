	quest.42000000001C0426.quest_desc: [
		"Wandelt Kesseldampf in gleichmäßige Drehung um.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0426.title: "Dampfmaschine"
	quest.42000000001C0427.quest_desc: [
		"Bläst Überdruck ab, mit einem Ton, den du über die ganze Plattform hörst.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
