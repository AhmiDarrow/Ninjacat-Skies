	quest.42000000001D046B.quest_desc: [
		"Speist Energie von außen in den digitalen Webstuhl.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D046B.title: "Energieakzeptor (Netzwerk)"
	quest.42000000001D046C.quest_desc: [
