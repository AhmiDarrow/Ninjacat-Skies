	quest.42000000001C042E.title: "Umschlossener Lüfter (Uhrwerke)"
	quest.42000000001C042F.quest_desc: [
		"Rührt ein Becken von oben, ohne Hände.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C042F.title: "Schneebesen (Uhrwerke)"
	quest.42000000001C0430.quest_desc: [
		"Bläst Gegenstände und Kreaturen weg, wenn er schnell genug dreht.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
