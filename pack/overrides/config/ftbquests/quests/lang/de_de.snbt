	quest.42000000001C0442.title: "Elektronenröhre"
	quest.42000000001C0443.quest_desc: [
		"Auf eine Welle gesetzt, wird es zur Hand eines Platzierers.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0443.title: "Messinghand"
	quest.42000000001C0444.quest_desc: [
		"Nimmt Gegenstände von einer Stelle und setzt sie an eine andere.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0444.title: "Mechanischer Arm"
	quest.42000000001C0445.quest_desc: [
		"Setzt eine genaue Drehzahl für alles, was ihm folgt.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
