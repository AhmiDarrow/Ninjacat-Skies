	reward.7200000000000702.title: "Vorräte der Koloniehüter (vier Würfe)"
	reward.7200000000000801.title: "Rückkehrfaden: +1 Clowder-Leben (Rechtsklick zum Ausgeben)"
	reward.7200000000000802.title: "Vorräte der Siegelschneider (vier Würfe)"
	reward.7200000000000901.title: "Rückkehrfaden: +1 Clowder-Leben (Rechtsklick zum Ausgeben)"
	reward.7200000000000902.title: "Vorräte der Webstuhlnäher (vier Würfe)"
	reward.7200000000000A01.title: "Vorräte der Neun Stämme (vier Würfe)"
	reward_table.7100000000000001.title: "Geschenk der Plattformhüter"
	reward_table.7100000000000002.title: "Geschenk der Splittsänger"
	reward_table.7100000000000003.title: "Geschenk der Wurzelbinder"
	reward_table.7100000000000004.title: "Geschenk der Randgänger"
	reward_table.7100000000000005.title: "Geschenk der Trommelherzen"
	reward_table.7100000000000006.title: "Geschenk der Musterweber"
	reward_table.7100000000000007.title: "Geschenk der Koloniehüter"
	reward_table.7100000000000008.title: "Geschenk der Siegelschneider"
	reward_table.7100000000000009.title: "Geschenk der Webstuhlnäher"
	reward_table.710000000000000A.title: "Geschenk der Neun Stämme"
	chapter.310000000000002B.chapter_subtitle: [
		"Stücke der alten Welt treiben hinauf zu deiner Plattform. Erreiche sie, bevor sie sich entweben."
	]
	chapter.310000000000002B.title: "Treibwracks"
	quest.42000000002B0801.quest_desc: [
		"Sobald Erde gespannt ist, treiben hin und wieder Stücke der alten Welt hinauf zu deiner Plattform und bleiben in deinem Schuss hängen. Der Hüter sagt dem ganzen Clowder Bescheid, wenn eines ankommt.",
		"Sie bleiben nicht: ein Wrack hält eine Weile der Onlinezeit deines Clowders, dann entwebt es sich zurück in die Leere. Niemand fällt, und nichts, was du verdient hast, geht verloren."
	]
	quest.42000000002B0801.title: "Etwas treibt heran"
	quest.42000000002B0802.quest_desc: [
		"Steh an der Kante deiner Plattform, schau auf das Wrack und benutze eine Ankerspule: eine Fadenbrücke legt sich von selbst hin und steigt in halben Schritten.",
		"Fällst du, fängt dich der Faden, für drei Herzen. Die Leere ist die Kulisse, nicht die Strafe."
	]
	quest.42000000002B0802.title: "Überquere die Leere"
	quest.42000000002B0803.quest_desc: [
		"Jedes Wrack verlangt eines: öffne seine Herztruhe, zerbrich seine Spawner, fädle seine Säulen neu, bring ein Echo nach Hause, oder halte die Naht.",
		"Schließ es ab, und jeder, der es betritt, bekommt Geborgener Schuss und ein Siegel. Der Bergerrahmen verwandelt Schuss in Spulen, Köder, Schlüssel und Zier."
	]
	quest.42000000002B0803.title: "Bergung"
	quest.42000000002B0804.quest_desc: [
		"Der Wrackatlas hält die Orte jedes Stammes, die du abgeschlossen hast: neun Stränge mal sechs Arten von Ort. Eine volle Spalte, eine volle Reihe, alle Stempel: jedes bringt einen kleinen, dauerhaften Bonus.",
		"Die Seiten bringen ihre Überlieferung im Kodex. Hinweisseiten aus Truhen öffnen versteckte Räume. Öffne den Wrackatlas, um dies abzuhaken."
	]
	quest.42000000002B0804.title: "Der Atlas"
	quest.42000000002B0805.quest_desc: [
		"Bring fünf Treibwracksiegel: fünf Wracks abgeschlossen, von irgendwem in deinem Clowder.",
		"Wiederholbar: gib sie ab, so oft du willst.",
		"So: schließe die Aufgabe eines Treibwracks ab. Jeder, der es betreten hat, bekommt ein Siegel."
	]
	quest.42000000002B0805.title: "Fünf Siegel"
	quest.42000000002B0806.quest_desc: [
		"Zerbrich drei ausgefranste Spawner und gib ihre Kerne ab.",
		"Wiederholbar: gib sie ab, so oft du willst.",
		"So: zerbrich einen ausgefransten Spawner auf einem Treibwrack; jeder lässt seinen Kern fallen."
	]
	quest.42000000002B0806.title: "Ausgefranste Kerne"
	quest.42000000002B0807.quest_desc: [
		"Eine Scherbe von einem geflickten Überrest. Gib sie ab.",
		"Wiederholbar: gib sie ab, so oft du willst.",
		"So: öffne den versiegelten Riss einer Feste mit einem Schussfaden-Schlüssel und flicke den Überrest darin."
	]
	quest.42000000002B0807.title: "Rissscherbe"
	quest.42000000002B0808.quest_desc: [
		"Jeder Kern eines Strangs. Die Köder dieses Stammes kosten die Hälfte, seine Wracks kommen etwas öfter, und sein Banner gehört dir."
	]
	quest.42000000002B0808.title: "Eine ganze Spalte"
	quest.42000000002B0809.quest_desc: [
		"Eine Art von Ort in allen neun Stämmen. Seine versteckten Räume sind jetzt immer offen."
	]
	quest.42000000002B0809.title: "Eine ganze Reihe"
	quest.42000000002B080A.quest_desc: [
		"Schließe ein Wrack jedes Modifikators ab. Deine Wracks halten ein Viertel länger."
	]
	quest.42000000002B080A.title: "Sechs Stempel"
	quest.42000000002B080B.quest_desc: [
		"Fünfundzwanzig Seiten gefüllt."
	]
	quest.42000000002B080B.title: "Halber Atlas"
	quest.42000000002B080C.quest_desc: [
		"Ein für den Strang dieses Wracks geschnittener Schussfaden-Schlüssel öffnet den versiegelten Riss einer Feste. Drinnen trägt etwas Kleines und Ausgefranstes die Gestalt eines Wächters."
	]
	quest.42000000002B080C.title: "In den Riss"
	quest.42000000002B080D.quest_desc: [
		"Flicke alle neun Überreste. Schussfaden-Schlüssel kosten die Hälfte."
	]
	quest.42000000002B080D.title: "Alle Überreste"
	quest.42000000002B080E.quest_desc: [
		"Alle vierundfünfzig Seiten. Irgendwo unter den Skies beginnt das Herz der alten Welt, zu dir zu treiben."
	]
	quest.42000000002B080E.title: "Jede Seite"
	quest.42000000002B080F.quest_desc: [
		"Steh im Herzen der alten Welt und fädele es neu ein. Es kommt nicht zweimal."
	]
	quest.42000000002B080F.title: "Herz des Gewebes"
}
