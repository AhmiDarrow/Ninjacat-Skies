	quest.42000000001D0469.title: "Ummanteltes Fluix"
	quest.42000000001D046A.quest_desc: [
		"Kabel, das die eigenen Kanäle tragen und filtern kann.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
