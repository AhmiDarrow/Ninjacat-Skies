	reward.7200000000000502.title: "Vorräte der Trommelherzen (vier Würfe)"
	reward.7200000000000601.title: "Rückkehrfaden: +1 Clowder-Leben (Rechtsklick zum Ausgeben)"
	reward.7200000000000602.title: "Vorräte der Musterweber (vier Würfe)"
