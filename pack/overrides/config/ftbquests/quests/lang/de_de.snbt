{
	chapter.3100000000000001.chapter_subtitle: [
		"Erwache — überlebe, beanspruche die Plattform, lass den Kodex erwachen."
	]
	chapter.3100000000000001.title: "Strang: Erde"
	chapter.3100000000000002.chapter_subtitle: [
		"Berge — zieh die gefallene Welt zurück in die Materie."
	]
	chapter.3100000000000002.title: "Strang: Stein"
	chapter.3100000000000003.chapter_subtitle: [
		"Wurzele — zieh Anker, damit die Plattform aufhört auszufransen."
	]
	chapter.3100000000000003.title: "Strang: Spross"
	chapter.3100000000000004.chapter_subtitle: [
		"Kante — rüste dich aus und verlass die Plattform mit Absicht."
	]
	chapter.3100000000000004.title: "Strang: Klaue"
	chapter.3100000000000005.chapter_subtitle: [
		"Summ — Rhythmus und Puls, bevor die Drähte kommen."
	]
	chapter.3100000000000005.title: "Strang: Funke"
	chapter.3100000000000006.chapter_subtitle: [
		"Muster — eine Fabrik als Lied, das sich selbst trägt."
	]
	chapter.3100000000000006.title: "Strang: Uhr"
	chapter.3100000000000007.chapter_subtitle: [
		"Kolonie — halt etwas am Leben, das etwas anderes am Leben hält."
	]
	chapter.3100000000000007.title: "Strang: Schwarm"
	chapter.3100000000000008.chapter_subtitle: [
		"Binde — Siegel, Riten und zwei Zopfpfade in einer Kordel."
	]
	chapter.3100000000000008.title: "Strang: Siegel"
	chapter.3100000000000009.chapter_subtitle: [
		"Neuwebe — der digitale Webstuhl, die Mark, das Fragment."
	]
	chapter.3100000000000009.title: "Strang: Spindel"
	chapter.310000000000000A.title: "Tiefsieb"
	chapter.310000000000000B.title: "Lager und Rucksäcke"
	chapter.310000000000000C.title: "Mekanism-Werke"
	chapter.310000000000000D.title: "Powah-Netz"
	chapter.310000000000000E.title: "Arkane Seite"
	chapter.310000000000000F.chapter_subtitle: [
		"Teams, die Halle, der Pfosten und der Ausfrans."
	]
	chapter.310000000000000F.title: "Clowder-Halle"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Küchenlinie"
	chapter.3100000000000013.title: "Kampfzauber"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Plattformdekor"
	chapter.3100000000000016.title: "Nether-Brückenkopf"
	chapter.3100000000000017.title: "Ende-Brückenkopf"
	chapter.3100000000000018.title: "Essenzfelder"
	chapter.3100000000000019.chapter_subtitle: [
		"Jedes Nest ist ein Ring aus irgendetwas um eine Blume."
	]
	chapter.3100000000000019.title: "Schwarm-Bienenhaus"
	chapter.310000000000001A.title: "Rohrwerk"
	chapter.310000000000001B.title: "Anderswelt"
	chapter.310000000000001C.title: "Tiefe Uhrwerke"
	chapter.310000000000001D.title: "Spindelnetz"
	chapter.310000000000001E.title: "Leerenwerk"
	chapter.310000000000001F.title: "Verpackte Linien"
	chapter.3100000000000020.title: "QIO und Mek-Gipfel"
	chapter.3100000000000021.title: "Jagd und Farm"
	chapter.3100000000000022.title: "Stammesweben"
	chapter.3100000000000023.chapter_subtitle: [
		"Die Splittsänger schneiden einen Stein auf hundert Arten."
	]
	chapter.3100000000000023.title: "Steinmetz"
	chapter.3100000000000024.chapter_subtitle: [
		"Eine Plattform ist nur ein Sims, bis jemand einen Stuhl darauf stellt."
	]
	chapter.3100000000000024.title: "Einrichtung"
	chapter.3100000000000025.chapter_subtitle: [
		"Die kleinen Maschinen, die die Hüter hinterließen."
	]
	chapter.3100000000000025.title: "Kleine Hütereien"
	chapter.3100000000000026.chapter_subtitle: [
		"Der Puls der Trommelherzen lernt, durch Kupfer zu laufen."
	]
	chapter.3100000000000026.title: "Der Strom"
	chapter.3100000000000027.chapter_subtitle: [
		"Der Schnitt hat dreizehn Wächter zerrissen. Spanne jeden Strang neu, indem du seinen Wächter schlägst."
	]
	chapter.3100000000000027.title: "Gerissene Wächter"
	chapter.3100000000000028.chapter_subtitle: [
		"Geh die Mark. Zähme ein Gelbes. Esther wartet in der Halle, nachdem du dort warst."
	]
	chapter.3100000000000028.title: "Plattformläufer"
	chapter.3100000000000029.chapter_subtitle: [
		"Gärten aus dem Sieb. Koch, was eine Plattform der Leere nie wachsen ließ."
	]
	chapter.3100000000000029.title: "Erntetafel"
	chapter.310000000000002A.chapter_subtitle: [
		"Anbaustöcke, Werte, Bewässerung. Auf einem Sims fasst Unkraut nicht."
	]
	chapter.310000000000002A.title: "Anbaustöcke"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Fertigen und Spannung"
	chapter_group.2100000000000003.title: "Neuweben"
	chapter_group.2100000000000004.title: "Nebenpfade"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"Du bist auf einem Sims aufgewacht. Sieh in den Abgrund, dann klick hier.",
		"Gravis (`) ist die Auftragsliste. Der Schnurrhaar-Kodex ist Hier anfangen.",
		"So: klick die Aufgabe. Dann schlag die Eiche."
	]
	quest.4200000000018001.title: "Sieh in den Abgrund"
	quest.4200000000010001.quest_desc: [
		"Du bist Skybound. Dies hier ist nicht gefallen.",
		"Acht Stämme. Fang beim Baum an; er hat bei dir angefangen.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: schlag die Eiche auf deiner Plattform. Acht Stämme starten Erwachen."
	]
	quest.4200000000010001.title: "Erwachen auf einer Plattform"
	quest.4200000000010002.quest_desc: [
		"Erde ist ein Versprechen der Plattform an deine Stiefel.",
		"Sechzehn Blöcke. Mach das Versprechen breiter.",
		"So: Startkiste, Bruchstein+Faden-Senke, Siebreste, oder /clowder hub (Plattformhüter)."
	]
	quest.4200000000010002.title: "Etwas zum Stehen"
	quest.4200000000010003.quest_desc: [
		"Hände brauchen eine Fläche. Alles danach ist eine Fläche.",
		"So: vier Bretter im Quadrat."
	]
	quest.4200000000010003.title: "Fertige eine Werkbank"
	quest.4200000000010004.quest_desc: [
		"Klaue kommt später. Für jetzt Holz, das zubeißt.",
		"So: drei Bretter über zwei Stöcken."
	]
	quest.4200000000010004.title: "Holzspitzhacke"
	quest.4200000000010005.quest_desc: [
		"Grün gegen den Abgrund.",
		"Pflanz ihn, bevor du hungrig bist.",
		"So: brich Eichenlaub, oder /clowder hub Wurzelbinder (8 Faden für vier)."
	]
	quest.4200000000010005.title: "Erster Setzling"
	quest.4200000000010006.quest_desc: [
		"Vierundsechzig Bretter sind eine Plattform, die sich nicht mehr wie ein Sims anfühlt.",
		"So: ein Stamm im Fertigungsgitter ergibt vier."
	]
	quest.4200000000010006.title: "Brettervorrat"
	quest.4200000000010007.quest_desc: [
		"Griffe, Gestelle, die Knochen der Werkzeuge.",
		"So: zwei Bretter in einer Spalte."
	]
	quest.4200000000010007.title: "Stockbündel"
	quest.4200000000010008.quest_desc: [
		"Leg die Dinge hin, wo sie bleiben. Ein Clowder teilt eine Kiste, bevor es irgendetwas sonst teilt.",
		"So: acht Bretter um eine leere Mitte."
	]
	quest.4200000000010008.title: "Kiste für den Clowder"
	quest.4200000000010009.quest_desc: [
		"Sieh die Kante, bevor die Kante dich sieht.",
		"So: Kohle oder Holzkohle über einem Stock. Verwandte bei /clowder hub verkaufen ein Bündel."
	]
	quest.4200000000010009.title: "Fackellinie"
	quest.420000000001000A.quest_desc: [
		"Eis und Lava machen Stein, wo keiner war.",
		"Normal- und Schwer-Plattformen bringen beides mit. Die Plattformhüter bei /clowder hub verkaufen einen Eimer.",
		"So: Lava neben Wasser (oder schmelzendes Eis). Hämmere Stein. Der Stand der Splittsänger bei /clowder hub verkauft ein Bündel."
	]
	quest.420000000001000A.title: "Bruchsteinvorrat"
	quest.420000000001000B.quest_desc: [
		"Wärme, die noch nicht Funke ist.",
		"Die Plattformhüter hätten dies einen Herd genannt.",
		"So: acht Bruchstein um eine leere Mitte."
	]
	quest.420000000001000B.title: "Ofenhitze"
	quest.420000000001000C.quest_desc: [
		"Hunger ist eine weiche Leere. Acht Brote schließen sie eine Weile.",
		"So: drei Weizen in einer Reihe, oder /clowder hub Herdhüter."
	]
	quest.420000000001000C.title: "Koch eine Mahlzeit"
	quest.420000000001000D.quest_desc: [
		"Setze Lava, schmilz Eis zu einer Quelle, füll den Eimer.",
		"Leicht bringt Wasser mit; Normal und Schwer bringen die Teile.",
		"So: leerer Eimer auf eine Wasserquelle. Normal/Schwer: Lava setzen, Eis schmelzen, füllen."
	]
	quest.420000000001000D.title: "Fang den Regen"
	quest.420000000001000E.quest_desc: [
		"Reste des Webstuhls, die noch halten. Jede Aufgabe gibt etwas zurück.",
		"Entwirre einen zu Schnur, oder gib sie an den Verwandtenständen in /clowder hub aus.",
		"So: Aufgabenbelohnungen, Erde mit Feuersteinnetz auf einem Webrahmen, Hütervorräte."
	]
	quest.420000000001000E.title: "Ausgefranste Währung"
	quest.420000000001000F.quest_desc: [
		"Beschädigt, aber er lehrt noch. Öffne Hier anfangen.",
		"Rechtsklick auf das Buch und öffne Hier anfangen. Gravis (`): die Auftragsliste.",
		"So: Startpaket / Dock-Truhe. Rechtsklick auf das Buch; Gravis (`) ist die Auftragsliste."
	]
	quest.420000000001000F.title: "Kodex in der Hand"
	quest.4200000000010010.quest_desc: [
		"Setze einen Spawnpunkt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010010.title: "Bettanspruch"
	quest.4200000000010011.quest_desc: [
		"Steig ohne Seil in die Tiefe. Billig genug, um in jedem Schacht eine zu lassen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010011.title: "Leiter hinab"
	quest.4200000000010012.quest_desc: [
		"Spinnenseide, aufgehoben für spätere Netze. Jede Faser wird irgendwann gebraucht.",
		"So: entwirre Ausgefransten Faden (1 → 3). Spinnen. Webflusen an einer Echobindung. Umgekehrte Garn-Senke."
	]
	quest.4200000000010012.title: "Schnurvorrat"
	quest.4200000000010013.quest_desc: [
		"Beschleunige das Grün.",
		"So: Knochen im Raster, oder Senke aus Faden + verrottetem Fleisch, oder /clowder hub Plattformhüter."
	]
	quest.4200000000010013.title: "Knochenmehlvorrat"
	quest.4200000000010014.quest_desc: [
		"Erweitere die Plattform.",
		"So: Startkiste, Bruchstein+Faden-Senke, Siebreste, oder /clowder hub (Plattformhüter)."
	]
	quest.4200000000010014.title: "Erdplattform"
	quest.4200000000010015.quest_desc: [
		"Schneide sie jetzt, kompostiere sie später. Auf einer Plattform geht nichts verloren.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010015.title: "Eichenlaub"
	quest.4200000000010016.quest_desc: [
		"Eine stille Ecke.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010016.title: "Blumentopf"
	quest.4200000000010017.quest_desc: [
		"Das Fass von Ex Deorum: Kompost, und Wasser zu Ton auf die langsame Art.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010017.title: "Fass"
	quest.4200000000010018.quest_desc: [
		"Abfall zu Mehl.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010018.title: "Komposter"
	quest.4200000000010019.quest_desc: [
		"Zieh eine Reihe.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010019.title: "Holzhacke"
	quest.420000000001001A.quest_desc: [
		"Fällt Stämme schneller als bloße Hände. Das erste echte Werkzeug, das ein Skybound besitzt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001001A.title: "Holzaxt"
	quest.420000000001001B.quest_desc: [
		"Macht aus Erde und Kies freien Boden. Langsam, aber sie funktioniert.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001001B.title: "Holzschaufel"
	quest.420000000001001C.quest_desc: [
		"Hält kaum einen Zombie auf, stoppt aber einen. Besser, als mit der Faust zu schwingen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001001C.title: "Holzschwert"
	quest.420000000001001D.quest_desc: [
		"Hält Suppe, Eintopf und sonst wenig. Einfaches Geschirr für eine einfache Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001001D.title: "Schüssel"
	quest.420000000001001E.quest_desc: [
		"Beschrifte die Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001001E.title: "Rahmen"
	quest.420000000001001F.quest_desc: [
		"Mach es zum Zuhause.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001001F.title: "Gemälde"
	quest.4200000000010020.quest_desc: [
		"Hält den Wind und die Monster auf der richtigen Seite der Wand.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010020.title: "Eichentür"
	quest.4200000000010021.quest_desc: [
		"Markiert eine Kante, ohne die Sicht zu sperren. Praktisch, wo der Absturz echt ist.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010021.title: "Eichenholzzaun"
	quest.4200000000010022.quest_desc: [
		"Macht aus einer steilen Wand etwas, das du wirklich erklettern kannst.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010022.title: "Eichentreppe"
	quest.4200000000010023.quest_desc: [
		"Ein halber Block, doppelt so viele Böden. Nützlich auf engem Raum.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010023.title: "Eichenholzstufe"
	quest.4200000000010024.quest_desc: [
		"Zugangsluken.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010024.title: "Eichenholzfalltür"
	quest.4200000000010025.quest_desc: [
		"Gibt ein Signal, wenn etwas drauftritt. Türen öffnen sich von selbst.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010025.title: "Eichenholzdruckplatte"
	quest.4200000000010026.quest_desc: [
		"Knopf für Redstone-Impulse.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010026.title: "Eichenholzknopf"
	quest.4200000000010027.quest_desc: [
		"Zäune den Rand der Plattform ein.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010027.title: "Stockzauntor"
	quest.4200000000010028.quest_desc: [
		"Kocht langsam und hält den Rauch meilenweit sichtbar.",
		"So: Stämme, Stöcke und Kohle oder Holzkohle."
	]
	quest.4200000000010028.title: "Lagerfeuer"
	quest.4200000000010029.quest_desc: [
		"Hängt Licht, wo eine Fackel falsch aussähe. Wärmeres Leuchten, gleiche Arbeit.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010029.title: "Laterne"
	quest.420000000001002A.quest_desc: [
		"Brennt blassblau und hält das meiste davon ab, in der Nähe zu erscheinen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001002A.title: "Seelenlaterne"
	quest.420000000001002B.quest_desc: [
		"Klettert mit dir und verschwindet, wenn du ziehst. Hoch bauen macht keine Angst mehr.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001002B.title: "Gerüst"
	quest.420000000001002C.quest_desc: [
		"Kette für hängenden Schmuck.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001002C.title: "Kette"
	quest.420000000001002D.quest_desc: [
		"Sperr den Rand ein.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001002D.title: "Eisengitter"
	quest.420000000001002E.quest_desc: [
		"Glas für die Fenster der Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001002E.title: "Glasscheibe"
	quest.420000000001002F.quest_desc: [
		"Weich, brennbar und leicht zu färben. Jede Plattform braucht irgendwann ein Bett.",
		"So: schere Schafe, nachdem du ihnen Gras gegeben hast, oder vier Schnur."
	]
	quest.420000000001002F.title: "Weiße Wolle"
	quest.4200000000010030.quest_desc: [
		"Eine dünne Wollschicht für Böden, die keinen ganzen Block brauchen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010030.title: "Weißer Teppich"
	quest.4200000000010031.quest_desc: [
		"Bringt ein wenig Grün und Rosa auf eine Plattform aus Splitt.",
		"So: Moos plus Eiche, oder Knochenmehl auf Moos. Bienen nehmen die Blüte an."
	]
	quest.4200000000010031.title: "Blühende Azalee"
	quest.4200000000010032.quest_desc: [
		"Breitet sich langsam aus und mildert den Look roher Steinplattformen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010032.title: "Moosblock"
	quest.4200000000010033.quest_desc: [
		"Hängende Wurzeln unter der Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010033.title: "Hängende Wurzeln"
	quest.4200000000010034.quest_desc: [
		"Klammert sich an Wände und beleuchtet sie ohne eine einzige Fackel.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010034.title: "Leuchtflechte"
	quest.4200000000010035.quest_desc: [
		"Tropfstein für spitzen Schmuck.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010035.title: "Spitzer Tropfstein"
	quest.4200000000010036.quest_desc: [
		"Amethyst im Block. Siegel will später Splitter.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010036.title: "Amethystblock"
	quest.4200000000010037.quest_desc: [
		"Neun Barren fest zusammengepresst. Wird grün, wenn du ihn draußen lässt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010037.title: "Kupferblock"
	quest.4200000000010038.quest_desc: [
		"Neun Brocken Roheisen fest gestapelt, warten auf einen Ofen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010038.title: "Roheisenblock"
	quest.4200000000010039.quest_desc: [
		"Brennt viel länger als lose Kohle. Füttere den Ofen und geh.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000010039.title: "Kohleblock"
	quest.420000000001003A.quest_desc: [
		"Füttert Tiere und bremst einen Sturz. Bauern halten ihn für beides griffbereit.",
		"So: neun Weizen. Drei Weizen ergeben auch Brot."
	]
	quest.420000000001003A.title: "Heuballen"
	quest.420000000001003B.quest_desc: [
		"Neun Seetang zu Brennstoff gepresst. Schmilzt mehr, als es scheint.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001003B.title: "Block aus getrocknetem Seetang"
	quest.420000000001003C.quest_desc: [
		"Papier und Leder, warten darauf, etwas mit Rezept zu werden.",
		"So: drei Papier plus Leder. Papier ist Zuckerrohr."
	]
	quest.420000000001003C.title: "Buch"
	quest.420000000001003D.quest_desc: [
		"Papier für Bücher und Karten.",
		"So: drei Zuckerrohr in einer Reihe. Rohr kommt vom Sieben von Erde mit einem Feuersteinnetz oder besser."
	]
	quest.420000000001003D.title: "Papier"
	quest.420000000001003E.quest_desc: [
		"Farbstoff und Bücher brauchen Tinte.",
		"So: Holzkohle plus eine Glasflasche. Tintenfische erscheinen hier nie."
	]
	quest.420000000001003E.title: "Tintenbeutel"
	quest.420000000001003F.quest_desc: [
		"Federn für Pfeile und Bücher.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000001003F.title: "Feder"
	quest.4200000000010040.quest_desc: [
		"Leder für Bücher und Sets.",
		"So: schmelze verrottetes Fleisch oder gare es am Lagerfeuer. Siebe Erde mit einem Feuersteinnetz. /clowder hub Die Plattformhüter verkaufen zwei für 18 Faden."
	]
	quest.4200000000010040.title: "Leder"
	quest.4200000000010041.quest_desc: [
		"Werkbank, Setzling, Herd, Wasser, Kodex. Die Plattform hält.",
		"Spann den Strang: die Plattformhüter antworten, und die Marke ist dein zum Einsetzen.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.4200000000010041.quest_subtitle: "Erwachen"
	quest.4200000000010041.title: "Erdenknoten"
	quest.4200000000010042.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.4200000000010042.title: "Setze Erde ein"
	quest.4200000000010043.quest_desc: [
		"Ein Zombie auf einer Plattform ohne Höhlen. Die Leere lässt grüßen.",
		"Leuchte die Ränder aus.",
		"So: töte nachts einen Zombie auf der Plattform. Leuchte die Ränder aus."
	]
	quest.4200000000010043.title: "Etwas kam hoch"
	quest.4200000000020044.quest_desc: [
		"Faden, der sich erinnert, woher er kam.",
		"Entwirre Faden zu Schnur; vier Schnüre spinnen zwei Garn.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: vier Schnüre → zwei Garn. Spannungsfass: Schnur + Perle. Vier Webflusen."
	]
	quest.4200000000020044.title: "Leerengarn ziehen"
	quest.4200000000020045.quest_desc: [
		"Bruchstein und Stöcke. Brich gefallenen Grus zu Kies, Sand und Staub.",
		"So: Bruchstein + Stöcke. Brich Grus zu Kies, Sand und Staub."
	]
	quest.4200000000020045.title: "Spindelhammer"
	quest.4200000000020046.quest_desc: [
		"Schnur um Garn. Sie fängt, was der Webstuhl fallen ließ — und kämmt Webflusen aus Erde.",
		"So: Schnur um Garn. Der Stand der Splittsänger verkauft eins."
	]
	quest.4200000000020046.title: "Das Netz einfädeln"
	quest.4200000000020047.quest_desc: [
		"Gieß Wasser hinein; der Eimer kommt sofort zurück. Gib Erde dazu. Warte auf Ton.",
		"Schnur und eine Perle im selben Fass machen Garn.",
		"So: Bretter, Schnur und Leerengarn. Gieß Wasser (Eimer kommt zurück), gib Erde dazu → Ton."
	]
	quest.4200000000020047.title: "Spannungsfass"
	quest.4200000000020048.quest_desc: [
		"Sechzehn Ton aus dem Fass. Lade acht Erde auf einmal.",
		"So: Spannungsfass — Wasser + Erde. Der Echobrecher hämmert Sand zu Ton."
	]
	quest.4200000000020048.title: "Tontasche"
	quest.4200000000020049.quest_desc: [
		"Ton und Knochenmehl. Forme den ungebrannten Eimer.",
		"So: Tonklumpen + Knochenmehl, formlos. Ton kommt aus dem Spannungsfass."
	]
	quest.4200000000020049.title: "Porzellan-Ton"
	quest.420000000002004A.quest_desc: [
		"Schmilz es. Porzellan trägt Lava, wo Eisen noch ein Gerücht ist.",
		"So: forme Porzellan-Ton zu einem ungebrannten Eimer, dann schmilz ihn."
	]
	quest.420000000002004A.title: "Porzellanwerkzeug"
	quest.420000000002004B.quest_desc: [
		"Die Splittsänger benannten jeden Splitter nach seinem Echo.",
		"Siebe, bis du das Eisen hörst.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.420000000002004B.title: "Gefallenen Grus sieben"
	quest.420000000002004C.quest_desc: [
		"Ein Satz Schläge in Reserve.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.420000000002004C.title: "Wooden Hammer"
	quest.420000000002004D.quest_desc: [
		"Stoff aus Grus. Vierundsechzig Steine, die vor einer Stunde noch Staub waren.",
		"So: Lava neben Wasser (oder schmelzendes Eis). Hämmere Stein. Der Stand der Splittsänger bei /clowder hub verkauft ein Bündel."
	]
	quest.420000000002004D.title: "Kiesel"
	quest.420000000002004E.quest_desc: [
		"Webstaub wartet im Kies. Feuerstein auch.",
		"So: hämmere Bruchstein (Spindelhammer oder Echobrecher)."
	]
	quest.420000000002004E.title: "Kiesweg"
	quest.420000000002004F.quest_desc: [
		"Feiner Grus. Glas später, und der beste Fang des Eisennetzes.",
		"So: hämmere Kies."
	]
	quest.420000000002004F.title: "Sandlager"
	quest.4200000000020050.quest_desc: [
		"Asche der gefallenen Welt. Redstone und Schwarzpulver verstecken sich darin.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.4200000000020050.title: "Staubhaufen"
	quest.4200000000020051.quest_desc: [
		"Garn um Schleim. Plattformkompost macht den Schleim.",
		"Der Knoten ist das weiche Tor des Webstuhls; behalte zwei.",
		"So: Leerengarn-Ring um einen Schleimball."
	]
	quest.4200000000020051.title: "Bindungsknoten knüpfen"
	quest.4200000000020052.quest_desc: [
		"Bretter um einen Knoten. Spann ein Netz, lade Grus, lass es arbeiten.",
		"Trichter füttern ihn. Das ist die erste Maschine der Plattform.",
		"So: Bretter um einen Bindungsknoten. Spann ein Netz, füttere Grus mit einem Trichter, setz ihn auf einen Trichter."
	]
	quest.4200000000020052.title: "Webrahmen errichten"
	quest.4200000000020053.quest_desc: [
		"Eisen ist tief und geduldig. Acht Brocken aus dem Netz.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.4200000000020053.title: "Iron Ore Chunk"
	quest.4200000000020054.quest_desc: [
		"Aus Kies gesiebt, Stück für Stück. Das Netz findet Kupfer, bevor deine Augen es tun.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.4200000000020054.title: "Copper Ore Chunk"
	quest.4200000000020055.quest_desc: [
		"Gold macht sich kaum die Mühe zu antworten. Vier reichen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.4200000000020055.title: "Gold Ore Chunk"
	quest.4200000000020056.quest_desc: [
		"Füttere die Linie.",
		"So: siebe Kies, oder schmilz Kohleerz."
	]
	quest.4200000000020056.title: "Kohle"
	quest.4200000000020057.quest_desc: [
		"Von Brocken zu Roh. Schmilz weiter.",
		"So: siebe Kies nach Eisenerzbrocken; vier ergeben einen Eisenerzblock, und beim Abbauen fällt Roheisen."
	]
	quest.4200000000020057.title: "Roheisen"
	quest.4200000000020058.quest_desc: [
		"Bergung zahlt aus. Sechzehn Barren, die die Leere dir nicht gönnen wollte.",
		"So: schmelze Roheisen / Eisengrus (Ofen oder Glutofen). Siebe Kies nach Brocken."
	]
	quest.4200000000020058.title: "Eisenbarren"
	quest.4200000000020059.quest_desc: [
		"Draht und Birnen, und später Stammesresonatoren.",
		"So: schmelze Rohkupfer / Kupfergrus. Siebe Kies."
	]
	quest.4200000000020059.title: "Kupferbarren"
	quest.420000000002005A.quest_desc: [
		"Vergoldete Werkzeuge, und Goldplatten für die Musterweber.",
		"So: schmelze Rohgold / Goldgrus. Seltenerer Siebfang."
	]
	quest.420000000002005A.title: "Goldbarren"
	quest.420000000002005B.quest_desc: [
		"Schärferer Fang. Feuersteinnetze schütteln Ausgefransten Faden aus dem Grus.",
		"So: Feuerstein um ein Fadennetz (Schnur)."
	]
	quest.420000000002005B.title: "Feuersteinnetz"
	quest.420000000002005C.quest_desc: [
		"Metallfaden für schwereren Staub. Eisennetze sind dort, wo Strangfilament fällt.",
		"So: Eisen um ein Fadennetz (Feuerstein). Hier beginnt das Strangfilament."
	]
	quest.420000000002005C.title: "Eisennetz"
	quest.420000000002005D.quest_desc: [
		"Schmilzt und tropft. Bruchstein zu Lava, mit der Zeit.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.420000000002005D.title: "Schmelztiegel"
	quest.420000000002005E.quest_desc: [
		"Das Fass von Ex Deorum: Kompost, und Wasser zu Ton auf die langsame Art.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.420000000002005E.title: "Fass (Stein)"
	quest.420000000002005F.quest_desc: [
		"Härtere Schläge, längeres Leben.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.420000000002005F.title: "Stone Hammer"
	quest.4200000000020060.quest_desc: [
		"Zerkleinert Erz zu Kies und Grus, der laute Trick hinter dem Sieb.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.4200000000020060.title: "Iron Hammer"
	quest.4200000000020061.quest_desc: [
		"Weiteres Netz, neun auf einmal.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.4200000000020061.title: "Komprimiertes Sieb"
	quest.4200000000020062.quest_desc: [
		"Man sieht hindurch. Sand zu Glas.",
		"So: schmelze Sand. Hämmere Bruchstein zu Kies, Kies zu Sand, dann in den Ofen."
	]
	quest.4200000000020062.title: "Glas"
	quest.4200000000020063.quest_desc: [
		"Trag den Regen jetzt in Eisen.",
		"So: drei Eisenbarren, oder /clowder hub Plattformhüter (8 Faden). Füll ihn aus geschmolzenem Eis."
	]
	quest.4200000000020063.title: "Eimer"
	quest.4200000000020064.quest_desc: [
		"Hitze aus der Leere, in der Hand.",
		"So: Ex Deorum-Lavatiegel, oder ein Nether-Lavabecken nach Klauen-Obsidian."
	]
	quest.4200000000020064.title: "Lavaeimer"
	quest.4200000000020065.quest_desc: [
		"Portalgedanken. Wasser auf eine Lavaquelle.",
		"So: Wasser auf eine Lavaquelle (oder Lava auf Wasser). Behalte die Lavaquelle."
	]
	quest.4200000000020065.title: "Obsidian"
	quest.4200000000020066.quest_desc: [
		"Seltenes Grusglück. Zwei sind ein Anfang.",
		"So: siebe Kies mit einem Eisennetz oder besser, oder Diamanterz im Echobrecher."
	]
	quest.4200000000020066.title: "Diamant"
	quest.4200000000020067.quest_desc: [
		"Treibstoff fürs Netz-Upgrade.",
		"So: Kies, oder Senke aus Faden + Kies."
	]
	quest.4200000000020067.title: "Feuerstein"
	quest.4200000000020068.quest_desc: [
		"Aus Grus und Staub gemacht, nicht von einem Creeper geplündert. Geh vorsichtig damit um.",
		"So: siebe Staub oder Seelensand, oder Creeper auf der Plattform bei Nacht. Halt die Ränder beleuchtet, sobald du welches hast."
	]
	quest.4200000000020068.title: "Schießpulver"
	quest.4200000000020069.quest_desc: [
		"Funke wird das wollen. Halt es trocken.",
		"So: siebe Kies, oder Redstone-Erz im Echobrecher nach der Bergung."
	]
	quest.4200000000020069.title: "Redstone"
	quest.420000000002006A.quest_desc: [
		"Speist den Zaubertisch. Blauer Staub, der die Ausrüstung besser zuhören lässt.",
		"So: siebe Kies, oder Lapislazulierz im Echobrecher."
	]
	quest.420000000002006A.title: "Lapislazuli"
	quest.420000000002006B.quest_desc: [
		"Eine gewöhnliche Steinmischung, vor allem zum Bauen und später zum Mischen von Rezepten nützlich.",
		"So: siebe Erd-/Kieskiesel, oder Bruchstein plus Diorit in JEI."
	]
	quest.420000000002006B.title: "Andesit"
	quest.420000000002006C.quest_desc: [
		"Gesprenkelter Stein, eher Zier als Tragwerk. Die Splittsänger nannten ihn den lauten.",
		"So: siebe Kiesel, oder Bruchstein plus Netherquarz."
	]
	quest.420000000002006C.title: "Diorit"
	quest.420000000002006D.quest_desc: [
		"Dicht und rosa gesprenkelt, gut für einen Boden, der auffallen will.",
		"So: siebe Kiesel, oder Diorit plus Netherquarz."
	]
	quest.420000000002006D.title: "Granit"
	quest.420000000002006E.quest_desc: [
		"Poröses Gestein vom anderen Ort. Brennt ewig, sobald es Feuer fängt.",
		"So: der Nether ist hier Leere, kein Gelände. Gieß Lava in ein Ex Deorum-Fass mit Hexenwasser (ein Wasserfass auf Myzel; Myzelsporen siebst du aus Erde)."
	]
	quest.420000000002006E.title: "Netherrack"
	quest.420000000002006F.quest_desc: [
		"Bremst jeden Schritt darüber und füttert Seelenfeuer mit kälterem Blau.",
		"So: Sand in ein Ex Deorum-Fass mit Hexenwasser. Die Warzenräume der Festung halten etwas. Drei Schädel auf Seelensand machen einen Wither."
	]
	quest.420000000002006F.title: "Seelensand"
	quest.4200000000020070.quest_desc: [
		"Gemahlen aus Nether-Glowstone, nützlich zum Brauen und für weichere Lichtquellen.",
		"So: siebe Seelensand, oder Hexen auf der Plattform."
	]
	quest.4200000000020070.title: "Glowstone-Staub"
	quest.4200000000020071.quest_desc: [
		"Streift Blätter vom Baum, ohne die Axt gegen den Stamm zu schwingen.",
		"So: vier Stöcke. Der Stand der Splittsänger verkauft einen."
	]
	quest.4200000000020071.title: "Krummstab"
	quest.4200000000020072.quest_desc: [
		"Aus dem Sieb, in wachsenden Haufen. Nie ganz genug für jedes Netz.",
		"So: entwirre Ausgefransten Faden (1 → 3). Spinnen. Webflusen an einer Echobindung. Umgekehrte Garn-Senke."
	]
	quest.4200000000020072.title: "Schnur"
	quest.4200000000020073.quest_desc: [
		"Knotenbinder — oder Rezept für Plattformkompost.",
		"So: zwei Erde + Weizensamen + Knochenmehl (Plattformkompost), oder /clowder hub Plattformhüter."
	]
	quest.4200000000020073.title: "Schleimball"
	quest.4200000000020074.quest_desc: [
		"Zu Knochenmehl gemahlen oder ganz behalten, um den nächsten Wolf des Rudels zu züchten.",
		"So: Skelette bei Nacht, oder /clowder hub Plattformhüter (16 Faden für 8)."
	]
	quest.4200000000020074.title: "Knochen"
	quest.4200000000020075.quest_desc: [
		"Bitter und leicht giftig. Man braut damit, niemand isst es pur.",
		"So: Spinnen auf der Plattform bei Nacht."
	]
	quest.4200000000020075.title: "Spinnenauge"
	quest.4200000000020076.quest_desc: [
		"Garn, Porzellan, ein laufender Webrahmen, Eisen in der Kiste.",
		"Spanne den Strang: die Splittsänger antworten.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.4200000000020076.quest_subtitle: "Bergung"
	quest.4200000000020076.title: "Stein-Knoten"
	quest.4200000000020077.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.4200000000020077.title: "Stein einsetzen"
	quest.4200000000020078.quest_desc: [
		"Ein Creeper, erledigt. Schwarzpulver ist mehr wert als der Schreck.",
		"So: töte drei Creeper. Schwarzpulver ist die Belohnung."
	]
	quest.4200000000020078.title: "Bumm, später"
	quest.4200000000030079.quest_desc: [
		"Zieh Reihen in die Plattform.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: zwei Eisenbarren über einem Stock."
	]
	quest.4200000000030079.title: "Eisenhacke"
	quest.420000000003007A.quest_desc: [
		"Brot ist Infrastruktur. Zweiunddreißig Weizen sind ein Feld, kein Beet.",
		"So: Weizensamen auf Ackerboden, dann Knochenmehl. Samen aus zerbrochenem Gras oder der Startkiste."
	]
	quest.420000000003007A.title: "Weizenfeld"
	quest.420000000003007B.quest_desc: [
		"Pflanz, was du isst.",
		"So: brich Gras, oder siebe Erde mit einem Feuersteinnetz. Pflanz auf Ackerboden; Knochenmehl beschleunigt das erste Feld."
	]
	quest.420000000003007B.title: "Samentasche"
	quest.420000000003007C.quest_desc: [
		"Tempo ist Güte. Kompost und Knochen.",
		"So: Knochen im Raster, oder Senke aus Faden + verrottetem Fleisch, oder /clowder hub Plattformhüter."
	]
	quest.420000000003007C.title: "Knochenmehlmotor"
	quest.420000000003007D.quest_desc: [
		"Bereite die Ernte vor.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000003007D.title: "Bauernmesser"
	quest.420000000003007E.quest_desc: [
		"Hier fängt eine Küche an.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000003007E.title: "Schneidebrett"
	quest.420000000003007F.quest_desc: [
		"Warme Mahlzeiten stillen mehr als nur Hunger.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000003007F.title: "Kochtopf"
	quest.4200000000030080.quest_desc: [
		"Wächst in ordentlichen Köpfen, besser zu etwas gekocht als roh gegessen.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000030080.title: "Weißkohl"
	quest.4200000000030081.quest_desc: [
		"Klettert am eigenen Spalier hoch und reift rot. Die Sauce fängt hier an.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000030081.title: "Tomate"
	quest.4200000000030082.quest_desc: [
		"Freudentränen.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000030082.title: "Zwiebel"
	quest.4200000000030083.quest_desc: [
		"Essenzanbau beginnt. Sechzehn aus der ersten Reihe.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"Das Rückgrat der Samen. Siebe sie oder zieh sie.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Zieh Samen aus Essenz.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030085.title: "Infusionsaltar"
	quest.4200000000030086.quest_desc: [
		"Vier um den Altar.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030086.title: "Infusionssockel"
	quest.4200000000030087.quest_desc: [
		"Zieh mehr Plattform.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030087.title: "Erdsamen"
	quest.4200000000030088.quest_desc: [
		"Zieh ein Blätterdach ohne die Axt.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030088.title: "Holzsamen"
	quest.4200000000030089.quest_desc: [
		"Gewachsen, nicht abgebaut. Ernte Essenz, statt eine Spitzhacke zu schwingen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030089.title: "Steinsamen"
	quest.420000000003008A.quest_desc: [
		"Metall aus einer Feldfrucht. Der zweite Motor der Bergung.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000003008A.title: "Eisensamen"
	quest.420000000003008B.quest_desc: [
		"Eine Feldfrucht, die Kupferessenz liefert statt Kupfererz.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000003008B.title: "Kupfersamen"
	quest.420000000003008C.quest_desc: [
		"Eine vergoldete Feldfrucht, die Goldessenz direkt auf der Plattform wachsen lässt.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000003008C.title: "Goldsamen"
	quest.420000000003008D.quest_desc: [
		"Macht aus einem Beet eine Brennstoffquelle, ganz ohne Abbau.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000003008D.title: "Kohlesamen"
	quest.420000000003008E.quest_desc: [
		"Abgefüllter Regen aus einer Feldfrucht.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000003008E.title: "Wassersamen"
	quest.420000000003008F.quest_desc: [
		"Kompaktes Wachstum für eine kleine Plattform.",
		"So: Botany Pot aus Terrakotta in JEI. Erde + ein Samen in den Topf; Knochenmehl hilft weiter."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"Der Topf, der sich selbst erntet.",
		"So: Botany Pot mit Trichter in JEI. Steht auf Truhe/Trichter und erntet sich selbst."
	]
	quest.4200000000030090.title: "Trichtertopf"
	quest.4200000000030091.quest_desc: [
		"Eine Stufe höher. Die Samen werden gieriger und besser.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"Eine tiefere Stufe der Ernteessenz, stärker als die Samen, mit denen du angefangen hast.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Neun Knochenmehl zu einem Block. Lager für den Motor.",
		"So: neun Knochenmehl. Knochen von Skeletten oder Plattformhütern."
	]
	quest.4200000000030093.title: "Knochenblock"
	quest.4200000000030094.quest_desc: [
		"Überschuss an Spross, gestapelt.",
		"So: neun Weizen. Drei Weizen ergeben auch Brot."
	]
	quest.4200000000030094.title: "Heusilo"
	quest.4200000000030095.quest_desc: [
		"Besseres Ackerland. Die Wurzelbinder würden zustimmen.",
		"So: platziere Organischen Kompost und warte; er reift langsam zu Reicher Erde."
	]
	quest.4200000000030095.title: "Reichhaltige Erde"
	quest.4200000000030096.quest_desc: [
		"Füttere die Erde, die dich füttert.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000030096.title: "Organischer Kompost"
	quest.4200000000030097.quest_desc: [
		"Pflanz eine Reihe, füttere ein Pferd oder iss sie einfach roh.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000030097.title: "Karotte"
	quest.4200000000030098.quest_desc: [
		"Grundkultur Kartoffel.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000030098.title: "Kartoffel"
	quest.4200000000030099.quest_desc: [
		"Wächst schnell und färbt rot. Suppe, Eintopf oder frisch aus dem Boden.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000030099.title: "Rote Bete"
	quest.420000000003009A.quest_desc: [
		"Melone für Essen und Tausch.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000003009A.title: "Melone"
	quest.420000000003009B.quest_desc: [
		"Kürbis für Essen und Schmuck.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000003009B.title: "Kürbis"
	quest.420000000003009C.quest_desc: [
		"Papier und Zucker.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000003009C.title: "Zuckerrohr"
	quest.420000000003009D.quest_desc: [
		"Wächst ohne Wasser und verletzt alles, was sich anlehnt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000003009D.title: "Kaktus"
	quest.420000000003009E.quest_desc: [
		"Schießt schnell hoch und brennt heiß. Praktischer Brennstoff für eine Plattform mit wenig Bäumen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000003009E.title: "Bambus"
	quest.420000000003009F.quest_desc: [
		"Beeren, während du baust.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000003009F.title: "Süßbeeren"
	quest.42000000000300A0.quest_desc: [
		"Wächst an Dschungelstämmen, gemahlen zu dem Braun, das alles Süße würzt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000300A0.title: "Kakao"
	quest.42000000000300A1.quest_desc: [
		"Fällt von Eichenlaub, wann es soweit ist. Irgendwann Essen umsonst.",
		"So: Eichenlaub lässt ein paar fallen; ein Pam's-Apfelbaum (Setzling aus Erde mit Eisennetz) trägt viele."
	]
	quest.42000000000300A1.title: "Apfel"
	quest.42000000000300A2.quest_desc: [
		"Eine Schüssel, keine Werkbank. Das Abendessen des faulen Bauern.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000300A2.title: "Pilzsuppe"
	quest.42000000000300A3.quest_desc: [
		"Ein Vorgeschmack vom Stock, bevor die tiefere Arbeit mit den Bienen beginnt.",
		"So: Glasflasche auf einen vollen Bienenstock. Lagerfeuer darunter."
	]
	quest.42000000000300A3.title: "Honigflasche"
	quest.42000000000300A4.quest_desc: [
		"Wachsen an Höhlenranken und leuchten den Tunnel aus, während du sie isst.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000300A4.title: "Leuchtbeeren"
	quest.42000000000300A5.quest_desc: [
		"Die Basis jedes Tranks, der das Abfüllen lohnt. Wächst nur auf Seelensand.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000300A5.title: "Netherwarze"
	quest.42000000000300A6.quest_desc: [
		"Ein Feld, eine Küche, Essenz steigt.",
		"Spanne den Strang: die Wurzelbinder antworten.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.42000000000300A6.quest_subtitle: "Wurzel"
	quest.42000000000300A6.title: "Sprossknoten"
	quest.42000000000300A7.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.42000000000300A7.title: "Setze Spross ein"
	quest.42000000000300A8.quest_desc: [
		"Jeder Wurzelbinder zieht irgendwann eine.",
		"Iss sie nicht. Wirf sie auch nicht weg.",
		"So: eine seltene Kartoffelernte. Optionales Spross-Geheimnis."
	]
	quest.42000000000300A8.title: "Falsche Kartoffel"
	quest.42000000000400A9.quest_desc: [
		"Schneide die Leere nach deinen Regeln. Acht Bögen Pläne.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: vier Papier und ein blauer Farbstoff, formlos. Ergibt vier Bögen."
	]
	quest.42000000000400A9.title: "Blaues Papier"
	quest.42000000000400AA.quest_desc: [
		"Pläne in einer Kiste.",
		"Vier Blaupausenpapier, formlos — eine Plattform zu beanspruchen löscht das Beitrittsgeschenk von Silent Gear. Rechtsklick, um die Startpläne auszupacken.",
		"So: vier Blaupausenpapier, formlos. Rechtsklick, um die Startpläne auszupacken. Eine Plattform zu beanspruchen löscht das Beitrittsgeschenk von Silent Gear."
	]
	quest.42000000000400AA.title: "Blaupausenbündel"
	quest.42000000000400AB.quest_desc: [
		"Die Vorlage, mit der ein modulares Werkzeug anfängt, bevor du die Teile ansetzt.",
		"So: packe das Blaupausenpaket aus, oder JEI. Klaue benennt die Werkzeuglinie."
	]
	quest.42000000000400AB.title: "Stabblaupause"
	quest.42000000000400AC.quest_desc: [
		"Forme eine Spitzhacke, die länger hält als ihr Metall.",
		"So: packe das Blaupausenpaket aus, oder JEI. Klaue benennt die Werkzeuglinie."
	]
	quest.42000000000400AC.title: "Spitzhackenblaupause"
	quest.42000000000400AD.quest_desc: [
		"Forme eine Axt.",
		"So: packe das Blaupausenpaket aus, oder JEI. Klaue benennt die Werkzeuglinie."
	]
	quest.42000000000400AD.title: "Axtblaupause"
	quest.42000000000400AE.quest_desc: [
		"Forme eine Schaufel.",
		"So: packe das Blaupausenpaket aus, oder JEI. Klaue benennt die Werkzeuglinie."
	]
	quest.42000000000400AE.title: "Schaufelblaupause"
	quest.42000000000400AF.quest_desc: [
		"Forme eine Klinge.",
		"So: packe das Blaupausenpaket aus, oder JEI. Klaue benennt die Werkzeuglinie."
	]
	quest.42000000000400AF.title: "Schwertblaupause"
	quest.42000000000400B0.quest_desc: [
		"Platz zum Wachsen.",
		"So: JEI nach dem Blaupausenpapier. Klaue benennt die Aufwertungslinie."
	]
	quest.42000000000400B0.title: "Upgrade-Basis"
	quest.42000000000400B1.quest_desc: [
		"Zweiunddreißig Barren Material für Teile.",
		"So: schmelze Roheisen / Eisengrus (Ofen oder Glutofen). Siebe Kies nach Brocken."
	]
	quest.42000000000400B1.title: "Eisenmasse"
	quest.42000000000400B2.quest_desc: [
		"Schärft die Schneide weiter, als Eisen allein es kann.",
		"So: siebe Kies mit einem Eisennetz oder besser, oder Diamanterz im Echobrecher."
	]
	quest.42000000000400B2.title: "Diamantspitze"
	quest.42000000000400B3.quest_desc: [
		"Blätter und Wolle, und später Waben.",
		"So: zwei Eisenbarren diagonal. Schere Schafe und Bienennester."
	]
	quest.42000000000400B3.title: "Schere"
	quest.42000000000400B4.quest_desc: [
		"Plattformen haben Kanten. Monster auch.",
		"So: sechs Bretter um Eisen. Blocken in der Nebenhand."
	]
	quest.42000000000400B4.title: "Schild"
	quest.42000000000400B5.quest_desc: [
		"Überstehe die Nacht mit Absicht.",
		"So: acht Eisenbarren. Schmelze Siebsplitt."
	]
	quest.42000000000400B5.title: "Eisenbrustplatte"
	quest.42000000000400B6.quest_desc: [
		"Achte auf den Fall.",
		"So: fünf Eisenbarren."
	]
	quest.42000000000400B6.title: "Eisenhelm"
	quest.42000000000400B7.quest_desc: [
		"Deckt zuerst die Beine. Der meiste Schaden kommt sowieso von unten.",
		"So: sieben Eisenbarren."
	]
	quest.42000000000400B7.title: "Eisenbeinschutz"
	quest.42000000000400B8.quest_desc: [
		"Gibt dir Halt auf Simsen, wo ein Ausrutscher die Leere bedeutet.",
		"So: vier Eisenbarren."
	]
	quest.42000000000400B8.title: "Eisenstiefel"
	quest.42000000000400B9.quest_desc: [
		"Halt die Monster der Leere auf Abstand.",
		"So: drei Schnüre und drei Stöcke."
	]
	quest.42000000000400B9.title: "Bogen"
	quest.42000000000400BA.quest_desc: [
		"Vierundsechzig Gründe, Abstand zu halten.",
		"So: Feuerstein, Stock, Feder. Skelette lassen Extra fallen."
	]
	quest.42000000000400BA.title: "Pfeilbündel"
	quest.42000000000400BB.quest_desc: [
		"Leuchte den Weg hindurch.",
		"So: Eisenbarren plus Feuerstein."
	]
	quest.42000000000400BB.title: "Feuerzeug"
	quest.42000000000400BC.quest_desc: [
		"Zehn Blöcke. Eine Tür, die die Randgänger erkennen würden.",
		"So: Wasser auf eine Lavaquelle (oder Lava auf Wasser). Behalte die Lavaquelle."
	]
	quest.42000000000400BC.title: "Obsidianrahmen"
	quest.42000000000400BD.quest_desc: [
		"Tritt vorbereiten. Irgendwo sonst existiert.",
		"So: Enderperle (Stand der Randgänger / Endermen) plus Lohenstaub aus einer Netherfestung nach Obsidian aus Klaue. Ein Vorrat von acht Augen ist optional; Enderkristalle nutzen dasselbe Rezept."
	]
	quest.42000000000400BD.title: "Ender-Auge"
	quest.42000000000400BE.quest_desc: [
		"Sanfte Kraft für harte Werkzeuge.",
		"So: zwei Diamanten, vier Obsidian, Buch. Diamanten aus Kies am Eisennetz."
	]
	quest.42000000000400BE.title: "Zaubertisch"
	quest.42000000000400BF.quest_desc: [
		"Reparier und benenne, was du trägst.",
		"So: drei Eisenblöcke über vier Barren."
	]
	quest.42000000000400BF.title: "Amboss"
	quest.42000000000400C0.quest_desc: [
		"Nenn es deins.",
		"So: Angeln / seltene Truhen, oder der Stand der Siegelschneider bei /clowder hub (24 Faden). Optional."
	]
	quest.42000000000400C0.title: "Namensschild"
	quest.42000000000400C1.quest_desc: [
		"Die Startvorlage für eine modulare Hacke, Teil für Teil gebaut.",
		"So: pack das Blaupausenpaket aus, oder JEI."
	]
	quest.42000000000400C1.title: "Hackenblaupause"
	quest.42000000000400C2.quest_desc: [
		"Räumt eine breite Bahn der Ernte in einem Schwung, statt einer Pflanze.",
		"So: pack das Blaupausenpaket aus, oder JEI."
	]
	quest.42000000000400C2.title: "Sichelblaupause"
	quest.42000000000400C3.quest_desc: [
		"Ein Werkzeug, das abbaut, hackt und gräbt. Kein Wechseln mehr in der Hand.",
		"So: pack das Blaupausenpaket aus, oder JEI."
	]
	quest.42000000000400C3.title: "Paxel-Blaupause"
	quest.42000000000400C4.quest_desc: [
		"Bricht Stein drei mal drei in einem Schlag.",
		"So: pack das Blaupausenpaket aus, oder JEI."
	]
	quest.42000000000400C4.title: "Hammerblaupause"
	quest.42000000000400C5.quest_desc: [
		"Räumt breite Löcher in Erde und Sand schneller als jede Schaufel.",
		"So: pack das Blaupausenpaket aus, oder JEI."
	]
	quest.42000000000400C5.title: "Baggerblaupause"
	quest.42000000000400C6.quest_desc: [
		"Klein, schnell und genau. Gebaut für die Naharbeit, nicht für den Krieg.",
		"So: pack das Blaupausenpaket aus, oder JEI."
	]
	quest.42000000000400C6.title: "Messerblaupause"
	quest.42000000000400C7.quest_desc: [
		"Weiche Panzerung, leicht zu verzaubern, mehr wert durch Magie als durch Abwehr.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000400C7.title: "Goldrüstungsteile"
	quest.42000000000400C8.quest_desc: [
		"Meerklaue.",
		"Optional — die Leere bietet dir vielleicht nie einen.",
		"So: nur Ertrunkene. Optional."
	]
	quest.42000000000400C8.title: "Dreizack"
	quest.42000000000400C9.quest_desc: [
		"Lädt langsam, trifft hart und hält die Ladung, bis du sie brauchst.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000400C9.title: "Armbrust"
	quest.42000000000400CA.quest_desc: [
		"Such die Leere ab.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000400CA.title: "Fernrohr"
	quest.42000000000400CB.quest_desc: [
		"Pläne, Eisen auf dem Rücken, eine Tür hinaus.",
		"Spann den Strang: die Randgänger antworten. Der Zopf öffnet sich.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.42000000000400CB.quest_subtitle: "Rand"
	quest.42000000000400CB.title: "Klauenknoten"
	quest.42000000000400CC.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.42000000000400CC.title: "Setze Klaue ein"
	quest.42000000000400CD.quest_desc: [
		"Etwas Hohes hat zurückgesehen. Die Randgänger nannten sie Torwächter.",
		"So: töte einen Enderman. Enderperlen gibt es auch am Stand der Randgänger."
	]
	quest.42000000000400CD.title: "Rand des Randes"
	quest.42000000000500CE.quest_desc: [
		"Ein kurzes Signal vor dem Summen. Vierundsechzig Staub.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: siebe Kies, oder Redstone-Erz im Echobrecher nach der Bergung."
	]
	quest.42000000000500CE.title: "Redstone-Staub"
	quest.42000000000500CF.quest_desc: [
		"Parallele Wärme. Acht ist eine Reihe, kein Ofen.",
		"So: acht Bruchstein um eine leere Mitte."
	]
	quest.42000000000500CF.title: "Ofenreihe"
	quest.42000000000500D0.quest_desc: [
		"Beweg den Grus ohne Hände.",
		"So: fünf Eisen um eine Truhe. Setz ihn unter einen Webrahmen oder ein Spannungsfass (entnimmt nach UNTEN)."
	]
	quest.42000000000500D0.title: "Trichterlinie"
	quest.42000000000500D1.quest_desc: [
		"Miss den Schlag.",
		"So: Netherquarz, Redstonefackel, Stein. Quarz siebst du aus Seelensand; keine Reise in den Nether nötig."
	]
	quest.42000000000500D1.title: "Komparator"
	quest.42000000000500D2.quest_desc: [
		"Knochen, Schnur, Amethyst. Der erste Schlag.",
		"Es ergibt zwei — behalte eines für den Geisterkodex.",
		"So: ein Knochen, Schnur, Amethyst. /clowder hub Die Plattformhüter verkaufen Knochen. Tor Funke / Summen."
	]
	quest.42000000000500D2.title: "Summen: Knochenklang"
	quest.42000000000500D3.quest_desc: [
		"Eine Scherbe alten Stammeslieds. Braucht einen Klang.",
		"So: Knochenklang, Amethyst und Redstone, formlos. Ergibt zwei."
	]
	quest.42000000000500D3.title: "Summen: Geisterscherbe"
	quest.42000000000500D4.quest_desc: [
		"Kupfer um einen Klang: Metall, auf den Geist gestimmt.",
		"So: Kupfer um einen Knochenklang. Ergibt zwei."
	]
	quest.42000000000500D4.title: "Summen: Kupferresonator"
	quest.42000000000500D5.quest_desc: [
		"Schlag es. Halt einen Puls. Hör zu, bevor du irgendwas verdrahtest.",
		"Zwei Klänge, eine Scherbe, zwei Leder, vier Bretter — die Plattformhüter bei /clowder hub verkaufen Leder.",
		"So: zwei Knochenklänge, eine Geisterscherbe, zwei Leder und vier Bretter. Schlag mit leeren Händen im Takt (17–23 Ticks) für 24 Puls."
	]
	quest.42000000000500D5.title: "Summen: Trommelherz"
	quest.42000000000500D6.quest_desc: [
		"Trag Puls für Werkzeuge, Zauber und Reise — braucht Resonator + Scherbe.",
		"So: fertige sie, dann fülle sie an einem Trommelherz (Klick mit der Zelle). Werkzeuge, Zauber und Reise ziehen aus der Zelle."
	]
	quest.42000000000500D6.title: "Summen: Pulszelle"
	quest.42000000000500D7.quest_desc: [
		"Zieh umgebende Ley in Schläge unter freiem Himmel. Totemstimmen legen zu; ein Trommelherz ist nicht nötig.",
		"So: stell ihn unter den Himmel, nah an Wasser/Grün. Langsamer Puls. Funke-Leiter."
	]
	quest.42000000000500D7.title: "Summen: Leysammler"
	quest.42000000000500D8.quest_desc: [
		"Setze einen Echo-Katalysator ein (er verschleißt bei der Arbeit) und zwei verschiedene Elementartotems. Das Lager singt seine eigene Kraft; Redstone pausiert die Harmonie.",
		"So: setze einen Echo-Katalysator ein, zwei verschiedene Totems innerhalb von 8. Redstone pausiert ihn."
	]
	quest.42000000000500D8.title: "Summen: Pulsresonator"
	quest.42000000000500D9.quest_desc: [
		"Ein Puffer für Forge-Energie — die Brücke vom Puls zum Draht, falls du eine willst.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500D9.title: "Powah-Startzelle"
	quest.42000000000500DA.quest_desc: [
		"Verbrenn Treibstoff für Forge-Energie.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500DA.title: "Powah-Brenner"
	quest.42000000000500DB.quest_desc: [
		"Leite Energie weiter.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500DB.title: "Powah-Kabel"
	quest.42000000000500DC.quest_desc: [
		"Himmelskraft, auf einer Plattform, die nur Himmel ist.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500DC.title: "Starter-Solarpanel"
	quest.42000000000500DD.quest_desc: [
		"Brennt einen Wärmeunterschied zu Kraft. Füttere ihn heiß auf einer Seite, kalt auf der anderen.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500DD.title: "Thermogenerator"
	quest.42000000000500DE.quest_desc: [
		"Lädt Gegenstände in einem Ring aus Stäben.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500DE.title: "Energizing Orb"
	quest.42000000000500DF.quest_desc: [
		"Füttere den Orb.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500DF.title: "Energiestab"
	quest.42000000000500E0.quest_desc: [
		"Eine Tasche voll gespeicherter Kraft.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500E0.title: "Batterie"
	quest.42000000000500E1.quest_desc: [
		"Dreht Maschinen an Ort und Stelle, statt sie abzubauen und neu zu setzen.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000500E1.title: "Wrench"
	quest.42000000000500E2.quest_desc: [
		"Schmilzt Erz doppelt so schnell wie ein normaler Ofen, nur Erz.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500E2.title: "Schmelzofen"
	quest.42000000000500E3.quest_desc: [
		"Gart Fleisch doppelt so schnell wie ein Lagerfeuer, nur Essen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500E3.title: "Räucherofen"
	quest.42000000000500E4.quest_desc: [
		"Neun Kohle, fest gepresst. Ein Block hält länger als ein ganzer Stapel Brocken.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500E4.title: "Kohleblock (Funke)"
	quest.42000000000500E5.quest_desc: [
		"Schubst jeweils einen Gegenstand in das, was davor steht.",
		"So: Bruchstein um Redstone."
	]
	quest.42000000000500E5.title: "Spender"
	quest.42000000000500E6.quest_desc: [
		"Stoß mit Absicht.",
		"So: Bruchstein, Bogen und Redstone."
	]
	quest.42000000000500E6.title: "Werfer"
	quest.42000000000500E7.quest_desc: [
		"Schiebt einen Block bei einem Signal nach vorn und wartet dann auf das nächste.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500E7.title: "Kolben"
	quest.42000000000500E8.quest_desc: [
		"Schiebt einen Block hinaus und zieht ihn zurück, wenn das Signal ausfällt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500E8.title: "Klebriger Kolben"
	quest.42000000000500E9.quest_desc: [
		"Der Beobachter liest den Takt.",
		"So: Bruchstein, Redstone und Netherquarz."
	]
	quest.42000000000500E9.title: "Beobachter"
	quest.42000000000500EA.quest_desc: [
		"Der Verstärker taktet die Schaltung.",
		"So: Redstone-Fackel, Redstone, Stein. Das Kapitel der Rohre nutzt ihn für Uhren."
	]
	quest.42000000000500EA.title: "Verstärker"
	quest.42000000000500EB.quest_desc: [
		"Registriert einen Treffer mit einer Signalstärke danach, wie nah er an der Mitte ist.",
		"So: Redstone um Heu. Heu ist drei Weizen."
	]
	quest.42000000000500EB.title: "Zielblock"
	quest.42000000000500EC.quest_desc: [
		"Zieht einen Einschlag von deinem Dach weg und erdet die Ladung.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500EC.title: "Blitzableiter"
	quest.42000000000500ED.quest_desc: [
		"Zeit für Energie.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500ED.title: "Uhr"
	quest.42000000000500EE.quest_desc: [
		"Licht ohne Fackeln.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500EE.title: "Kupferbirne"
	quest.42000000000500EF.quest_desc: [
		"Leuchtet bei einem Signal auf und wird dunkel, sobald es aufhört.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500EF.title: "Redstone-Lampe"
	quest.42000000000500F0.quest_desc: [
		"Liest den Himmel und sendet ein Signal, das mit der Sonne steigt und fällt.",
		"So: Glas, Netherquarz, Holzstufen."
	]
	quest.42000000000500F0.title: "Tageslichtsensor"
	quest.42000000000500F1.quest_desc: [
		"Schaltet ein Signal von Hand an oder aus. Der älteste Schalter, den es gibt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F1.title: "Hebel"
	quest.42000000000500F2.quest_desc: [
		"Der Knopf gibt einen Redstone-Impuls.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F2.title: "Knopf"
	quest.42000000000500F3.quest_desc: [
		"Sendet ein Signal, wenn etwas Schwereres als Luft darauf steht.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F3.title: "Druckplatte"
	quest.42000000000500F4.quest_desc: [
		"Mit Schnur über einen Pfad gespannt, fängt sie alles, was sie quert.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F4.title: "Stolperdrahthaken"
	quest.42000000000500F5.quest_desc: [
		"Spielt eine Note je Blockart darunter. Die Trommelherzen hören ein Lied in einer Reihe davon.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F5.title: "Notenblock"
	quest.42000000000500F6.quest_desc: [
		"Plattenspieler für die Moral der Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F6.title: "Plattenspieler"
	quest.42000000000500F7.quest_desc: [
		"Rollt durch Schwerkraft oder einen Schubs. Keine Schienen, keine Fahrt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F7.title: "Lore"
	quest.42000000000500F8.quest_desc: [
		"Schienen über die Leerspanne.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F8.title: "Schiene"
	quest.42000000000500F9.quest_desc: [
		"Antriebsschiene für Loren.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500F9.title: "Antriebsschiene"
	quest.42000000000500FA.quest_desc: [
		"Liest eine vorbeifahrende Lore und gibt ein Signal, wenn sie darüberrollt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000500FA.title: "Sensorschiene"
	quest.42000000000500FB.quest_desc: [
		"Alternative Solarfertigung.",
		"So: drei Glas, drei Lapislazuli und drei Spiegel, je eine Reihe."
	]
	quest.42000000000500FB.title: "Solar-Flux-Zelle"
	quest.42000000000500FC.quest_desc: [
		"Einfache Gegenstandsrohre.",
		"So: Eisen + Redstone. Richte die Seiten mit dem Pipez-Schraubenschlüssel."
	]
	quest.42000000000500FC.title: "Pipez-Gegenstände"
	quest.42000000000500FD.quest_desc: [
		"Einfache Flüssigkeitsrohre.",
		"So: Eisen + Eimer + Redstone. Schleich-Benutzung des Schraubenschlüssels auf einer Seite zum Abziehen; Rechtsklick auf diese Seite für Filter."
	]
	quest.42000000000500FD.title: "Pipez-Flüssigkeit"
	quest.42000000000500FE.quest_desc: [
		"Schlichte Energierohre zwischen den Maschinen.",
		"So: Eisen + Redstone. Trägt FE zwischen Maschinen."
	]
	quest.42000000000500FE.title: "Pipez-Energie"
	quest.42000000000500FF.quest_desc: [
		"Legt fest, welche Rohrseiten aus einer Maschine abziehen, oder kappt eine Seite, ohne das Rohr zu brechen.",
		"So: zwei Feuersteine und zwei Stöcke. Schleich-Benutzung einer Rohrseite an einer Maschine, damit sie abzieht, noch einmal, um sie zu kappen; Rechtsklick auf eine abziehende Seite für Filter."
	]
	quest.42000000000500FF.title: "Pipez-Schraubenschlüssel"
	quest.4200000000050100.quest_desc: [
		"Markiert Gitterlinien — braucht eine Geisterscherbe.",
		"So: zwei Knochenmehl, Lapislazuli und eine Geisterscherbe, formlos. Ergibt vier."
	]
	quest.4200000000050100.title: "Ritualkreide"
	quest.4200000000050101.quest_desc: [
		"Eine Trommel geschlagen, ein Puls gehalten, ein Resonator eingesetzt.",
		"Spanne den Strang: die Trommelherzen antworten.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.4200000000050101.quest_subtitle: "Summen"
	quest.4200000000050101.title: "Funkenknoten"
	quest.4200000000050102.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.4200000000050102.title: "Funke einsetzen"
	quest.4200000000050103.quest_desc: [
		"Folge dem Stammesweben durch die Echo-Veredelung bis zu einem Resonanzkern. Der Harmonische Energetisierer verwandelt die Harmonie des Lagers in FE für die Maschinen dieses Kapitels. Die Umwandlung ohne Rang liegt bei 60 Puls pro Sekunde; gib ihm an Echo-Stationen einen höheren Rang für mehr. Er kann kein FE empfangen. Redstone pausiert Umwandlung und Ausgabe.",
		"So: fünf Kupferbarren, drei Redstone und ein Resonanzkern."
	]
	quest.4200000000050103.title: "Summen wird Strom"
	quest.4200000000050104.quest_desc: [
		"Eine Hexe, auf deiner Plattform, bei Nacht. Die Trommeln haben dich nicht gewarnt.",
		"So: töte nachts eine Hexe auf der Plattform."
	]
	quest.4200000000050104.title: "Flaschenärger"
	quest.4200000000060105.quest_desc: [
		"Hände, die arbeiten, während du schläfst. Zweiunddreißig.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Andesit + Eisennugget in einer Werkbank (oder einem Mischer)."
	]
	quest.4200000000060105.title: "Andesitlegierung"
	quest.4200000000060106.quest_desc: [
		"Das Rückgrat der Rotation.",
		"So: Andesitlegierung in einem Schneide-Rezept / einer Fertigung, gelistet in JEI."
	]
	quest.4200000000060106.title: "Welle"
	quest.4200000000060107.quest_desc: [
		"Ein Zahnrad. Dann dasselbe Zahnrad noch einmal.",
		"So: Welle + Bretter."
	]
	quest.4200000000060107.title: "Zahnrad"
	quest.4200000000060108.quest_desc: [
		"Mehr Zähne, langsamere Drehung.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060108.title: "Großes Zahnrad"
	quest.4200000000060109.quest_desc: [
		"Das Andesitgehäuse ist der Rahmen von Create.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060109.title: "Andesitgehäuse"
	quest.420000000006010A.quest_desc: [
		"Ein Fluss im Himmel, der sich dreht.",
		"So: acht Bretter um eine Welle. Daneben braucht es einen Wasserfluss."
	]
	quest.420000000006010A.title: "Wasserrad"
	quest.420000000006010B.quest_desc: [
		"Erzeugt Rotation von Hand, wenn sonst noch nichts dreht.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006010B.title: "Handkurbel"
	quest.420000000006010C.quest_desc: [
		"Mahle Splitt zu Staub, ohne Hammer.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006010C.title: "Mahlstein"
	quest.420000000006010D.quest_desc: [
		"Das Becken hält das Mischen von Create.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006010D.title: "Becken"
	quest.420000000006010E.quest_desc: [
		"Platten und Pfade.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006010E.title: "Mechanische Presse"
	quest.420000000006010F.quest_desc: [
		"Rezepte in Menge, schnell.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006010F.title: "Mechanischer Mixer"
	quest.4200000000060110.quest_desc: [
		"Eine flache Fläche, die einen Gegenstand stillhält, für das Band oder die Presse.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060110.title: "Depot"
	quest.4200000000060111.quest_desc: [
		"Bänder bewegen Gegenstände die Wellen entlang.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060111.title: "Bandverbinder"
	quest.4200000000060112.quest_desc: [
		"Lässt Gegenstände senkrecht zwischen Maschinen fallen, kein Band nötig.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060112.title: "Schacht"
	quest.4200000000060113.quest_desc: [
		"Waschen, Trocknen und Kies zu Sand.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060113.title: "Ummantelter Lüfter"
	quest.4200000000060114.quest_desc: [
		"Eine Hand an einer Welle.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060114.title: "Einsatzgerät"
	quest.4200000000060115.quest_desc: [
		"Schneidet Stämme zu Brettern oder Bäume zu Bauholz, wenn genug Rotation da ist.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060115.title: "Mechanische Säge"
	quest.4200000000060116.quest_desc: [
		"Bohre durch Splittblöcke.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060116.title: "Mechanischer Bohrer"
	quest.4200000000060117.quest_desc: [
		"Schneide Feldfrüchte in einem drehenden Bogen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060117.title: "Mechanische Erntemaschine"
	quest.4200000000060118.quest_desc: [
		"Lädt die Fracht eines stehenden Zugs oder leert sie, ohne dass du eine einzige Kiste hebst.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060118.title: "Portable Lagerschnittstelle"
	quest.4200000000060119.quest_desc: [
		"Stapelt den Stauraum von neun Kisten in einen großen Block.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060119.title: "Gegenstandstresor"
	quest.420000000006011A.quest_desc: [
		"Hält Flüssigkeit in Menge und verbindet sich mit den Nachbarn, um mehr zu halten.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006011A.title: "Flüssigkeitstank"
	quest.420000000006011B.quest_desc: [
		"Gieß Fluide in Becken.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006011B.title: "Ausguss"
	quest.420000000006011C.quest_desc: [
		"Pumpe Fluide aus einer Quelle.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006011C.title: "Schlauchrolle"
	quest.420000000006011D.quest_desc: [
		"Markiert die Fluidseite eines Baus, der feinere Vetter des Andesits.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006011D.title: "Kupferrahmen"
	quest.420000000006011E.quest_desc: [
		"Verkleidet die präzisen Maschinen, die Drehung allein nicht zufriedenstellt.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006011E.title: "Messingrahmen"
	quest.420000000006011F.quest_desc: [
		"Uhrwerkherz. Will einen Bindungsknoten in seiner Mitte.",
		"Der Webstuhl, der bittet, einbezogen zu werden.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006011F.title: "Präzisionsgetriebe"
	quest.4200000000060120.quest_desc: [
		"Steuere die Drehzahl.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060120.title: "Rotationsgeschwindigkeitsregler"
	quest.4200000000060121.quest_desc: [
		"Bieg um die Ecke.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060121.title: "Getriebe"
	quest.4200000000060122.quest_desc: [
		"Die Kupplung stoppt eine Wellenlinie.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060122.title: "Kupplung"
	quest.4200000000060123.quest_desc: [
		"Die Schaltung kehrt die Drehung um.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060123.title: "Gangschaltung"
	quest.4200000000060124.quest_desc: [
		"Programmiertes Drehen. Das Lied der Musterweber, aufgeschrieben.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060124.title: "Sequenzielle Gangschaltung"
	quest.4200000000060125.quest_desc: [
		"Mischt Zutaten in einem Becken, wenn es schnell genug dreht.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060125.title: "Rührstab"
	quest.4200000000060126.quest_desc: [
		"Dreht auf einer Welle und schiebt Luft oder ein Boot, je nachdem, wo du es anbringst.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060126.title: "Propeller"
	quest.4200000000060127.quest_desc: [
		"Fängt an einer Windmühle Wind und lässt sich leicht färben, wenn du ein Muster willst.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060127.title: "Weißes Segel"
	quest.4200000000060128.quest_desc: [
		"Macht aus einem Segelring Drehung, geradewegs vom Himmel gezogen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060128.title: "Windmühlenlager"
	quest.4200000000060129.quest_desc: [
		"Dreht ein ganzes Bauwerk um einen festen Punkt, Wände und alles.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060129.title: "Mechanisches Lager"
	quest.420000000006012A.quest_desc: [
		"Der Portalkran gleitet an einer Schiene.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006012A.title: "Portalkranwagen"
	quest.420000000006012B.quest_desc: [
		"Macht aus einem stillen Bau einen, der auf den Schienen fährt.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006012B.title: "Lorenmonteur"
	quest.420000000006012C.quest_desc: [
		"Kuppelt zwei Loren, damit sie als ein Zug fahren.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006012C.title: "Lorenkupplung"
	quest.420000000006012D.quest_desc: [
		"Legt den Weg, den eine Lore oder eine Konstruktion nimmt.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006012D.title: "Gleis"
	quest.420000000006012E.quest_desc: [
		"Zugtür für Waggons.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006012E.title: "Zugtür"
	quest.420000000006012F.quest_desc: [
		"Plane die Zugstrecken.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.420000000006012F.title: "Fahrplan"
	quest.4200000000060130.quest_desc: [
		"Zeigt eine Zahl von anderswo auf einem Block, den du wirklich siehst.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060130.title: "Anzeige-Link"
	quest.4200000000060131.quest_desc: [
		"Die Anzeigetafel zeigt Daten.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060131.title: "Anzeigetafel"
	quest.4200000000060132.quest_desc: [
		"Schießt eine Kartoffel hart genug, um etwas zurückzustoßen. Meistens zum Lachen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060132.title: "Kartoffelkanone"
	quest.4200000000060133.quest_desc: [
		"Erreicht und bricht Blöcke weiter weg, als dein Arm reicht.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.4200000000060133.title: "Extendo Griff"
	quest.4200000000060134.quest_desc: [
		"Ein Rad, eine Presse, ein Mischer, ein Lüfter, ein Uhrwerkherz.",
		"Setze den Strang unter Spannung: die Antwort der Musterweber.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.4200000000060134.quest_subtitle: "Muster"
	quest.4200000000060134.title: "Uhrknoten"
	quest.4200000000060135.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"Seltene Belohnung: ein geteiltes Clowder-Leben, einmal für das ganze Team. Nur sechs solche Belohnungen gibt es in der Kampagne.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.4200000000060135.title: "Uhr einsetzen"
	quest.4200000000060136.quest_desc: [
		"Zwanzig Skelette. Das Muster hält, wenn du das Licht anlässt.",
		"So: töte zwanzig Skelette. Halt die Plattform beleuchtet."
	]
	quest.4200000000060136.title: "Klappern in den Zahnrädern"
	quest.4200000000070137.quest_desc: [
		"Stell das Eichennest auf die Plattform und rechtsklicke es mit einer kleinen Blume. Warte. Etwas mit Flügeln kommt aus dem Holz.",
		"Sieh sie dir an. Das zählt.",
		"So: Rechtsklick auf das Eichennest mit einer kleinen Blume, dann schau dir die erste Biene an, die herauskommt."
	]
	quest.4200000000070137.quest_subtitle: "Kolonie"
	quest.4200000000070137.title: "Erste Flügel"
	quest.4200000000070138.quest_desc: [
		"Acht Eichenstämme um eine kleine Blume. Setze es und wecke es mit einer weiteren Blume; das Holz erinnert sich an Flügel.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000070138.title: "Eichenring"
	quest.4200000000070139.quest_desc: [
		"Knochenmehl auf Gras. Bienen bleiben nicht, wo nichts blüht.",
		"So: Knochenmehl auf Gras. Bienen wollen irgendeine kleine Blume."
	]
	quest.4200000000070139.title: "Eine Blume zum Zanken"
	quest.420000000007013A.quest_desc: [
		"Bretter und Blumen — ein Zuhause, in das eine Wildbiene einzieht.",
		"So: drei kleine Blumen zwischen zwei Reihen Bretter. Schwarm benennt das Nest."
	]
	quest.420000000007013A.title: "Bienennest"
	quest.420000000007013B.quest_desc: [
		"Kolonien im Wind. Der Stand der Koloniehüter bei /clowder hub verkauft Honigwabe, wenn keine vorbeitreibt.",
		"So: scher ein Nest oder einen Stock, nachdem Bienen eine Blume bearbeitet haben. Der Stand der Koloniehüter bei /clowder hub verkauft acht für 16 Faden."
	]
	quest.420000000007013B.title: "Honigwabe"
	quest.420000000007013C.quest_desc: [
		"Ein Zuhause für Arbeiterinnen.",
		"So: drei Honigwaben und sechs Bretter. Ein Lagerfeuer darunter beruhigt sie."
	]
	quest.420000000007013C.title: "Bienenstock"
	quest.420000000007013D.quest_desc: [
		"Süß, klebrig und einem Ofen mehr wert als deinem Magen.",
		"So: Glasflasche auf einen vollen Bienenstock. Lagerfeuer darunter."
	]
	quest.420000000007013D.title: "Honigflasche (Schwarm)"
	quest.420000000007013E.quest_desc: [
		"Ein Happen, der eine aufgeregte Biene beruhigt, bevor du in den Stock greifst.",
		"So: Honigwabe plus eine Honigflasche, formlos."
	]
	quest.420000000007013E.title: "Honey Treat"
	quest.420000000007013F.quest_desc: [
		"Kies um eine Blume. Minenbienen und Gräber mögen den Staub.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.420000000007013F.title: "Ring aus Splitt"
	quest.4200000000070140.quest_desc: [
		"Grobe Erde um eine Blume. Blattschneider und aschige Bergleute.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000070140.title: "Ring aus grober Erde"
	quest.4200000000070141.quest_desc: [
		"Stein um eine Blume. Mauerbienen, und Gräber, die Fels fressen.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000070141.title: "Steinring"
	quest.4200000000070142.quest_desc: [
		"Ein produktives Zuhause.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000070142.title: "Fortgeschrittener Bienenstock"
	quest.4200000000070143.quest_desc: [
		"Gibt einem Stock mehr Platz, bevor er schwärmt und einen neuen sucht.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000070143.title: "Erweiterungskiste"
	quest.4200000000070144.quest_desc: [
		"Füllt den Ertrag ab, ohne dass du die Hand dranlegst.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000070144.title: "Bottler"
	quest.4200000000070145.quest_desc: [
		"Schleudere die Waben in alles, was sie verbergen.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000070145.title: "Centrifuge"
	quest.4200000000070146.quest_desc: [
		"Dasselbe, schneller, mit Energie.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000070146.title: "Powered Centrifuge"
	quest.4200000000070147.quest_desc: [
		"Holt eine Biene mit dem Netz aus der Luft, ohne einen einzigen Stich.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000070147.title: "Catcher"
	quest.4200000000070148.quest_desc: [
		"Trag eine Biene wie eine Laterne.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000070148.title: "Bee Cage"
	quest.4200000000070149.quest_desc: [
		"Brüte die Gene aus, die du willst.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000070149.title: "Inkubator"
	quest.420000000007014A.quest_desc: [
		"Paare zwei Kolonien absichtlich.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.420000000007014A.title: "Breeding Chamber"
	quest.420000000007014B.quest_desc: [
		"Sortiere Merkmale wie Saatgut.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.420000000007014B.title: "Gene Indexer"
	quest.420000000007014C.quest_desc: [
		"Ein Stapel Leckereien: der Lohn der Kolonie.",
		"So: Honigwabe plus eine Honigflasche, formlos."
	]
	quest.420000000007014C.title: "Futterverbesserung"
	quest.420000000007014D.quest_desc: [
		"Eine der tieferen Essenzpflanzen, weit über die Grundlagen hinaus gezogen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000007014D.title: "Diamantsamen"
	quest.420000000007014E.quest_desc: [
		"Ein Beet, das Staub liefert, statt danach zu graben.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000007014E.title: "Redstone-Samen"
	quest.420000000007014F.quest_desc: [
		"Zieht die blaue Essenz, nach der Zaubertische immer hungern.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000007014F.title: "Lapislazulisamen"
	quest.4200000000070150.quest_desc: [
		"Quarz, auf einer Pflanze gezogen, statt aus Nether-Höhlen gegraben.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000070150.title: "Netherquarz-Samen"
	quest.4200000000070151.quest_desc: [
		"Ein sanfterer Weg, Licht anzubauen, als die Netherdecke abzubauen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000070151.title: "Glowstone-Samen"
	quest.4200000000070152.quest_desc: [
		"Eine gehärtete Pflanze, die Obsidianessenz liefert, ohne dass ein Lavaeimer in Sicht ist.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000070152.title: "Obsidiansamen"
	quest.4200000000070153.quest_desc: [
		"Hohe Essenz. Die Felder sind jetzt Industrie.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000070153.title: "Imperium"
	quest.4200000000070154.quest_desc: [
		"Die letzte Essenzstufe. Was auch immer du baust, das ist die gute Version.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"Schwarmüberschuss, gestapelt.",
		"So: vier Honigflaschen. Die Flaschen kommen zurück."
	]
	quest.4200000000070155.title: "Honigblock"
	quest.4200000000070156.quest_desc: [
		"Eine Biene, die es nicht gab, bevor du das Nest gebaut hast.",
		"Minenbiene, Mauerbiene, Gräber, Holzbiene — sieh dir eine an.",
		"So: sieh dir eine Productive Bee an, nachdem ein Nest erwacht. Erste Flügel ist das Eichennest."
	]
	quest.4200000000070156.quest_subtitle: "Kolonie"
	quest.4200000000070156.title: "Etwas Neues summt"
	quest.4200000000070157.quest_desc: [
		"Sand um eine Blume. Aschige und Schokoladen-Bergleute.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000070157.title: "Sandring"
	quest.4200000000070158.quest_desc: [
		"Zuckerrohr um eine Blume. Schilfbienen und Mauerbienen.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000070158.title: "Schilfring"
	quest.4200000000070159.quest_desc: [
		"Schleimblöcke um eine Blume. Rate.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000070159.title: "Schleimring"
	quest.420000000007015A.quest_desc: [
		"Heu um eine Blume. Hummeln, und auch ganz normale Bienen.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.420000000007015A.title: "Heuring"
	quest.420000000007015B.quest_desc: [
		"Schnee um eine Blume. Schweißbienen, seltsamerweise.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.420000000007015B.title: "Schneering"
	quest.420000000007015C.quest_desc: [
		"Verbrennt Honig zu Energie. Ein Stock im Doppeldienst.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.420000000007015C.title: "Honey Generator"
	quest.420000000007015D.quest_desc: [
		"Zeigt eine Biene, samt Flügeln, ohne angebauten Stock.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.420000000007015D.title: "Glas"
	quest.420000000007015E.quest_desc: [
		"Beruhigt einen Stock voller Bienen, bevor du nach Honigwabe gräbst.",
		"So: Stämme, Stöcke und Kohle oder Holzkohle."
	]
	quest.420000000007015E.title: "Lagerfeuer (Schwarm)"
	quest.420000000007015F.quest_desc: [
		"Füttert Bienen und blüht zweimal im Jahr, den Rest der Zeit immergrün.",
		"So: Moos plus Eiche, oder Knochenmehl auf Moos. Bienen nehmen die Blüte an."
	]
	quest.420000000007015F.title: "Blühende Azalee (Schwarm)"
	quest.4200000000070160.quest_desc: [
		"Hoch, gelb und immer der Sonne zugewandt. Bienen finden sie leicht.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000070160.title: "Sonnenblume"
	quest.4200000000070161.quest_desc: [
		"Zwei Blöcke lila Blüte, für die Bienen eine Plattform überqueren.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000070161.title: "Flieder"
	quest.4200000000070162.quest_desc: [
		"Eine hohe Blume, die Bienen mögen, und eine Farbe mehr für den Garten.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000070162.title: "Rosenstrauch"
	quest.4200000000070163.quest_desc: [
		"Rosa und voll, gepflanzt, wo ein Stock in der Nähe mehr Weide braucht.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000070163.title: "Pfingstrose"
	quest.4200000000070164.quest_desc: [
		"Eine kurze, einzelne Blume, aber Bienen ist die Höhe egal.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000070164.title: "Orange Tulpe"
	quest.4200000000070165.quest_desc: [
		"Ein Nest, das du gebaut hast, ein Stock, den du versetzt hast, eine Zentrifuge, ein Inkubator, Essenzfelder.",
		"Gib dem Strang Spannung: die Koloniehüter antworten.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.4200000000070165.quest_subtitle: "Kolonie"
	quest.4200000000070165.title: "Schwarmknoten"
	quest.4200000000070166.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.4200000000070166.title: "Setze Schwarm ein"
	quest.4200000000070167.quest_desc: [
		"Du hast eine Biene getötet.",
		"Die Koloniehüter möchten ein Wort. Hier ist eine Flasche; denk darüber nach.",
		"So: töte eine Biene (verborgen). Die Flasche ist die Lektion."
	]
	quest.4200000000070167.title: "Reue"
	quest.4200000000080168.quest_desc: [
		"Die Hüter haben Tricks im Kristall gelassen. Zweiunddreißig Scherben.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Sieb, oder Amethystknospe, wenn du eine Geodenlinie züchtest. Occultism will Scherben."
	]
	quest.4200000000080168.title: "Amethyst"
	quest.4200000000080169.quest_desc: [
		"Rechtsklick auf den Spannungspfosten mit 16 Strangfilamenten in der Hand. Kein Strang muss eingesetzt sein.",
		"Binden beginnt hier.",
		"So: Rechtsklick auf den Spannungspfosten mit 16 Strangfilamenten in der Hand. Siebe Kies oder Sand mit einem eisernen Fadennetz, um sie zu finden."
	]
	quest.4200000000080169.title: "Zopfkordel"
	quest.420000000008016A.quest_desc: [
		"Schreib den Ritus, bevor du ihn schnitzt.",
		"So: Buch, Tintenbeutel, Feder. Holzkohle plus eine Glasflasche ergeben die Tinte."
	]
	quest.420000000008016A.title: "Buch und Feder"
	quest.420000000008016B.quest_desc: [
		"Sanfte Kraft für harte Werkzeuge.",
		"So: zwei Diamanten, vier Obsidian, Buch. Diamanten aus Kies am Eisennetz."
	]
	quest.420000000008016B.title: "Zaubertisch (Siegel)"
	quest.420000000008016C.quest_desc: [
		"Befeuere den Tisch.",
		"So: neun Lapislazuli. Siebe Kies, oder Lapislazulierz im Echobrecher."
	]
	quest.420000000008016C.title: "Lapislazuliblock"
	quest.420000000008016D.quest_desc: [
		"Umringt einen Zaubertisch, um seine stärksten Verzauberungen freizuschalten.",
		"So: sechs Bretter und drei Bücher. Bücher sind Papier plus Leder."
	]
	quest.420000000008016D.title: "Bücherregal"
	quest.420000000008016E.quest_desc: [
		"Heilt tief und gibt ein Leuchten, das nach einer Minute verblasst.",
		"So: acht Gold um einen Apfel. Nicht den verzauberten."
	]
	quest.420000000008016E.title: "Goldener Apfel"
	quest.420000000008016F.quest_desc: [
		"Überspring den Fall.",
		"So: Endermen, oder der Stand der Randgänger bei /clowder hub."
	]
	quest.420000000008016F.title: "Enderperle"
	quest.4200000000080170.quest_desc: [
		"Macht aus Wasserflaschen etwas mit einer echten Wirkung.",
		"So: Lohenrute über drei Bruchsteinen. Die Rute kommt aus einer Netherfestung, nach Obsidian aus Klaue."
	]
	quest.4200000000080170.title: "Braustand"
	quest.4200000000080171.quest_desc: [
		"Hitze für Tränke.",
		"So: fertige ihn aus einer Lohenrute, oder hol ihn aus einer Festung nach Obsidian aus Klaue."
	]
	quest.4200000000080171.title: "Lohenstaub"
	quest.4200000000080172.quest_desc: [
		"Befeuert den Braustand und beweist, dass du den Nether schon hinter dir hast.",
		"So: Netherfestung nach Obsidian aus Klaue. Das Brauen will eine Rute; Ars und Occultism warten nicht darauf."
	]
	quest.4200000000080172.title: "Lohenrute"
	quest.4200000000080173.quest_desc: [
		"Dreht die Wirkung eines Tranks absichtlich ins Schlimmere.",
		"So: Spinnenauge, brauner Pilz, Zucker."
	]
	quest.4200000000080173.title: "Fermentiertes Auge"
	quest.4200000000080174.quest_desc: [
		"Glowstone-Staub für Rezepte.",
		"So: siebe Seelensand, oder Hexen auf der Plattform."
	]
	quest.4200000000080174.title: "Glowstone-Staub (Siegel)"
	quest.4200000000080175.quest_desc: [
		"Atem dessen, was das End bewacht.",
		"So: Glasflasche auf den Drachen. Die End-Insel ist weg. Optional."
	]
	quest.4200000000080175.title: "Drachenatem"
	quest.4200000000080176.quest_desc: [
		"Noch eine Chance.",
		"Optional — keine Überfälle erreichen die Plattform, und das Pack stellt keines her.",
		"So: nur Aufgabenbelohnungen. Uhr einsetzen und Siegel einsetzen geben je eines, und die Gaben der späten Strangknoten bieten mehr. Überfälle und Magier kommen nie zur Plattform. Optional."
	]
	quest.4200000000080176.title: "Totem"
	quest.4200000000080177.quest_desc: [
		"Speichert Quelle, den Brennstoff, den Zauber verbrauchen.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.4200000000080177.title: "Quelljuwel"
	quest.4200000000080178.quest_desc: [
		"Gewachsen, nicht gefunden. Holz für Zauberwerkzeuge und Zaubersockel.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.4200000000080178.title: "Arkanholz"
	quest.4200000000080179.quest_desc: [
		"Erste Zauber. Magie auf Augenhöhe, wenn du sie neben den Riten willst.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.4200000000080179.title: "Zauberbuch für Anfänger"
	quest.420000000008017A.quest_desc: [
		"Eine arkane Feldfrucht, gezogen ebenso für ihren Stoff wie für ihre Magie.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008017A.title: "Magebloom"
	quest.420000000008017B.quest_desc: [
		"Feuerschale für Ritualarbeit.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008017B.title: "Ritual-Kohlenbecken"
	quest.420000000008017C.quest_desc: [
		"Zeigt ein Reagenz und speist es in das Ritual, das es braucht.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008017C.title: "Arkanes Podest"
	quest.420000000008017D.quest_desc: [
		"Schreibe Zauber und Seiten.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008017D.title: "Schreibertisch"
	quest.420000000008017E.quest_desc: [
		"Imprägniere Reagenzien mit Quelle.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008017E.title: "Imbuement-Kammer"
	quest.420000000008017F.quest_desc: [
		"Speichert extra Quelle, damit ein Zauber mitten im Spruch nicht versiegt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008017F.title: "Quellglas"
	quest.4200000000080180.quest_desc: [
		"Ruf die Geister bei ihren Namen.",
		"So: ein Buch und Dämonentraum-Samen, formlos. Lies es; Geisterfeuer ist als Nächstes dran."
	]
	quest.4200000000080180.title: "Occultism-Wörterbuch"
	quest.4200000000080181.quest_desc: [
		"Eine kalte Flamme für Rituale, die gewöhnliches Feuer nicht zu Ende bringt.",
		"So: entzünde Geisterfeuer, wie es das Wörterbuch der Geister zeigt (Es brennt!), und wirf dann Andesit hinein."
	]
	quest.4200000000080181.title: "Geisterfeuer"
	quest.4200000000080182.quest_desc: [
		"Ein Fokus zum Beschwören. Die Riten sind geduldig.",
		"So: Gold um eine Opferschale. Das Wörterbuch nennt das Ritual."
	]
	quest.4200000000080182.title: "Goldene Opferschale"
	quest.4200000000080183.quest_desc: [
		"Das Herz der Aura-Fertigung, abgestimmt auf das Land drumherum.",
		"So: Ritual des Waldes (JEI): drei Stein, ein Goldblatt, ein Goldbarren und eine Freudenmarke. Linie Herz der Aura."
	]
	quest.4200000000080183.title: "Natural Altar"
	quest.4200000000080184.quest_desc: [
		"Eine Pflanze, von hoher Aura durchdrungen und zu etwas Seltenerem gesponnen.",
		"So: vier Blätter und vier Goldklumpen um kurzes Gras ergeben vier Brillante Fasern. Setze sie in die Krone eines Baums; seine Blätter werden mit der Zeit golden."
	]
	quest.4200000000080184.title: "Brilliant Fiber"
	quest.4200000000080185.quest_desc: [
		"Von Aura berührtes Material, wertvoller, als es auf dem Boden liegend aussieht.",
		"So: brich goldene Blätter, die aus Brillanter Faser gewachsen sind."
	]
	quest.4200000000080185.title: "Gold Leaf"
	quest.4200000000080186.quest_desc: [
		"Eisen, das Umgebungs-Aura aufgesogen hat, bis es mehr wert ist als das Erz.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000080186.title: "Durchdrungenes Eisen"
	quest.4200000000080187.quest_desc: [
		"Lässt dich den Aura-Stand des Landes um dich sehen.",
		"So: Goldblatt + Spinnenauge. Zeigt die lokale Aura."
	]
	quest.4200000000080187.title: "Auge"
	quest.4200000000080188.quest_desc: [
		"Eine Freudenmarke. Der Natürliche Altar und der Pflanzenfresser-Absorber werden auf einer gebaut.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000080188.title: "Token of Joy"
	quest.4200000000080189.quest_desc: [
		"Vorrat an Zauberpergament.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.4200000000080189.title: "Zauberpergament"
	quest.420000000008018A.quest_desc: [
		"Markiert einen Ort, zu dem du mit einem Wort zurückkehrst, nicht zu Fuß.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008018A.title: "Warp-Schriftrolle"
	quest.420000000008018B.quest_desc: [
		"Pflanze sie, pflege sie und ernte Tuch, das in niedriger Magie getränkt ist.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008018B.title: "Magierblüten-Anbau"
	quest.420000000008018C.quest_desc: [
		"Die leere Seite, auf die ein Zauber geschrieben wird.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.420000000008018C.title: "Leere Glyphe"
	quest.420000000008018D.quest_desc: [
		"Wirkt Kampfzauber, ohne je einen Stab zu berühren.",
		"So: drei Ketten, vier Leder und zwei Papier. Das Zauber-Kapitel nennt Tinte."
	]
	quest.420000000008018D.title: "Irons Zauberbuch"
	quest.420000000008018E.quest_desc: [
		"Der Brennstoff, den Zauberwirker verbrauchen, Zauber um Zauber.",
		"So: töte Wirker oder fertige, was JEI listet. Brennstoff für Tinte und Bücher."
	]
	quest.420000000008018E.title: "Arcane Essence"
	quest.420000000008018F.quest_desc: [
		"Schreibt einen Zauber in ein Buch, eine Stufe nach der anderen.",
		"So: Flasche + Essenz + Farbstoff. Erste Einschreibtinte."
	]
	quest.420000000008018F.title: "Gewöhnliche Tinte"
	quest.4200000000080190.quest_desc: [
		"Farbe für Riten.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000080190.title: "Mystische Blume"
	quest.4200000000080191.quest_desc: [
		"Echo des tiefen Dunkels.",
		"Optional — die Leere bietet dir vielleicht nie einen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000080191.title: "Echoscherbe"
	quest.4200000000080192.quest_desc: [
		"Ein Zopf gesponnen, Tränke abgefüllt, Zauber und Geister gerufen.",
		"Lege Spannung an den Strang: die Siegelschneider antworten.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.4200000000080192.quest_subtitle: "Binden"
	quest.4200000000080192.title: "Siegelknoten"
	quest.4200000000080193.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"Seltene Belohnung: ein geteiltes Clowder-Leben, einmal für das ganze Team. Nur sechs solche Belohnungen gibt es in der Kampagne.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.4200000000080193.title: "Setze das Siegel"
	quest.4200000000080194.quest_desc: [
		"Ein Apfel, den die Hüter nie aßen. Du solltest es wohl auch nicht.",
		"So: kein Plattform-Rezept. Optionales Geheimnis — es sperrt den Siegelknoten nicht."
	]
	quest.4200000000080194.title: "Altes Gold"
	quest.4200000000090195.quest_desc: [
		"Ein Eisennetz, Kies oder Sand, Geduld.",
		"Das Strangfilament ist der eigene Faden des Webstuhls. Der Zopf wird daraus gesponnen.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Fadennetz (Eisen) auf Kies, Sand oder Staub (Webrahmen oder Sieb)."
	]
	quest.4200000000090195.title: "Spinn das Filament"
	quest.4200000000090196.quest_desc: [
		"Sechzehn Filamente, ein Rechtsklick auf den Spannungspfosten.",
		"Das Binden hat begonnen; Neuweben fängt hier an.",
		"So: Rechtsklick auf den Spannungspfosten mit 16 Strangfilamenten in der Hand. Siebe Kies oder Sand mit einem eisernen Fadennetz, um sie zu finden."
	]
	quest.4200000000090196.title: "Spleiße einen Zopf"
	quest.4200000000090197.quest_desc: [
		"Certus-Quarz — der kalte Faden eines digitalen Webstuhls.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.4200000000090197.title: "Kalter Schuss"
	quest.4200000000090198.quest_desc: [
		"Gemahlener Quarz, der Grundstoff, aus dem der digitale Webstuhl gebaut ist.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.4200000000090198.title: "Certus-Staub"
	quest.4200000000090199.quest_desc: [
		"Der Hüllenblock jeder Netzwerkmaschine, gebrochen aus Certus-Lagerstätten.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.4200000000090199.title: "Himmelsstein"
	quest.420000000009019A.quest_desc: [
		"Fluix — Certus, Quarz und Redstone, in Wasser geladen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.420000000009019A.title: "Geladene Kette"
	quest.420000000009019B.quest_desc: [
		"Eine Mischung aus Quarz, Redstone und Glas, fein gemahlen fürs Herstellen im Netzwerk.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.420000000009019B.title: "Fluixstaub"
	quest.420000000009019C.quest_desc: [
		"Silizium für AE2-Prozessoren.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.420000000009019C.title: "Silizium"
	quest.420000000009019D.quest_desc: [
		"Der Inscriptor presst Schaltkreise, so wie der Webstuhl Tuch presst.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.420000000009019D.title: "Press das Muster"
	quest.420000000009019E.quest_desc: [
		"Prägt eine Siliziumplatte, so wie der Webstuhl Tuch presst.",
		"So: Eisenblock, Bindungsknoten, Eisen und Quarz. AE2 dupliziert nur eine Presse, die du schon hast."
	]
	quest.420000000009019E.title: "Gravur-Siliziumdruck"
	quest.420000000009019F.quest_desc: [
		"Prägt die Stanze für einen Logikprozessor, eine Pressung nach der anderen.",
		"So: Eisenblock, Bindungsknoten, Eisen und Gold. Die erste Kopie ist die Knotenfertigung."
	]
	quest.420000000009019F.title: "Logikpresse"
	quest.42000000000901A0.quest_desc: [
		"Prägt die Stanze für einen Berechnungsprozessor.",
		"So: Eisenblock, Bindungsknoten, Eisen und Certus (Sieb, Sand). Die erste Kopie ist die Knotenfertigung."
	]
	quest.42000000000901A0.title: "Berechnungspresse"
	quest.42000000000901A1.quest_desc: [
		"Fertigung der Ingenieursform.",
		"So: Eisenblock, Bindungsknoten, Eisen und Diamant. Die erste Kopie ist die Knotenfertigung."
	]
	quest.42000000000901A1.title: "Ingenieurspresse"
	quest.42000000000901A2.quest_desc: [
		"Logikprozessor für AE2.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901A2.title: "Logikprozessor"
	quest.42000000000901A3.quest_desc: [
		"Ein Bauteil in Selbstfertigungsmustern, aus Silizium und Certusquarz.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901A3.title: "Kalkulationsprozessor"
	quest.42000000000901A4.quest_desc: [
		"Ein dichterer Prozessor, nötig für die anspruchsvolleren Teile des Netzwerks.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901A4.title: "Konstruktionsprozessor"
	quest.42000000000901A5.quest_desc: [
		"Beherbergt die Zellen, die alles halten, woran sich das Netzwerk erinnert.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901A5.title: "ME-Laufwerk"
	quest.42000000000901A6.quest_desc: [
		"Die Hülle, in der eine Speicherzelle gebaut wird.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901A6.title: "Gegenstandszellengehäuse"
	quest.42000000000901A7.quest_desc: [
		"Die erste digitale Truhe.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901A7.title: "1k-Gegenstandszelle"
	quest.42000000000901A8.quest_desc: [
		"Sieh das Netz.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901A8.title: "ME-Konsole"
	quest.42000000000901A9.quest_desc: [
		"Lässt dich direkt aus dem herstellen, was das Netzwerk schon hält.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901A9.title: "Fertigungsterminal"
	quest.42000000000901AA.quest_desc: [
		"Der Controller. Will einen Bindungsknoten in seiner Mitte.",
		"Spindelkern.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901AA.title: "Digitaler Webstuhl"
	quest.42000000000901AB.quest_desc: [
		"Benutze sie mit leeren Händen und spiele den Torritus: triff die fallenden Schläge auf A, S, D, F. Erreiche 60% und sie öffnet sich; kein Puls nötig.",
		"So: benutze die Tortrommel mit leeren Händen und spiele den Torritus: triff die fallenden Schläge auf A, S, D, F. Erreiche 60% und sie öffnet sich; kein Puls nötig. Binde zuerst einen Rückkehrkompass."
	]
	quest.42000000000901AB.title: "Tortrommel"
	quest.42000000000901AC.quest_desc: [
		"Halt von jenseits des Tores. Bring einen mit nach Hause.",
		"So: schmelze Bruchstein der Mark. Baue ihn in der Mark ab, durch eine Tortrommel."
	]
	quest.42000000000901AC.title: "Marschstein"
	quest.42000000000901AD.quest_desc: [
		"Trägt die Kanäle des Netzwerks von einer Maschine zur nächsten.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901AD.title: "Fluixkabel"
	quest.42000000000901AE.quest_desc: [
		"Zieh Gegenstände in den Speicher.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901AE.title: "Importbus"
	quest.42000000000901AF.quest_desc: [
		"Schiebt Gegenstände aus dem Netzwerk in eine Truhe oder Maschine.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901AF.title: "Exportbus"
	quest.42000000000901B0.quest_desc: [
		"Liest ein äußeres Inventar ins Netzwerk, als wäre es eine Zelle.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B0.title: "Speicherbus"
	quest.42000000000901B1.quest_desc: [
		"Gibt der Selbstfertigung des Netzwerks mehr Kapazität für große Aufträge.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B1.title: "Fertigungseinheit"
	quest.42000000000901B2.quest_desc: [
		"Lässt mehr Fertigungsaufträge zugleich laufen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B2.title: "Fertigungs-Prozessoreinheit"
	quest.42000000000901B3.quest_desc: [
		"Hält Muster bereit, aus denen das Netzwerk schöpft, während es herstellt.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B3.title: "1k-Fertigungsspeicher"
	quest.42000000000901B4.quest_desc: [
		"Speist Muster in die Maschinen, so wie ein Webstuhl den Faden ins Schiffchen speist.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B4.title: "Musteranbieter"
	quest.42000000000901B5.quest_desc: [
		"Baut aus Mustern. Will eine Zopfkordel in seinem Herzen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B5.title: "Molekularassembler"
	quest.42000000000901B6.quest_desc: [
		"Ein leeres Muster, das darauf wartet, mit einem Rezept beschrieben zu werden.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B6.title: "Leere Schablone"
	quest.42000000000901B7.quest_desc: [
		"Speise Energie in den digitalen Webstuhl.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B7.title: "Energieakzeptor"
	quest.42000000000901B8.quest_desc: [
		"Verbrenne für AE — optionaler Energiezweig.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B8.title: "Vibrationskammer"
	quest.42000000000901B9.quest_desc: [
		"Eine Speicherzelle mit mehr Platz als die vorige Größe.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901B9.title: "4k-Gegenstandszelle"
	quest.42000000000901BA.quest_desc: [
		"Fasst weit mehr als jede Kiste, die dichteste Zelle, bevor das Laufwerk voll ist.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901BA.title: "16k-Gegenstandszelle"
	quest.42000000000901BB.quest_desc: [
		"Die Hülle, in der eine Flüssigkeitsspeicherzelle gebaut wird.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901BB.title: "Flüssigkeitszellengehäuse"
	quest.42000000000901BC.quest_desc: [
		"Ein digitaler Tank, der Flüssigkeit speichert, die das Netzwerk von überall holen kann.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901BC.title: "1k-Flüssigkeitszelle"
	quest.42000000000901BD.quest_desc: [
		"Setzt Blöcke aus dem Netzwerk, wie eine Hand es täte, ohne eine zu haben.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901BD.title: "Formungsebene"
	quest.42000000000901BE.quest_desc: [
		"Bricht Blöcke vor sich und speist sie ins Netzwerk.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901BE.title: "Vernichtungsebene"
	quest.42000000000901BF.quest_desc: [
		"Redstone aus dem Netz.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901BF.title: "Füllstandsemitter"
	quest.42000000000901C0.quest_desc: [
		"Verbindet das Netzwerk mit der Welt und tauscht Gegenstände über die Kante.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901C0.title: "Schnittstelle"
	quest.42000000000901C1.quest_desc: [
		"Verbindet zwei Netzwerke über eine Distanz, die das gewöhnliche Kabel nicht schafft.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901C1.title: "Quantumring"
	quest.42000000000901C2.quest_desc: [
		"Die gepaarte Hälfte eines Quantumrings, die zwei Netzwerke zusammenbindet.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901C2.title: "Quantumverbindung"
	quest.42000000000901C3.quest_desc: [
		"Erreicht das Netzwerk von überall in Reichweite, kein Kabel unter den Füßen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901C3.title: "Drahtlose Zugangskonsole"
	quest.42000000000901C4.quest_desc: [
		"Kopiert die Einstellungen einer Maschine auf eine andere, ohne sie neu zu tippen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901C4.title: "Speicherkarte"
	quest.42000000000901C5.quest_desc: [
		"Netzwerkwerkzeug für AE2.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901C5.title: "Netzwerksonde"
	quest.42000000000901C6.quest_desc: [
		"Lädt Certusquarz, bis er für feinere Arbeit bereit ist.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901C6.title: "Ladegerät"
	quest.42000000000901C7.quest_desc: [
		"Beschleunigt eine wachsende Kristallknospe hin zu einer Gruppe in voller Größe.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000000901C7.title: "Kristallwachstumsbeschleuniger"
	quest.42000000000901C8.quest_desc: [
		"Beweis für das Blätterdach der Mark — optionales Andenken ans Neuweben.",
		"So: wächst wild in der Mark, liegt in Schilfwehr-Kisten, und ein Ältester der Wurzelbinder handelt damit."
	]
	quest.42000000000901C8.title: "Geistrohr"
	quest.42000000000901C9.quest_desc: [
		"Ein Zopf, ein digitaler Webstuhl, ein Tor, ein Stein der Mark.",
		"Spanne den neunten Strang. Dann das Fragment, dann den Pfosten.",
		"Hol es dir und wähle ein Geschenk des Stammes: ein Faden der Rückkehr für ein weiteres geteiltes Leben, oder Vorräte.",
		"So: schließe die verknüpften Aufgaben ab und hol sie dir für die Strang-Marke. Setze die Marke an deinen Spannungspfosten."
	]
	quest.42000000000901C9.quest_subtitle: "Neuweben"
	quest.42000000000901C9.title: "Spindel-Knoten"
	quest.42000000000901CA.quest_desc: [
		"Rechtsklick mit der Marke auf den Spannungspfosten deines Clowder.",
		"Die Kerbe leuchtet, der Stamm klingt, die Plattform verändert sich.",
		"So: Rechtsklick auf deinen Spannungspfosten mit der Strang-Marke in der Hand."
	]
	quest.42000000000901CA.title: "Spindel einsetzen"
	quest.42000000000901CB.quest_desc: [
		"Neun eingesetzt, ein Stein der Mark, ein Rechtsklick auf den Pfosten: das Fragment.",
		"Setze es ein. Der Schnitt schließt sich über deiner Plattform.",
		"So: neun Marken eingesetzt, dann Rechtsklick auf den Pfosten mit Stein der Mark."
	]
	quest.42000000000901CB.quest_subtitle: "Neuweben"
	quest.42000000000901CB.title: "Webstuhlfragment"
	quest.42000000000901CC.quest_desc: [
		"Setze das Fragment am Spannungspfosten ein.",
		"Neun Stämme, ein Faden. Geh und sieh, was die Mark für dich behalten hat.",
		"Seltene Belohnung: ein geteiltes Clowder-Leben, einmal für das ganze Team. Nur sechs solche Belohnungen gibt es in der Kampagne.",
		"So: setze das Spindel-Webstuhlfragment am Spannungspfosten ein. Der Fortschritt löst aus, wenn der Himmel sich schließt."
	]
	quest.42000000000901CC.quest_subtitle: "Der Schnitt, geschlossen"
	quest.42000000000901CC.title: "Neuweben"
	quest.42000000000901CD.quest_desc: [
		"Ein Wither, auf einer Plattform, im Himmel. Die Webstuhlnäher wären beeindruckt gewesen und dann zornig.",
		"So: Wither (drei Schädel auf Seelensand), oder der Stand der Trommelherzen bei /clowder hub einmal, für 12 Fadenballen (972 Faden). Optionale Trophäe — sie sperrt weder das End noch die Monsterfarm zu 100%."
	]
	quest.42000000000901CD.title: "Ein Stern, irgendwie"
	quest.42000000000A01CE.quest_desc: [
		"Blätter lassen mehr Setzlinge fallen.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01CE.title: "Krummstab-Grundlagen"
	quest.42000000000A01CF.quest_desc: [
		"Siebt schneller als der hölzerne Krummstab, und hält viel länger.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01CF.title: "Bone Crook"
	quest.42000000000A01D0.quest_desc: [
		"Das schlichteste Netz. Alles, was du siebst, geht zuerst hier durch.",
		"So: neun Schnur im 3x3. Der Stand der Splittsänger verkauft das Fadennetz (Schnur) des Leerenwebstuhls, das genauso siebt."
	]
	quest.42000000000A01D0.title: "String Mesh"
	quest.42000000000A01D1.quest_desc: [
		"Fängt feinere Splitter als Schnur. Weniger Reste rutschen durch das Gewebe.",
		"So: vier Feuerstein und fünf Schnur im Schachbrettmuster. Feuerstein kommt aus Kies, oder Faden + Kies."
	]
	quest.42000000000A01D1.title: "Feuersteinnetz (Sieb)"
	quest.42000000000A01D2.quest_desc: [
		"Eisenfäden fangen schwereren Grus und ziehen seltenere Reste aus dem Haufen.",
		"So: vier Eisenbarren und fünf Schnur im Schachbrettmuster. Kein Stand verkauft es."
	]
	quest.42000000000A01D2.title: "Eisennetz (Sieb)"
	quest.42000000000A01D3.quest_desc: [
		"Netz der Goldstufe. Die Chancen rücken zu den Erzen, die zählen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01D3.title: "Golden Mesh"
	quest.42000000000A01D4.quest_desc: [
		"Siebe Kies damit, und Diamanten tauchen weit öfter auf.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01D4.title: "Diamond Mesh"
	quest.42000000000A01D5.quest_desc: [
		"Das feinste Netz, das es gibt. Nichts siebt besser als Netheritfaden.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01D5.title: "Netherite Mesh"
	quest.42000000000A01D6.quest_desc: [
		"Glatt verfeinerter Ton, bereit zum Brennen in einen Schmelztiegel, der echte Hitze hält.",
		"So: Tonklumpen + Knochenmehl, formlos. Ton kommt aus dem Spannungsfass."
	]
	quest.42000000000A01D6.title: "Porzellanton (Sieb)"
	quest.42000000000A01D7.quest_desc: [
		"Porzellanton, zu einem Schmelztiegel geformt. Brenn ihn in einem Ofen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01D7.title: "Ungebrannter Schmelztiegel"
	quest.42000000000A01D8.quest_desc: [
		"Hält Schmelzhitze aus, ohne zu reißen. Schmelze, was das Sieb hergab.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01D8.title: "Porcelain Crucible"
	quest.42000000000A01D9.quest_desc: [
		"Spritzt Wasser über die Pflanzen, ohne die Reihen zu zertrampeln.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01D9.title: "Holzgießkanne"
	quest.42000000000A01DA.quest_desc: [
		"Breiterer Schwall und ein tieferer Tank. Du wässerst mehr von der Plattform pro Gang.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01DA.title: "Eisengießkanne"
	quest.42000000000A01DB.quest_desc: [
		"Auf Laub gesetzt spinnt sie Seide, während sie frisst.",
		"So: brich Laub mit einem Krummstab; Seidenraupen fallen ab und zu."
	]
	quest.42000000000A01DB.title: "Silkworm"
	quest.42000000000A01DC.quest_desc: [
		"Seltsames Wasser, das Setzlinge und Samen zu seltsameren Kulturen schiebt.",
		"So: ein Fass Wasser auf Myzel wird zu Hexenwasser; füll einen Eimer daraus. Myzelsporen siebst du aus Erde."
	]
	quest.42000000000A01DC.title: "Witch Water Bucket"
	quest.42000000000A01DD.quest_desc: [
		"Streu sie, und Myzel kriecht nach außen, Block für geduldigen Block.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01DD.title: "Mycelium Spores"
	quest.42000000000A01DE.quest_desc: [
		"Wirf sie auf Erde, und Gras breitet sich aus, ohne auf den Regen zu warten.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01DE.title: "Grass Seeds"
	quest.42000000000A01DF.quest_desc: [
		"Grus als Ersatz für Bruchstein. Gib ihn wieder in den Hammer, für mehr.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01DF.title: "Stone Pebble"
	quest.42000000000A01E0.quest_desc: [
		"Neun Bruchstein, fest zu Lagerstein gepackt, für eine wachsende Plattform.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01E0.title: "Komprimierter Bruchstein"
	quest.42000000000A01E1.quest_desc: [
		"Bricht Bruchstein schneller zu Kies als jeder Hammer davor.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01E1.title: "Netherite Hammer"
	quest.42000000000A01E2.quest_desc: [
		"Netherstein, fein zerkleinert. Basalt und Schwarzstein fangen beide hier an.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01E2.title: "Blackstone Pebble"
	quest.42000000000A01E3.quest_desc: [
		"Tiefenschiefer zu Grus zerkleinert, wieder bereit fürs Sieb.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01E3.title: "Deepslate Pebble"
	quest.42000000000A01E4.quest_desc: [
		"Blasser Stein aus tiefem Sieben, vor allem gut zum Bauen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01E4.title: "Kalzit"
	quest.42000000000A01E5.quest_desc: [
		"Grauer Stein aus der Tiefe, schlicht und leicht zu formen.",
		"So: Sieb, Hammer, Schmelztiegel oder Fass von Ex Deorum. Pass das Netz an den Grus an."
	]
	quest.42000000000A01E5.title: "Tuff"
	quest.42000000000A01E6.quest_desc: [
		"Wächst langsam unter der Erde; staple ihn und lass ihn wieder zu Stalaktiten tropfen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000A01E6.title: "Tropfstein"
	quest.42000000000A01E7.quest_desc: [
		"Saugt stehendes Wasser schnell auf, praktisch nach einem überfluteten Hof.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000A01E7.title: "Schwamm"
	quest.42000000000B01E8.quest_desc: [
		"Verknüpft den Speicher ringsum zu einem durchsuchbaren Netz.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: ein Holzfass oder eine Truhe, zwei Komparatoren, Bretter und Stein. Verknüpft nahe Sophisticated-Fässer."
	]
	quest.42000000000B01E8.title: "Lagerkern"
	quest.42000000000B01E9.quest_desc: [
		"Ein Fass zum Aufrüsten: Filter, Trichter, Magnete, Leere.",
		"So: rüste ein Fass mit Kupfer auf. JEI nennt das Rezept."
	]
	quest.42000000000B01E9.title: "Kupferfass"
	quest.42000000000B01EA.quest_desc: [
		"Mehr Plätze, mehr Verbesserungsreihen.",
		"So: Fässer und Verbesserungen in JEI. Der Controller bindet eine Wand aus Fässern zusammen."
	]
	quest.42000000000B01EA.title: "Eisenfass"
	quest.42000000000B01EB.quest_desc: [
		"Zieht fallengelassene Gegenstände quer über die Plattform direkt ins Fass.",
		"So: Fässer und Verbesserungen in JEI. Der Controller bindet eine Wand aus Fässern zusammen."
	]
	quest.42000000000B01EB.title: "Erweitertes Magnet-Upgrade"
	quest.42000000000B01EC.quest_desc: [
		"Rein auf einer Seite, raus auf der anderen, kein Trichterblock nötig.",
		"So: Fässer und Verbesserungen in JEI. Der Controller bindet eine Wand aus Fässern zusammen."
	]
	quest.42000000000B01EC.title: "Trichter-Upgrade"
	quest.42000000000B01ED.quest_desc: [
		"Löscht alles über der Kapazität, damit die Schublade nie klemmt.",
		"So: Fässer und Verbesserungen in JEI. Der Controller bindet eine Wand aus Fässern zusammen."
	]
	quest.42000000000B01ED.title: "Leerenverbesserung"
	quest.42000000000B01EE.quest_desc: [
		"Zieht nahe liegende Gegenstände direkt in das Lager, an dem sie sitzt.",
		"So: Fässer und Verbesserungen in JEI. Der Controller bindet eine Wand aus Fässern zusammen."
	]
	quest.42000000000B01EE.title: "Aufsammelverbesserung"
	quest.42000000000B01EF.quest_desc: [
		"Ein Platz, sortiert und sichtbar. Der einfachste Weg, Massenware zu lagern.",
		"So: Eichenstämme + Truhe. Erste Schublade."
	]
	quest.42000000000B01EF.title: "Eichenschublade 1x1"
	quest.42000000000B01F0.quest_desc: [
		"Zwei Plätze nebeneinander, damit ähnliche Gegenstände getrennt bleiben.",
		"So: Eichenschubladen 1x1 / 1x2 / 2x2, dann Kompaktierschublade und Controller. JEI nennt das Rezept."
	]
	quest.42000000000B01F0.title: "Eichenschublade 1x2"
	quest.42000000000B01F1.quest_desc: [
		"Vier Plätze in einem Rahmen. Dichtes Lager auf kleiner Fläche.",
		"So: Eichenschubladen 1x1 / 1x2 / 2x2, dann Kompaktierschublade und Controller. JEI nennt das Rezept."
	]
	quest.42000000000B01F1.title: "Eichenschublade 2x2"
	quest.42000000000B01F2.quest_desc: [
		"Verdichtet von selbst, was es hält, zu Blöcken, während es sich füllt.",
		"So: Eichenschubladen 1x1 / 1x2 / 2x2, dann Kompaktierschublade und Controller. JEI nennt das Rezept."
	]
	quest.42000000000B01F2.title: "Compacting Drawer"
	quest.42000000000B01F3.quest_desc: [
		"Verknüpft den Speicher ringsum zu einem durchsuchbaren Netz.",
		"So: Eichenschubladen 1x1 / 1x2 / 2x2, dann Kompaktierschublade und Controller. JEI nennt das Rezept."
	]
	quest.42000000000B01F3.title: "Lager-Controller (Lager)"
	quest.42000000000B01F4.quest_desc: [
		"Zieht nahe Gegenstände direkt in die Schublade.",
		"So: Eichenschubladen 1x1 / 1x2 / 2x2, dann Kompaktierschublade und Controller. JEI nennt das Rezept."
	]
	quest.42000000000B01F4.title: "Collector Upgrade"
	quest.42000000000B01F5.quest_desc: [
		"Zieht Gegenstände aus der Truhe oder Maschine daneben.",
		"So: Eichenschubladen 1x1 / 1x2 / 2x2, dann Kompaktierschublade und Controller. JEI nennt das Rezept."
	]
	quest.42000000000B01F5.title: "Puller Upgrade"
	quest.42000000000B01F6.quest_desc: [
		"Schiebt gelagerte Gegenstände in das Inventar daneben.",
		"So: Eichenschubladen 1x1 / 1x2 / 2x2, dann Kompaktierschublade und Controller. JEI nennt das Rezept."
	]
	quest.42000000000B01F6.title: "Pusher Upgrade"
	quest.42000000000B01F7.quest_desc: [
		"Löscht alles über der Kapazität, damit die Schublade nie klemmt.",
		"So: Eichenschubladen 1x1 / 1x2 / 2x2, dann Kompaktierschublade und Controller. JEI nennt das Rezept."
	]
	quest.42000000000B01F7.title: "Leerenverbesserung (Lager)"
	quest.42000000000B01F8.quest_desc: [
		"Ein tragbares Inventar, das die Schnellleiste und den Platz in den Taschen freimacht.",
		"So: Leder + Truhe. Dann Eisen-/Gold-/Diamantverbesserungen."
	]
	quest.42000000000B01F8.title: "Rucksack"
	quest.42000000000B01F9.quest_desc: [
		"Mehr Plätze als der schlichte Rucksack, und ein Platz, um ihn zu verbessern.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B01F9.title: "Eiserner Rucksack"
	quest.42000000000B01FA.quest_desc: [
		"Noch geräumiger, mit Plätzen übrig für nützliche Verbesserungen.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B01FA.title: "Goldener Rucksack"
	quest.42000000000B01FB.quest_desc: [
		"Die tiefsten Taschen, bevor die Verzauberung das Lager noch weiter treibt.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B01FB.title: "Diamantrucksack"
	quest.42000000000B01FC.quest_desc: [
		"Zieht nahe liegende Gegenstände direkt in das Lager, an dem sie sitzt.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B01FC.title: "Aufsammelverbesserung (Lager)"
	quest.42000000000B01FD.quest_desc: [
		"Filtert, was in die Rucksäcke kommt.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B01FD.title: "Filter-Upgrade"
	quest.42000000000B01FE.quest_desc: [
		"Lässt den Rucksack aus dem herstellen, was er schon lagert.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B01FE.title: "Werkbank-Upgrade"
	quest.42000000000B01FF.quest_desc: [
		"Speist dich automatisch aus ihrem Vorrat, wenn der Hunger sinkt.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B01FF.title: "Futter-Upgrade"
	quest.42000000000B0200.quest_desc: [
		"Tauscht ein kaputtes Werkzeug gegen ein frisches aus dem Rucksack.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B0200.title: "Auffüll-Upgrade"
	quest.42000000000B0201.quest_desc: [
		"Leert den Rucksack in nahe Truhen, wenn du herankommst.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B0201.title: "Lager-Upgrade"
	quest.42000000000B0202.quest_desc: [
		"Fügt einen Fluidtank im Rucksack hinzu, um Flüssigkeiten zu schleppen.",
		"So: Lederrucksack, dann Eisen-/Gold-/Diamantverbesserungen in JEI."
	]
	quest.42000000000B0202.title: "Tank-Upgrade"
	quest.42000000000C0203.quest_desc: [
		"Das Grundmetall der meisten Maschinen und Gehäuse dieser Linie.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0203.title: "Stahlbarren"
	quest.42000000000C0204.quest_desc: [
		"Das Kernmetall der meisten Kabel, Tanks und frühen Maschinen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0204.title: "Osmiumbarren"
	quest.42000000000C0205.quest_desc: [
		"Eine harte Legierung aus gepresstem Obsidianstaub, für zähere Ausrüstung.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0205.title: "Veredelter Obsidian"
	quest.42000000000C0206.quest_desc: [
		"Die einfachste Logikplatine. Die meisten frühen Maschinen brauchen ein paar davon.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0206.title: "Einfacher Steuerschaltkreis"
	quest.42000000000C0207.quest_desc: [
		"Eine schärfere Logikplatine für die Maschinen eine Stufe höher in der Linie.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0207.title: "Fortschrittlicher Steuerschaltkreis"
	quest.42000000000C0208.quest_desc: [
		"Die schärfste Logikplatine, reserviert für die Spitzenmaschinen der Linie.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0208.title: "Elitärer Steuerschaltkreis"
	quest.42000000000C0209.quest_desc: [
		"Tränkt Metalle vor dem Schmelzen mit Kohlenstoff, Redstone oder Diamantstaub.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0209.title: "Metallurgische Infusionsanlage"
	quest.42000000000C020A.quest_desc: [
		"Verdoppelt die meisten Roherze zu zwei Stäuben statt einem.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C020A.title: "Anreicherungskammer"
	quest.42000000000C020B.quest_desc: [
		"Mahl oder zerkleiner Material in Menge.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C020B.title: "Zerkleinerer"
	quest.42000000000C020C.quest_desc: [
		"Schmilzt Erze mit Energie statt Brennstoff, und ein wenig schneller dazu.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C020C.title: "Energiegeladener Schmelzer"
	quest.42000000000C020D.quest_desc: [
		"Reinigt angereichertes Erz mit Sauerstoff für eine dritte Ausbeute, manchmal mehr.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C020D.title: "Klärkammer"
	quest.42000000000C020E.quest_desc: [
		"Spritzt Gas ins Erz für die reichste Ausbeute der Linie.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C020E.title: "Chemische Injektion"
	quest.42000000000C020F.quest_desc: [
		"Presst Osmiumstaub schneller zu Barren als ein Ofen allein.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C020F.title: "Osmiumkompressor"
	quest.42000000000C0210.quest_desc: [
		"Ein einzelner Stapelplatz, der weit mehr fasst als eine Kiste.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0210.title: "Einfache Tonne"
	quest.42000000000C0211.quest_desc: [
		"Speichert einen tiefen Vorrat eines einzigen Fluids in einem Block.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0211.title: "Einfacher Flüssigkeitsbehälter"
	quest.42000000000C0212.quest_desc: [
		"Puffert Energie zwischen den Maschinen, damit Stöße die Linie nicht stoppen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0212.title: "Einfacher Energie-Würfel"
	quest.42000000000C0213.quest_desc: [
		"Trägt Energie zu den Maschinen. Das üblichste Kabel auf der Plattform.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0213.title: "Einfaches Universalkabel"
	quest.42000000000C0214.quest_desc: [
		"Bewegt Fluide zwischen Tanks und Maschinen entlang der Plattform.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0214.title: "Einfache Rohrleitung"
	quest.42000000000C0215.quest_desc: [
		"Bewegt Gegenstände automatisch zwischen verbundenen Inventaren.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0215.title: "Einfacher Logistiktransporter"
	quest.42000000000C0216.quest_desc: [
		"Dreht, schraubt und stellt die Seiten der Maschinen mit einem Werkzeug neu ein.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0216.title: "Konfigurator"
	quest.42000000000C0217.quest_desc: [
		"Mek-Raketenrucksack — Auftrieb nach Wahl.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0217.title: "Jetpack"
	quest.42000000000C0218.quest_desc: [
		"Mildert Fallschaden und kauft dir eine Sekunde, bevor die Leere dich holt.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0218.title: "Freiläufer"
	quest.42000000000C0219.quest_desc: [
		"Ein Werkzeug, das abbaut, schneidet und kämpft, mit jeder Aufwertung schärfer.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C0219.title: "Atomic Disassembler"
	quest.42000000000C021A.quest_desc: [
		"Der Strukturrahmen, um den die meisten Multiblock-Maschinen gebaut werden.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C021A.title: "Stahlgehäuse"
	quest.42000000000C021B.quest_desc: [
		"Verknüpft zwei Punkte, sodass ein Schritt den Weg dazwischen auslässt.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C021B.title: "Teleporter"
	quest.42000000000C021C.quest_desc: [
		"Gräbt von selbst einen weiten Umkreis ab und sortiert die Ausbeute für dich.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000000C021C.title: "Digitales Abbaugerät"
	quest.42000000000D021D.quest_desc: [
		"Eine klebrige Grundzutat, auf der die meisten Maschinen des Netzes aufbauen.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D021D.title: "Dielectric Paste"
	quest.42000000000D021E.quest_desc: [
		"Speicher ein Maß an Energie.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D021E.title: "Basis-Kondensator"
	quest.42000000000D021F.quest_desc: [
		"Hält eine tiefe Energiereserve für die Maschinen ringsum.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D021F.title: "Basis-Energiezelle"
	quest.42000000000D0220.quest_desc: [
		"Verbrennt Brennstoff zu Energie, effizienter als ein schlichter Ofen.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0220.title: "Basis-Brenner"
	quest.42000000000D0221.quest_desc: [
		"Wandelt Lava in stetige Energie, solange die Lava reicht.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0221.title: "Basis-Magmabrenner"
	quest.42000000000D0222.quest_desc: [
		"Erzeugt Energie aus Tageslicht, mehr als eine einzelne Zelle allein schafft.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0222.title: "Basis-Solarpanel"
	quest.42000000000D0223.quest_desc: [
		"Erzeugt Energie aus dem Wärmeunterschied zwischen heißen und kalten Blöcken in der Nähe.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0223.title: "Basis-Thermogenerator"
	quest.42000000000D0224.quest_desc: [
		"Verbrennt festen Brennstoff stetig zu einem starken, verlässlichen Rinnsal an Energie.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0224.title: "Basisreaktor"
	quest.42000000000D0225.quest_desc: [
		"Leitet mehr Energie pro Tick als das Startkabel.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0225.title: "Basis-Energiekabel"
	quest.42000000000D0226.quest_desc: [
		"Lädt dich direkt, ohne Kabel oder Steckplätze.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0226.title: "Basis-Spielersender"
	quest.42000000000D0227.quest_desc: [
		"Speist Energie in nahe Maschinen, so wie ein Trichter Gegenstände speist.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0227.title: "Basis-Energietrichter"
	quest.42000000000D0228.quest_desc: [
		"Lädt Energiezellen schneller, wenn er neben dem Kristallaufbau steht.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0228.title: "Basis-Energiestab"
	quest.42000000000D0229.quest_desc: [
		"Eine Taschenreserve an Energie, von Hand von Maschine zu Maschine zu tragen.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D0229.title: "Basisbatterie"
	quest.42000000000D022A.quest_desc: [
		"Die erste Kristallstufe für die Zellenkammer des Energiestabs.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D022A.title: "Niotic Crystal"
	quest.42000000000D022B.quest_desc: [
		"Eine stärkere Kristallstufe, weiter im Aufbau der Energiekammer.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D022B.title: "Spirited Crystal"
	quest.42000000000D022C.quest_desc: [
		"Die stärkste Kristallstufe, die die Energiekammer fassen kann.",
		"So: Kapitel Powah-Netz — Energieorb und Kabel, sobald Funke-Puls da ist."
	]
	quest.42000000000D022C.title: "Nitro Crystal"
	quest.42000000000E022D.quest_desc: [
		"Aus Magierblüte gesponnen und zu Roben und Zauberausrüstung gewebt.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E022D.title: "Magierfaser"
	quest.42000000000E022E.quest_desc: [
		"Eine Blume, die nach der Ernte ihre Faser am Stängel nachwachsen lässt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E022E.title: "Magebloom"
	quest.42000000000E022F.quest_desc: [
		"Speichert ein dichtes Becken voller Quelle, den Treibstoff hinter jedem Zauber.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E022F.title: "Quelledelsteinblock"
	quest.42000000000E0230.quest_desc: [
		"Hält mehr Glyphen, als das Startbuch erlaubt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0230.title: "Lehrlingszauberbuch"
	quest.42000000000E0231.quest_desc: [
		"Das größte Zauberbuch, mit Platz für ein volles Arsenal an Glyphen.",
		"So: Magierzauberbuch, drei Enderperlen, zwei Smaragde, ein Totem der Unsterblichkeit, ein Netherstern und ein Wilden-Tribut, formlos. Totem: Pack-Rezept, vier Goldblöcke und vier Smaragde um einen Goldapfel."
	]
	quest.42000000000E0231.title: "Erzmagierzauberbuch"
	quest.42000000000E0232.quest_desc: [
		"Wirkt einen gebundenen Zauber automatisch, sobald es ein Ziel spürt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0232.title: "Zauberturm"
	quest.42000000000E0233.quest_desc: [
		"Wirkt seinen gebundenen Zauber nach einem festen Timer, nicht auf Sicht.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0233.title: "Timer-Zauberturm"
	quest.42000000000E0234.quest_desc: [
		"Das Herzstück zum Fertigen von Zauberbüchern, Stäben und anderer arkaner Ausrüstung.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0234.title: "Bezaubernder Apparat"
	quest.42000000000E0235.quest_desc: [
		"Sitzt im Verzauberungsapparat und treibt seine Rezepte an.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0235.title: "Arkaner Kern"
	quest.42000000000E0236.quest_desc: [
		"Trägt Quelle zwischen einer arkanen Stelle und einem verknüpften Gefäß oder Zauber.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0236.title: "Relais"
	quest.42000000000E0237.quest_desc: [
		"Teilt eine Quellenleitung, damit sie mehrere Orte zugleich speist.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0237.title: "Relaisteiler"
	quest.42000000000E0238.quest_desc: [
		"Wandelt das Wachstum naher Feldfrüchte in ein langsames Rinnsal Quelle.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0238.title: "Agronomischer Quellenlink"
	quest.42000000000E0239.quest_desc: [
		"Wandelt die Hitze naher Lava in ein stetiges Rinnsal Quelle.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0239.title: "Vulkanischer Quelllink"
	quest.42000000000E023A.quest_desc: [
		"Beschwört eine Wixie, die für dich Rezepte fertigt, während du woanders arbeitest.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E023A.title: "Wixie-Charme"
	quest.42000000000E023B.quest_desc: [
		"Beschwört einen Starbuncle, der auf Befehl Gegenstände aus dem Lager holt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E023B.title: "Sternbunkel-Charme"
	quest.42000000000E023C.quest_desc: [
		"Beschwört einen Drygmy, der in der Nähe langsam eine gewählte Ressource erzeugt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E023C.title: "Trockener Charme"
	quest.42000000000E023D.quest_desc: [
		"Beschwört einen Whirlisprig, der Feldfrüchte allein pflegt und wachsen lässt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E023D.title: "Wirbelzweig-Charme"
	quest.42000000000E023E.quest_desc: [
		"Beschwört einen Golem, der Amethystknospen erntet, ohne eine Spitzhacke zu heben.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E023E.title: "Amethyst-Golem-Anhänger"
	quest.42000000000E023F.quest_desc: [
		"Hebt Blöcke auf und setzt sie aus der Ferne, und verdrahtet Maschinen über die Distanz.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E023F.title: "Dominion-Zauberstab"
	quest.42000000000E0240.quest_desc: [
		"Markiert einen Gegenstand als erlaubt, sobald er in einem Filter steckt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0240.title: "Erlaubnisrolle"
	quest.42000000000E0241.quest_desc: [
		"Markiert einen Gegenstand als verboten, sobald er in einem Filter steckt.",
		"So: Arkane Seite — Arkanholz und Quellenbeere aus Moos, dann die Kaskade."
	]
	quest.42000000000E0241.title: "Verweigerungsrolle"
	quest.42000000000F0242.quest_desc: [
		"Holzstämme um einen Bindungsknoten, Faden obendrauf. Stelle ihn auf die Plattform.",
		"Steh nah dran: die Plattform fängt an, dich zu heilen, sobald ein Strang eingesetzt ist.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Holzstämme um einen Bindungsknoten, Faden obendrauf. Stelle ihn auf die Plattform. Sieh ihn an, um abzuschließen."
	]
	quest.42000000000F0242.title: "Errichte den Pfosten"
	quest.42000000000F0243.quest_desc: [
		"Nexusschlüssel in der Hand, oder /clowder hub. Jeder Clowder auf dem Server trifft sich hier.",
		"/clowder return bringt dich nach Hause.",
		"So: Nexusschlüssel oder `/clowder hub`. `/clowder return` kommt nach Hause."
	]
	quest.42000000000F0243.title: "Betritt die Halle"
	quest.42000000000F0244.quest_desc: [
		"Über dem Dock steht eine langsame dunkle Säule: der Schnitt selbst.",
		"Sie wird dünner, wenn Clowders Stränge einsetzen. Komm ab und zu zurück und sieh nach.",
		"So: /clowder hub, schau hinauf zur dunklen Säule über dem Dock, dann klick das Häkchen."
	]
	quest.42000000000F0244.title: "Sieh den Ausfrans an"
	quest.42000000000F0245.quest_desc: [
		"Gib einer Plattform deinen Namen.",
		"So: K öffnet das Inselmenü. Halt die Urkunde; benutze sie schleichend auf dem Boden einer Oberwelt-Plattform, um den Spawnpunkt zu versiegeln. Hier anfangen nennt die Schritte."
	]
	quest.42000000000F0245.title: "Inselurkunde"
	quest.42000000000F0246.quest_desc: [
		"Öffnet den Weg zurück in die Clowder-Halle, von überall auf dem Strang.",
		"So: Startpaket / Halle. `/clowder hub` und der Nexusschlüssel führen zur Clowder-Halle; `/clowder return` kommt nach Hause."
	]
	quest.42000000000F0246.title: "Nexusschlüssel"
	quest.42000000000F0247.quest_desc: [
		"Eine Bannervorlage, die zeigt, wie weit dein Strang gekommen ist.",
		"So: fertige es in der Halle oder in JEI. Eine Bannermarke, keine Strang-Marke."
	]
	quest.42000000000F0247.title: "Strang-Banner"
	quest.42000000000F0248.quest_desc: [
		"Gravis (`) öffnet die Auftragsliste. Rechtsklick auf den Schnurrhaar-Kodex für Hier anfangen. Dieselbe Kampagne; kein Umschalt-Klick aufs Buch.",
		"So: ein Buch und irgendein Stein, formlos. Gravis (`) öffnet dieselbe Liste ohne ihn."
	]
	quest.42000000000F0248.title: "Auftragsliste"
	quest.42000000000F0249.quest_desc: [
		"Bleib satt auf den Anspruchs-Touren.",
		"So: acht Goldklumpen um eine Karotte. Karotten sind seltene Zombie-Beute; der Imbiss ist optional."
	]
	quest.42000000000F0249.title: "Anspruchs-Imbiss"
	quest.42000000000F024A.quest_desc: [
		"Kartiert die Plattformen um dich, während sich dein Clowder nach außen ausbreitet.",
		"So: ein Kompass, umgeben von Papier."
	]
	quest.42000000000F024A.title: "Karte"
	quest.42000000000F024B.quest_desc: [
		"Zeigt zurück zum Welt-Spawnpunkt; nützlich, sobald die Plattformen sich mehren.",
		"So: Eisen um Redstone."
	]
	quest.42000000000F024B.title: "Kompass"
	quest.42000000000F024C.quest_desc: [
		"Verankert einen Kompass an einem genauen Punkt statt am Spawnpunkt.",
		"So: ein Netheritbarren in gemeißelten Steinziegeln. Später Luxus für den Clowder."
	]
	quest.42000000000F024C.title: "Leitstein"
	quest.42000000000F024D.quest_desc: [
		"Zeigt auf deinen letzten Tod, damit nichts in der Leere verloren bleibt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000F024D.title: "Bergungskompass"
	quest.42000000000F024E.quest_desc: [
		"Läutet laut genug, um den ganzen Clowder auf einer Plattform zu versammeln.",
		"So: kein Rezept. Das Ritual Wilden Geist kontaktieren von Occultism stellt einen her, braucht aber eine Ziege, und Ziegen erreichen die Plattform nie. Optional."
	]
	quest.42000000000F024E.title: "Glocke"
	quest.42000000000F024F.quest_desc: [
		"Hält ein Buch offen, damit der ganze Clowder es lesen kann.",
		"So: Holzstufen um ein Bücherregal."
	]
	quest.42000000000F024F.title: "Lesepult"
	quest.42000000000F0250.quest_desc: [
		"Beschriftet ein Viertel, damit Neuankömmlinge wissen, welche Plattform welche ist.",
		"So: Bretter über einem Stock."
	]
	quest.42000000000F0250.title: "Eichenholzschild"
	quest.42000000000F0251.quest_desc: [
		"Ein leeres Banner, bereit für die Farben des Clowder.",
		"So: sechs Wolle über einem Stock."
	]
	quest.42000000000F0251.title: "Weißes Banner"
	quest.42000000000F0252.quest_desc: [
		"Schild bereit für Banner.",
		"So: sechs Bretter um Eisen. Blocken in der Nebenhand."
	]
	quest.42000000000F0252.title: "Schild bannerbereit"
	quest.42000000000F0253.quest_desc: [
		"Zünde sie, wenn ein Strang endlich wieder zusammenfindet.",
		"So: Papier plus Schießpulver. Optionaler Knall."
	]
	quest.42000000000F0253.title: "Feuerwerk"
	quest.42000000000F0254.quest_desc: [
		"Teile es mit der Halle.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000F0254.title: "Kekstribute"
	quest.42000000000F0255.quest_desc: [
		"Geteiltes Essen, um einen wahrhaft neugewebten Strang zu feiern.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000F0255.title: "Kuchen"
	quest.42000000000F0256.quest_desc: [
		"Katzenplatte — Stimmung des Pakets.",
		"Optional — die Leere bietet dir vielleicht nie einen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000F0256.title: "Musikplatte"
	quest.42000000000F0257.quest_desc: [
		"Führt ein gezähmtes oder gekauftes Tier zurück zur Plattform, ohne hinterherzulaufen.",
		"So: vier Schnur um einen Schleimball. Schleim ist Plattformkompost (Erde, Samen, Knochenmehl)."
	]
	quest.42000000000F0257.title: "Leine"
	quest.42000000000F0258.quest_desc: [
		"Steig auf, wenn du einen Sattel findest.",
		"Optional — die Plattformhüter in der Clowder-Halle verkaufen einen.",
		"So: tausche einen Diamantblock bei den Plattformhütern in ihrem Laden in der Clowder-Halle (/clowder hub). Der Chocobo-Sattel ist ein anderer Gegenstand."
	]
	quest.42000000000F0258.title: "Sattel"
	quest.42000000000F0259.quest_desc: [
		"Für den Tag, an dem jemand ein Meer baut. Optional.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000000F0259.title: "Boot"
	quest.4200000000110278.quest_desc: [
		"Zeigt, wo sich die Aura dick oder dünn über das Land sammelt.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Goldblatt + Spinnenauge. Zeigt die lokale Aura."
	]
	quest.4200000000110278.title: "Auge (Aura)"
	quest.4200000000110279.quest_desc: [
		"Aus Gold gewebt, dient sie dazu, Pflanzen mit gebündelter Aura zu durchdringen.",
		"So: vier Blätter und vier Goldklumpen um kurzes Gras ergeben vier Brillante Fasern. Setze sie in die Krone eines Baums; seine Blätter werden mit der Zeit golden."
	]
	quest.4200000000110279.title: "Brillante Faser (Aura)"
	quest.420000000011027A.quest_desc: [
		"Ein veredelter Werkstoff für die Rezepte höherer Stufen des Altars.",
		"So: brich goldene Blätter, die aus Brillanter Faser gewachsen sind."
	]
	quest.420000000011027A.title: "Blattgold (Aura)"
	quest.420000000011027B.quest_desc: [
		"Blätter, die das ganze Jahr über einen sanften Goldglanz halten.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011027B.title: "Golden Leaves"
	quest.420000000011027C.quest_desc: [
		"Hält eine Zutat für das Ritual des Waldes, um einen Setzling herum gestellt.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011027C.title: "Wooden Stand"
	quest.420000000011027D.quest_desc: [
		"Der Altar, an dem die Aura stärkere Fertigungsrezepte antreibt.",
		"So: Ritual des Waldes (JEI): drei Stein, ein Goldblatt, ein Goldbarren und eine Freudenmarke. Linie Herz der Aura."
	]
	quest.420000000011027D.title: "Natürlicher Altar (Aura)"
	quest.420000000011027E.quest_desc: [
		"Mit Aura geladenes Eisen, ein Schritt zum Barren der Tiefen.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011027E.title: "Infundiertes Eisen (Aura)"
	quest.420000000011027F.quest_desc: [
		"Von uralten Bäumen abgezogene Rinde, nützlich in Aura-Rezepten.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011027F.title: "Ancient Bark"
	quest.4200000000110280.quest_desc: [
		"Eine Freudenmarke. Der Natürliche Altar und der Pflanzenfresser-Absorber werden auf einer gebaut.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110280.title: "Marke der Freude (Aura)"
	quest.4200000000110281.quest_desc: [
		"Eine Marke der Furcht. Kronenminderer und Verweilabsorber werden auf einer gebaut.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110281.title: "Token of Fear"
	quest.4200000000110282.quest_desc: [
		"Eine Marke des Zorns. Bröckelkatalysator und Schussmarke brauchen eine.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110282.title: "Token of Anger"
	quest.4200000000110283.quest_desc: [
		"Eine Marke der Trauer. Opfertisch und Entwirrer der Sterblichen brauchen eine.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110283.title: "Token of Sorrow"
	quest.4200000000110284.quest_desc: [
		"Aurageist für Rituale.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110284.title: "Spirit of Calling"
	quest.4200000000110285.quest_desc: [
		"Geburtsgeist für Aura-Riten.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110285.title: "Spirit of Birthing"
	quest.4200000000110286.quest_desc: [
		"Speichert eine Reserve an Aura für die Zeit, in der das Land dünn wird.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110286.title: "Aura Trove"
	quest.4200000000110287.quest_desc: [
		"Spät. Nur wenn die Aura es will.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110287.title: "Creational Catalyst"
	quest.4200000000110288.quest_desc: [
		"Zeigt Aura und Erscheinungsbedingungen über ein weiteres Stück Land.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110288.title: "Environmental Ocular"
	quest.4200000000110289.quest_desc: [
		"Neben den Natürlichen Altar gestellt, öffnet er die Zerkleinerungsrezepte des Altars.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110289.title: "Crumbling Catalyst"
	quest.420000000011028A.quest_desc: [
		"Neben den Natürlichen Altar gestellt, öffnet er die Transmutationsrezepte des Altars.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011028A.title: "Transmutation Catalyst"
	quest.420000000011028B.quest_desc: [
		"Himmelsbarren, besudeltes Gold und Netheritschrott, zum Barren der Tiefen gepresst.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011028B.title: "Ingot of the Depths"
	quest.420000000011028C.quest_desc: [
		"Markiert ein Feldmuster, das Aura in schnelleres Wachstum der Ernte zieht.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011028C.title: "Farming Stencil"
	quest.420000000011028D.quest_desc: [
		"Erzeugt Aura, sobald ein Geschoss in der Nähe landet.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011028D.title: "Shooting Mark"
	quest.420000000011028E.quest_desc: [
		"Erzeugt langsam Aura aus Blumen, die in der Nähe blühen.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011028E.title: "Herbivorous Absorber"
	quest.420000000011028F.quest_desc: [
		"Erzeugt langsam Aura aus Eichen, die in der Nähe wachsen.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.420000000011028F.title: "Canopy Diminisher"
	quest.4200000000110290.quest_desc: [
		"Eine Blume aus dem Ende, seltsam heimisch auf einer Plattform.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110290.title: "Rose of Oblivion"
	quest.4200000000110291.quest_desc: [
		"Leuchtet ein Gebiet aus, damit dort keine feindlichen Kreaturen erscheinen.",
		"So: Brillante Faser an Bäumen → Goldblatt → Natürlicher Altar. Das Aura-Kapitel nennt Marken und Generatoren."
	]
	quest.4200000000110291.title: "Lamp of Sanctuary"
	quest.4200000000120292.quest_desc: [
		"Kocht Eintopfgerichte, die mehr als einen Teller auf einmal füllen.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000120292.title: "Kochtopf (Küche)"
	quest.4200000000120293.quest_desc: [
		"Die Pfanne brät die Gerichte.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000120293.title: "Bratpfanne"
	quest.4200000000120294.quest_desc: [
		"Herd für Farmer's Delight.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000120294.title: "Herd"
	quest.4200000000120295.quest_desc: [
		"Schneidet Fleisch und Gemüse zu Zutaten, die andere Rezepte brauchen.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000120295.title: "Schneidebrett (Küche)"
	quest.4200000000120296.quest_desc: [
		"Korb für die Ernte vom Feld.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000120296.title: "Korb"
	quest.4200000000120297.quest_desc: [
		"Du kletterst daran wie an einer Ranke, und mehrere Küchenrezepte brauchen sie.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000120297.title: "Strohseil"
	quest.4200000000120298.quest_desc: [
		"Fängt einen langen Sturz ab und wirft dich unverletzt wieder nach oben.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.4200000000120298.title: "Sicherheitsnetz"
	quest.4200000000120299.quest_desc: [
		"Sobald du sie pflügst und bepflanzt, beschleunigt sie das Wachstum naher Pflanzen.",
		"So: platziere Organischen Kompost und warte; er reift langsam zu Reicher Erde."
	]
	quest.4200000000120299.title: "Reiche Erde (Küche)"
	quest.420000000012029A.quest_desc: [
		"Macht aus Essensresten Kompost, der die Erde anreichert.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000012029A.title: "Organischer Kompost (Küche)"
	quest.420000000012029B.quest_desc: [
		"Eine herzhafte Mahlzeit, in Kohl gewickelt, füllt ein gutes Stück Hunger.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000012029B.title: "Salatrollen"
	quest.420000000012029C.quest_desc: [
		"Schnell gekocht, schnell gegessen, ordentlich Hunger für den Aufwand.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000012029C.title: "Specksandwich"
	quest.420000000012029D.quest_desc: [
		"Eine geschichtete Mahlzeit, die mehr Hunger füllt als die Teile allein.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000012029D.title: "Hamburger"
	quest.420000000012029E.quest_desc: [
		"Eine wärmende Schüssel, die Hunger und Sättigung zugleich füllt.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000012029E.title: "Hühnersuppe"
	quest.420000000012029F.quest_desc: [
		"Rindereintopf macht richtig satt.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.420000000012029F.title: "Rindfleischeintopf"
	quest.42000000001202A0.quest_desc: [
		"Nudeln und Brühe, sättigend genug für einen ganzen Arbeitstag.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A0.title: "Nudelsuppe"
	quest.42000000001202A1.quest_desc: [
		"Ein gebackenes Dessert, das Warten wert, füllt ein großes Stück Hunger.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A1.title: "Apfelkuchen"
	quest.42000000001202A2.quest_desc: [
		"Säuerlich und süß, eines der reichhaltigeren Desserts auf der Plattform.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A2.title: "Süßbeeren-Käsekuchen"
	quest.42000000001202A3.quest_desc: [
		"Reis für die Küchenlinie.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A3.title: "Reis"
	quest.42000000001202A4.quest_desc: [
		"Seelenfutter der Küchenlinie.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A4.title: "Gebratener Reis"
	quest.42000000001202A5.quest_desc: [
		"Kleine gefüllte Päckchen, schnell in Chargen zu kochen.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A5.title: "Teigtaschen"
	quest.42000000001202A6.quest_desc: [
		"Ein warmes Getränk aus Kakaobohnen und Milch.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A6.title: "Heiße Schokolade"
	quest.42000000001202A7.quest_desc: [
		"Ein kühles Getränk, aus Melone gepresst, füllt schnell ein wenig Hunger.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A7.title: "Melonensaft"
	quest.42000000001202A8.quest_desc: [
		"Gewebter Stoff für mehrere Küchen- und Dekorezepte.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A8.title: "Leinenstofffetzen"
	quest.42000000001202A9.quest_desc: [
		"Weicher gewebter Boden, eine andere Textur als schlichtes Holz.",
		"So: Farmer's Delight-Rezept in JEI (Werkbank, Schneidebrett oder Kochtopf). Saatgut kommt vom Sieben von Erde."
	]
	quest.42000000001202A9.title: "Tatami"
	quest.42000000001302AA.quest_desc: [
		"Das erste Buch, das dich in einem echten Kampf zaubern lässt.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: drei Ketten, vier Leder und zwei Papier. Das Zauber-Kapitel nennt Tinte."
	]
	quest.42000000001302AA.title: "Eisen-Zauberbuch"
	quest.42000000001302AB.quest_desc: [
		"Hat mehr Zauberplätze als das Eisenbuch davor.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302AB.title: "Gold-Zauberbuch"
	quest.42000000001302AC.quest_desc: [
		"Ein stabileres Buch mit noch mehr Platz für Zauber.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302AC.title: "Diamant-Zauberbuch"
	quest.42000000001302AD.quest_desc: [
		"Treibt das Zaubern an und steht am Anfang der meisten Zauberrezepte.",
		"So: töte Wirker oder fertige, was JEI listet. Brennstoff für Tinte und Bücher."
	]
	quest.42000000001302AD.title: "Arkane Essenz (Zauber)"
	quest.42000000001302AE.quest_desc: [
		"Schreibe Zauber und Seiten.",
		"So: Flasche + Essenz + Farbstoff. Erste Einschreibtinte."
	]
	quest.42000000001302AE.title: "Common Ink"
	quest.42000000001302AF.quest_desc: [
		"Schreibt Zauber und Schriftrollen der Stufe Ungewöhnlich in ein Buch.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302AF.title: "Uncommon Ink"
	quest.42000000001302B0.quest_desc: [
		"Schreibt Zauber und Schriftrollen der Stufe Selten in ein Buch.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B0.title: "Rare Ink"
	quest.42000000001302B1.quest_desc: [
		"Schreibt Zauber und Schriftrollen der Stufe Episch in ein Buch.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B1.title: "Epic Ink"
	quest.42000000001302B2.quest_desc: [
		"Schreibt die seltensten, stärksten Zauber, die ein Buch fassen kann.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B2.title: "Legendary Ink"
	quest.42000000001302B3.quest_desc: [
		"Wirkt einen Zauber einmal, ohne ihn in einem Buch gelernt zu haben.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B3.title: "Scroll"
	quest.42000000001302B4.quest_desc: [
		"Magischer Stoff für Roben.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B4.title: "Magischer Stoff"
	quest.42000000001302B5.quest_desc: [
		"Leichte Rüstung, die Zaubern über rohe Verteidigung stellt.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B5.title: "Helm des wandernden Magiers"
	quest.42000000001302B6.quest_desc: [
		"Brustrüstung für Zaubertempo statt für eingesteckten Schaden.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B6.title: "Brustplatte des wandernden Magiers"
	quest.42000000001302B7.quest_desc: [
		"Ein Stab, der Feuerzauber mit zusätzlicher Kraft leitet.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B7.title: "Pyrium Staff"
	quest.42000000001302B8.quest_desc: [
		"Ein bescheidener Stab für einen Zauberer am Anfang.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302B8.title: "Graybeard Staff"
	quest.42000000001302B9.quest_desc: [
		"Eine Klinge, die Zaubernde bestraft und ihre Abwehr durchschneidet.",
		"So: Pack-Rezept, zwei Arkane Barren auf der Diagonale, je eine Kette an der Seite und ein Diamant am Griff. Sein einziger wilder Träger lebt in Magierfestungen, und die Plattform hat nie welche."
	]
	quest.42000000001302B9.title: "Magehunter"
	quest.42000000001302BA.quest_desc: [
		"Das früheste Zauberbuch, knapp an Plätzen, aber leicht zu erreichen.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302BA.title: "Kupfer-Zauberbuch"
	quest.42000000001302BB.quest_desc: [
		"Das stärkste Zauberbuch, mit den meisten Zauberplätzen von allen.",
		"So: vier Arkane Stoffe, zwei Blutphiolen, ein Netheritbarren, eine Blitzflasche und ein Ruiniertes Buch (Pack-Rezept). JEI nennt es Alter Kodex."
	]
	quest.42000000001302BB.title: "Netherit-Zauberbuch"
	quest.42000000001302BC.quest_desc: [
		"Veredeltes Metall für das obere Ende der Zauberausrüstung.",
		"So: Arkane Essenz und Tinte, dann ein Zauberbuch. Das Kapitel Zauber nennt die Leiter."
	]
	quest.42000000001302BC.title: "Arcane Ingot"
	quest.42000000001302BD.quest_desc: [
		"Ein beschädigtes Buch, das sich wieder zu Wissen zusammensetzen lässt.",
		"So: Pack-Rezept, ein verzaubertes Buch, umringt von vier Arkanen Essenzen und vier Seelensand. JEI nennt es Ruiniertes Buch."
	]
	quest.42000000001302BD.title: "Ruinierter Kodex"
	quest.42000000001402BE.quest_desc: [
		"Das erste Bauteil von Solar Flux. Zellen, Beschichtungen und die Blanko-Verbesserung werden daraus gebaut.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: drei Glas über einem Eisenbarren ergeben drei Spiegel."
	]
	quest.42000000001402BE.title: "Spiegel"
	quest.42000000001402BF.quest_desc: [
		"Die erste Stufe der Solarzelle, schwach, aber billig zu stapeln.",
		"So: drei Glas, drei Lapislazuli und drei Spiegel, je eine Reihe."
	]
	quest.42000000001402BF.title: "Photovoltaikzelle 1"
	quest.42000000001402C0.quest_desc: [
		"Eine stärkere Solarzelle, eine Stufe über der letzten.",
		"So: drei Tonklumpen, drei Lapislazuli, zwei Spiegel und eine Photovoltaikzelle I."
	]
	quest.42000000001402C0.title: "Photovoltaikzelle 2"
	quest.42000000001402C1.quest_desc: [
		"Solarzelle der Mittelstufe, spürbar mehr Leistung pro Panel.",
		"So: drei Glas, drei Glowstone-Staub, zwei Obsidian und eine Photovoltaikzelle II."
	]
	quest.42000000001402C1.title: "Photovoltaikzelle 3"
	quest.42000000001402C2.quest_desc: [
		"Eine Solarzelle hoher Stufe für ein Panel, das mitwachsen soll.",
		"So: drei Lodernde Beschichtungen, zwei Glowstone-Staub, ein Diamant, zwei Quarzblöcke und eine Photovoltaikzelle III."
	]
	quest.42000000001402C2.title: "Photovoltaikzelle 4"
	quest.42000000001402C3.quest_desc: [
		"Fast ganz oben zieht diese Zelle ernsthafte Kraft aus dem Tageslicht.",
		"So: drei Smaragdglas, zwei Glowstone-Blöcke, ein Diamantblock, ein Quarzblock und zwei Photovoltaikzellen IV. Ergibt zwei."
	]
	quest.42000000001402C3.title: "Photovoltaikzelle 5"
	quest.42000000001402C4.quest_desc: [
		"Die stärkste gefertigte Solarzelle, die Obergrenze für ein einzelnes Panel.",
		"So: drei Enderglas, zwei Glowstone-Blöcke, ein Smaragdblock, ein Quarzblock und zwei Photovoltaikzellen V. Ergibt zwei."
	]
	quest.42000000001402C4.title: "Photovoltaikzelle 6"
	quest.42000000001402C5.quest_desc: [
		"Lässt ein Solarpanel eine größere Reserve an gespeicherter Kraft halten.",
		"So: fünf Redstoneblöcke, ein Diamantblock und eine Blanko-Verbesserung."
	]
	quest.42000000001402C5.title: "Kapazitätsverbesserung"
	quest.42000000001402C6.quest_desc: [
		"Holt mehr Kraft aus demselben Sonnenlicht.",
		"So: drei Spiegel, eine Blanko-Verbesserung und eine Photovoltaikzelle I."
	]
	quest.42000000001402C6.title: "Effizienzverbesserung"
	quest.42000000001402C7.quest_desc: [
		"Lässt ein Solarpanel die Kraft schneller abgeben.",
		"So: sechs Redstone und zwei Goldbarren um eine Blanko-Verbesserung."
	]
	quest.42000000001402C7.title: "Übertragungsverbesserung"
	quest.42000000001402C8.quest_desc: [
		"Gibt die Kraft an die Maschinen weiter, die am Panel hängen, auf wenige Blöcke.",
		"So: vier Eisenbarren, zwei Kolben und zwei Redstone um eine Blanko-Verbesserung."
	]
	quest.42000000001402C8.title: "Querungsverbesserung"
	quest.42000000001402C9.quest_desc: [
		"Schickt Energie an Spieler, die nahe am Paneel stehen.",
		"So: vier Glowstone-Staub und vier Ender-Augen um eine Leere Verbesserung."
	]
	quest.42000000001402C9.title: "Streuverbesserung"
	quest.42000000001402CA.quest_desc: [
		"Schickt Energie an einen verknüpften Block in Reichweite, kein Kabel nötig.",
		"So: vier Enderperlen und vier Redstone-Blöcke um eine Streuverbesserung."
	]
	quest.42000000001402CA.title: "Blockladeverbesserung"
	quest.42000000001402CB.quest_desc: [
		"Lässt das Paneel Gegenstände mit gespeichertem Sonnenlicht schmelzen, statt mit Brennstoff.",
		"So: fünf Kohle, ein Ofen und zwei Lohenbeschichtungen um eine Leere Verbesserung."
	]
	quest.42000000001402CB.title: "Ofenverbesserung"
	quest.42000000001402CC.quest_desc: [
		"Spiegelglas mit einem Smaragd gefasst. Enderglas und Photovoltaikzelle V bauen darauf auf.",
		"So: ein Smaragd zwischen zwei Spiegeln in einer Spalte ergibt zwei."
	]
	quest.42000000001402CC.title: "Smaragdglas"
	quest.42000000001402CD.quest_desc: [
		"Smaragdglas, geladen mit Perlen und einem Auge. Photovoltaikzelle VI baut darauf auf.",
		"So: drei Smaragdglas über einem Ender-Auge zwischen zwei Enderperlen ergeben drei."
	]
	quest.42000000001402CD.title: "Enderglas"
	quest.42000000001402CE.quest_desc: [
		"Eine Spiegel-Oberfläche mit Lohenstaub. Photovoltaikzelle IV und die Ofenverbesserung nutzen sie.",
		"So: Lohenstaub zwischen zwei Spiegeln in einer Spalte ergibt zwei."
	]
	quest.42000000001402CE.title: "Lohenbeschichtung"
	quest.42000000001402CF.quest_desc: [
		"Eine noch unfestgelegte Verbesserung, gefertigt zu jedem Verbesserungstyp.",
		"So: vier Bruchstein um einen Spiegel."
	]
	quest.42000000001402CF.title: "Leere Verbesserung"
	quest.42000000001502D0.quest_desc: [
		"Schlichter, verlässlicher Stein für Wände und Böden.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: vier Stein im Quadrat, oder die Steinsäge."
	]
	quest.42000000001502D0.title: "Steinziegel"
	quest.42000000001502D1.quest_desc: [
		"Bemooste Ziegelzier für die Plattform.",
		"So: Steinziegel plus Ranken oder Moos. Danach die Steinsäge."
	]
	quest.42000000001502D1.title: "Bemooste Steinziegel"
	quest.42000000001502D2.quest_desc: [
		"Verwitterte Steinziegel, abgenutzt und rissig.",
		"So: schmilz Steinziegel."
	]
	quest.42000000001502D2.title: "Rissige Steinziegel"
	quest.42000000001502D3.quest_desc: [
		"Gemeißelte Steinziegel für Zierleisten und Akzentlinien.",
		"So: zwei Steinziegelstufen, oder die Steinsäge."
	]
	quest.42000000001502D3.title: "Gemeißelte Steinziegel"
	quest.42000000001502D4.quest_desc: [
		"Eine flache, gleichmäßige Steinoberfläche für Böden.",
		"So: schmilz Stein. Stufen kommen aus der Steinsäge."
	]
	quest.42000000001502D4.title: "Glatter Stein"
	quest.42000000001502D5.quest_desc: [
		"Grauer Stein, glatt poliert.",
		"So: vier Andesit, oder die Steinsäge."
	]
	quest.42000000001502D5.title: "Polierter Andesit"
	quest.42000000001502D6.quest_desc: [
		"Heller weißer Stein, glatt poliert.",
		"So: vier Diorit, oder die Steinsäge."
	]
	quest.42000000001502D6.title: "Polierter Diorit"
	quest.42000000001502D7.quest_desc: [
		"Warmer rosa Stein, poliert fürs Detail.",
		"So: vier Granit, oder die Steinsäge."
	]
	quest.42000000001502D7.title: "Polierter Granit"
	quest.42000000001502D8.quest_desc: [
		"Gebrannte Tonblöcke, warmes Rot gegen grauen Stein.",
		"So: vier Ziegel. Tonklumpen schmelzen zu Ziegeln."
	]
	quest.42000000001502D8.title: "Ziegelsteine"
	quest.42000000001502D9.quest_desc: [
		"Blasser, fester Schlamm, geformt als Bauzier.",
		"So: vier Fester Schlamm. Schlamm ist Erde plus eine Wasserflasche; Schlamm und Weizen ergeben festen Schlamm."
	]
	quest.42000000001502D9.title: "Schlammziegel"
	quest.42000000001502DA.quest_desc: [
		"Dunkle Steinziegel aus der Tiefe geholt.",
		"So: polierter Tiefenschiefer im Quadrat, oder die Steinsäge. Vier Tiefenschieferkiesel (siebe Erde) ergeben Bruchtiefenschiefer."
	]
	quest.42000000001502DA.title: "Tiefenschieferziegel"
	quest.42000000001502DB.quest_desc: [
		"Glatte dunkle Fliesen für einen schlankeren Boden.",
		"So: Tiefenschieferziegel im Quadrat, oder die Steinsäge."
	]
	quest.42000000001502DB.title: "Tiefenschieferfliesen"
	quest.42000000001502DC.quest_desc: [
		"Dunkler Netherstein, stabil und schlicht.",
		"So: Hexenwasser in ein Lavafass gegossen, oder vier Schwarzsteinkiesel. Die Festen sind daraus gebaut."
	]
	quest.42000000001502DC.title: "Schwarzstein"
	quest.42000000001502DD.quest_desc: [
		"Schwarzstein, poliert zu einem glänzend dunklen Schimmer.",
		"So: vier Schwarzstein, oder die Steinsäge. Der Nether nach Klaue."
	]
	quest.42000000001502DD.title: "Polierter Schwarzstein"
	quest.42000000001502DE.quest_desc: [
		"Schwarzstein mit Gold gesprenkelt, selten und dekorativ.",
		"So: Nether-Bastion nach Klauen-Obsidian. Ein Endzweig der Dekoration, kein späteres Tor."
	]
	quest.42000000001502DE.title: "Vergoldeter Schwarzstein"
	quest.42000000001502DF.quest_desc: [
		"Hellweißer Block, ein Grundstoff fürs Plattformdekor.",
		"So: vier Netherquarz. Der Nether nach Klaue."
	]
	quest.42000000001502DF.title: "Quarzblock"
	quest.42000000001502E0.quest_desc: [
		"Quarz glatt geschliffen, für saubere Zierleisten.",
		"So: schmilz einen Quarzblock."
	]
	quest.42000000001502E0.title: "Glatter Quarz"
	quest.42000000001502E1.quest_desc: [
		"Violetter Endstein, ein eigenartiges Akzentstück.",
		"So: vier geplatzte Chorusfrüchte. Chorusfrucht ist der Stand der Randgänger."
	]
	quest.42000000001502E1.title: "Purpurblock"
	quest.42000000001502E2.quest_desc: [
		"Aus dem Meer geborener Stein, mit einem schwachen blauen Schimmer.",
		"So: braucht Prismarinscherben. Nur der Ozean. Nicht zwingend."
	]
	quest.42000000001502E2.title: "Prismarin"
	quest.42000000001502E3.quest_desc: [
		"Ein dunklerer Prismarin, gut für tiefe Akzente.",
		"So: braucht Prismarinscherben. Nur der Ozean. Nicht zwingend."
	]
	quest.42000000001502E3.title: "Dunkler Prismarin"
	quest.42000000001502E4.quest_desc: [
		"Ein stetiges Licht vom Meeresgrund.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502E4.title: "Seelaterne"
	quest.42000000001502E5.quest_desc: [
		"Ein warmes oranges Licht, gewachsen aus einem Netherpilz.",
		"So: wächst an Riesenpilzen. Pflanze einen Pilz auf Nylium und gib Knochenmehl drauf."
	]
	quest.42000000001502E5.title: "Pilzlicht"
	quest.42000000001502E6.quest_desc: [
		"Ein weiches gelbes Licht, ganz ohne Flamme.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502E6.title: "Ockerfroschlicht"
	quest.42000000001502E7.quest_desc: [
		"Ein blasses, leuchtendes Licht mit Perlmuttschimmer.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502E7.title: "Perlmuttfroschlicht"
	quest.42000000001502E8.quest_desc: [
		"Ein kühles grünes Licht, ohne Flamme und drinnen sicher.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502E8.title: "Grünfroschlicht"
	quest.42000000001502E9.quest_desc: [
		"Glas, das das Licht sperrt und die Sicht lässt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502E9.title: "Getöntes Glas"
	quest.42000000001502EA.quest_desc: [
		"Sanftes weißes Glas für mildes Fensterlicht.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502EA.title: "Weißes Glas"
	quest.42000000001502EB.quest_desc: [
		"Blassblaues Glas, nah am offenen Himmel.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502EB.title: "Hellblaues Glas"
	quest.42000000001502EC.quest_desc: [
		"Kühles türkises Glas für einen ruhigeren Raum.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502EC.title: "Türkises Glas"
	quest.42000000001502ED.quest_desc: [
		"Tiefviolettes Glas, ein Gruß an die Leere darunter.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502ED.title: "Violettes Glas"
	quest.42000000001502EE.quest_desc: [
		"Eine kleine stetige Flamme für Stimmungslicht.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502EE.title: "Kerze"
	quest.42000000001502EF.quest_desc: [
		"Eine blasse Kerze, dezent an hellen Wänden.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502EF.title: "Weiße Kerze"
	quest.42000000001502F0.quest_desc: [
		"Klettere sicher am Rand der Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F0.title: "Gerüstturm"
	quest.42000000001502F1.quest_desc: [
		"Leitern für senkrechte Plattformen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F1.title: "Leiternvorrat"
	quest.42000000001502F2.quest_desc: [
		"Schienen quer durch die Leere.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F2.title: "Ersatzschiene"
	quest.42000000001502F3.quest_desc: [
		"Hält dich über Wasser, falls die Plattform je Wasser trifft.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F3.title: "Eichenholzboot"
	quest.42000000001502F4.quest_desc: [
		"Dekor für die Wände der Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F4.title: "Ersatzgemälde"
	quest.42000000001502F5.quest_desc: [
		"Zeigt ein volles Rüstungsset auf der Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F5.title: "Rüstungsständer"
	quest.42000000001502F6.quest_desc: [
		"Hält einen ausgestellten Gegenstand, der nie dunkel wird.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F6.title: "Leuchtrahmen"
	quest.42000000001502F7.quest_desc: [
		"Blumentöpfe fürs Grün.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F7.title: "Ersatz-Blumentopf"
	quest.42000000001502F8.quest_desc: [
		"Hängeschilder für die Räume.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F8.title: "Hängeschild aus Eiche"
	quest.42000000001502F9.quest_desc: [
		"Webstuhl für die Bannerarbeit.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502F9.title: "Webstuhl"
	quest.42000000001502FA.quest_desc: [
		"Schneidet Stein in genaue Formen, ohne Verschnitt.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502FA.title: "Steinsäge"
	quest.42000000001502FB.quest_desc: [
		"Repariert Werkzeuge und nimmt Verzauberungen ab, die du nicht willst.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502FB.title: "Schleifstein"
	quest.42000000001502FC.quest_desc: [
		"Wertet Ausrüstung mit Schmiedevorlagen und Netherit auf.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502FC.title: "Schmiedetisch"
	quest.42000000001502FD.quest_desc: [
		"Zeichne das Raster der Insel.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502FD.title: "Kartentisch"
	quest.42000000001502FE.quest_desc: [
		"Ein Arbeitsplatz für Dorfbewohner, auf der Plattform meist nur Zierde.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502FE.title: "Bognertisch"
	quest.42000000001502FF.quest_desc: [
		"Schmilzt Erze doppelt so schnell wie ein normaler Ofen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001502FF.title: "Ersatz-Schmelzofen"
	quest.4200000000150300.quest_desc: [
		"Kocht Essen doppelt so schnell wie ein normaler Ofen.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000150300.title: "Ersatz-Räucherofen"
	quest.4200000000150301.quest_desc: [
		"Hält etwas Wasser, Farbstoff oder Trank.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000150301.title: "Kessel"
	quest.4200000000150302.quest_desc: [
		"Bewegt Gegenstände automatisch zwischen Behältern darunter und darüber.",
		"So: fünf Eisen um eine Truhe. Setz ihn unter einen Webrahmen oder ein Spannungsfass (entnimmt nach UNTEN)."
	]
	quest.4200000000150302.title: "Ersatz-Trichter"
	quest.4200000000150303.quest_desc: [
		"Schießt oder benutzt, was du hineinlädst.",
		"So: Bruchstein, Bogen und Redstone."
	]
	quest.4200000000150303.title: "Ersatz-Werfer"
	quest.4200000000150304.quest_desc: [
		"Gibt einen Redstone-Impuls, sobald der Block davor sich ändert.",
		"So: Bruchstein, Redstone und Netherquarz."
	]
	quest.4200000000150304.title: "Ersatz-Beobachter"
	quest.4200000000150305.quest_desc: [
		"Ein konstantes, starkes Redstone-Signal in Blockform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000150305.title: "Redstone-Block"
	quest.4200000000150306.quest_desc: [
		"Sendet eine Signalstärke danach, wie gut du ihn triffst.",
		"So: Redstone um Heu. Heu ist drei Weizen."
	]
	quest.4200000000150306.title: "Ersatz-Zielblock"
	quest.4200000000150307.quest_desc: [
		"Spielt eine Note, wenn du ihn schlägst oder er Strom bekommt. Stimm ihn von Hand.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000150307.title: "Ersatz-Notenblock"
	quest.4200000000150308.quest_desc: [
		"Spielt Musikplatten über die ganze Plattform.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.4200000000150308.title: "Ersatz-Plattenspieler"
	quest.4200000000150309.quest_desc: [
		"Die Glocke markiert den Clowder.",
		"So: kein Rezept. Das Ritual Wilden Geist kontaktieren von Occultism stellt einen her, braucht aber eine Ziege, und Ziegen erreichen die Plattform nie. Optional."
	]
	quest.4200000000150309.title: "Ersatzglocke"
	quest.420000000015030A.quest_desc: [
		"Setzt deinen Wiedereinstiegspunkt im Nether und lädt sich mit Glowstone.",
		"So: Weinender Obsidian plus Glowstone. Wiedereinstieg nur im Nether."
	]
	quest.420000000015030A.title: "Seelenanker"
	quest.420000000015030B.quest_desc: [
		"Bindet einen Kompass an genau diesen Block, statt an den Spawnpunkt.",
		"So: ein Netheritbarren in gemeißelten Steinziegeln. Später Luxus für den Clowder."
	]
	quest.420000000015030B.title: "Ersatz-Leitstein"
	quest.420000000015030C.quest_desc: [
		"Zieht Blitze sicher von der Plattform weg.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.420000000015030C.title: "Ersatz-Blitzableiter"
	quest.420000000015030D.quest_desc: [
		"Ein persönlicher Stauraum, der dir folgt, wohin du auch gehst.",
		"So: acht Obsidian um ein Ender-Auge. Das Auge ist Enderperle plus Lohenstaub."
	]
	quest.420000000015030D.title: "Endertruhe"
	quest.420000000015030E.quest_desc: [
		"Wird zur Shulker-Kiste für stapelbaren, sicheren Stauraum.",
		"So: Pack-Rezept, sechs Purpurblöcke, zwei Enderperlen und ein Bindungsknoten. Shulker erscheinen hier nie. Optional."
	]
	quest.420000000015030E.title: "Shulker-Schale"
	quest.420000000016030F.quest_desc: [
		"Boden und Wände, wo immer du über Lava baust.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: der Nether ist hier Leere, kein Gelände. Gieß Lava in ein Ex Deorum-Fass mit Hexenwasser (ein Wasserfass auf Myzel; Myzelsporen siebst du aus Erde)."
	]
	quest.420000000016030F.title: "Netherrack-Vorrat"
	quest.4200000000160310.quest_desc: [
		"Gebrannter Schlammstein, mit Quarz verstrebt. Hält die Form nahe am Feuer.",
		"So: schmelze Netherrack, dann vier Netherziegel-Gegenstände."
	]
	quest.4200000000160310.title: "Netherziegel"
	quest.4200000000160311.quest_desc: [
		"Netherwarze zu Ziegel gebacken. Wärmere Farbe, gleiche Stärke.",
		"So: Netherziegel plus Netherwarze. Nether nach Klaue."
	]
	quest.4200000000160311.title: "Rote Netherziegel"
	quest.4200000000160312.quest_desc: [
		"Abgekühlte Magmasäule, in Blöcke geschnitten als Tritt.",
		"So: Lava, die über Seelenerde neben blauem Eis fließt, oder vier Basaltkiesel aus gesiebtem zerkleinertem Schwarzstein."
	]
	quest.4200000000160312.title: "Basalt"
	quest.4200000000160313.quest_desc: [
		"Basalt glatt geschliffen. Liest sich als Stein, nicht als Gerüst.",
		"So: Steinsäge, oder vier Basalt."
	]
	quest.4200000000160313.title: "Polierter Basalt"
	quest.4200000000160314.quest_desc: [
		"Basalt ohne die Rippen. Gut für ebene Böden und Einfassungen.",
		"So: schmelze Basalt."
	]
	quest.4200000000160314.title: "Glatter Basalt"
	quest.4200000000160315.quest_desc: [
		"Der Bruchstein des Nether. Verarbeite ihn weiter zu Werkzeug und Ziegeln.",
		"So: Hexenwasser in ein Lavafass gegossen, oder vier Schwarzsteinkiesel. Die Festen sind daraus gebaut."
	]
	quest.4200000000160315.title: "Schwarzsteinvorrat"
	quest.4200000000160316.quest_desc: [
		"Erhitzt nahes Wasser bis zum Kochen und tut nackten Füßen weh.",
		"So: vier Magmacreme. Ein Schleimball in einem Lavafass gibt Creme."
	]
	quest.4200000000160316.title: "Magmablock"
	quest.4200000000160317.quest_desc: [
		"Seelensand-Vorrat als Tritt.",
		"So: Sand in ein Ex Deorum-Fass mit Hexenwasser. Die Warzenräume der Festung halten etwas. Drei Schädel auf Seelensand machen einen Wither."
	]
	quest.4200000000160317.title: "Seelensandvorrat"
	quest.4200000000160318.quest_desc: [
		"Lässt Seelenfeuer und Seelenfackeln brennen statt gewöhnlicher Flamme.",
		"So: Seelensand in ein Ex Deorum-Lavafass fallen lassen."
	]
	quest.4200000000160318.title: "Seelenerde"
	quest.4200000000160319.quest_desc: [
		"Zerdrückt zu vier Staub, oder leuchtet einen Raum ohne Rauch aus.",
		"So: vier Glowstone-Staub. Den Staub siebst du aus Seelensand."
	]
	quest.4200000000160319.title: "Glowstone"
	quest.420000000016031A.quest_desc: [
		"Ein Pilz, der von allein leuchtet. Keine Leitung nötig.",
		"So: wächst an Riesenpilzen. Pflanze einen Pilz auf Nylium und gib Knochenmehl drauf."
	]
	quest.420000000016031A.title: "Pilzlichtvorrat"
	quest.420000000016031B.quest_desc: [
		"Neun Netherwarzen, zu einem Block gebündelt. Meist Dekoration und Farbstoff.",
		"So: neun Netherwarzen. Warzen siebst du aus Seelensand, oder sie wachsen in den Gärten der Festung."
	]
	quest.420000000016031B.title: "Netherwarzenblock"
	quest.420000000016031C.quest_desc: [
		"Der blaue Vetter des karmesinroten Blocks. Gleiches Rezept, kühlere Farbe.",
		"So: wächst an riesigen Wirrpilzen. Gib Knochenmehl auf einen Wirrpilz auf Wirr-Nezel."
	]
	quest.420000000016031C.title: "Wirrwarzenblock"
	quest.420000000016031D.quest_desc: [
		"Holz, das kein Holz ist. Lässt sich entrinden und zu Brettern machen wie jeder Stamm.",
		"So: Sporen von Karmesin-Nezel (zerkleinerten Netherrack sieben) auf Netherrack, Knochenmehl aufs Nezel für einen Pilz, dann Knochenmehl auf den Pilz."
	]
	quest.420000000016031D.title: "Karmesinstiel"
	quest.420000000016031E.quest_desc: [
		"Der andere Pilzstamm. Die Bretter kommen blau heraus, nicht rot.",
		"So: Sporen von Wirr-Nezel (zerkleinerten Netherrack sieben) auf Netherrack, Knochenmehl aufs Nezel für einen Pilz, dann Knochenmehl auf den Pilz."
	]
	quest.420000000016031E.title: "Wirrstiel"
	quest.420000000016031F.quest_desc: [
		"Kette für hängenden Schmuck.",
		"So: Karmesinwälder nach Klaue. Hängen von der Decke."
	]
	quest.420000000016031F.title: "Trauerranken"
	quest.4200000000160320.quest_desc: [
		"Klettert einen Wirrwald hinauf und markiert einen Halt im Dunst.",
		"So: Wirrwälder nach Klaue. Wachsen vom Nezel nach oben."
	]
	quest.4200000000160320.title: "Zwirbelranken"
	quest.4200000000160321.quest_desc: [
		"Weint violettes Licht und verankert einen Wiedereinstieg im Nether.",
		"So: Bastionstruhen, Tausch mit Piglins oder Draconic-Bienen an Obsidian. Ruinenportale entstehen hier nicht."
	]
	quest.4200000000160321.title: "Weinender Obsidian"
	quest.4200000000160322.quest_desc: [
		"Vergraben unter den gewöhnlichen Erzen. Schmelze ihn Richtung Netherit.",
		"So: hämmere Schwarzstein zu zerkleinertem Schwarzstein und siebe ihn. Bastionstruhen halten ein wenig."
	]
	quest.4200000000160322.title: "Antiker Schrott"
	quest.4200000000160323.quest_desc: [
		"Vier Netheritschrott und vier Goldbarren ergeben einen Netheritbarren.",
		"So: schmelze antiken Schrott. Vier Schrott plus Gold ergeben einen Barren."
	]
	quest.4200000000160323.title: "Netheritschrott"
	quest.4200000000160324.quest_desc: [
		"Das härteste Metall, das eine Skybound-Hand je halten wird.",
		"So: vier Schrott plus vier Gold. Antiker Schrott ist seltener Nether nach Klaue."
	]
	quest.4200000000160324.title: "Netheritbarren"
	quest.4200000000160325.quest_desc: [
		"Befeuert Braustände und Schmelzöfen zugleich. Halt einen Stapel übrig.",
		"So: Netherfestung nach Obsidian aus Klaue. Das Brauen will eine Rute; Ars und Occultism warten nicht darauf."
	]
	quest.4200000000160325.title: "Lohenruten-Vorrat"
	quest.4200000000160326.quest_desc: [
		"Der Regenerationstrank braucht eine, und Geduld nahe einem Ghast.",
		"So: Nether-Ghasts nach Klauen-Obsidian."
	]
	quest.4200000000160326.title: "Ghastträne"
	quest.4200000000160327.quest_desc: [
		"Wird zu Feuerresistenz gebraut oder wieder zu einem Magmablock gefertigt.",
		"So: ein Schleimball in ein Lavafass geworfen, Schleim plus Lohenstaub, oder Magmawürfel."
	]
	quest.4200000000160327.title: "Magmacreme"
	quest.4200000000160328.quest_desc: [
		"Drei beschwören einen Wither. Einer steht auch gut im Regal.",
		"So: Netherfestung nach Obsidian aus Klaue. Drei Schädel starten einen Wither."
	]
	quest.4200000000160328.title: "Witherskelettschädel"
	quest.4200000000160329.quest_desc: [
		"Piglins tauschen gegen Gold. Klumpen tun es so gut wie Barren.",
		"So: ein Barren ergibt neun, oder Nether-Golderz."
	]
	quest.4200000000160329.title: "Goldklumpenhaufen"
	quest.420000000016032A.quest_desc: [
		"Schmilzt zu Gold und lässt sich schneller abbauen als das Erz, nach dem es benannt ist.",
		"So: Mekanism-Kombinierer, acht Rohgold plus Netherrack. Der leere Nether hat kein Erz."
	]
	quest.420000000016032A.title: "Nether-Golderz"
	quest.420000000016032B.quest_desc: [
		"Hellweißer Stein, der baut und zugleich Komparatorsignale leitet.",
		"So: siebe Seelensand, oder Tausch mit Piglins."
	]
	quest.420000000016032B.title: "Quarz"
	quest.420000000016032C.quest_desc: [
		"Geworfen zündet sie ein Feuer. In einen Werfer geladen, auch.",
		"So: Lohenstaub, Kohle und Schießpulver."
	]
	quest.420000000016032C.title: "Feuerkugel"
	quest.4200000000178001.quest_desc: [
		"Zwölf Portalrahmen sind kein Plattform-Rezept, also ist das End nur einen Bissen entfernt.",
		"Iss es, um auf der Obsidian-Plattform des Ends zu stehen; iss die Hälfte, die bleibt, um nach Hause zu kommen, an die Stelle, von der du gegessen hast.",
		"So: fünf Enderperlen, zwei Knochen und zwei Lohenstaub an der Werkbank."
	]
	quest.4200000000178001.title: "Endapfel"
	quest.420000000017032D.quest_desc: [
		"Blasser Stein von der fernen Seite. Schwer, schlicht und endlos.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Chorusfrucht und Enderperlen (Stand der Randgänger) um einen Bindungsknoten. Ergibt acht. Die End-Insel ist weg."
	]
	quest.420000000017032D.title: "Endstein"
	quest.420000000017032E.quest_desc: [
		"Endstein quadratisch geschnitten, für sauberere Linien auf einer End-Plattform.",
		"So: vier Endstein im Quadrat, oder die Steinsäge. Endstein ist das Knoten-Rezept."
	]
	quest.420000000017032E.title: "Endsteinziegel"
	quest.420000000017032F.quest_desc: [
		"Aus Chorusfrucht gezogen, dann zu Baustein gebacken.",
		"So: vier geplatzte Chorusfrüchte. Chorusfrucht ist der Stand der Randgänger."
	]
	quest.420000000017032F.title: "Purpurblockvorrat"
	quest.4200000000170330.quest_desc: [
		"Purpur mit Säulenmuster, ausgerichtet, wie du es setzt.",
		"So: zwei Purpurstufen, oder die Steinsäge. Zuerst geplatzte Chorusfrucht."
	]
	quest.4200000000170330.title: "Purpursäule"
	quest.4200000000170331.quest_desc: [
		"Ein kaltes Licht, das nie flackert und zugleich als Schienenpfosten dient.",
		"So: Lohenrute plus geplatzte Chorusfrucht. Nether nach Klaue; Chorus ist der Stand der Randgänger."
	]
	quest.4200000000170331.title: "Endstab"
	quest.4200000000170332.quest_desc: [
		"Iss sie, und du teleportierst dich einen kurzen, unberechenbaren Sprung.",
		"So: Stand der Randgänger bei /clowder hub. Die äußeren End-Inseln sind weg."
	]
	quest.4200000000170332.title: "Chorusfrucht"
	quest.4200000000170333.quest_desc: [
		"Chorusfrucht gekocht. Wird zu Purpur und Farbstoffen, ohne dich zu teleportieren.",
		"So: schmelze Chorusfrucht vom Stand der Randgänger."
	]
	quest.4200000000170333.title: "Geplatzte Chorusfrucht"
	quest.4200000000170334.quest_desc: [
		"Wirf sie, und du kommst an, wo sie landet, abzüglich etwas Leben.",
		"So: Endermen, oder der Stand der Randgänger bei /clowder hub."
	]
	quest.4200000000170334.title: "Enderperlenvorrat"
	quest.4200000000170335.quest_desc: [
		"Vorrat an Enderaugen.",
		"So: Enderperle (Stand der Randgänger / Endermen) plus Lohenstaub aus einer Netherfestung nach Obsidian aus Klaue. Ein Vorrat von acht Augen ist optional; Enderkristalle nutzen dasselbe Rezept."
	]
	quest.4200000000170335.title: "Enderaugen-Vorrat"
	quest.4200000000170336.quest_desc: [
		"Drachenatem für Tränke.",
		"So: Glasflasche auf den Drachen. Die End-Insel ist weg. Optional."
	]
	quest.4200000000170336.title: "Drachenatemvorrat"
	quest.4200000000170337.quest_desc: [
		"Die einzige Trophäe des Drachen. Es sitzt nie still, wenn man klickt.",
		"Seltene Belohnung: ein geteiltes Clowder-Leben, einmal für das ganze Team. Nur sechs solche Belohnungen gibt es in der Kampagne.",
		"So: der Drache ist mit der End-Insel weg. Optionale Trophäe — sie sperrt die Endertruhen nicht."
	]
	quest.4200000000170337.title: "Drachenei-Schau"
	quest.4200000000170338.quest_desc: [
		"Elytren für die Reise durch den Himmel.",
		"Optional — die Leere bietet dir vielleicht nie einen.",
		"So: die Endstädte sind weg. Optional."
	]
	quest.4200000000170338.title: "Elytren-Schau"
	quest.4200000000170339.quest_desc: [
		"Shulkerpanzer für Kisten.",
		"Optional — hier gibt es keine Shulker, also fertigt das Pack die Panzer.",
		"So: Pack-Rezept, sechs Purpurblöcke, zwei Enderperlen und ein Bindungsknoten. Shulker erscheinen hier nie. Optional."
	]
	quest.4200000000170339.title: "Shulkerpanzervorrat"
	quest.420000000017033A.quest_desc: [
		"Eine tragbare Truhe, die den Inhalt behält, wenn du sie abbaust.",
		"Optional — die Randgänger in der Clowder-Halle verkaufen eine.",
		"So: zwei Shulkerpanzer um eine Truhe (die Panzer sind ein Pack-Rezept), oder der Stand der Randgänger bei /clowder hub für 22 Fadendocken (198 Faden). Optional."
	]
	quest.420000000017033A.title: "Shulkerkisten-Schau"
	quest.420000000017033B.quest_desc: [
		"Enderkristalle — vorsichtig anfassen.",
		"So: Glas, Enderauge, Ghastträne. Nether nach Obsidian aus Klaue; das Ei ist optional."
	]
	quest.420000000017033B.title: "Enderkristall-Schau"
	quest.420000000017033C.quest_desc: [
		"Jede Endertruhe auf jeder Plattform teilt sich einen verborgenen Speicher.",
		"So: acht Obsidian um ein Ender-Auge. Das Auge ist Enderperle plus Lohenstaub."
	]
	quest.420000000017033C.title: "Endertruhen-Schau"
	quest.420000000017033D.quest_desc: [
		"Pflanze sie auf Endstein, dann wächst Chorusfrucht nach oben.",
		"So: die äußeren End-Inseln sind weg. Chorusfrucht gibt es am Stand der Randgänger. Optional."
	]
	quest.420000000017033D.title: "Chorusblume"
	quest.420000000017033E.quest_desc: [
		"Zwölf davon, mit Augen gefüllt, öffnen den Weg ins End.",
		"So: kein Rezept der Plattform. Optional."
	]
	quest.420000000017033E.title: "Endportalrahmen"
	quest.420000000017033F.quest_desc: [
		"Fest gewordenes Betonpulver. Finster wie die Leere, und dauerhaft, sobald es aushärtet.",
		"So: Betonpulver plus Wasser. Das Pulver ist Sand, Kies und Farbstoff."
	]
	quest.420000000017033F.title: "Schwarzer Beton"
	quest.4200000000170340.quest_desc: [
		"Eine laute Akzentfarbe für ein stilles, blasses Biom.",
		"So: Betonpulver plus Wasser. Das Pulver ist Sand, Kies und Farbstoff."
	]
	quest.4200000000170340.title: "Violetter Beton"
	quest.4200000000170341.quest_desc: [
		"Bei Kontakt mit Wasser abgekühlte Lava. Explosionssicher, langsam abzubauen.",
		"So: Wasser auf eine Lavaquelle (oder Lava auf Wasser). Behalte die Lavaquelle."
	]
	quest.4200000000170341.title: "Obsidianvorrat"
	quest.4200000000170342.quest_desc: [
		"Leuchtet schwach und schleudert dich, geladen, von einem Seelenanker.",
		"So: Bastionstruhen, Tausch mit Piglins oder Draconic-Bienen an Obsidian. Ruinenportale entstehen hier nicht."
	]
	quest.4200000000170342.title: "Vorrat weinenden Obsidians"
	quest.4200000000170343.quest_desc: [
		"Lade ihn mit Glowstone, um einen Wiedereinstieg im Nether zu setzen.",
		"So: Weinender Obsidian plus Glowstone. Wiedereinstieg nur im Nether."
	]
	quest.4200000000170343.title: "Seelenanker-Schau"
	quest.4200000000170344.quest_desc: [
		"In der Nebenhand gehalten, fängt es einen sonst tödlichen Treffer ab.",
		"So: nur Aufgabenbelohnungen. Uhr einsetzen und Siegel einsetzen geben je eines, und die Gaben der späten Strangknoten bieten mehr. Überfälle und Magier kommen nie zur Plattform. Optional."
	]
	quest.4200000000170344.title: "Totem-Schau"
	quest.4200000000170345.quest_desc: [
		"Der einzige Drop des Withers. Ein Leuchtfeuer braucht einen, um zu leuchten.",
		"So: Wither (drei Schädel auf Seelensand), oder der Stand der Trommelherzen bei /clowder hub einmal, für 12 Fadenballen (972 Faden). Optionale Trophäe — sie sperrt weder das End noch die Monsterfarm zu 100%."
	]
	quest.4200000000170345.title: "Netherstern-Schau"
	quest.4200000000170346.quest_desc: [
		"Von einer Pyramide aus Mineralblöcken gespeist, gewährt es Boni, solange du in seinem Bereich stehst.",
		"So: Netherstern, Glas und Obsidian. Optionale Trophäe — die Ozean-Zweige hängen am Obsidianvorrat."
	]
	quest.4200000000170346.title: "Leuchtfeuer-Schau"
	quest.4200000000170347.quest_desc: [
		"Von Prismarin umgeben, gewährt er unter Wasser Unterwasseratmung und Eile.",
		"Optional — die Leere bietet dir vielleicht nie einen.",
		"So: braucht Herz des Meeres und Nautilus. Nur Ozean. Optional."
	]
	quest.4200000000170347.title: "Aquisator-Schau"
	quest.4200000000170348.quest_desc: [
		"Acht umringen einen Aquisator, und eine wird zum Kompass des Meeres.",
		"Optional — die Leere bietet dir vielleicht nie einen.",
		"So: nur Ozean. Optional."
	]
	quest.4200000000170348.title: "Nautilusschale"
	quest.4200000000170349.quest_desc: [
		"Ein seltener Drop eines Ertrunkenen. Wirf ihn, oder lenke im Sturm einen Blitz.",
		"So: nur Ertrunkene. Optional."
	]
	quest.4200000000170349.title: "Dreizack-Schau"
	quest.420000000018034A.quest_desc: [
		"Basisessenz. Speist Wachstumsbeschleuniger wie Wiederaufbereiter.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018034A.title: "Inferiumvorrat"
	quest.420000000018034B.quest_desc: [
		"Ein unfertiger Samen. Braucht Essenz, bevor etwas wächst.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018034B.title: "Prosperity-Basis"
	quest.420000000018034C.quest_desc: [
		"Einmal verbraucht, hebt er Essenz auf die nächste Stufe.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018034C.title: "Infusionskristall"
	quest.420000000018034D.quest_desc: [
		"Essenz der zweiten Stufe, veredelt aus Stapeln Inferium.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018034D.title: "Prudentiumvorrat"
	quest.420000000018034E.quest_desc: [
		"Essenz der dritten Stufe, eine Sprosse über Prudentium.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018034E.title: "Tertiumvorrat"
	quest.420000000018034F.quest_desc: [
		"Essenz der vierten Stufe, nah an der Spitze der Kette.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018034F.title: "Imperiumvorrat"
	quest.4200000000180350.quest_desc: [
		"Essenz der fünften Stufe, fast so veredelt, wie es nur geht.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180350.title: "Supremiumvorrat"
	quest.4200000000180351.quest_desc: [
		"Die veredelte Spitze. Nötig für die stärkste Ausrüstung und die stärksten Samen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180351.title: "Erweckte Essenz"
	quest.4200000000180352.quest_desc: [
		"Das Kernstück, das Essenz in ihre Endform erweckt.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180352.title: "Erweckungsaltar"
	quest.4200000000180353.quest_desc: [
		"Umringle den Altar damit, um die Erweckung zu vollenden.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180353.title: "Erweckungssockel"
	quest.4200000000180354.quest_desc: [
		"Ein Infusionskristall, dem nie die Ladungen ausgehen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180354.title: "Meisterkristall"
	quest.4200000000180355.quest_desc: [
		"Lagert Essenz in Menge, damit die Maschinen nie trockengehen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180355.title: "Essenzurne"
	quest.4200000000180356.quest_desc: [
		"Das Grundteil jeder Maschine, die mit Essenz läuft.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180356.title: "Maschinengehäuse"
	quest.4200000000180357.quest_desc: [
		"Passt auf Pflanzen in der Nähe auf und bricht sie, sobald sie reif sind.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180357.title: "Ernter"
	quest.4200000000180358.quest_desc: [
		"Macht aus übrigem Samen wieder Essenz, statt Gerümpel.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180358.title: "Samenrecycler"
	quest.4200000000180359.quest_desc: [
		"Beschleunigt Pflanzen in der Nähe mit Inferium-Essenz.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180359.title: "Inferium-Beschleuniger"
	quest.420000000018035A.quest_desc: [
		"Ein stärkerer Beschleuniger, eine Stufe über Inferium.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018035A.title: "Prudentium-Beschleuniger"
	quest.420000000018035B.quest_desc: [
		"Beschleunigung der Mittelstufe für ein geschäftigeres Feld.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018035B.title: "Tertium-Beschleuniger"
	quest.420000000018035C.quest_desc: [
		"Nahe der Spitze der Wachstumsgeschwindigkeit.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018035C.title: "Imperium-Beschleuniger"
	quest.420000000018035D.quest_desc: [
		"Der schnellste Beschleuniger, den Essenz bauen kann.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018035D.title: "Supremium-Beschleuniger"
	quest.420000000018035E.quest_desc: [
		"Ein schlichter Wasserschwall für durstige Pflanzen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018035E.title: "Gießkanne"
	quest.420000000018035F.quest_desc: [
		"Eine mit Inferium infundierte Gießkanne, mit weiterer Reichweite.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018035F.title: "Inferium-Gießkanne"
	quest.4200000000180360.quest_desc: [
		"Bewässert pro Einsatz mehr Pflanzen als die einfache Kanne.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180360.title: "Prudentium-Gießkanne"
	quest.4200000000180361.quest_desc: [
		"Eine Kanne der Mittelstufe mit spürbar breiterem Schwall.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180361.title: "Tertium-Gießkanne"
	quest.4200000000180362.quest_desc: [
		"Wässert in einem Zug ein breites Stück Feld.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180362.title: "Imperium-Gießkanne"
	quest.4200000000180363.quest_desc: [
		"Der breiteste Schwall, den eine Gießkanne schafft.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180363.title: "Supremium-Gießkanne"
	quest.4200000000180364.quest_desc: [
		"Beschleunigt das Wachstum, wenn du sie auf gesetzte Pflanzen wirfst.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180364.title: "Düngeressenz"
	quest.4200000000180365.quest_desc: [
		"Der Staub, aus dem Souliumbarren werden. Ein Bestandteil für feindliche Samen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180365.title: "Seelenstaub"
	quest.4200000000180366.quest_desc: [
		"Soulium-Staub, an einen Prosperity-Barren gebunden, dunkel und ein wenig kalt.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180366.title: "Seelenbarren"
	quest.4200000000180367.quest_desc: [
		"Aus Soulium gefertigt. Fügt feindlichen Kreaturen zusätzlichen Schaden zu.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180367.title: "Seelendolch"
	quest.4200000000180368.quest_desc: [
		"Der unfertige Samen, um feindliche Kreaturen zu züchten.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180368.title: "Seelensamenbasis"
	quest.4200000000180369.quest_desc: [
		"Zieh Redstone-Staub, statt ihn abzubauen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180369.title: "Redstone-Samen (Felder)"
	quest.420000000018036A.quest_desc: [
		"Ein Feld voller Blau, statt einer Höhle voll davon.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018036A.title: "Lapislazulisamen (Felder)"
	quest.420000000018036B.quest_desc: [
		"Lässt Diamanten an einem Stängel wachsen, statt unter der Erde.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018036B.title: "Diamantsamen (Felder)"
	quest.420000000018036C.quest_desc: [
		"Bringt Smaragde ein, ohne einen einzigen Handel mit Dorfbewohnern.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018036C.title: "Smaragdsamen"
	quest.420000000018036D.quest_desc: [
		"Lässt Obsidian wachsen, ohne dass ein Wassereimer in Sicht ist.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018036D.title: "Obsidiansamen (Felder)"
	quest.420000000018036E.quest_desc: [
		"Bringt Quarz ein, ohne den Nether zu betreten.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018036E.title: "Netherquarz-Samen (Felder)"
	quest.420000000018036F.quest_desc: [
		"Lässt Licht wachsen, ohne einen Abstecher zur Netherdecke.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018036F.title: "Glowstone-Samen (Felder)"
	quest.4200000000180370.quest_desc: [
		"Die seltenste Frucht. Lässt Schrott wachsen, hin zum härtesten Metall.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180370.title: "Netheritsamen"
	quest.4200000000180371.quest_desc: [
		"Bringt Amethystsplitter ein, ohne eine einzige Geode.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180371.title: "Amethystsamen"
	quest.4200000000180372.quest_desc: [
		"Lässt Honigflaschen wachsen, ohne einen einzigen Stich.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180372.title: "Honigsamen"
	quest.4200000000180373.quest_desc: [
		"Bringt Prismarin ein, ohne ein Ozeanmonument in der Nähe.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180373.title: "Prismarinsamen"
	quest.4200000000180374.quest_desc: [
		"Lässt Basaltsäulen wachsen, ohne einen Abstecher in den Nether.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180374.title: "Basaltsamen"
	quest.4200000000180375.quest_desc: [
		"Eine Allzweckpflanze für Nether-Ressourcen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180375.title: "Nether-Samen"
	quest.4200000000180376.quest_desc: [
		"Eine Allzweckpflanze für Ressourcen des Endes.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180376.title: "End-Samen"
	quest.4200000000180377.quest_desc: [
		"Zieht Himmelsstein für ein Netzwerk, das ihn braucht.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180377.title: "Himmelsstein-Samen"
	quest.4200000000180378.quest_desc: [
		"Erntet Certusquarz für Kristallwachstum und Herstellung.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180378.title: "Certus-Samen"
	quest.4200000000180379.quest_desc: [
		"Zieht Fluixkristalle für Netzwerkbauteile.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180379.title: "Fluix-Samen"
	quest.420000000018037A.quest_desc: [
		"Erntet Silizium für Prozessoren und Schaltkreise.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018037A.title: "Siliziumsamen"
	quest.420000000018037B.quest_desc: [
		"Zieht Stahl, ohne dass ein einziger Ofen läuft.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018037B.title: "Stahlsamen"
	quest.420000000018037C.quest_desc: [
		"Erntet Osmium für frühe Legierungsarbeit.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018037C.title: "Osmiumsamen"
	quest.420000000018037D.quest_desc: [
		"Zieht Zinn für Bronze und einfache Legierungen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018037D.title: "Zinnsamen"
	quest.420000000018037E.quest_desc: [
		"Erntet Aluminium für leichte Legierungsbauteile.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018037E.title: "Aluminiumsamen"
	quest.420000000018037F.quest_desc: [
		"Zieht Uran. Geh mit dem Erz etwas vorsichtig um.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018037F.title: "Uransamen"
	quest.4200000000180380.quest_desc: [
		"Erntet Uraninit, später als Reaktorbrennstoff.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180380.title: "Uraninit-Samen"
	quest.4200000000180381.quest_desc: [
		"Zieht Flaschenerfahrung, statt sie aus Monstern zu schleifen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180381.title: "Erfahrungs-Samen"
	quest.4200000000180382.quest_desc: [
		"Erntet Schleimbälle, ohne nachts in einem Sumpf zu jagen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180382.title: "Schleimsamen"
	quest.4200000000180383.quest_desc: [
		"Zieht Lohenruten, ohne einen Abstecher in eine Festung.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180383.title: "Lohensamen"
	quest.4200000000180384.quest_desc: [
		"Erntet Ghasttränen, ohne über Lava zu schweben.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180384.title: "Ghast-Samen"
	quest.4200000000180385.quest_desc: [
		"Zieht Enderperlen, ohne einen einzigen Enderman zu reizen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180385.title: "Enderman-Samen"
	quest.4200000000180386.quest_desc: [
		"Erntet Wither-Skelettschädel aus viel sicherer Entfernung.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180386.title: "Wither-Skelett-Samen"
	quest.4200000000180387.quest_desc: [
		"Zieht Leder, ohne eine einzige Kuh zu halten.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180387.title: "Kuhsamen"
	quest.4200000000180388.quest_desc: [
		"Erntet Wolle in jeder Farbstofffarbe auf einmal.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180388.title: "Schafsamen"
	quest.4200000000180389.quest_desc: [
		"Zieht Federn, ohne einen Hühnerstall zu führen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180389.title: "Huhnsamen"
	quest.420000000018038A.quest_desc: [
		"Erntet Schweinekoteletts, ohne ein einziges Schwein zu halten.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018038A.title: "Schweinesamen"
	quest.420000000018038B.quest_desc: [
		"Zieht Knochen, ohne eine Nacht lang Skelette zu bekämpfen.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018038B.title: "Skelettsamen"
	quest.420000000018038C.quest_desc: [
		"Erntet verrottetes Fleisch, vor allem für den Komposter.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018038C.title: "Zombie-Samen"
	quest.420000000018038D.quest_desc: [
		"Zieht Schwarzpulver ohne das Risiko einer Explosion.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018038D.title: "Creeper-Samen"
	quest.420000000018038E.quest_desc: [
		"Wächst auf einer mystischen Pflanze, statt unter der Erde.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018038E.title: "Eisenessenz"
	quest.420000000018038F.quest_desc: [
		"Eine vergoldete Pflanze, die Goldessenz fallen lässt statt Korn.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.420000000018038F.title: "Goldessenz"
	quest.4200000000180390.quest_desc: [
		"Die härteste Pflanze auf dem Hof, ganz wörtlich.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180390.title: "Diamantessenz"
	quest.4200000000180391.quest_desc: [
		"Zieht Brennstoff auf einer Pflanze, statt in einem Flöz.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180391.title: "Kohleessenz"
	quest.4200000000180392.quest_desc: [
		"Zieht Kupfer auf einer Pflanze, statt in einer Ader.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180392.title: "Kupferessenz"
	quest.4200000000180393.quest_desc: [
		"Zieht Staub auf einer Pflanze, statt unter der Erde.",
		"So: Mystical Agriculture-Rezept in JEI. Inferium und Prosperity kommen aus dem Sieb; Samen werden am Infusionsaltar infundiert."
	]
	quest.4200000000180393.title: "Redstone-Essenz"
	quest.4200000000190394.quest_desc: [
		"Zeigt auf Nester, die du gesetzt und vergessen hast.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.4200000000190394.title: "Nest Locator"
	quest.4200000000190395.quest_desc: [
		"Birkenstämme um eine Blume: Holzbienen in einer anderen Farbe.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000190395.title: "Birkenring"
	quest.4200000000190396.quest_desc: [
		"Fichte um eine Blume: Harzbienen.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000190396.title: "Fichtenring"
	quest.4200000000190397.quest_desc: [
		"Schwarzeiche um eine Blume: blaubandige Bienen.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000190397.title: "Schwarzeichenring"
	quest.4200000000190398.quest_desc: [
		"Glowstone um eine Blume: Bienen, die leuchten.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000190398.title: "Glowstone-Ring"
	quest.4200000000190399.quest_desc: [
		"Quarz um eine Blume: kristalline Bienen, die Wurzel der Erzlinien.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.4200000000190399.title: "Quarzring"
	quest.420000000019039A.quest_desc: [
		"Netherziegel um eine Blume: magmatisch.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.420000000019039A.title: "Netherziegelring"
	quest.420000000019039B.quest_desc: [
		"Seelensand um eine Blume: geisterhaft.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.420000000019039B.title: "Seelensandring"
	quest.420000000019039C.quest_desc: [
		"Endstein um eine Blume: Enderbienen, und das ferne Ende der Zucht.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.420000000019039C.title: "Endsteinring"
	quest.420000000019039D.quest_desc: [
		"Obsidian um eine Blume: drakonisch. Frag nicht, was es frisst.",
		"So: Ring aus dem Nestmaterial um eine kleine Blume. Setze ihn, dann Rechtsklick mit einer kleinen Blume, um ihn zu wecken; die Bienen kommen nach einer Weile heraus."
	]
	quest.420000000019039D.title: "Obsidianring"
	quest.420000000019039E.quest_desc: [
		"Ein richtiger Bienenstock, mit mehr Plätzen als ein wildes Nest.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.420000000019039E.title: "Fortgeschrittener Eichenbienenstock"
	quest.420000000019039F.quest_desc: [
		"Schraubt sich an einen Stock, damit die Bienen mehr Wohnraum haben.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.420000000019039F.title: "Erweiterungskiste (Bienenhaus)"
	quest.42000000001903A0.quest_desc: [
		"Fängt eine Biene in Glas, damit du sie tragen kannst.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A0.title: "Eichenglas"
	quest.42000000001903A1.quest_desc: [
		"Sperr Bienen ein, um Stöcke zu versetzen.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A1.title: "Bienenkäfig (Bienenhaus)"
	quest.42000000001903A2.quest_desc: [
		"Hält eine Biene sicher für den Transport zwischen Plattformen.",
		"So: nur in Dorftruhen, und die Leere hat keine Dörfer. Optional."
	]
	quest.42000000001903A2.title: "Robuster Käfig"
	quest.42000000001903A3.quest_desc: [
		"Schöpft Bienen automatisch in Gläser, kein Netz nötig.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A3.title: "Fänger (Bienenhaus)"
	quest.42000000001903A4.quest_desc: [
		"Hält einen Stock satt, damit die Bienen weiterarbeiten.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A4.title: "Futterspender"
	quest.42000000001903A5.quest_desc: [
		"Füllt Flaschen aus dem gespeicherten Honig eines Stocks.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A5.title: "Abfüller (Bienenhaus)"
	quest.42000000001903A6.quest_desc: [
		"Schleudert die Honigwabe auseinander in Honig, Wachs und Waben.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A6.title: "Zentrifuge (Bienenhaus)"
	quest.42000000001903A7.quest_desc: [
		"Eine Zentrifuge, die von allein dreht, sobald sie Energie hat.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A7.title: "Energiezentrifuge (Bienenhaus)"
	quest.42000000001903A8.quest_desc: [
		"Dreht schneller, wenn eine Hitzequelle sie speist.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A8.title: "Heated Centrifuge"
	quest.42000000001903A9.quest_desc: [
		"Lässt Bienenlarven zu neuen Bienen mit nützlichen Merkmalen schlüpfen.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903A9.title: "Inkubator (Bienenhaus)"
	quest.42000000001903AA.quest_desc: [
		"Paart zwei Bienen und erzeugt Nachwuchs mit gemischten Merkmalen.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903AA.title: "Zuchtkammer (Bienenhaus)"
	quest.42000000001903AB.quest_desc: [
		"Liest die Merkmale einer Biene und notiert sie für die Zucht.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903AB.title: "Genindex (Bienenhaus)"
	quest.42000000001903AC.quest_desc: [
		"Verbrennt Honig für ein langsames, stetiges Rinnsal an Energie.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903AC.title: "Honiggenerator (Bienenhaus)"
	quest.42000000001903AD.quest_desc: [
		"Ein Snack, der eine Biene im Käfig ruhig und gesund hält.",
		"So: Honigwabe plus eine Honigflasche, formlos."
	]
	quest.42000000001903AD.title: "Honigleckerei (Bienenhaus)"
	quest.42000000001903AE.quest_desc: [
		"Ein voller Eimer Honig, bereit zum Ausgießen oder Verbrennen.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903AE.title: "Honey Bucket"
	quest.42000000001903AF.quest_desc: [
		"Schmilzt für Kerzen, oder versiegelt den Rahmen eines Stocks.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903AF.title: "Wachsvorrat"
	quest.42000000001903B0.quest_desc: [
		"Eine Honigwabe, die sich auf jede Biene abstimmen lässt.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903B0.title: "Einstellbare Wabe"
	quest.42000000001903B1.quest_desc: [
		"Die Merkmale einer Biene, entnommen und bereit zum Abfüllen.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903B1.title: "Gene Sample"
	quest.42000000001903B2.quest_desc: [
		"Die Genetik einer Biene, gelagert für spätere Zucht.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903B2.title: "Genflasche"
	quest.42000000001903B3.quest_desc: [
		"Vier fest gepresste Waben, vor allem zum Bauen.",
		"So: vier Honigwaben."
	]
	quest.42000000001903B3.title: "Honigwabenblock"
	quest.42000000001903B4.quest_desc: [
		"Verlangsamt Stürze und Bewegung. Klebrig unter den Füßen, süß im Trichter.",
		"So: vier Honigflaschen. Die Flaschen kommen zurück."
	]
	quest.42000000001903B4.title: "Honigblock (Bienenhaus)"
	quest.42000000001903B5.quest_desc: [
		"Ein wilder Bienenstock. Beräuchere ihn bis zur Ruhe, bevor du die Wabe nimmst.",
		"So: drei Honigwaben und sechs Bretter. Ein Lagerfeuer darunter beruhigt sie."
	]
	quest.42000000001903B5.title: "Basis-Bienenstock"
	quest.42000000001903B6.quest_desc: [
		"Rauch von unten hält die Bienen bei der Ernte ruhig.",
		"So: Stämme, Stöcke und Kohle oder Holzkohle."
	]
	quest.42000000001903B6.title: "Lagerfeuer darunter"
	quest.42000000001903B7.quest_desc: [
		"Blumen für die Arbeit der Bienen.",
		"So: Knochenmehl auf Gras, oder eine kleine Blume für das Eichennest."
	]
	quest.42000000001903B7.title: "Blumenteppich"
	quest.42000000001903B8.quest_desc: [
		"Mehr Blumen in der Nähe bedeutet mehr Pollen für den Bienenstock.",
		"So: Knochenmehl auf Gras. Bienen wollen irgendeine kleine Blume."
	]
	quest.42000000001903B8.title: "Löwenzahnfeld"
	quest.42000000001903B9.quest_desc: [
		"Eine auffälligere Blume, die manche Bienen dem Löwenzahn vorziehen.",
		"So: Moos plus Eiche, oder Knochenmehl auf Moos. Bienen nehmen die Blüte an."
	]
	quest.42000000001903B9.title: "Azaleenblüte"
	quest.42000000001903BA.quest_desc: [
		"Eine Frucht aus dem Ende, von der manche Bienen gern sammeln.",
		"So: Stand der Randgänger bei /clowder hub. Die äußeren End-Inseln sind weg."
	]
	quest.42000000001903BA.title: "Chorus-Happen"
	quest.42000000001903BB.quest_desc: [
		"Ein seltsamer Favorit für ein paar der zäheren Bienen.",
		"So: Wasser auf eine Lavaquelle (oder Lava auf Wasser). Behalte die Lavaquelle."
	]
	quest.42000000001903BB.title: "Obsidianleckerei"
	quest.42000000001903BC.quest_desc: [
		"Mehr Räume für den Bienenstock, diesmal aus Birke geschnitten.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903BC.title: "Birken-Erweiterung"
	quest.42000000001903BD.quest_desc: [
		"Mit Fichte vertäfelte Räume, an den Bienenstock geschraubt.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903BD.title: "Fichten-Erweiterung"
	quest.42000000001903BE.quest_desc: [
		"Schwarzeichen-Vertäfelung, gleicher Zweck: mehr Bienenräume.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903BE.title: "Schwarzeichen-Erweiterung"
	quest.42000000001903BF.quest_desc: [
		"Akazienräume für einen Bienenstock, der über sich hinausgewachsen ist.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903BF.title: "Akazien-Erweiterung"
	quest.42000000001903C0.quest_desc: [
		"Räume aus Tropenholz, genauso geräumig wie die übrigen.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903C0.title: "Tropenholz-Erweiterung"
	quest.42000000001903C1.quest_desc: [
		"Mit Kirsche vertäfelte Räume, reine Geschmackssache.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903C1.title: "Kirsch-Erweiterung"
	quest.42000000001903C2.quest_desc: [
		"Karmesinvertäfelte Räume für einen Bienenstock, der in den Nether abgewandert ist.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903C2.title: "Karmesin-Erweiterung"
	quest.42000000001903C3.quest_desc: [
		"Mit Wirrholz vertäfelte Räume, die blaue Hälfte des Paares.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903C3.title: "Wirr-Erweiterung"
	quest.42000000001903C4.quest_desc: [
		"Bambusräume, leichter und genauso brauchbar.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903C4.title: "Bambus-Erweiterung"
	quest.42000000001903C5.quest_desc: [
		"Mangrovenräume, das neueste Holz auf der Liste.",
		"So: Productive Bees-Rezepte in JEI. Schwarm benennt den Stock, die Zentrifuge und die Zuchtschritte."
	]
	quest.42000000001903C5.title: "Mangroven-Erweiterung"
	quest.42000000001903C6.quest_desc: [
		"Honig, den du direkt aus der Flasche trinkst.",
		"So: Glasflasche auf einen vollen Bienenstock. Lagerfeuer darunter."
	]
	quest.42000000001903C6.title: "Honigflaschen-Vorrat"
	quest.42000000001903C7.quest_desc: [
		"Wird zu Leckereien und Kuchen für ein hungriges Clowder.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001903C7.title: "Zuckervorrat"
	quest.42000000001903C8.quest_desc: [
		"Leer und warten auf Honig, Tränke oder Erfahrung.",
		"So: fertige, schmelze, siebe oder lass es ein Monster fallen. JEI listet jede Quelle auf der Plattform."
	]
	quest.42000000001903C8.title: "Glasflaschen-Vorrat"
	quest.42000000001903C9.quest_desc: [
		"Ein Ersatzpaar, um Waben zu schneiden, ohne die Bienen zu verletzen.",
		"So: zwei Eisenbarren diagonal. Schere Schafe und Bienennester."
	]
	quest.42000000001903C9.title: "Ersatzschere"
	quest.42000000001A03CA.quest_desc: [
		"Ein Block, der Gegenstände dorthin bringt, wo du es ihm sagst — das Nervensystem der Plattform.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Eisenbarren und Eisenstangen um ein leeres Modul; ergibt vier. Die Module kommen in den Router."
	]
	quest.42000000001A03CA.title: "Modular Router"
	quest.42000000001A03CB.quest_desc: [
		"Die Karte, auf die jedes Verhalten des Routers geschrieben wird.",
		"So: Modularer Router plus leere Module in JEI. Zieher/Sender/Brecher sitzen im Router."
	]
	quest.42000000001A03CB.title: "Blank Module"
	quest.42000000001A03CC.quest_desc: [
		"Zieht Gegenstände aus einem Nachbarn in den Router.",
		"So: Modularer Router plus leere Module in JEI. Zieher/Sender/Brecher sitzen im Router."
	]
	quest.42000000001A03CC.title: "Ziehmodul"
	quest.42000000001A03CD.quest_desc: [
		"Schieb Gegenstände zu einer markierten Stelle quer über die Plattform.",
		"So: Modularer Router plus leere Module in JEI. Zieher/Sender/Brecher sitzen im Router."
	]
	quest.42000000001A03CD.title: "Sendemodul"
	quest.42000000001A03CE.quest_desc: [
		"Brich einen Block vor dem Router und behalte, was fällt.",
		"So: Modularer Router plus leere Module in JEI. Zieher/Sender/Brecher sitzen im Router."
	]
	quest.42000000001A03CE.title: "Breaker Module"
	quest.42000000001A03CF.quest_desc: [
		"Setz einen Block, wohin der Router zeigt.",
		"So: Modularer Router plus leere Module in JEI. Zieher/Sender/Brecher sitzen im Router."
	]
	quest.42000000001A03CF.title: "Placer Module"
	quest.42000000001A03D0.quest_desc: [
		"Gib Redstone ab, wenn der Inhalt des Routers eine Schwelle überschreitet.",
		"So: Modularer Router plus leere Module in JEI. Zieher/Sender/Brecher sitzen im Router."
	]
	quest.42000000001A03D0.title: "Detector Module"
	quest.42000000001A03D1.quest_desc: [
		"Trägt Gegenstände zwischen Truhen, Maschinen und Plattformen.",
		"So: Eisen + Redstone. Richte die Seiten mit dem Pipez-Schraubenschlüssel."
	]
	quest.42000000001A03D1.title: "Item Rohr"
	quest.42000000001A03D2.quest_desc: [
		"Trägt Flüssigkeiten zwischen Tanks und Maschinen, ohne Eimerlauf.",
		"So: Eisen + Eimer + Redstone. Schleich-Benutzung des Schraubenschlüssels auf einer Seite zum Abziehen; Rechtsklick auf diese Seite für Filter."
	]
	quest.42000000001A03D2.title: "Flüssigkeitsrohr"
	quest.42000000001A03D3.quest_desc: [
		"Trägt Energie zwischen Maschinen, die sie erzeugen, und Maschinen, die sie brauchen.",
		"So: Eisen + Redstone. Trägt FE zwischen Maschinen."
	]
	quest.42000000001A03D3.title: "Strom Rohr"
	quest.42000000001A03D4.quest_desc: [
		"Trägt Chemikalien zwischen Maschinen, die damit umgehen.",
		"So: Eisen- + Redstone-Rohre in JEI. Schleich-Benutzung des Schraubenschlüssels setzt abziehende Seiten; Rechtsklick auf eine für Filter. Das Kapitel der Rohre ist die ganze Leiter."
	]
	quest.42000000001A03D4.title: "Gasrohr"
	quest.42000000001A03D5.quest_desc: [
		"Ein Rohr, viele Aufgaben.",
		"So: Eisen- + Redstone-Rohre in JEI. Schleich-Benutzung des Schraubenschlüssels setzt abziehende Seiten; Rechtsklick auf eine für Filter. Das Kapitel der Rohre ist die ganze Leiter."
	]
	quest.42000000001A03D5.title: "Universelles Rohr"
	quest.42000000001A03D6.quest_desc: [
		"Benutze eine Rohrseite schleichend, damit sie aus einer Maschine zieht, oder um sie abzuklemmen.",
		"So: zwei Feuersteine und zwei Stöcke. Schleich-Benutzung einer Rohrseite an einer Maschine, damit sie abzieht, noch einmal, um sie zu kappen; Rechtsklick auf eine abziehende Seite für Filter."
	]
	quest.42000000001A03D6.title: "Schraubenschlüssel"
	quest.42000000001A03D7.quest_desc: [
		"Geschwindigkeitsverbesserung für ein Rohr.",
		"So: Eisen- + Redstone-Rohre in JEI. Schleich-Benutzung des Schraubenschlüssels setzt abziehende Seiten; Rechtsklick auf eine für Filter. Das Kapitel der Rohre ist die ganze Leiter."
	]
	quest.42000000001A03D7.title: "Basisverbesserung"
	quest.42000000001A03D8.quest_desc: [
		"Steck sie in ein Rohr, um mehr pro Tick zu bewegen.",
		"So: Eisen- + Redstone-Rohre in JEI. Schleich-Benutzung des Schraubenschlüssels setzt abziehende Seiten; Rechtsklick auf eine für Filter. Das Kapitel der Rohre ist die ganze Leiter."
	]
	quest.42000000001A03D8.title: "Verbesserte Verbesserung"
	quest.42000000001A03D9.quest_desc: [
		"Die stärkere Verbesserung, für eine Leitung unter hoher Last.",
		"So: Eisen- + Redstone-Rohre in JEI. Schleich-Benutzung des Schraubenschlüssels setzt abziehende Seiten; Rechtsklick auf eine für Filter. Das Kapitel der Rohre ist die ganze Leiter."
	]
	quest.42000000001A03D9.title: "Fortgeschrittene Verbesserung"
	quest.42000000001A03DA.quest_desc: [
		"Oberste Durchsatzstufe von Pipez.",
		"So: Eisen- + Redstone-Rohre in JEI. Schleich-Benutzung des Schraubenschlüssels setzt abziehende Seiten; Rechtsklick auf eine für Filter. Das Kapitel der Rohre ist die ganze Leiter."
	]
	quest.42000000001A03DA.title: "Ultimative Verbesserung"
	quest.42000000001A03DB.quest_desc: [
		"Heb die Pipez-Ratengrenzen auf.",
		"So: nur Kreativ; Pipez hat kein Überlebensrezept dafür. Optional."
	]
	quest.42000000001A03DB.title: "Unendliche Verbesserung"
	quest.42000000001A03DC.quest_desc: [
		"Legt fest, welche Gegenstände ein Rohrende annimmt oder ignoriert.",
		"So: Eisen- + Redstone-Rohre in JEI. Schleich-Benutzung des Schraubenschlüssels setzt abziehende Seiten; Rechtsklick auf eine für Filter. Das Kapitel der Rohre ist die ganze Leiter."
	]
	quest.42000000001A03DC.title: "Filterwerkzeug"
	quest.42000000001A03DD.quest_desc: [
		"Der ursprüngliche Beweger. Langsam, billig und immer nützlich.",
		"So: fünf Eisen um eine Truhe. Setz ihn unter einen Webrahmen oder ein Spannungsfass (entnimmt nach UNTEN)."
	]
	quest.42000000001A03DD.title: "Ersatztrichter (Rohre)"
	quest.42000000001A03DE.quest_desc: [
		"Spenderlinie für die Logistik.",
		"So: Bruchstein um Redstone."
	]
	quest.42000000001A03DE.title: "Spenderlinie"
	quest.42000000001A03DF.quest_desc: [
		"Feuert oder platziert, was geladen ist, sobald ein Signal kommt.",
		"So: Bruchstein, Bogen und Redstone."
	]
	quest.42000000001A03DF.title: "Werferlinie"
	quest.42000000001A03E0.quest_desc: [
		"Liest, wie voll ein Behälter ist, und gibt ein Signal aus.",
		"So: Netherquarz, Redstonefackel, Stein. Quarz siebst du aus Seelensand; keine Reise in den Nether nötig."
	]
	quest.42000000001A03E0.title: "Komparator (Rohre)"
	quest.42000000001A03E1.quest_desc: [
		"Der Beobachter liest den Takt.",
		"So: Bruchstein, Redstone und Netherquarz."
	]
	quest.42000000001A03E1.title: "Beobachterlinie"
	quest.42000000001A03E2.quest_desc: [
		"Eine Signalquelle, die immer an ist, oder ein Inverter neben einem Hebel.",
		"So: Redstone über einem Stock."
	]
	quest.42000000001A03E2.title: "Redstone-Fackel"
	quest.42000000001A03E3.quest_desc: [
		"Der Verstärker taktet die Schaltung.",
		"So: Redstone-Fackel, Redstone, Stein. Das Kapitel der Rohre nutzt ihn für Uhren."
	]
	quest.42000000001A03E3.title: "Verstärker (Rohre)"
	quest.42000000001A03E4.quest_desc: [
		"Trifft ihn ein Geschoss, sendet er ein Signal nach der Stärke.",
		"So: Redstone um Heu. Heu ist drei Weizen."
	]
	quest.42000000001A03E4.title: "Zielblock"
	quest.42000000001A03E5.quest_desc: [
		"Liest den Himmel und gibt Signal nach Licht oder Zeit.",
		"So: Glas, Netherquarz, Holzstufen."
	]
	quest.42000000001A03E5.title: "Tageslichtsensor (Rohre)"
	quest.42000000001A03E6.quest_desc: [
		"Hält ein Buch und gibt Signal, wenn eine Seite umblättert.",
		"So: Holzstufen um ein Bücherregal."
	]
	quest.42000000001A03E6.title: "Lesepult (Rohre)"
	quest.42000000001A03E7.quest_desc: [
		"Gibt Signal, solange er offen ist, wie eine Truhe mit Stolperdraht.",
		"So: Stolperdrahthaken plus eine Truhe."
	]
	quest.42000000001A03E7.title: "Redstone-Truhe"
	quest.42000000001A03E8.quest_desc: [
		"Belädt ein Band oder zieht Gegenstände herunter, je nach Ausrichtung.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001A03E8.title: "Create-Trichter"
	quest.42000000001A03E9.quest_desc: [
		"Ein Trichter, der filtern kann, was er bewegt.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001A03E9.title: "Messingschleuse"
	quest.42000000001A03EA.quest_desc: [
		"Wirft Gegenstände gerade nach unten, zwischen den Etagen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001A03EA.title: "Rutsche (Rohre)"
	quest.42000000001A03EB.quest_desc: [
		"Eine Rutsche, die Gegenstände filtern und zurückhalten kann.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001A03EB.title: "Schlauer Schacht"
	quest.42000000001A03EC.quest_desc: [
		"Sortiert und bewegt Gegenstände, mit einstellbarer Priorität je Seite.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000001A03EC.title: "Mek-Logistik"
	quest.42000000001A03ED.quest_desc: [
		"Bewegt Flüssigkeiten mit Druck, also geht es nach oben so leicht wie nach unten.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000001A03ED.title: "Mek-Rohr"
	quest.42000000001A03EE.quest_desc: [
		"Trägt Energie zwischen Maschinen, in mehreren Durchsatzstufen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000001A03EE.title: "Mek-Kabel"
	quest.42000000001A03EF.quest_desc: [
		"Bewegt Chemikalien und Gase durch eine dichte Leitung.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000001A03EF.title: "Mek-Röhre"
	quest.42000000001A03F0.quest_desc: [
		"Eine schnellere Leitung für Gegenstände auf einer geschäftigen Plattform.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000001A03F0.title: "Fortgeschrittener Transporter"
	quest.42000000001A03F1.quest_desc: [
		"Noch schneller, für ein Netz, dem die Grundlagen nicht mehr reichen.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000001A03F1.title: "Elite-Transporter"
	quest.42000000001A03F2.quest_desc: [
		"Die schnellste Gegenstandsleitung, für eine voll ausgebaute Plattform.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000001A03F2.title: "Ultimativer Transporter"
	quest.42000000001A03F3.quest_desc: [
		"Die Energieleitung mit dem höchsten Durchsatz, für schwere Maschinenräume.",
		"So: Kapitel Mekanism-Werke — Erzbrocken aus dem Sieb, dann die Fabriklinie."
	]
	quest.42000000001A03F3.title: "Ultimatives Kabel"
	quest.42000000001B03F4.quest_desc: [
		"Listet jeden Geist auf, den du binden kannst, und was er braucht.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: ein Buch und Dämonentraum-Samen, formlos. Lies es; Geisterfeuer ist als Nächstes dran."
	]
	quest.42000000001B03F4.title: "Wörterbuch der Geister"
	quest.42000000001B03F5.quest_desc: [
		"Brennt violett und greift nie über. Dient zum Entzünden von Ritualen.",
		"So: entzünde Geisterfeuer, wie es das Wörterbuch der Geister zeigt (Es brennt!), und wirf dann Andesit hinein."
	]
	quest.42000000001B03F5.title: "Geisterfeuer (Anderswelt)"
	quest.42000000001B03F6.quest_desc: [
		"Zeigt auf vergrabenes Erz oder verborgene Bauwerke in der Nähe.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03F6.title: "Divination Rod"
	quest.42000000001B03F7.quest_desc: [
		"Wischt die Ritualkreide vom Boden, wenn du fertig bist.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03F7.title: "Bürste"
	quest.42000000001B03F8.quest_desc: [
		"Wächst zu einem Baum, der nicht in diese Welt gehört.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03F8.title: "Otherworld Sapling"
	quest.42000000001B03F9.quest_desc: [
		"Holz von einem fremden Baum, für Bindungsrituale.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03F9.title: "Otherworld Log"
	quest.42000000001B03FA.quest_desc: [
		"Hält eine Gabe, solange ein Bindungsritual läuft.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03FA.title: "Sacrificial Bowl"
	quest.42000000001B03FB.quest_desc: [
		"Eine vergoldete Schale, die das Ritual beschleunigt, in dem sie steht.",
		"So: Gold um eine Opferschale. Das Wörterbuch nennt das Ritual."
	]
	quest.42000000001B03FB.title: "Goldschale"
	quest.42000000001B03FC.quest_desc: [
		"Ein Vertrag ohne Unterschrift, der auf den Namen eines Geistes wartet.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03FC.title: "Leeres Bindungsbuch"
	quest.42000000001B03FD.quest_desc: [
		"Bindet die schwächste Klasse von Geistern, ein guter erster Versuch.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03FD.title: "Foliot-Buch"
	quest.42000000001B03FE.quest_desc: [
		"Bindet einen Geist mittlerer Stärke, stärkere Arbeit als ein Foliot.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03FE.title: "Djinni-Buch"
	quest.42000000001B03FF.quest_desc: [
		"Bindet einen wilden Geist. Das Ritual braucht mehr Vorbereitung.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B03FF.title: "Afrit-Buch"
	quest.42000000001B0400.quest_desc: [
		"Bindet den stärksten Geist im Wörterbuch.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0400.title: "Marid-Buch"
	quest.42000000001B0401.quest_desc: [
		"Ein Fokus, der einem Ritual hilft, seine Form zu halten.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0401.title: "Spirit Attuned Gem"
	quest.42000000001B0402.quest_desc: [
		"Erz von jenseits dieser Welt, verhüttet zu Iesnium.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0402.title: "Raw Iesnium"
	quest.42000000001B0403.quest_desc: [
		"Ein Metall, das es nur auf der anderen Seite gibt.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0403.title: "Iesnium Ingot"
	quest.42000000001B0404.quest_desc: [
		"Schickt gebundene Geisterbergleute in die Anderswelt zum Graben.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0404.title: "Dimensional Mineshaft"
	quest.42000000001B0405.quest_desc: [
		"Der schwächste Geist, unter Tage zum Graben abgestellt.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0405.title: "Foliot-Bergmann"
	quest.42000000001B0406.quest_desc: [
		"Verknüpft Geister-Lagergläser zu einem durchsuchbaren Netz.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0406.title: "Lagersteuerung (Anderswelt)"
	quest.42000000001B0407.quest_desc: [
		"Zieht bestimmte Geister zu einem Ritualkreis.",
		"So: Sieb, oder Amethystknospe, wenn du eine Geodenlinie züchtest. Occultism will Scherben."
	]
	quest.42000000001B0407.title: "Amethystfokus"
	quest.42000000001B0408.quest_desc: [
		"Wird eingeschmolzen für goldene Schalen und anderes Ritualgerät.",
		"So: schmelze Rohgold / Goldgrus. Seltenerer Siebfang."
	]
	quest.42000000001B0408.title: "Goldbarrenvorrat"
	quest.42000000001B0409.quest_desc: [
		"Leere Seiten, bereit, ein Bindungsbuch zu werden.",
		"So: drei Papier plus Leder. Papier ist Zuckerrohr."
	]
	quest.42000000001B0409.title: "Buchvorrat"
	quest.42000000001B040A.quest_desc: [
		"Färbt Ritualkreide, um einen Beschwörungskreis zu markieren.",
		"So: Blau plus Rot, oder eine violette Blume. Occultism will es."
	]
	quest.42000000001B040A.title: "Violetter Farbstoff"
	quest.42000000001B040B.quest_desc: [
		"Färbt Ritualkreide, eine schlichtere Markierung als Violett.",
		"So: Knochenmehl im Gitter, oder eine weiße Blume."
	]
	quest.42000000001B040B.title: "Weißer Farbstoff"
	quest.42000000001B040C.quest_desc: [
		"Färbt Ritualkreide für einen dunkleren Kreis.",
		"So: Holzkohle oder ein Tintenbeutel (Holzkohle plus eine Glasflasche)."
	]
	quest.42000000001B040C.title: "Schwarzer Farbstoff"
	quest.42000000001B040D.quest_desc: [
		"Ritueller Boden mit einer Textur, die Rituale zu mögen scheinen.",
		"So: Sand in ein Ex Deorum-Fass mit Hexenwasser. Die Warzenräume der Festung halten etwas. Drei Schädel auf Seelensand machen einen Wither."
	]
	quest.42000000001B040D.title: "Seelensandvorrat (Anderswelt)"
	quest.42000000001B040E.quest_desc: [
		"Eine Grundschicht für Rituale, die zum Feuer neigen.",
		"So: der Nether ist hier Leere, kein Gelände. Gieß Lava in ein Ex Deorum-Fass mit Hexenwasser (ein Wasserfass auf Myzel; Myzelsporen siebst du aus Erde)."
	]
	quest.42000000001B040E.title: "Netherrack-Vorrat (Anderswelt)"
	quest.42000000001B040F.quest_desc: [
		"Ein dunkler, stabiler Rahmen für einen Ritualkreis.",
		"So: Wasser auf eine Lavaquelle (oder Lava auf Wasser). Behalte die Lavaquelle."
	]
	quest.42000000001B040F.title: "Obsidianvorrat (Anderswelt)"
	quest.42000000001B0410.quest_desc: [
		"Ein Opfer, zu dem manche Geister gezogen werden.",
		"So: Endermen, oder der Stand der Randgänger bei /clowder hub."
	]
	quest.42000000001B0410.title: "Enderperlenvorrat (Anderswelt)"
	quest.42000000001B0411.quest_desc: [
		"Ein wertvolles Opfer für ein anspruchsvolles Ritual.",
		"So: siebe Kies mit einem Eisennetz oder besser, oder Diamanterz im Echobrecher."
	]
	quest.42000000001B0411.title: "Diamantvorrat"
	quest.42000000001B0412.quest_desc: [
		"Ein Bindungsbuch, in dem schon ein Foliot versiegelt ist.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0412.title: "Gebundenes Foliot-Buch"
	quest.42000000001B0413.quest_desc: [
		"Ein Bindungsbuch, in dem schon ein Djinni versiegelt ist.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0413.title: "Gebundenes Djinni-Buch"
	quest.42000000001B0414.quest_desc: [
		"Ein Bindungsbuch, in dem schon ein Afrit versiegelt ist.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0414.title: "Gebundenes Afrit-Buch"
	quest.42000000001B0415.quest_desc: [
		"Ein Bindungsbuch, in dem schon ein Marid versiegelt ist.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0415.title: "Gebundenes Marid-Buch"
	quest.42000000001B0416.quest_desc: [
		"Eine Aderprobe, die sich zu schmelzen lohnt, sobald du mehr findest.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0416.title: "Iesnium Ore"
	quest.42000000001B0417.quest_desc: [
		"Ein Afrit, tief hinabgeschickt, um dort zu graben, wohin geringere Geister nicht gehen.",
		"So: Wörterbuch der Geister, dann Geisterfeuer und Schalen. Das Kapitel Anderswelt nennt die Riten."
	]
	quest.42000000001B0417.title: "Tiefen-Afrit-Bergmann"
	quest.42000000001C0418.quest_desc: [
		"Dreh sie von Hand, solange sonst noch nichts dreht.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0418.title: "Handkurbel (Uhrwerke)"
	quest.42000000001C0419.quest_desc: [
		"Trägt die Drehung von einer Maschine zur nächsten.",
		"So: Andesitlegierung in einem Schneide-Rezept / einer Fertigung, gelistet in JEI."
	]
	quest.42000000001C0419.title: "Wellenvorrat"
	quest.42000000001C041A.quest_desc: [
		"Das Zahnrad beißt in die Welle.",
		"So: Welle + Bretter."
	]
	quest.42000000001C041A.title: "Zahnradvorrat"
	quest.42000000001C041B.quest_desc: [
		"Greift schräg ein und ändert die Drehzahl.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C041B.title: "Großes Zahnrad (Uhrwerke)"
	quest.42000000001C041C.quest_desc: [
		"Führt die Drehung um die Ecke, ohne Geschwindigkeit zu verlieren.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C041C.title: "Getriebe (Uhrwerke)"
	quest.42000000001C041D.quest_desc: [
		"Schalte einen Maschinenmodus ein.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C041D.title: "Kupplung (Uhrwerke)"
	quest.42000000001C041E.quest_desc: [
		"Kehrt die Drehrichtung mit einem Redstone-Impuls um.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C041E.title: "Schaltung (Uhrwerke)"
	quest.42000000001C041F.quest_desc: [
		"Schickt die Drehung weit fort, ohne eine Wand aus Wellen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
