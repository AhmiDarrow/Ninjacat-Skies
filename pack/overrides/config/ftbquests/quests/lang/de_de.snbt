	]
	quest.42000000001D0479.title: "256k-Gegenstandszelle"
	quest.42000000001D047A.quest_desc: [
		"Speichert Flüssigkeit im Netzwerk statt in einem Tank.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D047A.title: "1k-Flüssigkeitszelle (Netzwerk)"
	quest.42000000001D047B.quest_desc: [
