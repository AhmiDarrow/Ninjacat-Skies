	quest.42000000001C042C.title: "Mahlstein (Uhrwerke)"
	quest.42000000001C042D.quest_desc: [
		"Zwei Räder drehen gegeneinander, Erz läuft dazwischen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C042D.title: "Mahlwerkrad"
	quest.42000000001C042E.quest_desc: [
		"Lüfter zum Waschen und Trocknen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
