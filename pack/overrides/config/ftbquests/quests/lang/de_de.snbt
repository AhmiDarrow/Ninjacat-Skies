	quest.42000000001C044F.quest_desc: [
		"Fordert Gegenstände aus einem verbundenen Bestandsnetz.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C044F.title: "Lagerticker"
	quest.42000000001C0450.quest_desc: [
		"Leg es hin, und eine Lore hat wohin sie fahren kann.",
