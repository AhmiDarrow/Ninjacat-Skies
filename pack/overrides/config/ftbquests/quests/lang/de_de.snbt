	quest.42000000001C043B.quest_desc: [
		"Füllt Gegenstände und Behälter von oben mit Flüssigkeit.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C043B.title: "Ausguss (Uhrwerke)"
