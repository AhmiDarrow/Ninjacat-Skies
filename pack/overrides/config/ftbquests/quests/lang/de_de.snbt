	quest.42000000001C041F.title: "Kettenantrieb"
	quest.42000000001C0420.quest_desc: [
		"Ein Kettenantrieb, der auf Befehl umkehrt oder anhält.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0420.title: "Verstellkette"
	quest.42000000001C0421.quest_desc: [
		"Dreht sich am fallenden Wasser, langsam, aber stetig.",
		"So: acht Bretter um eine Welle. Daneben braucht es einen Wasserfluss."
	]
	quest.42000000001C0421.title: "Wasserrad (Uhrwerke)"
	quest.42000000001C0422.quest_desc: [
		"Größeres Rad, mehr Drehmoment aus derselben Strömung.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
