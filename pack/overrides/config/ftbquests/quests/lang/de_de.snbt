	quest.42000000001C0454.title: "Steuerungsschiene"
	quest.42000000001C0455.quest_desc: [
		"Seilrolle für senkrechte Bewegung.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0455.title: "Flaschenzug"
	quest.42000000001C0456.quest_desc: [
		"Hebt eine ganze Plattform zwischen markierten Etagen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0456.title: "Aufzug-Seilrolle"
	quest.42000000001C0457.quest_desc: [
		"Trägt einen Portalkranwagen entlang seiner Länge.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0457.title: "Portalkranachse"
	quest.42000000001C0458.quest_desc: [
		"Fährt auf einer Portalkranwelle und zieht das Bauwerk mit sich.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C0458.title: "Portalkranwagen (Uhrwerke)"
	quest.42000000001D0459.quest_desc: [
		"Wächst in Höhlen und hält das Gedächtnis eines Netzwerks.",
		"Die Neun Stämme haben Vorräte für den nächsten Clowder hinterlegt. Nutze einen Hütervorrat, um zufällige Vorräte auszupacken, oder fertige aus vier kleinen einen mittleren und aus drei mittleren einen großen. Größere Siegel haben mehr Würfe und einen breiteren Vorrat; getrennt öffnen gibt mehr Grundvorräte. Darin verstecken sich keine Maschinen und keine Fortschrittsmarken, aber jedes Siegel hat eine kleine Chance auf eine Fadenscherbe und eine sehr kleine auf einen ganzen Rückkehrfaden; größere Siegel haben bessere Chancen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0459.title: "Certus-Kristall"
	quest.42000000001D045A.quest_desc: [
		"Ein geladener Kristall, bereit für Prozessoren und Zellen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D045A.title: "Aufgeladenes Certus"
	quest.42000000001D045B.quest_desc: [
		"Wächst schnell im Wasser, der Hauptkristall des digitalen Webstuhls.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D045B.title: "Fluixkristall"
	quest.42000000001D045C.quest_desc: [
		"Gemahlenes Fluix, für Rezepte von Glas und Kabel.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D045C.title: "Fluixstaub (Netzwerk)"
	quest.42000000001D045D.quest_desc: [
		"Aus Certusquarz erschmolzen, für die Chips des Webstuhls.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D045D.title: "Silizium (Netzwerk)"
	quest.42000000001D045E.quest_desc: [
		"Meteorstein, die Grundlage jedes Baus am digitalen Webstuhl.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D045E.title: "Himmelsstein (Netzwerk)"
	quest.42000000001D045F.quest_desc: [
		"Geglätteter Himmelsstein, für die Hülle des Controllers.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
