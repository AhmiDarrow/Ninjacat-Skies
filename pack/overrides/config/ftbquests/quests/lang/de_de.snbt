	quest.42000000001D0460.quest_desc: [
		"Der Inscriptor presst Schaltkreise, so wie der Webstuhl Tuch presst.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0460.title: "Press das Muster (Netzwerk)"
	quest.42000000001D0461.quest_desc: [
