		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D046C.title: "Energiezelle"
	quest.42000000001D046D.quest_desc: [
		"Speichert eine tiefe Energiereserve für das Netzwerk.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D046D.title: "Dichte Energie"
	quest.42000000001D046E.quest_desc: [
		"Das Rückgrat des Webstuhls; jeder Kanal strahlt von hier aus.",
