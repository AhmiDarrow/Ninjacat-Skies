	]
	quest.42000000001D046F.title: "Laufwerk"
	quest.42000000001D0470.quest_desc: [
		"Ein kleines Speichergehäuse, versiegelt in einer Zellhülle.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0470.title: "1k-Komponente"
	quest.42000000001D0471.quest_desc: [
		"Ein größeres Speichergehäuse für eine dichtere Zelle.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0471.title: "4k-Komponente"
	quest.42000000001D0472.quest_desc: [
		"Ein mittelgroßes Speichergehäuse, weit über der Grundgröße.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0472.title: "16k-Komponente"
	quest.42000000001D0473.quest_desc: [
		"Ein großes Speichergehäuse für eine ernsthafte Zelle.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0473.title: "64k-Komponente"
	quest.42000000001D0474.quest_desc: [
		"Das größte Speichergehäuse, nur das Archiv selbst ist größer.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0474.title: "256k-Komponente"
	quest.42000000001D0475.quest_desc: [
		"Speichert Gegenstände im Netzwerk, ungefähr eine Truhe voll.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0475.title: "1k-Gegenstandszelle (Netzwerk)"
	quest.42000000001D0476.quest_desc: [
		"Speichert im Netzwerk Gegenstände für mehrere Truhen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0476.title: "4k-Gegenstandszelle (Netzwerk)"
	quest.42000000001D0477.quest_desc: [
		"Speichert eine Menge Gegenstände, ohne ein Fass anzufassen.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0477.title: "16k-Gegenstandszelle (Netzwerk)"
	quest.42000000001D0478.quest_desc: [
		"Speichert ein Lagerhaus voller Gegenstände auf einer kleinen Platte.",
