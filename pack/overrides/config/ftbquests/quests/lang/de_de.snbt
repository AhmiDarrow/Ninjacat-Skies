	quest.42000000001C044A.quest_desc: [
		"Zeigt eine Zahl für jeden, der die Anzeige liest.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C044A.title: "Nixie-Röhre"
	quest.42000000001C044B.quest_desc: [
		"Zeigt Text von einem Schild oder einem Bestandsticker.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C044B.title: "Anzeigetafel (Uhrwerke)"
	quest.42000000001C044C.quest_desc: [
		"Zeigt auf einen Blick die Menge einer verfolgten Ressource.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C044C.title: "Fabrikanzeige"
	quest.42000000001C044D.quest_desc: [
		"Packe Gegenstände für den Versand.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
	quest.42000000001C044D.title: "Verpacker"
	quest.42000000001C044E.quest_desc: [
		"Sammelt geteilte Pakete wieder zu ganzen Bestellungen.",
		"So: Create-Fertigung in JEI (Werkbank, Presse, Mischer oder Platzierer). Andesitlegierung und ein Wasserrad starten die Linie."
	]
