	quest.42000000001D0461.title: "Ladegerät (Netzwerk)"
	quest.42000000001D0462.quest_desc: [
		"Eine gedruckte Schaltung, gepresst, ehe sie ein Prozessor wird.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
	quest.42000000001D0462.title: "Gedruckte Berechnung"
	quest.42000000001D0463.quest_desc: [
		"Eine gedruckte Schaltung für einen Logikprozessor.",
		"So: Spindelnetz — Certus aus Sand, der Controller will einen Bindungsknoten."
	]
