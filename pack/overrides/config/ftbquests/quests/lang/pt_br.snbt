{
	chapter.3100000000000001.chapter_subtitle: [
		"Acorde — sobreviva, reivindique a plataforma, deixe o Códice despertar."
	]
	chapter.3100000000000001.title: "Trama: Solo"
	chapter.3100000000000002.chapter_subtitle: [
		"Recupere — traga o mundo caído de volta à matéria."
	]
	chapter.3100000000000002.title: "Trama: Pedra"
	chapter.3100000000000003.chapter_subtitle: [
		"Enraíze — cultive âncoras para a plataforma parar de desfiar."
	]
	chapter.3100000000000003.title: "Trama: Broto"
	chapter.3100000000000004.chapter_subtitle: [
		"Borda — equipe-se e saia da plataforma de propósito."
	]
	chapter.3100000000000004.title: "Trama: Garra"
	chapter.3100000000000005.chapter_subtitle: [
		"Zumba — ritmo e pulso antes dos fios."
	]
	chapter.3100000000000005.title: "Trama: Centelha"
	chapter.3100000000000006.chapter_subtitle: [
		"Padrão — uma fábrica como uma canção que se sustenta sozinha."
	]
	chapter.3100000000000006.title: "Trama: Relógio"
	chapter.3100000000000007.chapter_subtitle: [
		"Colônia — mantenha vivo algo que mantém outra coisa viva."
	]
	chapter.3100000000000007.title: "Trama: Enxame"
	chapter.3100000000000008.chapter_subtitle: [
		"Amarre — selos, ritos e dois caminhos de trança num cordão."
	]
	chapter.3100000000000008.title: "Trama: Selo"
	chapter.3100000000000009.chapter_subtitle: [
		"Reteça — o tear digital, a Marca, o Fragmento."
	]
	chapter.3100000000000009.title: "Trama: Fuso"
	chapter.310000000000000A.title: "Peneira funda"
	chapter.310000000000000B.title: "Armazenamento e mochilas"
	chapter.310000000000000C.title: "Oficinas Mekanism"
	chapter.310000000000000D.title: "Rede Powah"
	chapter.310000000000000E.title: "Lado arcano"
	chapter.310000000000000F.chapter_subtitle: [
		"Equipes, o Salão, o Poste e o Desfiado."
	]
	chapter.310000000000000F.title: "Salão Clowder"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Linha da cozinha"
	chapter.3100000000000013.title: "Feitiços de batalha"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Decoração de plataforma"
	chapter.3100000000000016.title: "Apoio no Nether"
	chapter.3100000000000017.title: "Apoio no End"
	chapter.3100000000000018.title: "Campos de essência"
	chapter.3100000000000019.chapter_subtitle: [
		"Cada ninho é um anel de alguma coisa em volta de uma flor."
	]
	chapter.3100000000000019.title: "Apiário do Enxame"
	chapter.310000000000001A.title: "Tubulação"
	chapter.310000000000001B.title: "Outro mundo"
	chapter.310000000000001C.title: "Relojoaria profunda"
	chapter.310000000000001D.title: "Rede do Fuso"
	chapter.310000000000001E.title: "Ofício do vazio"
	chapter.310000000000001F.title: "Linhas empacotadas"
	chapter.3100000000000020.title: "QIO e o pico Mek"
	chapter.3100000000000021.title: "Caça e fazenda"
	chapter.3100000000000022.title: "Tecido tribal"
	chapter.3100000000000023.chapter_subtitle: [
		"Os Cantores de cascalho cortam uma pedra de cem jeitos."
	]
	chapter.3100000000000023.title: "Canteiro"
	chapter.3100000000000024.chapter_subtitle: [
		"Uma plataforma é uma beirada até alguém colocar uma cadeira nela."
	]
	chapter.3100000000000024.title: "Mobília"
	chapter.3100000000000025.chapter_subtitle: [
		"As máquinas pequenas que os zeladores deixaram."
	]
	chapter.3100000000000025.title: "Pequenas zeladorias"
	chapter.3100000000000026.chapter_subtitle: [
		"O pulso dos Corações de tambor aprende a correr no cobre."
	]
	chapter.3100000000000026.title: "A corrente"
	chapter.3100000000000027.chapter_subtitle: [
		"O Corte rompeu treze guardiões. Volte a tensionar cada Trama ao vencer o guardião dela."
	]
	chapter.3100000000000027.title: "Guardiões partidos"
	chapter.3100000000000028.chapter_subtitle: [
		"Ande pela Marca. Dome um amarelo. Esther espera no Salão depois que você tiver estado lá."
	]
	chapter.3100000000000028.title: "Corredores de plataforma"
	chapter.3100000000000029.chapter_subtitle: [
		"Hortas da peneira. Cozinhe o que uma plataforma do vazio nunca fez crescer."
	]
	chapter.3100000000000029.title: "Mesa da colheita"
	chapter.310000000000002A.chapter_subtitle: [
		"Varetas de cultivo, estatísticas, irrigação. Numa saliência, as ervas daninhas não pegam."
	]
	chapter.310000000000002A.title: "Varetas de cultivo"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Fabricar e tensão"
	chapter_group.2100000000000003.title: "Retecer"
	chapter_group.2100000000000004.title: "Caminhos laterais"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"Você acordou numa saliência. Olhe o precipício e depois clique aqui.",
		"O acento grave (`) é a lista de tarefas. O Códice dos Bigodes é Comece aqui.",
		"Como: clique na missão. Depois bata no carvalho."
	]
	quest.4200000000018001.title: "Olhe o precipício"
	quest.4200000000010001.quest_desc: [
		"Você é Skybound. Isto é o que não caiu.",
		"Oito troncos. Comece pela árvore; ela começou com você.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: bata no carvalho da sua plataforma. Oito troncos começam Despertar."
	]
	quest.4200000000010001.title: "Despertar numa plataforma"
	quest.4200000000010002.quest_desc: [
		"A terra é uma promessa que a plataforma faz às suas botas.",
		"Dezesseis blocos. Alargue a promessa.",
		"Como: baú inicial, sumidouro de pedregulho+fio, sobras da peneira, ou /clowder hub (Guardiões da plataforma)."
	]
	quest.4200000000010002.title: "Algo onde pisar"
	quest.4200000000010003.quest_desc: [
		"As mãos precisam de uma superfície. Tudo depois disto é uma superfície.",
		"Como: quatro tábuas em um quadrado."
	]
	quest.4200000000010003.title: "Faça uma bancada"
	quest.4200000000010004.quest_desc: [
		"Garra vem depois. Por agora, madeira que morde.",
		"Como: três tábuas sobre dois gravetos."
	]
	quest.4200000000010004.title: "Picareta de madeira"
	quest.4200000000010005.quest_desc: [
		"Verde contra o precipício.",
		"Plante-o antes de ficar com fome.",
		"Como: quebre folhas de carvalho, ou /clowder hub Liga-raízes (8 Fio por quatro)."
	]
	quest.4200000000010005.title: "Primeira muda"
	quest.4200000000010006.quest_desc: [
		"Sessenta e quatro tábuas são uma plataforma que deixa de parecer uma saliência.",
		"Como: um tronco na grade de criação faz quatro."
	]
	quest.4200000000010006.title: "Estoque de tábuas"
	quest.4200000000010007.quest_desc: [
		"Cabos, estruturas, os ossos das ferramentas.",
		"Como: duas tábuas em uma coluna."
	]
	quest.4200000000010007.title: "Feixe de gravetos"
	quest.4200000000010008.quest_desc: [
		"Ponha as coisas onde elas fiquem. Um Clowder divide um baú antes de dividir qualquer outra coisa.",
		"Como: oito tábuas ao redor de um centro vazio."
	]
	quest.4200000000010008.title: "Baú para o Clowder"
	quest.4200000000010009.quest_desc: [
		"Veja a borda antes que a borda veja você.",
		"Como: carvão ou carvão vegetal sobre um graveto. Os Parentes em /clowder hub vendem um pacote."
	]
	quest.4200000000010009.title: "Linha de tochas"
	quest.420000000001000A.quest_desc: [
		"Gelo e lava fazem pedra onde não havia.",
		"As plataformas Normal e Difícil trazem os dois. Os Guardiões da plataforma em /clowder hub vendem um balde.",
		"Como: lava ao lado da água (ou gelo derretido). Martele a pedra. A banca dos Cantores de cascalho em /clowder hub vende um fardo."
	]
	quest.420000000001000A.title: "Reserva de pedregulho"
	quest.420000000001000B.quest_desc: [
		"Calor que ainda não é Centelha.",
		"Os Guardiões da plataforma teriam chamado isto de lareira.",
		"Como: oito pedregulhos ao redor de um centro vazio."
	]
	quest.420000000001000B.title: "Calor da fornalha"
	quest.420000000001000C.quest_desc: [
		"A fome é um vazio macio. Oito pães o fecham por um tempo.",
		"Como: três trigos em fileira, ou /clowder hub Guardião da lareira."
	]
	quest.420000000001000C.title: "Cozinhe uma refeição"
	quest.420000000001000D.quest_desc: [
		"Coloque lava, derreta o gelo numa fonte e encha o balde.",
		"Fácil traz água; Normal e Difícil trazem as peças.",
		"Como: balde vazio numa fonte de água. Normal/Difícil: coloque lava, derreta o gelo, encha."
	]
	quest.420000000001000D.title: "Pegue a chuva"
	quest.420000000001000E.quest_desc: [
		"Restos do Tear que ainda aguentam. Toda missão devolve um pouco.",
		"Desfie um para linha, ou gaste-os nas bancas dos Parentes em /clowder hub.",
		"Como: recompensas de missão, terra com malha de pederneira numa Armação do tear, reservas do zelador."
	]
	quest.420000000001000E.title: "Moeda desfiada"
	quest.420000000001000F.quest_desc: [
		"Danificado, mas ainda ensina. Abra Comece aqui.",
		"Clique direito no livro e abra Comece aqui. Acento grave (`): a lista de tarefas.",
		"Como: kit inicial / baú do cais. Clique direito no livro; o acento grave (`) é a lista de tarefas."
	]
	quest.420000000001000F.title: "Códice na mão"
	quest.4200000000010010.quest_desc: [
		"Marque um ponto de renascimento.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010010.title: "Cama reivindicada"
	quest.4200000000010011.quest_desc: [
		"Desça às profundezas sem corda. Barata o bastante para deixar uma em cada poço.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010011.title: "Escada abaixo"
	quest.4200000000010012.quest_desc: [
		"Seda de aranha guardada para malhas futuras. Cada fibra acaba sendo usada.",
		"Como: desfie Fio desfiado (1 → 3). Aranhas. Fiapo do tear numa Amarra de eco. Sumidouro inverso de novelo."
	]
	quest.4200000000010012.title: "Reserva de linha"
	quest.4200000000010013.quest_desc: [
		"Acelere o verde.",
		"Como: ossos numa grade, ou sumidouro de Fio + carne podre, ou /clowder hub Guardiões da plataforma."
	]
	quest.4200000000010013.title: "Estoque de farinha de osso"
	quest.4200000000010014.quest_desc: [
		"Alargue a plataforma.",
		"Como: baú inicial, sumidouro de pedregulho+fio, sobras da peneira, ou /clowder hub (Guardiões da plataforma)."
	]
	quest.4200000000010014.title: "Plataforma de terra"
	quest.4200000000010015.quest_desc: [
		"Pode-as agora, composte-as depois. Numa plataforma, nada se desperdiça.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010015.title: "Folhas de carvalho"
	quest.4200000000010016.quest_desc: [
		"Um canto quieto.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010016.title: "Vaso de flor"
	quest.4200000000010017.quest_desc: [
		"O barril do Ex Deorum: composto, e água em argila pelo caminho lento.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010017.title: "Barril"
	quest.4200000000010018.quest_desc: [
		"Lixo em farinha.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010018.title: "Composteira"
	quest.4200000000010019.quest_desc: [
		"Risque um sulco.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010019.title: "Enxada de madeira"
	quest.420000000001001A.quest_desc: [
		"Derruba troncos mais rápido do que as mãos nuas. A primeira ferramenta de verdade que um Skybound tem.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001001A.title: "Machado de madeira"
	quest.420000000001001B.quest_desc: [
		"Transforma terra e cascalho em chão limpo. Lenta, mas funciona.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001001B.title: "Pá de madeira"
	quest.420000000001001C.quest_desc: [
		"Mal segura um zumbi, mas segura um. Melhor do que socar.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001001C.title: "Espada de madeira"
	quest.420000000001001D.quest_desc: [
		"Cabe sopa, ensopado e pouco mais. Louça simples para uma plataforma simples.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001001D.title: "Tigela"
	quest.420000000001001E.quest_desc: [
		"Etiquete a plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001001E.title: "Moldura"
	quest.420000000001001F.quest_desc: [
		"Faça daqui um lar.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001001F.title: "Pintura"
	quest.4200000000010020.quest_desc: [
		"Mantém o vento e os monstros do lado certo da parede.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010020.title: "Porta de carvalho"
	quest.4200000000010021.quest_desc: [
		"Marca uma borda sem tapar a vista. Útil onde a queda é de verdade.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010021.title: "Cerca de carvalho"
	quest.4200000000010022.quest_desc: [
		"Transforma uma parede a pique em algo que você realmente sobe.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010022.title: "Escadas de carvalho"
	quest.4200000000010023.quest_desc: [
		"Meio bloco, o dobro de opções de piso. Útil em espaços apertados.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010023.title: "Laje de carvalho"
	quest.4200000000010024.quest_desc: [
		"Alçapões de acesso.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010024.title: "Alçapão de carvalho"
	quest.4200000000010025.quest_desc: [
		"Dispara um sinal quando algo pisa nela. As portas se abrem sozinhas.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010025.title: "Placa de pressão de carvalho"
	quest.4200000000010026.quest_desc: [
		"Botão para toques de redstone.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010026.title: "Botão de carvalho"
	quest.4200000000010027.quest_desc: [
		"Cerque a borda da plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010027.title: "Portão de cerca de gravetos"
	quest.4200000000010028.quest_desc: [
		"Cozinha devagar e deixa a fumaça visível por léguas.",
		"Como: troncos, gravetos e carvão ou carvão vegetal."
	]
	quest.4200000000010028.title: "Fogueira"
	quest.4200000000010029.quest_desc: [
		"Pendura luz onde uma tocha ficaria errada. Brilho mais quente, o mesmo trabalho.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010029.title: "Lampião"
	quest.420000000001002A.quest_desc: [
		"Queima num azul pálido e impede que quase tudo surja perto.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001002A.title: "Lampião das almas"
	quest.420000000001002B.quest_desc: [
		"Sobe com você e some quando puxado. Construir no alto deixa de assustar.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001002B.title: "Andaime"
	quest.420000000001002C.quest_desc: [
		"Corrente para um enfeite pendurado.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001002C.title: "Corrente"
	quest.420000000001002D.quest_desc: [
		"Engaiole a borda.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001002D.title: "Barras de ferro"
	quest.420000000001002E.quest_desc: [
		"Vidro para as janelas da plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001002E.title: "Painel de vidro"
	quest.420000000001002F.quest_desc: [
		"Macia, inflamável e fácil de tingir. Toda plataforma acaba precisando de uma cama.",
		"Como: tosquie as ovelhas depois de dar grama, ou quatro linhas."
	]
	quest.420000000001002F.title: "Lã branca"
	quest.4200000000010030.quest_desc: [
		"Uma camada fina de lã para pisos que não precisam de um bloco inteiro.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010030.title: "Tapete branco"
	quest.4200000000010031.quest_desc: [
		"Traz um pouco de verde e rosa a uma plataforma feita de cascalho.",
		"Como: musgo mais carvalho, ou farinha de osso no musgo. As abelhas aceitam a flor."
	]
	quest.4200000000010031.title: "Azaleia florida"
	quest.4200000000010032.quest_desc: [
		"Espalha-se devagar e suaviza o visual das plataformas de pedra bruta.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010032.title: "Bloco de musgo"
	quest.4200000000010033.quest_desc: [
		"Raízes penduradas sob a plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010033.title: "Raízes suspensas"
	quest.4200000000010034.quest_desc: [
		"Gruda nas paredes e as ilumina sem uma única tocha.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010034.title: "Líquen brilhante"
	quest.4200000000010035.quest_desc: [
		"Espeleotema para um toque pontudo.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010035.title: "Espeleotema pontiagudo"
	quest.4200000000010036.quest_desc: [
		"Ametista em um bloco. Selo vai querer lascas mais tarde.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010036.title: "Bloco de ametista"
	quest.4200000000010037.quest_desc: [
		"Nove lingotes prensados. Fica verde se você deixar do lado de fora.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010037.title: "Bloco de cobre"
	quest.4200000000010038.quest_desc: [
		"Nove pedaços de ferro bruto bem empilhados, à espera de uma fornalha.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010038.title: "Bloco de ferro bruto"
	quest.4200000000010039.quest_desc: [
		"Queima bem mais que carvão solto. Alimente a fornalha e vá embora.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000010039.title: "Bloco de carvão"
	quest.420000000001003A.quest_desc: [
		"Alimenta animais e amortece uma queda. Os fazendeiros o deixam perto pelos dois motivos.",
		"Como: nove trigos. Três trigos também fazem pão."
	]
	quest.420000000001003A.title: "Fardo de feno"
	quest.420000000001003B.quest_desc: [
		"Nove algas prensadas em combustível. Funde mais do que parece.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001003B.title: "Bloco de algas secas"
	quest.420000000001003C.quest_desc: [
		"Papel e couro, à espera de virar algo com receita.",
		"Como: três papéis mais couro. Papel é cana-de-açúcar."
	]
	quest.420000000001003C.title: "Livro"
	quest.420000000001003D.quest_desc: [
		"Papel para livros e mapas.",
		"Como: três canas-de-açúcar em fila. A cana vem de peneirar terra com malha de pederneira ou melhor."
	]
	quest.420000000001003D.title: "Papel"
	quest.420000000001003E.quest_desc: [
		"O corante e os livros precisam de tinta.",
		"Como: carvão vegetal mais uma garrafa de vidro. Lulas nunca surgem aqui."
	]
	quest.420000000001003E.title: "Bolsa de tinta"
	quest.420000000001003F.quest_desc: [
		"Penas para flechas e livros.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000001003F.title: "Pena"
	quest.4200000000010040.quest_desc: [
		"Couro para livros e kits.",
		"Como: funda carne podre ou asse na fogueira. Peneire terra com malha de pederneira. /clowder hub Os Guardiões da plataforma vendem dois por 18 Fio."
	]
	quest.4200000000010040.title: "Couro"
	quest.4200000000010041.quest_desc: [
		"Bancada, muda, lareira, água, Códice. A plataforma se mantém.",
		"Tensione a Trama: os Guardiões da plataforma respondem, e a ficha é sua para assentar.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.4200000000010041.quest_subtitle: "Despertar"
	quest.4200000000010041.title: "Nó de Solo"
	quest.4200000000010042.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.4200000000010042.title: "Assente Solo"
	quest.4200000000010043.quest_desc: [
		"Um zumbi numa plataforma sem cavernas. O vazio manda lembranças.",
		"Ilumine as bordas.",
		"Como: mate um zumbi na plataforma à noite. Ilumine as bordas."
	]
	quest.4200000000010043.title: "Surgiu alguma coisa"
	quest.4200000000020044.quest_desc: [
		"Fio que lembra de onde veio.",
		"Desfie Fio em linha; quatro linhas fiam dois novelos.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: quatro linhas → dois novelos. Barril de tensão: linha + pérola. Quatro Fiapos do tear."
	]
	quest.4200000000020044.title: "Puxe a Meada do vazio"
	quest.4200000000020045.quest_desc: [
		"Pedregulho e gravetos. Quebre os grânulos caídos em cascalho, areia e pó.",
		"Como: pedregulho + gravetos. Quebre grânulos em cascalho, areia e pó."
	]
	quest.4200000000020045.title: "Martelo de fuso"
	quest.4200000000020046.quest_desc: [
		"Linha ao redor do novelo. Ela pega o que o Tear deixou cair — e penteia Fiapo do tear para fora da terra.",
		"Como: linha ao redor do novelo. A banca dos Cantores de cascalho vende uma."
	]
	quest.4200000000020046.title: "Enfie a malha"
	quest.4200000000020047.quest_desc: [
		"Despeje água; o balde volta na hora. Acrescente terra. Espere a argila.",
		"Linha e uma pérola no mesmo barril fazem novelo.",
		"Como: tábuas, linha e Meada do vazio. Despeje água (o balde volta), acrescente terra → argila."
	]
	quest.4200000000020047.title: "Barril de tensão"
	quest.4200000000020048.quest_desc: [
		"Dezesseis argilas do barril. Carregue oito terras por vez.",
		"Como: Barril de tensão — água + terra. A Quebra-eco martela areia em argila."
	]
	quest.4200000000020048.title: "Bolso de argila"
	quest.4200000000020049.quest_desc: [
		"Argila e farinha de osso. Modele o balde não queimado.",
		"Como: bola de argila + farinha de osso, sem forma. A argila vem do Barril de tensão."
	]
	quest.4200000000020049.title: "Argila de porcelana"
	quest.420000000002004A.quest_desc: [
		"Funda. A porcelana carrega lava onde o ferro ainda é um rumor.",
		"Como: modele a argila de porcelana num balde não queimado e depois funda."
	]
	quest.420000000002004A.title: "Ferramenta de porcelana"
	quest.420000000002004B.quest_desc: [
		"Os Cantores de cascalho nomeavam cada fragmento pelo seu eco.",
		"Peneire até ouvir o ferro.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.420000000002004B.title: "Peneire grânulos caídos"
	quest.420000000002004C.quest_desc: [
		"Um conjunto de pancadas sobrando.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.420000000002004C.title: "Wooden Hammer"
	quest.420000000002004D.quest_desc: [
		"Matéria dos grânulos. Sessenta e quatro pedras que eram pó há uma hora.",
		"Como: lava ao lado da água (ou gelo derretido). Martele a pedra. A banca dos Cantores de cascalho em /clowder hub vende um fardo."
	]
	quest.420000000002004D.title: "Seixos"
	quest.420000000002004E.quest_desc: [
		"O pó do Tear espera no cascalho. O sílex também.",
		"Como: martele pedregulho (Martelo de fuso ou Quebra-eco)."
	]
	quest.420000000002004E.title: "Caminho de cascalho"
	quest.420000000002004F.quest_desc: [
		"Grânulos finos. Vidro mais tarde, e a melhor captura da malha de ferro.",
		"Como: martele cascalho."
	]
	quest.420000000002004F.title: "Estoque de areia"
	quest.4200000000020050.quest_desc: [
		"Cinza do mundo caído. Redstone e pólvora se escondem nela.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.4200000000020050.title: "Pilha de pó"
	quest.4200000000020051.quest_desc: [
		"Novelo ao redor do slime. O composto da plataforma faz o slime.",
		"O Nó é o portão macio do Tear; guarde dois.",
		"Como: anel de Meada do vazio ao redor de uma bola de slime."
	]
	quest.4200000000020051.title: "Amarre um Nó vinculante"
	quest.4200000000020052.quest_desc: [
		"Tábuas ao redor de um Nó. Estique uma malha, carregue grânulos e deixe trabalhar.",
		"Funis a alimentam. É a primeira máquina da plataforma.",
		"Como: tábuas ao redor de um Nó vinculante. Estique uma malha, jogue grânulos com um funil e sente-a sobre um funil."
	]
	quest.4200000000020052.title: "Erga a Armação do tear"
	quest.4200000000020053.quest_desc: [
		"O ferro é grave e paciente. Oito fragmentos da malha.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.4200000000020053.title: "Iron Ore Chunk"
	quest.4200000000020054.quest_desc: [
		"Peneirado do cascalho, aos poucos. A malha acha o cobre antes dos seus olhos.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.4200000000020054.title: "Copper Ore Chunk"
	quest.4200000000020055.quest_desc: [
		"O ouro mal se dá ao trabalho de responder. Quatro bastam.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.4200000000020055.title: "Gold Ore Chunk"
	quest.4200000000020056.quest_desc: [
		"Abasteça a linha.",
		"Como: peneire cascalho, ou funda minério de carvão."
	]
	quest.4200000000020056.title: "Carvão"
	quest.4200000000020057.quest_desc: [
		"De fragmentos a bruto. Continue fundindo.",
		"Como: peneire cascalho para fragmentos de minério de ferro; quatro fazem um bloco de minério de ferro, e minerá-lo solta ferro bruto."
	]
	quest.4200000000020057.title: "Ferro bruto"
	quest.4200000000020058.quest_desc: [
		"Recuperação paga. Dezesseis barras que o vazio não queria que você tivesse.",
		"Como: funda ferro bruto / grânulo de ferro (fornalha ou Forno de brasas). Peneire cascalho para pegar pedaços."
	]
	quest.4200000000020058.title: "Barra de ferro"
	quest.4200000000020059.quest_desc: [
		"Arame e lâmpadas, e ressonadores tribais mais tarde.",
		"Como: funda cobre bruto / grânulo de cobre. Peneire cascalho."
	]
	quest.4200000000020059.title: "Barra de cobre"
	quest.420000000002005A.quest_desc: [
		"Ferramentas douradas, e placas de ouro para os Tecelões de padrões.",
		"Como: funda ouro bruto / grânulo de ouro. Apanho mais raro da peneira."
	]
	quest.420000000002005A.title: "Barra de ouro"
	quest.420000000002005B.quest_desc: [
		"Apanho mais afiado. Malhas de sílex sacodem Fio desfiado para fora dos grânulos.",
		"Como: sílex ao redor de uma malha de Fio (linha)."
	]
	quest.420000000002005B.title: "Malha de sílex"
	quest.420000000002005C.quest_desc: [
		"Fio metálico para o pó mais pesado. As malhas de ferro são onde cai o Filamento de Trama.",
		"Como: ferro ao redor de uma malha de Fio (sílex). O Filamento de Trama começa aqui."
	]
	quest.420000000002005C.title: "Malha de ferro"
	quest.420000000002005D.quest_desc: [
		"Derrete e pinga. De pedregulho a lava, com tempo.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.420000000002005D.title: "Cadinho"
	quest.420000000002005E.quest_desc: [
		"O barril do Ex Deorum: composto, e água em argila pelo caminho lento.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.420000000002005E.title: "Barril (pedra)"
	quest.420000000002005F.quest_desc: [
		"Golpes mais duros, vida mais longa.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.420000000002005F.title: "Stone Hammer"
	quest.4200000000020060.quest_desc: [
		"Esmaga minério em cascalho e grânulos, o truque barulhento por trás da peneira.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.4200000000020060.title: "Iron Hammer"
	quest.4200000000020061.quest_desc: [
		"Malha mais larga, nove de cada vez.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.4200000000020061.title: "Peneira comprimida"
	quest.4200000000020062.quest_desc: [
		"Dá para ver através. De areia a vidro.",
		"Como: funda areia. Martele pedregulho em cascalho, cascalho em areia, depois na fornalha."
	]
	quest.4200000000020062.title: "Vidro"
	quest.4200000000020063.quest_desc: [
		"Agora carregue a chuva em ferro.",
		"Como: três barras de ferro, ou /clowder hub Guardiões da plataforma (8 Fio). Encha a partir de gelo derretido."
	]
	quest.4200000000020063.title: "Balde"
	quest.4200000000020064.quest_desc: [
		"Calor do vazio, na mão.",
		"Como: cadinho de lava do Ex Deorum, ou um lago de lava do Nether depois da obsidiana de Garra."
	]
	quest.4200000000020064.title: "Balde de lava"
	quest.4200000000020065.quest_desc: [
		"Pensamentos de portal. Água sobre uma fonte de lava.",
		"Como: água sobre uma fonte de lava (ou lava sobre água). Mantenha a fonte de lava."
	]
	quest.4200000000020065.title: "Obsidiana"
	quest.4200000000020066.quest_desc: [
		"Sorte rara dos grânulos. Dois já é um começo.",
		"Como: peneire cascalho com uma malha de ferro ou melhor, ou minério de diamante na Quebra-eco."
	]
	quest.4200000000020066.title: "Diamante"
	quest.4200000000020067.quest_desc: [
		"Combustível de melhoria da malha.",
		"Como: cascalho, ou sumidouro de Fio + cascalho."
	]
	quest.4200000000020067.title: "Sílex"
	quest.4200000000020068.quest_desc: [
		"Feita de grânulos e pó, não saqueada de um creeper. Manuseie com cuidado.",
		"Como: peneire pó ou areia das almas, ou creepers na plataforma à noite. Mantenha as bordas iluminadas depois que tiver um pouco."
	]
	quest.4200000000020068.title: "Pólvora"
	quest.4200000000020069.quest_desc: [
		"Centelha vai querer isto. Mantenha seco.",
		"Como: peneire cascalho, ou minério de redstone na Quebra-eco depois de Recuperação."
	]
	quest.4200000000020069.title: "Redstone"
	quest.420000000002006A.quest_desc: [
		"Alimenta a mesa de encantamentos. Pó azul que faz o equipamento escutar melhor.",
		"Como: peneire cascalho, ou minério de lápis-lazúli na Quebra-eco."
	]
	quest.420000000002006A.title: "Lápis-lazúli"
	quest.420000000002006B.quest_desc: [
		"Uma mistura de pedra comum, útil sobretudo para construir e para misturar receitas depois.",
		"Como: peneire seixos de terra/cascalho, ou pedregulho mais diorito no JEI."
	]
	quest.420000000002006B.title: "Andesito"
	quest.420000000002006C.quest_desc: [
		"Pedra salpicada, mais decorativa que estrutural. Os Cantores de cascalho a chamavam de a barulhenta.",
		"Como: peneire seixos, ou pedregulho mais quartzo do Nether."
	]
	quest.420000000002006C.title: "Diorito"
	quest.420000000002006D.quest_desc: [
		"Densa e salpicada de rosa, boa para um chão que quer se destacar.",
		"Como: peneire seixos, ou diorito mais quartzo do Nether."
	]
	quest.420000000002006D.title: "Granito"
	quest.420000000002006E.quest_desc: [
		"Rocha porosa do outro lugar. Queima para sempre assim que pega.",
		"Como: o Nether aqui é vazio, não terreno. Despeje lava num barril do Ex Deorum com água de bruxa (um barril de água sobre micélio; esporos de micélio saem ao peneirar terra)."
	]
	quest.420000000002006E.title: "Rocha do Nether"
	quest.420000000002006F.quest_desc: [
		"Segura cada passo que o cruza e alimenta o fogo das almas com um azul mais frio.",
		"Como: areia num barril do Ex Deorum com água de bruxa. As salas de fungo da fortaleza guardam um pouco. Três crânios sobre areia das almas fazem um Wither."
	]
	quest.420000000002006F.title: "Areia das almas"
	quest.4200000000020070.quest_desc: [
		"Moído da pedra luminosa do Nether, útil para poções e para luzes mais suaves.",
		"Como: peneire areia das almas, ou bruxas na plataforma."
	]
	quest.4200000000020070.title: "Pó de pedra luminosa"
	quest.4200000000020071.quest_desc: [
		"Tira as folhas de uma árvore sem balançar o machado no tronco.",
		"Como: quatro gravetos. A barraca dos Cantores de cascalho vende um."
	]
	quest.4200000000020071.title: "Cajado"
	quest.4200000000020072.quest_desc: [
		"Sai da peneira em pilhas que crescem. Nunca chega de verdade para cada malha.",
		"Como: desfie Fio desfiado (1 → 3). Aranhas. Fiapo do tear numa Amarra de eco. Sumidouro inverso de novelo."
	]
	quest.4200000000020072.title: "Linha"
	quest.4200000000020073.quest_desc: [
		"Ligante de nós — ou receita de composto da plataforma.",
		"Como: duas terras + sementes de trigo + farinha de osso (composto da plataforma), ou /clowder hub Guardiões da plataforma."
	]
	quest.4200000000020073.title: "Bola de slime"
	quest.4200000000020074.quest_desc: [
		"Moído em farinha de osso, ou inteiro para criar o próximo lobo da matilha.",
		"Como: esqueletos à noite, ou /clowder hub Guardiões da plataforma (16 de Fio por 8)."
	]
	quest.4200000000020074.title: "Osso"
	quest.4200000000020075.quest_desc: [
		"Amargo e levemente tóxico. Serve para poções; ninguém come puro.",
		"Como: aranhas na plataforma à noite."
	]
	quest.4200000000020075.title: "Olho de aranha"
	quest.4200000000020076.quest_desc: [
		"Novelo, porcelana, uma Armação do tear funcionando, ferro no baú.",
		"Tensione a Trama: os Cantores de cascalho respondem.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.4200000000020076.quest_subtitle: "Recuperação"
	quest.4200000000020076.title: "Nó de Pedra"
	quest.4200000000020077.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.4200000000020077.title: "Assente Pedra"
	quest.4200000000020078.quest_desc: [
		"Um creeper, resolvido. A pólvora vale mais que o susto.",
		"Como: mate três creepers. A pólvora é a recompensa."
	]
	quest.4200000000020078.title: "Bum, depois"
	quest.4200000000030079.quest_desc: [
		"Risque fileiras na plataforma.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: dois lingotes de ferro sobre um graveto."
	]
	quest.4200000000030079.title: "Enxada de ferro"
	quest.420000000003007A.quest_desc: [
		"Pão é infraestrutura. Trinta e dois trigos são um campo, não um canteiro.",
		"Como: sementes de trigo na terra arada, depois farinha de osso. Sementes ao quebrar grama, ou do baú inicial."
	]
	quest.420000000003007A.title: "Campo de trigo"
	quest.420000000003007B.quest_desc: [
		"Plante o que você come.",
		"Como: quebre grama, ou peneire terra com uma malha de sílex. Plante na terra arada; a farinha de osso acelera o primeiro campo."
	]
	quest.420000000003007B.title: "Bolsa de sementes"
	quest.420000000003007C.quest_desc: [
		"Velocidade é gentileza. Composto e ossos.",
		"Como: ossos numa grade, ou sumidouro de Fio + carne podre, ou /clowder hub Guardiões da plataforma."
	]
	quest.420000000003007C.title: "Motor de farinha de osso"
	quest.420000000003007D.quest_desc: [
		"Prepare a colheita.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000003007D.title: "Faca do fazendeiro"
	quest.420000000003007E.quest_desc: [
		"Uma cozinha começa aqui.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000003007E.title: "Tábua de corte"
	quest.420000000003007F.quest_desc: [
		"Refeições quentes alimentam mais que a fome.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000003007F.title: "Panela"
	quest.4200000000030080.quest_desc: [
		"Cresce em cabeças certinhas, melhor cozida em algo do que crua.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000030080.title: "Repolho"
	quest.4200000000030081.quest_desc: [
		"Sobe na própria treliça e amadurece vermelho. O molho começa aqui.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000030081.title: "Tomate"
	quest.4200000000030082.quest_desc: [
		"Lágrimas de alegria.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000030082.title: "Cebola"
	quest.4200000000030083.quest_desc: [
		"Começa o cultivo de essência. Dezesseis da primeira fileira.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"A espinha das sementes. Peneire ou cultive.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Erga sementes a partir de essência.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030085.title: "Altar de infusão"
	quest.4200000000030086.quest_desc: [
		"Quatro ao redor do altar.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030086.title: "Pedestal de infusão"
	quest.4200000000030087.quest_desc: [
		"Faça crescer mais plataforma.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030087.title: "Sementes de terra"
	quest.4200000000030088.quest_desc: [
		"Faça crescer a copa sem o machado.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030088.title: "Sementes de madeira"
	quest.4200000000030089.quest_desc: [
		"Cultivado, não minerado. Colha essência em vez de balançar uma picareta.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030089.title: "Sementes de pedra"
	quest.420000000003008A.quest_desc: [
		"Metal de um cultivo. O segundo motor da Recuperação.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000003008A.title: "Sementes de ferro"
	quest.420000000003008B.quest_desc: [
		"Um cultivo que rende essência de cobre em vez de minério de cobre.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000003008B.title: "Sementes de cobre"
	quest.420000000003008C.quest_desc: [
		"Um cultivo dourado que faz crescer essência de ouro bem na plataforma.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000003008C.title: "Sementes de ouro"
	quest.420000000003008D.quest_desc: [
		"Transforma um canteiro em fonte de combustível, sem precisar minerar.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000003008D.title: "Sementes de carvão"
	quest.420000000003008E.quest_desc: [
		"Chuva engarrafada, vinda de um cultivo.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000003008E.title: "Sementes de água"
	quest.420000000003008F.quest_desc: [
		"Crescimento compacto para uma plataforma pequena.",
		"Como: Botany Pot de terracota no JEI. Terra + uma semente no vaso; a farinha de osso ainda ajuda."
	]
	quest.420000000003008F.title: "Vaso de Botânica"
	quest.4200000000030090.quest_desc: [
		"O vaso que colhe sozinho.",
		"Como: Botany Pot com funil no JEI. Fica sobre um baú/funil e colhe sozinho."
	]
	quest.4200000000030090.title: "Vaso-funil"
	quest.4200000000030091.quest_desc: [
		"Suba de grau. As sementes ficam mais gulosas e melhores.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"Um grau mais fundo de essência de cultivo, mais forte do que as sementes com que você começou.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Nove farinhas de osso para um bloco. Armazenamento para o motor.",
		"Como: nove farinhas de osso. Ossos de esqueletos ou dos Guardiões da plataforma."
	]
	quest.4200000000030093.title: "Bloco de osso"
	quest.4200000000030094.quest_desc: [
		"Excedente de Broto, empilhado.",
		"Como: nove trigos. Três trigos também fazem pão."
	]
	quest.4200000000030094.title: "Silo de feno"
	quest.4200000000030095.quest_desc: [
		"Melhor terra de cultivo. Os Liga-raízes aprovariam.",
		"Como: coloque Composto orgânico e espere; ele amadurece devagar até virar Solo rico."
	]
	quest.4200000000030095.title: "Solo rico"
	quest.4200000000030096.quest_desc: [
		"Alimente o solo que alimenta você.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000030096.title: "Composto orgânico"
	quest.4200000000030097.quest_desc: [
		"Plante uma fileira, alimente um cavalo ou apenas coma crua.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000030097.title: "Cenoura"
	quest.4200000000030098.quest_desc: [
		"Cultura básica de batata.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000030098.title: "Batata"
	quest.4200000000030099.quest_desc: [
		"Cresce rápido e tinge de vermelho. Sopa, ensopado ou direto do chão.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000030099.title: "Beterraba"
	quest.420000000003009A.quest_desc: [
		"Melancia para comida e trocas.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000003009A.title: "Melancia"
	quest.420000000003009B.quest_desc: [
		"Abóbora para comida e decoração.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000003009B.title: "Abóbora"
	quest.420000000003009C.quest_desc: [
		"Papel e açúcar.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000003009C.title: "Cana-de-açúcar"
	quest.420000000003009D.quest_desc: [
		"Cresce sem água e machuca tudo o que se encosta nele.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000003009D.title: "Cacto"
	quest.420000000003009E.quest_desc: [
		"Sobe rápido e queima quente. Combustível prático para uma plataforma com poucas árvores.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000003009E.title: "Bambu"
	quest.420000000003009F.quest_desc: [
		"Bagas enquanto você constrói.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000003009F.title: "Bagas doces"
	quest.42000000000300A0.quest_desc: [
		"Cultivado em troncos de selva, moído no marrom que tempera tudo o que é doce.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000300A0.title: "Cacau"
	quest.42000000000300A1.quest_desc: [
		"Cai das folhas de carvalho no tempo delas. Comida de graça, mais cedo ou mais tarde.",
		"Como: folhas de carvalho soltam algumas; uma macieira da Pam's (muda de terra com malha de ferro) dá muitas."
	]
	quest.42000000000300A1.title: "Maçã"
	quest.42000000000300A2.quest_desc: [
		"Uma tigela, sem bancada. O jantar do fazendeiro preguiçoso.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000300A2.title: "Ensopado de cogumelos"
	quest.42000000000300A3.quest_desc: [
		"Um gostinho da colmeia antes de começar o trabalho mais fundo com as abelhas.",
		"Como: frasco de vidro numa colmeia cheia. Fogueira embaixo."
	]
	quest.42000000000300A3.title: "Frasco de mel"
	quest.42000000000300A4.quest_desc: [
		"Crescem em trepadeiras de caverna e iluminam o túnel enquanto você as come.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000300A4.title: "Bagas brilhantes"
	quest.42000000000300A5.quest_desc: [
		"A base de toda poção que vale engarrafar. Só cresce em areia das almas.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000300A5.title: "Fungo do Nether"
	quest.42000000000300A6.quest_desc: [
		"Um campo, uma cozinha, essência subindo.",
		"Dê tensão à Trama: os Liga-raízes respondem.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.42000000000300A6.quest_subtitle: "Raiz"
	quest.42000000000300A6.title: "Nó de Broto"
	quest.42000000000300A7.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.42000000000300A7.title: "Assente Broto"
	quest.42000000000300A8.quest_desc: [
		"Os Liga-raízes puxam uma cada um, mais cedo ou mais tarde.",
		"Não a coma. Também não a jogue fora.",
		"Como: uma colheita rara de batata. Segredo opcional de Broto."
	]
	quest.42000000000300A8.title: "Batata errada"
	quest.42000000000400A9.quest_desc: [
		"Corte o vazio do seu jeito. Oito folhas de plantas.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: quatro papéis e um corante azul, sem forma. Rende quatro folhas."
	]
	quest.42000000000400A9.title: "Papel de Projeto"
	quest.42000000000400AA.quest_desc: [
		"Plantas numa caixa.",
		"Quatro Papel de planta, sem forma — reivindicar uma plataforma apaga o presente de entrada do Silent Gear. Clique direito para desembrulhar as plantas iniciais.",
		"Como: quatro Papel de planta, sem forma. Clique direito para desembrulhar as plantas iniciais. Reivindicar uma plataforma apaga o presente de entrada do Silent Gear."
	]
	quest.42000000000400AA.title: "Pacote de Projetos"
	quest.42000000000400AB.quest_desc: [
		"O modelo de onde começa uma ferramenta modular, antes de você pôr as peças.",
		"Como: desembrulhe o Pacote de plantas, ou JEI. Garra nomeia a linha de ferramentas."
	]
	quest.42000000000400AB.title: "Planta de haste"
	quest.42000000000400AC.quest_desc: [
		"Forme uma picareta que dura mais que o próprio metal.",
		"Como: desembrulhe o Pacote de plantas, ou JEI. Garra nomeia a linha de ferramentas."
	]
	quest.42000000000400AC.title: "Planta de picareta"
	quest.42000000000400AD.quest_desc: [
		"Forme um machado.",
		"Como: desembrulhe o Pacote de plantas, ou JEI. Garra nomeia a linha de ferramentas."
	]
	quest.42000000000400AD.title: "Planta de machado"
	quest.42000000000400AE.quest_desc: [
		"Forme uma pá.",
		"Como: desembrulhe o Pacote de plantas, ou JEI. Garra nomeia a linha de ferramentas."
	]
	quest.42000000000400AE.title: "Planta de pá"
	quest.42000000000400AF.quest_desc: [
		"Forme uma lâmina.",
		"Como: desembrulhe o Pacote de plantas, ou JEI. Garra nomeia a linha de ferramentas."
	]
	quest.42000000000400AF.title: "Planta de espada"
	quest.42000000000400B0.quest_desc: [
		"Espaço para crescer.",
		"Como: JEI depois do Papel de planta. Garra nomeia a linha de melhorias."
	]
	quest.42000000000400B0.title: "Base de melhoria"
	quest.42000000000400B1.quest_desc: [
		"Trinta e duas barras de material para as peças.",
		"Como: funda ferro bruto / grânulo de ferro (fornalha ou Forno de brasas). Peneire cascalho para pegar pedaços."
	]
	quest.42000000000400B1.title: "Massa de ferro"
	quest.42000000000400B2.quest_desc: [
		"Afia o fio além do que o ferro sozinho consegue.",
		"Como: peneire cascalho com uma malha de ferro ou melhor, ou minério de diamante na Quebra-eco."
	]
	quest.42000000000400B2.title: "Ponta de diamante"
	quest.42000000000400B3.quest_desc: [
		"Folhas e lã, e favos depois.",
		"Como: duas barras de ferro na diagonal. Tosquie ovelhas e ninhos de abelha."
	]
	quest.42000000000400B3.title: "Tesoura"
	quest.42000000000400B4.quest_desc: [
		"As plataformas têm bordas. Os monstros também.",
		"Como: seis tábuas em volta do ferro. Bloqueio na mão secundária."
	]
	quest.42000000000400B4.title: "Escudo"
	quest.42000000000400B5.quest_desc: [
		"Sobreviva à noite de propósito.",
		"Como: oito barras de ferro. Funda cascalho de peneira."
	]
	quest.42000000000400B5.title: "Peitoral de ferro"
	quest.42000000000400B6.quest_desc: [
		"Cuidado com a queda.",
		"Como: cinco barras de ferro."
	]
	quest.42000000000400B6.title: "Capacete de ferro"
	quest.42000000000400B7.quest_desc: [
		"Cobre as pernas primeiro. A maior parte do dano vem de baixo, de qualquer modo.",
		"Como: sete barras de ferro."
	]
	quest.42000000000400B7.title: "Calças de ferro"
	quest.42000000000400B8.quest_desc: [
		"Firma o passo nas beiradas onde um escorregão é o vazio.",
		"Como: quatro barras de ferro."
	]
	quest.42000000000400B8.title: "Botas de ferro"
	quest.42000000000400B9.quest_desc: [
		"Mantenha os monstros do vazio à distância.",
		"Como: três linhas e três gravetos."
	]
	quest.42000000000400B9.title: "Arco"
	quest.42000000000400BA.quest_desc: [
		"Sessenta e quatro razões para manter distância.",
		"Como: pederneira, graveto, pena. Esqueletos largam extras."
	]
	quest.42000000000400BA.title: "Feixe de flechas"
	quest.42000000000400BB.quest_desc: [
		"Ilumine a passagem.",
		"Como: barra de ferro mais pederneira."
	]
	quest.42000000000400BB.title: "Isqueiro"
	quest.42000000000400BC.quest_desc: [
		"Dez blocos. Uma porta que os Anda-bordas reconheceriam.",
		"Como: água sobre uma fonte de lava (ou lava sobre água). Mantenha a fonte de lava."
	]
	quest.42000000000400BC.title: "Moldura de obsidiana"
	quest.42000000000400BD.quest_desc: [
		"Preparo de um apoio. Existe outro lugar.",
		"Como: pérola de ender (banca dos Anda-bordas / endermen) mais pó de blaze de uma fortaleza do Nether, depois da obsidiana de Garra. O estoque de oito olhos é opcional; cristais do End usam a mesma fabricação."
	]
	quest.42000000000400BD.title: "Olho de ender"
	quest.42000000000400BE.quest_desc: [
		"Poder macio para ferramentas duras.",
		"Como: dois diamantes, quatro obsidiana, livro. Diamantes do cascalho com malha de ferro."
	]
	quest.42000000000400BE.title: "Mesa de encantamentos"
	quest.42000000000400BF.quest_desc: [
		"Repare e dê nome ao que você carrega.",
		"Como: três blocos de ferro sobre quatro barras."
	]
	quest.42000000000400BF.title: "Bigorna"
	quest.42000000000400C0.quest_desc: [
		"Chame de seu.",
		"Como: pesca / baús raros, ou a banca dos Entalhadores de selos em /clowder hub (24 Fio). Opcional."
	]
	quest.42000000000400C0.title: "Etiqueta"
	quest.42000000000400C1.quest_desc: [
		"O modelo inicial de uma enxada modular, feita peça por peça.",
		"Como: desembrulhe o Pacote de plantas, ou JEI."
	]
	quest.42000000000400C1.title: "Planta de enxada"
	quest.42000000000400C2.quest_desc: [
		"Limpa uma faixa larga de plantações num golpe, em vez de uma planta.",
		"Como: desembrulhe o Pacote de plantas, ou JEI."
	]
	quest.42000000000400C2.title: "Planta de foice"
	quest.42000000000400C3.quest_desc: [
		"Uma ferramenta que mina, corta e cava. Sem mais trocar na mão.",
		"Como: desembrulhe o Pacote de plantas, ou JEI."
	]
	quest.42000000000400C3.title: "Planta de Paxel"
	quest.42000000000400C4.quest_desc: [
		"Quebra pedra em três por três num só golpe.",
		"Como: desembrulhe o Pacote de plantas, ou JEI."
	]
	quest.42000000000400C4.title: "Planta de martelo"
	quest.42000000000400C5.quest_desc: [
		"Abre buracos largos em terra e areia mais rápido que qualquer pá.",
		"Como: desembrulhe o Pacote de plantas, ou JEI."
	]
	quest.42000000000400C5.title: "Planta de escavador"
	quest.42000000000400C6.quest_desc: [
		"Pequeno, rápido e preciso. Feito para o trabalho de perto, não para a guerra.",
		"Como: desembrulhe o Pacote de plantas, ou JEI."
	]
	quest.42000000000400C6.title: "Planta de faca"
	quest.42000000000400C7.quest_desc: [
		"Revestimento macio, fácil de encantar, que vale mais pela magia do que pela defesa.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000400C7.title: "Peças de armadura de ouro"
	quest.42000000000400C8.quest_desc: [
		"Garra do mar.",
		"Opcional — o vazio pode nunca te oferecer um.",
		"Como: só afogados. Opcional."
	]
	quest.42000000000400C8.title: "Tridente"
	quest.42000000000400C9.quest_desc: [
		"Carrega devagar, acerta forte e segura a carga até você precisar.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000400C9.title: "Besta"
	quest.42000000000400CA.quest_desc: [
		"Vasculhe o vazio.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000400CA.title: "Luneta"
	quest.42000000000400CB.quest_desc: [
		"Plantas, ferro nas costas, uma porta para fora.",
		"Tensione a Trama: os Anda-bordas respondem. A trança se abre.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.42000000000400CB.quest_subtitle: "Borda"
	quest.42000000000400CB.title: "Nó de Garra"
	quest.42000000000400CC.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.42000000000400CC.title: "Assente Garra"
	quest.42000000000400CD.quest_desc: [
		"Algo alto olhou de volta. Os Anda-bordas os chamavam de guardas das portas.",
		"Como: mate um enderman. Pérolas de ender também vêm da banca dos Anda-bordas."
	]
	quest.42000000000400CD.title: "Borda da Borda"
	quest.42000000000500CE.quest_desc: [
		"Um sinal breve antes do Zumbido. Sessenta e quatro de pó.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: peneire cascalho, ou minério de redstone na Quebra-eco depois de Recuperação."
	]
	quest.42000000000500CE.title: "Pó de redstone"
	quest.42000000000500CF.quest_desc: [
		"Calor em paralelo. Oito é uma linha, não uma fornalha.",
		"Como: oito pedregulhos ao redor de um centro vazio."
	]
	quest.42000000000500CF.title: "Fileira de fornalhas"
	quest.42000000000500D0.quest_desc: [
		"Mova os grânulos sem as mãos.",
		"Como: cinco ferros ao redor de um baú. Ponha-o sob uma Armação do tear ou um Barril de tensão (extrai para BAIXO)."
	]
	quest.42000000000500D0.title: "Linha de funis"
	quest.42000000000500D1.quest_desc: [
		"Meça a batida.",
		"Como: quartzo do Nether, tocha de redstone, pedra. O quartzo sai da peneira na areia das almas; sem viagem ao Nether."
	]
	quest.42000000000500D1.title: "Comparador"
	quest.42000000000500D2.quest_desc: [
		"Osso, linha, ametista. A primeira batida.",
		"Rende dois — guarde um para o Códice dos Espíritos.",
		"Como: um osso, linha, ametista. /clowder hub Os Guardiões da plataforma vendem ossos. Portão Centelha / Zumbido."
	]
	quest.42000000000500D2.title: "Zumbido: Carrilhão de osso"
	quest.42000000000500D3.quest_desc: [
		"Uma lasca de um canto antigo da tribo. Precisa de um carrilhão.",
		"Como: Carrilhão de osso, ametista e redstone, sem forma. Rende dois."
	]
	quest.42000000000500D3.title: "Zumbido: Lasca espiritual"
	quest.42000000000500D4.quest_desc: [
		"Cobre ao redor de um carrilhão: metal afinado ao espírito.",
		"Como: cobre ao redor de um Carrilhão de osso. Rende dois."
	]
	quest.42000000000500D4.title: "Zumbido: Ressonador de cobre"
	quest.42000000000500D5.quest_desc: [
		"Golpeie. Segure um Pulso. Escute antes de ligar qualquer fio.",
		"Dois carrilhões, uma lasca, dois couros, quatro tábuas — os Guardiões da plataforma em /clowder hub vendem couro.",
		"Como: dois Carrilhões de osso, uma Lasca espiritual, dois couros e quatro tábuas. Golpeie de mãos vazias no tempo (17–23 ticks) para 24 de Pulso."
	]
	quest.42000000000500D5.title: "Zumbido: Coração de tambor"
	quest.42000000000500D6.quest_desc: [
		"Carregue Pulso para ferramentas, feitiços e viagem — precisa de Ressonador + Lasca.",
		"Como: fabrique e depois encha a partir de um Coração de tambor (clique com a célula). Ferramentas, feitiços e viagem puxam da célula."
	]
	quest.42000000000500D6.title: "Zumbido: Célula de Pulso"
	quest.42000000000500D7.quest_desc: [
		"Puxe a ley do ambiente para batidas sob céu aberto. As vozes dos totens somam; um Coração de tambor não é preciso.",
		"Como: coloque sob o céu, perto de água/verde. Pulso lento. Escada de Centelha."
	]
	quest.42000000000500D7.title: "Zumbido: Coletor de ley"
	quest.42000000000500D8.quest_desc: [
		"Assente um catalisador de eco (ele se desgasta enquanto trabalha) e dois totens elementais diferentes. O acampamento canta o próprio poder; a redstone pausa a harmonia.",
		"Como: assente um catalisador de eco e dois totens diferentes em até 8. A redstone o pausa."
	]
	quest.42000000000500D8.title: "Zumbido: Ressonador de Pulso"
	quest.42000000000500D9.quest_desc: [
		"Um reservatório de Energia de Forge — a ponte do Pulso ao fio, se você quiser uma.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500D9.title: "Célula inicial da Powah"
	quest.42000000000500DA.quest_desc: [
		"Queime combustível para Energia de Forge.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500DA.title: "Queimador Powah"
	quest.42000000000500DB.quest_desc: [
		"Leve a energia adiante.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500DB.title: "Cabo Powah"
	quest.42000000000500DC.quest_desc: [
		"Energia do céu, numa plataforma que é só céu.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500DC.title: "Painel solar inicial"
	quest.42000000000500DD.quest_desc: [
		"Queima uma diferença de calor em energia. Alimente-o quente de um lado, frio do outro.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500DD.title: "Gerador térmico"
	quest.42000000000500DE.quest_desc: [
		"Carrega itens num anel de varas.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500DE.title: "Orbe energizante"
	quest.42000000000500DF.quest_desc: [
		"Alimente o orbe.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500DF.title: "Vara energizante"
	quest.42000000000500E0.quest_desc: [
		"Um punhado de energia guardada.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500E0.title: "Bateria"
	quest.42000000000500E1.quest_desc: [
		"Gira as máquinas no lugar, em vez de quebrá-las e recolocá-las.",
		"Como: capítulo Rede Powah — orbe energizante e cabos, depois que o Pulso de Centelha existir."
	]
	quest.42000000000500E1.title: "Chave inglesa"
	quest.42000000000500E2.quest_desc: [
		"Funde minério duas vezes mais rápido que uma fornalha comum, só minério.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500E2.title: "Alto-forno"
	quest.42000000000500E3.quest_desc: [
		"Cozinha carne duas vezes mais rápido que uma fogueira, só comida.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500E3.title: "Defumador"
	quest.42000000000500E4.quest_desc: [
		"Nove carvões prensados, densos. Um bloco dura mais que uma pilha inteira de pedaços.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500E4.title: "Bloco de carvão (Centelha)"
	quest.42000000000500E5.quest_desc: [
		"Cutuca um item de cada vez para o que estiver na frente.",
		"Como: pedregulho ao redor de redstone."
	]
	quest.42000000000500E5.title: "Liberador"
	quest.42000000000500E6.quest_desc: [
		"Empurre com intenção.",
		"Como: pedregulho, arco e redstone."
	]
	quest.42000000000500E6.title: "Ejetor"
	quest.42000000000500E7.quest_desc: [
		"Empurra um bloco para a frente com um sinal e depois espera o próximo.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500E7.title: "Pistão"
	quest.42000000000500E8.quest_desc: [
		"Empurra um bloco e o puxa de volta quando o sinal cai.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500E8.title: "Pistão grudento"
	quest.42000000000500E9.quest_desc: [
		"O observador lê o pulso.",
		"Como: pedregulho, redstone e quartzo do Nether."
	]
	quest.42000000000500E9.title: "Observador"
	quest.42000000000500EA.quest_desc: [
		"O repetidor temporiza o circuito.",
		"Como: tocha de redstone, redstone, pedra. O capítulo dos tubos usa isso para relógios."
	]
	quest.42000000000500EA.title: "Repetidor"
	quest.42000000000500EB.quest_desc: [
		"Registra um acerto com força de sinal conforme o quão perto do centro.",
		"Como: redstone ao redor do feno. Feno é três trigos."
	]
	quest.42000000000500EB.title: "Alvo"
	quest.42000000000500EC.quest_desc: [
		"Desvia um raio do seu telhado e aterra a carga.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500EC.title: "Para-raios"
	quest.42000000000500ED.quest_desc: [
		"Hora da energia.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500ED.title: "Relógio"
	quest.42000000000500EE.quest_desc: [
		"Luz sem tochas.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500EE.title: "Lâmpada de cobre"
	quest.42000000000500EF.quest_desc: [
		"Acende com um sinal e apaga no instante em que ele para.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500EF.title: "Lâmpada de redstone"
	quest.42000000000500F0.quest_desc: [
		"Lê o céu e manda um sinal que sobe e desce com o sol.",
		"Como: vidro, quartzo do Nether, lajes de madeira."
	]
	quest.42000000000500F0.title: "Detector de luz solar"
	quest.42000000000500F1.quest_desc: [
		"Liga ou desliga um sinal à mão. O interruptor mais antigo que existe.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F1.title: "Alavanca"
	quest.42000000000500F2.quest_desc: [
		"O botão dá um toque de redstone.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F2.title: "Botão"
	quest.42000000000500F3.quest_desc: [
		"Manda um sinal quando algo mais pesado que o ar fica em cima.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F3.title: "Placa de pressão"
	quest.42000000000500F4.quest_desc: [
		"Estendida com linha através de um caminho, pega tudo o que cruza.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F4.title: "Gancho de armadilha"
	quest.42000000000500F5.quest_desc: [
		"Toca uma nota por tipo de bloco embaixo. Os Corações de tambor ouvem uma canção numa fileira deles.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F5.title: "Bloco musical"
	quest.42000000000500F6.quest_desc: [
		"Jukebox para o ânimo da plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F6.title: "Jukebox"
	quest.42000000000500F7.quest_desc: [
		"Rola com a gravidade ou um empurrão. Sem trilhos, sem viagem.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F7.title: "Carrinho de mina"
	quest.42000000000500F8.quest_desc: [
		"Trilhos através do vão do vazio.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F8.title: "Trilho"
	quest.42000000000500F9.quest_desc: [
		"Trilho elétrico para carrinhos.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500F9.title: "Trilho elétrico"
	quest.42000000000500FA.quest_desc: [
		"Lê um carrinho que passa e dispara um sinal quando ele rola por cima.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000500FA.title: "Trilho detector"
	quest.42000000000500FB.quest_desc: [
		"Fabricação solar alternativa.",
		"Como: três vidros, três lápis-lazúlis e três Espelhos, uma fileira de cada."
	]
	quest.42000000000500FB.title: "Célula Solar Flux"
	quest.42000000000500FC.quest_desc: [
		"Tubos de itens simples.",
		"Como: ferro + redstone. Ajuste as faces com a chave inglesa Pipez."
	]
	quest.42000000000500FC.title: "Pipez de itens"
	quest.42000000000500FD.quest_desc: [
		"Tubos de fluidos simples.",
		"Como: ferro + baldes + redstone. Uso agachado da chave inglesa num lado para extrair; clique direito nesse lado para os filtros."
	]
	quest.42000000000500FD.title: "Pipez de fluidos"
	quest.42000000000500FE.quest_desc: [
		"Tubos de energia comuns entre as máquinas.",
		"Como: ferro + redstone. Leva FE entre máquinas."
	]
	quest.42000000000500FE.title: "Pipez de energia"
	quest.42000000000500FF.quest_desc: [
		"Define quais lados do tubo extraem de uma máquina, ou corta um lado, sem quebrar o tubo.",
		"Como: dois sílex e dois gravetos. Uso agachado num lado do tubo numa máquina para extrair, de novo para cortar; clique direito num lado que extrai para os filtros."
	]
	quest.42000000000500FF.title: "Chave inglesa Pipez"
	quest.4200000000050100.quest_desc: [
		"Marca linhas da treliça — precisa de uma Lasca espiritual.",
		"Como: duas farinhas de osso, lápis-lazúli e uma Lasca espiritual, sem forma. Rende quatro."
	]
	quest.4200000000050100.title: "Giz ritual"
	quest.4200000000050101.quest_desc: [
		"Um tambor golpeado, um Pulso segurado, um Ressonador assentado.",
		"Dê tensão à Trama: os Corações de tambor respondem.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.4200000000050101.quest_subtitle: "Zumbido"
	quest.4200000000050101.title: "Nó de Centelha"
	quest.4200000000050102.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.4200000000050102.title: "Assente Centelha"
	quest.4200000000050103.quest_desc: [
		"Siga o Tecido tribal pelo refino de eco até um Núcleo ressonante. O Energizador harmônico transforma a harmonia do acampamento em FE para as máquinas deste capítulo. A conversão sem grau é 60 de Pulso por segundo; aumente o grau nas estações de eco para obter mais. Ele não pode receber FE. A redstone pausa a conversão e a exportação.",
		"Como: cinco lingotes de cobre, três redstone e um Núcleo ressonante."
	]
	quest.4200000000050103.title: "O zumbido vira corrente"
	quest.4200000000050104.quest_desc: [
		"Uma bruxa, na sua plataforma, à noite. Os tambores não avisaram você.",
		"Como: mate uma bruxa na plataforma à noite."
	]
	quest.4200000000050104.title: "Encrenca engarrafada"
	quest.4200000000060105.quest_desc: [
		"Mãos que trabalham enquanto você dorme. Trinta e dois.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: andesito + pepita de ferro numa bancada de trabalho (ou misturador)."
	]
	quest.4200000000060105.title: "Liga de andesito"
	quest.4200000000060106.quest_desc: [
		"A espinha dorsal da rotação.",
		"Como: liga de andesito numa receita de corte / fabricação, listada no JEI."
	]
	quest.4200000000060106.title: "Eixo"
	quest.4200000000060107.quest_desc: [
		"Uma engrenagem. Depois a mesma engrenagem de novo.",
		"Como: eixo + tábuas."
	]
	quest.4200000000060107.title: "Engrenagem"
	quest.4200000000060108.quest_desc: [
		"Mais dentes, giro mais lento.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.4200000000060108.title: "Engrenagem grande"
	quest.4200000000060109.quest_desc: [
		"O invólucro de andesito é a moldura do Create.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.4200000000060109.title: "Revestimento de Andesito"
	quest.420000000006010A.quest_desc: [
		"Um rio no céu, girando.",
		"Como: oito tábuas ao redor de um eixo. Precisa de um fluxo de água ao lado."
	]
	quest.420000000006010A.title: "Roda d'água"
	quest.420000000006010B.quest_desc: [
		"Gera rotação à mão quando nada mais está girando ainda.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.420000000006010B.title: "Manivela"
	quest.420000000006010C.quest_desc: [
		"Moa cascalho até virar pó, sem martelo.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.420000000006010C.title: "Moedor"
	quest.420000000006010D.quest_desc: [
		"A bacia segura a mistura do Create.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.420000000006010D.title: "Bacia"
	quest.420000000006010E.quest_desc: [
		"Placas e caminhos.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.420000000006010E.title: "Prensa mecânica"
	quest.420000000006010F.quest_desc: [
		"Receitas em massa, rápido.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.420000000006010F.title: "Batedeira Mecânica"
	quest.4200000000060110.quest_desc: [
		"Uma superfície plana que segura um item parado para a correia ou a prensa.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.4200000000060110.title: "Depósito"
	quest.4200000000060111.quest_desc: [
		"As correias movem itens ao longo dos eixos.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.4200000000060111.title: "Conector de correia"
	quest.4200000000060112.quest_desc: [
		"Solta itens direto para baixo entre máquinas, sem precisar de correia.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.4200000000060112.title: "Calha"
	quest.4200000000060113.quest_desc: [
		"Lavagem, secagem e cascalho em areia.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.4200000000060113.title: "Ventilador revestido"
	quest.4200000000060114.quest_desc: [
		"Uma mão num eixo.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.4200000000060114.title: "Implantador"
	quest.4200000000060115.quest_desc: [
		"Corta troncos em tábuas, ou árvores em madeira, se houver rotação suficiente.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.4200000000060115.title: "Serra mecânica"
