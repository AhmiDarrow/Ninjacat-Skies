	quest.42000000001F04D1.quest_desc: [
		"Empacota os itens do lado do Create do jeito mecânico.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.42000000001F04D1.title: "Empacotador do Create"
	quest.42000000001F04D2.quest_desc: [
