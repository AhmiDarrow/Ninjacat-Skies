	quest.42000000001903A9.title: "Incubadora (Apiário)"
	quest.42000000001903AA.quest_desc: [
		"Pareia duas abelhas e produz crias com traços misturados.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903AA.title: "Câmara de criação (Apiário)"
	quest.42000000001903AB.quest_desc: [
		"Lê os traços de uma abelha e os anota para a criação.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903AB.title: "Indexador de genes (Apiário)"
	quest.42000000001903AC.quest_desc: [
		"Queima mel para um fio lento e constante de energia.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903AC.title: "Gerador de mel (Apiário)"
	quest.42000000001903AD.quest_desc: [
		"Um lanche que mantém uma abelha enjaulada calma e saudável.",
		"Como: favo de mel mais um frasco de mel, sem forma."
	]
	quest.42000000001903AD.title: "Guloseima de mel (Apiário)"
	quest.42000000001903AE.quest_desc: [
		"Um balde cheio de mel, pronto para despejar ou queimar.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903AE.title: "Balde de mel"
	quest.42000000001903AF.quest_desc: [
		"Derrete para velas, ou sela o quadro de uma colmeia.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903AF.title: "Estoque de cera"
	quest.42000000001903B0.quest_desc: [
		"Um favo de mel que dá para ajustar a qualquer abelha.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903B0.title: "Favo configurável"
	quest.42000000001903B1.quest_desc: [
		"Os traços de uma abelha, extraídos e prontos para engarrafar.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903B1.title: "Amostra de gene"
	quest.42000000001903B2.quest_desc: [
		"A genética de uma abelha, guardada para criar depois.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903B2.title: "Frasco de genes"
	quest.42000000001903B3.quest_desc: [
		"Quatro favos prensados até ficar sólido, sobretudo para construir.",
		"Como: quatro favos de mel."
	]
	quest.42000000001903B3.title: "Bloco de favo de mel"
	quest.42000000001903B4.quest_desc: [
		"Desacelera quedas e movimento. Pegajoso sob os pés, doce num funil.",
		"Como: quatro frascos de mel. Os frascos voltam."
	]
	quest.42000000001903B4.title: "Bloco de mel (apiário)"
	quest.42000000001903B5.quest_desc: [
		"Uma colmeia selvagem. Defume-a até acalmar, antes de pegar o favo.",
		"Como: três favos de mel e seis tábuas. Uma fogueira embaixo as acalma."
	]
	quest.42000000001903B5.title: "Colmeia do jogo base"
	quest.42000000001903B6.quest_desc: [
		"A fumaça vinda de baixo mantém as abelhas calmas na colheita.",
		"Como: troncos, gravetos e carvão ou carvão vegetal."
	]
	quest.42000000001903B6.title: "Fogueira embaixo"
	quest.42000000001903B7.quest_desc: [
		"Flores para o trabalho das abelhas.",
		"Como: farinha de osso na grama, ou uma flor pequena para o ninho de carvalho."
	]
	quest.42000000001903B7.title: "Tapete de flores"
	quest.42000000001903B8.quest_desc: [
		"Mais flores por perto significa mais pólen para a colmeia.",
		"Como: farinha de osso na grama. As abelhas querem qualquer flor pequena."
	]
	quest.42000000001903B8.title: "Campo de dentes-de-leão"
	quest.42000000001903B9.quest_desc: [
		"Uma flor mais vistosa, que algumas abelhas preferem aos dentes-de-leão.",
		"Como: musgo mais carvalho, ou farinha de osso no musgo. As abelhas aceitam a flor."
	]
	quest.42000000001903B9.title: "Florada de azaleia"
	quest.42000000001903BA.quest_desc: [
		"Uma fruta do End da qual algumas abelhas coletam de bom grado.",
		"Como: banca dos Anda-bordas em /clowder hub. As ilhas externas do End se foram."
	]
	quest.42000000001903BA.title: "Lanche do coro"
	quest.42000000001903BB.quest_desc: [
		"Um favorito estranho para algumas das abelhas mais resistentes.",
		"Como: água sobre uma fonte de lava (ou lava sobre água). Mantenha a fonte de lava."
	]
	quest.42000000001903BB.title: "Guloseima de obsidiana"
	quest.42000000001903BC.quest_desc: [
		"Mais cômodos para a colmeia, desta vez cortados de bétula.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903BC.title: "Expansão de bétula"
	quest.42000000001903BD.quest_desc: [
		"Cômodos revestidos de pinheiro, aparafusados na colmeia.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903BD.title: "Expansão de pinheiro"
	quest.42000000001903BE.quest_desc: [
		"Revestimento de carvalho escuro, o mesmo fim: mais cômodos para as abelhas.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903BE.title: "Expansão de carvalho escuro"
	quest.42000000001903BF.quest_desc: [
		"Cômodos de acácia para uma colmeia que cresceu além de si.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903BF.title: "Expansão de acácia"
	quest.42000000001903C0.quest_desc: [
		"Cômodos de madeira da selva, tão espaçosos quanto os outros.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903C0.title: "Expansão da selva"
	quest.42000000001903C1.quest_desc: [
		"Cômodos revestidos de cerejeira, só questão de estilo.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903C1.title: "Expansão de cerejeira"
	quest.42000000001903C2.quest_desc: [
		"Cômodos revestidos de carmesim para uma colmeia que foi para o Nether.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903C2.title: "Expansão carmesim"
	quest.42000000001903C3.quest_desc: [
		"Cômodos revestidos de distorcido, a metade azul do par.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903C3.title: "Expansão distorcida"
	quest.42000000001903C4.quest_desc: [
		"Cômodos de bambu, mais leves e igualmente úteis.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903C4.title: "Expansão de bambu"
	quest.42000000001903C5.quest_desc: [
		"Cômodos de mangue, a madeira mais nova da lista.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.42000000001903C5.title: "Expansão de mangue"
	quest.42000000001903C6.quest_desc: [
		"Mel que você bebe direto do frasco.",
		"Como: frasco de vidro numa colmeia cheia. Fogueira embaixo."
	]
	quest.42000000001903C6.title: "Estoque de frascos de mel"
	quest.42000000001903C7.quest_desc: [
		"Vira guloseimas e bolos para um Clowder com fome.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001903C7.title: "Estoque de açúcar"
	quest.42000000001903C8.quest_desc: [
		"Vazios, à espera de mel, poções ou experiência.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001903C8.title: "Estoque de frascos"
	quest.42000000001903C9.quest_desc: [
		"Um par reserva para cortar o favo sem machucar as abelhas.",
		"Como: duas barras de ferro na diagonal. Tosquie ovelhas e ninhos de abelha."
	]
	quest.42000000001903C9.title: "Tesoura reserva"
	quest.42000000001A03CA.quest_desc: [
		"Um bloco que move itens para onde você mandar — o sistema nervoso da plataforma.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: lingotes de ferro e barras de ferro ao redor de um módulo em branco; rende quatro. Os módulos vão no roteador."
	]
	quest.42000000001A03CA.title: "Modular Router"
	quest.42000000001A03CB.quest_desc: [
		"O cartão em que se escreve cada comportamento do roteador.",
		"Como: Roteador modular mais módulos em branco no JEI. Puxador/enviador/quebrador ficam no roteador."
	]
	quest.42000000001A03CB.title: "Blank Module"
	quest.42000000001A03CC.quest_desc: [
		"Puxa itens de um vizinho para dentro do roteador.",
		"Como: Roteador modular mais módulos em branco no JEI. Puxador/enviador/quebrador ficam no roteador."
	]
	quest.42000000001A03CC.title: "Módulo puxador"
	quest.42000000001A03CD.quest_desc: [
		"Empurre itens até um ponto marcado do outro lado da plataforma.",
		"Como: Roteador modular mais módulos em branco no JEI. Puxador/enviador/quebrador ficam no roteador."
	]
	quest.42000000001A03CD.title: "Módulo emissor"
	quest.42000000001A03CE.quest_desc: [
		"Quebre um bloco na frente do roteador e fique com o que cair.",
		"Como: Roteador modular mais módulos em branco no JEI. Puxador/enviador/quebrador ficam no roteador."
	]
	quest.42000000001A03CE.title: "Breaker Module"
	quest.42000000001A03CF.quest_desc: [
		"Coloque um bloco para onde o roteador aponta.",
		"Como: Roteador modular mais módulos em branco no JEI. Puxador/enviador/quebrador ficam no roteador."
	]
	quest.42000000001A03CF.title: "Placer Module"
	quest.42000000001A03D0.quest_desc: [
		"Emita redstone quando o conteúdo do roteador passar de um limite.",
		"Como: Roteador modular mais módulos em branco no JEI. Puxador/enviador/quebrador ficam no roteador."
	]
	quest.42000000001A03D0.title: "Detector Module"
	quest.42000000001A03D1.quest_desc: [
		"Leva itens entre baús, máquinas e plataformas.",
		"Como: ferro + redstone. Ajuste as faces com a chave inglesa Pipez."
	]
	quest.42000000001A03D1.title: "Tubo de itens"
	quest.42000000001A03D2.quest_desc: [
		"Leva líquidos entre tanques e máquinas, sem corrida de balde.",
		"Como: ferro + baldes + redstone. Uso agachado da chave inglesa num lado para extrair; clique direito nesse lado para os filtros."
	]
	quest.42000000001A03D2.title: "Tubo de Fluido"
	quest.42000000001A03D3.quest_desc: [
		"Leva energia entre as máquinas que a fazem e as que precisam dela.",
		"Como: ferro + redstone. Leva FE entre máquinas."
	]
	quest.42000000001A03D3.title: "Tubo de energia"
	quest.42000000001A03D4.quest_desc: [
		"Leva químicos entre as máquinas que lidam com eles.",
		"Como: tubos de ferro + redstone no JEI. Uso agachado da chave inglesa para marcar os lados que extraem; clique direito em um para os filtros. O capítulo dos tubos é a escada toda."
	]
	quest.42000000001A03D4.title: "Tubo de gás"
	quest.42000000001A03D5.quest_desc: [
		"Um tubo, muitas tarefas.",
		"Como: tubos de ferro + redstone no JEI. Uso agachado da chave inglesa para marcar os lados que extraem; clique direito em um para os filtros. O capítulo dos tubos é a escada toda."
	]
	quest.42000000001A03D5.title: "Tubo universal"
	quest.42000000001A03D6.quest_desc: [
		"Use agachado um lado do tubo para que ele puxe de uma máquina, ou para cortá-lo.",
		"Como: dois sílex e dois gravetos. Uso agachado num lado do tubo numa máquina para extrair, de novo para cortar; clique direito num lado que extrai para os filtros."
	]
	quest.42000000001A03D6.title: "Chave de Tubos"
	quest.42000000001A03D7.quest_desc: [
		"Melhoria de velocidade para um tubo.",
		"Como: tubos de ferro + redstone no JEI. Uso agachado da chave inglesa para marcar os lados que extraem; clique direito em um para os filtros. O capítulo dos tubos é a escada toda."
	]
	quest.42000000001A03D7.title: "Melhoria básica"
	quest.42000000001A03D8.quest_desc: [
		"Encaixe-a num tubo para mover mais por tick.",
		"Como: tubos de ferro + redstone no JEI. Uso agachado da chave inglesa para marcar os lados que extraem; clique direito em um para os filtros. O capítulo dos tubos é a escada toda."
	]
	quest.42000000001A03D8.title: "Melhoria aprimorada"
	quest.42000000001A03D9.quest_desc: [
		"Uma melhoria mais forte, para uma linha sob carga pesada.",
		"Como: tubos de ferro + redstone no JEI. Uso agachado da chave inglesa para marcar os lados que extraem; clique direito em um para os filtros. O capítulo dos tubos é a escada toda."
	]
	quest.42000000001A03D9.title: "Melhoria avançada"
	quest.42000000001A03DA.quest_desc: [
		"O degrau mais alto de vazão do Pipez.",
		"Como: tubos de ferro + redstone no JEI. Uso agachado da chave inglesa para marcar os lados que extraem; clique direito em um para os filtros. O capítulo dos tubos é a escada toda."
	]
	quest.42000000001A03DA.title: "Melhoria suprema"
	quest.42000000001A03DB.quest_desc: [
		"Remova os tetos de vazão do Pipez.",
		"Como: só no criativo; o Pipez não tem receita de sobrevivência para isso. Opcional."
	]
	quest.42000000001A03DB.title: "Melhoria infinita"
	quest.42000000001A03DC.quest_desc: [
		"Define quais itens uma ponta do tubo aceita ou ignora.",
		"Como: tubos de ferro + redstone no JEI. Uso agachado da chave inglesa para marcar os lados que extraem; clique direito em um para os filtros. O capítulo dos tubos é a escada toda."
	]
	quest.42000000001A03DC.title: "Ferramenta de filtro"
	quest.42000000001A03DD.quest_desc: [
		"O movedor original. Lento, barato e sempre útil.",
		"Como: cinco ferros ao redor de um baú. Ponha-o sob uma Armação do tear ou um Barril de tensão (extrai para BAIXO)."
	]
	quest.42000000001A03DD.title: "Funil reserva (Tubos)"
	quest.42000000001A03DE.quest_desc: [
		"Linha de liberadores para a logística.",
		"Como: pedregulho ao redor de redstone."
	]
	quest.42000000001A03DE.title: "Linha de liberadores"
	quest.42000000001A03DF.quest_desc: [
		"Dispara ou coloca o que estiver carregado ao receber um sinal.",
		"Como: pedregulho, arco e redstone."
	]
	quest.42000000001A03DF.title: "Linha de ejetores"
	quest.42000000001A03E0.quest_desc: [
		"Lê o quão cheio está um recipiente e emite um sinal.",
		"Como: quartzo do Nether, tocha de redstone, pedra. O quartzo sai da peneira na areia das almas; sem viagem ao Nether."
	]
	quest.42000000001A03E0.title: "Comparador (Tubos)"
	quest.42000000001A03E1.quest_desc: [
		"O observador lê o pulso.",
		"Como: pedregulho, redstone e quartzo do Nether."
	]
	quest.42000000001A03E1.title: "Linha de observadores"
	quest.42000000001A03E2.quest_desc: [
		"Uma fonte de sinal sempre ligada, ou um inversor junto de uma alavanca.",
		"Como: redstone sobre um graveto."
	]
	quest.42000000001A03E2.title: "Tocha de redstone"
	quest.42000000001A03E3.quest_desc: [
		"O repetidor temporiza o circuito.",
		"Como: tocha de redstone, redstone, pedra. O capítulo dos tubos usa isso para relógios."
	]
	quest.42000000001A03E3.title: "Repetidor (Tubos)"
	quest.42000000001A03E4.quest_desc: [
		"Se um projétil o acerta, manda um sinal conforme a força.",
		"Como: redstone ao redor do feno. Feno é três trigos."
	]
	quest.42000000001A03E4.title: "Alvo"
	quest.42000000001A03E5.quest_desc: [
		"Lê o céu e sinaliza pela luz ou pela hora.",
		"Como: vidro, quartzo do Nether, lajes de madeira."
	]
	quest.42000000001A03E5.title: "Detector de luz solar (Tubos)"
	quest.42000000001A03E6.quest_desc: [
		"Segura um livro e sinaliza quando uma página vira.",
		"Como: lajes de madeira ao redor de uma estante."
	]
	quest.42000000001A03E6.title: "Atril (Tubos)"
	quest.42000000001A03E7.quest_desc: [
		"Sinaliza enquanto está aberto, como um baú com um fio de armadilha.",
		"Como: gancho de armadilha mais um baú."
	]
	quest.42000000001A03E7.title: "Baú com armadilha"
	quest.42000000001A03E8.quest_desc: [
		"Carrega uma esteira ou puxa itens dela, conforme a face.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.42000000001A03E8.title: "Funil do Create"
	quest.42000000001A03E9.quest_desc: [
		"Um funil que pode filtrar o que move.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.42000000001A03E9.title: "Funil Bidirecional de Latão"
	quest.42000000001A03EA.quest_desc: [
		"Solta itens em linha reta para baixo, entre andares.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.42000000001A03EA.title: "Calha (Tubos)"
	quest.42000000001A03EB.quest_desc: [
		"Uma calha que pode filtrar itens e retê-los.",
		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.42000000001A03EB.title: "Calha inteligente"
	quest.42000000001A03EC.quest_desc: [
		"Classifica e move itens, com prioridade ajustável por lado.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000001A03EC.title: "Logístico Mek"
	quest.42000000001A03ED.quest_desc: [
		"Move fluidos com pressão, então sobe tão fácil quanto desce.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000001A03ED.title: "Cano Mek"
	quest.42000000001A03EE.quest_desc: [
		"Leva energia entre máquinas, com vários degraus de vazão.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000001A03EE.title: "Cabo Mek"
	quest.42000000001A03EF.quest_desc: [
		"Move químicos e gases por uma linha selada.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000001A03EF.title: "Tubo Mek"
	quest.42000000001A03F0.quest_desc: [
		"Uma linha mais rápida para mover itens por uma plataforma movimentada.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000001A03F0.title: "Transportador avançado"
	quest.42000000001A03F1.quest_desc: [
		"Mais rápido ainda, para uma rede que já passou do básico.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000001A03F1.title: "Transportador de elite"
	quest.42000000001A03F2.quest_desc: [
		"A linha de itens mais rápida que existe, para uma plataforma no máximo.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000001A03F2.title: "Transportador supremo"
	quest.42000000001A03F3.quest_desc: [
		"A linha de energia de maior vazão, para salas de máquinas pesadas.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000001A03F3.title: "Cabo supremo"
	quest.42000000001B03F4.quest_desc: [
		"Lista cada espírito que você pode vincular e o que ele precisa.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: um livro e Sementes de sonho de demônio, sem forma. Leia; o Fogo espiritual vem depois."
	]
	quest.42000000001B03F4.title: "Dicionário de espíritos"
	quest.42000000001B03F5.quest_desc: [
		"Queima em violeta e nunca se espalha. Serve para acender rituais.",
		"Como: acenda o Fogo espiritual como mostra o Dicionário dos espíritos (Queima!), depois solte andesito nele."
	]
	quest.42000000001B03F5.title: "Fogo dos espíritos (Outromundo)"
	quest.42000000001B03F6.quest_desc: [
		"Aponta para minério enterrado ou estruturas ocultas por perto.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03F6.title: "Vara de adivinhação"
	quest.42000000001B03F7.quest_desc: [
		"Tira o giz ritual do chão quando você terminar.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03F7.title: "Escova"
	quest.42000000001B03F8.quest_desc: [
		"Cresce até virar uma árvore que não pertence a este mundo.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03F8.title: "Muda do Outromundo"
	quest.42000000001B03F9.quest_desc: [
		"Madeira de uma árvore estranha, usada em rituais de vínculo.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03F9.title: "Tronco do Outromundo"
	quest.42000000001B03FA.quest_desc: [
		"Segura uma oferenda enquanto um ritual de vínculo acontece.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03FA.title: "Tigela de sacrifício"
	quest.42000000001B03FB.quest_desc: [
		"Uma tigela dourada que acelera o ritual em que é usada.",
		"Como: ouro ao redor de uma tigela de sacrifício. O dicionário nomeia o ritual."
	]
	quest.42000000001B03FB.title: "Tigela de ouro"
	quest.42000000001B03FC.quest_desc: [
		"Um contrato sem assinatura, à espera do nome de um espírito.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03FC.title: "Livro de vínculo vazio"
	quest.42000000001B03FD.quest_desc: [
		"Vincula a classe mais fraca de espírito, uma boa primeira tentativa.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03FD.title: "Livro de Foliot"
	quest.42000000001B03FE.quest_desc: [
		"Vincula um espírito de força média, um trabalho mais forte que um foliot.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03FE.title: "Livro de Djinni"
	quest.42000000001B03FF.quest_desc: [
		"Vincula um espírito feroz. O ritual pede mais preparação.",
		"Como: Dicionário de espíritos, depois Fogo dos espíritos e tigelas. O capítulo Outromundo nomeia os ritos."
	]
	quest.42000000001B03FF.title: "Livro de Afrit"
	quest.42000000001B0400.quest_desc: [
