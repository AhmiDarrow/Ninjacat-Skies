		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004E3.title: "Desmontador atômico (QIO)"
	quest.42000000002004E4.quest_desc: [
		"Gira as faces e copia os ajustes entre máquinas do Mekanism.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004E4.title: "Configurador (QIO)"
	quest.42000000002004E5.quest_desc: [
		"Leva você num salto entre duas bases ligadas.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004E5.title: "Teletransportador (QIO)"
	quest.42000000002004E6.quest_desc: [
