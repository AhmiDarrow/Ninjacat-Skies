	quest.4200000000060133.title: "Mão Extensora"
	quest.4200000000060134.quest_desc: [
		"Uma roda, uma prensa, um misturador, um ventilador, um coração de relojoaria.",
		"Dê tensão à Trama: a resposta dos Tecelões de padrões.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.4200000000060134.quest_subtitle: "Padrão"
	quest.4200000000060134.title: "Nó de Relógio"
	quest.4200000000060135.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Recompensa rara: uma vida compartilhada do Clowder, uma vez para a equipe toda. Só existem seis recompensas assim na campanha.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.4200000000060135.title: "Assente Relógio"
	quest.4200000000060136.quest_desc: [
		"Vinte esqueletos. O padrão se mantém se você deixar as luzes acesas.",
		"Como: mate vinte esqueletos. Mantenha a plataforma iluminada."
	]
	quest.4200000000060136.title: "Chocalho nas engrenagens"
	quest.4200000000070137.quest_desc: [
		"Coloque o ninho de carvalho na plataforma e clique com o direito nele usando uma flor pequena. Espere. Algo com asas vai sair da madeira.",
		"Olhe para ela. Isso conta.",
		"Como: clique direito no ninho de carvalho com uma flor pequena e olhe a primeira abelha que sair."
	]
	quest.4200000000070137.quest_subtitle: "Colônia"
	quest.4200000000070137.title: "Primeiras asas"
	quest.4200000000070138.quest_desc: [
		"Oito troncos de carvalho ao redor de uma flor pequena. Coloque-o e acorde-o com outra flor; a madeira lembra as asas.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: anel do material do ninho ao redor de uma flor pequena. Coloque-o e depois clique direito com uma flor pequena para acordá-lo; as abelhas saem depois de um tempo."
	]
	quest.4200000000070138.title: "Anel de carvalho"
	quest.4200000000070139.quest_desc: [
		"Farinha de osso na grama. As abelhas não ficam onde nada floresce.",
		"Como: farinha de osso na grama. As abelhas querem qualquer flor pequena."
	]
	quest.4200000000070139.title: "Uma flor para discutir"
	quest.420000000007013A.quest_desc: [
		"Tábuas e flores — um lar para o qual uma abelha selvagem vai se mudar.",
		"Como: três flores pequenas entre duas fileiras de tábuas. Enxame nomeia o ninho."
	]
	quest.420000000007013A.title: "Ninho de abelhas"
	quest.420000000007013B.quest_desc: [
		"Colônias no vento. A banca dos Guardiões da colônia em /clowder hub vende favo se nenhum vier à deriva.",
		"Como: tosquie um ninho ou uma colmeia depois que as abelhas trabalharem uma flor. A banca dos Guardiões da colônia em /clowder hub vende oito por 16 Fio."
	]
	quest.420000000007013B.title: "Favo de mel"
	quest.420000000007013C.quest_desc: [
		"Um lar para as operárias.",
		"Como: três favos de mel e seis tábuas. Uma fogueira embaixo as acalma."
	]
	quest.420000000007013C.title: "Colmeia"
	quest.420000000007013D.quest_desc: [
