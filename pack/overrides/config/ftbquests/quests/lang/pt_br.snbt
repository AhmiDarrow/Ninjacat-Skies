		"Como: fabricação do Create no JEI (bancada de trabalho, prensa, misturador ou implantador). A liga de andesito e uma roda d'água começam a linha."
	]
	quest.42000000001F04D4.title: "Cofre de itens (empacotado)"
	quest.42000000002004D5.quest_desc: [
		"Um disco básico de armazenamento quântico para a rede QIO.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004D5.title: "Base de disco QIO"
	quest.42000000002004D6.quest_desc: [
		"Põe bem mais armazenamento num único disco quântico.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004D6.title: "QIO hiperdenso"
	quest.42000000002004D7.quest_desc: [
		"Um disco quântico que troca tamanho por densidade bruta.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004D7.title: "QIO dilatação temporal"
	quest.42000000002004D8.quest_desc: [
		"O maior disco quântico que a Mekanism faz.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004D8.title: "QIO supermassivo"
	quest.42000000002004D9.quest_desc: [
		"Guarda vários discos quânticos em uma só carcaça.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004D9.title: "Matriz de Disco do OIQ"
	quest.42000000002004DA.quest_desc: [
		"Navegue por tudo o que a rede QIO guarda.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004DA.title: "Painel do OIQ"
	quest.42000000002004DB.quest_desc: [
		"Leva o painel QIO no seu bolso.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004DB.title: "QIO portátil"
	quest.42000000002004DC.quest_desc: [
		"A carcaça básica da maioria das máquinas avançadas do Mekanism.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004DC.title: "Carcaça de aço (QIO)"
	quest.42000000002004DD.quest_desc: [
		"Guarda uma quantidade enorme de energia em um só bloco.",
		"Recompensa rara: uma vida compartilhada do Clowder, uma vez para a equipe toda. Só existem seis recompensas assim na campanha.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004DD.title: "Cubo supremo"
	quest.42000000002004DE.quest_desc: [
		"Guarda uma pilha enorme de um único item.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004DE.title: "Compartimento Ultimate"
	quest.42000000002004DF.quest_desc: [
		"Funde várias pilhas de uma vez, tão rápido quanto o Mekanism consegue.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004DF.title: "Fábrica de fundição suprema"
	quest.42000000002004E0.quest_desc: [
		"Enriquece o minério na maior velocidade que o Mekanism oferece.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004E0.title: "Fábrica de enriquecimento suprema"
	quest.42000000002004E1.quest_desc: [
		"Tritura o minério na maior velocidade que o Mekanism oferece.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004E1.title: "Fábrica de trituração suprema"
	quest.42000000002004E2.quest_desc: [
		"Minera um chunk inteiro sozinho, direto até o vazio.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004E2.title: "Minerador digital (QIO)"
	quest.42000000002004E3.quest_desc: [
