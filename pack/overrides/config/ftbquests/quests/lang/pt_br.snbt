	]
	quest.4200000000070158.title: "Anel de junco"
	quest.4200000000070159.quest_desc: [
		"Blocos de slime ao redor de uma flor. Chute.",
		"Como: anel do material do ninho ao redor de uma flor pequena. Coloque-o e depois clique direito com uma flor pequena para acordá-lo; as abelhas saem depois de um tempo."
	]
	quest.4200000000070159.title: "Anel de slime"
	quest.420000000007015A.quest_desc: [
		"Feno ao redor de uma flor. Mamangabas, e abelhas comuns também.",
		"Como: anel do material do ninho ao redor de uma flor pequena. Coloque-o e depois clique direito com uma flor pequena para acordá-lo; as abelhas saem depois de um tempo."
	]
	quest.420000000007015A.title: "Anel de feno"
	quest.420000000007015B.quest_desc: [
		"Neve ao redor de uma flor. Abelhas do suor, estranhamente.",
		"Como: anel do material do ninho ao redor de uma flor pequena. Coloque-o e depois clique direito com uma flor pequena para acordá-lo; as abelhas saem depois de um tempo."
	]
	quest.420000000007015B.title: "Anel de neve"
	quest.420000000007015C.quest_desc: [
		"Queima mel para virar energia. Uma colmeia em dobro de função.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.420000000007015C.title: "Gerador de mel"
	quest.420000000007015D.quest_desc: [
		"Expõe uma abelha, com asas e tudo, sem uma colmeia presa.",
		"Como: as receitas de Productive Bees ficam no JEI. Enxame nomeia a colmeia, a centrífuga e os passos de criação."
	]
	quest.420000000007015D.title: "Pote"
	quest.420000000007015E.quest_desc: [
		"Acalma uma colmeia cheia de abelhas antes de você cavar em busca de favo de mel.",
		"Como: troncos, gravetos e carvão ou carvão vegetal."
	]
	quest.420000000007015E.title: "Fogueira (Enxame)"
	quest.420000000007015F.quest_desc: [
		"Alimenta as abelhas e floresce duas vezes por ano, sempre-verde no resto do tempo.",
		"Como: musgo mais carvalho, ou farinha de osso no musgo. As abelhas aceitam a flor."
	]
	quest.420000000007015F.title: "Azaleia florida (Enxame)"
	quest.4200000000070160.quest_desc: [
		"Alto, amarelo e sempre de frente para o sol. As abelhas o acham fácil.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000070160.title: "Girassol"
	quest.4200000000070161.quest_desc: [
		"Dois blocos de flor roxa que as abelhas atravessam uma plataforma para alcançar.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000070161.title: "Lilás"
	quest.4200000000070162.quest_desc: [
		"Uma flor alta que as abelhas preferem, e mais uma cor para o jardim.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000070162.title: "Roseira"
	quest.4200000000070163.quest_desc: [
		"Rosa e cheia, plantada onde uma colmeia precise de mais pasto por perto.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000070163.title: "Peônia"
	quest.4200000000070164.quest_desc: [
		"Uma flor baixa e única, mas as abelhas não ligam para a altura.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000070164.title: "Tulipa laranja"
	quest.4200000000070165.quest_desc: [
		"Um ninho que você construiu, uma colmeia que você moveu, uma centrífuga, uma incubadora, campos de essência.",
		"Dê tensão à Trama: os Guardiões da colônia respondem.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.4200000000070165.quest_subtitle: "Colônia"
	quest.4200000000070165.title: "Nó de Enxame"
	quest.4200000000070166.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.4200000000070166.title: "Assente Enxame"
	quest.4200000000070167.quest_desc: [
		"Você matou uma abelha.",
		"Os Guardiões da colônia querem uma palavra. Aqui está um frasco; pense nisso.",
		"Como: mate uma abelha (oculto). O frasco é a lição."
	]
	quest.4200000000070167.title: "Arrependimento"
	quest.4200000000080168.quest_desc: [
		"Os zeladores deixaram truques no cristal. Trinta e dois fragmentos.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: peneira, ou ametista brotando, se você cultivar uma linha de geodos. Occultism quer fragmentos."
	]
	quest.4200000000080168.title: "Ametista"
	quest.4200000000080169.quest_desc: [
		"Clique direito no Poste de tensão segurando 16 Filamentos de Trama. Nenhuma Trama precisa estar assentada.",
		"Atar começa aqui.",
		"Como: clique direito no Poste de tensão segurando 16 Filamentos de Trama. Peneire cascalho ou areia com uma malha de Fio de ferro para encontrá-los."
	]
	quest.4200000000080169.title: "Cordão de trança"
	quest.420000000008016A.quest_desc: [
		"Escreva o rito antes de entalhá-lo.",
		"Como: livro, bolsa de tinta, pena. Carvão vegetal mais um frasco de vidro fazem a tinta."
	]
	quest.420000000008016A.title: "Livro e pena"
	quest.420000000008016B.quest_desc: [
		"Poder macio para ferramentas duras.",
		"Como: dois diamantes, quatro obsidiana, livro. Diamantes do cascalho com malha de ferro."
	]
	quest.420000000008016B.title: "Mesa de encantamentos (Selo)"
	quest.420000000008016C.quest_desc: [
		"Abasteça a mesa.",
		"Como: nove lápis-lazúli. Peneire cascalho, ou minério de lápis-lazúli na Quebra-eco."
	]
	quest.420000000008016C.title: "Bloco de lápis-lazúli"
	quest.420000000008016D.quest_desc: [
		"Cerca uma mesa de encantamentos para liberar seus encantamentos mais fortes.",
		"Como: seis tábuas e três livros. Livros são papel mais couro."
	]
	quest.420000000008016D.title: "Estante de livros"
	quest.420000000008016E.quest_desc: [
		"Cura fundo e dá um brilho que some depois de um minuto.",
		"Como: oito de ouro ao redor de uma maçã. Não a encantada."
	]
	quest.420000000008016E.title: "Maçã dourada"
	quest.420000000008016F.quest_desc: [
		"Pule a queda.",
		"Como: endermen, ou a banca dos Anda-bordas em /clowder hub."
	]
	quest.420000000008016F.title: "Pérola de ender"
	quest.4200000000080170.quest_desc: [
		"Transforma frascos de água em algo com um efeito de verdade.",
		"Como: vara de blaze sobre três pedregulhos. A vara vem de uma fortaleza do Nether, depois da obsidiana de Garra."
	]
	quest.4200000000080170.title: "Suporte de poções"
	quest.4200000000080171.quest_desc: [
		"Calor para as poções.",
		"Como: fabrique com uma vara de blaze, ou numa fortaleza depois da obsidiana de Garra."
	]
	quest.4200000000080171.title: "Pó de blaze"
	quest.4200000000080172.quest_desc: [
		"Abastece o suporte de poções e prova que você já enfrentou o Nether.",
		"Como: fortaleza do Nether depois da obsidiana de Garra. As poções querem uma vara; Ars e Occultism não esperam por ela."
	]
	quest.4200000000080172.title: "Vara de blaze"
	quest.4200000000080173.quest_desc: [
		"Torce o efeito de uma poção para algo pior, de propósito.",
		"Como: olho de aranha, cogumelo marrom, açúcar."
	]
	quest.4200000000080173.title: "Olho fermentado"
	quest.4200000000080174.quest_desc: [
		"Pó de pedra luminosa para receitas.",
		"Como: peneire areia das almas, ou bruxas na plataforma."
	]
	quest.4200000000080174.title: "Pó de pedra luminosa (Selo)"
	quest.4200000000080175.quest_desc: [
		"Bafo da coisa que guarda o End.",
		"Como: frasco de vidro no dragão. A ilha do End se foi. Opcional."
	]
	quest.4200000000080175.title: "Bafo do dragão"
	quest.4200000000080176.quest_desc: [
		"Mais uma chance.",
		"Opcional — nenhuma invasão chega à plataforma, e o pack não fabrica um.",
		"Como: só recompensas de missões. Assente Relógio e Assente Selo dão um cada, e os presentes dos Nós de Trama tardios oferecem mais. Invasões e evocadores nunca chegam à plataforma. Opcional."
	]
	quest.4200000000080176.title: "Totem"
	quest.4200000000080177.quest_desc: [
		"Guarda a Fonte, o combustível que os feitiços queimam.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.4200000000080177.title: "Gema de fonte"
	quest.4200000000080178.quest_desc: [
		"Cultivada, não achada. Madeira para ferramentas de conjuração e pedestais de feitiço.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.4200000000080178.title: "Madeira arcana"
	quest.4200000000080179.quest_desc: [
		"Os primeiros feitiços. Magia de igual para igual, se você a quiser ao lado dos ritos.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.4200000000080179.title: "Livro de feitiços de novato"
	quest.420000000008017A.quest_desc: [
		"Uma cultura arcana, cultivada tanto pelo tecido quanto pela magia.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008017A.title: "Flor de mago"
	quest.420000000008017B.quest_desc: [
		"Braseiro para o trabalho ritual.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008017B.title: "Braseiro Ritualístico"
	quest.420000000008017C.quest_desc: [
		"Mostra um reagente e o entrega a qualquer ritual que precise dele.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008017C.title: "Pedestal arcano"
	quest.420000000008017D.quest_desc: [
		"Escreva feitiços e páginas.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008017D.title: "Mesa dos escribas"
	quest.420000000008017E.quest_desc: [
		"Imbua os reagentes com fonte.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008017E.title: "Câmara de Impregnação"
	quest.420000000008017F.quest_desc: [
		"Guarda Fonte extra, para um feitiço não secar no meio da conjuração.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008017F.title: "Jarra de Fonte"
	quest.4200000000080180.quest_desc: [
		"Chame os espíritos pelos nomes.",
		"Como: um livro e Sementes de sonho de demônio, sem forma. Leia; o Fogo espiritual vem depois."
	]
	quest.4200000000080180.title: "Dicionário de Occultism"
	quest.4200000000080181.quest_desc: [
		"Uma chama fria para rituais que o fogo comum não termina.",
		"Como: acenda o Fogo espiritual como mostra o Dicionário dos espíritos (Queima!), depois solte andesito nele."
	]
	quest.4200000000080181.title: "Fogo espiritual"
	quest.4200000000080182.quest_desc: [
		"Um foco para a invocação. Os ritos são pacientes.",
		"Como: ouro ao redor de uma tigela de sacrifício. O dicionário nomeia o ritual."
	]
	quest.4200000000080182.title: "Tigela de sacrifício dourada"
	quest.4200000000080183.quest_desc: [
		"O coração da fabricação baseada em aura, afinado à terra ao redor.",
		"Como: Ritual da floresta (JEI): três pedras, uma Folha de ouro, uma barra de ouro e uma Ficha da alegria. Linha do Coração da aura."
	]
	quest.4200000000080183.title: "Altar natural"
	quest.4200000000080184.quest_desc: [
		"Uma planta infundida por aura alta, fiada em algo mais raro.",
		"Como: quatro folhas e quatro pepitas de ouro ao redor de grama baixa fazem quatro Fibras brilhantes. Coloque-a na copa de uma árvore; as folhas ficam douradas com o tempo."
	]
	quest.4200000000080184.title: "Fibra brilhante"
	quest.4200000000080185.quest_desc: [
		"Material tocado pela aura, mais valioso do que parece jogado no chão.",
		"Como: quebre as folhas douradas nascidas da Fibra brilhante."
	]
	quest.4200000000080185.title: "Folha de ouro"
	quest.4200000000080186.quest_desc: [
		"Ferro que absorveu a aura ambiente até valer mais que o minério.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000080186.title: "Ferro infundido"
	quest.4200000000080187.quest_desc: [
		"Deixa você ver o nível de aura da terra ao seu redor.",
		"Como: Folha de ouro + olho de aranha. Mostra a aura local."
	]
	quest.4200000000080187.title: "Olho"
	quest.4200000000080188.quest_desc: [
		"Uma ficha de alegria. O Altar natural e o Absorvedor herbívoro são feitos sobre uma.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000080188.title: "Símbolo de Alegria"
	quest.4200000000080189.quest_desc: [
		"Estoque de pergaminho de feitiço.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.4200000000080189.title: "Pergaminho de feitiço"
	quest.420000000008018A.quest_desc: [
		"Marca um lugar para voltar com uma palavra, não a pé.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008018A.title: "Pergaminho de Teletransporte"
	quest.420000000008018B.quest_desc: [
		"Plante-a, cuide dela e colha pano encharcado de magia baixa.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008018B.title: "Plantação de flor de mago"
	quest.420000000008018C.quest_desc: [
		"A página vazia em que um feitiço é escrito.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.420000000008018C.title: "Glifo em branco"
	quest.420000000008018D.quest_desc: [
		"Lança feitiços de combate sem nunca tocar uma varinha.",
		"Como: três correntes, quatro couros e dois papéis. O capítulo de feitiços nomeia a tinta."
	]
	quest.420000000008018D.title: "Livro de feitiços de Iron"
	quest.420000000008018E.quest_desc: [
		"O combustível que os lançadores queimam, feitiço após feitiço.",
		"Como: mate lançadores ou fabrique o que o JEI lista. Combustível para tinta e livros."
	]
	quest.420000000008018E.title: "Essência arcana"
	quest.420000000008018F.quest_desc: [
		"Inscreve um feitiço num livro, um nível de cada vez.",
		"Como: frasco + essência + corante. A primeira tinta de inscrição."
	]
	quest.420000000008018F.title: "Tinta comum"
	quest.4200000000080190.quest_desc: [
		"Cor para os ritos.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000080190.title: "Flor mística"
	quest.4200000000080191.quest_desc: [
		"Eco da escuridão profunda.",
		"Opcional — o vazio pode nunca te oferecer um.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000080191.title: "Lasca de eco"
	quest.4200000000080192.quest_desc: [
		"Uma trança fiada, poções engarrafadas, feitiços e espíritos chamados.",
		"Ponha tensão na Trama: os Entalhadores de selos respondem.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.4200000000080192.quest_subtitle: "Atar"
	quest.4200000000080192.title: "Nó de Selo"
	quest.4200000000080193.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Recompensa rara: uma vida compartilhada do Clowder, uma vez para a equipe toda. Só existem seis recompensas assim na campanha.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.4200000000080193.title: "Assente o Selo"
	quest.4200000000080194.quest_desc: [
		"Uma maçã que os zeladores nunca comeram. Você também não deveria, provavelmente.",
		"Como: não é uma fabricação da plataforma. Segredo opcional — não trava o Nó de Selo."
	]
	quest.4200000000080194.title: "Ouro velho"
	quest.4200000000090195.quest_desc: [
		"Uma malha de ferro, cascalho ou areia, paciência.",
		"O Filamento de Trama é o fio próprio do Tear. A trança é fiada a partir dele.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: malha de Fio (ferro) sobre cascalho, areia ou pó (Armação do tear ou peneira)."
	]
	quest.4200000000090195.title: "Fie o Filamento"
	quest.4200000000090196.quest_desc: [
		"Dezesseis Filamentos, um clique direito no Poste de tensão.",
		"O atar começou; retecer começa aqui.",
		"Como: clique direito no Poste de tensão segurando 16 Filamentos de Trama. Peneire cascalho ou areia com uma malha de Fio de ferro para encontrá-los."
	]
	quest.4200000000090196.title: "Emende uma trança"
	quest.4200000000090197.quest_desc: [
		"Quartzo Certus — o fio frio de um tear digital.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.4200000000090197.title: "Trama fria"
	quest.4200000000090198.quest_desc: [
		"Quartzo moído, o material base de que se constrói o tear digital.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.4200000000090198.title: "Pó de Certus"
	quest.4200000000090199.quest_desc: [
		"O bloco casca de cada máquina da rede, extraído das jazidas de Certus.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.4200000000090199.title: "Pedra do céu"
	quest.420000000009019A.quest_desc: [
		"Fluix — certus, quartzo e redstone carregados na água.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.420000000009019A.title: "Urdidura carregada"
	quest.420000000009019B.quest_desc: [
		"Uma mistura de quartzo, redstone e vidro, moída fina para fabricar na rede.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.420000000009019B.title: "Pó de Fluix"
	quest.420000000009019C.quest_desc: [
		"Silício para os processadores da AE2.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.420000000009019C.title: "Silício"
	quest.420000000009019D.quest_desc: [
		"O inscriptor prensa os circuitos como o Tear prensa o pano.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.420000000009019D.title: "Prensa o padrão"
	quest.420000000009019E.quest_desc: [
		"Estampa uma placa de silício como o Tear prensa o pano.",
		"Como: bloco de ferro, Nó vinculante, ferro e quartzo. A AE2 só duplica uma prensa que você já tenha."
	]
	quest.420000000009019E.title: "Prensa Inscitora de Silício"
	quest.420000000009019F.quest_desc: [
		"Estampa a matriz de um processador lógico, uma prensada de cada vez.",
		"Como: bloco de ferro, Nó vinculante, ferro e ouro. A primeira cópia é o ofício do Nó."
	]
	quest.420000000009019F.title: "Prensa lógica"
	quest.42000000000901A0.quest_desc: [
		"Estampa a matriz de um processador de cálculo.",
		"Como: bloco de ferro, Nó vinculante, ferro e certus (peneira, areia). A primeira cópia é o ofício do Nó."
	]
	quest.42000000000901A0.title: "Prensa de cálculo"
	quest.42000000000901A1.quest_desc: [
		"Fabricação da matriz de engenharia.",
		"Como: bloco de ferro, Nó vinculante, ferro e diamante. A primeira cópia é o ofício do Nó."
	]
	quest.42000000000901A1.title: "Prensa de engenharia"
	quest.42000000000901A2.quest_desc: [
		"Processador lógico para a AE2.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901A2.title: "Processador lógico"
	quest.42000000000901A3.quest_desc: [
		"Um componente dos padrões de fabricação automática, feito de silício e quartzo certus.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901A3.title: "Processador de cálculo"
	quest.42000000000901A4.quest_desc: [
		"Um processador mais denso, necessário para as partes mais exigentes da rede.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901A4.title: "Processador de engenharia"
	quest.42000000000901A5.quest_desc: [
		"Abriga as células que guardam tudo o que a rede lembra.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901A5.title: "Gabinete ME"
	quest.42000000000901A6.quest_desc: [
		"O invólucro dentro do qual se monta uma célula de armazenamento.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901A6.title: "Invólucro de célula de itens"
	quest.42000000000901A7.quest_desc: [
		"O primeiro baú digital.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901A7.title: "Célula de itens de 1k"
	quest.42000000000901A8.quest_desc: [
		"Veja a rede.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901A8.title: "Terminal"
	quest.42000000000901A9.quest_desc: [
		"Deixa você fabricar direto com o que a rede já guarda.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901A9.title: "Terminal de fabricação"
	quest.42000000000901AA.quest_desc: [
		"O controlador. Quer um Nó vinculante no seu centro.",
		"Núcleo de Fuso.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901AA.title: "Tear digital"
	quest.42000000000901AB.quest_desc: [
		"Use-o de mãos vazias e toque o Rito do portão: acerte as batidas que caem em A, S, D, F. Acerte 60% e ele abre; não precisa de Pulso.",
		"Como: use o Tambor de portão de mãos vazias e toque o Rito do portão: acerte as batidas que caem em A, S, D, F. Acerte 60% e ele abre; não precisa de Pulso. Vincule primeiro uma bússola de retorno."
	]
	quest.42000000000901AB.title: "Tambor do portal"
	quest.42000000000901AC.quest_desc: [
		"Um apoio de além do portão. Traga um para casa.",
		"Como: funda o Pedregulho da Marca. Mine-o na Marca, através de um Tambor de portão."
	]
	quest.42000000000901AC.title: "Pedra da Marcha"
	quest.42000000000901AD.quest_desc: [
		"Leva os canais da rede de uma máquina à seguinte.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901AD.title: "Cabo de Fluix"
	quest.42000000000901AE.quest_desc: [
		"Puxe itens para o armazenamento.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901AE.title: "Bus de importação"
	quest.42000000000901AF.quest_desc: [
		"Empurra itens da rede para um baú ou uma máquina.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901AF.title: "Bus de exportação"
	quest.42000000000901B0.quest_desc: [
		"Lê um inventário de fora para a rede, como se fosse uma célula.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B0.title: "Bus de armazenamento"
	quest.42000000000901B1.quest_desc: [
		"Adiciona capacidade de fabricação em massa à fabricação automática da rede.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B1.title: "Unidade de fabricação"
	quest.42000000000901B2.quest_desc: [
		"Faz mais trabalhos de fabricação rodarem ao mesmo tempo.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B2.title: "Unidade de coprocessamento de fabricação"
	quest.42000000000901B3.quest_desc: [
		"Guarda padrões dos quais a rede tira enquanto fabrica.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B3.title: "Unidade de fabricação 1k"
	quest.42000000000901B4.quest_desc: [
		"Alimenta as máquinas com padrões, como um tear alimenta a lançadeira com fio.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B4.title: "Provedor de padrões"
	quest.42000000000901B5.quest_desc: [
		"Constrói a partir de padrões. Quer um Cordão de trança no coração.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B5.title: "Montador molecular"
	quest.42000000000901B6.quest_desc: [
		"Um padrão vazio, à espera de ser gravado com uma receita.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B6.title: "Padrão em branco"
	quest.42000000000901B7.quest_desc: [
		"Alimente o tear digital com energia.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B7.title: "Aceitador de energia"
	quest.42000000000901B8.quest_desc: [
		"Queime para AE — ramo opcional de energia.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B8.title: "Câmara de vibração"
	quest.42000000000901B9.quest_desc: [
		"Uma célula de armazenamento com mais espaço que o tamanho anterior.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901B9.title: "Célula de itens 4k"
	quest.42000000000901BA.quest_desc: [
		"Guarda bem mais que qualquer baú, a célula mais densa antes de a unidade encher.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901BA.title: "Célula de itens 16k"
	quest.42000000000901BB.quest_desc: [
		"A casca dentro da qual se monta uma célula de fluidos.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901BB.title: "Invólucro de célula de fluidos"
	quest.42000000000901BC.quest_desc: [
		"Um tanque digital, que guarda líquido que a rede pode puxar de qualquer lugar.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901BC.title: "Célula de fluidos 1k"
	quest.42000000000901BD.quest_desc: [
		"Coloca blocos da rede como uma mão faria, sem ter uma.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901BD.title: "Plano de formação"
	quest.42000000000901BE.quest_desc: [
		"Quebra os blocos à frente e os manda para a rede.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901BE.title: "Plano de aniquilação"
	quest.42000000000901BF.quest_desc: [
		"Redstone da rede.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901BF.title: "Emissor de nível"
	quest.42000000000901C0.quest_desc: [
		"Liga a rede ao mundo, trocando itens pela borda.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901C0.title: "Interface"
	quest.42000000000901C1.quest_desc: [
		"Liga duas redes a uma distância que o cabo comum não alcança.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901C1.title: "Anel quântico"
	quest.42000000000901C2.quest_desc: [
		"A metade emparelhada de um anel quântico, que ata duas redes.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901C2.title: "Elo quântico"
	quest.42000000000901C3.quest_desc: [
		"Alcança a rede de qualquer lugar no alcance, sem cabo debaixo dos pés.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901C3.title: "Terminal sem fio"
	quest.42000000000901C4.quest_desc: [
		"Copia os ajustes de uma máquina para outra sem redigitá-los.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901C4.title: "Cartão de memória"
	quest.42000000000901C5.quest_desc: [
		"Ferramenta de rede para AE2.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901C5.title: "Ferramenta de rede"
	quest.42000000000901C6.quest_desc: [
		"Carrega o quartzo certus até ficar pronto para um trabalho mais fino.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901C6.title: "Carregador"
	quest.42000000000901C7.quest_desc: [
		"Acelera um botão de cristal em crescimento até um cacho de tamanho cheio.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000000901C7.title: "Acelerador de crescimento de cristais"
	quest.42000000000901C8.quest_desc: [
		"Prova do dossel da Marca — lembrança opcional de retecer.",
		"Como: cresce selvagem na Marca, fica em baús do açude de junco, e um Ancião dos Liga-raízes o troca."
	]
	quest.42000000000901C8.title: "Cana de Espírito"
	quest.42000000000901C9.quest_desc: [
		"Uma trança, um tear digital, um portão, uma pedra da Marca.",
		"Tensione a nona Trama. Depois o Fragmento, depois o Poste.",
		"Reclame e escolha um presente da tribo: um Fio do Retorno para mais uma vida compartilhada, ou suprimentos.",
		"Como: termine as missões ligadas a esta e então reclame-a pela ficha de Trama. Assente a ficha no seu Poste de tensão."
	]
	quest.42000000000901C9.quest_subtitle: "Retecer"
	quest.42000000000901C9.title: "Nó de Fuso"
	quest.42000000000901CA.quest_desc: [
		"Clique direito no Poste de tensão do seu Clowder com a ficha.",
		"O entalhe acende, a tribo repica, a plataforma muda.",
		"Como: clique direito no seu Poste de tensão com a ficha de Trama na mão."
	]
	quest.42000000000901CA.title: "Assente Fuso"
	quest.42000000000901CB.quest_desc: [
		"Nove assentadas, uma pedra da Marca, um clique direito no Poste: o Fragmento.",
		"Assente-o. O corte se fecha acima da sua plataforma.",
		"Como: nove fichas assentadas, depois clique direito no Poste com a Pedra da Marca."
	]
	quest.42000000000901CB.quest_subtitle: "Retecer"
	quest.42000000000901CB.title: "Fragmento do tear"
	quest.42000000000901CC.quest_desc: [
		"Assente o Fragmento no Poste de tensão.",
		"Nove tribos, um fio. Vá ver o que a Marca guardou para você.",
		"Recompensa rara: uma vida compartilhada do Clowder, uma vez para a equipe toda. Só existem seis recompensas assim na campanha.",
		"Como: assente o Fragmento do tear de Fuso no Poste de tensão. O progresso dispara quando o céu se fecha."
	]
	quest.42000000000901CC.quest_subtitle: "O corte, fechado"
	quest.42000000000901CC.title: "Retecer"
	quest.42000000000901CD.quest_desc: [
		"Um Wither, numa plataforma, no céu. Os Costureiros do tear teriam ficado impressionados e depois furiosos.",
		"Como: Wither (três crânios sobre areia das almas), ou a barraca dos Corações de tambor em /clowder hub uma vez, por 12 Rolos de Fio (972 de Fio). Troféu opcional — não trava o End nem a Fazenda de monstros em 100%."
	]
	quest.42000000000901CD.title: "Uma estrela, de algum jeito"
	quest.42000000000A01CE.quest_desc: [
		"As folhas largam mais mudas.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01CE.title: "Bases do cajado"
	quest.42000000000A01CF.quest_desc: [
		"Peneira mais rápido que o cajado de madeira, e dura bem mais.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01CF.title: "Bone Crook"
	quest.42000000000A01D0.quest_desc: [
		"A malha mais simples. Tudo o que você peneira começa passando por aqui.",
		"Como: nove linhas num 3x3. A banca dos Cantores de cascalho vende a malha de Fio (linha) do Tear do vazio, que peneira igual."
	]
	quest.42000000000A01D0.title: "String Mesh"
	quest.42000000000A01D1.quest_desc: [
		"Pega lascas mais finas que a linha. Menos restos escapam pelo tecido.",
		"Como: quatro sílex e cinco linhas em xadrez. O sílex vem do cascalho, ou de Fio + cascalho."
	]
	quest.42000000000A01D1.title: "Malha de sílex (peneira)"
	quest.42000000000A01D2.quest_desc: [
		"Fios de ferro pegam grânulos mais pesados e puxam restos mais raros da pilha.",
		"Como: quatro barras de ferro e cinco linhas em xadrez. Nenhuma banca vende."
	]
	quest.42000000000A01D2.title: "Malha de ferro (peneira)"
	quest.42000000000A01D3.quest_desc: [
		"Malha de nível de ouro. As chances puxam para os minérios que importam.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01D3.title: "Golden Mesh"
	quest.42000000000A01D4.quest_desc: [
		"Peneire cascalho com isto e os diamantes aparecem bem mais vezes.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01D4.title: "Diamond Mesh"
	quest.42000000000A01D5.quest_desc: [
		"A malha mais fina que existe. Nada peneira melhor que o fio de netherita.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01D5.title: "Netherite Mesh"
	quest.42000000000A01D6.quest_desc: [
		"Argila refinada e lisa, pronta para queimar num cadinho que segura calor de verdade.",
		"Como: bola de argila + farinha de osso, sem forma. A argila vem do Barril de tensão."
	]
	quest.42000000000A01D6.title: "Argila de porcelana (peneira)"
	quest.42000000000A01D7.quest_desc: [
		"Argila de porcelana moldada em cadinho. Queime-o numa fornalha.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01D7.title: "Cadinho cru"
	quest.42000000000A01D8.quest_desc: [
		"Aguenta o calor da fundição sem rachar. Funda o que a peneira trouxe.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01D8.title: "Porcelain Crucible"
	quest.42000000000A01D9.quest_desc: [
		"Borrifa água nas plantações sem pisotear as fileiras.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01D9.title: "Regador de madeira"
	quest.42000000000A01DA.quest_desc: [
		"Um jato mais largo e um tanque mais fundo. Você rega mais da plataforma por viagem.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01DA.title: "Regador de ferro"
	quest.42000000000A01DB.quest_desc: [
		"Solto nas folhas, ele fia seda enquanto come.",
		"Como: quebre folhas com um cajado; bichos-da-seda caem de vez em quando."
	]
	quest.42000000000A01DB.title: "Silkworm"
	quest.42000000000A01DC.quest_desc: [
		"Água estranha que empurra mudas e sementes para culturas mais estranhas.",
		"Como: um barril de água sobre micélio vira água de bruxa; encha um balde a partir dele. Esporos de micélio saem ao peneirar terra."
	]
	quest.42000000000A01DC.title: "Witch Water Bucket"
	quest.42000000000A01DD.quest_desc: [
		"Espalhe-os e o micélio rasteja para fora, bloco por paciente bloco.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01DD.title: "Mycelium Spores"
	quest.42000000000A01DE.quest_desc: [
		"Jogue na terra e a grama se espalha sem esperar a chuva.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01DE.title: "Grass Seeds"
	quest.42000000000A01DF.quest_desc: [
		"O grânulo que substitui o pedregulho. Devolva-o ao martelo para ter mais.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01DF.title: "Stone Pebble"
	quest.42000000000A01E0.quest_desc: [
		"Nove pedregulhos bem apertados em pedra de estoque, para uma plataforma que cresce.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01E0.title: "Pedregulho comprimido"
	quest.42000000000A01E1.quest_desc: [
		"Quebra pedregulho em cascalho mais rápido que qualquer martelo anterior.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01E1.title: "Netherite Hammer"
	quest.42000000000A01E2.quest_desc: [
		"Pedra do Nether, moída fina. Basalto e pedra-negra começam os dois aqui.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01E2.title: "Blackstone Pebble"
	quest.42000000000A01E3.quest_desc: [
		"Ardósia profunda moída até grânulos, pronta de novo para a peneira.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01E3.title: "Deepslate Pebble"
	quest.42000000000A01E4.quest_desc: [
		"Pedra pálida tirada de uma peneiração funda, boa sobretudo para construir.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01E4.title: "Calcita"
	quest.42000000000A01E5.quest_desc: [
		"Pedra cinza das profundezas, simples e fácil de moldar.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000000A01E5.title: "Tufo"
	quest.42000000000A01E6.quest_desc: [
		"Cresce devagar no subsolo; empilhe e deixe pingar de novo em estalactites.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000A01E6.title: "Espeleotema"
	quest.42000000000A01E7.quest_desc: [
		"Absorbe a água parada depressa, útil depois de uma fazenda alagada.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000A01E7.title: "Esponja"
	quest.42000000000B01E8.quest_desc: [
		"Liga o armazenamento ao redor numa só rede pesquisável.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: um barril de madeira ou um baú, dois comparadores, tábuas e pedra. Liga os barris Sophisticated próximos."
