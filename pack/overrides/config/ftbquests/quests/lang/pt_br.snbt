		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0480.title: "Terminal de fabricação (Rede)"
	quest.42000000001D0481.quest_desc: [
		"Escreve a receita que um padrão vai seguir.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0481.title: "Codificação de padrão"
	quest.42000000001D0482.quest_desc: [
