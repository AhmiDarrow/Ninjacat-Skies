	quest.42000000000E022D.quest_desc: [
		"Fiada da flor-de-mago e tecida em robes e equipamento de feitiços.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E022D.title: "Fibra de mago"
	quest.42000000000E022E.quest_desc: [
		"Uma flor que, após a colheita, refaz a fibra no caule.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E022E.title: "Flor-de-mago"
	quest.42000000000E022F.quest_desc: [
		"Guarda um tanque denso de fonte, o combustível por trás de cada feitiço.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E022F.title: "Bloco de gema de fonte"
	quest.42000000000E0230.quest_desc: [
		"Cabe mais glifos do que o livro inicial permite.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0230.title: "Livro de feitiços de aprendiz"
	quest.42000000000E0231.quest_desc: [
		"O maior livro de feitiços, com espaço para um arsenal completo de glifos.",
		"Como: Livro de feitiços do mago, três pérolas de ender, duas esmeraldas, um Totem da imortalidade, uma Estrela do Nether e um Tributo wilden, sem forma. Totem: receita do pack, quatro blocos de ouro e quatro esmeraldas ao redor de uma maçã dourada."
	]
	quest.42000000000E0231.title: "Livro de feitiços de arquimago"
	quest.42000000000E0232.quest_desc: [
		"Lança um feitiço vinculado automaticamente sempre que sente um alvo.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0232.title: "Torreta de feitiços"
	quest.42000000000E0233.quest_desc: [
		"Lança o feitiço vinculado num temporizador firme, não ao avistar.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0233.title: "Torreta de feitiços com temporizador"
	quest.42000000000E0234.quest_desc: [
		"A peça central para fabricar livros de feitiços, varinhas e outro equipamento arcano.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0234.title: "Aparato de encantamento"
	quest.42000000000E0235.quest_desc: [
		"Fica dentro do aparato de encantamento e faz as receitas dele andarem.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0235.title: "Núcleo arcano"
	quest.42000000000E0236.quest_desc: [
		"Leva fonte entre um ponto arcano e um jarro ou um feitiço ligado.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0236.title: "Relé"
	quest.42000000000E0237.quest_desc: [
		"Divide uma linha de fonte para alimentar vários lugares de uma vez.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0237.title: "Divisor de relé"
	quest.42000000000E0238.quest_desc: [
		"Converte o crescimento das plantações próximas num fio lento de fonte.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0238.title: "Vínculo de Fonte Agronômico"
	quest.42000000000E0239.quest_desc: [
		"Converte o calor da lava próxima num fio constante de fonte.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0239.title: "Vínculo de Fonte Vulcânico"
	quest.42000000000E023A.quest_desc: [
		"Invoca uma wixie que fabrica receitas para você enquanto você trabalha em outro lugar.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E023A.title: "Amuleto de Wixie"
	quest.42000000000E023B.quest_desc: [
		"Invoca um starbuncle que, sob comando, busca itens do armazenamento.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E023B.title: "Amuleto de Starbuncle"
	quest.42000000000E023C.quest_desc: [
		"Invoca um drygmy que gera aos poucos, por perto, um recurso escolhido.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E023C.title: "Amuleto de Drygmy"
	quest.42000000000E023D.quest_desc: [
		"Invoca um whirlisprig que cuida das plantações e as faz crescer sozinho.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E023D.title: "Amuleto de Whirlisprig"
	quest.42000000000E023E.quest_desc: [
		"Invoca um golem que colhe brotos de ametista sem erguer uma picareta.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E023E.title: "Amuleto de golem de ametista"
	quest.42000000000E023F.quest_desc: [
		"Pega e coloca blocos à distância, ligando as máquinas entre si de longe.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E023F.title: "Varinha do Domínio"
	quest.42000000000E0240.quest_desc: [
		"Marca um item como permitido ao colocá-lo num filtro.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0240.title: "Pergaminho de permitir"
	quest.42000000000E0241.quest_desc: [
		"Marca um item como negado ao colocá-lo num filtro.",
		"Como: Lado arcano — madeira arcana e baga de fonte a partir do musgo, depois a cascata."
	]
	quest.42000000000E0241.title: "Pergaminho de negar"
	quest.42000000000F0242.quest_desc: [
		"Troncos ao redor de um Nó vinculante, Fio por cima. Coloque-o na plataforma.",
		"Fique perto: a plataforma começa a curar você quando uma Trama fica assentada.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: troncos ao redor de um Nó vinculante, Fio por cima. Coloque-o na plataforma. Olhe para ele para concluir."
	]
	quest.42000000000F0242.title: "Erga o Poste"
	quest.42000000000F0243.quest_desc: [
		"Chave do nexo na mão, ou /clowder hub. Todo Clowder do servidor se encontra aqui.",
		"/clowder return leva você para casa.",
		"Como: Chave do nexo ou `/clowder hub`. `/clowder return` volta para casa."
	]
	quest.42000000000F0243.title: "Entre no Salão"
	quest.42000000000F0244.quest_desc: [
		"Acima do Cais ergue-se uma coluna escura e lenta: o corte em si.",
		"Ela afina conforme os Clowders assentam Tramas. Volte de vez em quando para conferir.",
		"Como: /clowder hub, olhe para cima, para a coluna escura sobre o Cais, e então clique na marca de verificação."
	]
	quest.42000000000F0244.title: "Olhe o Desfiado"
	quest.42000000000F0245.quest_desc: [
		"Ponha uma plataforma no seu nome.",
		"Como: K abre o painel da ilha. Segure a Carta; use-a agachado no chão de uma plataforma do Mundo Superior para selar o surgimento. Comece aqui lista os passos."
	]
	quest.42000000000F0245.title: "Carta da ilha"
	quest.42000000000F0246.quest_desc: [
		"Abre o caminho de volta ao Salão Clowder, de qualquer ponto da Trama.",
		"Como: kit inicial / Salão. `/clowder hub` e a Chave do nexo vão ao Salão Clowder; `/clowder return` volta para casa."
	]
	quest.42000000000F0246.title: "Chave do nexo"
	quest.42000000000F0247.quest_desc: [
		"Um desenho de estandarte que marca até onde a sua Trama chegou.",
		"Como: fabrique no Salão ou no JEI. Uma marca de estandarte, não uma ficha de Trama."
	]
	quest.42000000000F0247.title: "Estandarte de Trama"
	quest.42000000000F0248.quest_desc: [
		"O acento grave (`) abre a lista de tarefas. Clique direito no Códice dos Bigodes para Comece aqui. Mesma campanha; sem clique com Shift no livro.",
		"Como: um livro e qualquer pedra, sem forma. O acento grave (`) abre a mesma lista sem ele."
	]
	quest.42000000000F0248.title: "Lista de tarefas"
	quest.42000000000F0249.quest_desc: [
		"Fique alimentado nas saídas de reivindicação.",
		"Como: oito pepitas de ouro ao redor de uma cenoura. Cenouras são um achado raro de zumbis; o lanche é opcional."
	]
	quest.42000000000F0249.title: "Lanche de reivindicação"
	quest.42000000000F024A.quest_desc: [
		"Mapeia as plataformas ao seu redor conforme o seu Clowder se espalha para fora.",
		"Como: uma bússola cercada de papel."
	]
	quest.42000000000F024A.title: "Mapa"
	quest.42000000000F024B.quest_desc: [
		"Aponta de volta para o ponto de surgimento do mundo; útil quando as plataformas se multiplicam.",
		"Como: ferro ao redor de redstone."
	]
	quest.42000000000F024B.title: "Bússola"
	quest.42000000000F024C.quest_desc: [
		"Ancora uma bússola num ponto exato, em vez do ponto de surgimento.",
		"Como: uma barra de netherita em tijolos de pedra talhados. Luxo tardio do Clowder."
	]
	quest.42000000000F024C.title: "Magnetita"
	quest.42000000000F024D.quest_desc: [
		"Aponta para a sua última morte, para que nada fique perdido no vazio.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000F024D.title: "Bússola de recuperação"
	quest.42000000000F024E.quest_desc: [
		"Toca alto o bastante para reunir o Clowder inteiro numa plataforma.",
		"Como: sem receita. O ritual Contatar espírito selvagem do Occultism faz um, mas precisa de uma cabra, e as cabras nunca chegam à plataforma. Opcional."
	]
	quest.42000000000F024E.title: "Sino"
	quest.42000000000F024F.quest_desc: [
		"Mantém um livro aberto para o Clowder inteiro ler.",
		"Como: lajes de madeira ao redor de uma estante."
	]
	quest.42000000000F024F.title: "Atril"
	quest.42000000000F0250.quest_desc: [
		"Marca um distrito para os recém-chegados saberem qual plataforma é qual.",
		"Como: tábuas sobre um graveto."
	]
	quest.42000000000F0250.title: "Placa de carvalho"
	quest.42000000000F0251.quest_desc: [
		"Um estandarte em branco, pronto para as cores do Clowder.",
		"Como: seis lãs sobre um graveto."
	]
	quest.42000000000F0251.title: "Estandarte branco"
	quest.42000000000F0252.quest_desc: [
		"Escudo pronto para estandartes.",
		"Como: seis tábuas em volta do ferro. Bloqueio na mão secundária."
	]
	quest.42000000000F0252.title: "Escudo pronto para estandarte"
	quest.42000000000F0253.quest_desc: [
		"Solte-os quando uma Trama finalmente voltar a se unir.",
		"Como: papel mais pólvora. Estouro opcional."
	]
	quest.42000000000F0253.title: "Fogo de artifício"
	quest.42000000000F0254.quest_desc: [
		"Compartilhe com o Salão.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000F0254.title: "Tributo de biscoitos"
	quest.42000000000F0255.quest_desc: [
		"Comida compartilhada para celebrar uma Trama bem e verdadeiramente retecida.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000F0255.title: "Bolo"
	quest.42000000000F0256.quest_desc: [
		"Disco de gato — o clima do pacote.",
		"Opcional — o vazio pode nunca te oferecer um.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000F0256.title: "Disco musical"
	quest.42000000000F0257.quest_desc: [
		"Leva um animal domado ou comprado de volta à plataforma sem precisar correr atrás.",
		"Como: quatro linhas ao redor de uma bola de slime. O slime é o composto da plataforma (terra, sementes, farinha de osso)."
	]
	quest.42000000000F0257.title: "Laço"
	quest.42000000000F0258.quest_desc: [
		"Monte quando achar uma sela.",
		"Opcional — os Guardiões da plataforma no Salão Clowder vendem uma.",
		"Como: troque um bloco de diamante com os Guardiões da plataforma na loja deles no Salão Clowder (/clowder hub). A Sela Chocobo é um item diferente."
	]
	quest.42000000000F0258.title: "Sela"
	quest.42000000000F0259.quest_desc: [
		"Para o dia em que alguém construir um mar. Opcional.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000000F0259.title: "Bote"
	quest.4200000000110278.quest_desc: [
		"Mostra onde a aura se acumula, espessa ou fina, pela terra.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: Folha de ouro + olho de aranha. Mostra a aura local."
	]
	quest.4200000000110278.title: "Olho (Aura)"
	quest.4200000000110279.quest_desc: [
		"Tecida de ouro, usada para infundir as plantas com aura concentrada.",
		"Como: quatro folhas e quatro pepitas de ouro ao redor de grama baixa fazem quatro Fibras brilhantes. Coloque-a na copa de uma árvore; as folhas ficam douradas com o tempo."
	]
	quest.4200000000110279.title: "Fibra brilhante (Aura)"
	quest.420000000011027A.quest_desc: [
		"Um material refinado para as receitas de nível superior do altar.",
		"Como: quebre as folhas douradas nascidas da Fibra brilhante."
	]
	quest.420000000011027A.title: "Folha de ouro (Aura)"
	quest.420000000011027B.quest_desc: [
		"Folhas que guardam um brilho dourado suave o ano inteiro.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011027B.title: "Folhas douradas"
	quest.420000000011027C.quest_desc: [
		"Segura um ingrediente para o Ritual da Floresta, posto ao redor de uma muda.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011027C.title: "Suporte de madeira"
	quest.420000000011027D.quest_desc: [
		"O altar onde a aura impulsiona receitas de fabricação mais fortes.",
		"Como: Ritual da floresta (JEI): três pedras, uma Folha de ouro, uma barra de ouro e uma Ficha da alegria. Linha do Coração da aura."
	]
	quest.420000000011027D.title: "Altar natural (Aura)"
	quest.420000000011027E.quest_desc: [
		"Ferro carregado de aura, um passo até o Lingote das Profundezas.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011027E.title: "Ferro infundido (Aura)"
	quest.420000000011027F.quest_desc: [
		"Casca retirada de árvores antigas, útil em receitas de aura.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011027F.title: "Casca Ancestral"
	quest.4200000000110280.quest_desc: [
		"Uma ficha de alegria. O Altar natural e o Absorvedor herbívoro são feitos sobre uma.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110280.title: "Ficha de alegria (Aura)"
	quest.4200000000110281.quest_desc: [
		"Uma ficha de medo. O Diminuidor de copa e o Absorvedor remanescente são feitos sobre uma.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110281.title: "Símbolo de Medo"
	quest.4200000000110282.quest_desc: [
		"Uma ficha de raiva. O Catalisador esfarelante e a Marca de disparo precisam de uma.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110282.title: "Símbolo de Ira"
	quest.4200000000110283.quest_desc: [
		"Uma ficha de pesar. A Mesa de oferendas e o Desembaraçador de mortais precisam de uma.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110283.title: "Símbolo de Tristeza"
	quest.4200000000110284.quest_desc: [
		"Espírito de aura para rituais.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110284.title: "Espírito do chamado"
	quest.4200000000110285.quest_desc: [
		"Espírito de nascimento para ritos de aura.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110285.title: "Espírito do Nascimento"
	quest.4200000000110286.quest_desc: [
		"Guarda uma reserva de aura para quando a terra rarear.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110286.title: "Repositório de Aura"
	quest.4200000000110287.quest_desc: [
		"Tarde. Só se a Aura quiser isso.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110287.title: "Catalisador de criação"
	quest.4200000000110288.quest_desc: [
		"Revela a aura e as condições de surgimento num trecho mais amplo de terra.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110288.title: "Ocular ambiental"
	quest.4200000000110289.quest_desc: [
		"Colocado ao lado do Altar natural, abre as receitas de trituração do altar.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110289.title: "Catalisador de Desmoronamento"
	quest.420000000011028A.quest_desc: [
		"Colocado ao lado do Altar natural, abre as receitas de transmutação do altar.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011028A.title: "Catalisador de transmutação"
	quest.420000000011028B.quest_desc: [
		"Lingotes do céu, ouro maculado e fragmento de netherita, prensados no Lingote das Profundezas.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011028B.title: "Lingote das Profundezas"
	quest.420000000011028C.quest_desc: [
		"Marca um traçado de fazenda que puxa a aura para as plantações crescerem mais rápido.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011028C.title: "Molde de cultivo"
	quest.420000000011028D.quest_desc: [
		"Gera aura sempre que um projétil cai por perto.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011028D.title: "Marca de Tiro"
	quest.420000000011028E.quest_desc: [
		"Gera aura devagar a partir de flores que florescem por perto.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011028E.title: "Absorvedor herbívoro"
	quest.420000000011028F.quest_desc: [
		"Gera aura devagar a partir de carvalhos que crescem por perto.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.420000000011028F.title: "Diminuidor de Dossel"
	quest.4200000000110290.quest_desc: [
		"Uma flor do End, estranhamente à vontade numa plataforma.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110290.title: "Rosa do esquecimento"
	quest.4200000000110291.quest_desc: [
		"Ilumina uma área para que criaturas hostis não surjam ali.",
		"Como: Fibra brilhante nas árvores → Folha de ouro → Altar natural. O capítulo da aura nomeia fichas e geradores."
	]
	quest.4200000000110291.title: "Lâmpada do santuário"
	quest.4200000000120292.quest_desc: [
		"Cozinha refeições tipo ensopado que alimentam mais de um prato de uma vez.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000120292.title: "Panela de cozinha (Cozinha)"
	quest.4200000000120293.quest_desc: [
		"A frigideira refoga os pratos.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000120293.title: "Frigideira"
	quest.4200000000120294.quest_desc: [
		"Fogão para Farmer's Delight.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000120294.title: "Fogão"
	quest.4200000000120295.quest_desc: [
		"Corta carne e vegetais nos ingredientes que outras receitas pedem.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000120295.title: "Tábua de corte (Cozinha)"
	quest.4200000000120296.quest_desc: [
		"Cesta para carregar a colheita.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000120296.title: "Cesto"
	quest.4200000000120297.quest_desc: [
		"Você sobe nela como numa trepadeira, e várias receitas de cozinha precisam dela.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000120297.title: "Corda"
	quest.4200000000120298.quest_desc: [
		"Segura uma queda longa e te joga de volta para cima sem um arranhão.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.4200000000120298.title: "Rede de segurança"
	quest.4200000000120299.quest_desc: [
		"Acelera o crescimento das plantações próximas depois que você ara e planta.",
		"Como: coloque Composto orgânico e espere; ele amadurece devagar até virar Solo rico."
	]
	quest.4200000000120299.title: "Solo rico (Cozinha)"
	quest.420000000012029A.quest_desc: [
		"Transforma restos de comida em composto para enriquecer o solo.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000012029A.title: "Composto orgânico (Cozinha)"
	quest.420000000012029B.quest_desc: [
		"Uma refeição reforçada enrolada em repolho, restaura um bom pedaço de fome.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000012029B.title: "Rolinhos de repolho"
	quest.420000000012029C.quest_desc: [
		"Rápido de cozinhar, rápido de comer, uma fome decente pelo esforço.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000012029C.title: "Sanduíche de bacon"
	quest.420000000012029D.quest_desc: [
		"Uma refeição em camadas que restaura mais fome do que as partes sozinhas.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000012029D.title: "Hambúrguer"
	quest.420000000012029E.quest_desc: [
		"Uma tigela quentinha que restaura fome e saturação juntas.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000012029E.title: "Sopa de frango"
	quest.420000000012029F.quest_desc: [
		"O ensopado de carne enche de verdade.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.420000000012029F.title: "Ensopado de carne"
	quest.42000000001202A0.quest_desc: [
		"Macarrão e caldo, substancioso o bastante para um dia inteiro de trabalho.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A0.title: "Sopa de macarrão"
	quest.42000000001202A1.quest_desc: [
		"Uma sobremesa assada que vale a espera e restaura um bom pedaço de fome.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A1.title: "Torta de maçã"
	quest.42000000001202A2.quest_desc: [
		"Azedo e doce, uma das sobremesas mais ricas na plataforma.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A2.title: "Cheesecake de bagas doces"
	quest.42000000001202A3.quest_desc: [
		"Arroz para a linha da cozinha.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A3.title: "Arroz"
	quest.42000000001202A4.quest_desc: [
		"Comida afetiva da linha da cozinha.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A4.title: "Arroz frito"
	quest.42000000001202A5.quest_desc: [
		"Pequenos embrulhos recheados, rápidos de cozinhar em lotes.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A5.title: "Bolinhos no vapor"
	quest.42000000001202A6.quest_desc: [
		"Uma bebida quente feita com sementes de cacau e leite.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A6.title: "Chocolate quente"
	quest.42000000001202A7.quest_desc: [
		"Uma bebida fresca prensada de melancia, restaura um pouco de fome bem rápido.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A7.title: "Suco de melancia"
	quest.42000000001202A8.quest_desc: [
		"Tecido tramado usado em várias receitas de cozinha e decoração.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A8.title: "Lona"
	quest.42000000001202A9.quest_desc: [
		"Piso tecido e macio, uma textura diferente da madeira lisa.",
		"Como: fabricação de Farmer's Delight no JEI (bancada de trabalho, tábua de corte ou panela). Sementes de cultivo vêm de peneirar terra."
	]
	quest.42000000001202A9.title: "Tatami"
	quest.42000000001302AA.quest_desc: [
		"O primeiro livro que deixa você lançar feitiços numa luta de verdade.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: três correntes, quatro couros e dois papéis. O capítulo de feitiços nomeia a tinta."
	]
	quest.42000000001302AA.title: "Livro de feitiços de ferro"
	quest.42000000001302AB.quest_desc: [
		"Tem mais espaços de feitiço que o livro de ferro anterior.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302AB.title: "Livro de feitiços de ouro"
	quest.42000000001302AC.quest_desc: [
		"Um livro mais resistente, com ainda mais espaço para feitiços.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302AC.title: "Livro de feitiços de diamante"
	quest.42000000001302AD.quest_desc: [
		"Alimenta a conjuração e fica na base da maioria das receitas de feitiços.",
		"Como: mate lançadores ou fabrique o que o JEI lista. Combustível para tinta e livros."
	]
	quest.42000000001302AD.title: "Essência arcana (Feitiços)"
	quest.42000000001302AE.quest_desc: [
		"Escreva feitiços e páginas.",
		"Como: frasco + essência + corante. A primeira tinta de inscrição."
	]
	quest.42000000001302AE.title: "Tinta comum"
	quest.42000000001302AF.quest_desc: [
		"Escreve num livro feitiços e pergaminhos de nível incomum.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302AF.title: "Tinta incomum"
	quest.42000000001302B0.quest_desc: [
		"Escreve num livro feitiços e pergaminhos de nível raro.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B0.title: "Tinta rara"
	quest.42000000001302B1.quest_desc: [
		"Escreve num livro feitiços e pergaminhos de nível épico.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B1.title: "Tinta épica"
	quest.42000000001302B2.quest_desc: [
		"Escreve os feitiços mais raros e mais fortes que um livro pode guardar.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B2.title: "Tinta lendária"
	quest.42000000001302B3.quest_desc: [
		"Lança um feitiço uma vez, sem precisar tê-lo aprendido num livro.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B3.title: "em Pergaminho"
	quest.42000000001302B4.quest_desc: [
		"Tecido mágico para vestes.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B4.title: "Tecido mágico"
	quest.42000000001302B5.quest_desc: [
		"Armadura leve que favorece a conjuração em vez da defesa bruta.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B5.title: "Capacete do mago errante"
	quest.42000000001302B6.quest_desc: [
		"Armadura de peito feita para a velocidade de conjuração, não para o dano absorvido.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B6.title: "Peitoral do mago errante"
	quest.42000000001302B7.quest_desc: [
		"Um cajado que canaliza feitiços de fogo com força extra.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B7.title: "Cajado de Pyrio"
	quest.42000000001302B8.quest_desc: [
		"Um cajado modesto para quem está começando a conjurar.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302B8.title: "Cajado do Barba-Cinzenta"
	quest.42000000001302B9.quest_desc: [
		"Uma lâmina que pune quem lança feitiços e corta as defesas deles.",
		"Como: receita do pack, duas Barras arcanas na diagonal, uma corrente de cada lado e um diamante no cabo. O único portador selvagem vive nos fortes de evocadores, que a plataforma nunca tem."
	]
	quest.42000000001302B9.title: "Caça-Mago"
	quest.42000000001302BA.quest_desc: [
		"O livro de feitiços mais cedo: poucos espaços, mas fácil de alcançar.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302BA.title: "Livro de feitiços de cobre"
	quest.42000000001302BB.quest_desc: [
		"O livro de feitiços mais forte, com mais espaços de feitiço que todos.",
		"Como: quatro Tecidos arcanos, dois Frascos de sangue, uma barra de netherita, uma Garrafa de relâmpago e um Livro em ruínas (receita do pack). O JEI chama isso de Códice antigo."
	]
	quest.42000000001302BB.title: "Livro de feitiços de netherita"
	quest.42000000001302BC.quest_desc: [
		"Metal refinado, usado no alto do equipamento de feitiços.",
		"Como: Essência arcana e tinta, depois um livro de feitiços. O capítulo Feitiços nomeia a escada."
	]
	quest.42000000001302BC.title: "Lingote de Metal Arcano"
	quest.42000000001302BD.quest_desc: [
		"Um livro danificado que dá para recompor em conhecimento.",
		"Como: receita do pack, um livro encantado cercado por quatro Essências arcanas e quatro areias das almas. O JEI chama isso de Livro em ruínas."
	]
	quest.42000000001302BD.title: "Códice em ruínas"
	quest.42000000001402BE.quest_desc: [
		"A primeira peça do Solar Flux. Células, revestimentos e a Melhoria em branco saem dela.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: três vidros sobre uma barra de ferro fazem três Espelhos."
	]
	quest.42000000001402BE.title: "Espelho"
	quest.42000000001402BF.quest_desc: [
		"O primeiro nível de célula solar, fraca, mas barata de empilhar.",
		"Como: três vidros, três lápis-lazúlis e três Espelhos, uma fileira de cada."
	]
	quest.42000000001402BF.title: "Célula fotovoltaica 1"
	quest.42000000001402C0.quest_desc: [
		"Uma célula solar mais forte, um passo acima do nível anterior.",
		"Como: três bolas de argila, três lápis-lazúlis, dois Espelhos e uma Célula fotovoltaica I."
	]
	quest.42000000001402C0.title: "Célula fotovoltaica 2"
	quest.42000000001402C1.quest_desc: [
		"Célula solar de nível médio, com bem mais saída por painel.",
		"Como: três vidros, três pós de pedra luminosa, duas obsidianas e uma Célula fotovoltaica II."
	]
	quest.42000000001402C1.title: "Célula fotovoltaica 3"
	quest.42000000001402C2.quest_desc: [
		"Uma célula solar de nível alto, para um painel feito para crescer.",
		"Como: três Revestimentos flamejantes, dois pós de pedra luminosa, um diamante, dois blocos de quartzo e uma Célula fotovoltaica III."
	]
	quest.42000000001402C2.title: "Célula fotovoltaica 4"
	quest.42000000001402C3.quest_desc: [
		"Quase no topo, esta célula tira muita energia da luz do dia.",
		"Como: três Vidros de esmeralda, dois blocos de pedra luminosa, um bloco de diamante, um bloco de quartzo e duas Células fotovoltaicas IV. Faz dois."
	]
	quest.42000000001402C3.title: "Célula fotovoltaica 5"
	quest.42000000001402C4.quest_desc: [
		"A célula solar mais forte que se faz, o teto de um único painel.",
		"Como: três Vidros de ender, dois blocos de pedra luminosa, um bloco de esmeralda, um bloco de quartzo e duas Células fotovoltaicas V. Faz dois."
	]
	quest.42000000001402C4.title: "Célula fotovoltaica 6"
	quest.42000000001402C5.quest_desc: [
		"Permite a um painel solar guardar uma reserva maior de energia.",
		"Como: cinco blocos de redstone, um bloco de diamante e uma Melhoria em branco."
	]
	quest.42000000001402C5.title: "Melhoria de capacidade"
	quest.42000000001402C6.quest_desc: [
		"Tira mais energia da mesma luz do sol.",
		"Como: três Espelhos, uma Melhoria em branco e uma Célula fotovoltaica I."
	]
	quest.42000000001402C6.title: "Melhoria de eficiência"
	quest.42000000001402C7.quest_desc: [
		"Permite a um painel solar enviar energia mais rápido.",
		"Como: seis redstone e duas barras de ouro ao redor de uma Melhoria em branco."
	]
	quest.42000000001402C7.title: "Melhoria de transferência"
	quest.42000000001402C8.quest_desc: [
		"Passa a energia às máquinas ligadas ao painel, a poucos blocos.",
		"Como: quatro barras de ferro, dois pistões e dois redstone ao redor de uma Melhoria em branco."
	]
	quest.42000000001402C8.title: "Melhoria de travessia"
	quest.42000000001402C9.quest_desc: [
		"Envia energia aos jogadores parados perto do painel.",
		"Como: quatro pós de pedra luminosa e quatro Olhos de ender ao redor de uma Melhoria em branco."
	]
	quest.42000000001402C9.title: "Melhoria dispersiva"
	quest.42000000001402CA.quest_desc: [
		"Envia energia a um bloco vinculado no alcance, sem cabo.",
		"Como: quatro pérolas de ender e quatro blocos de redstone ao redor de uma Melhoria dispersiva."
	]
	quest.42000000001402CA.title: "Melhoria de carga de bloco"
	quest.42000000001402CB.quest_desc: [
		"Deixa o painel fundir itens com a luz do sol guardada, em vez de combustível.",
		"Como: cinco carvões, uma fornalha e dois Revestimentos flamejantes ao redor de uma Melhoria em branco."
	]
	quest.42000000001402CB.title: "Melhoria de fornalha"
	quest.42000000001402CC.quest_desc: [
		"Vidro espelhado cravejado com uma esmeralda. O Vidro de ender e a Célula fotovoltaica V são feitos sobre ele.",
		"Como: uma esmeralda entre dois Espelhos numa coluna faz dois."
	]
	quest.42000000001402CC.title: "Vidro de esmeralda"
	quest.42000000001402CD.quest_desc: [
		"Vidro de esmeralda carregado com pérolas e um olho. A Célula fotovoltaica VI é feita sobre ele.",
		"Como: três Vidros de esmeralda sobre um Olho de ender entre duas pérolas de ender fazem três."
	]
	quest.42000000001402CD.title: "Vidro de ender"
	quest.42000000001402CE.quest_desc: [
		"Um acabamento de Espelho polvilhado de pó de blaze. A Célula fotovoltaica IV e a Melhoria de fornalha usam isso.",
		"Como: pó de blaze entre dois Espelhos numa coluna faz dois."
	]
	quest.42000000001402CE.title: "Revestimento flamejante"
	quest.42000000001402CF.quest_desc: [
		"Uma melhoria ainda sem função, fabricada em qualquer tipo de melhoria.",
		"Como: quatro pedregulhos ao redor de um Espelho."
	]
	quest.42000000001402CF.title: "Melhoria em branco"
	quest.42000000001502D0.quest_desc: [
		"Pedra simples e confiável para paredes e pisos.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: quatro pedras num quadrado, ou o cortador de pedras."
	]
	quest.42000000001502D0.title: "Tijolos de pedra"
	quest.42000000001502D1.quest_desc: [
		"Acabamento de tijolo musgoso da plataforma.",
		"Como: tijolos de pedra mais trepadeiras ou musgo. Depois, o cortador de pedras."
	]
	quest.42000000001502D1.title: "Tijolos de pedra musgosos"
	quest.42000000001502D2.quest_desc: [
		"Tijolos de pedra desgastados, com um ar gasto e rachado.",
		"Como: funda tijolos de pedra."
	]
	quest.42000000001502D2.title: "Tijolos de pedra rachados"
	quest.42000000001502D3.quest_desc: [
		"Tijolos de pedra entalhados para acabamento e linhas de destaque.",
		"Como: duas lajes de tijolos de pedra, ou o cortador de pedras."
	]
	quest.42000000001502D3.title: "Tijolos de pedra entalhados"
	quest.42000000001502D4.quest_desc: [
		"Um acabamento de pedra plano e uniforme para pisos.",
		"Como: funda pedra. As lajes vêm do cortador de pedras."
	]
	quest.42000000001502D4.title: "Pedra lisa"
	quest.42000000001502D5.quest_desc: [
		"Pedra cinza polida até um acabamento liso.",
		"Como: quatro andesitos, ou o cortador de pedras."
	]
	quest.42000000001502D5.title: "Andesito polido"
	quest.42000000001502D6.quest_desc: [
		"Pedra branca e clara, polida até ficar lisa.",
		"Como: quatro dioritos, ou o cortador de pedras."
	]
	quest.42000000001502D6.title: "Diorito polido"
	quest.42000000001502D7.quest_desc: [
		"Pedra rosa quente, polida para os detalhes.",
		"Como: quatro granitos, ou o cortador de pedras."
	]
	quest.42000000001502D7.title: "Granito polido"
	quest.42000000001502D8.quest_desc: [
		"Blocos de argila cozida, vermelho quente contra a pedra cinza.",
		"Como: quatro itens de tijolo. Bolas de argila fundem em tijolos."
	]
	quest.42000000001502D8.title: "Tijolos"
	quest.42000000001502D9.quest_desc: [
		"Lama pálida e compactada, moldada em acabamento de construção.",
		"Como: quatro lamas compactadas. Lama é terra mais uma garrafa de água; lama e trigo fazem lama compactada."
	]
	quest.42000000001502D9.title: "Tijolos de lama"
	quest.42000000001502DA.quest_desc: [
		"Tijolos de pedra escura trazidos das profundezas.",
		"Como: ardósia profunda polida num quadrado, ou o cortador de pedras. Quatro seixos de ardósia profunda (peneire terra) fazem pedregulho de ardósia profunda."
	]
	quest.42000000001502DA.title: "Tijolos de ardósia profunda"
	quest.42000000001502DB.quest_desc: [
		"Azulejos escuros e lisos para um piso mais elegante.",
		"Como: tijolos de ardósia profunda num quadrado, ou o cortador de pedras."
	]
	quest.42000000001502DB.title: "Azulejos de ardósia profunda"
	quest.42000000001502DC.quest_desc: [
		"Pedra escura do Nether, firme e simples.",
		"Como: água de bruxa despejada num barril de lava, ou quatro seixos de pedra-negra. As Fortalezas são feitas dela."
	]
	quest.42000000001502DC.title: "Pedra-negra"
	quest.42000000001502DD.quest_desc: [
		"Pedra-negra polida até um brilho escuro e lustroso.",
		"Como: quatro pedra-negra, ou o cortador de pedras. O Nether, depois de Garra."
	]
	quest.42000000001502DD.title: "Pedra-negra polida"
	quest.42000000001502DE.quest_desc: [
		"Pedra-negra salpicada de ouro, rara e decorativa.",
		"Como: bastião do Nether depois da obsidiana de Garra. Um ramo final da decoração, não um portão seguinte."
	]
	quest.42000000001502DE.title: "Pedra-negra dourada"
	quest.42000000001502DF.quest_desc: [
		"Bloco de um branco vivo, um básico da decoração da plataforma.",
		"Como: quatro quartzo do Nether. O Nether, depois de Garra."
	]
	quest.42000000001502DF.title: "Bloco de quartzo"
	quest.42000000001502E0.quest_desc: [
		"Quartzo alisado, para acabamentos limpos.",
		"Como: funda um bloco de quartzo."
	]
	quest.42000000001502E0.title: "Quartzo liso"
	quest.42000000001502E1.quest_desc: [
		"Pedra roxa do End, um destaque um pouco estranho.",
		"Como: quatro frutas do coro estouradas. A fruta do coro é a banca dos Anda-bordas."
	]
	quest.42000000001502E1.title: "Bloco de púrpura"
	quest.42000000001502E2.quest_desc: [
		"Pedra nascida do mar, com um leve brilho azul.",
		"Como: precisa de fragmentos de prismarinho. Só o oceano. Opcional."
	]
	quest.42000000001502E2.title: "Prismarinho"
	quest.42000000001502E3.quest_desc: [
		"Um prismarinho mais escuro, bom para destaques profundos.",
		"Como: precisa de fragmentos de prismarinho. Só o oceano. Opcional."
	]
	quest.42000000001502E3.title: "Prismarinho escuro"
	quest.42000000001502E4.quest_desc: [
		"Uma luz firme, tirada do fundo do oceano.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502E4.title: "Lanterna do mar"
	quest.42000000001502E5.quest_desc: [
		"Uma luz laranja quente, cultivada de um fungo do Nether.",
		"Como: cresce em fungos enormes. Plante um fungo no nílio e use farinha de osso."
	]
	quest.42000000001502E5.title: "Cogubrilho"
	quest.42000000001502E6.quest_desc: [
		"Uma luz amarela suave, sem chama nenhuma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502E6.title: "Luz de sapo ocre"
	quest.42000000001502E7.quest_desc: [
		"Uma luz pálida e luminosa, com brilho de pérola.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502E7.title: "Luz de sapo nacarada"
	quest.42000000001502E8.quest_desc: [
		"Uma luz verde fresca, sem chama e segura em lugares fechados.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502E8.title: "Luz de sapo verdejante"
	quest.42000000001502E9.quest_desc: [
		"Vidro que bloqueia a luz, mas mantém a vista.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502E9.title: "Vidro fosco"
	quest.42000000001502EA.quest_desc: [
		"Vidro branco suave, para uma luz de janela delicada.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502EA.title: "Vidro branco"
	quest.42000000001502EB.quest_desc: [
		"Vidro azul-claro, perto do céu aberto.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502EB.title: "Vidro azul-claro"
	quest.42000000001502EC.quest_desc: [
		"Vidro ciano fresco, para um cômodo mais calmo.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502EC.title: "Vidro ciano"
	quest.42000000001502ED.quest_desc: [
		"Vidro de um roxo fundo, um aceno ao vazio lá embaixo.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502ED.title: "Vidro roxo"
	quest.42000000001502EE.quest_desc: [
		"Uma chama pequena e firme, para luz de ambiente.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502EE.title: "Vela"
	quest.42000000001502EF.quest_desc: [
		"Uma vela pálida, sutil contra paredes claras.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502EF.title: "Vela branca"
	quest.42000000001502F0.quest_desc: [
		"Suba a borda da plataforma em segurança.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F0.title: "Torre de andaime"
	quest.42000000001502F1.quest_desc: [
		"Escadas para plataformas verticais.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F1.title: "Estoque de escadas"
	quest.42000000001502F2.quest_desc: [
		"Trilhos através do vazio.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F2.title: "Trilho sobrando"
	quest.42000000001502F3.quest_desc: [
		"Mantém você à tona, se a plataforma um dia encontrar água.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F3.title: "Bote de carvalho"
	quest.42000000001502F4.quest_desc: [
		"Decoração para as paredes da plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F4.title: "Pintura sobrando"
	quest.42000000001502F5.quest_desc: [
		"Mostra um conjunto completo de armadura na plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F5.title: "Suporte de armadura"
	quest.42000000001502F6.quest_desc: [
		"Segura um item exposto que nunca escurece.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F6.title: "Moldura brilhante"
	quest.42000000001502F7.quest_desc: [
		"Vasos de flor para o verde.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F7.title: "Vaso de flor de reserva"
	quest.42000000001502F8.quest_desc: [
		"Placas suspensas para os cômodos.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F8.title: "Placa suspensa de carvalho"
	quest.42000000001502F9.quest_desc: [
		"Tear para o trabalho de estandartes.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502F9.title: "Tear"
	quest.42000000001502FA.quest_desc: [
		"Corta a pedra em formas precisas, sem desperdício.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502FA.title: "Cortador de pedras"
	quest.42000000001502FB.quest_desc: [
		"Repara ferramentas e tira encantamentos que você não quer.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502FB.title: "Rebolo"
	quest.42000000001502FC.quest_desc: [
		"Melhora o equipamento com moldes de ferraria e netherita.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502FC.title: "Bancada de ferraria"
	quest.42000000001502FD.quest_desc: [
		"Mapeie a grade da ilha.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502FD.title: "Bancada de cartografia"
	quest.42000000001502FE.quest_desc: [
		"Uma estação de aldeão, quase só decorativa na plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502FE.title: "Bancada de flechas"
	quest.42000000001502FF.quest_desc: [
		"Funde minérios duas vezes mais rápido que uma fornalha comum.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.42000000001502FF.title: "Alto-forno de reserva"
	quest.4200000000150300.quest_desc: [
		"Cozinha comida duas vezes mais rápido que uma fornalha comum.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000150300.title: "Defumador de reserva"
	quest.4200000000150301.quest_desc: [
		"Guarda um pouco de água, corante ou poção.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000150301.title: "Caldeirão"
	quest.4200000000150302.quest_desc: [
		"Move itens automaticamente entre os recipientes de baixo e de cima.",
		"Como: cinco ferros ao redor de um baú. Ponha-o sob uma Armação do tear ou um Barril de tensão (extrai para BAIXO)."
	]
	quest.4200000000150302.title: "Funil de reserva"
	quest.4200000000150303.quest_desc: [
		"Dispara ou usa o item que você carregar nele.",
		"Como: pedregulho, arco e redstone."
	]
	quest.4200000000150303.title: "Ejetor de reserva"
	quest.4200000000150304.quest_desc: [
		"Pulsa redstone sempre que o bloco à frente muda.",
		"Como: pedregulho, redstone e quartzo do Nether."
	]
	quest.4200000000150304.title: "Observador de reserva"
	quest.4200000000150305.quest_desc: [
		"Um sinal de redstone constante e forte, em forma de bloco.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000150305.title: "Bloco de redstone"
	quest.4200000000150306.quest_desc: [
		"Envia uma força de sinal conforme o quão bem você acerta.",
		"Como: redstone ao redor do feno. Feno é três trigos."
	]
	quest.4200000000150306.title: "Alvo de reserva"
	quest.4200000000150307.quest_desc: [
		"Toca uma nota quando é golpeado ou energizado. Afine-o à mão.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000150307.title: "Bloco musical de reserva"
	quest.4200000000150308.quest_desc: [
		"Toca discos de música por toda a plataforma.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000150308.title: "Jukebox de reserva"
	quest.4200000000150309.quest_desc: [
		"O sino marca o Clowder.",
		"Como: sem receita. O ritual Contatar espírito selvagem do Occultism faz um, mas precisa de uma cabra, e as cabras nunca chegam à plataforma. Opcional."
	]
	quest.4200000000150309.title: "Sino de reserva"
	quest.420000000015030A.quest_desc: [
		"Define seu ponto de renascimento no Nether e se carrega com pedra luminosa.",
		"Como: obsidiana chorona mais pedra luminosa. Renascimento só no Nether."
	]
	quest.420000000015030A.title: "Âncora de renascimento"
	quest.420000000015030B.quest_desc: [
		"Trava uma bússola neste bloco exato, em vez do ponto de surgimento.",
		"Como: uma barra de netherita em tijolos de pedra talhados. Luxo tardio do Clowder."
	]
	quest.420000000015030B.title: "Magnetita de reserva"
	quest.420000000015030C.quest_desc: [
		"Desvia os raios para longe da plataforma, em segurança.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000015030C.title: "Para-raios de reserva"
	quest.420000000015030D.quest_desc: [
		"Um espaço de armazenamento pessoal que segue você aonde for.",
		"Como: oito obsidianas ao redor de um Olho de ender. O olho é pérola de ender mais pó de blaze."
	]
	quest.420000000015030D.title: "Baú de ender"
	quest.420000000015030E.quest_desc: [
		"Vira uma caixa de shulker, armazenamento empilhável e seguro.",
		"Como: receita do pack, seis blocos de purpur, duas pérolas de ender e um Nó vinculante. Shulkers nunca surgem aqui. Opcional."
	]
	quest.420000000015030E.title: "Casco de shulker"
	quest.420000000016030F.quest_desc: [
		"O chão e as paredes de qualquer lugar onde você construir sobre lava.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: o Nether aqui é vazio, não terreno. Despeje lava num barril do Ex Deorum com água de bruxa (um barril de água sobre micélio; esporos de micélio saem ao peneirar terra)."
	]
	quest.420000000016030F.title: "Estoque de rocha do Nether"
	quest.4200000000160310.quest_desc: [
		"Pedra de lama queimada, escorada com quartzo. Mantém a forma perto do fogo.",
		"Como: funda rocha do Nether, depois quatro itens de tijolo do Nether."
	]
	quest.4200000000160310.title: "Tijolos do Nether"
	quest.4200000000160311.quest_desc: [
		"Fungo do Nether assado em tijolo. Cor mais quente, a mesma força.",
		"Como: tijolos do Nether mais fungo do Nether. Nether depois de Garra."
	]
	quest.4200000000160311.title: "Tijolos vermelhos do Nether"
	quest.4200000000160312.quest_desc: [
		"Coluna de magma resfriada, cortada em blocos para um apoio.",
		"Como: lava fluindo sobre terra das almas ao lado de gelo azul, ou quatro seixos de basalto ao peneirar pedra-negra moída."
	]
	quest.4200000000160312.title: "Basalto"
	quest.4200000000160313.quest_desc: [
		"Basalto lixado até ficar liso. Lê-se como pedra, não como andaime.",
		"Como: cortador de pedra, ou quatro basaltos."
	]
	quest.4200000000160313.title: "Basalto polido"
	quest.4200000000160314.quest_desc: [
		"Basalto sem as cristas. Bom para pisos planos e acabamento.",
		"Como: funda basalto."
	]
	quest.4200000000160314.title: "Basalto liso"
	quest.4200000000160315.quest_desc: [
		"O pedregulho do Nether. Fabrique rumo a ferramentas e tijolos.",
		"Como: água de bruxa despejada num barril de lava, ou quatro seixos de pedra-negra. As Fortalezas são feitas dela."
	]
	quest.4200000000160315.title: "Reserva de pedra-negra"
	quest.4200000000160316.quest_desc: [
		"Aquece a água próxima até ferver e machuca os pés descalços.",
		"Como: quatro cremes de magma. Uma bola de slime num barril de lava faz creme."
	]
	quest.4200000000160316.title: "Bloco de magma"
	quest.4200000000160317.quest_desc: [
		"Reserva de areia das almas para firmar o pé.",
		"Como: areia num barril do Ex Deorum com água de bruxa. As salas de fungo da fortaleza guardam um pouco. Três crânios sobre areia das almas fazem um Wither."
	]
	quest.4200000000160317.title: "Reserva de areia das almas"
	quest.4200000000160318.quest_desc: [
		"Faz o fogo das almas e as tochas das almas queimarem no lugar da chama comum.",
		"Como: areia das almas jogada num barril de lava do Ex Deorum."
	]
	quest.4200000000160318.title: "Terra das almas"
	quest.4200000000160319.quest_desc: [
		"Esmaga em quatro de pó, ou ilumina uma sala sem fumaça.",
		"Como: quatro pós de pedra luminosa. O pó sai ao peneirar areia das almas."
	]
	quest.4200000000160319.title: "Pedra luminosa"
	quest.420000000016031A.quest_desc: [
		"Um fungo que brilha sozinho. Não precisa de fiação.",
		"Como: cresce em fungos enormes. Plante um fungo no nílio e use farinha de osso."
	]
	quest.420000000016031A.title: "Reserva de luz de fungo"
	quest.420000000016031B.quest_desc: [
		"Nove fungos do Nether reunidos num bloco. Quase só decoração e corante.",
		"Como: nove fungos do Nether. O fungo sai ao peneirar areia das almas, ou cresce nos jardins da fortaleza."
	]
	quest.420000000016031B.title: "Bloco de fungos do Nether"
	quest.420000000016031C.quest_desc: [
		"O primo azul do bloco carmesim. A mesma receita, uma cor mais fria.",
		"Como: cresce em fungos distorcidos enormes. Use farinha de osso num fungo distorcido sobre nílio distorcido."
	]
	quest.420000000016031C.title: "Bloco de fungos distorcidos"
	quest.420000000016031D.quest_desc: [
		"Madeira que não é madeira. Descascada, vira tábuas como qualquer tronco.",
		"Como: esporos de nílio carmesim (peneire rocha do Nether moída) sobre rocha do Nether, farinha de osso no nílio para um fungo, depois farinha de osso no fungo."
	]
	quest.420000000016031D.title: "Caule carmesim"
	quest.420000000016031E.quest_desc: [
		"O outro tronco de fungo. As tábuas saem azuis, não vermelhas.",
		"Como: esporos de nílio distorcido (peneire rocha do Nether moída) sobre rocha do Nether, farinha de osso no nílio para um fungo, depois farinha de osso no fungo."
	]
	quest.420000000016031E.title: "Caule distorcido"
	quest.420000000016031F.quest_desc: [
		"Corrente para um enfeite pendurado.",
		"Como: florestas carmesim depois de Garra. Pendem do teto."
	]
	quest.420000000016031F.title: "Trepadeiras choronas"
	quest.4200000000160320.quest_desc: [
		"Sobe uma floresta distorcida e marca um apoio na névoa.",
		"Como: florestas distorcidas depois de Garra. Crescem para cima a partir do nílio."
	]
	quest.4200000000160320.title: "Trepadeiras retorcidas"
	quest.4200000000160321.quest_desc: [
		"Chora luz roxa e ancora um ponto de renascimento no Nether.",
		"Como: baús de bastião, troca com piglins ou abelhas Draconic trabalhando obsidiana. Portais em ruínas não surgem aqui."
	]
	quest.4200000000160321.title: "Obsidiana chorona"
	quest.4200000000160322.quest_desc: [
		"Enterrado sob os minérios comuns. Funda rumo à netherita.",
		"Como: martele a pedra-negra até virar pedra-negra moída e peneire. Os baús do bastião guardam um pouco."
	]
	quest.4200000000160322.title: "Detritos ancestrais"
	quest.4200000000160323.quest_desc: [
		"Quatro fragmentos e quatro barras de ouro fazem uma barra de netherita.",
		"Como: funda detritos ancestrais. Quatro fragmentos mais ouro fazem uma barra."
	]
	quest.4200000000160323.title: "Fragmento de netherita"
	quest.4200000000160324.quest_desc: [
		"O metal mais duro que uma mão de Skybound vai chegar a segurar.",
		"Como: quatro fragmentos mais quatro de ouro. Os detritos são Nether raro, depois de Garra."
	]
	quest.4200000000160324.title: "Barra de netherita"
	quest.4200000000160325.quest_desc: [
		"Abastece suportes de poções e altos-fornos, os dois. Guarde uma pilha de reserva.",
		"Como: fortaleza do Nether depois da obsidiana de Garra. As poções querem uma vara; Ars e Occultism não esperam por ela."
	]
	quest.4200000000160325.title: "Reserva de varas de blaze"
	quest.4200000000160326.quest_desc: [
		"A poção de regeneração precisa de uma, mais paciência perto de um ghast.",
		"Como: ghasts do Nether depois da obsidiana de Garra."
	]
	quest.4200000000160326.title: "Lágrima de ghast"
	quest.4200000000160327.quest_desc: [
		"Vira resistência ao fogo na poção, ou volta a um bloco de magma na fabricação.",
		"Como: uma bola de slime jogada num barril de lava, slime mais pó de blaze, ou cubos de magma."
	]
	quest.4200000000160327.title: "Creme de magma"
	quest.4200000000160328.quest_desc: [
		"Três invocam um Wither. Uma também fica bem numa prateleira.",
		"Como: fortaleza do Nether depois da obsidiana de Garra. Três crânios iniciam um Wither."
	]
	quest.4200000000160328.title: "Caveira de esqueleto wither"
	quest.4200000000160329.quest_desc: [
		"Os piglins trocam por ouro. Pepitas servem tanto quanto barras.",
		"Como: uma barra faz nove, ou minério de ouro do Nether."
	]
	quest.4200000000160329.title: "Pilha de pepitas de ouro"
	quest.420000000016032A.quest_desc: [
		"Funde em ouro e mina mais rápido que o minério de que leva o nome.",
		"Como: combinador do Mekanism, oito ouros brutos mais netherrack. O Nether vazio não tem minério."
	]
	quest.420000000016032A.title: "Minério de ouro do Nether"
	quest.420000000016032B.quest_desc: [
		"Pedra branca e brilhante que constrói e também conduz sinais de comparador.",
		"Como: peneire areia das almas, ou troca com piglins."
	]
	quest.420000000016032B.title: "Quartzo"
	quest.420000000016032C.quest_desc: [
		"Lançada, começa um fogo. Carregada num ejetor, também.",
		"Como: pó de blaze, carvão e pólvora."
	]
	quest.420000000016032C.title: "Bola de fogo"
	quest.4200000000178001.quest_desc: [
		"Doze molduras de portal não são uma fabricação da plataforma, então o End fica a uma mordida.",
		"Coma para ficar na plataforma de obsidiana do End; coma a metade que sobra para voltar para casa, ao lugar de onde você comeu.",
		"Como: cinco pérolas de ender, dois ossos e dois pós de blaze numa bancada de trabalho."
	]
	quest.4200000000178001.title: "Maçã do End"
	quest.420000000017032D.quest_desc: [
		"Pedra pálida do lado de lá. Pesada, simples e sem fim.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: fruta do coro e pérolas de ender (banca dos Anda-bordas) ao redor de um Nó vinculante. Rende oito. A ilha do End se foi."
	]
	quest.420000000017032D.title: "Pedra do End"
	quest.420000000017032E.quest_desc: [
		"Pedra do End cortada em quadrado, para linhas mais limpas numa plataforma do End.",
		"Como: quatro Pedra do End em quadrado, ou o cortador de pedras. A Pedra do End é a fabricação do Nó."
	]
	quest.420000000017032E.title: "Tijolos de pedra do End"
	quest.420000000017032F.quest_desc: [
		"Cultivado da fruta do coro e depois assado em pedra de construção.",
		"Como: quatro frutas do coro estouradas. A fruta do coro é a banca dos Anda-bordas."
	]
	quest.420000000017032F.title: "Estoque de bloco de púrpura"
	quest.4200000000170330.quest_desc: [
		"Púrpura com um padrão de coluna, orientada como você colocar.",
		"Como: duas lajes de púrpura, ou o cortador de pedras. Primeiro a fruta do coro estourada."
	]
	quest.4200000000170330.title: "Pilar de púrpura"
	quest.4200000000170331.quest_desc: [
		"Uma luz fria que nunca pisca e também serve de poste de trilho.",
		"Como: vara de blaze mais fruta do coro estourada. O Nether, depois de Garra; o chorus é a banca dos Anda-bordas."
	]
	quest.4200000000170331.title: "Haste do End"
	quest.4200000000170332.quest_desc: [
		"Coma e você se teleporta num pulo curto e imprevisível.",
		"Como: banca dos Anda-bordas em /clowder hub. As ilhas externas do End se foram."
	]
	quest.4200000000170332.title: "Fruta do coro"
	quest.4200000000170333.quest_desc: [
		"Fruta do coro cozida. Vira púrpura e corantes sem teletransportar você.",
		"Como: funda fruta do coro da banca dos Anda-bordas."
	]
	quest.4200000000170333.title: "Coro estourado"
	quest.4200000000170334.quest_desc: [
		"Jogue e você chega onde ela cai, menos um pouco de vida.",
		"Como: endermen, ou a banca dos Anda-bordas em /clowder hub."
	]
	quest.4200000000170334.title: "Estoque de pérolas de ender"
	quest.4200000000170335.quest_desc: [
		"Estoque de olhos de ender.",
		"Como: pérola de ender (banca dos Anda-bordas / endermen) mais pó de blaze de uma fortaleza do Nether, depois da obsidiana de Garra. O estoque de oito olhos é opcional; cristais do End usam a mesma fabricação."
	]
	quest.4200000000170335.title: "Estoque de olho de ender"
	quest.4200000000170336.quest_desc: [
		"Bafo do dragão para poções.",
		"Como: frasco de vidro no dragão. A ilha do End se foi. Opcional."
	]
	quest.4200000000170336.title: "Estoque de bafo do dragão"
	quest.4200000000170337.quest_desc: [
		"O único troféu do dragão. Ele nunca fica parado quando você clica.",
		"Recompensa rara: uma vida compartilhada do Clowder, uma vez para a equipe toda. Só existem seis recompensas assim na campanha.",
		"Como: o dragão se foi com a ilha do End. Troféu opcional — não trava os baús de ender."
	]
	quest.4200000000170337.title: "Mostra do ovo de dragão"
	quest.4200000000170338.quest_desc: [
		"Élitros para viajar pelo céu.",
		"Opcional — o vazio pode nunca te oferecer um.",
		"Como: as cidades do End se foram. Opcional."
	]
	quest.4200000000170338.title: "Mostra de élitros"
	quest.4200000000170339.quest_desc: [
		"Cascos de shulker para caixas.",
		"Opcional — aqui não há shulkers, então o pack fabrica os cascos.",
		"Como: receita do pack, seis blocos de purpur, duas pérolas de ender e um Nó vinculante. Shulkers nunca surgem aqui. Opcional."
	]
	quest.4200000000170339.title: "Estoque de casco de shulker"
	quest.420000000017033A.quest_desc: [
		"Um baú portátil que guarda o conteúdo quando você quebra.",
		"Opcional — os Anda-bordas no Salão Clowder vendem uma.",
		"Como: dois Cascos de shulker ao redor de um baú (os cascos são uma receita do pack), ou a banca dos Anda-bordas em /clowder hub por 22 Meadas de Fio (198 de Fio). Opcional."
	]
	quest.420000000017033A.title: "Mostra da caixa de shulker"
	quest.420000000017033B.quest_desc: [
		"Cristais do End — com cuidado.",
		"Como: vidro, olho de ender, lágrima de ghast. Nether depois da obsidiana de Garra; o ovo é opcional."
	]
	quest.420000000017033B.title: "Mostra do cristal do End"
	quest.420000000017033C.quest_desc: [
		"Cada baú de ender, em cada plataforma, compartilha um único depósito oculto.",
		"Como: oito obsidianas ao redor de um Olho de ender. O olho é pérola de ender mais pó de blaze."
	]
	quest.420000000017033C.title: "Mostra do baú de ender"
	quest.420000000017033D.quest_desc: [
		"Plante-a na pedra do End e a fruta do coro cresce para cima.",
		"Como: as ilhas de fora do End se foram. A fruta do coro fica na banca dos Anda-bordas. Opcional."
	]
	quest.420000000017033D.title: "Flor do coro"
	quest.420000000017033E.quest_desc: [
		"Doze destes, cheios de olhos, abrem o caminho para o End.",
		"Como: não é uma fabricação da plataforma. Opcional."
	]
	quest.420000000017033E.title: "Moldura do portal do End"
	quest.420000000017033F.quest_desc: [
		"Pó de concreto solidificado. Escuro como o vazio e permanente depois que cura.",
		"Como: pó de concreto mais água. O pó é areia, cascalho e corante."
	]
	quest.420000000017033F.title: "Concreto preto"
	quest.4200000000170340.quest_desc: [
		"Uma cor de destaque berrante para um bioma quieto e pálido.",
		"Como: pó de concreto mais água. O pó é areia, cascalho e corante."
	]
	quest.4200000000170340.title: "Concreto roxo"
	quest.4200000000170341.quest_desc: [
		"Lava resfriada no contato com a água. Resiste a explosões e é lenta de minerar.",
		"Como: água sobre uma fonte de lava (ou lava sobre água). Mantenha a fonte de lava."
	]
	quest.4200000000170341.title: "Estoque de obsidiana"
	quest.4200000000170342.quest_desc: [
		"Brilha fraco e, carregada, lança você de uma âncora de renascimento.",
		"Como: baús de bastião, troca com piglins ou abelhas Draconic trabalhando obsidiana. Portais em ruínas não surgem aqui."
	]
	quest.4200000000170342.title: "Estoque de obsidiana chorona"
	quest.4200000000170343.quest_desc: [
		"Carregue-a com pedra luminosa para marcar um ponto de renascimento no Nether.",
		"Como: obsidiana chorona mais pedra luminosa. Renascimento só no Nether."
	]
	quest.4200000000170343.title: "Mostra da âncora de renascimento"
	quest.4200000000170344.quest_desc: [
		"Na mão secundária, cancela um golpe que seria fatal.",
		"Como: só recompensas de missões. Assente Relógio e Assente Selo dão um cada, e os presentes dos Nós de Trama tardios oferecem mais. Invasões e evocadores nunca chegam à plataforma. Opcional."
	]
	quest.4200000000170344.title: "Mostra do totem"
	quest.4200000000170345.quest_desc: [
		"O único drop do Wither. Um sinalizador precisa de uma para acender.",
		"Como: Wither (três crânios sobre areia das almas), ou a barraca dos Corações de tambor em /clowder hub uma vez, por 12 Rolos de Fio (972 de Fio). Troféu opcional — não trava o End nem a Fazenda de monstros em 100%."
	]
	quest.4200000000170345.title: "Mostra da estrela do Nether"
	quest.4200000000170346.quest_desc: [
		"Alimentado por uma pirâmide de blocos minerais, concede buffs enquanto você está na área.",
		"Como: estrela do Nether, vidro e obsidiana. Troféu opcional — os ramos do oceano pendem do Estoque de obsidiana."
	]
	quest.4200000000170346.title: "Mostra do sinalizador"
	quest.4200000000170347.quest_desc: [
		"Cercado de prismarinho, concede respiração aquática e pressa debaixo d'água.",
		"Opcional — o vazio pode nunca te oferecer um.",
		"Como: precisa de Coração do mar e de náutilo. Só oceano. Opcional."
	]
	quest.4200000000170347.title: "Mostra do conduto"
	quest.4200000000170348.quest_desc: [
		"Oito cercam um conduto e uma entra na bússola do mar.",
		"Opcional — o vazio pode nunca te oferecer um.",
		"Como: só oceano. Opcional."
	]
	quest.4200000000170348.title: "Concha de náutilo"
	quest.4200000000170349.quest_desc: [
		"Drop raro de um afogado. Arremesse, ou canalize um raio numa tempestade.",
		"Como: só afogados. Opcional."
	]
	quest.4200000000170349.title: "Mostra do tridente"
	quest.420000000018034A.quest_desc: [
		"Essência base. Alimenta tanto os aceleradores de crescimento quanto os reprocessadores.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018034A.title: "Estoque de Inferium"
	quest.420000000018034B.quest_desc: [
		"Uma semente inacabada. Precisa de essência antes de cultivar qualquer coisa.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018034B.title: "Base de Prosperity"
	quest.420000000018034C.quest_desc: [
		"Consumido uma vez, sobe a essência para o nível seguinte.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018034C.title: "Cristal de infusão"
	quest.420000000018034D.quest_desc: [
		"Essência de segundo nível, refinada de pilhas de Inferium.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018034D.title: "Estoque de Prudentium"
	quest.420000000018034E.quest_desc: [
		"Essência de terceiro nível, um degrau acima de Prudentium.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018034E.title: "Estoque de Tertium"
	quest.420000000018034F.quest_desc: [
		"Essência de quarto nível, perto do topo da cadeia.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018034F.title: "Estoque de Imperium"
	quest.4200000000180350.quest_desc: [
		"Essência de quinto nível, quase tão refinada quanto dá para ser.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180350.title: "Estoque de Supremium"
	quest.4200000000180351.quest_desc: [
		"O pico refinado. Necessário para o equipamento e as sementes mais fortes.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180351.title: "Essência despertada"
	quest.4200000000180352.quest_desc: [
		"A peça central para despertar a essência até a forma final.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180352.title: "Altar do despertar"
	quest.4200000000180353.quest_desc: [
		"Cerque o altar com estes para completar o despertar.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180353.title: "Pedestal do despertar"
	quest.4200000000180354.quest_desc: [
		"Um cristal de infusão que nunca fica sem cargas.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180354.title: "Cristal mestre"
	quest.4200000000180355.quest_desc: [
		"Guarda essência em quantidade, para as máquinas nunca secarem.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180355.title: "Receptáculo de Essência"
	quest.4200000000180356.quest_desc: [
		"O componente base de toda máquina movida a essência.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180356.title: "Estrutura de máquina"
	quest.4200000000180357.quest_desc: [
		"Vigia as plantações próximas e as quebra no instante em que amadurecem.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180357.title: "Colheitadeira"
	quest.4200000000180358.quest_desc: [
		"Transforma sementes sobrando de volta em essência, em vez de bagunça.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180358.title: "Reprocessador de sementes"
	quest.4200000000180359.quest_desc: [
		"Acelera as plantações próximas com essência de Inferium.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180359.title: "Acelerador Inferium"
	quest.420000000018035A.quest_desc: [
		"Um acelerador mais forte, um nível acima de Inferium.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018035A.title: "Acelerador Prudentium"
	quest.420000000018035B.quest_desc: [
		"Aceleração de nível médio para um campo mais movimentado.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018035B.title: "Acelerador Tertium"
	quest.420000000018035C.quest_desc: [
		"Quase no topo da faixa de velocidade de crescimento.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018035C.title: "Acelerador Imperium"
	quest.420000000018035D.quest_desc: [
		"O acelerador mais rápido que a essência pode construir.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018035D.title: "Acelerador Supremium"
	quest.420000000018035E.quest_desc: [
		"Um borrifo básico de água para plantações com sede.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018035E.title: "Regador"
	quest.420000000018035F.quest_desc: [
		"Um regador infundido com Inferium, de alcance maior.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.420000000018035F.title: "Regador de Inferium"
	quest.4200000000180360.quest_desc: [
		"Rega mais plantações por uso do que o regador básico.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180360.title: "Regador de Prudentium"
	quest.4200000000180361.quest_desc: [
		"Um regador de nível médio, com um borrifo bem mais largo.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180361.title: "Regador de Tertium"
	quest.4200000000180362.quest_desc: [
		"Rega um bom pedaço de campo numa só passada.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180362.title: "Regador de Imperium"
	quest.4200000000180363.quest_desc: [
		"O borrifo mais largo que um regador consegue.",
		"Como: fabricação de Mystical Agriculture no JEI. Inferium e Prosperity vêm da peneira; as sementes são infundidas no Altar de infusão."
	]
	quest.4200000000180363.title: "Regador de Supremium"
	quest.4200000000180364.quest_desc: [
		"Acelera o crescimento quando você a joga sobre plantações já feitas.",
