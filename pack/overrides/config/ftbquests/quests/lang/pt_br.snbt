		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0482.title: "Acesso a padrões"
	quest.42000000001D0483.quest_desc: [
		"Fornece padrões às máquinas que fabricam sozinhas.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0483.title: "Provedor de padrões (Rede)"
	quest.42000000001D0484.quest_desc: [
		"Monta os itens fabricados seguindo um padrão guardado.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0484.title: "Montador molecular (Rede)"
	quest.42000000001D0485.quest_desc: [
		"Um bloco de memória que a rede usa enquanto fabrica.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0485.title: "Unidade de fabricação (Rede)"
	quest.42000000001D0486.quest_desc: [
