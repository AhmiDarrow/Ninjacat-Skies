	chapter.310000000000002B.chapter_subtitle: [
		"Pedaços do velho mundo sobem à deriva até a sua plataforma. Chegue a eles antes que se desteçam."
	]
	chapter.310000000000002B.title: "Naufrágios à deriva"
	quest.42000000002B0801.quest_desc: [
		"Quando Solo está em tensão, pedaços do velho mundo sobem de vez em quando até a sua plataforma e se prendem na sua trama. O zelador avisa o Clowder inteiro quando um chega.",
		"Eles não ficam: um destroço dura um pouco do tempo online do seu Clowder e depois se destece de volta ao vazio. Ninguém cai, e nada do que você ganhou se perde."
	]
	quest.42000000002B0801.title: "Algo à deriva"
	quest.42000000002B0802.quest_desc: [
		"Fique na borda da sua plataforma, encare o destroço e use um Carretel de amarra: uma ponte de fio se estende sozinha, subindo em meios passos.",
		"Caia e o fio pega você, por três corações. O vazio é o cenário, não o castigo."
	]
	quest.42000000002B0802.title: "Cruze o vazio"
	quest.42000000002B0803.quest_desc: [
		"Cada destroço pede uma coisa: abra o baú do coração, quebre os geradores, refie os pilares, caminhe para casa com um eco, ou segure a costura.",
		"Termine e todos que puserem o pé nele ganham Trama resgatada e um Selo. A Armação do recuperador transforma a trama em carretéis, iscas, chaves e decoração."
	]
	quest.42000000002B0803.title: "Salvamento"
	quest.42000000002B0804.quest_desc: [
		"O Atlas de destroços guarda os lugares de cada tribo que você terminou: nove Tramas por seis tipos de lugar. Uma coluna cheia, uma linha cheia, todos os carimbos: cada um dá uma vantagem pequena e permanente.",
		"As páginas vêm com o relato no Códice. Páginas de dica achadas em baús abrem salas ocultas. Abra o Atlas de destroços para marcar isto."
	]
	quest.42000000002B0804.title: "O Atlas"
	quest.42000000002B0805.quest_desc: [
		"Traga cinco Selos do naufrágio: cinco destroços terminados, por qualquer um do seu Clowder.",
		"Repetível: entregue-os quantas vezes quiser.",
		"Como: termine a tarefa de um destroço à deriva. Todos que puserem o pé nele ganham um Selo."
	]
	quest.42000000002B0805.title: "Cinco selos"
	quest.42000000002B0806.quest_desc: [
		"Quebre três geradores desfiados e entregue os núcleos.",
		"Repetível: entregue-os quantas vezes quiser.",
		"Como: quebre um gerador desfiado num destroço à deriva; cada um solta o núcleo."
	]
	quest.42000000002B0806.title: "Núcleos desfiados"
	quest.42000000002B0807.quest_desc: [
		"Um fragmento de um Remanescente remendado. Entregue-o.",
		"Repetível: entregue-os quantas vezes quiser.",
		"Como: abra a fenda selada de uma Fortaleza com uma Chave de fio de trama e remende o Remanescente lá dentro."
	]
	quest.42000000002B0807.title: "Fragmento de fenda"
	quest.42000000002B0808.quest_desc: [
		"Todos os núcleos de uma Trama. As iscas dessa tribo custam a metade, os destroços dela vêm um pouco mais vezes, e o estandarte é seu."
	]
	quest.42000000002B0808.title: "Uma coluna inteira"
	quest.42000000002B0809.quest_desc: [
		"Um tipo de lugar nas nove tribos. As salas ocultas dele ficam sempre abertas agora."
	]
	quest.42000000002B0809.title: "Uma linha inteira"
	quest.42000000002B080A.quest_desc: [
		"Conclua um destroço de cada modificador. Seus destroços duram um quarto a mais."
	]
	quest.42000000002B080A.title: "Seis carimbos"
	quest.42000000002B080B.quest_desc: [
		"Vinte e cinco páginas preenchidas."
	]
	quest.42000000002B080B.title: "Metade do Atlas"
	quest.42000000002B080C.quest_desc: [
		"Uma Chave de fio de trama cortada para a Trama desse destroço abre a fenda selada de uma Fortaleza. Lá dentro, algo pequeno e desfiado veste a forma de um Guardião."
	]
	quest.42000000002B080C.title: "Rumo à fenda"
	quest.42000000002B080D.quest_desc: [
		"Remende os nove Remanescentes. As Chaves de fio de trama custam a metade."
	]
	quest.42000000002B080D.title: "Todos os Remanescentes"
	quest.42000000002B080E.quest_desc: [
		"Todas as cinquenta e quatro páginas. Em algum lugar sob os Skies, o coração do mundo antigo começa a derivar até você."
	]
	quest.42000000002B080E.title: "Cada página"
	quest.42000000002B080F.quest_desc: [
		"Fique no coração do mundo antigo e reenfie ele. Ele não vem duas vezes."
	]
	quest.42000000002B080F.title: "Coração do tecido"
}
