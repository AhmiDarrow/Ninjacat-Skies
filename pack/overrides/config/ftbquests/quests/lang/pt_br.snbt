	quest.42000000001B0406.title: "Controlador de armazenamento (Outromundo)"
	quest.42000000001B0407.quest_desc: [
		"Atrai certos espíritos para um círculo ritual.",
		"Como: peneira, ou ametista brotando, se você cultivar uma linha de geodos. Occultism quer fragmentos."
	]
