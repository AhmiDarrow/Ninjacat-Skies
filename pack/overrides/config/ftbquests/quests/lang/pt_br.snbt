	quest.42000000001B040B.title: "Corante branco"
	quest.42000000001B040C.quest_desc: [
		"Colore giz ritual para um círculo mais escuro.",
		"Como: carvão vegetal ou uma bolsa de tinta (carvão vegetal mais uma garrafa de vidro)."
	]
	quest.42000000001B040C.title: "Corante preto"
	quest.42000000001B040D.quest_desc: [
		"Chão ritual com uma textura que os rituais parecem gostar.",
		"Como: areia num barril do Ex Deorum com água de bruxa. As salas de fungo da fortaleza guardam um pouco. Três crânios sobre areia das almas fazem um Wither."
	]
	quest.42000000001B040D.title: "Reserva de areia das almas (Outro mundo)"
	quest.42000000001B040E.quest_desc: [
		"Uma camada de base para rituais que pendem para o fogo.",
		"Como: o Nether aqui é vazio, não terreno. Despeje lava num barril do Ex Deorum com água de bruxa (um barril de água sobre micélio; esporos de micélio saem ao peneirar terra)."
	]
	quest.42000000001B040E.title: "Estoque de rocha do Nether (Outro mundo)"
	quest.42000000001B040F.quest_desc: [
		"Uma moldura escura e estável para um círculo ritual.",
		"Como: água sobre uma fonte de lava (ou lava sobre água). Mantenha a fonte de lava."
