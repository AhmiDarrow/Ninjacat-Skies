	]
	quest.42000000002004E7.title: "Revestimento do AFS"
	quest.42000000002004E8.quest_desc: [
		"Mete os químicos e tira a antimatéria do reator.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004E8.title: "Porta do AFS"
	quest.42000000002004E9.quest_desc: [
		"Acelera a produção de um reator de antimatéria.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004E9.title: "Bobina supercarregada"
	quest.42000000002004EA.quest_desc: [
		"Separa isótopos no giro, para a química tardia.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004EA.title: "Centrífuga isotópica"
	quest.42000000002004EB.quest_desc: [
		"Dissolve o minério numa lama química.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004EB.title: "Dissolução química"
	quest.42000000002004EC.quest_desc: [
		"Lava a lama até limpar, antes de cristalizá-la.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004EC.title: "Lavador químico"
	quest.42000000002004ED.quest_desc: [
		"Transforma um produto químico de volta num cristal sólido.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004ED.title: "Cristalizador químico"
	quest.42000000002004EE.quest_desc: [
		"Bombardeia o material com nêutrons movidos pela luz do sol.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004EE.title: "Nêutron solar"
	quest.42000000002004EF.quest_desc: [
		"Converte a energia diretamente em calor para uma caldeira.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004EF.title: "Aquecedor resistivo"
	quest.42000000002004F0.quest_desc: [
		"Queima madeira para calor, não para energia.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F0.title: "Aquecedor a Lenha"
	quest.42000000002004F1.quest_desc: [
		"Síntese tardia de materiais que, de outro modo, seriam impossíveis.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F1.title: "Antiprotônico"
	quest.42000000002004F2.quest_desc: [
		"Uma só ferramenta modular para minerar, cavar e mais.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F2.title: "Mekatool"
	quest.42000000002004F3.quest_desc: [
		"Armadura de traje para a cabeça, melhorada módulo a módulo.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F3.title: "Capacete Meka"
	quest.42000000002004F4.quest_desc: [
		"Armadura de traje para o peito, melhorada módulo a módulo.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F4.title: "Peitoral Meka"
	quest.42000000002004F5.quest_desc: [
		"Armadura de traje para as pernas, melhorada módulo a módulo.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F5.title: "Calças Meka"
	quest.42000000002004F6.quest_desc: [
		"Armadura de traje para os pés, melhorada módulo a módulo.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F6.title: "Botas Meka"
	quest.42000000002004F7.quest_desc: [
		"Casco para uma caldeira a vapor.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F7.title: "Revestimento da Caldeira"
	quest.42000000002004F8.quest_desc: [
		"Armazena uma grande quantidade de energia.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F8.title: "Cubo de Energia Elite"
	quest.42000000002004F9.quest_desc: [
		"Armazena uma quantidade moderada de energia.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004F9.title: "Cubo de energia avançado"
	quest.42000000002004FA.quest_desc: [
		"Armazena pouca energia, bom para começar.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004FA.title: "Cubo de energia básico (QIO)"
	quest.42000000002004FB.quest_desc: [
		"Infunde o metal com um químico para novas ligas.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004FB.title: "Infusor metalúrgico (QIO)"
	quest.42000000002004FC.quest_desc: [
		"Dobra o rendimento do minério bruto antes de fundir.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004FC.title: "Câmara de enriquecimento (QIO)"
	quest.42000000002004FD.quest_desc: [
		"Moa ou triture materiais a granel.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004FD.title: "Triturador (QIO)"
	quest.42000000002004FE.quest_desc: [
		"Funde mais rápido do que uma fornalha, com energia em vez de combustível.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004FE.title: "Fundidora energizada (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Corta madeira com a lâmina de precisão do próprio Mekanism.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.42000000002004FF.title: "Serraria de precisão"
	quest.4200000000200500.quest_desc: [
		"Divide a água nos dois gases que a formam.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.4200000000200500.title: "Separador eletrolítico"
	quest.4200000000200501.quest_desc: [
		"Combina dois químicos num novo.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.4200000000200501.title: "Infusor químico"
	quest.4200000000200502.quest_desc: [
		"Purifique fluidos ou minérios.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.4200000000200502.title: "Purificação"
	quest.4200000000200503.quest_desc: [
		"Injeta um químico no minério para mais rendimento.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.4200000000200503.title: "Injeção química"
	quest.4200000000200504.quest_desc: [
		"Comprime ósmio sobre os itens, para um equipamento mais resistente.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.4200000000200504.title: "Compressor de ósmio (QIO)"
	quest.4200000000200505.quest_desc: [
		"Junta vários componentes numa peça pronta.",
		"Como: capítulo Oficinas Mekanism — fragmentos de minério da peneira, depois a linha da fábrica."
	]
	quest.4200000000200505.title: "Combinador"
	quest.4200000000210506.quest_desc: [
		"Os zumbis largam isso, queira você ou não.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: mate zumbis na plataforma à noite, ou num buraco escuro."
	]
	quest.4200000000210506.title: "Estoque de carne podre"
	quest.4200000000210507.quest_desc: [
		"Os esqueletos deixam isso; moa depois para farinha de osso.",
		"Como: esqueletos à noite, ou /clowder hub Guardiões da plataforma (16 de Fio por 8)."
	]
	quest.4200000000210507.title: "Estoque de ossos"
	quest.4200000000210508.quest_desc: [
		"Os creepers pagam isso, às vezes com explosão.",
		"Como: peneire pó ou areia das almas, ou creepers na plataforma à noite. Mantenha as bordas iluminadas depois que tiver um pouco."
	]
	quest.4200000000210508.title: "Estoque de pólvora"
	quest.4200000000210509.quest_desc: [
		"As aranhas largam isso, e uma peneira nunca.",
		"Como: desfie Fio desfiado (1 → 3). Aranhas. Fiapo do tear numa Amarra de eco. Sumidouro inverso de novelo."
	]
	quest.4200000000210509.title: "Estoque de linha"
	quest.420000000021050A.quest_desc: [
		"Vira veneno na poção e entra em algumas receitas estranhas.",
		"Como: aranhas na plataforma à noite."
	]
	quest.420000000021050A.title: "Estoque de olhos de aranha"
	quest.420000000021050B.quest_desc: [
		"Os endermen largam estas; uma fazenda ganha de implorar por elas ao vazio.",
		"Como: endermen, ou a banca dos Anda-bordas em /clowder hub."
	]
	quest.420000000021050B.title: "Fazenda de pérolas de ender"
	quest.420000000021050C.quest_desc: [
		"Combustível para suportes de poções e queimadores de blaze.",
		"Como: fortaleza do Nether depois da obsidiana de Garra. As poções querem uma vara; Ars e Occultism não esperam por ela."
	]
	quest.420000000021050C.title: "Fazenda de varas de blaze"
	quest.420000000021050D.quest_desc: [
		"Um achado raro, chave para poções de regeneração.",
		"Como: ghasts do Nether depois da obsidiana de Garra."
	]
	quest.420000000021050D.title: "Fazenda de lágrimas de ghast"
	quest.420000000021050E.quest_desc: [
		"Vira resistência ao fogo na poção e entra em algumas fabricações.",
		"Como: uma bola de slime jogada num barril de lava, slime mais pó de blaze, ou cubos de magma."
	]
	quest.420000000021050E.title: "Fazenda de creme de magma"
	quest.420000000021050F.quest_desc: [
		"Grudento o bastante para pistões, blocos de slime e laços.",
		"Como: duas terras + sementes de trigo + farinha de osso (composto da plataforma), ou /clowder hub Guardiões da plataforma."
	]
	quest.420000000021050F.title: "Fazenda de bolas de slime"
	quest.4200000000210510.quest_desc: [
		"Três destas invocam um chefe que vale a luta.",
		"Como: fortaleza do Nether depois da obsidiana de Garra. Três crânios iniciam um Wither."
	]
	quest.4200000000210510.title: "Caveira de esqueleto wither"
	quest.4200000000210511.quest_desc: [
		"O próprio imposto do wither, raro e pesado de poder.",
		"Como: Wither (três crânios sobre areia das almas), ou a barraca dos Corações de tambor em /clowder hub uma vez, por 12 Rolos de Fio (972 de Fio). Troféu opcional — não trava o End nem a Fazenda de monstros em 100%."
	]
	quest.4200000000210511.title: "Estrela do Nether"
	quest.4200000000210512.quest_desc: [
		"Vira uma caixa de shulker, armazenamento que sobrevive à morte.",
		"Opcional — aqui não há shulkers, então o pack fabrica os cascos.",
		"Como: receita do pack, seis blocos de purpur, duas pérolas de ender e um Nó vinculante. Shulkers nunca surgem aqui. Opcional."
	]
	quest.4200000000210512.title: "Fazenda de cascos de shulker"
	quest.4200000000210513.quest_desc: [
		"Repara élitros quando nada mais consegue.",
		"Como: pule o sono por três noites e depois mate phantoms. Opcional."
	]
	quest.4200000000210513.title: "Membrana de phantom"
	quest.4200000000210514.quest_desc: [
		"Tinta de lula, útil para tingir e para a escrita à moda antiga.",
		"Como: carvão vegetal mais uma garrafa de vidro. Lulas nunca surgem aqui."
	]
	quest.4200000000210514.title: "Fazenda de bolsas de tinta"
	quest.4200000000210515.quest_desc: [
		"Faz placas e molduras brilharem no escuro.",
		"Como: lulas brilhantes nunca surgem na plataforma. Opcional."
	]
	quest.4200000000210515.title: "Tinta luminosa"
	quest.4200000000210516.quest_desc: [
		"Os guardiões o soltam, para blocos de prismarinho e lanternas.",
		"Como: os monumentos oceânicos sumiram. Opcional, a menos que você cultive uma semente de prismarinho."
	]
	quest.4200000000210516.title: "Fragmento de prismarinho"
	quest.4200000000210517.quest_desc: [
		"Espólio de guardião que ilumina o mar e abastece algumas fabricações.",
		"Como: os monumentos oceânicos sumiram. Opcional."
	]
	quest.4200000000210517.title: "Cristal de prismarinho"
	quest.4200000000210518.quest_desc: [
		"Circunda um conduíte; junte oito para fechar a moldura.",
		"Opcional — o vazio pode nunca te oferecer um.",
		"Como: só oceano. Opcional."
	]
	quest.4200000000210518.title: "Concha de náutilo (Caça)"
	quest.4200000000210519.quest_desc: [
		"Engana a morte uma vez, depois some.",
		"Como: só recompensas de missões. Assente Relógio e Assente Selo dão um cada, e os presentes dos Nós de Trama tardios oferecem mais. Invasões e evocadores nunca chegam à plataforma. Opcional."
	]
	quest.4200000000210519.title: "Totem (Caça)"
	quest.420000000021051A.quest_desc: [
		"Os golens soltam ferro enquanto ficam de guarda.",
		"Como: funda ferro bruto / grânulo de ferro (fornalha ou Forno de brasas). Peneire cascalho para pegar pedaços."
	]
	quest.420000000021051A.title: "Presente do golem de ferro"
	quest.420000000021051B.quest_desc: [
		"Joga bolas de neve; munição útil, lutador fraquinho.",
		"Como: um gelo (kit / gerador de gelo), sem forma, em quatro bolas de neve."
	]
	quest.420000000021051B.title: "Golem de neve"
	quest.420000000021051C.quest_desc: [
		"Os esqueletos mantêm a plataforma abastecida de munição.",
		"Como: pederneira, graveto, pena. Esqueletos largam extras."
	]
	quest.420000000021051C.title: "Fazenda de flechas"
	quest.420000000021051D.quest_desc: [
		"Marca o que acertar com um brilho temporário.",
		"Como: pó de pedra luminosa ao redor de uma flecha."
	]
	quest.420000000021051D.title: "Flecha espectral"
	quest.420000000021051E.quest_desc: [
		"Monte quando achar uma sela.",
		"Opcional — os Guardiões da plataforma no Salão Clowder vendem uma.",
		"Como: troque um bloco de diamante com os Guardiões da plataforma na loja deles no Salão Clowder (/clowder hub). A Sela Chocobo é um item diferente."
	]
	quest.420000000021051E.title: "Sela (Caça)"
	quest.420000000021051F.quest_desc: [
		"Dá nome a uma criatura para que ela nunca suma.",
		"Opcional — os Entalhadores de selos no Salão Clowder vendem uma.",
		"Como: pesca / baús raros, ou a banca dos Entalhadores de selos em /clowder hub (24 Fio). Opcional."
	]
	quest.420000000021051F.title: "Fazenda de etiquetas"
	quest.4200000000210520.quest_desc: [
		"Amarra um elo ou um cabo.",
		"Como: quatro linhas ao redor de uma bola de slime. O slime é o composto da plataforma (terra, sementes, farinha de osso)."
	]
	quest.4200000000210520.title: "Laço (Caça)"
	quest.4200000000210521.quest_desc: [
		"As galinhas os põem mais rápido do que você consegue recolher.",
		"Como: sementes de trigo para as galinhas na plataforma, ou o galinheiro do capítulo Fazenda de monstros."
	]
	quest.4200000000210521.title: "Estoque de ovos"
	quest.4200000000210522.quest_desc: [
		"Estoque de couro e de bife.",
		"Como: funda carne podre ou asse na fogueira. Peneire terra com malha de pederneira. /clowder hub Os Guardiões da plataforma vendem dois por 18 Fio."
	]
	quest.4200000000210522.title: "Estoque de couro"
	quest.4200000000210523.quest_desc: [
		"As ovelhas a fazem crescer de novo depois de uma tosa.",
		"Como: tosquie as ovelhas depois de dar grama, ou quatro linhas."
	]
	quest.4200000000210523.title: "Estoque de lã"
	quest.4200000000210524.quest_desc: [
		"Estoque de comida para a cozinha.",
		"Como: trigo para as vacas na plataforma."
	]
	quest.4200000000210524.title: "Estoque de bife"
	quest.4200000000210525.quest_desc: [
		"Os porcos o fornecem; cozinhe antes de comer.",
		"Como: batatas ou cenouras para os porcos na plataforma."
	]
	quest.4200000000210525.title: "Estoque de porco"
	quest.4200000000210526.quest_desc: [
		"Frango para refeições e penas.",
		"Como: sementes para as galinhas na plataforma."
	]
	quest.4200000000210526.title: "Estoque de frango"
	quest.4200000000210527.quest_desc: [
		"Carne de ovelha, melhor assada que crua.",
		"Como: trigo para as ovelhas na plataforma."
	]
	quest.4200000000210527.title: "Estoque de carneiro"
	quest.4200000000210528.quest_desc: [
		"Prepara uma poção de sorte, se você puder abrir mão de um.",
		"Opcional — o vazio pode nunca te oferecer um.",
		"Como: coelhos não surgem na plataforma. Opcional."
	]
	quest.4200000000210528.title: "Pé de coelho"
	quest.4200000000210529.quest_desc: [
		"Uma peça de mostra que vale pôr ao lado de um ovo de dragão.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000210529.title: "Cabeça de zumbi"
	quest.420000000021052A.quest_desc: [
		"Combina bem com um ovo de dragão numa prateleira.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000021052A.title: "Caveira de esqueleto"
	quest.420000000021052B.quest_desc: [
		"Mais uma cabeça para a prateleira de troféus, junto ao ovo.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000021052B.title: "Cabeça de creeper"
	quest.420000000021052C.quest_desc: [
		"Mais uma cabeça, à vontade perto de um ovo de dragão.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000021052C.title: "Cabeça de piglin"
	quest.420000000021052D.quest_desc: [
		"A cabeça mais rara, ganha só depois que a luta acaba.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000021052D.title: "Cabeça de dragão"
	quest.420000000021052E.quest_desc: [
		"Só se um jogador deixar cair uma por acaso.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.420000000021052E.title: "Cabeça de jogador"
	quest.420000000022052F.quest_desc: [
		"A primeira fabricação rende 2 — guarde um para o Códice depois.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: um osso, linha, ametista. /clowder hub Os Guardiões da plataforma vendem ossos. Portão Centelha / Zumbido."
	]
	quest.420000000022052F.title: "Carrilhão de osso"
	quest.4200000000220530.quest_desc: [
		"Lasca de um canto tribal antigo — precisa de um Carrilhão.",
		"Como: Carrilhão de osso, ametista e redstone, sem forma. Rende dois."
	]
	quest.4200000000220530.title: "Fragmento de Espírito"
	quest.4200000000220531.quest_desc: [
		"Afine o metal ao espírito — cobre em volta de um Carrilhão.",
		"Como: cobre ao redor de um Carrilhão de osso. Rende dois."
	]
	quest.4200000000220531.title: "Ressonador de cobre"
	quest.4200000000220532.quest_desc: [
		"Marque as linhas da treliça — o giz precisa de uma Lasca.",
		"Como: duas farinhas de osso, lápis-lazúli e uma Lasca espiritual, sem forma. Rende quatro."
	]
	quest.4200000000220532.title: "Giz ritual (tribal)"
	quest.4200000000220533.quest_desc: [
		"Coloque o coração — dois Carrilhões de osso, uma Lasca espiritual, dois couros e quatro tábuas (os Guardiões da plataforma vendem couro).",
		"Como: dois Carrilhões de osso, uma Lasca espiritual, dois couros e quatro tábuas. Golpeie de mãos vazias no tempo (17–23 ticks) para 24 de Pulso."
	]
	quest.4200000000220533.title: "Batida do Coração de tambor"
	quest.4200000000220534.quest_desc: [
		"Nove tribos cantarolaram uma vez — precisa de um Carrilhão e uma Lasca sobrando.",
		"Como: fabrique, ou pegue como recompensa de Centelha/Tecido tribal. Clique direito: como a treliça funciona."
	]
	quest.4200000000220534.title: "Códice espiritual"
	quest.4200000000220535.quest_desc: [
		"Puxe a ley para as batidas.",
		"Como: coloque sob o céu, perto de água/verde. Pulso lento. Escada de Centelha."
	]
	quest.4200000000220535.title: "Coletor de ley"
	quest.4200000000220536.quest_desc: [
		"Carrega Pulso para ferramentas, feitiços e viagem. Encha-a num Coração de tambor.",
		"Como: fabrique e depois encha a partir de um Coração de tambor (clique com a célula). Ferramentas, feitiços e viagem puxam da célula."
	]
	quest.4200000000220536.title: "Célula de Pulso"
	quest.4200000000220537.quest_desc: [
		"Assente um catalisador de Eco, que se desgasta enquanto trabalha; acrescente duas vozes de totem diferentes em oito blocos. Mais vozes fortalecem a canção. A redstone pausa.",
		"Como: assente um catalisador de eco e dois totens diferentes em até 8. A redstone o pausa."
	]
	quest.4200000000220537.title: "Ressonador de Pulso"
	quest.4200000000220538.quest_desc: [
		"A tribo da pedra responde.",
		"Como: um Carrilhão de osso, dois troncos, terra e um Ressonador de cobre."
	]
	quest.4200000000220538.title: "Totem de Terra"
	quest.4200000000220539.quest_desc: [
		"A tribo da chama responde.",
		"Como: um Carrilhão de osso, dois troncos, carvão vegetal e um Ressonador de cobre."
	]
	quest.4200000000220539.title: "Totem de Fogo"
	quest.420000000022053A.quest_desc: [
		"A tribo da maré responde.",
		"Como: um Carrilhão de osso, dois troncos, um balde de água (ou um balde de água de porcelana) e um Ressonador de cobre."
	]
	quest.420000000022053A.title: "Totem de Água"
	quest.420000000022053B.quest_desc: [
		"A tribo do vento responde.",
		"Como: um Carrilhão de osso, dois troncos, uma pena e um Ressonador de cobre."
	]
	quest.420000000022053B.title: "Totem de Ar"
	quest.420000000022053C.quest_desc: [
		"Quinta tribo — núcleo do zelador.",
		"Como: um Carrilhão de osso, dois troncos, uma Lasca espiritual e um Ressonador de cobre."
	]
	quest.420000000022053C.title: "Totem de Espírito"
	quest.420000000022053D.quest_desc: [
		"Comece a canção da treliça. Ela espera pedra ou um item de estágio de Eco; metal bruto é grânulo na Quebra-eco.",
		"Como: Códice dos Espíritos + Tecido tribal. Assente pedra ou um item de estágio de Eco. Metal bruto fica na Quebra-eco."
	]
	quest.420000000022053D.title: "Bancada do canto"
	quest.420000000022053E.quest_desc: [
		"Encaminhe as harmônicas entre totens.",
		"Como: quatro Ressonadores de cobre ao redor de redstone. Faz quatro."
	]
	quest.420000000022053E.title: "Condutor de treliça"
	quest.420000000022053F.quest_desc: [
		"Cantarole o estágio um — quebre o minério. Pedra vira lascas; pedregulho vira cascalho; metal bruto vira grânulos. A quebra de grânulos leva 4 segundos a 40 de Pulso/s.",
		"Como: pedra + Carrilhão de osso + Ressonador de cobre. Totem de Terra em 8. Pedra → lascas; pedregulho → cascalho; metal bruto → grânulos. Quatro segundos a 40 de Pulso/s."
	]
	quest.420000000022053F.title: "Triturador de eco"
	quest.4200000000220540.quest_desc: [
		"Lasca que ouviu a quebra.",
		"Como: pedra na Quebra-eco (não pedregulho). Pedra do grau da Fonte, ou pedra com toque suave."
	]
	quest.4200000000220540.title: "Lasca de eco (tribal)"
	quest.4200000000220541.quest_desc: [
		"Cantarole o estágio dois — sintonize.",
		"Como: sete pedras, uma Lasca espiritual e um Ressonador de cobre."
	]
	quest.4200000000220541.title: "Sintonizador de eco"
	quest.4200000000220542.quest_desc: [
		"Eco que achou uma chave.",
		"Como: Códice dos Espíritos + Tecido tribal. A estação, o totem e o custo de Pulso estão na página do Códice."
	]
	quest.4200000000220542.title: "Eco sintonizado"
	quest.4200000000220543.quest_desc: [
		"Estágio de vínculo — amarre o espírito ao metal.",
		"Como: sete pedras, uma lasca de ametista e um Ressonador de cobre."
	]
	quest.4200000000220543.title: "Vinculador de eco"
	quest.4200000000220544.quest_desc: [
		"Eco que não vai escorregar.",
		"Como: Códice dos Espíritos + Tecido tribal. A estação, o totem e o custo de Pulso estão na página do Códice."
	]
	quest.4200000000220544.title: "Eco vinculado"
	quest.4200000000220545.quest_desc: [
		"Estágio de retecer — chame o lingote.",
		"Como: cinco pedras, um lingote de ouro, dois Ressonadores de cobre e uma Lasca espiritual."
	]
	quest.4200000000220545.title: "Manifestador de eco"
	quest.4200000000220546.quest_desc: [
		"Metal trazido ao ser pelo Pulso espiritual, em vez de uma fornalha.",
		"Como: Códice dos Espíritos + Tecido tribal. A estação, o totem e o custo de Pulso estão na página do Códice."
	]
	quest.4200000000220546.title: "Barra manifestada"
	quest.4200000000220547.quest_desc: [
		"Guarde o que as tribos deixaram.",
		"Como: sete tábuas, um baú e um Carrilhão de osso."
	]
	quest.4200000000220547.title: "Depósito ancestral"
	quest.4200000000220548.quest_desc: [
		"Cofre-forte ligado em direção à Marca.",
		"Como: um Esconderijo ancestral, quatro lingotes de ferro, uma Lasca espiritual, dois Ressonadores de cobre e uma Célula de Pulso."
	]
	quest.4200000000220548.title: "Depósito profundo"
	quest.4200000000220549.quest_desc: [
		"Um selo sem escrita, à espera de um rito que o preencha.",
		"Como: sete papéis, uma Lasca espiritual e um Carrilhão de osso. Faz dois."
	]
	quest.4200000000220549.title: "Selo em branco"
	quest.420000000022054A.quest_desc: [
		"Selo da tribo da pedra.",
		"Como: um Selo em branco e terra, sem forma."
	]
	quest.420000000022054A.title: "Selo de Terra"
	quest.420000000022054B.quest_desc: [
		"Selo da tribo da chama.",
		"Como: um Selo em branco e carvão vegetal, sem forma."
	]
	quest.420000000022054B.title: "Selo de Fogo"
	quest.420000000022054C.quest_desc: [
		"Selo da tribo da maré.",
		"Como: um Selo em branco e um balde de água (ou um balde de água de porcelana), sem forma."
	]
	quest.420000000022054C.title: "Selo de Água"
	quest.420000000022054D.quest_desc: [
		"Selo da tribo do vento.",
		"Como: um Selo em branco e uma pena, sem forma."
	]
	quest.420000000022054D.title: "Selo de Ar"
	quest.420000000022054E.quest_desc: [
		"Selo da tribo do zelador.",
		"Como: um Selo em branco e uma Lasca espiritual, sem forma."
	]
	quest.420000000022054E.title: "Selo de Espírito"
	quest.420000000022054F.quest_desc: [
		"Ofereça selos. Peça ao Tear.",
		"Como: cinco pedras, uma lasca de ametista e um Carrilhão de osso."
	]
	quest.420000000022054F.title: "Pedestal do rito"
	quest.4200000000220550.quest_desc: [
		"Use-o de mãos vazias e toque o Rito do portão: acerte as batidas que caem em A, S, D, F. Acerte 60% e ele abre; não precisa de Pulso.",
		"Como: use o Tambor de portão de mãos vazias e toque o Rito do portão: acerte as batidas que caem em A, S, D, F. Acerte 60% e ele abre; não precisa de Pulso. Vincule primeiro uma bússola de retorno."
	]
	quest.4200000000220550.title: "Tambor de portão (tribal)"
	quest.4200000000220551.quest_desc: [
		"Vista a soleira do seu acampamento com uma moldura espiritual entalhada. Bússolas e o Tambor de portão fazem a viagem.",
		"Como: quatro lingotes de ferro, duas Lascas espirituais, dois Ressonadores de cobre e uma lasca de ametista."
	]
	quest.4200000000220551.title: "Porta espiritual"
	quest.4200000000220552.quest_desc: [
		"Ferramenta que gasta Pulso.",
		"Como: três Lingotes manifestados, um Carrilhão de osso e um graveto."
	]
	quest.4200000000220552.title: "Picareta do equipamento espiritual"
	quest.4200000000220553.quest_desc: [
		"Gume que gasta Pulso.",
		"Como: dois Lingotes manifestados, um Carrilhão de osso e um graveto."
	]
	quest.4200000000220553.title: "Lâmina de Equipamento espiritual"
	quest.4200000000220554.quest_desc: [
		"Pedra da Marca, sob os pés, num lugar que não devia existir.",
		"Como: funda o Pedregulho da Marca. Mine-o na Marca, através de um Tambor de portão."
	]
	quest.4200000000220554.title: "Pedra da Marca (tribal)"
	quest.4200000000220555.quest_desc: [
		"Entulho da Marca, simples, mas farto.",
		"Como: mine pedra da Marca na Marca, por um Tambor de portão."
	]
	quest.4200000000220555.title: "Pedregulho da Marcha"
	quest.4200000000220556.quest_desc: [
		"Madeira crescida onde o sol não chega.",
		"Como: corte árvores da Marca, por um Tambor de portão."
	]
	quest.4200000000220556.title: "Tronco da Marcha"
	quest.4200000000220557.quest_desc: [
		"Madeira serrada da Marca, firme apesar de onde veio.",
		"Como: um Tronco da Marca faz quatro tábuas."
	]
	quest.4200000000220557.title: "Tábuas da Marcha"
	quest.4200000000220558.quest_desc: [
		"Folhas que murmuram mesmo sem vento nenhum.",
		"Como: árvores da Marca, por um Tambor de portão. Tesoura ou toque suave guardam as folhas."
	]
	quest.4200000000220558.title: "Folha da Marcha"
	quest.4200000000220559.quest_desc: [
		"Um junco que zumbe com Pulso espiritual que sobrou.",
		"Como: cresce selvagem na Marca, fica em baús do açude de junco, e um Ancião dos Liga-raízes o troca."
	]
	quest.4200000000220559.title: "Junco espiritual (tribal)"
	quest.420000000022055A.quest_desc: [
		"Coloque ferro bruto na Quebra-eco, ao lado de um Totem de Terra. Saem dois grânulos; funda na fornalha ou no alto-forno até virarem lingotes. Outros Mods podem fornecer metais brutos etiquetados.",
		"Como: Códice dos Espíritos + Tecido tribal. A estação, o totem e o custo de Pulso estão na página do Códice."
	]
	quest.420000000022055A.title: "O minério lembra duas vezes"
	quest.420000000022055B.quest_desc: [
		"A água ata a lã em Tecido espiritual. Alimente a estação por cima ou pelos lados e retire o trabalho pronto por baixo.",
		"Como: Códice dos Espíritos + Tecido tribal. A estação, o totem e o custo de Pulso estão na página do Códice."
	]
	quest.420000000022055B.title: "Pano com voz"
	quest.420000000022055C.quest_desc: [
		"Manifeste de novo um Lingote manifestado sob Espírito. O Núcleo ressonante abre equipamento mais forte e caminhos distantes.",
		"Como: Códice dos Espíritos + Tecido tribal. A estação, o totem e o custo de Pulso estão na página do Códice."
	]
	quest.420000000022055C.title: "O coração vivo"
	quest.420000000022055D.quest_desc: [
		"Leve 4,800 de Pulso numa Célula maior, ou 19,200 numa Célula grandiosa. Carregue-a num Coração de tambor ou num Ressonador antes de partir.",
		"Como: uma Célula de Pulso, dois Núcleos ressonantes e dois Lingotes manifestados."
	]
	quest.420000000022055D.title: "Uma canção mais longa"
	quest.420000000022055E.quest_desc: [
		"Dezesseis baldes numa cisterna. Baldes e canos de fluido funcionam os dois. Um comparador lê o quanto está cheia; a redstone trava o enchimento e o esvaziamento. Quebre-a e o fluido fica no bloco que cai. Os tanques de pedra do céu despejam.",
		"Como: fabrique, encha com um balde ou cano, pegue — o fluido fica. Os tanques de pedra do céu do AE2 esvaziam ao serem quebrados."
	]
	quest.420000000022055E.title: "Chuva presa no cobre"
	quest.420000000022055F.quest_desc: [
		"Marque uma face da máquina com o sintonizador e depois use-o numa placa de relé. Use-o em outra máquina para substituir a marca. Não marque a placa.",
		"Como: uma Lasca espiritual sobre dois Ressonadores de cobre."
	]
	quest.420000000022055F.title: "Nomeie a extremidade distante"
	quest.4200000000220560.quest_desc: [
		"Encaixe a placa na face de um baú ou de uma máquina. Emparelhe duas placas com o mesmo item único de Vínculo, ou vincule um destino com o afinador. A carga local alcança 32 blocos, 16 itens por segundo, por 8 de Pulso. A redstone pausa isso. Desde a 5.0 a placa quer um Totem de ressonância de Ar atendido em até oito blocos, ou fica parada e diz qual voz falta.",
		"Como: um funil, um Ressonador de cobre, dois Gizes rituais e um Lingote manifestado."
	]
	quest.4200000000220560.title: "Um caminho para os suprimentos"
	quest.4200000000220561.quest_desc: [
		"Encaixe a placa na face de um tanque. Emparelhe duas placas, ou vincule um destino com o afinador. O fluido local alcança 32 blocos: 250 mB por segundo por 8 de Pulso. As duas pontas têm de estar carregadas. Desde a 5.0 a placa quer um Totem de ressonância de Ar atendido em até oito blocos, ou fica parada e diz qual voz falta.",
		"Como: uma Cisterna dos espíritos, um Ressonador de cobre, dois Gizes rituais e um Lingote manifestado."
	]
	quest.4200000000220561.title: "Um caminho para a chuva"
	quest.4200000000220562.quest_desc: [
		"O Longoalcance leva itens até 128 blocos por 16 de Pulso a cada batida bem-sucedida. Use inventários comuns de qualquer mod compatível. Desde a 5.0 a placa quer um Totem de ressonância de Ar atendido em até oito blocos, ou fica parada e diz qual voz falta.",
		"Como: um Relé de itens, dois Núcleos ressonantes e duas pérolas de ender."
	]
	quest.4200000000220562.title: "Através da oficina"
	quest.4200000000220563.quest_desc: [
		"O Longoalcance leva fluidos até 128 blocos por 16 de Pulso a cada batida. Receptores cheios pausam em segurança; a redstone pode travar a cisterna receptora. Desde a 5.0 a placa quer um Totem de ressonância de Ar atendido em até oito blocos, ou fica parada e diz qual voz falta.",
		"Como: um Relé de fluidos, dois Núcleos ressonantes e duas pérolas de ender."
	]
	quest.4200000000220563.title: "Através das águas"
	quest.4200000000220564.quest_desc: [
		"Faça a ponte do Tribal Power até os aceitadores de energia de Mekanism, Powah ou AE2. Cada Pulso vira 100 FE. A conversão sem posto é de 60 de Pulso por segundo (6,000 FE/s); suba o posto do adaptador nas estações de Eco, e o status de mão vazia nomeia a taxa ao vivo. Ele ainda não pode receber FE. A redstone para a conversão e a exportação.",
		"Como: cinco lingotes de cobre, três redstone e um Núcleo ressonante."
	]
	quest.4200000000220564.title: "O compasso vira corrente"
	quest.4200000000220565.quest_desc: [
		"O Cajado sêxtuplo. Use agachado para alternar Terra, Fogo, Água, Ar, Espírito e Tear. Use para lançar; a voz do Tear é Amarra, que puxa um alvo oito blocos na sua direção, e um lançamento agachado sem alvo é Ponto, um salto de seis blocos. Leve células carregadas; o Códice dos Espíritos explica cada feitiço e o custo.",
		"Como: um Selo espiritual, um Núcleo ressonante, um Lingote manifestado e dois troncos."
	]
	quest.4200000000220565.title: "Seis vozes numa mão"
	quest.4200000000220566.quest_desc: [
		"Na mão principal, use agachado uma face de pedra: um corte deliberado de três por três a 8 de Pulso por bloco. A proteção normal de quebra e os requisitos de ferramenta ainda valem.",
		"Como: dois Lingotes manifestados, um Núcleo ressonante e dois Ressonadores de cobre."
	]
	quest.4200000000220566.title: "A pedra cede uma porta"
	quest.4200000000220567.quest_desc: [
		"O capuz empresta visão noturna enquanto células carregadas a sustentam. Peças sem vínculo puxam 2 de Pulso a cada quatro segundos; uma voz vinculada custa 3.",
		"Como: cinco Tecidos espirituais, em forma de elmo. Uma Lente de ley nele, mais tarde, deixa ver a ley."
	]
	quest.4200000000220567.title: "Olhos no silêncio"
	quest.4200000000220568.quest_desc: [
		"A túnica concede resistência. Vista-a no trabalho e mantenha as células carregadas.",
		"Como: sete Tecidos espirituais e um Núcleo ressonante."
	]
	quest.4200000000220568.title: "Um abrigo tecido"
	quest.4200000000220569.quest_desc: [
		"As calças tecidas emprestam velocidade. O custo de Pulso delas fica separado das outras peças.",
		"Como: seis Tecidos espirituais e um Núcleo ressonante."
	]
	quest.4200000000220569.title: "O acampamento acompanha o passo"
	quest.420000000022056A.quest_desc: [
		"As botas podem emprestar queda lenta na descida enquanto restar Pulso. Um caminho de retorno vinculado ainda vale a pena carregar.",
		"Como: quatro Tecidos espirituais, em forma de bota."
	]
	quest.420000000022056A.title: "Uma descida mais suave"
	quest.420000000022056B.quest_desc: [
		"Assente um selo reutilizável ao lado do totem correspondente. Uma bênção de seis blocos custa 8 de Pulso a cada dois segundos. Redstone alta pausa; agache de mãos vazias para recuperar o selo.",
		"Como: dois Lingotes manifestados, dois lingotes de cobre, um Núcleo ressonante e três pedras."
	]
	quest.420000000022056B.title: "Uma bênção que fica"
	quest.420000000022056C.quest_desc: [
		"Use agachado o topo de um piso sólido para vinculá-lo. Volte em até 128 blocos, no mesmo mundo, por 20 de Pulso. Energize o piso de chegada para travar as chegadas.",
		"Como: uma bússola dentro de quatro Lingotes manifestados."
	]
	quest.420000000022056C.title: "O primeiro caminho de volta"
	quest.420000000022056D.quest_desc: [
		"Volte qualquer distância dentro de uma dimensão por 40 de Pulso. Deixe um pouso seco com dois blocos livres acima.",
		"Como: uma Bússola de marco dentro de quatro Núcleos ressonantes."
	]
	quest.420000000022056D.title: "Além do horizonte"
	quest.420000000022056E.quest_desc: [
		"Busque Cristal da Marca além do Tambor de portão. Os caminhos astrais de pessoas, itens e fluidos bebem todos do mesmo material tardio.",
		"Como: mine cristal nas grutas da Marca, ou ache-o nos baús da Marca. Tambor de portão primeiro."
	]
	quest.420000000022056E.title: "Uma voz além do véu"
	quest.420000000022056F.quest_desc: [
		"A bússola final cruza dimensões por 100 de Pulso. Vincule um retorno seguro antes de explorar. A viagem espera cinco segundos entre usos.",
		"Como: uma Bússola do horizonte, dois Selos espirituais e dois Cristais da Marca."
	]
	quest.420000000022056F.title: "Um caminho entre mundos"
	quest.4200000000220570.quest_desc: [
		"A carga astral cruza dimensões sem limite de distância. Cada batida bem-sucedida custa 32 de Pulso. O receptor já deve estar carregado; sem carregamento oculto de chunks. Desde 5.0 a placa quer um Totem de ressonância (Tear) atendido em oito blocos, ou fica parada e diz qual voz falta.",
		"Como: um Relé de itens de longo alcance, dois Selos de Espírito e dois Cristais da Marca."
	]
	quest.4200000000220570.title: "Suprimentos cruzam o véu"
	quest.4200000000220571.quest_desc: [
		"O fluido astral segue o mesmo nível dimensional que jogadores e itens. Mantenha o tanque de destino carregado. Um tanque cheio ou um mundo não carregado pausa sem consumir a carga. Desde 5.0 a placa quer um Totem de ressonância (Tear) atendido em oito blocos, ou fica parada e diz qual voz falta.",
		"Como: um Relé de fluidos de longo alcance, dois Selos de Espírito e dois Cristais da Marca."
	]
	quest.4200000000220571.title: "A chuva cruza o véu"
	quest.4200000000220572.quest_desc: [
		"Abra da estrada o seu Esconderijo profundo pessoal de 54 espaços. É o mesmo cofre, compartilhado entre seus esconderijos e a algibeira. A sintonia com a Marca remove o custo de abri-lo.",
		"Como: seis Tecidos espirituais, dois Núcleos ressonantes e um Esconderijo profundo."
	]
	quest.4200000000220572.title: "O acampamento sob sua guarda"
	quest.4200000000220573.quest_desc: [
		"O Portão abre para um país vivo. Algumas criaturas ainda carregam a canção antiga; outras guardam os pedaços quebrados dela. Escove as mansas. Encare os guardiões com células de Pulso carregadas e uma rota de volta.",
		"Como: fabrique, ou pegue como recompensa de Centelha/Tecido tribal. Clique direito: como a treliça funciona."
	]
	quest.4200000000220573.title: "A canção que volta"
	quest.4200000000220574.quest_desc: [
		"Um pastador da alvorada que carrega o velho canto da floresta na galhada. Reproduza com trigo; escove os adultos para obter Veludo da alvorada.",
		"Procure-o nas florestas do Mundo Superior e na Marca. Devolva o reagente dele ao Vínculo de eco, sob a voz Água, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: escove um Cervo da alvorada adulto. Reproduza-os com trigo."
	]
	quest.4200000000220574.title: "Cervo da alvorada: uma canção devolvida"
	quest.4200000000220575.quest_desc: [
		"Um coletor tímido do crepúsculo, cujo rabo marca caminhos seguros. Reproduza com bagas doces; escove os adultos para obter Penugem de lanterna.",
		"Procure-o nas florestas do Mundo Superior e na Marca. Devolva o reagente dele ao Vínculo de eco, sob a voz Água, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: escove uma Raposa-lanterna adulta. Reproduza-as com bagas doces."
	]
	quest.4200000000220575.title: "Raposa-lanterna: uma canção devolvida"
	quest.4200000000220576.quest_desc: [
		"Um jardineiro paciente das áreas úmidas, com uma concha viva. Reproduza com erva marinha; escove os adultos para uma Escama de Dorsomusgo largada naturalmente.",
		"Procure-o nos pântanos do Mundo Superior e na Marca. Devolva o reagente dele ao Vínculo de eco, sob a voz Água, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: escove um Dorsomusgo adulto. Reproduza-os com erva marinha."
	]
	quest.4200000000220576.title: "Dorsomusgo: uma canção devolvida"
	quest.4200000000220577.quest_desc: [
		"Os restos de um rito de fogo quebrado. Seus golpes corpo a corpo acendem por um instante; mantenha água por perto.",
		"Procure-o nas florestas do Mundo Superior e na Marca. Devolva o reagente dele à Sintonia de eco, sob a voz Espírito, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai do Cinzeligado. Espíritos hostis precisam de escuridão."
	]
	quest.4200000000220577.title: "Cinzeligado: uma canção devolvida"
	quest.4200000000220578.quest_desc: [
		"Um guardião do arvoredo, torcido por uma linha ley cortada. Lento, mas firme; os golpes enraízam os viajantes por um instante.",
		"Procure-o nas florestas do Mundo Superior e na Marca. Devolva o reagente dele à Sintonia de eco, sob a voz Espírito, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai do Raizligado. Espíritos hostis precisam de escuridão."
	]
	quest.4200000000220578.title: "Raizligado: uma canção devolvida"
	quest.4200000000220579.quest_desc: [
		"Um caçador do pântano, oculto entre juncos espirituais. Os golpes rápidos trazem um veneno curto.",
		"Procure-o nos pântanos do Mundo Superior e na Marca. Devolva o reagente dele à Sintonia de eco, sob a voz Espírito, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai do Espreita-junco. Espíritos hostis precisam de escuridão."
	]
	quest.4200000000220579.title: "Espreita-junco: uma canção devolvida"
	quest.420000000022057A.quest_desc: [
		"Um catador dos campos de cristal, couraçado de pedra que canta. Mantenha distância do empurrão pesado.",
		"Procure-o na Marca. Devolva o reagente dele à Sintonia de eco, sob a voz Espírito, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai do Dorsoestilhaço. Espíritos hostis precisam de escuridão."
	]
	quest.420000000022057A.title: "Dorsoestilhaço: uma canção devolvida"
	quest.420000000022057B.quest_desc: [
		"Um vigia vazio que ainda guarda as estradas antigas. Seu toque enfraquece o aperto de quem ataca.",
		"Procure-o na Marca. Devolva o reagente dele à Sintonia de eco, sob a voz Espírito, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai da Sentinela oca. Espíritos hostis precisam de escuridão."
	]
	quest.420000000022057B.title: "Sentinela oca: uma canção devolvida"
	quest.420000000022057C.quest_desc: [
		"Um espírito alimentado pela tempestade, com vastas asas de véu. Um ajuntamento brilhante de grãos avisa da rajada; a cobertura quebra o ataque.",
		"Procure-a na Marca. Devolva o reagente dela ao Vínculo de eco, sob a voz Água, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai da Mariposa da tempestade. Espíritos hostis precisam de escuridão."
	]
	quest.420000000022057C.title: "Mariposa da tempestade: uma canção devolvida"
	quest.420000000022057D.quest_desc: [
		"Um espírito ágil de brasa. Ele junta centelhas antes de um raio ardente; o feitiço nunca acende o terreno.",
		"Procure-o na Marca. Devolva o reagente dele à Sintonia de eco, sob a voz Espírito, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai do Diabrete de brasa. Espíritos hostis precisam de escuridão."
	]
	quest.420000000022057D.title: "Diabrete de brasa: uma canção devolvida"
	quest.420000000022057E.quest_desc: [
		"Uma relíquia flutuante que lembra as tribos perdidas. Seu sino anunciado desacelera; um abrigo interrompe a canção.",
		"Procure-o na Marca. Devolva o reagente dele à Sintonia de eco, sob a voz Espírito, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai do Sino do luto. Espíritos hostis precisam de escuridão."
	]
	quest.420000000022057E.title: "Sino do luto: uma canção devolvida"
	quest.420000000022057F.quest_desc: [
		"Um caçador atraído pelos rasgos na treliça. Ele encurta a distância depressa, mas não atravessa mundos sozinho.",
		"Procure-o na Marca. Devolva o reagente dele à Sintonia de eco, sob a voz Espírito, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai do Sabujo da fenda. Espíritos hostis precisam de escuridão."
	]
	quest.420000000022057F.title: "Sabujo da fenda: uma canção devolvida"
	quest.4200000000220580.quest_desc: [
		"Um guardião de oito patas, das canções quebradas. A mordida desacelera a presa sem colocar teias nem danificar o acampamento.",
		"Procure-a na Marca. Devolva o reagente dela ao Vínculo de eco, sob a voz Água, para um material útil. Construa caminhos iluminados; espíritos hostis exigem escuridão.",
		"Como: cai do Tecelão de eco. Espíritos hostis precisam de escuridão."
	]
	quest.4200000000220580.title: "Tecelão de eco: uma canção devolvida"
	quest.4200000000220581.quest_desc: [
		"As notas de campo estão completas. As colheitas suaves e as relíquias recuperadas voltaram a ser tecido e Ecos. Sob o véu da noite, o acampamento responde com uma canção mais cheia.",
		"Recompensa rara: uma vida compartilhada do Clowder, uma vez para a equipe toda. Só existem seis recompensas assim na campanha.",
		"Como: Códice dos Espíritos + Tecido tribal. A estação, o totem e o custo de Pulso estão na página do Códice."
	]
	quest.4200000000220581.title: "Treze vozes, um céu"
	quest.4200000000220582.quest_desc: [
		"Pendure a canção do acampamento no cobre. Uma Lanterna espiritual dá luz plena sem combustível; a redstone a atenua. Marque caminhos seguros de volta da escuridão.",
		"Como: três barras de cobre, uma Lasca espiritual e uma tábua."
	]
	quest.4200000000220582.title: "Uma luz para quem volta"
	quest.4200000000220583.quest_desc: [
		"O carrilhão é enfeite e instrumento ao mesmo tempo. O comparador dele dá 0 com céu limpo, 8 na chuva e 15 na trovoada. A redstone o silencia.",
		"Como: três tábuas, três barras de cobre e um Carrilhão de osso."
	]
	quest.4200000000220583.title: "Ouça o tempo"
	quest.4200000000220584.quest_desc: [
		"Uma mesa entalhada guarda 27 pilhas. Tubos de itens e relés comuns podem compartilhar suas oferendas; comparadores leem o quanto está cheia e a redstone tranca o acesso.",
		"Como: um baú, um Eco vinculado, duas tábuas e duas pedras."
	]
	quest.4200000000220584.title: "Um lugar junto à lareira"
	quest.4200000000220585.quest_desc: [
		"Coloque o Cuidador do arvoredo na altura da plantação, num canteiro de 9 por 9. Ponha as sementes na primeira fileira; as colheitas enchem as duas fileiras de baixo. Plantar custa 4 de Pulso; colher e replantar custa 12. Forneça energia em até oito blocos. Uma saída cheia preserva a plantação; a redstone pausa o trabalho. Desde a 5.0 ele quer um Totem de ressonância de Terra atendido em até oito blocos, ou fica parado e diz qual voz está faltando. Mantenha um totem de Água perto também, e ele rega cada sulco do canteiro.",
		"Como: uma enxada de ferro, um Selo de Terra, um Eco ligado, dois lingotes de cobre e duas tábuas."
	]
	quest.4200000000220585.title: "O jardim continua cantando"
	quest.4200000000220586.quest_desc: [
		"Oito de Pulso por segundo impedem o surgimento de hostis em 24 blocos. As criaturas que já estão permanecem. A guarda também impede invocações hostis do Berço, então mantenha o chão de invocação do lado de fora. A redstone silencia a guarda na hora. Desde a 5.0 ele quer um Totem de ressonância de Espírito atendido em até oito blocos, ou fica parado e diz qual voz está faltando.",
		"Como: um Selo de Espírito, dois Ecos ligados, uma Lasca de eco e três Tábuas da Marca."
	]
	quest.4200000000220586.title: "Sossego na borda do acampamento"
	quest.4200000000220587.quest_desc: [
		"A Âncora do caminho mantém o próprio chunk acordado por 16 de Pulso a cada segundo. Coloque uma num receptor de relé distante e sustente a energia local. No máximo, 32 âncoras podem funcionar numa dimensão. A redstone ou um buffer vazio solta o chunk. Desde a 5.0 ela quer um Totem de ressonância de Terra atendido em até oito blocos, ou fica parada e diz qual voz está faltando.",
		"Como: dois Cristais da Marca, um Olho de ender, dois Lingotes manifestados, um Núcleo ressonante e três Pedras da Marca."
	]
	quest.4200000000220587.title: "Um acampamento que lembra"
	quest.4200000000220588.quest_desc: [
		"Use agachado uma efígie sem carga numa criatura suportada, para tirar uma marca inofensiva. A efígie lembra a espécie. Chefes não podem ser vinculados; o Códice explica os espíritos compatíveis e a renovação.",
		"Como: um Carrilhão de osso, dois Tecidos espirituais, um Núcleo ressonante e um Eco ligado."
	]
	quest.4200000000220588.title: "Pegue uma voz viva emprestada"
	quest.4200000000220589.quest_desc: [
		"Assente uma efígie despertada no primeiro espaço e Tecido espiritual no segundo. Cada invocação bem-sucedida gasta 80 de Pulso, um Tecido espiritual e um fio de vínculo. Deixe piso seguro em até três blocos. Oito criaturas próximas pausam o Berço de invocação; a redstone pausa todo o trabalho e a automação. Desde a 5.0 ele quer um Totem de ressonância de Espírito mantido a oito blocos, ou fica parado e diz qual voz falta.",
		"Como: dois Lingotes manifestados, um Cristal da Marca, dois Ecos ligados, um Núcleo ressonante e três Tábuas da Marca."
	]
	quest.4200000000220589.title: "Uma lareira para vida emprestada"
	quest.420000000022058A.quest_desc: [
		"Ponha um Selo de Espírito num Braseiro ritual. Traga totens de Terra, de Ar e de Espírito a oito blocos, 200 de Pulso por perto e três Tecidos espirituais no seu inventário. Use a efígie com a marca no braseiro para despertar 512 fios de invocação. Quando todos se gastarem, repita este rito para renovar o vínculo.",
		"Como: Selo de Espírito num Braseiro ritual; totens de Terra, Ar e Espírito a 8; 200 de Pulso; três Tecidos espirituais; use a efígie com a marca."
	]
	quest.420000000022058A.title: "Três vozes despertam o fio"
	quest.420000000022058B.quest_desc: [
		"Complete uma invocação bem-sucedida. Tentativas falhas ou bloqueadas não gastam fios nem oferendas. Cada vínculo dura 512 invocações bem-sucedidas; quebrar e repor o Berço de invocação nunca renova o vínculo. A dica da efígie mostra os usos que restam, e um comparador lê a força de vínculo que resta ao berço.",
		"Como: complete uma invocação bem-sucedida a partir do Berço de invocação. Tentativas falhas não gastam nada."
	]
	quest.420000000022058B.title: "Uma resposta do berço"
	quest.4200000000228001.quest_desc: [
		"Além do Tambor de portão, a estepe e as terras altas da Marca escondem Salões dos ancestrais afundados. Entrar a pé marca isto. Quatro Tabuletas de história ladeiam cada salão; leia todas. Os baús guardam Fio do tear, Ecos, Tecido espiritual e selos. Sentinelas ocas ainda fazem guarda.",
		"Como: Tambor de portão até a Marca e entre a pé num Salão dos ancestrais; depois leia suas quatro Tabuletas de história."
	]
	quest.4200000000228001.title: "Os salões que guardaram o tempo"
	quest.4200000000228002.quest_desc: [
		"O Fio do tear é o Tear, na mão: os baús dos Salões dos ancestrais guardam de dois a quatro, o Não Cantado solta dezesseis ou mais, e um Ancião dos Costureiros do tear troca um no posto Amigo. É o reagente da sexta voz.",
		"Como: baús dos Salões dos ancestrais, o Não Cantado, ou um Ancião dos Costureiros do tear em Amigo."
	]
	quest.4200000000228002.title: "Uma Trama do fio em si"
	quest.4200000000228003.quest_desc: [
		"Oito Pedras da Marca em volta de uma Lasca de eco fazem duas Tabuletas de história. Colocada, uma tabuleta mostra um fragmento das nove tribos; um uso agachado no criativo troca qual. Forre seu próprio salão com elas.",
		"Como: oito Pedras da Marca em volta de uma Lasca de eco. Faz duas."
	]
	quest.4200000000228003.title: "Entalhe o que você lê"
	quest.4200000000228004.quest_desc: [
		"Couro sobre Tábuas da Marca, em volta de um Núcleo ressonante. O Círculo de tambores, nas terras altas da Marca, já guarda um; este é seu para assentar em casa. Golpeie-o quatro vezes, um fôlego entre cada, e algo antigo se ergue.",
		"Como: três couros, cinco Tábuas da Marca e um Núcleo ressonante."
	]
	quest.4200000000228004.title: "Um tambor que não vai soar"
	quest.4200000000228005.quest_desc: [
		"O Não Cantado é um espírito de tambor de três fases. Batida: firme-se agachando contra a onda de choque. Coro: derrube os Tecelões de eco que ele chama. Silêncio: ele não pode ser ferido até você golpear o Tambor silencioso com o mesmo ritmo de quatro batidas, que o atordoa e dobra o seu dano. Leve células de Pulso carregadas e um caminho de volta.",
		"Como: lute contra o Não Cantado no Tambor silencioso. Agache na Batida; quatro batidas no Silêncio."
	]
	quest.4200000000228005.title: "O tambor lembra"
	quest.4200000000228006.quest_desc: [
		"Um Coração do Não Cantado por abate, junto com Fio do tear e Núcleos ressonantes. Ele faz o totem do Tear e nada mais, então gaste-o com cuidado.",
		"Como: o Não Cantado no Tambor silencioso larga um por abate."
	]
	quest.4200000000228006.title: "O tambor aquietado"
	quest.4200000000228007.quest_desc: [
		"Um Coração do Não Cantado entre Fio do tear e Cristal da Marca, sobre Tábuas da Marca. O Tear junta-se a Terra, Fogo, Água, Ar e Espírito: uma voz distinta para o Ressonador de Pulso e a sintonia que a Destrama de eco e o Vínculo de ley pedem.",
		"Como: um Coração do Não Cantado, quatro Cristais da Marca, dois Fio do tear e duas Tábuas da Marca."
	]
	quest.4200000000228007.title: "A sexta voz"
	quest.4200000000228008.quest_desc: [
		"Um Selo em branco e Fio do tear. Assentado num Braseiro ritual, o Selo do tear abençoa a tensão: a cada dois segundos recarrega dois de Pulso nas células que cada um carrega no alcance, e empresta Sorte.",
		"Como: um Selo em branco e Fio do tear, sem forma."
	]
	quest.4200000000228008.title: "Um selo de tensão"
	quest.4200000000228009.quest_desc: [
		"Fio do tear e Ressonadores de cobre sobre Pedra da Marca. Sob uma voz do Tear, o Destecer de eco faz a treliça correr para trás: um Lingote manifestado em dois Ecos ligados, o Ligado em dois Sintonizados, o Sintonizado em duas Lascas, Tecido espiritual em duas lãs, um Núcleo ressonante em três Lingotes manifestados, e qualquer ferramenta gasta de equipamento espiritual em um Lingote manifestado.",
		"Como: cinco Pedras da Marca, Fio do tear, dois Ressonadores de cobre e uma Lasca espiritual."
	]
	quest.4200000000228009.title: "A treliça, ao contrário"
	quest.420000000022800A.quest_desc: [
		"Gire o Cajado sêxtuplo até a voz do Tear. Amarra puxa um alvo oito blocos na sua direção por seis de Pulso; um lançamento agachado sem alvo é Ponto, um piscar de seis blocos pelo ar por dez. Marque isto quando você tiver usado os dois.",
		"Como: Cajado sêxtuplo na voz do Tear. Amarre um alvo e depois faça Ponto agachado. Marque quando os dois tiverem saído."
	]
	quest.420000000022800A.title: "Amarra e Ponto"
	quest.420000000022800B.quest_desc: [
		"Nove acampamentos de tribo ficam na Marca, um por Trama: cabanas, uma fogueira, uma Lareira da tribo, um totem, um estandarte e quatro Parentes da tribo. Clique com o botão direito numa lareira com o que essa tribo prefere, ou com uma Célula de Pulso carregada, e sua reputação com eles sobe. Ferir um Parente custa 25. Quebrar o estandarte de uma tribo custa 5, a lareira 40. Blocos genéricos do acampamento não custam.",
		"Como: clique direito numa Lareira de tribo da Marca com o que essa tribo favorece, ou com uma Célula de Pulso carregada."
	]
	quest.420000000022800B.title: "Mantido quente"
	quest.420000000022800C.quest_desc: [
		"Convidado aos 50, Amigo aos 150, Parente aos 400, Voz aos 800. Mortes perto de uma lareira e trocas concluídas também contam. Os Anciãos trocam duas ofertas por posto: os Cantores de cascalho vendem Ecos por minério bruto, os Entalhadores de selos vendem selos e tábuas de rito, os Costureiros do tear vendem Fio do tear e uma Bússola de marco, e em Parente uma Âncora do tear e um Selo do tear. `/tribalpower standing` mostra as nove.",
		"Como: chegue a Amigo (150) com uma tribo. /tribalpower standing."
	]
	quest.420000000022800C.title: "Em bons termos"
	quest.420000000022800D.quest_desc: [
		"Na posição Voz, um Ancião pressiona uma Marca da tribo na sua mão, uma vez. Ela abre a página do Códice dessa tribo e é o único ingrediente de que um Totem de parentesco não pode passar.",
		"Como: Voz (800) com uma tribo; o Ancião dá uma Marca da tribo uma vez."
	]
	quest.420000000022800D.title: "Nove de acordo"
	quest.420000000022800E.quest_desc: [
		"Segure uma Marca da tribo. A de cada tribo é diferente; nove são possíveis.",
		"Como: chegue a Voz (800) com uma tribo; o Ancião dela dá a Marca uma vez."
	]
	quest.420000000022800E.title: "Marca da tribo"
	quest.420000000022800F.quest_desc: [
		"Uma Marca da tribo, o Totem de ressonância da sintonia dessa tribo e dois Tecidos espirituais. Um Totem de parentesco conta como uma voz distinta a mais para o Ressonador de Pulso e empresta a sintonia da tribo dele às estações, então nove tribos podem levar a canção do acampamento a quinze vozes.",
		"Como: uma Marca da tribo, o Totem de ressonância dessa tribo e dois Tecidos espirituais na grade."
	]
	quest.420000000022800F.title: "Uma voz que não é uma voz"
	quest.4200000000228010.quest_desc: [
		"O Tamborileiro de um acampamento toca a cada poucos segundos; coloque um Coração de tambor a oito blocos de um, e cada batida lhe dá dois de Pulso. Marque isto quando um Tamborileiro estiver alimentando a sua treliça.",
		"Como: coloque um Coração de tambor a 8 de um Tamborileiro do acampamento; marque quando ele estiver dando Pulso."
	]
	quest.4200000000228010.title: "O acampamento segura o compasso"
	quest.4200000000228011.quest_desc: [
		"Duas pedras e o reagente ao redor do selo; o selo é devolvido. Raiz nodosa ao lado de um Selo de Terra; 600 de Pulso. Por vinte minutos, plantações, mudas e caules crescem mais rápido nos nove chunks ao redor do braseiro. Use a tábua agachado num Braseiro ritual com esse selo assentado, dentro do Círculo de rito dele (quatro pedestais nas diagonais, o giz os liga); o Pulso é puxado da treliça num raio de oito blocos.",
		"Como: duas pedras, uma Raiz nodosa e um Selo de Terra, sem forma; o selo volta."
	]
	quest.4200000000228011.title: "Tábua de rito: Bênção verde"
	quest.4200000000228012.quest_desc: [
		"Duas pedras e o reagente ao redor do selo; o selo é devolvido. Presa de junco ao lado de um Selo de Água; 400 de Pulso. Vinte minutos de chuva, para as cisternas e as plantações. Use a tábua agachado num Braseiro ritual com esse selo assentado, dentro do Círculo de rito dele (quatro pedestais nas diagonais, o giz os liga); o Pulso é puxado da treliça num raio de oito blocos.",
		"Como: duas pedras, uma Presa de junco e um Selo de Água, sem forma; o selo volta."
	]
	quest.4200000000228012.title: "Tabuleta de rito: Chamado da chuva"
	quest.4200000000228013.quest_desc: [
		"Duas pedras e o reagente ao redor do selo; o selo é devolvido a você. Asa de tempestade ao lado de um Selo de ar; 400 de Pulso. Quarenta minutos de céu limpo. Use agachado a tábua num Braseiro ritual com esse selo assentado, dentro do Círculo de rito dele (quatro pedestais nas diagonais, o giz os une); o Pulso é puxado da treliça num raio de oito blocos.",
		"Como: duas pedras, uma Asa de tempestade e um Selo de ar, sem forma; o selo volta."
	]
	quest.4200000000228013.title: "Tabuleta de rito: Clareamento do céu"
	quest.4200000000228014.quest_desc: [
		"Duas pedras e o reagente ao redor do selo; o selo é devolvido a você. Coração de brasa ao lado de um Selo de fogo; 800 de Pulso. Apressa a noite até o próximo nascer do sol, para o mundo inteiro. Use agachado a tábua num Braseiro ritual com esse selo assentado, dentro do Círculo de rito dele (quatro pedestais nas diagonais, o giz os une); o Pulso é puxado da treliça num raio de oito blocos.",
		"Como: duas pedras, um Coração de brasa e um Selo de fogo, sem forma; o selo volta."
	]
	quest.4200000000228014.title: "Tábua de rito: chamado da alvorada"
	quest.4200000000228015.quest_desc: [
		"Duas pedras e o reagente ao redor do selo; o selo é devolvido a você. Selo sentinela ao lado de um Selo de espírito; 600 de Pulso. Quinze minutos sem surgimentos hostis em sessenta e quatro blocos. Use agachado a tábua num Braseiro ritual com esse selo assentado, dentro do Círculo de rito dele (quatro pedestais nas diagonais, o giz os une); o Pulso é puxado da treliça num raio de oito blocos.",
		"Como: duas pedras, um Selo sentinela e um Selo de espírito, sem forma; o selo volta."
	]
	quest.4200000000228015.title: "Tábua de rito: noite quieta"
	quest.4200000000228016.quest_desc: [
		"Duas pedras e o reagente ao redor do selo; o selo é devolvido a você. Fio do tear ao lado de um Selo do tear; 1.200 de Pulso. Liga o totem mais próximo a outro em sessenta e quatro blocos com uma linha ley de trinta minutos que conduz Pulso entre eles. Use agachado a tábua num Braseiro ritual com esse selo assentado, dentro do Círculo de rito dele (quatro pedestais nas diagonais, o giz os une); o Pulso é puxado da treliça num raio de oito blocos.",
		"Como: duas pedras, Fio do tear e um Selo do tear, sem forma; o selo volta."
	]
	quest.4200000000228016.title: "Tábua de rito: vínculo ley"
	quest.4200000000228017.quest_desc: [
		"Faça qualquer rito. Se a treliça ao redor do braseiro tiver Pulso de menos, nada é consumido e o braseiro avisa.",
		"Como: use agachado qualquer Tábua de rito num Braseiro ritual no Círculo de rito dele, com o selo e o Pulso correspondentes."
	]
	quest.4200000000228017.title: "Primeiro rito"
	quest.4200000000228018.quest_desc: [
		"Dois Tecidos espirituais, uma Lasca espiritual e o reagente da espécie. Use num familiar adulto. Animais: sessenta por cento, o amuleto fica se falhar. Os restos querem Voz com a tribo deles, quarenta por cento, o amuleto é gasto se falhar.",
		"Como: dois Tecidos espirituais, uma Lasca espiritual e um reagente de familiar (Veludo da alvorada, Penugem de lanterna, Asa de tempestade e afins)."
	]
	quest.4200000000228018.title: "Um amuleto para uma criatura selvagem"
	quest.4200000000228019.quest_desc: [
		"Um familiar vinculado segue você, teleporta-se atrás de você, nunca some, você não pode feri-lo e rende o dobro quando você o escova. A Raposa-lanterna, o Dorsomusgo e o Cervo da alvorada são por onde você começa. Os restos precisam de Voz. Um lutador e dois ajudantes podem seguir; quem senta não conta.",
		"Como: use um Amuleto de vínculo num familiar adulto. O progresso dispara no primeiro vínculo."
	]
	quest.4200000000228019.title: "Um amigo no escuro"
	quest.420000000022801A.quest_desc: [
		"Papel, Tecido espiritual e uma Lasca espiritual. Use a carta num jogador para convidá-lo ao seu acampamento, ou no ar para vê-lo. `/tribalpower camp` cria, convida, entra, sai, expulsa e renomeia.",
		"Como: papel, Tecido espiritual e uma Lasca espiritual, sem forma."
	]
	quest.420000000022801A.title: "Um acampamento de muitas vozes"
	quest.420000000022801B.quest_desc: [
		"Os membros do acampamento compartilham um cofre de acampamento de cinquenta e quatro espaços atrás de cada Esconderijo profundo e cada Algibeira do viajante, contam como donos dos aparelhos uns dos outros, juntam doze Âncoras do caminho e espelham no acampamento um quarto da estima com a tribo. Um Clowder não é esse acampamento — /tribalpower camp create <name> é.",
		"Como: /tribalpower camp create <name> (não é um Clowder). O progresso dispara no primeiro acampamento."
	]
	quest.420000000022801B.title: "Um cofre, um orçamento"
	quest.420000000022801C.quest_desc: [
		"Um painel de vidro sobre um Ressonador de cobre e uma Lasca espiritual. Na mão, a lente mostra a força da ley onde você está e a pinta no chão ao redor; use-a agachado num Coletor de ley, ou num familiar, para ver os números.",
		"Como: um painel de vidro, um Ressonador de cobre e uma Lasca espiritual, em coluna."
	]
	quest.420000000022801C.title: "Ver a ley"
	quest.420000000022801D.quest_desc: [
		"Quartzo sobre redstone e um Ressonador de cobre, sobre Pedra da Marca. Voltado para qualquer suporte de Pulso, emite redstone de 0 a 15 na proporção do que está guardado.",
		"Como: quartzo, dois redstone, um Ressonador de cobre e Pedra da Marca."
	]
	quest.420000000022801D.title: "Uma agulha para o Pulso"
	quest.420000000022801E.quest_desc: [
		"Uma tocha de redstone sobre redstone e um Ressonador de cobre, sobre Pedra da Marca. Ele emite quando o suporte voltado está no limiar ou acima; o clique direito percorre 25, 50, 75 e 100 por cento. As peças de uma automação movida a Pulso.",
		"Como: uma tocha de redstone, dois redstone, um Ressonador de cobre e Pedra da Marca."
	]
	quest.420000000022801E.title: "Uma linha na canção"
	quest.420000000022801F.quest_desc: [
		"Use agachado o Códice dos Espíritos em qualquer bloco tribal para um relatório simples: o Pulso armazenado, os geradores que o alimentam, as sintonias em oito blocos, o que falta para a receita atual, uma saída cheia, uma pausa de redstone, uma ponta de relé não carregada. Marque isto quando ele tiver dito algo que você não sabia.",
		"Como: use agachado o Códice dos Espíritos num bloco tribal; marque quando o relatório nomear uma falha real."
	]
	quest.420000000022801F.title: "Pergunte ao Códice por quê"
	quest.4200000000228020.quest_desc: [
		"Peça pedregulho a uma Fonte de Pedra. A Pedra não se faz; pede-se à pedra que fique. O pedregulho só precisa da forma e de Pulso; um Totem de Terra em oito blocos deixa que ela peça pedra.",
		"Como: cinco pedregulhos, uma Lasca de eco e um Coração de tambor."
	]
	quest.4200000000228020.title: "Uma fonte de pedra"
	quest.4200000000228021.quest_desc: [
		"Complete qualquer padrão. A colocação é o ritual: aparelhos espalhados não são um rito.",
		"Como: coloque um padrão de rito do Códice dos Espíritos; o progresso dispara no primeiro círculo completo."
	]
	quest.4200000000228021.title: "Trace o círculo"
	quest.4200000000228022.quest_desc: [
		"Peça a uma Fonte de Pedra o primeiro pedregulho. A Pedra não se faz; pede-se à pedra que fique.",
		"Como: rode a Fonte de Pedra até o pedregulho aparecer. Progresso na primeira vez que fica."
	]
	quest.4200000000228022.title: "A Pedra fica"
	quest.4200000000228023.quest_desc: [
		"Use agachado o Códice dos Espíritos na fonte quando ela estiver trabalhando. Marque isto quando o relatório nomear Pulso armazenado ou um totem faltando.",
		"Como: use agachado o Códice dos Espíritos na Fonte de Pedra; marque quando o relatório nomear uma falha real ou um buffer cheio."
	]
	quest.4200000000228023.title: "A fonte responde"
	quest.4200000000228024.quest_desc: [
		"Mantenha uma célula carregada na fonte para o pedido não estancar.",
		"Como: encha uma Célula de Pulso num Coração de tambor e marque isto quando a fonte estiver alimentada."
	]
	quest.4200000000228024.title: "Uma célula na fonte"
	quest.4200000000228025.quest_desc: [
		"A malha não acha o minério; a malha dá ao minério um lugar para pousar. Assente-a sobre um Fosso de escuta.",
		"Como: quatro Pedras da Marca, dois Ecos sintonizados, dois Tecidos espirituais e um Ressonador de cobre."
	]
	quest.4200000000228025.title: "Uma malha que escuta"
	quest.4200000000228026.quest_desc: [
		"Quatro Pedras de âncora seguram os cantos do fosso. Sem elas a malha não tem onde ficar.",
		"Como: quatro Pedras da Marca sobre uma Lasca de eco. Faz quatro."
	]
	quest.4200000000228026.title: "Quatro âncoras"
	quest.4200000000228027.quest_desc: [
		"Chame o primeiro minério através de um Fosso de escuta.",
		"Como: Malha de ressonância sobre um fosso com Pedras de âncora; o progresso dispara no primeiro minério."
	]
	quest.4200000000228027.title: "Pergunte ao chão"
	quest.4200000000228028.quest_desc: [
		"Os grânulos de ouro do fosso são a voz seguinte depois do ferro.",
		"Como: continue perguntando ao chão; marque quando os grânulos de ouro estiverem na mão."
	]
	quest.4200000000228028.title: "Ouro do fosso"
	quest.4200000000228029.quest_desc: [
		"O fosso gasta Pulso. Mantenha uma célula na malha para o pedido não estancar.",
		"Como: encha uma Célula de Pulso num Coração de tambor e assente-a onde o Códice mostra."
	]
	quest.4200000000228029.title: "O fosso marca o tempo"
	quest.420000000022802A.quest_desc: [
		"Onze Molduras de portão e a pedra-chave cingem o caminho. Uma moldura que falta é um passo que falta.",
		"Como: seis Pedras da Marca, dois lingotes de cobre e uma Lasca de eco. Faz quatro."
	]
	quest.420000000022802A.title: "Uma moldura para o caminho"
	quest.420000000022802B.quest_desc: [
		"A pedra-chave é a décima segunda pedra. Sem ela o anel é só um padrão.",
		"Como: quatro Molduras de portão, um Núcleo ressonante, uma Lasca espiritual e uma Célula de Pulso."
	]
	quest.420000000022802B.title: "A pedra-chave"
	quest.420000000022802C.quest_desc: [
		"Acenda um Portão do caminho. Onze molduras, uma pedra-chave e um lugar onde estar.",
		"Como: termine o anel e acenda-o; o progresso dispara quando o caminho se abre."
	]
	quest.420000000022802C.title: "Abra o caminho"
	quest.420000000022802D.quest_desc: [
		"Use agachado o selo numa pedra-chave para anotá-la. Use-o numa segunda pedra-chave para atar as duas.",
		"Como: um Selo em branco, Fio do tear e uma Lasca espiritual, sem forma."
	]
	quest.420000000022802D.title: "Escreva o destino"
	quest.420000000022802E.quest_desc: [
		"Viaje por um Portão longínquo de uma dimensão a outra. O Tear nunca foi um só fio.",
		"Como: una duas pedras-chave com um Selo de portão e depois caminhe o portão longínquo."
	]
	quest.420000000022802E.title: "O fio longo"
	quest.420000000022802F.quest_desc: [
		"O gerador do fogo. Assente-o perto do totem dele; um Coração de tambor na mão não sustenta esta voz.",
		"Como: três lingotes de cobre, um Nó de brasa, um Selo de fogo e duas Tábuas da Marca."
	]
	quest.420000000022802F.title: "A voz do fogo"
	quest.4200000000228030.quest_desc: [
		"O gerador do vento. Assente-o perto do totem dele para que os seis possam se ouvir.",
		"Como: quatro Tecidos espirituais, uma Asa de tempestade, um Selo de ar e duas Tábuas da Marca."
	]
	quest.4200000000228030.title: "A voz do vento"
	quest.4200000000228031.quest_desc: [
		"O gerador da água. Assente-o perto do totem dele; cisternas e nascentes escutam esta voz.",
		"Como: dois couros, três Tábuas da Marca, uma Raiz nodosa e um Selo de Água."
	]
	quest.4200000000228031.title: "A voz da água"
	quest.4200000000228032.quest_desc: [
		"O sino do despertar é o tom longo do espírito. Assente-o perto do totem dele, com os outros cinco.",
		"Como: um Fragmento de sino, quatro lingotes de cobre, um Selo de Espírito e uma Lasca espiritual."
	]
	quest.4200000000228032.title: "O despertar da terra"
	quest.4200000000228033.quest_desc: [
		"O sexto gerador. A voz do Tear precisa de Fio do tear; o Não Cantado e os Anciãos dos Costureiros do tear o guardam.",
		"Como: quatro Cristais da Marca, dois Fios do tear, dois Tecidos espirituais e um Núcleo ressonante."
	]
	quest.4200000000228033.title: "O sexto gerador"
	quest.4200000000228034.quest_desc: [
		"Um marco guarda Pulso no campo, para que seis vozes compartilhem uma reserva.",
		"Como: seis Pedras da Marca, dois Ecos ligados e uma Célula de Pulso."
	]
	quest.4200000000228034.title: "Um marco de Pulso"
	quest.4200000000228035.quest_desc: [
		"Mantenha os seis geradores produzindo a até 32 blocos uns dos outros, um por voz.",
		"Como: Trompa de brasa, Harpa de vento, Tambor de onda, Sino do despertar, Âncora do tear e Coração de tambor em 32. Progresso com seis vozes."
	]
	quest.4200000000228035.title: "Seis vozes cantando"
	quest.4200000000228036.quest_desc: [
		"A tábua pede a uma cisterna que continue dando. Dez minutos de água, e o selo fica.",
		"Como: use agachado a tábua num Braseiro ritual no Círculo de rito dele, com o selo e o Pulso correspondentes."
	]
	quest.4200000000228036.title: "Uma nascente que continua dando"
	quest.4200000000228037.quest_desc: [
		"O círculo de tambores de que o Não Cantado ainda se lembra. Lembrança opcional.",
		"Como: o Não Cantado no Tambor silencioso pode soltá-lo. Opcional."
	]
	quest.4200000000228037.title: "O círculo de tambores"
	quest.4200000000228038.quest_desc: [
		"Um selo em branco depois do primeiro rito, pronto para o círculo seguinte.",
		"Como: Primeiro rito no braseiro; marque quando um selo em branco sobressalente estiver na mão."
	]
	quest.4200000000228038.title: "Um selo sobressalente"
	quest.4200000000228039.quest_desc: [
		"A oficina do fogo. Um Totem de Fogo em oito e Pulso rodam toda receita de fornalha, grânulo mineral incluso. Um Coração de tambor na mão não mantém este forno.",
		"Como: fornalha + ressonadores + carrilhão. Totem de Fogo. Funde grânulo por Pulso — um Coração de tambor na mão não consegue fazê-lo rodar."
	]
	quest.4200000000228039.title: "Grânulo no forno"
	quest.420000000022803A.quest_desc: [
		"Teça um Selo de receita para uma oficina. Garrafas vazias voltam ao espaço que as segurava. A E/S lateral recusa espectadores e outros acampamentos. Desde a 5.0 ele quer um Totem de ressonância (Tear) atendido em oito blocos, ou fica parado e diz qual voz falta.",
		"Como: o Códice dos Espíritos nomeia a fabricação do Tear de selos. Assente as garrafas; elas voltam àquele espaço."
	]
	quest.420000000022803A.title: "Um tear para selos"
	quest.420000000022803B.quest_desc: [
		"Quatro lâmpadas de Pulso baratas (Junco luminoso, Lâmpada de lasca, Arandela de eco, Tigela de brasa) puxam 1–2 de Pulso por segundo da treliça. A redstone as escurece.",
		"Como: fabrique uma Lâmpada de lasca, coloque-a a oito blocos do Pulso e depois escureça-a com redstone se quiser noite."
	]
	quest.420000000022803B.title: "Uma lâmpada que bebe Pulso"
	quest.420000000022803C.quest_desc: [
		"Dez Amuletos de espírito se vestem em três espaços tribais, sem Curios. Céu com Ar é voo criativo. Use agachado um Totem de ressonância para vincular uma voz; o Coro vincula cada voz próxima num Braseiro.",
		"Como: fabrique o Amuleto do céu e use-o agachado num totem de Ar. Códice dos Espíritos: Amuletos de espírito."
	]
	quest.420000000022803C.title: "Um amuleto com voz"
	quest.420000000022803D.quest_desc: [
		"A oficina da água. Dê posto a ela nas estações de eco, do mesmo jeito que o equipamento espiritual; posto mais alto gasta mais Pulso ao acelerar. O posto sobrevive ao recolhê-la. Desde a 5.0 ela quer um Totem de ressonância de Água atendido em oito blocos, ou fica parada e diz qual voz falta.",
		"Como: páginas de oficina do Códice dos Espíritos. Coloque a Bomba de maré numa face da cisterna e, se ficar calada, use agachado o Códice."
	]
	quest.420000000022803D.title: "Uma bomba para a cisterna"
	quest.420000000022803E.quest_desc: [
		"Cada Pulso ainda vira 100 FE. A conversão sem posto é de 60 de Pulso por segundo. Suba o posto do adaptador na Sintonia de eco, depois no Vínculo de eco e depois no Manifesto de eco, e o status de mão vazia nomeia a taxa ao vivo. Ele ainda não pode receber FE.",
		"Como: use agachado um Energizador harmônico na Sintonia de eco, depois no Vínculo de eco e depois no Manifesto de eco. Marque quando o diagnóstico nomear uma taxa acima de 60."
	]
	quest.420000000022803E.title: "Posto da corrente"
	quest.420000000022803F.quest_desc: [
		"Use agachado qualquer peça de equipamento espiritual ou amuleto num Totem de ressonância colocado (40 de Pulso) para vincular essa voz. Conjuntos mistos são intencionais. O totem não é consumido. O Tear precisa de um totem de Tear.",
		"Como: use agachado uma ferramenta, uma peça de armadura ou um amuleto num totem com 40 de Pulso por perto. Marque quando a dica nomear a voz vinculada."
	]
	quest.420000000022803F.title: "Vincule uma voz"
	quest.4200000000228040.quest_desc: [
		"Uma lâmpada de junco. Luz de Pulso barata para uma trilha do acampamento. Opcional.",
		"Como: fabrique o Junco luminoso. Coloque-o perto do Pulso. Opcional."
	]
	quest.4200000000228040.title: "Luz de junco"
	quest.4200000000228041.quest_desc: [
		"Uma arandela de parede que bebe Pulso. Opcional.",
		"Como: fabrique a Arandela de eco e pendure-a. Opcional."
	]
	quest.4200000000228041.title: "Arandela de eco"
	quest.4200000000228042.quest_desc: [
		"Uma tigela de luz de fogueira do acampamento, no Pulso. Opcional.",
		"Como: fabrique a Tigela de brasa. Opcional."
	]
	quest.4200000000228042.title: "Tigela de brasa"
	quest.4200000000228043.quest_desc: [
		"Pendure um amuleto de vento no teto. Mobília do acampamento da Marca: banqueta, mesa, urna, esteira, prateleira e este. Opcional.",
		"Como: fabrique o Amuleto do vento e pendure-o. Lembrança opcional."
	]
	quest.4200000000228043.title: "Um amuleto ao vento"
	quest.4200000000228044.quest_desc: [
		"O Coro vincula cada voz de totem próxima num Braseiro ritual. Opcional quando Céu estiver na mão.",
		"Como: fabrique o Amuleto do coro e use-o agachado num Braseiro com vozes ao alcance. Opcional."
	]
	quest.4200000000228044.title: "Cada voz próxima"
	quest.4200000000228045.quest_desc: [
		"O machado gasta Pulso como a picareta. Dê posto a ele nas estações de eco; use agachado um totem para vincular uma voz. Opcional.",
		"Como: fabrique o Machado do equipamento espiritual. Opcional quando a picareta já existir."
	]
	quest.4200000000228045.title: "Gume para a madeira"
	quest.4200000000228046.quest_desc: [
		"Tijolos e uma tigela sobre três de cobre. Ponha-a sobre uma fogueira acesa, fogo, magma, lava ou uma Tigela de brasa; ela não pede Pulso nenhum. Até quatro ingredientes e uma tigela, em qualquer ordem, uns doze segundos por refeição. Os funis a alimentam por cima e pelos lados e retiram a refeição por baixo.",
		"Como: tijolos e uma tigela sobre três de cobre. Ponha-a sobre uma fogueira, fogo, magma, lava ou uma Tigela de brasa; sem Pulso."
	]
	quest.4200000000228046.title: "Uma panela para o acampamento"
	quest.4200000000228047.quest_desc: [
		"Um tubérculo vermelho e quente dos Ermos de brasa. O que você colhe é a semente; plante-o na terra arada como uma batata. A Enxada do equipamento espiritual colhe e replanta num só golpe.",
		"Como: cresce selvagem nos Ermos de brasa, através de um Tambor de portão. O que você colhe é a semente; plante-o na terra arada."
	]
	quest.4200000000228047.title: "Raiz de brasa"
	quest.4200000000228048.quest_desc: [
		"Cresce selvagem no Brejo de juncos. Colha um tufo e plante o que colheu; quatro estágios em solo arado, e as abelhas o polinizam.",
		"Como: cresce selvagem no Brejo de juncos, através de um Tambor de portão. Plante o que você colheu na terra arada."
	]
	quest.4200000000228048.title: "Arroz de brejo"
	quest.4200000000228049.quest_desc: [
		"Dos Campos de neve. Também conta como erva para a Chaleira espiritual.",
		"Como: cresce selvagem nos Campos de neve, através de um Tambor de portão. Plante o que você colheu na terra arada."
	]
	quest.4200000000228049.title: "Baga de geada"
	quest.420000000022804A.quest_desc: [
		"Da Crista do fulgor. Uma erva para a chaleira e também um cultivo.",
		"Como: cresce selvagem na Crista do fulgor, através de um Tambor de portão. Plante o que você colheu na terra arada."
	]
	quest.420000000022804A.title: "Feijão de fulgor"
	quest.420000000022804B.quest_desc: [
		"Da Estepe, e o grão em que se baseia a maioria dos pratos das tribos. Cultive um canteiro dele antes do resto.",
		"Como: cresce selvagem na Estepe, através de um Tambor de portão. Plante o que você colheu na terra arada."
	]
	quest.420000000022804B.title: "Grão da estepe"
	quest.420000000022804C.quest_desc: [
		"Dois Grãos de estepe e um Grânulo de ferro na Panela da lareira. Comer o prato de uma tribo carrega o dom dela por cinco minutos; o dos Cantores de cascalho tira mais do minério. Quando uma tribo chama você de Amigo, os Parentes dela vendem o prato por quatro do cultivo dela, e oferecer a uma tribo o próprio prato na lareira dela rende seis de estima.",
		"Como: dois Grãos de estepe e um Grânulo de ferro numa Panela da lareira sobre o calor. Os Parentes dos Cantores de cascalho o vendem em Amigo."
	]
	quest.420000000022804C.title: "O pão dos Cantores de cascalho"
	quest.420000000022804D.quest_desc: [
		"Duas de Caça crua e uma Raiz de brasa. A Caça crua cai dos animais de caça da Marca. O dom dos Anda-bordas: você nunca cai enquanto se agacha. Cada tribo tem um prato; JEI lista os nove sob a panela.",
		"Como: duas de Caça crua e uma Raiz de brasa numa Panela da lareira. A Caça crua cai dos animais de caça da Marca."
	]
	quest.420000000022804D.title: "O charque dos Anda-bordas"
	quest.420000000022804E.quest_desc: [
		"Purê de raiz do guardião, Pão assado no grânulo, uma Raiz de brasa e Grão de estepe na panela. Ponha o banquete num bloco sólido e ele guarda seis porções; cada uma enche você e concede a bênção de Terra por oito minutos — você cava mais rápido e fica firme. Cada voz tem um banquete dos próprios pratos.",
		"Como: Purê de raiz do guardião, Pão assado no grânulo, Raiz de brasa e Grão de estepe numa Panela da lareira. Coloque; seis porções."
	]
	quest.420000000022804E.title: "Uma mesa para o acampamento"
	quest.420000000022804F.quest_desc: [
		"Ossos e ferro ao redor de um caldeirão, um Carrilhão de osso embaixo. Ponha-o sobre o calor. Três assentos: um reagente cru da sua bolsa, uma erva da Marca e uma base — uma garrafa de vidro faz duas tinturas, um favo de mel dois unguentos, carvão quatro incensos. Uma fornada são dez segundos e 24 de Pulso da treliça. O totem mais próximo, em oito blocos, canta no caldo.",
		"Como: ossos e ferro ao redor de um caldeirão, um Carrilhão de osso embaixo. Ponha-o sobre o calor; um totem em 8 dá forma ao caldo."
	]
	quest.420000000022804F.title: "Uma chaleira sobre o fogo"
	quest.4200000000228050.quest_desc: [
		"A família do reagente escolhe o remédio: Acendalha é Força, Resfriamento é Resistência ao fogo, Antídoto tira o veneno, Remendo é Regeneração, e assim por diante. Uma tintura dura três minutos e devolve a garrafa para você. Cada remédio tira o Mal de espírito, o Silêncio não cantado, o Desfiamento e o Mal de ley.",
		"Como: Chaleira espiritual — um reagente cru, uma erva da Marca e uma garrafa de vidro. Dez segundos, 24 de Pulso, duas tinturas."
	]
	quest.4200000000228050.title: "Beba"
	quest.4200000000228051.quest_desc: [
		"O favo de mel como base. Use um unguento em você, ou num amigo, num aldeão ou no seu familiar: três corações de uma vez, todo efeito nocivo some, e o remédio por metade do tempo de uma tintura. Uma pilha destes é a diferença entre uma noite dura na Marca e voltar para casa a pé.",
		"Como: Chaleira espiritual — um reagente cru, uma erva da Marca e um favo de mel. Dois unguentos por leva."
	]
	quest.4200000000228051.title: "Passe"
	quest.4200000000228052.quest_desc: [
		"O carvão como base. Assente o incenso num Braseiro ritual — até dezesseis varetas, sem selo e sem Pulso — e a cada dois segundos todos em oito blocos recebem o remédio, e os familiares são remendados em um coração. Cada vareta queima trinta segundos. A redstone apaga; agache de mãos vazias para pegar de volta.",
		"Como: Chaleira espiritual — um reagente cru, uma erva da Marca e carvão. Quatro incensos por leva; queime-os num Braseiro ritual."
	]
	quest.4200000000228052.title: "Queime para todos"
	quest.4200000000228053.quest_desc: [
		"Dois Carrilhões de osso em volta de um Lingote manifestado sobre um graveto. Segure Usar e a cada meio segundo ele remenda quem você olha em seis blocos, ou você: três quartos de um coração por 2 de Pulso. Ganha grau nas estações de Eco como o resto do equipamento espiritual; a partir de Ligado, cada sacudida alivia o Mal de espírito em um nível.",
		"Como: dois Carrilhões de osso em volta de um Lingote manifestado sobre um graveto. Segure Usar para remendar quem você olha."
	]
	quest.4200000000228053.title: "Agite"
	quest.4200000000228054.quest_desc: [
		"Pedregulho sobre um bloco de magma faz quatro. Sobre o calor, soltam vapor. Durma a noite inteira numa cama, com pedras quentes a cinco blocos e um teto sobre você: você acorda totalmente curado, purificado, com dez minutos de Bênção espiritual, para a doença não pegar.",
		"Como: pedregulho sobre um bloco de magma faz quatro. Ponha-os sobre o calor, a cinco blocos de uma cama coberta."
	]
	quest.4200000000228054.title: "Uma noite na cabana"
	quest.4200000000228055.quest_desc: [
		"Duas pedras, uma Escama de Dorsomusgo e Junco espiritual ao redor de um Selo de espírito; o selo é devolvido. Lance-o num braseiro com um Selo de espírito assentado, dentro do Círculo de rito dele, por 500 de Pulso: todos em doze blocos recuperam dez corações, ficam purificados e abençoados, e o círculo fica aberto dez minutos. Ponha antes o Remanescente espiritual de um familiar caído num pedestal, e ele volta inteiro.",
		"Como: duas pedras, uma Escama de Dorsomusgo, Junco espiritual e um Selo de espírito, sem forma; o selo volta. Lance num braseiro selado, no Círculo de rito dele."
	]
	quest.4200000000228055.title: "Tábua de rito: Círculo de cura"
	quest.4200000000228056.quest_desc: [
		"Um Lingote manifestado, um Carrilhão de osso e um graveto na diagonal. Sete de dano, alcance mais um e meio, e um golpe em disparada acerta 35 por cento mais forte. Por baixo é uma Lâmina: ganha grau nas estações de Eco, gasta Pulso em golpes de eco e toma uma voz de totem. Mantém um Sabujo da fenda à distância de um braço.",
		"Como: Lingote manifestado, Carrilhão de osso e um graveto na diagonal. Ganha grau nas estações de Eco como a Lâmina."
	]
	quest.4200000000228056.title: "Primeiro o alcance"
	quest.4200000000228057.quest_desc: [
		"Quatro Lingotes manifestados em T sobre um Carrilhão de osso. Dez de dano, alcance mais meio, pesado — deixa seu passo mais lento enquanto está na mão — e a varredura mais larga e mais forte da família. A alabarda, o machado de batalha, o martelo de guerra, a adaga, a foice e o tridente são feitos do mesmo jeito; cada um troca alcance, velocidade e peso com os outros.",
		"Como: quatro Lingotes manifestados em T sobre um Carrilhão de osso. Pesado; a varredura mais larga."
	]
	quest.4200000000228057.title: "A varredura mais larga"
	quest.4200000000228058.quest_desc: [
		"Linha e Ressonadores de cobre ao redor de um Carrilhão de osso. Dispara raios sônicos com o Pulso das células que você carrega, e aceita flechas de verso. Rápido para soltar de novo, e um meio puxão quando você está com pressa.",
		"Como: linha e Ressonadores de cobre ao redor de um Carrilhão de osso. Dispara raios sônicos com o Pulso que você carrega."
	]
	quest.4200000000228058.title: "Um arco que canta"
	quest.4200000000228059.quest_desc: [
		"Lingotes manifestados de cada lado de um Arco de Pulso, um gancho de armadilha e gravetos embaixo. Segure Usar para carregar — 10 de Pulso adiantados, um pouco mais que uma puxada completa — depois use de novo para disparar. Acerta cerca de metade mais forte, voa quase reto e segura o tiro pelo tempo que você quiser.",
		"Como: Lingotes manifestados de cada lado de um Arco de Pulso, gancho de armadilha e gravetos embaixo. Segure Usar para carregar, use para disparar."
	]
	quest.4200000000228059.title: "A irmã mais pesada do arco"
	quest.420000000022805A.quest_desc: [
		"A Bancada do canto tem um assento de arma ao lado da saída. Erga um totem ao alcance com Pulso na treliça, mantenha a Bolsa de reagentes na barra rápida com quatro reagentes potencializados de um só tipo, sente uma arma de equipamento espiritual, escolha o reagente e pressione Unção: quatro reagentes e 32 de Pulso. Queima queima, Chamatormenta lança o raio em arco, Sede de sangue rouba vida, Remendo repara a arma — onze no total, uma de cada vez; outro reagente a substitui. Só o equipamento espiritual aceita o trabalho da bancada, a menos que um pack abra tribalpower:anointable. Marque isto quando uma arma carregar uma.",
		"Como: arma de equipamento espiritual no assento da Bancada do canto, quatro reagentes potencializados na bolsa, 32 de Pulso; pressione Unção. Marque quando estiver ungida."
	]
	quest.420000000022805A.title: "Um reagente na lâmina"
	quest.420000000022805B.quest_desc: [
		"Trepadeiras ao redor de Junco espiritual e uma pérola de ender fazem dois. Ponha um em cada andar da mesma coluna; eles se acham, sem ligação e sem energia. Pule para subir ao próximo elevador acima, agache para descer ao de baixo, até 48 blocos em cada sentido. Um elevador com teto em cima é pulado.",
		"Como: trepadeiras ao redor de Junco espiritual e uma pérola de ender fazem dois. Empilhe-os numa coluna; pule para subir, agache para descer."
	]
	quest.420000000022805B.title: "Coluna acima"
	quest.420000000022805C.quest_desc: [
		"Junco espiritual sob uma linha. Use numa criatura para levá-la e num bloco para deixá-la, a salvo e inteira. Nunca um jogador, um chefe ou uma elite da Marca. O tecido tem dois usos — uma viagem; as urnas de cobre, manifestadas e ressonantes levam mais, e a ressonante nunca se gasta. Ele não leva uma criatura quando só resta um uso.",
		"Como: Junco espiritual sob uma linha. Use numa criatura para levá-la, num bloco para deixá-la. Dois usos."
	]
	quest.420000000022805C.title: "Leve uma criatura para casa"
	quest.420000000022805D.quest_desc: [
		"Couro sobre tábuas em volta de um bloco musical. O Rito do portão como um jogo sem portal no fim: cada faixa que ele traz, tocada em A, S, D, F quando as batidas chegam à linha. Ele guarda sua melhor pontuação por faixa e um placar dos cinco melhores do servidor. Pratique aqui antes de um Tambor de portão de verdade.",
		"Como: couro sobre tábuas em volta de um bloco musical. Use-o para escolher uma faixa e tocar A, S, D, F."
	]
	quest.420000000022805D.title: "Tambor pelo gosto"
	quest.420000000022805E.quest_desc: [
		"Quatro pedras luminosas em volta de um Selo de Espírito, dois Lingotes manifestados, uma cenoura dourada e Tecido espiritual. Use-o para vesti-lo; o uso agachado abre os três espaços de amuleto. O amuleto de lanterna carrega a voz de Espírito: visão noturna, e qualquer bênção de voz em você dura metade a mais. Amuletos equipados custam 2 de Pulso por voz a cada dois segundos, de uma Célula de Pulso que você carregue.",
		"Como: quatro pedras luminosas em volta de um Selo de Espírito, dois Lingotes manifestados, uma cenoura dourada e Tecido espiritual. Use-o para vesti-lo; o uso agachado abre os espaços."
	]
	quest.420000000022805E.title: "Uma luz para vestir"
	quest.420000000022805F.quest_desc: [
		"Quando uma tribo chama você de Convidado, clique com o botão direito no Ancião dela e fale. Peça trabalho e eles entregam um pedido — três abertos por dia, um em mãos por tribo, cada um paga reputação e a cada terceiro uma Marca da tribo. Peça a história deles e um caminho de sete passos começa: Amigo, a coisa que eles prezam, caçar perto das fogueiras deles, um rito no acampamento deles, o prato deles cozido e para onde eles mandam você. O último passo é uma prova contra um guardião. Termine uma história e segure a relíquia dela.",
		"Como: clique com o botão direito no Ancião de uma tribo em Convidado ou melhor e peça a história deles; sete passos terminam num guardião. O progresso dispara na primeira relíquia."
	]
	quest.420000000022805F.title: "Uma história contada"
	quest.4200000000228060.quest_desc: [
		"A relíquia dos Guardiões da plataforma. A história deles termina no Espírito da debandada, no Anel pisoteado na Estepe; vença a prova e o Ancião a entrega a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua reputação: você nunca pisoteia um campo.",
		"Como: termine a história dos Guardiões da plataforma com o Ancião deles; a prova é o Espírito da debandada na Estepe."
	]
	quest.4200000000228060.title: "Brasa guardada"
	quest.4200000000228061.quest_desc: [
		"A relíquia dos Cantores de cascalho. A história deles termina na Serpente de prisma, na Fenda cantante dos Campos de cristal; vença a prova e o Ancião entrega a relíquia a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua estima: você tira mais do minério.",
		"Como: termine a história dos Cantores de cascalho com o Ancião deles; a prova é a Serpente de prisma nos Campos de cristal."
	]
	quest.4200000000228061.title: "Pedra ressonante"
	quest.4200000000228062.quest_desc: [
		"A relíquia dos Liga-raízes. A história deles termina na Matriarca do brejo, na Raiz afogada do Brejo de juncos; vença a prova e o Ancião entrega a relíquia a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua estima: as plantações se apressam ao seu redor.",
		"Como: termine a história dos Liga-raízes com o Ancião deles; a prova é a Matriarca do brejo no Brejo de juncos."
	]
	quest.4200000000228062.title: "Primeira raiz"
	quest.4200000000228063.quest_desc: [
		"A relíquia dos Anda-bordas. A história deles termina no Roc da tempestade, no Poleiro das Terras Altas; vença a prova e o Ancião entrega a relíquia a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua estima: você nunca cai enquanto se agacha.",
		"Como: termine a história dos Anda-bordas com o Ancião deles; a prova é o Roc da tempestade nas Terras Altas."
	]
	quest.4200000000228063.title: "Prego de ponte"
	quest.4200000000228064.quest_desc: [
		"A relíquia dos Corações de tambor. A história deles termina no Titã de escória, no Trono de escória dos Ermos de brasa; vença a prova e o Ancião entrega a relíquia a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua estima: você golpeia mais rápido.",
		"Como: termine a história dos Corações de tambor com o Ancião deles; a prova é o Titã de escória nos Ermos de brasa."
	]
	quest.4200000000228064.title: "Tambor firme"
	quest.4200000000228065.quest_desc: [
		"A relíquia dos Tecelões de padrões. A história deles termina no Tamborileiro da maré, na Pedra da maré, nos Baixios; vença a prova e o Ancião a entrega a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua estima: as estações de Eco perto de você trabalham em dobro.",
		"Como: termine a história dos Tecelões de padrões com o Ancião deles; a prova é o Tamborileiro da maré nos Baixios."
	]
	quest.4200000000228065.title: "Engrenagem silenciosa"
	quest.4200000000228066.quest_desc: [
		"A relíquia dos Guardiões da colônia. A história deles termina no Espectro do túmulo, no Anel do túmulo, nos Campos de neve; vença a prova e o Ancião a entrega a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua estima: você nunca é picado.",
		"Como: termine a história dos Guardiões da colônia com o Ancião deles; a prova é o Espectro do túmulo nos Campos de neve."
	]
	quest.4200000000228066.title: "Selo da colmeia"
	quest.4200000000228067.quest_desc: [
		"A relíquia dos Entalhadores de selos. A história deles termina no Sentinela da abóbada, no Portão selado, na Crista do fulgor; vença a prova e o Ancião a entrega a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua estima: seus amuletos pedem metade do Pulso.",
		"Como: termine a história dos Entalhadores de selos com o Ancião deles; a prova é o Sentinela da abóbada na Crista do fulgor."
	]
	quest.4200000000228067.title: "Selo cortês"
	quest.4200000000228068.quest_desc: [
		"A relíquia dos Costureiros do tear. A história deles termina no Não Cantado, no Tambor silencioso; vença a prova e o Ancião a entrega a você. Carregada em qualquer lugar do seu inventário, ela mantém o dom deles em você, seja qual for a sua estima: você canta mais barato.",
		"Como: termine a história dos Costureiros do tear com o Ancião deles; a prova é o Não Cantado no Tambor silencioso."
	]
	quest.4200000000228068.title: "Nono Fio"
	quest.4200000000228069.quest_desc: [
		"A história de cada tribo está terminada: oito guardiões enfrentados e o Não Cantado. Com as nove relíquias no inventário, o Nono Acordo está ao alcance. `/tribalpower standing` mostra a estima de cada tribo com você.",
		"Como: termine as nove histórias. O progresso dispara quando a nona relíquia está na mão."
	]
	quest.4200000000228069.title: "Nove relíquias"
	quest.420000000022806A.quest_desc: [
		"O Trono de escória nos Ermos de brasa: um anel de pedra com um Altar do guardião no centro, sobre ardósia profunda polida, entre quatro velas acesas, com o céu aberto acima. Use o altar agachado com a mão vazia e ele diz o que quer — oito Escamas de magma — depois coloque-as em cima e afaste-se. Agache para se firmar contra as pancadas; enfurecido, os anéis se acendem e Diabretes de brasa sobem da escória. Na metade da vida ele se enfurece e chama as criaturas do país dele, que não deixam nada. Deixe-o meio minuto e ele volta a dormir; o altar descansa vinte minutos entre os chamados. Ele larga o Núcleo de escória, e a queda dele encerra a história dos Corações de tambor.",
		"Como: use agachado, de mão vazia, o Altar do guardião do país, coloque oito do reagente que ele nomear e vença. O progresso dispara ao abater."
	]
	quest.420000000022806A.title: "Titã de escória aquietado"
	quest.420000000022806B.quest_desc: [
		"A Raiz afogada no Brejo de juncos: um anel de pedra com um Altar do guardião no centro, sobre ardósia profunda polida, entre quatro velas acesas, com o céu aberto acima. Use o altar agachado com a mão vazia e ele diz o que quer — oito Presas de junco — depois coloque-as em cima e afaste-se. O laço dela te arrasta para dentro e te deixa lento; fique em chão firme e derrube os Espreita-juncos que ela chama. Na metade da vida ela se enfurece e chama as criaturas do país dela, que não deixam nada. Deixe-a meio minuto e ela volta a dormir; o altar descansa vinte minutos entre os chamados. Ela larga o Coração do brejo, e a queda dela encerra a história dos Liga-raízes.",
		"Como: use agachado, de mão vazia, o Altar do guardião do país, coloque oito do reagente que ele nomear e vença. O progresso dispara ao abater."
	]
	quest.420000000022806B.title: "Matriarca do brejo aquietada"
	quest.420000000022806C.quest_desc: [
		"O Anel do túmulo nos Campos de neve: um anel de pedra com um Altar do guardião no centro, sobre ardósia profunda polida, entre quatro velas acesas, com o céu aberto acima. Use o altar agachado com a mão vazia e ele diz o que quer — oito Mandíbulas de geada — depois coloque-as em cima e afaste-se. O sopro dele congela tudo à frente. Circule por trás; os Rastejantes de geada que ele chama são lentos. Na metade da vida ele se enfurece e chama as criaturas do país dele, que não deixam nada. Deixe-o meio minuto e ele volta a dormir; o altar descansa vinte minutos entre os chamados. Ele larga a Pedra do túmulo, e a queda dele encerra a história dos Guardiões da colônia.",
		"Como: use agachado, de mão vazia, o Altar do guardião do país, coloque oito do reagente que ele nomear e vença. O progresso dispara ao abater."
	]
	quest.420000000022806C.title: "Espectro do túmulo aquietado"
	quest.420000000022806D.quest_desc: [
		"A Fenda cantante nos Campos de cristal: um anel de pedra com um Altar do guardião no centro, sobre ardósia profunda polida, entre quatro velas acesas, com o céu aberto acima. Use o altar agachado com a mão vazia e ele diz o que quer — oito Carapaças de prisma — depois coloque-as em cima e afaste-se. Ela dispara raios de luz que te marcam brilhando. Ande de lado, chegue perto e fique de olho no segundo raio que ela acrescenta ao se enfurecer. Na metade da vida ela se enfurece e chama as criaturas do país dela, que não deixam nada. Deixe-a meio minuto e ela volta a dormir; o altar descansa vinte minutos entre os chamados. Ela larga o Núcleo de prisma, e a queda dela encerra a história dos Cantores de cascalho.",
		"Como: use agachado, de mão vazia, o Altar do guardião do país, coloque oito do reagente que ele nomear e vença. O progresso dispara ao abater."
	]
	quest.420000000022806D.title: "Serpente de prisma aquietada"
	quest.420000000022806E.quest_desc: [
		"O Portão selado na Crista do fulgor: um anel de pedra com um Altar do guardião no centro, sobre ardósia profunda polida, entre quatro velas acesas, com o céu aberto acima. Use o altar agachado com a mão vazia e ele diz o que quer — oito Selos sentinela — depois coloque-os em cima e afaste-se. A armadura mais pesada da Marca e uma varredura que te joga para fora da crista. Enfurecido, ele se resguarda três segundos de cada vez: espere passar. Na metade da vida ele se enfurece e chama as criaturas do país dele, que não deixam nada. Deixe-o meio minuto e ele volta a dormir; o altar descansa vinte minutos entre os chamados. Ele larga o Selo da abóbada, e a queda dele encerra a história dos Entalhadores de selos.",
		"Como: use agachado, de mão vazia, o Altar do guardião do país, coloque oito do reagente que ele nomear e vença. O progresso dispara ao abater."
	]
	quest.420000000022806E.title: "Sentinela da abóbada aquietado"
	quest.420000000022806F.quest_desc: [
		"A Pedra da maré, nos Baixios: um anel de pedra com um Altar do guardião no centro, sobre ardósia profunda polida, entre quatro velas acesas, céu aberto acima. Use o altar agachado com a mão vazia e ele nomeia o que quer — oito Presas de salmoura — depois coloque-as em cima e afaste-se. Cada batida puxa todo mundo para ele e machuca. Lute contra ele da margem, de costas para algo sólido. Na metade da vida ele desperta e chama as criaturas do país dele, que não deixam nada. Deixe-o meio minuto e ele volta a dormir; o altar descansa vinte minutos entre os chamados. Ele larga a Concha da maré, e a queda dele encerra a história dos Tecelões de padrões.",
		"Como: use agachado, de mão vazia, o Altar do guardião do país, coloque oito do reagente que ele nomear e vença. O progresso dispara ao abater."
	]
	quest.420000000022806F.title: "Tamborileiro da maré aquietado"
	quest.4200000000228070.quest_desc: [
		"O Anel pisoteado na Estepe: um anel de pedra com um Altar do guardião no centro, sobre ardósia profunda polida, entre quatro velas acesas, céu aberto acima. Use o altar agachado com a mão vazia e ele nomeia o que quer — oito Tendões de jarrete — depois coloque-os em cima e afaste-se. Ele investe. Desvie para o lado e acerte quando ele passar; quando os Rangentes da toca aflorarem, fique sobre um bloco. Na metade da vida ele desperta e chama as criaturas do país dele, que não deixam nada. Deixe-o meio minuto e ele volta a dormir; o altar descansa vinte minutos entre os chamados. Ele larga o Chifre do rebanho, e a queda dele encerra a história dos Guardiões da plataforma.",
		"Como: use agachado, de mão vazia, o Altar do guardião do país, coloque oito do reagente que ele nomear e vença. O progresso dispara ao abater."
	]
	quest.4200000000228070.title: "Espírito da debandada aquietado"
	quest.4200000000228071.quest_desc: [
		"O Poleiro nas Terras Altas: um anel de pedra com um Altar do guardião no centro, sobre ardósia profunda polida, entre quatro velas acesas, céu aberto acima. Use o altar agachado com a mão vazia e ele nomeia o que quer — oito Asas de tempestade — depois coloque-as em cima e afaste-se. Ele mergulha e joga você no ar; desperto, um raio segue cada mergulho. Um arco e um teto ajudam mais que um escudo. Na metade da vida ele desperta e chama as criaturas do país dele, que não deixam nada. Deixe-o meio minuto e ele volta a dormir; o altar descansa vinte minutos entre os chamados. Ele larga a Pluma da tempestade, e a queda dele encerra a história dos Anda-bordas.",
		"Como: use agachado, de mão vazia, o Altar do guardião do país, coloque oito do reagente que ele nomear e vença. O progresso dispara ao abater."
	]
	quest.4200000000228071.title: "Roc da tempestade aquietado"
	quest.4200000000228072.quest_desc: [
		"Todos os oito núcleos de guardião e um Coração do Não Cantado, sem forma. Um núcleo com um Fio do tear faria, no lugar, seis Núcleos ressonantes; então leve um segundo conjunto do que eles largam, se quiser os dois. A barra de chefe de cada guardião usa a cor da tribo dele.",
		"Como: os oito núcleos de guardião e um Coração do Não Cantado, sem forma. Lance-a num círculo do Tear com as nove relíquias com você."
	]
	quest.4200000000228072.title: "A tabuleta dos nove"
	quest.4200000000228073.quest_desc: [
		"Trace um círculo do Tear — um Selo do tear assentado no braseiro, dentro do Círculo de rito dele — e lance a tabuleta com as nove relíquias com você; o rito puxa o Pulso dele antes de pegar. Nove luzes sobem, uma na cor de cada tribo. Daí em diante, cada tribo trata você no mínimo como Parente, os nove dons pousam em você por um tempo, e a aurora arde plena toda noite em que você fica sob ela. Uma vez por jogador; um segundo lançamento só acende o círculo.",
		"Como: Selo do tear num braseiro dentro do Círculo de rito dele, nove relíquias no inventário; use agachado a tabuleta no braseiro."
	]
	quest.4200000000228073.title: "O Tear concorda"
	quest.4200000000228074.quest_desc: [
		"Dezesseis fragmentos da história do Tear estão entalhados na Marca: oito Pedras entalhadas nas paredes das ruínas dela, oito Murais de dois por dois nos terrenos dos guardiões. Clique direito em um para lê-lo; o Códice dos Espíritos o guarda, e a seção da crônica o põe em ordem. Leia os dezesseis e a história fica inteira.",
		"Como: clique direito nas oito Pedras entalhadas nas ruínas da Marca e nos oito Murais nos terrenos dos guardiões."
	]
	quest.4200000000228074.title: "A crônica inteira"
	quest.4200000000228075.quest_desc: [
		"Encaixada nas paredes das ruínas da Marca — as obras velhas, o santuário afundado, os túmulos, as tumbas, as abóbadas. Leia onde a encontrar, depois pegue-a e ponha numa parede sua; o que você leu continua lido.",
		"Como: encaixada nas paredes das ruínas da Marca. Leia-a, depois quebre-a e ponha-a na sua própria parede."
	]
	quest.4200000000228075.title: "Uma pedra que lembra"
	quest.4200000000228076.quest_desc: [
		"Dois blocos de largura e dois de altura no terreno de cada guardião; cada um pinta o país em que está. Ler qualquer parte lê o todo. Colocado como uma peça só, desce como uma só; um mural cortado no criativo muda de capítulo com um clique agachado.",
		"Como: fica dois por dois no terreno de cada guardião. Leia-o, depois tire-o inteiro e coloque-o em casa."
	]
	quest.4200000000228076.title: "Uma parede que pinta seu país"
	quest.4200000000228077.quest_desc: [
		"A Marca age por conta própria. Queda de cinza, uma Tempestade de brilho, um Branco total e Névoa dos juncos fecham um país e levantam espíritos de dia; cada um alimenta os geradores de uma voz e atrapalha os de outra. De vez em quando os fios de ley de uma voz disparam: os coletores que os levam rendem o dobro, mas fique num cruzamento nu sem coletor e o Mal de ley balança o chão e escoa o seu Pulso. Cada tribo guarda um dia de festa, uma de cada vez — entre no banquete por um presente. Uma luz quente que deriva perto de você é um espírito errante; alcance-a por uma linha da história do país dele e um presente pequeno. Tempestades e surtos são avisados dois minutos antes, no chat e sobre a barra rápida. Marque isto quando você tiver aguentado um.",
		"Como: fique na Marca enquanto houver um tempo, um surto ou um dia de festa; marque quando tiver feito."
	]
	quest.4200000000228077.title: "A Marca respira"
	quest.420000000023058C.quest_desc: [
		"Os Cantores de cascalho nunca cortam uma pedra do mesmo jeito duas vezes. Esta mesa lembra cada corte.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: pedra + peças da mesa no JEI. Insira um bloco e escolha uma variante."
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"O mesmo truque para a madeira — cem tábuas a partir de uma.",
		"Como: mesa de carpinteiro do Chipped no JEI. A mesma ideia da mesa de pedreiro, para madeira."
	]
	quest.420000000023058D.title: "Mesa de carpinteiro"
	quest.420000000023058E.quest_desc: [
		"Areia em vidro, depois o vidro em cada forma que a luz aceitar.",
		"Como: bancada do Chipped no JEI (pedreiro, carpinteiro, soprador de vidro…). Ponha o bloco na mesa e escolha um corte."
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"Lã e pano, retecidos — cai bem, numa plataforma que está remendando um Tear.",
		"Como: bancada do Chipped no JEI (pedreiro, carpinteiro, soprador de vidro…). Ponha o bloco na mesa e escolha um corte."
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"Folhas, mudas e coisas que crescem, separadas nas suas variações.",
		"Como: bancada do Chipped no JEI (pedreiro, carpinteiro, soprador de vidro…). Ponha o bloco na mesa e escolha um corte."
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"Blocos coloridos e pedra mais estranha. Escolha uma variante; a bancada guarda o resto.",
		"Como: bancada do Chipped no JEI (pedreiro, carpinteiro, soprador de vidro…). Ponha o bloco na mesa e escolha um corte."
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"Metal e blocos com cara de máquina, cortados a gosto.",
		"Como: bancada do Chipped no JEI (pedreiro, carpinteiro, soprador de vidro…). Ponha o bloco na mesa e escolha um corte."
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"Alimente um bloco na Mesa de pedreiro e escolha no muro de variantes.",
		"Como: quatro pedras num quadrado, ou o cortador de pedras."
	]
	quest.4200000000230593.title: "Um corte de pedra"
	quest.4200000000230594.quest_desc: [
		"A Mesa de carpinteiro faz o mesmo pela madeira.",
		"Como: um tronco na grade de criação faz quatro."
	]
	quest.4200000000230594.title: "Um corte de tábuas"
	quest.4200000000230595.quest_desc: [
		"Cada vidraça que o Soprador de vidro conhece começa aqui.",
		"Como: funda areia. Martele pedregulho em cascalho, cascalho em areia, depois na fornalha."
	]
	quest.4200000000230595.title: "Um corte de vidro"
	quest.4200000000230596.quest_desc: [
		"A pedra favorita dos Cantores de cascalho para discutir.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000230596.title: "Variedade de ardósia profunda"
	quest.4200000000230597.quest_desc: [
		"Argila cozida, de cem jeitos.",
		"Como: quatro itens de tijolo. Bolas de argila fundem em tijolos."
	]
	quest.4200000000230597.title: "Variedade de tijolos"
	quest.4200000000230598.quest_desc: [
		"Cascalho da plataforma, cortado fino.",
		"Como: fabrique, funda, peneire ou pegue de um monstro. O JEI lista cada fonte na plataforma."
	]
	quest.4200000000230598.title: "Variedade de arenito"
	quest.4200000000240599.quest_desc: [
		"A primeira coisa que transforma uma plataforma num lugar onde alguém vive.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: tábuas de carvalho no JEI. Primeira peça do Handcrafted."
	]
	quest.4200000000240599.title: "Uma cadeira"
	quest.420000000024059A.quest_desc: [
		"Um lugar para pousar o Códice enquanto você pensa.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.420000000024059A.title: "Uma mesa"
	quest.420000000024059B.quest_desc: [
		"Lugar para um Clowder sentar enquanto o barril trabalha.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.420000000024059B.title: "Um banco"
	quest.420000000024059C.quest_desc: [
		"Para as Páginas do códice que você sempre fica de reler.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.420000000024059C.title: "Uma prateleira"
	quest.420000000024059D.quest_desc: [
		"Armazenamento Handcrafted que parece pertencer ao lugar.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.420000000024059D.title: "Um armário"
	quest.420000000024059E.quest_desc: [
		"Os Guardiões da plataforma dormiam bem. Você também deveria.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.420000000024059E.title: "Uma cama chique"
	quest.420000000024059F.quest_desc: [
		"Um lampião, uma página, um lugar para os dois.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.420000000024059F.title: "Um criado-mudo"
	quest.42000000002405A0.quest_desc: [
		"Corte uma moldura e depois vista-a com qualquer bloco. Uma forma, todas as peles.",
		"Como: uma barra de ferro sobre três cubos emoldurados. Corta blocos emoldurados."
	]
	quest.42000000002405A0.title: "Serra Emoldurada"
	quest.42000000002405A1.quest_desc: [
		"Um cubo em branco, à espera de um bloco de camuflagem.",
		"Como: Serra de molduras e depois cubo/laje/escadas emoldurados. A camuflagem é um clique direito com um bloco."
	]
	quest.42000000002405A1.title: "Cubo emoldurado"
	quest.42000000002405A2.quest_desc: [
		"Meio quadro; o dobro das opções.",
		"Como: Serra de molduras e depois cubo/laje/escadas emoldurados. A camuflagem é um clique direito com um bloco."
	]
	quest.42000000002405A2.title: "Laje emoldurada"
	quest.42000000002405A3.quest_desc: [
		"Degraus que vestem a parede em que se encostam, qualquer que seja.",
		"Como: Serra de molduras e depois cubo/laje/escadas emoldurados. A camuflagem é um clique direito com um bloco."
	]
	quest.42000000002405A3.title: "Escadas emolduradas"
	quest.42000000002405A4.quest_desc: [
		"Para telhados e linhas de telhado que o vazio nunca te deu.",
		"Como: Serra de molduras e depois cubo/laje/escadas emoldurados. A camuflagem é um clique direito com um bloco."
	]
	quest.42000000002405A4.title: "Rampa Emoldurada"
	quest.42000000002405A5.quest_desc: [
		"Os Anda-bordas transpuseram o vazio com menos. Chegue à próxima plataforma com estilo.",
		"Como: pontes Macaw a partir da pedra/madeira correspondente no JEI."
	]
	quest.42000000002405A5.title: "Ponte de corda"
	quest.42000000002405A6.quest_desc: [
		"Um telhado sobre a plataforma. A chuva aqui em cima nunca passa de ambição.",
		"Como: telhados Macaw a partir da madeira correspondente no JEI."
	]
	quest.42000000002405A6.title: "Telhado de sótão"
	quest.42000000002405A7.quest_desc: [
		"O conforto também é infraestrutura.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.42000000002405A7.title: "Sofá"
	quest.42000000002405A8.quest_desc: [
		"Uma borda de cozinha para a linha de Farmer's Delight.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.42000000002405A8.title: "Bancada"
	quest.42000000002405A9.quest_desc: [
		"Onde o Códice dos Bigodes ganha suas margens.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.42000000002405A9.title: "Escrivaninha"
	quest.42000000002405AA.quest_desc: [
		"Uma guarda pequena que combina com a mesa.",
		"Como: móveis Handcrafted de tábuas no JEI. A primeira cadeira é de carvalho."
	]
	quest.42000000002405AA.title: "Gaveta"
	quest.42000000002405AB.quest_desc: [
		"Uma soleira que se esconde na parede.",
		"Como: Serra de molduras e depois cubo/laje/escadas emoldurados. A camuflagem é um clique direito com um bloco."
	]
	quest.42000000002405AB.title: "Porta emoldurada"
	quest.42000000002405AC.quest_desc: [
		"Cobertura fina; disfarce completo.",
		"Como: Serra de molduras e depois cubo/laje/escadas emoldurados. A camuflagem é um clique direito com um bloco."
	]
	quest.42000000002405AC.title: "Painel emoldurado"
	quest.42000000002405AD.quest_desc: [
		"Um gradil de borda que você veste a gosto.",
		"Como: Serra de molduras e depois cubo/laje/escadas emoldurados. A camuflagem é um clique direito com um bloco."
	]
	quest.42000000002405AD.title: "Cerca emoldurada"
	quest.42000000002405AE.quest_desc: [
		"Cinza e honesta, como o cascalho de onde veio.",
		"Como: pontes Macaw a partir da pedra/madeira correspondente no JEI."
	]
	quest.42000000002405AE.title: "Ponte de andesito"
	quest.42000000002505AF.quest_desc: [
		"Uma luz de parede, não uma tocha fincada de vergonha. Os zeladores tinham critério.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: tocha + pepitas de ferro. Primeira fabricação das zeladorias."
	]
	quest.42000000002505AF.title: "Arandela"
	quest.42000000002505B0.quest_desc: [
		"Areia, a cair. O único relógio honesto antes da Trama de Relógio.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B0.title: "Ampulheta"
	quest.42000000002505B1.quest_desc: [
		"Pingue um fluido para fora de um bloco. Pequeno; estranhamente satisfatório.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B1.title: "Torneira"
	quest.42000000002505B2.quest_desc: [
		"Gire-a à mão. Os Corações de tambor também começaram em algum lugar.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B2.title: "Manivela"
	quest.42000000002505B3.quest_desc: [
		"Mostre uma coisa. Uma ficha, uma página, um troféu.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B3.title: "Prateleira"
	quest.42000000002505B4.quest_desc: [
		"Um saco que guarda sacos. A bagunça da Recuperação, arrumada.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B4.title: "Saco"
	quest.42000000002505B5.quest_desc: [
		"Tranque o Fio desfiado, longe das suas ideias piores.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B5.title: "Cofre"
	quest.42000000002505B6.quest_desc: [
		"Prenda uma página onde o Clowder inteiro a leia.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B6.title: "Quadro de Avisos"
	quest.42000000002505B7.quest_desc: [
		"Um vaso com ambições. Cultive um pouco onde a plataforma é fina.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B7.title: "Jardineira"
	quest.42000000002505B8.quest_desc: [
		"Erga o Fragmento do tear de Fuso onde ele possa ser admirado.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B8.title: "Pedestal"
	quest.42000000002505B9.quest_desc: [
		"Guarde biscoitos, abelhas ou a pequena dignidade da ordem.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505B9.title: "Pote (37)"
	quest.42000000002505BA.quest_desc: [
		"Defina o surgimento sem carregar uma cama inteira escada acima.",
		"Como: lã no JEI. Saco de dormir branco; existem variantes tingidas. Define o surgimento sem uma cama inteira."
	]
	quest.42000000002505BA.title: "Saco de dormir"
	quest.42000000002505BB.quest_desc: [
		"Durma o dia, para que as criaturas encontrem um Skybound descansado.",
		"Como: lã + linha no JEI. Pendure-a na Corda e no Prego."
	]
	quest.42000000002505BB.title: "Rede"
	quest.42000000002505BC.quest_desc: [
		"Pendure a rede entre dois postes, sobre o precipício, e encare.",
		"Como: linha e um lingote de ferro. Coloque dois e depois pendure a rede."
	]
	quest.42000000002505BC.title: "Corda e prego"
	quest.42000000002505BD.quest_desc: [
		"Uma chama mais firme para as noites longas da plataforma.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505BD.title: "Suporte de Vela"
	quest.42000000002505BE.quest_desc: [
		"Escale, pendure-se ou faça uma ponte. Os Anda-bordas juravam por ela.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505BE.title: "Corda (37)"
	quest.42000000002505BF.quest_desc: [
		"Suba e desça a corda ao bel-prazer da redstone.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505BF.title: "Bloco de polia"
	quest.42000000002505C0.quest_desc: [
		"Caia em cima, e o vazio esquece de punir você.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505C0.title: "Bloco de Penas"
	quest.42000000002505C1.quest_desc: [
		"Risque com giz um plano com que o Clowder inteiro possa discutir.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505C1.title: "Quadro Negro"
	quest.42000000002505C2.quest_desc: [
		"Carregue uma coisinha que preferia que você não fizesse isso.",
		"Como: fabricação de Supplementaries no JEI (arandela, saco, cofre, corda…). As zeladorias nomeiam a estação."
	]
	quest.42000000002505C2.title: "Gaiola"
	quest.42000000002605C3.quest_desc: [
		"O primeiro fio. O pulso que os Corações de tambor guardavam agora tem para onde ir.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: lamine chapas de cobre num laminador. O capítulo atual começa aqui."
	]
	quest.42000000002605C3.title: "Fio de cobre"
	quest.42000000002605C4.quest_desc: [
		"Rotação de um lado, Energia de Forge do outro. Duas Tramas apertam as mãos.",
		"Como: Create Crafts & Additions — fio de cobre do laminador, depois conectores e motor."
	]
	quest.42000000002605C4.title: "Conector"
	quest.42000000002605C5.quest_desc: [
		"A energia volta a ser rotação. A Trama de Relógio agora gira na Trama de Centelha.",
		"Como: Create Crafts & Additions — fio de cobre do laminador, depois conectores e motor."
	]
	quest.42000000002605C5.title: "Motor elétrico"
	quest.42000000002605C6.quest_desc: [
		"Guarde uma carga entre o fio e o trabalho.",
		"Como: Create Crafts & Additions — fio de cobre do laminador, depois conectores e motor."
	]
	quest.42000000002605C6.title: "Capacitor"
	quest.42000000002605C7.quest_desc: [
		"Uma parede de corrente armazenada, tão grande quanto a plataforma permitir.",
		"Como: Create Crafts & Additions — fio de cobre do laminador, depois conectores e motor."
	]
	quest.42000000002605C7.title: "Acumulador modular"
	quest.42000000002605C8.quest_desc: [
		"Varetas e fio a partir de lingotes — a resposta do Create à prensa.",
		"Como: Create Crafts & Additions — fio de cobre do laminador, depois conectores e motor."
	]
	quest.42000000002605C8.title: "Laminadora"
	quest.42000000002605C9.quest_desc: [
		"Encante sem a superstição da mesa. Alimente com experiência e receba intenção.",
		"Como: Create Enchantment Industry depois de um queimador de blaze. O JEI nomeia a impressora e o balde de experiência."
	]
	quest.42000000002605C9.title: "Encantador Blaze"
	quest.42000000002605CA.quest_desc: [
		"Prática líquida, carregada. Os zeladores teriam achado isto vulgar e útil.",
		"Como: Create Enchantment Industry depois de um queimador de blaze. O JEI nomeia a impressora e o balde de experiência."
	]
	quest.42000000002605CA.title: "Balde de experiência"
	quest.42000000002605CB.quest_desc: [
		"Copie um livro, uma planta, uma página. O Códice dos Bigodes aprova, em silêncio.",
		"Como: Create Enchantment Industry depois de um queimador de blaze. O JEI nomeia a impressora e o balde de experiência."
	]
	quest.42000000002605CB.title: "Impressora"
	quest.42000000002605CC.quest_desc: [
		"Lava e calor em energia. Uma ponte, não o Zumbido em si.",
		"Como: ósmio + fornalha + cobre. O primeiro gerador Mekanism."
	]
	quest.42000000002605CC.title: "Gerador a Calor"
	quest.42000000002605CD.quest_desc: [
		"Numa plataforma que é só céu, o sol é o único recurso que ninguém raciona.",
		"Como: geradores Mekanism, depois da linha Oficinas Mekanism. O gerador de calor é a primeira receita."
	]
	quest.42000000002605CD.title: "Gerador a Energia Solar"
	quest.42000000002605CE.quest_desc: [
		"Quanto mais alta a plataforma, mais forte ele gira. Construa alto.",
		"Como: geradores Mekanism, depois da linha Oficinas Mekanism. O gerador de calor é a primeira receita."
	]
	quest.42000000002605CE.title: "Gerador Eólico"
	quest.42000000002605CF.quest_desc: [
		"Queime o excedente da Trama de Broto. Numa plataforma, nada é desperdício.",
		"Como: geradores Mekanism, depois da linha Oficinas Mekanism. O gerador de calor é a primeira receita."
	]
	quest.42000000002605CF.title: "Biogerador"
	quest.42000000002605D0.quest_desc: [
		"Energia tardia para um Clowder que foi fundo no Mekanism.",
		"Como: geradores Mekanism, depois da linha Oficinas Mekanism. O gerador de calor é a primeira receita."
	]
	quest.42000000002605D0.title: "Gerador a Queima de Gás"
	quest.42000000002605D1.quest_desc: [
		"O tear digital, no bolso. Reteça de qualquer lugar da plataforma.",
		"Como: Terminal sem fio depois de uma rede AE2 e um kit sem fio carregado. O JEI nomeia a receita."
	]
	quest.42000000002605D1.title: "Terminal sem fio (38)"
	quest.42000000002605D2.quest_desc: [
		"Os químicos do Mekanism, guardados na rede AE2. Dois pilares tardios, trançados.",
		"Como: células químicas do Applied Mekanistics depois do invólucro de AE2 + químicos do Mekanism."
	]
	quest.42000000002605D2.title: "Célula química"
	quest.42000000002605D3.quest_desc: [
		"Para quando o fio de cobre não consegue levar o pulso todo.",
		"Como: Create Crafts & Additions — fio de cobre do laminador, depois conectores e motor."
	]
	quest.42000000002605D3.title: "Conector grande"
	quest.42000000002605D4.quest_desc: [
		"Um bolo que sobe o seu nível. Não conte à linha da cozinha.",
		"Como: Create Enchantment Industry depois de um queimador de blaze. O JEI nomeia a impressora e o balde de experiência."
	]
	quest.42000000002605D4.title: "Bolo de experiência"
	quest.42000000002605D5.quest_desc: [
		"Uma mordida maior do mesmo céu de graça.",
		"Como: geradores Mekanism, depois da linha Oficinas Mekanism. O gerador de calor é a primeira receita."
	]
	quest.42000000002605D5.title: "Solar avançado"
	quest.42000000002605D6.quest_desc: [
		"A casca de que toda célula química precisa.",
		"Como: células químicas do Applied Mekanistics depois do invólucro de AE2 + químicos do Mekanism."
	]
	quest.42000000002605D6.title: "Invólucro químico"
	quest.42000000002605D7.quest_desc: [
		"Leve uma medida de gás para fora da rede.",
		"Como: células químicas do Applied Mekanistics depois do invólucro de AE2 + químicos do Mekanism."
	]
	quest.42000000002605D7.title: "Célula química portátil"
	quest.42000000002705D8.quest_desc: [
		"Cada Trama tem um guardião que o Corte partiu: um construto do Tear que ficou selvagem. Você não assassina um monstro; devolve a tensão à Trama ao vencê-lo. Fabrique o Totem desfiado dele quando a Trama estiver assentada, use-o em qualquer lugar fora de uma arena, e você e cada companheiro de Clowder num raio de 32 blocos são puxados para o palco dele. Se vencer, cada um de vocês leva para casa a Relíquia tecida desse guardião. Se perder, vocês são cuspidos de volta com o totem gasto.",
		"As relíquias funcionam a partir do espaço de relíquia do Curios, da mão secundária ou da barra rápida: um passivo enquanto equipadas e um poder de clique direito com recarga. `/guardians leave` abandona uma luta; `/guardians status` mostra o registro do Clowder.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: marque. Fabrique cada Totem desfiado depois que essa Trama estiver assentada; use-o fora de uma arena."
	]
	quest.42000000002705D8.title: "Resposta pelo Corte"
	quest.42000000002705D9.quest_desc: [
		"A Tigela da toca: uma tigela afundada de quatro degraus de terra que descem até um poço de lama, sob seis arcos de raízes de carvalho escuro, com sete costuras de raiz azul-esverdeadas brilhando no chão do poço.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705D9.title: "Totem: O Leito"
	quest.42000000002705DA.quest_desc: [
		"A cada quarto da vida dele, O Leito golpeia e alaga o fosso com uma camada de terra, imune lá dentro. Uma das sete costuras acende: cave um canal até ela, exponha o núcleo e acerte nele para quebrar o soterramento. O primeiro portão, e um clemente.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705DA.title: "Devolver a tensão: O Leito"
	quest.42000000002705DB.quest_desc: [
		"Coração-raiz: o recuo recebido cai sessenta por cento e nada pode te puxar. Raiz no chão te planta por cinco segundos, atrás de oito corações de Absorção.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705DB.title: "Relíquia: Coração-raiz"
	quest.42000000002705DC.quest_desc: [
		"O Fosso de moagem: uma pedreira de ardósia profunda com um anel de mó giratório no chão e quatro calhas de peneira de pedra despejando cascalho no fosso central de cascalho.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705DC.title: "Totem: A Mandíbula"
	quest.42000000002705DD.quest_desc: [
		"A Mandíbula fica imune enquanto a goela está fechada. Cada calha solta um bloco de cascalho a cada quinze segundos; carregue um até o anel e deixe que ele siga até a boca do fosso para travar a goela aberta por doze segundos. O anel inverte a cada fase e empurra o descuidado para o fosso.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705DD.title: "Devolver a tensão: A Mandíbula"
	quest.42000000002705DE.quest_desc: [
		"Núcleo de moagem: imune a Fadiga de mineração, e suas peneiras de mão ganham uma rolagem extra de Fortuna. Retalha tira dois de armadura da próxima coisa que você acertar.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705DE.title: "Relíquia: Núcleo de moagem"
	quest.42000000002705DF.quest_desc: [
		"O Terraço do sobrecrescimento: quatro terraços de jardim sob um dossel de folhas, oito postes de treliça e quatro estações de poda no segundo nível.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705DF.title: "Totem: A Mãe-espinho"
	quest.42000000002705E0.quest_desc: [
		"A Mãe-espinho nunca golpeia; ela semeia uma sebe de espinhos que se espalha e queima ao toque, e se cura sempre que uma estação de poda fica tomada. Tesoura e machados limpam isso. Composte oito de sebe numa estação para disparar uma onda de poda que limpa o chão e a atordoa — a única janela limpa de dano.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705E0.title: "Devolver a tensão: A Mãe-espinho"
	quest.42000000002705E1.quest_desc: [
		"Semente de espinho: Espinhos, e nenhum dano de frutinhas nem de cacto. Florescência ergue um anel de sebe e dá Regeneração II a você e ao seu Clowder dentro dele.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705E1.title: "Relíquia: Semente de espinho"
	quest.42000000002705E2.quest_desc: [
		"Os Fragmentos do céu: dez fragmentos de ardósia profunda flutuando sobre o vazio, pontes que desmoronam entre eles, marcas de garra douradas no fragmento principal, onde o chefe aterrissa.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705E2.title: "Totem: O Anda-borda"
	quest.42000000002705E3.quest_desc: [
		"Um duelo puro. O Anda-borda salta de fragmento em fragmento e se lança sobre quem estiver mais longe de uma parede; uma marca de garra dourada mostra onde, um suspiro antes de ele aterrissar — saia dali. As pontes desmoronam atrás de você e voltam depois. Cair custa seis corações e uma volta à sua plataforma.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705E3.title: "Devolver a tensão: O Anda-borda"
	quest.42000000002705E4.quest_desc: [
		"Passo-borda: sem dano de queda em quedas de menos de doze blocos e sem escorregar das bordas. Passo-borda avança seis blocos, duas vezes, com um golpe mais forte no fim.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705E4.title: "Relíquia: Passo-borda"
	quest.42000000002705E5.quest_desc: [
		"O Tambor de forja: um estrado-tambor de latão sobre uma cratera de lava, oito martelos de pistão de cobre com almofadas de batida à frente, quatro canais de lava pelo chão.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705E5.title: "Totem: O Coração de tambor"
	quest.42000000002705E6.quest_desc: [
		"O Coração de tambor só pode ser ferido por um instante depois de cada quarto pulso. Fique numa placa de pulso no tempo forte para carregar uma centelha que conta como três; no quarto pulso os canais de lava sobem, então fique nas placas, não nos canais. O andamento sobe a cada fase.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705E6.title: "Devolver a tensão: O Coração de tambor"
	quest.42000000002705E7.quest_desc: [
		"Pulso de tambor: cada quarto golpe acerta dois corações a mais. O tempo forte atordoa e empurra tudo num raio de sete blocos.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705E7.title: "Relíquia: Pulso de tambor"
	quest.42000000002705E8.quest_desc: [
		"O Escape: quatro anéis de cobre giratórios com ladrilhos de sequência de carvalho escuro ao redor de um cubo de ferro, seis torres de engrenagem e um pêndulo de dezesseis blocos marcando o tempo.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705E8.title: "Totem: O Engrenageiro"
	quest.42000000002705E9.quest_desc: [
		"A cada fase O Engrenageiro dá corda: as placas acendem em sequência nos anéis que giram e você tem doze segundos para pisá-las na ordem. O acerto abre o chassi por oito segundos; a falha dispara cada torre de engrenagem. O pêndulo é o metrônomo; os anéis invertem quando ele balança longe.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705E9.title: "Devolver a tensão: O Engrenageiro"
	quest.42000000002705EA.quest_desc: [
		"Laço de engrenagem: Pressa I, e as ferramentas gastam um quinto mais devagar. Rebobinar zera as outras relíquias que você carrega e te puxa de volta para onde você estava há três segundos.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705EA.title: "Relíquia: Laço de engrenagem"
	quest.42000000002705EB.quest_desc: [
		"O Favo: uma arena hexagonal de cera, com células de favo que sobem e descem, poças de mel e seis células de zangão na parede.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705EB.title: "Totem: A Mente-colmeia"
	quest.42000000002705EC.quest_desc: [
		"A Mente-colmeia é frágil, mas a cada onda suas seis células despejam zangões. Uma fogueira colocada numa célula de zangão a sela por trinta segundos; sele as seis e a câmara real se abre por dez segundos. Suas próprias Productive Bees atacam os zangões assim que os veem.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705EC.title: "Voltar a tensionar: A Mente-colmeia"
	quest.42000000002705ED.quest_desc: [
		"Chamado da colmeia: as abelhas nunca se voltam contra você, e as colmeias num raio de dezesseis blocos trabalham um décimo mais rápido. Chame o Enxame: manda quatro abelhas de relíquia atrás do que você acertar.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705ED.title: "Relíquia: Chamado da colmeia"
	quest.42000000002705EE.quest_desc: [
		"O Círculo de guarda: um santuário de pedra com círculos de ouro e nove pilares de glifos com agulhas de ametista, um estrado de nove lados com pinos de ouro no centro.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705EE.title: "Totem: O Quebra-selos"
	quest.42000000002705EF.quest_desc: [
		"O Quebra-selos se esconde atrás de três guardas ativas. Os pinos do estrado acendem a ordem uma vez por fase — olhe primeiro. Disperse os pilares nessa ordem com uma dissipação de Ars ou qualquer item da Trama Selo; um errado rearma os três e o vidro da guarda morde. Três certos, e ele fica aberto por doze segundos. As fases seguintes embaralham as runas e acrescentam um chamariz.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705EF.title: "Voltar a tensionar: O Quebra-selos"
	quest.42000000002705F0.quest_desc: [
		"Marca de selo: o dano mágico recebido cai um quinto. Marca de selo protege você, ou um companheiro de Clowder que você olha, contra um golpe pesado.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705F0.title: "Relíquia: Marca de selo"
	quest.42000000002705F1.quest_desc: [
		"O Tear que desaba: um tear com sessenta e seis blocos de largura cujo chão é a urdidura — faixas de tábuas que se desfazem em pontes de fio quando as barras de liços caem.",
		"Quatro Fio desfiado e quatro do bloco da Trama ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705F1.title: "Totem: O Desteido"
	quest.42000000002705F2.quest_desc: [
		"Cinco fases. Cada uma cita duas das outras oito mecânicas por trinta segundos; depois uma barra de liços cai e mais três faixas se desfazem. Na forma verdadeira restam as últimas quatro faixas, e os fios da urdidura são o único caminho até a viga onde ele está. Mate-o ali: o Retecer.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705F2.title: "Voltar a tensionar: O Desteido"
	quest.42000000002705F3.quest_desc: [
		"Fio do tear: mais duas de tensão do Tear para o seu Clowder e um desgaste mais lento. O Fio do tear prende o seu Clowder ao seu lado. É a pedra-chave do verdadeiro Retecer e a chave das duas arenas seladas.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705F3.title: "Relíquia: Fio do tear"
	quest.42000000002705F4.quest_desc: [
		"A Lixeira do Cais: um canto do próprio Cais — um pátio de tábuas, um varal de lençóis de pano, cestos de lã, um tapete vermelho.",
		"Quatro Fios desfiados e quatro lãs ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705F4.title: "Totem: O golem de fiapo"
	quest.42000000002705F5.quest_desc: [
		"A única luta sem risco. O golem joga bolas de fiapo que só cegam por um instante e se esconde atrás da roupa lavada; bata no tapete e ele espirra e cambaleia. Ensina o totem, a arena e o portão.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705F5.title: "Voltar a tensionar: O golem de fiapo"
	quest.42000000002705F6.quest_desc: [
		"Sopro de fiapo: imune a dano de cacto, frutas vermelhas e sebe, e a ser empurrado. Sopro cega as criaturas próximas para você escapar.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705F6.title: "Relíquia: Sopro de fiapo"
	quest.42000000002705F7.quest_desc: [
		"O Jardim de nós: uma ilha de grama sob quatro anéis de labirinto de cerca viva, com vãos e esporões, caminhos de pedregulho e anéis de nó de corda pendurados por cima.",
		"Quatro de Fio desfiado e quatro folhas ao redor de uma Meada do vazio.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705F7.title: "Totem: O Emaranhado"
	quest.42000000002705F8.quest_desc: [
		"A aranha fecha os caminhos atrás de você com nós de corda que levam três golpes para cortar, e morde quem estiver sozinho num beco sem saída. Fique junto no labirinto. Opcional, no meio do jogo, um prêmio cosmético.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705F8.title: "Voltar a tensionar: O Emaranhado"
	quest.42000000002705F9.quest_desc: [
		"Amuleto de nó: sem lentidão em teia, areia das almas, mel ou neve fofa, e metade do escorregão no gelo. Emaranhado enraíza a primeira criatura que acerta.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705F9.title: "Relíquia: Amuleto de nó"
	quest.42000000002705FA.quest_desc: [
		"As duas arenas loucas esperam atrás de uma porta que só o Retecer abre. Os totens delas precisam da relíquia Fio do tear na grade de fabricação e só respondem a um Clowder que fechou o próprio céu. Os chefes são de dez a vinte vezes o seu tamanho. Traga todo mundo.",
		"Como: assente as nove Tramas e depois reteça. O progresso dispara quando o céu se fecha."
	]
	quest.42000000002705FA.title: "A porta selada"
	quest.42000000002705FB.quest_desc: [
		"A Cisão: um grande fragmento de obsidiana cruzado pelo Corte brilhante, vinte fragmentos do mundo à deriva ao redor, lágrimas do vazio azul-esverdeadas no ar.",
		"Fio desfiado e obsidiana ao redor da relíquia Fio do tear; a relíquia é devolvida.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705FB.title: "Totem: O Primeiro corte"
	quest.42000000002705FC.quest_desc: [
		"Uma forma que o Corte deixou no fragmento, não uma confissão de quem brandiu. A cada vinte segundos ela corta uma linha pelo fragmento e os blocos caem por quinze segundos; a costura dá Velocidade, mas o feixe segue a costura. Fragmentos à deriva esmagam, lágrimas do vazio puxam, e a um quinto da vida o fragmento se parte em dois ao longo do Corte. Só depois do Retecer.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705FC.title: "Devolver a tensão: O Primeiro corte"
	quest.42000000002705FD.quest_desc: [
		"Fragmento do Primeiro corte: corta as fases de proteção. O melhor do pacote, reservado a quem passou.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705FD.title: "Relíquia: Fragmento do Primeiro corte"
	quest.42000000002705FE.quest_desc: [
		"O Tear acima: um tecido de púrpura, nove pontes de Trama até nove plataformas com pilares, vinte e sete fios de catedral até uma pedra-chave a sessenta e quatro blocos de altura.",
		"Fio desfiado e púrpura ao redor da relíquia Fio do tear; a relíquia volta para você.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.42000000002705FE.title: "Totem: O Sobretecelão"
	quest.42000000002705FF.quest_desc: [
		"Seu próprio Tear restaurado se voltou contra você. O Sobretecelão lança sombras dos nove guardiões sobre as Tramas deles; mate uma sombra e o fio dela fica teso por vinte e cinco segundos, e só então o próprio Tear pode ser ferido. Depois ele lança três e, então, os nove.",
		"Como: use o Totem desfiado correspondente e depois vença a arena. O progresso completa isto."
	]
	quest.42000000002705FF.title: "Devolver a tensão: O Sobretecelão"
	quest.4200000000270600.quest_desc: [
		"Lançadeira do Sobretecelão: um eco de cada relíquia de Trama numa só, e ela retece um companheiro de Clowder caído.",
		"Um por membro de Clowder presente na vitória, direto para o inventário.",
		"Como: Códice dos Bigodes, Guardiões partidos — totem, arena, relíquia. O totem responde na plataforma."
	]
	quest.4200000000270600.title: "Relíquia: Lançadeira do Sobretecelão"
	quest.42000000002805E3.quest_desc: [
		"Corredores de plataforma selvagens não surgem numa plataforma do vazio. Toque o Rito do portão num Tambor de portão (use-o de mãos vazias, acerte as batidas em A, S, D, F) e ande pela Marca. Os amarelos pastam na Estepe e no Brejo de juncos. As Terras Altas pendem para o grau Ótimo. Os Campos de neve escondem graus Maravilhosos. Os Ermos de brasa guardam aves Chama.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: use o Tambor de portão de mãos vazias e toque o Rito do portão: acerte as batidas que caem em A, S, D, F. Acerte 60% e ele abre; não precisa de Pulso. Vincule primeiro uma bússola de retorno."
	]
	quest.42000000002805E3.title: "Portão para a Marca"
	quest.42000000002805E4.quest_desc: [
		"Gysahl selvagem cresce no Brejo de juncos, na Estepe e nas Terras Altas, mais denso no Brejo. Colher também solta sementes, e Folha da Marca ou grama quebradas com uma enxada soltam mais. Plante as sementes em terra arada em casa.",
		"Como: colha Gysahl selvagem na Marca (o Brejo de juncos é o mais denso). Colher também solta sementes; plante-as em terra arada em casa."
	]
	quest.42000000002805E4.title: "Gysahl Green"
	quest.42000000002805E5.quest_desc: [
		"Um livro e uma folha de Gysahl. Use-o em qualquer lugar: as páginas listam a cor, o grau, a classe, as vitórias em corrida e a última noz de cada uma das suas aves.",
		"Como: um livro e um Gysahl. Use-o em qualquer lugar; as páginas listam as suas aves."
	]
	quest.42000000002805E5.title: "Chocobo Almanac"
	quest.42000000002805E6.quest_desc: [
		"Dê Gysahl para domar um amarelo selvagem. Faça uma sela de couro, linha e ferro, depois monte. O sprint dá uma investida; solte para recuperar o fôlego.",
		"Como: couro, linha e ferro. Dome um amarelo selvagem com Gysahl e depois sele-o."
	]
	quest.42000000002805E6.title: "Chocobo Saddle"
	quest.42000000002805E7.quest_desc: [
		"Pepitas de ouro em volta de um relógio, com um Gysahl. Ao dar corda, ele te leva ao Vento dos Bigodes e de volta. Depois que você tiver andado pela Marca, Esther também fica no Salão Clowder: monte uma ave selada até ela, ou pergunte ao Guia do Vento dos Bigodes.",
		"Como: pepitas de ouro em volta de um relógio, com um Gysahl. Use-o para dar corda até o Vento dos Bigodes e de volta; uma ave selada vai com você."
	]
	quest.42000000002805E7.title: "Chocobo Pocketwatch"
	quest.42000000002805E8.quest_desc: [
		"Uma isca na mão atrai aves selvagens e desenha o contorno delas por um campo.",
		"Como: faça a isca. Segure-a para achar os amarelos da Marca."
	]
	quest.42000000002805E8.title: "Chocobo Lure"
	quest.42000000002805E9.quest_desc: [
		"Plante sementes de Gysahl em terra arada. Um canteiro em casa é como a linha da fazenda começa.",
		"Como: colher Gysahl selvagem solta sementes, e o mesmo fazem grama e Folha da Marca quebradas com uma enxada. Plante em terra arada."
	]
	quest.42000000002805E9.title: "Gysahl Seeds"
	quest.42000000002805EA.quest_desc: [
		"Alimente dois adultos de sexos opostos com uma noz Carob. Dois Amarelos de grau Bom ou melhor mais Carob podem eclodir Verde ou Azul. Cada pai precisa de 5 primeiros lugares na Classe C; 16 somados tornam a cor certa. Um Verde de grau Ótimo e um Azul de grau Ótimo, cada um com 8 primeiros da Classe B, eclodem Preto (se falhar, sai Branco; 24 somados para uma rolagem certa).",
		"Como: Bilo, o Guardião das Nozes, no Vento dos Bigodes, vende Carob. Corridas de Classe A também pagam isso."
	]
	quest.42000000002805EA.title: "Carob Nut"
	quest.42000000002805EB.quest_desc: [
		"Um verde no meio da escada. Treine velocidade, vigor, inteligência ou cooperação; a ave fica saciada de cada tipo.",
		"Como: o sábio Wynn, no Vento dos Bigodes."
	]
	quest.42000000002805EB.title: "Verde Curiel"
	quest.42000000002805EC.quest_desc: [
		"O verde de treino do topo. Suba a escada quando a ave ficar saciada das folhas mais baratas.",
		"Como: o sábio Wynn no Vento dos Bigodes, ou um prêmio de corrida da Classe S."
	]
	quest.42000000002805EC.title: "Verde Sylkis"
	quest.42000000002805ED.quest_desc: [
		"O Dourado nunca eclode sem Zeio. Um Preto de grau Maravilhoso mais um Amarelo de grau Maravilhoso, cada um com 10 primeiros lugares na Classe A (32 somados para uma rolagem certa).",
		"Como: Bilo, o Guardião das Nozes, no Vento dos Bigodes, vende Zeio. Corridas de Classe S raramente pagam isso."
	]
	quest.42000000002805ED.title: "Zeio Nut"
	quest.42000000002805EE.quest_desc: [
		"GP ganhos na pista. As bancas da Praça precificam tudo em GP.",
		"Como: fique entre os três primeiros de uma bateria no Vento dos Bigodes. Monte uma ave selada até Esther para entrar."
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"A primeira noz de acasalamento. O talento segue a noz; a cor segue os pais, a menos que Carob ou Zeio entrem.",
		"Como: Bilo, o Guardião das Nozes, no Vento dos Bigodes, vende Pepio. Uma vitória na Classe C também pode pagar isso."
	]
	quest.42000000002805EF.title: "Pepio Nut"
	quest.42000000002805F0.quest_desc: [
		"Dois Gysahl e farinha de osso. O primeiro degrau acima dos verdes simples.",
		"Como: sem forma — dois Gysahl e farinha de osso."
	]
	quest.42000000002805F0.title: "Verde Krakka"
	quest.42000000002805F1.quest_desc: [
		"O próximo verde de treino. Opcional quando a fazenda já anda.",
		"Como: o sábio Wynn, ou a receita listada no JEI."
	]
	quest.42000000002805F1.title: "Verde Tantal"
	quest.42000000002805F2.quest_desc: [
		"Outro verde de treino. Opcional.",
		"Como: o sábio Wynn na Praça."
	]
	quest.42000000002805F2.title: "Verde Pahsana"
	quest.42000000002805F3.quest_desc: [
		"Outro verde de treino. Opcional.",
		"Como: o sábio Wynn na Praça."
	]
	quest.42000000002805F3.title: "Verde Mimett"
	quest.42000000002805F4.quest_desc: [
		"Outro verde de treino. Opcional.",
		"Como: o sábio Wynn na Praça."
	]
	quest.42000000002805F4.title: "Verde Reagan"
	quest.42000000002805F5.quest_desc: [
		"Uma noz intermediária. Opcional.",
		"Como: Bilo, o Guardião das Nozes, no Vento dos Bigodes, vende Luchile."
	]
	quest.42000000002805F5.title: "Luchile Nut"
	quest.42000000002805F6.quest_desc: [
		"Uma noz intermediária. Opcional.",
		"Como: Bilo, o Guardião das Nozes, no Vento dos Bigodes, vende Saraha."
	]
	quest.42000000002805F6.title: "Saraha Nut"
	quest.42000000002805F7.quest_desc: [
		"Uma noz intermediária. Opcional.",
		"Como: Bilo, o Guardião das Nozes, no Vento dos Bigodes, vende Lasan."
	]
	quest.42000000002805F7.title: "Lasan Nut"
	quest.42000000002805F8.quest_desc: [
		"Uma noz de acasalamento de meio para o fim. Opcional. Bilo, o Guardião das Nozes, a vende.",
		"Como: Bilo, o Guardião das Nozes, no Vento dos Bigodes, vende Pram."
	]
	quest.42000000002805F8.title: "Pram Nut"
	quest.42000000002805F9.quest_desc: [
		"A banca da Feira no Vento dos Bigodes vende fogos de artifício, laços, relógios de bolso e o Almanaque Chocobo por GP.",
		"Como: papel mais pólvora. Estouro opcional."
	]
	quest.42000000002805F9.title: "Fogos da Feira"
	quest.42000000002805FA.quest_desc: [
		"Uma noz de acasalamento tardia. Opcional.",
		"Como: Bilo, o Guardião das Nozes, no Vento dos Bigodes, vende Porov."
	]
	quest.42000000002805FA.title: "Porov Nut"
	quest.42000000002905FB.quest_desc: [
		"O vazio nunca fez crescer os arbustos da Pam's. Peneire terra com uma malha de linha. Quebre o jardim para sementes áridas — pimenta, milho, fruto de cacto.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: peneire terra com uma malha de linha ou melhor (Ex Deorum ou o Tear do vazio)."
	]
	quest.42000000002905FB.title: "Arid Garden"
	quest.42000000002905FC.quest_desc: [
		"Cultivos de frio, da mesma terra. Quebre o arbusto; plante o que precisar.",
		"Como: peneire terra com uma malha de linha ou melhor."
	]
	quest.42000000002905FC.title: "Frost Garden"
	quest.42000000002905FD.quest_desc: [
		"Cultivos sob a folha. A mesma peneira, outro arbusto.",
		"Como: peneire terra com uma malha de linha ou melhor."
	]
	quest.42000000002905FD.title: "Shaded Garden"
	quest.42000000002905FE.quest_desc: [
		"Cultivos úmidos. O arroz e o resto das sementes de alma de brejo vivem aqui.",
		"Como: peneire terra com uma malha de linha ou melhor."
	]
	quest.42000000002905FE.title: "Soggy Garden"
	quest.42000000002905FF.quest_desc: [
		"Cultivos quentes. Guarde um arbusto num baú; eles ainda se espalham se você os plantar.",
		"Como: peneire terra com uma malha de linha ou melhor."
	]
	quest.42000000002905FF.title: "Tropical Garden"
	quest.4200000000290600.quest_desc: [
		"O último dos seis. Toda semente de HarvestCraft na plataforma começa como um desses arbustos.",
		"Como: peneire terra com uma malha de linha ou melhor."
	]
	quest.4200000000290600.title: "Windy Garden"
	quest.4200000000290601.quest_desc: [
		"Não é a tábua de corte do Farmer's Delight. Cobre, um graveto e uma tábua. Prepare fruta e verdura antes de irem para a panela.",
		"Como: cobre, um graveto e uma tábua. Não é a tábua de corte do Farmer's Delight."
	]
	quest.4200000000290601.title: "Quadro da colheita"
	quest.4200000000290602.quest_desc: [
		"Sopas, ensopados e caldo. Cobre e um graveto. A panela volta após cada fabricação.",
		"Como: cobre e um graveto. A panela volta após cada cozimento sem forma."
	]
	quest.4200000000290602.title: "Panela da colheita"
	quest.4200000000290603.quest_desc: [
		"Refeições de frigideira. Cobre e gravetos. Fabricação diferente da frigideira Delight; o JEI as separa.",
		"Como: cobre e gravetos. Diferente da frigideira Delight."
	]
	quest.4200000000290603.title: "Frigideira da colheita"
	quest.4200000000290604.quest_desc: [
		"Molhos e reduções. Cobre e um graveto. Deixe-o ao lado da panela.",
		"Como: cobre e um graveto."
	]
	quest.4200000000290604.title: "Saucepan"
	quest.4200000000290605.quest_desc: [
		"Anel de terracota. Tortas, pães e tudo que pede forma de forno.",
		"Como: oito terracotas ao redor de um centro vazio."
	]
	quest.4200000000290605.title: "Bakeware"
	quest.4200000000290606.quest_desc: [
		"Tábuas e um graveto. Massas líquidas, massas e saladas. A estação quieta.",
		"Como: tábuas e um graveto."
	]
	quest.4200000000290606.title: "Mixing Bowl"
	quest.4200000000290607.quest_desc: [
		"Terracota. Fruta entra, suco sai. Combine com uma árvore, não com uma horta.",
		"Como: terracota. Quatro em T."
	]
	quest.4200000000290607.title: "Juicer"
	quest.4200000000290608.quest_desc: [
		"Gravetos e um tronco. Achate a massa. A forma espera.",
		"Como: gravetos dos dois lados de um tronco."
	]
	quest.4200000000290608.title: "Rolo"
	quest.4200000000290609.quest_desc: [
		"Seixos de andesito de uma peneira de sílex, depois um graveto. Farinha, temperos, pastas.",
		"Como: andesito (seixos de terra ou cascalho da peneira de sílex) e um graveto."
	]
	quest.4200000000290609.title: "Grinder"
	quest.420000000029060A.quest_desc: [
		"Um balde de água dividido em oito. A maioria das receitas quer isto, não um balde vanilla.",
		"Como: um balde de água → oito de água doce."
	]
	quest.420000000029060A.title: "Fresh Water"
	quest.420000000029060B.quest_desc: [
		"Sem vacas na plataforma. Coco (terra com malha de ferro) mais água doce, ou divida um balde de leite depois.",
		"Como: coco (terra com malha de ferro) mais água doce, ou divida um balde de leite."
	]
	quest.420000000029060B.title: "Fresh Milk"
	quest.420000000029060C.quest_desc: [
		"Água numa panela, ou uma moagem. Quase toda receita salgada pede.",
		"Como: panela mais água ou água doce. A panela volta."
	]
	quest.420000000029060C.title: "Salt"
	quest.420000000029060D.quest_desc: [
		"Trigo no moedor. A massa começa aqui.",
		"Como: moedor mais trigo (ou outra planta de farinha). O moedor volta."
	]
	quest.420000000029060D.title: "Flour"
	quest.420000000029060E.quest_desc: [
		"Farinha, sal e água doce. Tortas e pães compartilham este naco.",
		"Como: tigela de mistura, farinha, água, sal."
	]
	quest.420000000029060E.title: "Dough"
	quest.420000000029060F.quest_desc: [
		"Ossos ou verdura na panela. As sopas querem uma garrafa disto, não um caldo qualquer.",
		"Como: panela mais um osso (os Guardiões da plataforma vendem ossos) ou verdura que sobrou."
	]
	quest.420000000029060F.title: "Stock"
	quest.4200000000290610.quest_desc: [
		"Terra com malha de ferro. Cultive na plataforma; o carvalho vanilla não solta as maçãs da Pam's.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.4200000000290610.title: "Macieira"
	quest.4200000000290611.quest_desc: [
		"Ácido para molhos e peixe. A mesma peneira de ferro.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.4200000000290611.title: "Limoeiro"
	quest.4200000000290612.quest_desc: [
		"Tempero de casca. Assados e chás.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.4200000000290612.title: "Caneleira"
	quest.4200000000290613.quest_desc: [
		"Leite, óleo e cozinha tropical.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.4200000000290613.title: "Palmeira de coco"
	quest.4200000000290614.quest_desc: [
		"Vagens para doces. Plante como as outras.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.4200000000290614.title: "Trepadeira de baunilha"
	quest.4200000000290615.quest_desc: [
		"A macieira da Pam's dá maçãs comuns, bem mais do que as folhas de carvalho soltam. O espremedor e a forma querem estas.",
		"Como: folhas de carvalho soltam algumas; uma macieira da Pam's (muda de terra com malha de ferro) dá muitas."
	]
	quest.4200000000290615.title: "Maçã da Pam's"
	quest.4200000000290616.quest_desc: [
		"Forma, massa, açúcar, maçãs. O primeiro assado pronto do HarvestCraft.",
		"Como: forma, massa, açúcar, maçãs da Pam's da macieira."
	]
	quest.4200000000290616.title: "Torta de maçã (Colheita)"
	quest.4200000000290617.quest_desc: [
		"Espremedor mais fruta misturada. Uma bebida da plataforma que não é suco de melancia.",
		"Como: espremedor e frutas mistas."
	]
	quest.4200000000290617.title: "Fruit Punch"
	quest.4200000000290618.quest_desc: [
		"Frigideira, pão, queijo. Um almoço rápido enquanto as árvores crescem.",
		"Como: frigideira, pão, manteiga e queijo — tudo sai de água doce, leite de coco e farinha."
	]
	quest.4200000000290618.title: "Grilled Cheese"
	quest.4200000000290619.quest_desc: [
		"Pimentas áridas, tomate, cebola, feijão, folha de especiaria e carne ou tofu sedoso. Food Extended começa a valer a pena.",
		"Como: panela, chili árido, tomate, cebola, feijão, folha de especiaria e carne ou tofu sedoso."
	]
	quest.4200000000290619.title: "Tigela de chili"
	quest.420000000029061A.quest_desc: [
		"Especiarias do moedor, verdura dos jardins, serviço de panela.",
		"Como: caçarola, arroz, coco, chili, pimenta-do-reino, pó de curry (folha de especiaria + mostarda + canela)."
	]
	quest.420000000029061A.title: "Prato de curry"
	quest.420000000029061B.quest_desc: [
		"Massa, molho, carne. Forma de assar. Uma refeição completa do HarvestCraft.",
		"Como: forma de assar, massa, tomate, queijo, pepperoni (bacon de porco, ou bacon de tofu de bordo + soja)."
	]
	quest.420000000029061B.title: "Pepperoni Pizza"
	quest.420000000029061C.quest_desc: [
		"Arroz do jardim encharcado, cenoura, cebola, ervilhas e um ovo — o tofu sedoso entra no lugar até existirem galinhas.",
		"Como: frigideira, arroz do jardim encharcado, cenoura, cebola, ervilhas e um ovo — o tofu sedoso conta como ovo."
	]
	quest.420000000029061C.title: "Arroz frito do jardim"
	quest.420000000029061D.quest_desc: [
		"Folha de chá e folha de especiaria na panela. O jardim sombreado e o encharcado cobrem os dois.",
		"Como: panela, folha de chá e folha de especiaria. O jardim sombreado larga chá e especiaria."
	]
	quest.420000000029061D.title: "Green Tea"
	quest.420000000029061E.quest_desc: [
		"Óleo e fruto salgado. Apanha opcional da malha de ferro.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.420000000029061E.title: "Oliveira"
	quest.420000000029061F.quest_desc: [
		"Suco e raspas. Opcional.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.420000000029061F.title: "Laranjeira"
	quest.4200000000290620.quest_desc: [
		"Fruta de verão. Opcional.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.4200000000290620.title: "Pessegueiro"
	quest.4200000000290621.quest_desc: [
		"Pimenta para o moedor. Opcional.",
		"Como: peneire terra com uma malha de ferro para mudas de cozinha, depois cultive a fruta."
	]
	quest.4200000000290621.title: "Pimenteira"
	quest.4200000000290622.quest_desc: [
		"Gordura para fritar. Básico opcional.",
		"Como: prense sementes ou azeitonas no JEI. Básico opcional."
	]
	quest.4200000000290622.title: "Cooking Oil"
	quest.4200000000290623.quest_desc: [
		"Leite e sal. Básico opcional.",
		"Como: panela e leite (o leite de coco com água doce serve)."
	]
	quest.4200000000290623.title: "Butter"
	quest.4200000000290624.quest_desc: [
		"Um ovo pelo espremedor. Opcional.",
		"Como: espremedor e um ovo (o tofu sedoso conta). Opcional."
	]
	quest.4200000000290624.title: "Mayonnaise"
	quest.4200000000290625.quest_desc: [
		"Tábua de corte, frutas mistas. Opcional.",
		"Como: tábua de corte e frutas mistas. Opcional."
	]
	quest.4200000000290625.title: "Fruit Salad"
	quest.4200000000290626.quest_desc: [
		"Noite de macarrão. Opcional.",
		"Como: os jardins e as árvores frutíferas dão os ingredientes. O tofu de soja substitui a carne e o ovo. O JEI diz a estação."
	]
	quest.4200000000290626.title: "Jantar de espaguete"
	quest.4200000000290627.quest_desc: [
		"Café da manhã para ostentar. Opcional.",
		"Como: os jardins e as árvores frutíferas dão os ingredientes. O tofu de soja substitui a carne e o ovo. O JEI diz a estação."
	]
	quest.4200000000290627.title: "Bacon Pancakes"
	quest.4200000000290628.quest_desc: [
		"Terra com malha de ferro para uma muda de abacate, depois frigideira, torrada, sal, alho, folha de especiaria.",
		"Como: muda de abacate da malha de ferro, depois frigideira com torrada, sal, alho, folha de especiaria."
	]
	quest.4200000000290628.title: "Avocado Toast"
	quest.4200000000290629.quest_desc: [
		"Não é o hambúrguer do Delight. Opcional.",
		"Como: os jardins e as árvores frutíferas dão os ingredientes. O tofu de soja substitui a carne e o ovo. O JEI diz a estação."
	]
	quest.4200000000290629.title: "Hambúrguer de cebola"
	quest.420000000029062A.quest_desc: [
		"Espremedor, maçãs. Opcional.",
		"Como: espremedor e maçãs da Pam's. Opcional."
	]
	quest.420000000029062A.title: "Apple Juice"
	quest.420000000029062B.quest_desc: [
		"Frigideira, pão e manteiga. Opcional.",
		"Como: frigideira, pão e manteiga. Opcional."
	]
	quest.420000000029062B.title: "Fatia de torrada"
	quest.42000000002A062C.quest_desc: [
		"Quatro gravetos num quadrado. Coloque-os na terra arada. As sementes do jogo base se convertem quando você planta — as de Mystical Agriculture, não.",
		"Coloque um segundo conjunto de gravetos no mesmo bloco para fazer um cultivo cruzado — um par vazio que puxa o que estiver maduro ao lado. Cerque-o de pais nos quatro lados e ele se semeia sozinho em alguns minutos; farinha de osso no cruzamento força uma tentativa na hora.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: quatro gravetos num quadrado. Coloque-os na terra arada e plante uma semente."
	]
	quest.42000000002A062C.title: "Gravetos de cultivo de madeira"
	quest.42000000002A062D.quest_desc: [
		"Um livro e pena (livro, bolsa de tinta, pena) mais sementes de trigo. Deixe-o no analisador.",
		"Como: livro e pena (livro, bolsa de tinta, pena) mais sementes de trigo. Carvão vegetal mais um frasco de vidro fazem a tinta."
	]
	quest.42000000002A062D.title: "Diário de cultivos"
	quest.42000000002A062E.quest_desc: [
		"Painel de vidro e gravetos. Olhe um cultivo para ler crescimento, rendimento e força sem colhê-lo.",
		"Como: painel de vidro entre gravetos e depois um cabo de graveto. Olhe um cultivo plantado."
	]
	quest.42000000002A062E.title: "Magnifying Glass"
	quest.42000000002A062F.quest_desc: [
		"Vidro, laje de pedra, tábuas, gravetos. Coloque uma semente com o diário. A criação fica visível.",
		"A fertilidade é o atributo que impulsiona o cruzamento: uma semente nova fica em 1 de 10, e cada ponto aumenta a chance de uma planta ser escolhida como pai. Analise, replante as melhores, e os cruzamentos vêm mais rápido.",
		"Como: painéis de vidro, laje de pedra, tábuas e gravetos. Encaixe o diário e depois uma semente."
	]
	quest.42000000002A062F.title: "Seed Analyzer"
	quest.42000000002A0630.quest_desc: [
		"As ervas daninhas estão desligadas neste pacote, mas o ancinho ainda tira um graveto. Leve um mesmo assim.",
		"Como: cerca de madeira sobre um graveto. As ervas daninhas estão desligadas; ainda assim tira um graveto."
	]
	quest.42000000002A0630.title: "Ancinho de madeira"
	quest.42000000002A0631.quest_desc: [
		"Pegue uma planta e coloque-a de volta com os atributos intactos. Mova um 10-10 sem quebrá-lo.",
		"Como: dois lingotes de ferro e um graveto. Pegue uma planta com os atributos intactos."
	]
	quest.42000000002A0631.title: "Pazinha"
	quest.42000000002A0632.quest_desc: [
		"Pode uma planta madura pelo produto do corte e reinicie-a. Flores e algumas culturas do HarvestCraft.",
		"Como: tesoura, ferro e um graveto. Pode uma planta madura e reinicie-a."
	]
	quest.42000000002A0632.title: "Podador"
	quest.42000000002A0633.quest_desc: [
		"Leve uma linhagem de criação. Encha-a no analisador e esvazie-a nos gravetos.",
		"Como: couro e linha. Encha a partir do analisador."
	]
	quest.42000000002A0633.title: "Bolsa de sementes"
	quest.42000000002A0634.quest_desc: [
		"Gravetos mais firmes. As mesmas regras de plantio, menos incômodo se você esbarrar neles.",
		"Como: duas pepitas de ferro em coluna fazem oito."
	]
	quest.42000000002A0634.title: "Iron Crop Sticks"
	quest.42000000002A0635.quest_desc: [
		"O ancinho melhor. Ainda um hábito, mesmo sem ervas daninhas.",
		"Como: barras de ferro sobre um graveto."
	]
	quest.42000000002A0635.title: "Ancinho de ferro"
	quest.42000000002A0636.quest_desc: [
		"Guarda água para os canais. Uma fazenda na plataforma que não carrega baldes toda manhã.",
		"Como: tábuas. Guarda água para os canais."
	]
	quest.42000000002A0636.title: "Irrigation Tank"
	quest.42000000002A0637.quest_desc: [
		"Leve a água do tanque ao longo da fileira. As culturas bebem do canal, não de você.",
		"Como: sem forma, a partir de um tanque — um tanque vira oito canais."
	]
	quest.42000000002A0637.title: "Irrigation Channel"
	quest.42000000002A0638.quest_desc: [
		"Pare e ligue uma linha sem quebrar o tanque.",
		"Como: barras de ferro, corante vermelho e um lingote de ferro. Pare e ligue uma linha sem quebrar o tanque."
	]
	quest.42000000002A0638.title: "Channel Valve"
	quest.42000000002A0639.quest_desc: [
		"Chuva num quadrado. Encaixe-o num canal, sobre os gravetos.",
		"Como: encaixe-o num canal, sobre os gravetos. O JEI nomeia a receita."
	]
	quest.42000000002A0639.title: "Sprinkler"
	quest.42000000002A063A.quest_desc: [
		"Cubra um canal para poder andar pela fileira.",
		"Como: cubra um canal para poder andar pela fileira."
	]
	quest.42000000002A063A.title: "Grade de canal"
	quest.42000000002A063B.quest_desc: [
		"Leia o ambiente. Luz, umidade, o motivo de um cultivo ter parado.",
		"Como: faça e coloque na sala para ler luz e umidade."
	]
	quest.42000000002A063B.title: "Greenhouse Monitor"
	quest.42000000002A063C.quest_desc: [
		"Gravetos tardios. À prova de fogo, teimosos, para as plantas que exigem demais da madeira. Duas culturas maduras vizinhas podem cruzar.",
		"Como: duas obsidianas em coluna fazem oito. Duas culturas maduras vizinhas podem cruzar."
	]
	quest.42000000002A063C.title: "Obsidian Crop Sticks"
	quest.42000000002A063D.quest_desc: [
		"Um canal em que você pode andar. Opcional.",
		"Como: um canal em que você pode andar. Opcional."
	]
	quest.42000000002A063D.title: "Canal oco"
	quest.42000000002A063E.quest_desc: [
