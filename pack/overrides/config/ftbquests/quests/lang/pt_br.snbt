		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0487.title: "Armazenamento de fabricação de 1k"
	quest.42000000001D0488.quest_desc: [
		"Mais memória de fabricação para trabalhos maiores.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0488.title: "Armazenamento de fabricação de 4k"
	quest.42000000001D0489.quest_desc: [
		"Um bloco sério de memória de fabricação.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0489.title: "Armazenamento de fabricação de 16k"
	quest.42000000001D048A.quest_desc: [
		"Memória de fabricação suficiente para os maiores trabalhos da rede.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D048A.title: "Armazenamento de fabricação de 64k"
	quest.42000000001D048B.quest_desc: [
		"Memória de fabricação de arquivo, rara vez necessária, mas lá quando é.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D048B.title: "Armazenamento de fabricação de 256k"
	quest.42000000001D048C.quest_desc: [
		"Emite redstone quando um item rastreado passa de uma quantidade.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D048C.title: "Emissor de nível (Rede)"
	quest.42000000001D048D.quest_desc: [
		"Coloca blocos da rede no mundo.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D048D.title: "Plano de formação (Rede)"
	quest.42000000001D048E.quest_desc: [
		"Quebra blocos e puxa o que cai para a rede.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D048E.title: "Plano de aniquilação (Rede)"
	quest.42000000001D048F.quest_desc: [
		"Leva um canal da rede por uma quebra na linha de cabo.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D048F.title: "Túnel P2P"
	quest.42000000001D0490.quest_desc: [
		"Dobra um pedacinho de espaço numa célula portátil.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0490.title: "Espacial 2"
	quest.42000000001D0491.quest_desc: [
		"Consulte o armazenamento da rede de qualquer lugar, com um amplificador por perto.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0491.title: "Terminal sem fio (Rede)"
	quest.42000000001D0492.quest_desc: [
		"Fabrique a partir da rede sem voltar a pé até um terminal.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0492.title: "Fabricação sem fio"
	quest.42000000001D0493.quest_desc: [
		"Dispara bolas de matéria; carregue antes de precisar.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0493.title: "Canhão de matéria"
	quest.42000000001D0494.quest_desc: [
		"Um bloco transparente para cascas de controlador e linhas de cabo.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0494.title: "Vidro de quartzo"
	quest.42000000001D0495.quest_desc: [
		"Vidro que brilha sozinho, sem tocha.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0495.title: "Quartzo vibrante"
	quest.42000000001D0496.quest_desc: [
		"Um bloco de armazenamento sólido, quatro cristais condensados em um.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0496.title: "Bloco de Fluix"
	quest.42000000001D0497.quest_desc: [
		"Divide uma célula de armazenamento em vários reservatórios menores.",
		"Como: Rede do Fuso — Certus da areia, o controlador quer um Nó vinculante."
	]
	quest.42000000001D0497.title: "Bancada de células"
	quest.42000000001E0498.quest_desc: [
		"Argila e farinha de osso, um passo rumo às ferramentas de porcelana.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: bola de argila + farinha de osso, sem forma. A argila vem do Barril de tensão."
	]
	quest.42000000001E0498.title: "Argila de porcelana (Ofício do vazio)"
	quest.42000000001E0499.quest_desc: [
		"Um balde mais leve, mais gentil com o orçamento de cascalho do começo.",
		"Como: modele a argila de porcelana num balde não queimado e depois funda."
	]
	quest.42000000001E0499.title: "Porcelain Bucket"
	quest.42000000001E049A.quest_desc: [
		"Derrete blocos até líquido sobre um fogo.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E049A.title: "Cadinho de porcelana (Ofício do vazio)"
	quest.42000000001E049B.quest_desc: [
		"A primeira malha da peneira; lenta, mas funciona.",
		"Como: nove linhas num 3x3. A banca dos Cantores de cascalho vende a malha de Fio (linha) do Tear do vazio, que peneira igual."
	]
	quest.42000000001E049B.title: "Malha de linha (Ofício do vazio)"
	quest.42000000001E049C.quest_desc: [
		"Peneira mais rápido que a linha, vale a melhoria.",
		"Como: quatro sílex e cinco linhas em xadrez. O sílex vem do cascalho, ou de Fio + cascalho."
	]
	quest.42000000001E049C.title: "Malha de sílex (Ofício do vazio)"
	quest.42000000001E049D.quest_desc: [
		"Uma malha intermediária sólida, para peneirar com constância.",
		"Como: quatro barras de ferro e cinco linhas em xadrez. Nenhuma banca vende."
	]
	quest.42000000001E049D.title: "Malha de ferro (Voidcraft)"
	quest.42000000001E049E.quest_desc: [
		"Traz achados mais raros do que o ferro.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E049E.title: "Malha de ouro (Voidcraft)"
	quest.42000000001E049F.quest_desc: [
		"Peneira rápido o bastante para manter uma linha de funis alimentada.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E049F.title: "Malha de diamante (Voidcraft)"
	quest.42000000001E04A0.quest_desc: [
		"A melhor malha que uma peneira jamais vai segurar.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04A0.title: "Malha de netherita (Voidcraft)"
	quest.42000000001E04A1.quest_desc: [
		"Fiada da linha, a fibra própria do Tear.",
		"Como: quatro linhas → dois novelos. Barril de tensão: linha + pérola. Quatro Fiapos do tear."
	]
	quest.42000000001E04A1.title: "Estoque de Meada do vazio"
	quest.42000000001E04A2.quest_desc: [
		"O portão macio do Tear: postes, prensas e controladores, todos querem um.",
		"Como: anel de Meada do vazio ao redor de uma bola de slime."
	]
	quest.42000000001E04A2.title: "Estoque de Nó vinculante"
	quest.42000000001E04A3.quest_desc: [
		"A versão do Tear do vazio da malha básica de peneira.",
		"Como: linha ao redor do novelo. A banca dos Cantores de cascalho vende uma."
	]
	quest.42000000001E04A3.title: "Malha de Fio (linha)"
	quest.42000000001E04A4.quest_desc: [
		"Uma malha do Tear do vazio, um passo acima da linha comum.",
		"Como: sílex ao redor de uma malha de Fio (linha)."
	]
	quest.42000000001E04A4.title: "Malha de Fio (sílex)"
	quest.42000000001E04A5.quest_desc: [
		"Uma malha do Tear do vazio, feita para um rendimento constante.",
		"Como: ferro ao redor de uma malha de Fio (sílex). O Filamento de Trama começa aqui."
	]
	quest.42000000001E04A5.title: "Malha de Fio (ferro)"
	quest.42000000001E04A6.quest_desc: [
		"Quebra os grânulos um passo mais finos: pedregulho em cascalho, cascalho em areia, areia em pó.",
		"Como: pedregulho + gravetos. Quebre grânulos em cascalho, areia e pó."
	]
	quest.42000000001E04A6.title: "Martelo de fuso (Voidcraft)"
	quest.42000000001E04A7.quest_desc: [
		"Raspa folhas para mudas e bichos-da-seda.",
		"Como: quatro gravetos. A barraca dos Cantores de cascalho vende um."
	]
	quest.42000000001E04A7.title: "Cajado de fuso"
	quest.42000000001E04A8.quest_desc: [
		"A armação de peneira do Tear: estique uma malha nela e alimente com grânulos.",
		"Como: tábuas ao redor de um Nó vinculante. Estique uma malha, jogue grânulos com um funil e sente-a sobre um funil."
	]
	quest.42000000001E04A8.title: "Armação do tear"
	quest.42000000001E04A9.quest_desc: [
		"Água e terra viram argila; linha e uma pérola viram novelo.",
		"Como: tábuas, linha e Meada do vazio. Despeje água (o balde volta), acrescente terra → argila."
	]
	quest.42000000001E04A9.title: "Barril de tensão (Voidcraft)"
	quest.42000000001E04AA.quest_desc: [
		"Nove blocos de terra dobrados em um, para a subida.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04AA.title: "Compressed Dirt"
	quest.42000000001E04AB.quest_desc: [
		"Nove pedregulhos bem apertados, baratos e sem fim.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04AB.title: "Pedregulho comprimido (Voidcraft)"
	quest.42000000001E04AC.quest_desc: [
		"Nove cascalhos compactados; uma peneira comprimida pega o bloco inteiro.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04AC.title: "Compressed Gravel"
	quest.42000000001E04AD.quest_desc: [
		"Nove blocos de areia prensados em um, para carregar.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04AD.title: "Compressed Sand"
	quest.42000000001E04AE.quest_desc: [
		"Nove blocos de pó prensados, pelo mesmo motivo.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04AE.title: "Compressed Dust"
	quest.42000000001E04AF.quest_desc: [
		"Pedra do Nether compactada, para um inventário mais leve.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04AF.title: "Compressed Netherrack"
	quest.42000000001E04B0.quest_desc: [
		"Pedra do End compactada, útil quando o vazio precisar ser alimentado.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04B0.title: "Compressed End Stone"
	quest.42000000001E04B1.quest_desc: [
		"Ardósia profunda compactada, nove para um, e ainda é só pedra.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04B1.title: "Compressed Deepslate"
	quest.42000000001E04B2.quest_desc: [
		"Esmaga de uma vez uma pilha inteira de blocos comprimidos.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04B2.title: "Martelo comprimido"
	quest.42000000001E04B3.quest_desc: [
		"Um martelo mais fraco para quebrar blocos comprimidos.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04B3.title: "Compressed Iron Hammer"
	quest.42000000001E04B4.quest_desc: [
		"Uma peneira larga, várias pilhas de cascalho por vez.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04B4.title: "Peneira comprimida (Voidcraft)"
	quest.42000000001E04B5.quest_desc: [
		"Peneira igual à de carvalho, só muda o veio.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04B5.title: "Birch Sieve"
	quest.42000000001E04B6.quest_desc: [
		"Fermenta igual a qualquer outro barril.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04B6.title: "Birch Barrel"
	quest.42000000001E04B7.quest_desc: [
		"Derrete blocos igual a qualquer outro cadinho.",
		"Como: peneira, martelo, cadinho ou barril do Ex Deorum. Ajuste a malha aos grânulos."
	]
	quest.42000000001E04B7.title: "Birch Crucible"
	quest.42000000001E04B8.quest_desc: [
		"A moeda da Trama; ganhe, gaste, nunca desperdice.",
		"Como: recompensas de missão, terra com malha de pederneira numa Armação do tear, reservas do zelador."
	]
	quest.42000000001E04B8.title: "Estoque de Fio desfiado"
	quest.42000000001E04B9.quest_desc: [
		"Páginas de arquivo e notas.",
		"Como: assente uma Trama no Poste, ou na banca dos Entalhadores de selos em /clowder hub (8 Fio). Clique direito para ler; ficam guardadas, não são gastas."
	]
	quest.42000000001E04B9.title: "Páginas do códice"
	quest.42000000001E04BA.quest_desc: [
		"Clique direito e abra Comece aqui. Acento grave (`): a lista de tarefas. O livro não atribui missões.",
		"Como: kit inicial / baú do cais. Clique direito no livro; o acento grave (`) é a lista de tarefas."
	]
	quest.42000000001E04BA.title: "Códice dos Bigodes"
	quest.42000000001F04BB.quest_desc: [
		"O papel dentro de um pacote, antes de ser selado de vez.",
		"As Nove Tribos deixaram provisões para o próximo Clowder. Use uma reserva do zelador para desembrulhar suprimentos aleatórios, ou fabrique quatro reservas pequenas em uma média e três médias em uma grande. Selos maiores têm mais rolagens e um conjunto de suprimentos mais amplo; abrir separado dá mais suprimentos básicos. Nenhuma máquina nem ficha de progresso se esconde dentro, mas cada selo tem uma chance pequena de um Fragmento de Fio e uma bem pequena de um Fio de retorno inteiro; selos maiores têm chances melhores.",
		"Como: barras de ouro e tábuas ao redor de um Olho de ender. A primeira receita de Packaged Auto."
	]
	quest.42000000001F04BB.title: "Componente de pacote"
	quest.42000000001F04BC.quest_desc: [
		"Um invólucro de pacote feito, em vez disso, em volta de um padrão guardado.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04BC.title: "Componente de pacote ME"
	quest.42000000001F04BD.quest_desc: [
		"Sela itens num pacote para a linha mover.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04BD.title: "Empacotador (empacotado)"
	quest.42000000001F04BE.quest_desc: [
		"Acrescenta outro espaço de empacotamento a um empacotador.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04BE.title: "Extensão de empacotador"
	quest.42000000001F04BF.quest_desc: [
		"Abre um pacote de volta em itens soltos.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04BF.title: "Unpackager"
	quest.42000000001F04C0.quest_desc: [
		"Escreve uma receita de fabricação num padrão de pacote.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04C0.title: "Codificador"
	quest.42000000001F04C1.quest_desc: [
		"Monta um pacote seguindo a receita codificada dele.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04C1.title: "Fabricador"
	quest.42000000001F04C2.quest_desc: [
		"Encaminha os pacotes para o endereço que coincidir.",
		"Como: Marcador de distribuidor, componente de empacotamento, dois Cascos de shulker, quatro pérolas de ender e um bloco de ferro. Cascos: receita do pack, seis blocos de purpur, duas pérolas de ender e um Nó vinculante."
	]
	quest.42000000001F04C2.title: "Distribuidor"
	quest.42000000001F04C3.quest_desc: [
		"Marca um destino para onde um distribuidor pode mandar pacotes.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04C3.title: "Distributor Marker"
	quest.42000000001F04C4.quest_desc: [
		"Põe os pacotes prontos na linha, para retirada.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04C4.title: "Provedor de empacotamento"
	quest.42000000001F04C5.quest_desc: [
		"Deixa um fabricador distante pedir por este bloco, em vez disso.",
		"Como: Marcador de intermediário, componente de empacotamento, dois Cascos de shulker, duas pérolas de ender, duas obsidianas choronas e um bloco de ferro. Cascos: receita do pack, seis blocos de purpur, duas pérolas de ender e um Nó vinculante."
	]
	quest.42000000001F04C5.title: "Intermediário de fabricação"
	quest.42000000001F04C6.quest_desc: [
		"Guarda um lote de receitas de pacote para reutilizar.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04C6.title: "Porta-receitas"
	quest.42000000001F04C7.quest_desc: [
		"Copia os ajustes de um bloco para outro e poupa muitos cliques.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04C7.title: "Clonador de ajustes"
	quest.42000000001F04C8.quest_desc: [
		"Enche um pacote de fluido em vez de itens.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04C8.title: "Fluid Package Filler"
	quest.42000000001F04C9.quest_desc: [
		"Um fardo selado de itens, pronto para mover ou guardar.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04C9.title: "Item pacote"
	quest.42000000001F04CA.quest_desc: [
		"Cabe bem mais num só pacote do que no tipo básico.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04CA.title: "Volume Package"
	quest.42000000001F04CB.quest_desc: [
		"Marca onde um intermediário de fabricação deve chegar.",
		"Como: componente de pacote, depois Empacotador / Codificador. Precisa de uma rede da AE2 para a peça ME."
	]
	quest.42000000001F04CB.title: "Proxy Marker"
	quest.42000000001F04CC.quest_desc: [
