	quest.420000000018035A.title: "Prudentium 加速器"
	quest.420000000018035B.quest_desc: [
		"中层加速，给更忙的田。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
