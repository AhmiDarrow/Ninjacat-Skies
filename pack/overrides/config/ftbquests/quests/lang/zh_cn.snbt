	]
	quest.42000000001903A6.title: "离心机（蜂场）"
	quest.42000000001903A7.quest_desc: [
		"一通上能量，就自己转的离心机。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903A7.title: "能量离心机（蜂场）"
	quest.42000000001903A8.quest_desc: [
		"有热源供给时，转得更快。",
