		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.4200000000060114.title: "放置器"
	quest.4200000000060115.quest_desc: [
		"旋转够用时，把原木切成木板，或把树切成成材。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.4200000000060115.title: "机械锯"
	quest.4200000000060116.quest_desc: [
		"钻穿砾石方块。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.4200000000060116.title: "机械钻"
	quest.4200000000060117.quest_desc: [
