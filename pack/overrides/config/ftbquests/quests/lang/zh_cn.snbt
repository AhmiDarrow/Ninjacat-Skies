{
	chapter.3100000000000001.chapter_subtitle: [
		"苏醒——活下来，认领浮台，让抄本醒来。"
	]
	chapter.3100000000000001.title: "丝缕：土壤"
	chapter.3100000000000002.chapter_subtitle: [
		"回收——把坠落的世界拉回物质里。"
	]
	chapter.3100000000000002.title: "丝缕：石"
	chapter.3100000000000003.chapter_subtitle: [
		"扎根——养出锚，让浮台不再绽开。"
	]
	chapter.3100000000000003.title: "丝缕：萌芽"
	chapter.3100000000000004.chapter_subtitle: [
		"边缘——备好行装，故意离开浮台。"
	]
	chapter.3100000000000004.title: "丝缕：爪"
	chapter.3100000000000005.chapter_subtitle: [
		"低鸣——先是节奏和脉动，然后才是导线。"
	]
	chapter.3100000000000005.title: "丝缕：火花"
	chapter.3100000000000006.chapter_subtitle: [
		"纹样——一座自己能唱下去的工厂。"
	]
	chapter.3100000000000006.title: "丝缕：时钟"
	chapter.3100000000000007.chapter_subtitle: [
		"群落——养活一个会养活别的东西的东西。"
	]
	chapter.3100000000000007.title: "丝缕：群"
	chapter.3100000000000008.chapter_subtitle: [
		"缚合——印记、仪式，一条绳里两条辫路。"
	]
	chapter.3100000000000008.title: "丝缕：印记"
	chapter.3100000000000009.chapter_subtitle: [
		"重织——数字织机、边境、碎片。"
	]
	chapter.3100000000000009.title: "丝缕：纺锤"
	chapter.310000000000000A.title: "深筛"
	chapter.310000000000000B.title: "存储与背包"
	chapter.310000000000000C.title: "Mekanism 工坊"
	chapter.310000000000000D.title: "Powah 电网"
	chapter.310000000000000E.title: "奥术侧"
	chapter.310000000000000F.chapter_subtitle: [
		"队伍、大厅、柱，还有绽裂。"
	]
	chapter.310000000000000F.title: "Clowder 大厅"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "厨房产线"
	chapter.3100000000000013.title: "战斗法术"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "浮台装饰"
	chapter.3100000000000016.title: "下界立足点"
	chapter.3100000000000017.title: "末地立足点"
	chapter.3100000000000018.title: "精华田"
	chapter.3100000000000019.chapter_subtitle: [
		"每个巢都是花周围的一圈东西。"
	]
	chapter.3100000000000019.title: "群蜂箱"
	chapter.310000000000001A.title: "管网"
	chapter.310000000000001B.title: "异界"
	chapter.310000000000001C.title: "深层钟械"
	chapter.310000000000001D.title: "纺锤网络"
	chapter.310000000000001E.title: "虚空工艺"
	chapter.310000000000001F.title: "封装产线"
	chapter.3100000000000020.title: "QIO 与 Mek 之巅"
	chapter.3100000000000021.title: "狩猎与农耕"
	chapter.3100000000000022.title: "部族编织"
	chapter.3100000000000023.chapter_subtitle: [
		"砾歌者把一块石头切出一百种样子。"
	]
	chapter.3100000000000023.title: "石匠"
	chapter.3100000000000024.chapter_subtitle: [
		"浮台在有人放上椅子之前，只是一道岩沿。"
	]
	chapter.3100000000000024.title: "陈设"
	chapter.3100000000000025.chapter_subtitle: [
		"执事们留下的小机器。"
	]
	chapter.3100000000000025.title: "小型执事所"
	chapter.3100000000000026.chapter_subtitle: [
		"鼓心的脉动学会顺着铜奔走。"
	]
	chapter.3100000000000026.title: "电流"
	chapter.3100000000000027.chapter_subtitle: [
		"切断扯断了十三名守护者。打败每条丝缕的守护者，重新绷上张力。"
	]
	chapter.3100000000000027.title: "绷断守护者"
	chapter.3100000000000028.chapter_subtitle: [
		"走一遍边境。驯服一只黄色的。你到过那里之后，Esther 在大厅等你。"
	]
	chapter.3100000000000028.title: "浮台奔者"
	chapter.3100000000000029.chapter_subtitle: [
		"筛出来的园子。去做虚空浮台从没长出来的东西。"
	]
	chapter.3100000000000029.title: "收获餐桌"
	chapter.310000000000002A.chapter_subtitle: [
		"作物棒、属性、灌溉。岩架上杂草待不住。"
	]
	chapter.310000000000002A.title: "作物棒"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "制作与张力"
	chapter_group.2100000000000003.title: "重织"
	chapter_group.2100000000000004.title: "旁路"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"你在岩架上醒来。先看一眼落差，再点这里。",
		"反引号（`）是任务列表。胡须抄本就是从这里开始。",
		"做法：点这个任务。然后打那棵橡树。"
	]
	quest.4200000000018001.title: "看向落差"
	quest.4200000000010001.quest_desc: [
		"你是 Skybound。这是没有坠落的。",
		"八根原木。从树开始；是树先从你开始的。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：打你浮台上的橡树。八根原木开启苏醒。"
	]
	quest.4200000000010001.title: "在浮台苏醒"
	quest.4200000000010002.quest_desc: [
		"泥土是浮台许给你靴子的承诺。",
		"十六个方块。把承诺拓宽。",
		"做法：初始箱子、圆石+丝线消耗配方、筛子余料，或 /clowder hub（浮台看守）。"
	]
	quest.4200000000010002.title: "立足之地"
	quest.4200000000010003.quest_desc: [
		"手需要一块台面。这之后的一切，都是台面。",
		"做法：四块木板排成正方形。"
	]
	quest.4200000000010003.title: "做工作台"
	quest.4200000000010004.quest_desc: [
		"爪以后再来。眼下，是会咬人的木头。",
		"做法：三块木板放在两根木棍上面。"
	]
	quest.4200000000010004.title: "木镐"
	quest.4200000000010005.quest_desc: [
		"对着落差的绿意。",
		"在饿之前种下它。",
		"做法：打破橡树叶，或 /clowder hub 缚根者（8丝线换四个）。"
	]
	quest.4200000000010005.title: "第一棵树苗"
	quest.4200000000010006.quest_desc: [
		"六十四块木板，浮台就不再像一块岩架。",
		"做法：合成格里放一根原木，得到四块。"
	]
	quest.4200000000010006.title: "木板储备"
	quest.4200000000010007.quest_desc: [
		"握柄、框架，工具的骨头。",
		"做法：两块木板竖着放。"
	]
	quest.4200000000010007.title: "一捆木棍"
	quest.4200000000010008.quest_desc: [
		"把东西放到它们会留下的地方。Clowder 在分享别的之前，先分享一只箱子。",
		"做法：八块木板围住空的中心。"
	]
	quest.4200000000010008.title: "给 Clowder 的箱子"
	quest.4200000000010009.quest_desc: [
		"在边缘看见你之前，先看见边缘。",
		"做法：煤炭或木炭放在木棍上。 /clowder hub 的亲族出售一包。"
	]
	quest.4200000000010009.title: "火把列"
	quest.420000000001000A.quest_desc: [
		"冰和熔岩在原本没有的地方造出石头。",
		"普通和困难浮台都带着这两样。 /clowder hub 的浮台看守出售一只桶。",
		"做法：熔岩挨着水（或把冰融化）。锤石头。 /clowder hub 的砾歌者摊位出售一捆。"
	]
	quest.420000000001000A.title: "圆石储备"
	quest.420000000001000B.quest_desc: [
		"还不是火花的暖意。",
		"浮台看守会把这叫做炉灶。",
		"做法：八块圆石围住空的中心。"
	]
	quest.420000000001000B.title: "熔炉的热"
	quest.420000000001000C.quest_desc: [
		"饥饿是柔软的虚空。八个面包能把它合上一阵。",
		"做法：三份小麦排成一行，或 /clowder hub 炉灶看守。"
	]
	quest.420000000001000C.title: "做一顿饭"
	quest.420000000001000D.quest_desc: [
		"放下熔岩，把冰融成水源，装满桶。",
		"简单带着水；普通和困难带着零件。",
		"做法：空桶对着水源。普通/困难：放熔岩，融冰，装满。"
	]
	quest.420000000001000D.title: "接住雨水"
	quest.420000000001000E.quest_desc: [
		"还撑着的织机碎料。每个任务都会还回一些。",
		"拆开一根换成线，或在 /clowder hub 的亲族摊位花掉它们。",
		"做法：任务奖励、织机架上铺了燧石网的泥土、执事储藏。"
	]
	quest.420000000001000E.title: "绽线货币"
	quest.420000000001000F.quest_desc: [
		"破损了，但仍在教你。打开从这里开始。",
		"右键这本书，打开从这里开始。反引号（`）：任务列表。",
		"做法：起始套件 / 码头箱子。右键这本书；反引号（`）就是任务列表。"
	]
	quest.420000000001000F.title: "手中抄本"
	quest.4200000000010010.quest_desc: [
		"设定重生点。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010010.title: "认领床位"
	quest.4200000000010011.quest_desc: [
		"不用绳子也能下到深处。便宜到每条竖井都能留一架。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010011.title: "下梯"
	quest.4200000000010012.quest_desc: [
		"蛛丝留着以后做网。每根纤维迟早都会用上。",
		"做法：拆开绽线（1 → 3）。蜘蛛。在回响缚结处用织机绒絮。纱的反向消耗。"
	]
	quest.4200000000010012.title: "线储备"
	quest.4200000000010013.quest_desc: [
		"催绿。",
		"做法：骨头摆进合成格，或丝线 + 腐肉消耗，或 /clowder hub 浮台看守。"
	]
	quest.4200000000010013.title: "骨粉储备"
	quest.4200000000010014.quest_desc: [
		"拓宽浮台。",
		"做法：初始箱子、圆石+丝线消耗配方、筛子余料，或 /clowder hub（浮台看守）。"
	]
	quest.4200000000010014.title: "泥土浮台"
	quest.4200000000010015.quest_desc: [
		"现在修剪，以后堆肥。浮台上没有东西会浪费。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010015.title: "橡木树叶"
	quest.4200000000010016.quest_desc: [
		"安静的一角。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010016.title: "花盆"
	quest.4200000000010017.quest_desc: [
		"Ex Deorum 的木桶：堆肥，以及把水慢慢变成黏土。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010017.title: "木桶"
	quest.4200000000010018.quest_desc: [
		"废料成粉。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010018.title: "堆肥桶"
	quest.4200000000010019.quest_desc: [
		"划出一垄。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010019.title: "木锄"
	quest.420000000001001A.quest_desc: [
		"砍原木比空手快。这是 Skybound 拥有的第一件真正的工具。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001001A.title: "木斧"
	quest.420000000001001B.quest_desc: [
		"把泥土和砾石变成平整的地。慢，但有用。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001001B.title: "木铲"
	quest.420000000001001C.quest_desc: [
		"勉强挡住一只僵尸，但挡得住。比挥拳头强。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001001C.title: "木剑"
	quest.420000000001001D.quest_desc: [
		"盛汤、盛炖菜，别的差不多不行。简单浮台配简单器皿。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001001D.title: "碗"
	quest.420000000001001E.quest_desc: [
		"给浮台做标记。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001001E.title: "物品展示框"
	quest.420000000001001F.quest_desc: [
		"把它变成家。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001001F.title: "画"
	quest.4200000000010020.quest_desc: [
		"让风和生物留在墙的正确一侧。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010020.title: "橡木门"
	quest.4200000000010021.quest_desc: [
		"标出边缘，又不挡住视线。在落下去是真的地方很管用。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010021.title: "橡木栅栏"
	quest.4200000000010022.quest_desc: [
		"把陡墙变成你真能爬上去的东西。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010022.title: "橡木楼梯"
	quest.4200000000010023.quest_desc: [
		"半个方块，地板选择翻倍。窄处很有用。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010023.title: "橡木台阶"
	quest.4200000000010024.quest_desc: [
		"进出用的活板门。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010024.title: "橡木活板门"
	quest.4200000000010025.quest_desc: [
		"有东西踩上去就发出信号。门会自己打开。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010025.title: "橡木压力板"
	quest.4200000000010026.quest_desc: [
		"用来点一下红石的按钮。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010026.title: "橡木按钮"
	quest.4200000000010027.quest_desc: [
		"给浮台边缘围上栅栏。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010027.title: "木棍栅栏门"
	quest.4200000000010028.quest_desc: [
		"慢慢做饭，烟几里外都看得见。",
		"做法：原木、木棍，以及煤炭或木炭。"
	]
	quest.4200000000010028.title: "营火"
	quest.4200000000010029.quest_desc: [
		"火把显得别扭的地方就挂一盏灯。光更暖，活一样。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010029.title: "灯笼"
	quest.420000000001002A.quest_desc: [
		"燃着淡蓝的火，让附近几乎不会生成东西。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001002A.title: "灵魂灯笼"
	quest.420000000001002B.quest_desc: [
		"跟着你往上爬，一拉就消失。往高处建不再吓人。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001002B.title: "脚手架"
	quest.420000000001002C.quest_desc: [
		"用来挂点缀的锁链。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001002C.title: "锁链"
	quest.420000000001002D.quest_desc: [
		"围住边缘。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001002D.title: "铁栏杆"
	quest.420000000001002E.quest_desc: [
		"浮台窗户用的玻璃。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001002E.title: "玻璃板"
	quest.420000000001002F.quest_desc: [
		"柔软、易燃、也好染色。每座浮台迟早都需要一张床。",
		"做法：先给羊吃草再剪毛，或者四根线。"
	]
	quest.420000000001002F.title: "白色羊毛"
	quest.4200000000010030.quest_desc: [
		"薄薄一层羊毛，给用不着整块的地板。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010030.title: "白色地毯"
	quest.4200000000010031.quest_desc: [
		"给砾石铺成的浮台添一点绿和粉。",
		"做法：苔藓加橡木，或者给苔藓用骨粉。蜜蜂认这朵花。"
	]
	quest.4200000000010031.title: "盛开的杜鹃"
	quest.4200000000010032.quest_desc: [
		"慢慢蔓延，让粗糙的石台看起来柔和些。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010032.title: "苔藓块"
	quest.4200000000010033.quest_desc: [
		"浮台底下的垂根。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010033.title: "垂根"
	quest.4200000000010034.quest_desc: [
		"贴在墙上，不用一根火把也能照亮。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010034.title: "发光地衣"
	quest.4200000000010035.quest_desc: [
		"用来做尖角点缀的滴水石。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010035.title: "滴水石锥"
	quest.4200000000010036.quest_desc: [
		"一整块紫水晶。印记以后会要碎片。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010036.title: "紫水晶块"
	quest.4200000000010037.quest_desc: [
		"九块锭压在一起。放在外面会变成绿色。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010037.title: "铜块"
	quest.4200000000010038.quest_desc: [
		"九块粗铁紧紧叠着，等着进熔炉。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010038.title: "粗铁块"
	quest.4200000000010039.quest_desc: [
		"比散煤烧得久得多。丢进熔炉就能走开。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000010039.title: "煤炭块"
	quest.420000000001003A.quest_desc: [
		"能喂动物，也能减缓坠落。农夫两种用途都把它留在身边。",
		"做法：九个小麦。三个小麦也能做面包。"
	]
	quest.420000000001003A.title: "干草块"
	quest.420000000001003B.quest_desc: [
		"九份海带压成的燃料。熔炼得比看起来多。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001003B.title: "干海带块"
	quest.420000000001003C.quest_desc: [
		"纸和皮革，等着变成带配方的东西。",
		"做法：三张纸加皮革。纸就是甘蔗。"
	]
	quest.420000000001003C.title: "书"
	quest.420000000001003D.quest_desc: [
		"做书和地图用的纸。",
		"做法：三根甘蔗排成一行。甘蔗来自用燧石网或更好的网筛泥土。"
	]
	quest.420000000001003D.title: "纸"
	quest.420000000001003E.quest_desc: [
		"染料和书都需要墨水。",
		"做法：木炭加玻璃瓶。鱿鱼在这里从不生成。"
	]
	quest.420000000001003E.title: "墨囊"
	quest.420000000001003F.quest_desc: [
		"做箭和书用的羽毛。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000001003F.title: "羽毛"
	quest.4200000000010040.quest_desc: [
		"做书和套件用的皮革。",
		"做法：熔炼腐肉，或在营火上烤。用燧石网筛泥土。/clowder hub 浮台看守以18丝线卖两个。"
	]
	quest.4200000000010040.title: "皮革"
	quest.4200000000010041.quest_desc: [
		"工作台、树苗、炉火、水、抄本。浮台稳住了。",
		"给丝缕上张力：浮台看守会回应，令牌归你安放。",
		"领取它，并从部落选一份礼物：一根归返丝线，多一条共享的命，或者物资。",
		"做法：完成与此相连的任务，再领取丝缕令牌。把令牌安放到你的张力柱上。"
	]
	quest.4200000000010041.quest_subtitle: "苏醒"
	quest.4200000000010041.title: "土壤结"
	quest.4200000000010042.quest_desc: [
		"拿着令牌右键你的 Clowder 的张力柱。",
		"刻槽亮起，部落鸣响，浮台改变。",
		"做法：手里拿着丝缕令牌，右键你的张力柱。"
	]
	quest.4200000000010042.title: "安放土壤"
	quest.4200000000010043.quest_desc: [
		"没有洞穴的浮台上有一只僵尸。虚空向你问好。",
		"照亮边缘。",
		"做法：夜里在浮台上杀死一只僵尸。照亮边缘。"
	]
	quest.4200000000010043.title: "有东西上来了"
	quest.4200000000020044.quest_desc: [
		"记得来处的丝线。",
		"把丝线拆成线；四根线纺出两团纱。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：四根线 → 两团纱。张力桶：线 + 珍珠。四份织机绒絮。"
	]
	quest.4200000000020044.title: "抽出虚空纱"
	quest.4200000000020045.quest_desc: [
		"圆石和木棍。把落下的砂砾敲成沙砾、沙子和粉。",
		"做法：圆石 + 木棍。把砂砾敲成沙砾、沙子和粉。"
	]
	quest.4200000000020045.title: "纺锤锤"
	quest.4200000000020046.quest_desc: [
		"纱的周围绕上线。它接住织机掉下的东西——也从泥土里梳出织机绒絮。",
		"做法：纱的周围绕上线。砾歌者的摊子卖一张。"
	]
	quest.4200000000020046.title: "穿上网"
	quest.4200000000020047.quest_desc: [
		"倒入水；桶马上回来。加入泥土。等黏土。",
		"同一只桶里的线和珍珠做出纱。",
		"做法：木板、线、虚空纱。倒入水（桶会回来），加入泥土 → 黏土。"
	]
	quest.4200000000020047.title: "张力桶"
	quest.4200000000020048.quest_desc: [
		"从桶里取出十六份黏土。一次装八个泥土。",
		"做法：张力桶——水 + 泥土。回声粉碎机把沙子锤成黏土。"
	]
	quest.4200000000020048.title: "黏土口袋"
	quest.4200000000020049.quest_desc: [
		"黏土和骨粉。塑出未烧的桶。",
		"做法：黏土球 + 骨粉，无序合成。黏土来自张力桶。"
	]
	quest.4200000000020049.title: "瓷黏土"
	quest.420000000002004A.quest_desc: [
		"熔炼它。在铁还只是传闻的地方，瓷能装熔岩。",
		"做法：把瓷黏土塑成未烧的桶，然后熔炼。"
	]
	quest.420000000002004A.title: "瓷具"
	quest.420000000002004B.quest_desc: [
		"砾歌者按回声给每一片碎片取名。",
		"筛到能听见铁为止。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.420000000002004B.title: "筛落下的砂砾"
	quest.420000000002004C.quest_desc: [
		"一套备用敲击。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.420000000002004C.title: "木锤"
	quest.420000000002004D.quest_desc: [
		"从砂砾里来的物质。六十四块石头，一小时前还是粉。",
		"做法：熔岩挨着水（或把冰融化）。锤石头。 /clowder hub 的砾歌者摊位出售一捆。"
	]
	quest.420000000002004D.title: "卵石"
	quest.420000000002004E.quest_desc: [
		"织机的粉等在沙砾里。燧石也是。",
		"做法：锤圆石（纺锤锤或回声粉碎机）。"
	]
	quest.420000000002004E.title: "沙砾之路"
	quest.420000000002004F.quest_desc: [
		"细砂砾。玻璃以后再说，也是铁网捞得最好的东西。",
		"做法：锤沙砾。"
	]
	quest.420000000002004F.title: "沙藏"
	quest.4200000000020050.quest_desc: [
		"坠落世界的灰。红石和火药藏在里面。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.4200000000020050.title: "粉堆"
	quest.4200000000020051.quest_desc: [
		"纱围住黏液。浮台堆肥做出黏液。",
		"结是织机的软门；留两个。",
		"做法：一圈虚空纱围住粘液球。"
	]
	quest.4200000000020051.title: "系上缚结"
	quest.4200000000020052.quest_desc: [
		"木板围住一个结。把网绷上，装上砂砾，让它干活。",
		"漏斗给它送料。这是浮台的第一台机器。",
		"做法：木板围住一枚缚结。把网绷上，用漏斗送入砂砾，把它坐在漏斗上。"
	]
	quest.4200000000020052.title: "立起织机架"
	quest.4200000000020053.quest_desc: [
		"铁低沉，也耐心。从网上得到八块。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.4200000000020053.title: "铁矿石块"
	quest.4200000000020054.quest_desc: [
		"从沙砾里一点一点筛出来。网比你的眼睛先找到铜。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.4200000000020054.title: "铜矿石块"
	quest.4200000000020055.quest_desc: [
		"金几乎懒得应一声。四个就够了。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.4200000000020055.title: "金矿石块"
	quest.4200000000020056.quest_desc: [
		"给产线添燃料。",
		"做法：筛沙砾，或熔炼煤矿石。"
	]
	quest.4200000000020056.title: "煤炭"
	quest.4200000000020057.quest_desc: [
		"碎块到粗矿。接着熔炼。",
		"做法：筛沙砾得到铁矿石块；四个合成铁矿石方块，挖开会掉粗铁。"
	]
	quest.4200000000020057.title: "粗铁"
	quest.4200000000020058.quest_desc: [
		"回收会付钱。十六块锭，虚空本不想让你拿到。",
		"做法：熔炼粗铁 / 铁砂砾（熔炉或余烬窑）。筛砾石取碎块。"
	]
	quest.4200000000020058.title: "铁锭"
	quest.4200000000020059.quest_desc: [
		"导线和灯泡，以后还有部族谐振器。",
		"做法：熔炼粗铜 / 铜砂砾。筛砾石。"
	]
	quest.4200000000020059.title: "铜锭"
	quest.420000000002005A.quest_desc: [
		"镀金工具，还有给纹织者的金板。",
		"做法：熔炼粗金 / 金砂砾。筛子里更稀有的收获。"
	]
	quest.420000000002005A.title: "金锭"
	quest.420000000002005B.quest_desc: [
		"更利的收获。燧石网把绽线从砂砾里抖出来。",
		"做法：丝线网（线）四周放上燧石。"
	]
	quest.420000000002005B.title: "燧石网"
	quest.420000000002005C.quest_desc: [
		"给更重粉尘用的金属丝。铁网就是丝缕细丝落下的地方。",
		"做法：丝线网（燧石）四周放上铁。丝缕细丝从这里开始。"
	]
	quest.420000000002005C.title: "铁网"
	quest.420000000002005D.quest_desc: [
		"熔化，滴落。给足时间，圆石变成熔岩。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.420000000002005D.title: "坩埚"
	quest.420000000002005E.quest_desc: [
		"Ex Deorum 的木桶：堆肥，以及把水慢慢变成黏土。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.420000000002005E.title: "桶（石）"
	quest.420000000002005F.quest_desc: [
		"打得更狠，用得更久。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.420000000002005F.title: "石锤"
	quest.4200000000020060.quest_desc: [
		"把矿石碾成砾石和砂砾，筛子背后的吵闹手法。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.4200000000020060.title: "铁锤"
	quest.4200000000020061.quest_desc: [
		"网更宽，一次九个。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.4200000000020061.title: "压缩筛"
	quest.4200000000020062.quest_desc: [
		"能看穿。沙子变成玻璃。",
		"做法：熔炼沙子。用锤子把圆石敲成砾石，砾石敲成沙子，再送进熔炉。"
	]
	quest.4200000000020062.title: "玻璃"
	quest.4200000000020063.quest_desc: [
		"现在用铁来装雨。",
		"做法：三个铁锭，或 /clowder hub 浮台看守（8丝线）。用融化的冰灌满。"
	]
	quest.4200000000020063.title: "桶"
	quest.4200000000020064.quest_desc: [
		"虚空的热，握在手里。",
		"做法：Ex Deorum 的熔岩坩埚，或爪的黑曜石之后，下界的熔岩池。"
	]
	quest.4200000000020064.title: "熔岩桶"
	quest.4200000000020065.quest_desc: [
		"传送门的念头。水浇在熔岩源上。",
		"做法：水浇在熔岩源上（或熔岩浇在水上）。留下熔岩源。"
	]
	quest.4200000000020065.title: "黑曜石"
	quest.4200000000020066.quest_desc: [
		"砂砾里的稀罕运气。两个就是起步。",
		"做法：用铁网或更好的网筛砾石，或用回声粉碎机处理钻石矿石。"
	]
	quest.4200000000020066.title: "钻石"
	quest.4200000000020067.quest_desc: [
		"网升级的燃料。",
		"做法：砾石，或丝线 + 砾石消耗。"
	]
	quest.4200000000020067.title: "燧石"
	quest.4200000000020068.quest_desc: [
		"用砂砾和粉尘做成，不是从苦力怕身上抢的。小心拿。",
		"做法：筛粉尘或灵魂沙，或夜里浮台上的苦力怕。有了一些之后，把边缘照亮。"
	]
	quest.4200000000020068.title: "火药"
	quest.4200000000020069.quest_desc: [
		"火花会要这个。保持干燥。",
		"做法：筛砾石，或在回收之后用回声粉碎机处理红石矿石。"
	]
	quest.4200000000020069.title: "红石"
	quest.420000000002006A.quest_desc: [
		"供给附魔台。让装备更听话的蓝色粉末。",
		"做法：筛砾石，或用回声粉碎机处理青金石矿石。"
	]
	quest.420000000002006A.title: "青金石"
	quest.420000000002006B.quest_desc: [
		"一种常见的石头混合物，多用于建造，以后也会拿来配配方。",
		"做法：筛泥土/砾石里的卵石，或在 JEI 里用圆石加闪长岩。"
	]
	quest.420000000002006B.title: "安山岩"
	quest.420000000002006C.quest_desc: [
		"带斑点的石头，装饰多于承重。砾歌者叫它吵闹的那块。",
		"做法：筛卵石，或圆石加下界石英。"
	]
	quest.420000000002006C.title: "闪长岩"
	quest.420000000002006D.quest_desc: [
		"密实，带着粉色斑点，适合想显眼的地板。",
		"做法：筛卵石，或闪长岩加下界石英。"
	]
	quest.420000000002006D.title: "花岗岩"
	quest.420000000002006E.quest_desc: [
		"来自另一处的多孔岩石。一点着，就永远烧下去。",
		"做法：这里的下界是虚空，不是地形。把熔岩倒进装有巫水的 Ex Deorum 木桶（放在菌丝上的一桶水；菌丝孢子从泥土里筛出）。"
	]
	quest.420000000002006E.title: "下界岩"
	quest.420000000002006F.quest_desc: [
		"踏上的每一步都变慢，并给灵魂火喂进更冷的蓝。",
		"做法：把沙子倒进装有巫水的 Ex Deorum 木桶。要塞的疣室里有一点。灵魂沙上三个头颅做成凋灵。"
	]
	quest.420000000002006F.title: "灵魂沙"
	quest.4200000000020070.quest_desc: [
		"由下界荧石磨成，适合酿造，也适合更柔和的光源。",
		"做法：筛灵魂沙，或打浮台上的女巫。"
	]
	quest.4200000000020070.title: "荧石粉"
	quest.4200000000020071.quest_desc: [
		"不用朝树干挥斧，就能扯下树上的叶子。",
		"做法：四根木棍。砾歌者的摊位卖一把。"
	]
	quest.4200000000020071.title: "曲杖"
	quest.4200000000020072.quest_desc: [
		"从筛子里出来，越堆越多。每张网总是差一点。",
		"做法：拆开绽线（1 → 3）。蜘蛛。在回响缚结处用织机绒絮。纱的反向消耗。"
	]
	quest.4200000000020072.title: "线"
	quest.4200000000020073.quest_desc: [
		"结的黏合剂——或是浮台堆肥配方。",
		"做法：两份泥土 + 小麦种子 + 骨粉（浮台堆肥），或 /clowder hub 浮台看守。"
	]
	quest.4200000000020073.title: "粘液球"
	quest.4200000000020074.quest_desc: [
		"磨成骨粉，或整根留着，好繁殖狼群里的下一只。",
		"做法：夜里的骷髅，或 /clowder hub 浮台看守（16丝线换8个）。"
	]
	quest.4200000000020074.title: "骨头"
	quest.4200000000020075.quest_desc: [
		"味苦，还带一点毒。酿药的人用它，没人就这么吃。",
		"做法：夜里浮台上的蜘蛛。"
	]
	quest.4200000000020075.title: "蜘蛛眼"
	quest.4200000000020076.quest_desc: [
		"纱、瓷器、能用的织机架、箱子里的铁。",
		"给丝缕加上张力：砾歌者会回应。",
		"领取它，并从部落选一份礼物：一根归返丝线，多一条共享的命，或者物资。",
		"做法：完成与此相连的任务，再领取丝缕令牌。把令牌安放到你的张力柱上。"
	]
	quest.4200000000020076.quest_subtitle: "回收"
	quest.4200000000020076.title: "石之结"
	quest.4200000000020077.quest_desc: [
		"拿着令牌右键你的 Clowder 的张力柱。",
		"刻槽亮起，部落鸣响，浮台改变。",
		"做法：手里拿着丝缕令牌，右键你的张力柱。"
	]
	quest.4200000000020077.title: "安放石"
	quest.4200000000020078.quest_desc: [
		"苦力怕，解决了。火药比那一下惊吓值钱。",
		"做法：杀死三只苦力怕。火药是奖励。"
	]
	quest.4200000000020078.title: "轰，以后"
	quest.4200000000030079.quest_desc: [
		"在浮台上划出垄沟。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：两块铁锭放在一根木棍上面。"
	]
	quest.4200000000030079.title: "铁锄"
	quest.420000000003007A.quest_desc: [
		"面包是基础设施。三十二个小麦是一片田，不是一小畦。",
		"做法：耕地撒上小麦种子，再上骨粉。种子来自破坏草丛，或初始箱子。"
	]
	quest.420000000003007A.title: "麦田"
	quest.420000000003007B.quest_desc: [
		"种你要吃的。",
		"做法：破坏草丛，或用燧石网筛泥土。种在耕地上；骨粉会催熟第一片田。"
	]
	quest.420000000003007B.title: "种子袋"
	quest.420000000003007C.quest_desc: [
		"快，是好意。堆肥，还有骨头。",
		"做法：骨头摆进合成格，或丝线 + 腐肉消耗，或 /clowder hub 浮台看守。"
	]
	quest.420000000003007C.title: "骨粉引擎"
	quest.420000000003007D.quest_desc: [
		"准备收获。",
		"做法：在 JEI 里制作 Farmer's Delight（工作台、砧板或烹饪锅）。作物种子来自筛泥土。"
	]
	quest.420000000003007D.title: "农夫刀"
	quest.420000000003007E.quest_desc: [
		"厨房从这里开始。",
		"做法：在 JEI 里制作 Farmer's Delight（工作台、砧板或烹饪锅）。作物种子来自筛泥土。"
	]
	quest.420000000003007E.title: "砧板"
	quest.420000000003007F.quest_desc: [
		"热饭喂饱的，不只是肚子。",
		"做法：在 JEI 里制作 Farmer's Delight（工作台、砧板或烹饪锅）。作物种子来自筛泥土。"
	]
	quest.420000000003007F.title: "烹饪锅"
	quest.4200000000030080.quest_desc: [
		"长成齐整的菜头，煮进菜里比生吃好。",
		"做法：在 JEI 里制作 Farmer's Delight（工作台、砧板或烹饪锅）。作物种子来自筛泥土。"
	]
	quest.4200000000030080.title: "卷心菜"
	quest.4200000000030081.quest_desc: [
		"顺着自己的棚架往上爬，熟成红色。酱从这里开始。",
		"做法：在 JEI 里制作 Farmer's Delight（工作台、砧板或烹饪锅）。作物种子来自筛泥土。"
	]
	quest.4200000000030081.title: "番茄"
	quest.4200000000030082.quest_desc: [
		"喜悦的泪。",
		"做法：在 JEI 里制作 Farmer's Delight（工作台、砧板或烹饪锅）。作物种子来自筛泥土。"
	]
	quest.4200000000030082.title: "洋葱"
	quest.4200000000030083.quest_desc: [
		"精华种植开始。第一排要十六个。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"种子的脊梁。筛出来，或者种出来。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"从精华中升起种子。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030085.title: "注魔祭坛"
	quest.4200000000030086.quest_desc: [
		"祭坛四周放四个。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030086.title: "注魔基座"
	quest.4200000000030087.quest_desc: [
		"再长出一些浮台。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030087.title: "泥土种子"
	quest.4200000000030088.quest_desc: [
		"不用斧也能长出树冠。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030088.title: "木头种子"
	quest.4200000000030089.quest_desc: [
		"种出来的，不是挖出来的。别挥镐，去收精华。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030089.title: "石种子"
	quest.420000000003008A.quest_desc: [
		"从作物得到金属。回收的第二台引擎。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.420000000003008A.title: "铁种子"
	quest.420000000003008B.quest_desc: [
		"这种作物产出铜精华，而不是铜矿石。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.420000000003008B.title: "铜种子"
	quest.420000000003008C.quest_desc: [
		"一种镀金作物，就在浮台上长出金精华。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.420000000003008C.title: "金种子"
	quest.420000000003008D.quest_desc: [
		"把耕地变成燃料来源，不必挖矿。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.420000000003008D.title: "煤炭种子"
	quest.420000000003008E.quest_desc: [
		"从作物装来的瓶中雨。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.420000000003008E.title: "水种子"
	quest.420000000003008F.quest_desc: [
		"给小浮台的紧凑种植。",
		"做法：在 JEI 里找陶瓦 Botany Pot。盆中放泥土 + 种子；骨粉仍然有用。"
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"会自己收获的盆。",
		"做法：在 JEI 里找漏斗 Botany Pot。放在箱子/漏斗上，自己收获。"
	]
	quest.4200000000030090.title: "漏斗花盆"
	quest.4200000000030091.quest_desc: [
		"升一档。种子变得更贪，也更好。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"更深一档的作物精华，比你起初的种子更强。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"九份骨粉合成一块。给引擎的储存。",
		"做法：九份骨粉。骨头来自骷髅或浮台看守。"
	]
	quest.4200000000030093.title: "骨块"
	quest.4200000000030094.quest_desc: [
		"萌芽的余量，叠放。",
		"做法：九个小麦。三个小麦也能做面包。"
	]
	quest.4200000000030094.title: "干草筒仓"
	quest.4200000000030095.quest_desc: [
		"更好的耕地。缚根者会点头。",
		"做法：放上有机堆肥然后等待；它会慢慢熟成肥沃土壤。"
	]
	quest.4200000000030095.title: "肥沃土壤"
	quest.4200000000030096.quest_desc: [
		"去喂养养活你的土壤。",
		"做法：在 JEI 里制作 Farmer's Delight（工作台、砧板或烹饪锅）。作物种子来自筛泥土。"
	]
	quest.4200000000030096.title: "有机堆肥"
	quest.4200000000030097.quest_desc: [
		"种下一行，喂马，或直接生吃。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000030097.title: "胡萝卜"
	quest.4200000000030098.quest_desc: [
		"主食作物：马铃薯。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000030098.title: "马铃薯"
	quest.4200000000030099.quest_desc: [
		"长得快，能染成红色。做汤、炖菜，或直接从地里吃。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000030099.title: "甜菜根"
	quest.420000000003009A.quest_desc: [
		"西瓜，供食用和交易。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000003009A.title: "西瓜"
	quest.420000000003009B.quest_desc: [
		"南瓜，供食用和装饰。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000003009B.title: "南瓜"
	quest.420000000003009C.quest_desc: [
		"纸和糖。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000003009C.title: "甘蔗"
	quest.420000000003009D.quest_desc: [
		"无水也能长，靠上去就会受伤。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000003009D.title: "仙人掌"
	quest.420000000003009E.quest_desc: [
		"窜得快，烧得旺。树少的浮台正好拿它当燃料。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000003009E.title: "竹子"
	quest.420000000003009F.quest_desc: [
		"建造时吃的浆果。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000003009F.title: "甜浆果"
	quest.42000000000300A0.quest_desc: [
		"长在丛林原木上，磨成给一切甜食调味的褐色。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000300A0.title: "可可"
	quest.42000000000300A1.quest_desc: [
		"到时候会从橡木树叶掉下来。免费的食物，迟早会有。",
		"做法：橡木树叶只掉几个；Pam's 的苹果树（铁网泥土出的树苗）结很多。"
	]
	quest.42000000000300A1.title: "苹果"
	quest.42000000000300A2.quest_desc: [
		"一个碗，不用工作台。懒农夫的晚饭。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000300A2.title: "蘑菇煲"
	quest.42000000000300A3.quest_desc: [
		"在与蜜蜂更深入的工作开始前，先尝一口蜂巢。",
		"做法：玻璃瓶对着满的蜂箱。下面放营火。"
	]
	quest.42000000000300A3.title: "蜂蜜瓶"
	quest.42000000000300A4.quest_desc: [
		"长在洞穴藤上，吃的时候照亮隧道。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000300A4.title: "发光浆果"
	quest.42000000000300A5.quest_desc: [
		"所有值得装瓶的药水的底料。只长在灵魂沙上。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000300A5.title: "下界疣"
	quest.42000000000300A6.quest_desc: [
		"一块田，一间厨房，精华上升。",
		"给丝缕上张力：缚根者回应。",
		"领取它，并从部落选一份礼物：一根归返丝线，多一条共享的命，或者物资。",
		"做法：完成与此相连的任务，再领取丝缕令牌。把令牌安放到你的张力柱上。"
	]
	quest.42000000000300A6.quest_subtitle: "根"
	quest.42000000000300A6.title: "萌芽结"
	quest.42000000000300A7.quest_desc: [
		"拿着令牌右键你的 Clowder 的张力柱。",
		"刻槽亮起，部落鸣响，浮台改变。",
		"做法：手里拿着丝缕令牌，右键你的张力柱。"
	]
	quest.42000000000300A7.title: "安放萌芽"
	quest.42000000000300A8.quest_desc: [
		"每个缚根者迟早都会拔出一颗。",
		"别吃。也别扔掉。",
		"做法：稀有的马铃薯收获。可选的萌芽秘密。"
	]
	quest.42000000000300A8.title: "错马铃薯"
	quest.42000000000400A9.quest_desc: [
		"按你的条件切开虚空。八张蓝图。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：四张纸和一份蓝色染料，无序合成。得到四张。"
	]
	quest.42000000000400A9.title: "蓝图纸"
	quest.42000000000400AA.quest_desc: [
		"盒子里的蓝图。",
		"四张蓝图纸，无序合成 — 领取浮台会清掉 Silent Gear 的加入赠礼。右键拆开初始蓝图。",
		"做法：四张蓝图纸，无序合成。右键拆开初始蓝图。领取浮台会清掉 Silent Gear 的加入赠礼。"
	]
	quest.42000000000400AA.title: "蓝图包"
	quest.42000000000400AB.quest_desc: [
		"在你装上零件之前，模块化工具由此开始的模板。",
		"做法：拆开蓝图包，或看 JEI。爪为工具线命名。"
	]
	quest.42000000000400AB.title: "杆蓝图"
	quest.42000000000400AC.quest_desc: [
		"塑一把比它的金属更耐久的镐。",
		"做法：拆开蓝图包，或看 JEI。爪为工具线命名。"
	]
	quest.42000000000400AC.title: "镐蓝图"
	quest.42000000000400AD.quest_desc: [
		"塑一把斧。",
		"做法：拆开蓝图包，或看 JEI。爪为工具线命名。"
	]
	quest.42000000000400AD.title: "斧蓝图"
	quest.42000000000400AE.quest_desc: [
		"塑一把铲。",
		"做法：拆开蓝图包，或看 JEI。爪为工具线命名。"
	]
	quest.42000000000400AE.title: "铲蓝图"
	quest.42000000000400AF.quest_desc: [
		"塑一把刃。",
		"做法：拆开蓝图包，或看 JEI。爪为工具线命名。"
	]
	quest.42000000000400AF.title: "剑蓝图"
	quest.42000000000400B0.quest_desc: [
		"还有生长的余地。",
		"做法：蓝图纸之后看 JEI。爪为升级线命名。"
	]
	quest.42000000000400B0.title: "升级基底"
	quest.42000000000400B1.quest_desc: [
		"三十二锭材料，用来做零件。",
		"做法：熔炼粗铁 / 铁砂砾（熔炉或余烬窑）。筛砾石取碎块。"
	]
	quest.42000000000400B1.title: "铁质块"
	quest.42000000000400B2.quest_desc: [
		"把刃口磨过单靠铁能到的地步。",
		"做法：用铁网或更好的网筛砾石，或用回声粉碎机处理钻石矿石。"
	]
	quest.42000000000400B2.title: "钻石尖"
	quest.42000000000400B3.quest_desc: [
		"树叶和羊毛，以后还有蜜脾。",
		"做法：两个铁锭斜放。剪羊和蜂巢。"
	]
	quest.42000000000400B3.title: "剪刀"
	quest.42000000000400B4.quest_desc: [
		"浮台有边。生物也有。",
		"做法：铁周围六块木板。副手格挡。"
	]
	quest.42000000000400B4.title: "盾牌"
	quest.42000000000400B5.quest_desc: [
		"故意熬过这一夜。",
		"做法：八个铁锭。烧炼筛砾。"
	]
	quest.42000000000400B5.title: "铁胸甲"
	quest.42000000000400B6.quest_desc: [
		"当心坠落。",
		"做法：五个铁锭。"
	]
	quest.42000000000400B6.title: "铁头盔"
	quest.42000000000400B7.quest_desc: [
		"先护住双腿。反正大部分伤害来自下面。",
		"做法：七个铁锭。"
	]
	quest.42000000000400B7.title: "铁护腿"
	quest.42000000000400B8.quest_desc: [
		"在一滑就是虚空的岩架上稳住你的脚步。",
		"做法：四个铁锭。"
	]
	quest.42000000000400B8.title: "铁靴子"
	quest.42000000000400B9.quest_desc: [
		"让虚空的生物离你远一点。",
		"做法：三根线和三根木棍。"
	]
	quest.42000000000400B9.title: "弓"
	quest.42000000000400BA.quest_desc: [
		"六十四个保持距离的理由。",
		"做法：燧石、木棍、羽毛。骷髅会多掉一些。"
	]
	quest.42000000000400BA.title: "箭束"
	quest.42000000000400BB.quest_desc: [
		"照亮穿行的路。",
		"做法：铁锭加燧石。"
	]
	quest.42000000000400BB.title: "打火石"
	quest.42000000000400BC.quest_desc: [
		"十个方块。一扇缘行者会认得的门。",
		"做法：水浇在熔岩源上（或熔岩浇在水上）。留下熔岩源。"
	]
	quest.42000000000400BC.title: "黑曜石框架"
	quest.42000000000400BD.quest_desc: [
		"落脚处的准备。别处是存在的。",
		"做法：末影珍珠（缘行者的摊位 / 末影人），加上爪的黑曜石之后从下界要塞取得的烈焰粉。八只眼的存货可选；末地水晶用同一种合成。"
	]
	quest.42000000000400BD.title: "末影之眼"
	quest.42000000000400BE.quest_desc: [
		"给硬工具的软力量。",
		"做法：两个钻石、四块黑曜石、书。钻石来自铁网砾石。"
	]
	quest.42000000000400BE.title: "附魔台"
	quest.42000000000400BF.quest_desc: [
		"修理并命名你携带的东西。",
		"做法：三个铁块放在四个锭上面。"
	]
	quest.42000000000400BF.title: "铁砧"
	quest.42000000000400C0.quest_desc: [
		"称它为你的。",
		"做法：钓鱼 / 稀有箱子，或 /clowder hub 的印刻者摊位（24丝线）。可选。"
	]
	quest.42000000000400C0.title: "命名牌"
	quest.42000000000400C1.quest_desc: [
		"模块化锄的起始模板，一件一件拼成。",
		"做法：拆开蓝图包，或 JEI。"
	]
	quest.42000000000400C1.title: "锄的蓝图"
	quest.42000000000400C2.quest_desc: [
		"一挥清掉一大片作物，而不是一株。",
		"做法：拆开蓝图包，或 JEI。"
	]
	quest.42000000000400C2.title: "镰刀蓝图"
	quest.42000000000400C3.quest_desc: [
		"一把能挖矿、砍树、掘土的工具。不用再在手里来回换。",
		"做法：拆开蓝图包，或 JEI。"
	]
	quest.42000000000400C3.title: "Paxel 蓝图"
	quest.42000000000400C4.quest_desc: [
		"一下敲碎三乘三的石头。",
		"做法：拆开蓝图包，或 JEI。"
	]
	quest.42000000000400C4.title: "锤的蓝图"
	quest.42000000000400C5.quest_desc: [
		"在泥土和沙子里开出宽坑，比任何铲子都快。",
		"做法：拆开蓝图包，或 JEI。"
	]
	quest.42000000000400C5.title: "挖掘蓝图"
	quest.42000000000400C6.quest_desc: [
		"小、快、准。为近身活计而造，不是为了打仗。",
		"做法：拆开蓝图包，或 JEI。"
	]
	quest.42000000000400C6.title: "刀的蓝图"
	quest.42000000000400C7.quest_desc: [
		"柔软的护片，容易附魔，价值在魔法而不在防御。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000400C7.title: "金甲部件"
	quest.42000000000400C8.quest_desc: [
		"海之爪。",
		"可选——虚空也许永远不会给你一个。",
		"做法：仅溺尸。可选。"
	]
	quest.42000000000400C8.title: "三叉戟"
	quest.42000000000400C9.quest_desc: [
		"装填慢，打得重，在你需要之前一直保持蓄力。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000400C9.title: "弩"
	quest.42000000000400CA.quest_desc: [
		"扫视虚空。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000400CA.title: "望远镜"
	quest.42000000000400CB.quest_desc: [
		"蓝图，背上的铁，一扇出去的门。",
		"给丝缕上张力：缘行者回应。辫织打开。",
		"领取它，并从部落选一份礼物：一根归返丝线，多一条共享的命，或者物资。",
		"做法：完成与此相连的任务，再领取丝缕令牌。把令牌安放到你的张力柱上。"
	]
	quest.42000000000400CB.quest_subtitle: "缘"
	quest.42000000000400CB.title: "爪结"
	quest.42000000000400CC.quest_desc: [
		"拿着令牌右键你的 Clowder 的张力柱。",
		"刻槽亮起，部落鸣响，浮台改变。",
		"做法：手里拿着丝缕令牌，右键你的张力柱。"
	]
	quest.42000000000400CC.title: "安放爪"
	quest.42000000000400CD.quest_desc: [
		"有个高个子回看了一眼。缘行者称他们为守门者。",
		"做法：杀死一只末影人。末影珍珠也可从缘行者的摊位得到。"
	]
	quest.42000000000400CD.title: "缘之缘"
	quest.42000000000500CE.quest_desc: [
		"低鸣之前的短信号。六十四份粉末。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：筛砾石，或在回收之后用回声粉碎机处理红石矿石。"
	]
	quest.42000000000500CE.title: "红石粉"
	quest.42000000000500CF.quest_desc: [
		"并行的热。八个是一排，不是一座熔炉。",
		"做法：八块圆石围住空的中心。"
	]
	quest.42000000000500CF.title: "熔炉阵列"
	quest.42000000000500D0.quest_desc: [
		"不用手，把砂砾移走。",
		"做法：五个铁围住箱子。把它放在织机架或张力桶下面（向下抽取）。"
	]
	quest.42000000000500D0.title: "漏斗线"
	quest.42000000000500D1.quest_desc: [
		"量一下节拍。",
		"做法：下界石英、红石火把、石头。石英从灵魂沙筛出；不必跑一趟下界。"
	]
	quest.42000000000500D1.title: "比较器"
	quest.42000000000500D2.quest_desc: [
		"骨头、线、紫水晶。第一拍。",
		"产出两个——留一个给灵之抄本。",
		"做法：一块骨头、线、紫水晶。/clowder hub 浮台看守卖骨头。火花 / 低鸣之门。"
	]
	quest.42000000000500D2.title: "低鸣：骨铃"
	quest.42000000000500D3.quest_desc: [
		"旧部族歌谣的一片碎片。需要一只铃。",
		"做法：骨铃、紫水晶和红石，无序。产出两个。"
	]
	quest.42000000000500D3.title: "低鸣：灵碎片"
	quest.42000000000500D4.quest_desc: [
		"铜围住铃：调向灵的金属。",
		"做法：铜围住骨铃。产出两个。"
	]
	quest.42000000000500D4.title: "低鸣：铜共鸣器"
	quest.42000000000500D5.quest_desc: [
		"敲它。稳住一股脉动。接线之前先听。",
		"两只铃、一块碎片、两份皮革、四块木板——/clowder hub 的浮台看守出售皮革。",
		"做法：两个骨铃、一块灵碎片、两份皮革和四块木板。空手按拍子敲（17–23 刻），得到 24 点脉动。"
	]
	quest.42000000000500D5.title: "低鸣：鼓心"
	quest.42000000000500D6.quest_desc: [
		"为工具、法术和旅行携带脉动——需要共鸣器 + 碎片。",
		"做法：先合成，再从鼓心灌满（用胞点击）。工具、法术和旅行都从胞里取用。"
	]
	quest.42000000000500D6.title: "低鸣：脉动胞"
	quest.42000000000500D7.quest_desc: [
		"在开阔的天空下，把周围的地脉收成节拍。图腾之声会叠加；不必有鼓心。",
		"做法：放在天空下，靠近水/绿。脉动很慢。火花阶梯。"
	]
	quest.42000000000500D7.title: "低鸣：地脉收集器"
	quest.42000000000500D8.quest_desc: [
		"安放一个回声触媒（工作就会磨损），再加两个不同的元素图腾。营地唱出自己的力量；红石会暂停这和声。",
		"做法：安放一个回声触媒，8格内放两个不同的图腾。红石会让它暂停。"
	]
	quest.42000000000500D8.title: "低鸣：脉动共鸣器"
	quest.42000000000500D9.quest_desc: [
		"一块 Forge 能量的缓冲——从脉动到电线的桥，如果你想要。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500D9.title: "Powah 起步电池"
	quest.42000000000500DA.quest_desc: [
		"烧燃料来得到 Forge 能量。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500DA.title: "Powah 燃烧器"
	quest.42000000000500DB.quest_desc: [
		"把能量往前送。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500DB.title: "Powah 线缆"
	quest.42000000000500DC.quest_desc: [
		"天空的能量，在一座全是天空的浮台上。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500DC.title: "起步太阳能板"
	quest.42000000000500DD.quest_desc: [
		"把温差烧成能量。一边喂热，另一边喂冷。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500DD.title: "温差发电机"
	quest.42000000000500DE.quest_desc: [
		"在一圈杆中给物品充能。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500DE.title: "充能宝珠"
	quest.42000000000500DF.quest_desc: [
		"给宝珠供能。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500DF.title: "充能杆"
	quest.42000000000500E0.quest_desc: [
		"一口袋存好的能量。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500E0.title: "电池"
	quest.42000000000500E1.quest_desc: [
		"就地转动机器，不必拆掉再放下。",
		"做法：Powah 电网章节——有了火花脉动之后，再做充能宝珠和线缆。"
	]
	quest.42000000000500E1.title: "扳手"
	quest.42000000000500E2.quest_desc: [
		"熔炼矿石的速度是普通熔炉的两倍，只熔矿石。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500E2.title: "高炉"
	quest.42000000000500E3.quest_desc: [
		"烤肉的速度是营火的两倍，只做食物。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500E3.title: "烟熏炉"
	quest.42000000000500E4.quest_desc: [
		"九块煤炭压得密实。一块方块比一整组碎块更耐烧。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500E4.title: "煤炭块（火花）"
	quest.42000000000500E5.quest_desc: [
		"一次把一件物品轻轻推进面前的东西里。",
		"做法：圆石围住红石。"
	]
	quest.42000000000500E5.title: "投掷器"
	quest.42000000000500E6.quest_desc: [
		"有目的地推。",
		"做法：圆石、弓和红石。"
	]
	quest.42000000000500E6.title: "发射器"
	quest.42000000000500E7.quest_desc: [
		"收到信号就把方块往前推，然后等下一个。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500E7.title: "活塞"
	quest.42000000000500E8.quest_desc: [
		"把方块推出去，信号一断就拉回来。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500E8.title: "粘性活塞"
	quest.42000000000500E9.quest_desc: [
		"侦测器读取节拍。",
		"做法：圆石、红石和下界石英。"
	]
	quest.42000000000500E9.title: "侦测器"
	quest.42000000000500EA.quest_desc: [
		"中继器给电路定时。",
		"做法：红石火把、红石、石头。管网这一章用它做时钟。"
	]
	quest.42000000000500EA.title: "中继器"
	quest.42000000000500EB.quest_desc: [
		"记下一次命中，信号强度看离中心有多近。",
		"做法：红石围住干草。干草是三份小麦。"
	]
	quest.42000000000500EB.title: "标靶"
	quest.42000000000500EC.quest_desc: [
		"把雷击从你的屋顶引开，并把电荷导入地下。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500EC.title: "避雷针"
	quest.42000000000500ED.quest_desc: [
		"该上电力了。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500ED.title: "时钟"
	quest.42000000000500EE.quest_desc: [
		"不用火把的光。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500EE.title: "铜灯"
	quest.42000000000500EF.quest_desc: [
		"有信号就亮，信号一停立刻灭。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500EF.title: "红石灯"
	quest.42000000000500F0.quest_desc: [
		"读取天空，发出随太阳起落的信号。",
		"做法：玻璃、下界石英、木台阶。"
	]
	quest.42000000000500F0.title: "阳光探测器"
	quest.42000000000500F1.quest_desc: [
		"用手把信号拨开或拨关。这是最老的开关。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F1.title: "拉杆"
	quest.42000000000500F2.quest_desc: [
		"按钮点出一下红石脉冲。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F2.title: "按钮"
	quest.42000000000500F3.quest_desc: [
		"比空气重的东西站上去，就发出信号。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F3.title: "压力板"
	quest.42000000000500F4.quest_desc: [
		"用线横拉过路，谁穿过去都能抓住。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F4.title: "绊线钩"
	quest.42000000000500F5.quest_desc: [
		"底下每种方块响一个音。鼓心从一排里听出一首歌。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F5.title: "音符盒"
	quest.42000000000500F6.quest_desc: [
		"给浮台提气的唱片机。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F6.title: "唱片机"
	quest.42000000000500F7.quest_desc: [
		"靠重力或一推就会滚。没有铁轨，就坐不成。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F7.title: "矿车"
	quest.42000000000500F8.quest_desc: [
		"跨过虚空的铁轨。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F8.title: "铁轨"
	quest.42000000000500F9.quest_desc: [
		"给矿车用的动力铁轨。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500F9.title: "动力铁轨"
	quest.42000000000500FA.quest_desc: [
		"读取经过的矿车，碾过去时发出信号。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000000500FA.title: "探测铁轨"
	quest.42000000000500FB.quest_desc: [
		"备用太阳能合成。",
		"做法：三块玻璃、三块青金石、三面镜子，各排一行。"
	]
	quest.42000000000500FB.title: "Solar Flux 电池"
	quest.42000000000500FC.quest_desc: [
		"简单的物品管道。",
		"做法：铁 + 红石。用 Pipez 扳手调好各面。"
	]
	quest.42000000000500FC.title: "Pipez 物品"
	quest.42000000000500FD.quest_desc: [
		"简单的流体管道。",
		"做法：铁 + 桶 + 红石。在一侧潜行使用扳手以抽出；右键那一侧设置过滤。"
	]
	quest.42000000000500FD.title: "Pipez 流体"
	quest.42000000000500FE.quest_desc: [
		"机器之间的普通能量管。",
		"做法：铁 + 红石。在机器之间输送 FE。"
	]
	quest.42000000000500FE.title: "Pipez 能量"
	quest.42000000000500FF.quest_desc: [
		"设定管子哪几面从机器抽取，或关掉一面，不用拆管子。",
		"做法：两个燧石、两根木棍。在机器旁对管子的一面潜行使用，让它抽取，再来一次就关掉；右键正在抽取的一面设置过滤。"
	]
	quest.42000000000500FF.title: "Pipez 扳手"
	quest.4200000000050100.quest_desc: [
		"标出格子的线——需要一块灵碎片。",
		"做法：两份骨粉、青金石和一块灵碎片，无序合成。产出四个。"
	]
	quest.4200000000050100.title: "仪式粉笔"
	quest.4200000000050101.quest_desc: [
		"敲过的鼓，握住的脉动，安放的共鸣器。",
		"给丝缕加上张力：鼓心回应。",
		"领取它，并从部落选一份礼物：一根归返丝线，多一条共享的命，或者物资。",
		"做法：完成与此相连的任务，再领取丝缕令牌。把令牌安放到你的张力柱上。"
	]
	quest.4200000000050101.quest_subtitle: "低鸣"
	quest.4200000000050101.title: "火花结"
	quest.4200000000050102.quest_desc: [
		"拿着令牌右键你的 Clowder 的张力柱。",
		"刻槽亮起，部落鸣响，浮台改变。",
		"做法：手里拿着丝缕令牌，右键你的张力柱。"
	]
	quest.4200000000050102.title: "安放火花"
	quest.4200000000050103.quest_desc: [
		"沿着部族编织，经回声精炼，直到共鸣核心。谐能激发器把营地的和谐变成 FE，供这一章的机器使用。无等级时转换是每秒 60 脉动；在回声站点提升等级可以更多。它不能接收 FE。红石会同时暂停转换和输出。",
		"做法：五个铜锭、三个红石，和一枚共鸣核心。"
	]
	quest.4200000000050103.title: "嗡鸣成了电流"
	quest.4200000000050104.quest_desc: [
		"一个女巫，在你的浮台上，夜里。鼓没有警告你。",
		"做法：夜里在浮台上杀死一名女巫。"
	]
	quest.4200000000050104.title: "瓶中麻烦"
	quest.4200000000060105.quest_desc: [
		"你睡着时还在干活的手。三十二。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：安山岩 + 铁粒，在工作台（或搅拌机）里。"
	]
	quest.4200000000060105.title: "安山岩合金"
	quest.4200000000060106.quest_desc: [
		"旋转的脊骨。",
		"做法：安山岩合金，用 JEI 列出的切割配方 / 合成。"
	]
	quest.4200000000060106.title: "传动轴"
	quest.4200000000060107.quest_desc: [
		"一个齿轮。然后再来同一个齿轮。",
		"做法：传动轴 + 木板。"
	]
	quest.4200000000060107.title: "齿轮"
	quest.4200000000060108.quest_desc: [
		"齿更多，转更慢。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.4200000000060108.title: "大齿轮"
	quest.4200000000060109.quest_desc: [
		"安山岩机壳是 Create 的框架。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.4200000000060109.title: "安山岩机壳"
	quest.420000000006010A.quest_desc: [
		"天上一道河，转着。",
		"做法：八块木板围着一根传动轴。旁边要有水流。"
	]
	quest.420000000006010A.title: "水车"
	quest.420000000006010B.quest_desc: [
		"别的东西都还没转时，用手产生旋转。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.420000000006010B.title: "手摇曲柄"
	quest.420000000006010C.quest_desc: [
		"不用锤子，把砾石磨成粉。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.420000000006010C.title: "磨盘"
	quest.420000000006010D.quest_desc: [
		"搅拌盆承接 Create 的混合。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.420000000006010D.title: "搅拌盆"
	quest.420000000006010E.quest_desc: [
