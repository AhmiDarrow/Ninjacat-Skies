	chapter.310000000000002B.chapter_subtitle: [
		"旧世界的碎片漂上你的浮台。在它们散开之前抵达。"
	]
	chapter.310000000000002B.title: "漂流残骸"
	quest.42000000002B0801.quest_desc: [
		"土壤加上张力之后，旧世界的碎片会不时漂上你的浮台，并挂在你的纬线上。有一处到来时，执事会告诉整个 Clowder。",
		"它们不会久留：残骸会按你的 Clowder 的在线时间撑一会儿，然后散回虚空。没有人坠落，你得到的东西也不会丢失。"
	]
	quest.42000000002B0801.title: "漂来的东西"
	quest.42000000002B0802.quest_desc: [
		"站在你的浮台边缘，面向残骸，使用系索线轴：一座丝线桥会自行架过去，以半步向上爬。",
		"掉下去，丝线会接住你，代价是三颗心。虚空是风景，不是惩罚。"
	]
	quest.42000000002B0802.title: "跨越虚空"
	quest.42000000002B0803.quest_desc: [
		"每处残骸只要求一件事：打开它的心脏箱子，打碎刷怪笼，给柱子重新穿线，把回声护送回家，或守住接缝。",
		"做完之后，凡是踏上它的人都得到回收的纬线和一枚印。打捞者框架把纬线变成线轴、诱饵、钥匙和装饰。"
	]
	quest.42000000002B0803.title: "打捞"
	quest.42000000002B0804.quest_desc: [
		"残骸图册记下你完成的每个部族的地点：九条丝缕乘六种地点。满一列、满一行、集齐戳记：各自给出一份小小的永久增益。",
		"书页带着抄本中的传说。在箱子里找到的提示页会打开隐藏房间。打开残骸图册即可勾掉这项。"
	]
	quest.42000000002B0804.title: "图册"
	quest.42000000002B0805.quest_desc: [
		"带来五枚漂流残骸印：五处残骸已完成，由你的 Clowder 里的任何人完成。",
		"可重复：想交多少次就交多少次。",
		"做法：完成一处漂流残骸的任务。凡是踏上它的人都得到一枚印。"
	]
	quest.42000000002B0805.title: "五枚印"
	quest.42000000002B0806.quest_desc: [
		"打碎三个绽开刷怪笼，并上交它们的核心。",
		"可重复：想交多少次就交多少次。",
		"做法：在漂流残骸上打碎一个绽开刷怪笼；每个都会掉下核心。"
	]
	quest.42000000002B0806.title: "绽开核心"
	quest.42000000002B0807.quest_desc: [
		"来自已织补残响的一块碎片。把它交上。",
		"可重复：想交多少次就交多少次。",
		"做法：用纬线钥匙打开一处要塞的封印裂隙，并织补里面的残响。"
	]
	quest.42000000002B0807.title: "裂隙碎片"
	quest.42000000002B0808.quest_desc: [
		"一条丝缕的每个核心。该部族的诱饵半价，它的残骸来得更勤一些，旗帜归你。"
	]
	quest.42000000002B0808.title: "一整列"
	quest.42000000002B0809.quest_desc: [
		"全部九个部族里的同一种地点。它的隐藏房间现在始终开启。"
	]
	quest.42000000002B0809.title: "一整行"
	quest.42000000002B080A.quest_desc: [
		"每种修正都完成一处残骸。你的残骸会多留四分之一。"
	]
	quest.42000000002B080A.title: "六枚戳记"
	quest.42000000002B080B.quest_desc: [
		"填满了二十五页。"
	]
	quest.42000000002B080B.title: "图册过半"
	quest.42000000002B080C.quest_desc: [
		"为那处残骸的丝缕切削的纬线钥匙，能打开一处要塞的封印裂隙。里面有一个又小又绽开的东西，披着守护者的外形。"
	]
	quest.42000000002B080C.title: "进入裂隙"
	quest.42000000002B080D.quest_desc: [
		"织补全部九个残响。纬线钥匙半价。"
	]
	quest.42000000002B080D.title: "所有残响"
	quest.42000000002B080E.quest_desc: [
		"全部五十四页。在 Skies 之下的某处，旧世界的心脏开始向你漂来。"
	]
	quest.42000000002B080E.title: "每一页"
	quest.42000000002B080F.quest_desc: [
		"站在旧世界的心脏里，给它重新穿线。它不会来第二次。"
	]
	quest.42000000002B080F.title: "织物之心"
}
