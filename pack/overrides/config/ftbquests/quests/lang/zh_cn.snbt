	]
	quest.42000000001903A8.title: "加热离心机"
	quest.42000000001903A9.quest_desc: [
		"把蜜蜂幼虫孵成带有用性状的新蜜蜂。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903A9.title: "孵化器（蜂场）"
	quest.42000000001903AA.quest_desc: [
		"把两只蜜蜂配成一对，产出性状混合的后代。",
