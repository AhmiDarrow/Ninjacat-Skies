	quest.420000000018035B.title: "Tertium 加速器"
	quest.420000000018035C.quest_desc: [
		"接近生长速度的上限。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
