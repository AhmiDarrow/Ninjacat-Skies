	quest.42000000001F04D4.title: "物品保险库（封装）"
	quest.42000000002004D5.quest_desc: [
		"给 QIO 网络用的基础量子存储盘。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004D5.title: "QIO 驱动器基座"
	quest.42000000002004D6.quest_desc: [
		"在一块量子盘上塞进多得多的存储。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004D6.title: "QIO 超密"
	quest.42000000002004D7.quest_desc: [
		"一块拿容量换原始密度的量子盘。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004D7.title: "QIO 时间膨胀"
	quest.42000000002004D8.quest_desc: [
		"Mekanism 造出的最大量子盘。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004D8.title: "QIO 超大质量"
	quest.42000000002004D9.quest_desc: [
