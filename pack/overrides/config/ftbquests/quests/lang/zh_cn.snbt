	quest.420000000018034F.title: "Imperium 储备"
	quest.4200000000180350.quest_desc: [
		"第五阶精华，精炼几乎到头了。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000180350.title: "Supremium 储备"
	quest.4200000000180351.quest_desc: [
		"精炼的顶峰。最强的装备和种子都离不开它。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000180351.title: "觉醒精华"
	quest.4200000000180352.quest_desc: [
