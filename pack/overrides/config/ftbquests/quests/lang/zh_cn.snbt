	]
	quest.42000000001903AB.title: "基因索引器（蜂场）"
	quest.42000000001903AC.quest_desc: [
		"烧掉蜂蜜，换一缕又慢又稳的能量。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903AC.title: "蜂蜜发电机（蜂场）"
	quest.42000000001903AD.quest_desc: [
		"一份点心，让笼里的蜜蜂保持平静和健康。",
		"做法：蜜脾加蜂蜜瓶，无序合成。"
	]
	quest.42000000001903AD.title: "蜂蜜点心（蜂场）"
	quest.42000000001903AE.quest_desc: [
		"满满一桶蜂蜜，可以倒，也可以烧。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903AE.title: "蜂蜜桶"
	quest.42000000001903AF.quest_desc: [
		"可以融化做蜡烛，也可以封住蜂箱的框。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903AF.title: "蜂蜡备料"
	quest.42000000001903B0.quest_desc: [
		"一块可以调成匹配任何蜜蜂的蜜脾。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903B0.title: "可配置蜜脾"
	quest.42000000001903B1.quest_desc: [
		"一只蜜蜂的性状，已经取出，可以装瓶。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903B1.title: "基因样本"
	quest.42000000001903B2.quest_desc: [
		"一只蜜蜂的遗传，留着以后配种。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903B2.title: "基因瓶"
	quest.42000000001903B3.quest_desc: [
		"四块蜜脾压成实心，多半用来建造。",
		"做法：四块蜜脾。"
	]
	quest.42000000001903B3.title: "蜜脾块"
	quest.42000000001903B4.quest_desc: [
		"减缓下落和移动。脚下发黏，进了漏斗却是甜的。",
		"做法：四个蜂蜜瓶。瓶子会还回来。"
	]
	quest.42000000001903B4.title: "蜜块（蜂场）"
	quest.42000000001903B5.quest_desc: [
		"一座野生蜂箱。取蜜脾之前，先用烟把它熏安静。",
		"做法：三个蜜脾和六块木板。下面的营火能让它们冷静。"
	]
	quest.42000000001903B5.title: "原版蜂箱"
	quest.42000000001903B6.quest_desc: [
		"从下面来的烟，能让蜜蜂在收获时保持安静。",
		"做法：原木、木棍，以及煤炭或木炭。"
	]
	quest.42000000001903B6.title: "下方营火"
	quest.42000000001903B7.quest_desc: [
		"给蜜蜂干活用的花。",
		"做法：给草施骨粉，或一朵小花给橡木巢。"
	]
	quest.42000000001903B7.title: "花毯"
	quest.42000000001903B8.quest_desc: [
		"附近的花越多，蜂箱得到的花粉就越多。",
		"做法：给草施骨粉。蜜蜂想要任何小花。"
	]
	quest.42000000001903B8.title: "蒲公英田"
	quest.42000000001903B9.quest_desc: [
		"更显眼的花，有些蜜蜂比蒲公英更喜欢它。",
		"做法：苔藓加橡木，或者给苔藓用骨粉。蜜蜂认这朵花。"
	]
	quest.42000000001903B9.title: "杜鹃花"
	quest.42000000001903BA.quest_desc: [
		"末地的一种果实，有些蜜蜂会乐意去采。",
		"做法：/clowder hub 的缘行者摊位。末地外岛已经没了。"
	]
	quest.42000000001903BA.title: "紫颂点心"
	quest.42000000001903BB.quest_desc: [
		"少数更结实的蜜蜂的怪癖最爱。",
		"做法：水浇在熔岩源上（或熔岩浇在水上）。留下熔岩源。"
	]
	quest.42000000001903BB.title: "黑曜石点心"
	quest.42000000001903BC.quest_desc: [
		"给蜂箱多加的房间，这次是白桦切的。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903BC.title: "白桦扩建"
	quest.42000000001903BD.quest_desc: [
		"云杉镶板的房间，用螺栓固定在蜂箱上。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903BD.title: "云杉扩建"
	quest.42000000001903BE.quest_desc: [
		"深色橡木镶板，用途一样：给蜜蜂多加房间。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903BE.title: "深色橡木扩建"
	quest.42000000001903BF.quest_desc: [
		"金合欢房间，给已经装不下自己的蜂箱。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903BF.title: "金合欢扩建"
	quest.42000000001903C0.quest_desc: [
		"丛林木的房间，和其他的一样宽敞。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903C0.title: "丛林扩建"
	quest.42000000001903C1.quest_desc: [
		"樱花木镶板的房间，纯粹是风格问题。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903C1.title: "樱花扩建"
	quest.42000000001903C2.quest_desc: [
		"绯红镶板的房间，给一座跑去下界的蜂箱。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903C2.title: "绯红扩建"
	quest.42000000001903C3.quest_desc: [
		"诡异木镶板的房间，一对里蓝色的那一半。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903C3.title: "诡异扩建"
	quest.42000000001903C4.quest_desc: [
		"竹房间，更轻，一样好用。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903C4.title: "竹扩建"
	quest.42000000001903C5.quest_desc: [
		"红树房间，名单上最新的木材。",
		"做法：Productive Bees 的合成在 JEI 里。群为蜂箱、离心机和繁育步骤命名。"
	]
	quest.42000000001903C5.title: "红树扩建"
	quest.42000000001903C6.quest_desc: [
		"可以直接对着瓶子喝的蜂蜜。",
		"做法：玻璃瓶对着满的蜂箱。下面放营火。"
	]
	quest.42000000001903C6.title: "蜂蜜瓶储备"
	quest.42000000001903C7.quest_desc: [
		"做成点心和蛋糕，给饿着的 Clowder。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000001903C7.title: "糖储备"
	quest.42000000001903C8.quest_desc: [
		"空着，等着装蜂蜜、药水或经验。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.42000000001903C8.title: "玻璃瓶储备"
	quest.42000000001903C9.quest_desc: [
		"备用的一把，剪蜜脾时不伤到蜜蜂。",
		"做法：两个铁锭斜放。剪羊和蜂巢。"
	]
	quest.42000000001903C9.title: "备用剪刀"
	quest.42000000001A03CA.quest_desc: [
		"一块方块，把物品送到你说的地方——浮台的神经系统。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：空白模块四周放铁锭和铁栏杆，得到四个。模块装进路由器。"
	]
	quest.42000000001A03CA.title: "模块路由器"
	quest.42000000001A03CB.quest_desc: [
		"路由器的每一种行为都写在这张卡上。",
		"做法：在 JEI 里查模块路由器和空白模块。拉取/发送/破坏装进路由器。"
	]
	quest.42000000001A03CB.title: "空白模块"
	quest.42000000001A03CC.quest_desc: [
		"从相邻方块把物品拉进路由器。",
		"做法：在 JEI 里查模块路由器和空白模块。拉取/发送/破坏装进路由器。"
	]
	quest.42000000001A03CC.title: "抽取模块"
	quest.42000000001A03CD.quest_desc: [
		"把物品推到浮台另一头标记的位置。",
		"做法：在 JEI 里查模块路由器和空白模块。拉取/发送/破坏装进路由器。"
	]
	quest.42000000001A03CD.title: "发送模块"
	quest.42000000001A03CE.quest_desc: [
		"破坏路由器前方的方块，把掉落物留下。",
		"做法：在 JEI 里查模块路由器和空白模块。拉取/发送/破坏装进路由器。"
	]
	quest.42000000001A03CE.title: "破坏模块"
	quest.42000000001A03CF.quest_desc: [
		"在路由器所指的地方放下方块。",
		"做法：在 JEI 里查模块路由器和空白模块。拉取/发送/破坏装进路由器。"
	]
	quest.42000000001A03CF.title: "放置模块"
	quest.42000000001A03D0.quest_desc: [
		"路由器里的东西越过阈值时，发出红石信号。",
		"做法：在 JEI 里查模块路由器和空白模块。拉取/发送/破坏装进路由器。"
	]
	quest.42000000001A03D0.title: "探测模块"
	quest.42000000001A03D1.quest_desc: [
		"在箱子、机器和浮台之间运送物品。",
		"做法：铁 + 红石。用 Pipez 扳手调好各面。"
	]
	quest.42000000001A03D1.title: "物品管道"
	quest.42000000001A03D2.quest_desc: [
		"在储罐和机器之间送液体，不用提着桶来回跑。",
		"做法：铁 + 桶 + 红石。在一侧潜行使用扳手以抽出；右键那一侧设置过滤。"
	]
	quest.42000000001A03D2.title: "流体管道"
	quest.42000000001A03D3.quest_desc: [
		"在产能的机器和用电的机器之间输送能量。",
		"做法：铁 + 红石。在机器之间输送 FE。"
	]
	quest.42000000001A03D3.title: "能量管道"
	quest.42000000001A03D4.quest_desc: [
		"在处理它们的机器之间输送化学物质。",
		"做法：在 JEI 里找铁 + 红石管道。潜行使用扳手设定抽取面；右键其中一面设过滤器。管网这一章是整条阶梯。"
	]
	quest.42000000001A03D4.title: "气体管道"
	quest.42000000001A03D5.quest_desc: [
		"一根管子，干很多活。",
		"做法：在 JEI 里找铁 + 红石管道。潜行使用扳手设定抽取面；右键其中一面设过滤器。管网这一章是整条阶梯。"
	]
	quest.42000000001A03D5.title: "通用管道"
	quest.42000000001A03D6.quest_desc: [
		"潜行使用管子的一面，让它从机器抽取，或把那一面关掉。",
		"做法：两个燧石、两根木棍。在机器旁对管子的一面潜行使用，让它抽取，再来一次就关掉；右键正在抽取的一面设置过滤。"
	]
	quest.42000000001A03D6.title: "管道扳手"
	quest.42000000001A03D7.quest_desc: [
		"管子用的速度升级。",
		"做法：在 JEI 里找铁 + 红石管道。潜行使用扳手设定抽取面；右键其中一面设过滤器。管网这一章是整条阶梯。"
	]
	quest.42000000001A03D7.title: "基础升级"
	quest.42000000001A03D8.quest_desc: [
		"插进管子里，每刻运送更多。",
		"做法：在 JEI 里找铁 + 红石管道。潜行使用扳手设定抽取面；右键其中一面设过滤器。管网这一章是整条阶梯。"
	]
	quest.42000000001A03D8.title: "改良升级"
	quest.42000000001A03D9.quest_desc: [
		"更强一级的升级，给负担很重的管线。",
		"做法：在 JEI 里找铁 + 红石管道。潜行使用扳手设定抽取面；右键其中一面设过滤器。管网这一章是整条阶梯。"
	]
	quest.42000000001A03D9.title: "高级升级"
	quest.42000000001A03DA.quest_desc: [
		"Pipez 通量的最高一档。",
		"做法：在 JEI 里找铁 + 红石管道。潜行使用扳手设定抽取面；右键其中一面设过滤器。管网这一章是整条阶梯。"
	]
	quest.42000000001A03DA.title: "终极升级"
	quest.42000000001A03DB.quest_desc: [
		"去掉 Pipez 的速率上限。",
		"做法：仅创造模式；Pipez 没有生存配方。可选。"
	]
	quest.42000000001A03DB.title: "无限升级"
	quest.42000000001A03DC.quest_desc: [
		"设定管子一端接受或忽略哪些物品。",
		"做法：在 JEI 里找铁 + 红石管道。潜行使用扳手设定抽取面；右键其中一面设过滤器。管网这一章是整条阶梯。"
	]
	quest.42000000001A03DC.title: "过滤工具"
	quest.42000000001A03DD.quest_desc: [
		"最早的搬运工。慢，便宜，却总有用。",
		"做法：五个铁围住箱子。把它放在织机架或张力桶下面（向下抽取）。"
	]
	quest.42000000001A03DD.title: "备用漏斗（管网）"
	quest.42000000001A03DE.quest_desc: [
		"用于物流的投掷器列。",
		"做法：圆石围住红石。"
	]
	quest.42000000001A03DE.title: "投掷器列"
	quest.42000000001A03DF.quest_desc: [
		"收到信号就发射或放下装好的东西。",
		"做法：圆石、弓和红石。"
	]
	quest.42000000001A03DF.title: "发射器列"
	quest.42000000001A03E0.quest_desc: [
		"读取容器有多满，并输出信号。",
		"做法：下界石英、红石火把、石头。石英从灵魂沙筛出；不必跑一趟下界。"
	]
	quest.42000000001A03E0.title: "比较器（管网）"
	quest.42000000001A03E1.quest_desc: [
		"侦测器读取节拍。",
		"做法：圆石、红石和下界石英。"
	]
	quest.42000000001A03E1.title: "侦测器列"
	quest.42000000001A03E2.quest_desc: [
		"一个一直开着的信号源，或是拉杆旁边的反相器。",
		"做法：木棍上放红石。"
	]
	quest.42000000001A03E2.title: "红石火把"
	quest.42000000001A03E3.quest_desc: [
		"中继器给电路定时。",
		"做法：红石火把、红石、石头。管网这一章用它做时钟。"
	]
	quest.42000000001A03E3.title: "中继器（管网）"
	quest.42000000001A03E4.quest_desc: [
		"被弹射物击中后，按力度发出信号。",
		"做法：红石围住干草。干草是三份小麦。"
	]
	quest.42000000001A03E4.title: "标靶"
	quest.42000000001A03E5.quest_desc: [
		"读取天空，按光或时间发信号。",
		"做法：玻璃、下界石英、木台阶。"
	]
	quest.42000000001A03E5.title: "阳光探测器（管网）"
	quest.42000000001A03E6.quest_desc: [
		"托着一本书，翻页时发出信号。",
		"做法：书架周围放木台阶。"
	]
	quest.42000000001A03E6.title: "讲台（管网）"
	quest.42000000001A03E7.quest_desc: [
		"开着就发信号，像装着绊线的箱子。",
		"做法：绊线钩再加一个箱子。"
	]
	quest.42000000001A03E7.title: "陷阱箱"
	quest.42000000001A03E8.quest_desc: [
		"看朝向，给传送带装货，或从上面拉下物品。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001A03E8.title: "Create 漏斗"
	quest.42000000001A03E9.quest_desc: [
		"能过滤所运物品的漏斗。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001A03E9.title: "黄铜漏斗"
	quest.42000000001A03EA.quest_desc: [
		"让物品在楼层之间笔直往下掉。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001A03EA.title: "溜槽（管网）"
	quest.42000000001A03EB.quest_desc: [
		"能过滤并拦住物品的溜槽。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001A03EB.title: "智能溜槽"
	quest.42000000001A03EC.quest_desc: [
		"分拣并运送物品，每一面都能设优先级。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000001A03EC.title: "Mek 物流"
	quest.42000000001A03ED.quest_desc: [
		"用压力输送流体，往上和往下一样轻松。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000001A03ED.title: "Mek 管道"
	quest.42000000001A03EE.quest_desc: [
		"在机器之间输送能量，有好几档通量。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000001A03EE.title: "Mek 线缆"
	quest.42000000001A03EF.quest_desc: [
		"通过密封管线输送化学物质和气体。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000001A03EF.title: "Mek 导管"
	quest.42000000001A03F0.quest_desc: [
		"一条更快的管线，用来在忙碌的浮台上运物品。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000001A03F0.title: "高级传输器"
	quest.42000000001A03F1.quest_desc: [
		"还要更快，给已经超出基础的网络。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000001A03F1.title: "精英传输器"
	quest.42000000001A03F2.quest_desc: [
		"现有最快的物品管线，给拉满的浮台。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000001A03F2.title: "终极传输器"
	quest.42000000001A03F3.quest_desc: [
		"通量最高的能量管线，给重型机械室。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000001A03F3.title: "终极线缆"
	quest.42000000001B03F4.quest_desc: [
		"列出你能束缚的每一种灵，以及它需要什么。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：一本书和恶魔之梦种子，无序合成。读它；下一步是灵火。"
	]
	quest.42000000001B03F4.title: "灵之辞典"
	quest.42000000001B03F5.quest_desc: [
		"燃着紫色，从不蔓延。用来点亮仪式。",
		"做法：按灵魂词典所示点燃灵火（烧起来了！），再把安山岩丢进去。"
	]
	quest.42000000001B03F5.title: "灵火（异界）"
	quest.42000000001B03F6.quest_desc: [
		"指向附近埋着的矿石或隐藏的结构。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03F6.title: "占卜杖"
	quest.42000000001B03F7.quest_desc: [
		"你做完后，把地上的仪式粉笔擦掉。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03F7.title: "刷子"
	quest.42000000001B03F8.quest_desc: [
		"长成一棵不属于这个世界的树。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03F8.title: "异界树苗"
	quest.42000000001B03F9.quest_desc: [
		"来自异树的木材，用于束缚仪式。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03F9.title: "异界原木"
	quest.42000000001B03FA.quest_desc: [
		"束缚仪式进行时，托着一份祭品。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03FA.title: "献祭碗"
	quest.42000000001B03FB.quest_desc: [
		"一只镀金的碗，能加快所用的仪式。",
		"做法：金放在祭碗周围。词典写出仪式的名字。"
	]
	quest.42000000001B03FB.title: "金碗"
	quest.42000000001B03FC.quest_desc: [
		"一份未签名的契约，等着一个灵的名字。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03FC.title: "空白束缚之书"
	quest.42000000001B03FD.quest_desc: [
		"束缚最弱一级的灵，很适合第一次尝试。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03FD.title: "Foliot 之书"
	quest.42000000001B03FE.quest_desc: [
		"束缚中等强度的灵，比 foliot 更重的活。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03FE.title: "Djinni 之书"
	quest.42000000001B03FF.quest_desc: [
		"束缚一个凶猛的灵。仪式需要更多准备。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B03FF.title: "Afrit 之书"
	quest.42000000001B0400.quest_desc: [
		"束缚辞典里最强的灵。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0400.title: "Marid 之书"
	quest.42000000001B0401.quest_desc: [
		"一枚焦点，帮仪式稳住形状。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0401.title: "灵谐宝石"
	quest.42000000001B0402.quest_desc: [
		"来自这个世界之外的矿石，熔炼成 Iesnium。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0402.title: "粗 Iesnium"
	quest.42000000001B0403.quest_desc: [
		"一种只存在于另一边的金属。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0403.title: "Iesnium 锭"
	quest.42000000001B0404.quest_desc: [
		"把束缚好的灵矿工送进异界去挖。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0404.title: "维度矿井"
	quest.42000000001B0405.quest_desc: [
		"最弱的灵，被派去地下采矿。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0405.title: "Foliot 矿工"
	quest.42000000001B0406.quest_desc: [
		"把灵存储罐连成一个可搜索的网络。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0406.title: "存储控制器（异界）"
	quest.42000000001B0407.quest_desc: [
		"把某些灵引向仪式圈。",
		"做法：筛子，或者你种出一排晶洞就用紫水晶母岩。Occultism 要碎片。"
	]
	quest.42000000001B0407.title: "紫水晶焦点"
	quest.42000000001B0408.quest_desc: [
		"熔成金碗和其他仪式器具。",
		"做法：熔炼粗金 / 金砂砾。筛子里更稀有的收获。"
	]
	quest.42000000001B0408.title: "金锭储备"
	quest.42000000001B0409.quest_desc: [
		"空白书页，随时能做成一本束缚之书。",
		"做法：三张纸加皮革。纸就是甘蔗。"
	]
	quest.42000000001B0409.title: "书本储备"
	quest.42000000001B040A.quest_desc: [
		"给仪式粉笔上色，用来标出召唤阵。",
		"做法：蓝色加红色，或一朵紫花。Occultism 要这个。"
	]
	quest.42000000001B040A.title: "紫色染料"
	quest.42000000001B040B.quest_desc: [
		"给仪式粉笔上色，比紫色更素的记号。",
		"做法：在合成格里放骨粉，或一朵白花。"
	]
	quest.42000000001B040B.title: "白色染料"
	quest.42000000001B040C.quest_desc: [
		"给仪式粉笔上色，画出更深的圈。",
		"做法：木炭，或一个墨囊（木炭加玻璃瓶）。"
	]
	quest.42000000001B040C.title: "黑色染料"
	quest.42000000001B040D.quest_desc: [
		"仪式地面，质地好像正合仪式的意。",
		"做法：把沙子倒进装有巫水的 Ex Deorum 木桶。要塞的疣室里有一点。灵魂沙上三个头颅做成凋灵。"
	]
	quest.42000000001B040D.title: "灵魂沙储备（异界）"
	quest.42000000001B040E.quest_desc: [
		"偏向火焰的仪式用的底层。",
		"做法：这里的下界是虚空，不是地形。把熔岩倒进装有巫水的 Ex Deorum 木桶（放在菌丝上的一桶水；菌丝孢子从泥土里筛出）。"
	]
	quest.42000000001B040E.title: "下界岩储备（异界）"
	quest.42000000001B040F.quest_desc: [
		"给仪式圈用的暗色稳固边框。",
		"做法：水浇在熔岩源上（或熔岩浇在水上）。留下熔岩源。"
	]
	quest.42000000001B040F.title: "黑曜石储备（异界）"
	quest.42000000001B0410.quest_desc: [
		"一份供品，有些灵会被它吸引。",
		"做法：末影人，或 /clowder hub 的缘行者摊位。"
	]
	quest.42000000001B0410.title: "末影珍珠储备（异界）"
	quest.42000000001B0411.quest_desc: [
		"一份贵重供品，给苛刻的仪式。",
		"做法：用铁网或更好的网筛砾石，或用回声粉碎机处理钻石矿石。"
	]
	quest.42000000001B0411.title: "钻石储备"
	quest.42000000001B0412.quest_desc: [
		"一本束缚之书，里面已经封着一个 Foliot。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0412.title: "已缚的 Foliot 之书"
	quest.42000000001B0413.quest_desc: [
		"一本束缚之书，里面已经封着一个 Djinni。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0413.title: "已缚的 Djinni 之书"
	quest.42000000001B0414.quest_desc: [
		"一本束缚之书，里面已经封着一个 Afrit。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0414.title: "已缚的 Afrit 之书"
	quest.42000000001B0415.quest_desc: [
		"一本束缚之书，里面已经封着一个 Marid。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0415.title: "已缚的 Marid 之书"
	quest.42000000001B0416.quest_desc: [
		"一小块矿脉样本，等你找到更多再熔炼才值。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0416.title: "Iesnium 矿石"
	quest.42000000001B0417.quest_desc: [
		"一个 Afrit，被派到更深处开采，较弱的灵不肯去那里。",
		"做法：灵之辞典，然后是灵火和碗。异界章节写出仪式的名字。"
	]
	quest.42000000001B0417.title: "深层矿工 Afrit"
	quest.42000000001C0418.quest_desc: [
		"别的都还没转的时候，用手摇它。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0418.title: "手摇曲柄（钟械）"
	quest.42000000001C0419.quest_desc: [
		"把转动从一台机器传到下一台。",
		"做法：安山岩合金，用 JEI 列出的切割配方 / 合成。"
	]
	quest.42000000001C0419.title: "传动轴储备"
	quest.42000000001C041A.quest_desc: [
		"齿轮咬住传动轴。",
		"做法：传动轴 + 木板。"
	]
	quest.42000000001C041A.title: "齿轮储备"
	quest.42000000001C041B.quest_desc: [
		"斜着啮合，并改变转速。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C041B.title: "大齿轮（钟械）"
	quest.42000000001C041C.quest_desc: [
		"让转动拐过墙角，速度不减。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C041C.title: "齿轮箱（钟械）"
	quest.42000000001C041D.quest_desc: [
		"接通机器的一种模式。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C041D.title: "离合器（钟械）"
	quest.42000000001C041E.quest_desc: [
		"靠一次红石脉冲翻转转动方向。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C041E.title: "变速器（钟械）"
	quest.42000000001C041F.quest_desc: [
		"把转动送得很远，不必砌一堵传动轴的墙。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C041F.title: "链传动"
	quest.42000000001C0420.quest_desc: [
		"一条链传动，下令就能反转或停下。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0420.title: "可调链条"
	quest.42000000001C0421.quest_desc: [
		"靠落下的水来转，慢，但稳。",
		"做法：八块木板围着一根传动轴。旁边要有水流。"
	]
	quest.42000000001C0421.title: "水车（钟械）"
	quest.42000000001C0422.quest_desc: [
		"轮子更大，同一股水流给出更多扭矩。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0422.title: "大轮"
	quest.42000000001C0423.quest_desc: [
		"把帆变成转动，浮台的风也算。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0423.title: "风车轴承（钟械）"
	quest.42000000001C0424.quest_desc: [
		"转动建在它上面的整座结构。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0424.title: "机械轴承（钟械）"
	quest.42000000001C0425.quest_desc: [
		"按时刻转动结构，像时钟的指针。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0425.title: "发条轴承"
	quest.42000000001C0426.quest_desc: [
		"把锅炉蒸汽变成稳定的转动。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0426.title: "蒸汽引擎"
	quest.42000000001C0427.quest_desc: [
		"用整个浮台都听得见的声音泄掉压力。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0427.title: "蒸汽哨"
	quest.42000000001C0428.quest_desc: [
		"把工作盆加热到足以高炉烧炼和酿造。",
		"做法：合成一个空的烈焰人燃烧器，在爪黑曜石之后，对下界要塞的烈焰人使用。"
	]
	quest.42000000001C0428.title: "烈焰人燃烧器"
	quest.42000000001C0429.quest_desc: [
		"接住掉进来的东西，用来搅拌或压制。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0429.title: "工作盆（钟械）"
	quest.42000000001C042A.quest_desc: [
		"快速搅拌批量配方。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C042A.title: "机械搅拌器（钟械）"
	quest.42000000001C042B.quest_desc: [
		"把锭压成板，并把工作盆里的东西压实。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C042B.title: "机械压机（钟械）"
	quest.42000000001C042C.quest_desc: [
		"砂轮或磨坊的活。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C042C.title: "磨盘（钟械）"
	quest.42000000001C042D.quest_desc: [
		"两只轮子对着转，矿石从中间喂进去。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C042D.title: "粉碎轮"
	quest.42000000001C042E.quest_desc: [
		"用来清洗和烘干的风扇。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C042E.title: "封闭风扇（钟械）"
	quest.42000000001C042F.quest_desc: [
		"不用动手，从上方搅动工作盆。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C042F.title: "打蛋器（钟械）"
	quest.42000000001C0430.quest_desc: [
		"转得够快时，吹飞物品和生物。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0430.title: "螺旋桨（钟械）"
	quest.42000000001C0431.quest_desc: [
		"托住一件物品，好让机械加工它。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0431.title: "置物台（钟械）"
	quest.42000000001C0432.quest_desc: [
		"按传动轴给它的速度运送物品。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0432.title: "传送带"
	quest.42000000001C0433.quest_desc: [
		"给传送带装货或卸货，一次只朝一个方向。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0433.title: "安山岩漏斗"
	quest.42000000001C0434.quest_desc: [
		"按物品和数量过滤它所搬运的东西。",
		"做法：JEI 里的 Create 合成（工作台、压机、搅拌机或放置器）。安山岩合金和水车是产线的起点。"
	]
	quest.42000000001C0434.title: "黄铜漏斗（钟械）"
