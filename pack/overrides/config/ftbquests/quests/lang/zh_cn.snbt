	quest.420000000018035C.title: "Imperium 加速器"
	quest.420000000018035D.quest_desc: [
		"精华能造出的最快加速器。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.420000000018035D.title: "Supremium 加速器"
	quest.420000000018035E.quest_desc: [
		"给口渴的作物来一下最基本的浇水。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.420000000018035E.title: "喷壶"
	quest.420000000018035F.quest_desc: [
		"注入了 Inferium 的喷壶，浇得更远。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.420000000018035F.title: "Inferium 喷壶"
	quest.4200000000180360.quest_desc: [
		"每次比基础喷壶浇到更多作物。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000180360.title: "Prudentium 喷壶"
	quest.4200000000180361.quest_desc: [
		"中层喷壶，洒面明显更宽。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000180361.title: "Tertium 喷壶"
	quest.4200000000180362.quest_desc: [
		"一次扫过，浇湿田里好大一片。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000180362.title: "Imperium 喷壶"
	quest.4200000000180363.quest_desc: [
		"喷壶洒得出的最宽一泼。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000180363.title: "Supremium 喷壶"
	quest.4200000000180364.quest_desc: [
		"扔到已经种下的作物上，生长就会变快。",
		"做法：在 JEI 里制作 Mystical Agriculture。Inferium 和 Prosperity 来自筛子；种子在注魔祭坛上注入。"
	]
	quest.4200000000180364.title: "施肥精华"
	quest.4200000000180365.quest_desc: [
