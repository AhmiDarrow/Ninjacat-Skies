	quest.42000000002004F8.title: "精英能量立方"
	quest.42000000002004F9.quest_desc: [
		"储存中等数量的能量。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004F9.title: "高级能量立方"
	quest.42000000002004FA.quest_desc: [
		"储存少量能量，适合起步。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004FA.title: "基础能量立方 (QIO)"
	quest.42000000002004FB.quest_desc: [
		"把化学物质注入金属，得到新合金。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004FB.title: "冶金灌注机 (QIO)"
	quest.42000000002004FC.quest_desc: [
		"熔炼前把粗矿的产出翻倍。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004FC.title: "富集仓 (QIO)"
	quest.42000000002004FD.quest_desc: [
		"研磨或粉碎成批材料。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004FD.title: "粉碎机 (QIO)"
	quest.42000000002004FE.quest_desc: [
		"比熔炉熔得更快，用电而不用燃料。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004FE.title: "电能冶炼炉 (QIO)"
	quest.42000000002004FF.quest_desc: [
		"用 Mekanism 自己的精密锯刃切木头。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.42000000002004FF.title: "精密锯木机"
	quest.4200000000200500.quest_desc: [
		"把水拆成组成它的两种气体。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.4200000000200500.title: "电解分离器"
	quest.4200000000200501.quest_desc: [
		"把两种化学物质合成一种新的。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.4200000000200501.title: "化学灌注机"
	quest.4200000000200502.quest_desc: [
		"提纯流体或矿石。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.4200000000200502.title: "纯化"
	quest.4200000000200503.quest_desc: [
		"把化学物质注入矿石，换取额外产出。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.4200000000200503.title: "化学注入"
	quest.4200000000200504.quest_desc: [
		"把锇压到物品上，做出更结实的装备。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.4200000000200504.title: "锇压缩机 (QIO)"
	quest.4200000000200505.quest_desc: [
		"把好几样部件合成一件成品。",
		"做法：Mekanism 工坊章节 — 筛子里的矿石块，然后是工厂线。"
	]
	quest.4200000000200505.title: "合并机"
	quest.4200000000210506.quest_desc: [
		"僵尸会掉这个，你想不想都一样。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：夜里在浮台上杀僵尸，或在一个暗洞里。"
	]
	quest.4200000000210506.title: "腐肉储备"
	quest.4200000000210507.quest_desc: [
		"骷髅会留下这些；以后磨成骨粉。",
		"做法：夜里的骷髅，或 /clowder hub 浮台看守（16丝线换8个）。"
	]
	quest.4200000000210507.title: "骨头储备"
	quest.4200000000210508.quest_desc: [
		"苦力怕会交出这个，有时还带着爆炸。",
		"做法：筛粉尘或灵魂沙，或夜里浮台上的苦力怕。有了一些之后，把边缘照亮。"
	]
	quest.4200000000210508.title: "火药储备"
	quest.4200000000210509.quest_desc: [
		"蜘蛛会掉这个，筛子永远不会。",
		"做法：拆开绽线（1 → 3）。蜘蛛。在回响缚结处用织机绒絮。纱的反向消耗。"
	]
	quest.4200000000210509.title: "线储备"
	quest.420000000021050A.quest_desc: [
		"能酿成剧毒，也进几样古怪配方。",
		"做法：夜里浮台上的蜘蛛。"
	]
	quest.420000000021050A.title: "蜘蛛眼储备"
	quest.420000000021050B.quest_desc: [
		"末影人会掉这些；农场比向虚空乞讨强。",
		"做法：末影人，或 /clowder hub 的缘行者摊位。"
	]
	quest.420000000021050B.title: "末影珍珠农场"
	quest.420000000021050C.quest_desc: [
		"酿造台和烈焰燃烧器都能用的燃料。",
		"做法：爪的黑曜石之后的下界要塞。酿造要一根棒；Ars 和 Occultism 不等它。"
	]
	quest.420000000021050C.title: "烈焰棒农场"
	quest.420000000021050D.quest_desc: [
		"稀有掉落，再生药水的关键。",
		"做法：爪的黑曜石之后的下界恶魂。"
	]
	quest.420000000021050D.title: "恶魂之泪农场"
	quest.420000000021050E.quest_desc: [
		"能酿成抗火，也供给几样合成。",
		"做法：把黏液球丢进熔岩木桶，黏液加烈焰粉，或岩浆怪。"
	]
	quest.420000000021050E.title: "岩浆膏农场"
	quest.420000000021050F.quest_desc: [
		"够黏，能做活塞、粘液块和拴绳。",
		"做法：两份泥土 + 小麦种子 + 骨粉（浮台堆肥），或 /clowder hub 浮台看守。"
	]
	quest.420000000021050F.title: "粘液球农场"
	quest.4200000000210510.quest_desc: [
		"三个就能召唤一个值得一战的首领。",
		"做法：爪的黑曜石之后，下界要塞。三个头颅就能召出一只凋灵。"
	]
	quest.4200000000210510.title: "凋灵骷髅头颅"
	quest.4200000000210511.quest_desc: [
		"凋灵自己的税，稀有，又沉甸甸地满是力量。",
		"做法：凋灵（灵魂沙上三个头颅），或在 /clowder hub 的鼓心摊位换一次，花 12 个丝线匹（972 丝线）。可选战利品——它不拦住末地，也不拦住生物农场的 100%。"
	]
	quest.4200000000210511.title: "下界之星"
	quest.4200000000210512.quest_desc: [
		"合成成潜影盒，一种死后仍在的储存。",
		"可选——这里没有潜影贝，所以整合包改为合成壳。",
		"做法：整合包配方，六块紫珀，两颗末影珍珠，一枚缚结。潜影贝从不在这里生成。可选。"
	]
	quest.4200000000210512.title: "潜影壳农场"
	quest.4200000000210513.quest_desc: [
		"别的都不行时，用来修鞘翅。",
		"做法：连着三夜不睡觉，然后杀死幻翼。可选。"
	]
	quest.4200000000210513.title: "幻翼膜"
	quest.4200000000210514.quest_desc: [
		"鱿鱼墨汁，能染色，也能用来写旧式的字。",
		"做法：木炭加玻璃瓶。鱿鱼在这里从不生成。"
	]
	quest.4200000000210514.title: "墨囊农场"
	quest.4200000000210515.quest_desc: [
		"让告示牌和物品展示框在黑暗中发光。",
		"做法：发光鱿鱼从不在浮台生成。可选。"
	]
	quest.4200000000210515.title: "荧光墨水"
	quest.4200000000210516.quest_desc: [
		"守卫者掉落它，用来做海晶石方块和灯。",
		"做法：海底神殿已经没了。除非你种一颗海晶石种子，否则可选。"
	]
	quest.4200000000210516.title: "海晶碎片"
	quest.4200000000210517.quest_desc: [
		"守卫者的掉落，照亮大海，也供给几样合成。",
		"做法：海底神殿已经没了。可选。"
	]
	quest.4200000000210517.title: "海晶砂粒"
	quest.4200000000210518.quest_desc: [
		"围成潮涌核心；凑齐八个，框架才算完成。",
		"可选——虚空也许永远不会给你一个。",
		"做法：仅限海洋。可选。"
	]
	quest.4200000000210518.title: "鹦鹉螺壳（狩猎）"
	quest.4200000000210519.quest_desc: [
		"骗过死亡一次，然后就没了。",
		"做法：只有任务奖励。安置时钟和安置印记各给一个，后期丝缕结的赠礼还会再给。袭击和唤魔者从不到浮台。可选。"
	]
	quest.4200000000210519.title: "图腾（狩猎）"
	quest.420000000021051A.quest_desc: [
		"傀儡站岗的时候会掉铁。",
		"做法：熔炼粗铁 / 铁砂砾（熔炉或余烬窑）。筛砾石取碎块。"
	]
	quest.420000000021051A.title: "铁傀儡的赠礼"
	quest.420000000021051B.quest_desc: [
		"会扔雪球；弹药好用，不太能打。",
		"做法：一块冰（套装／制冰机），无序合成四颗雪球。"
	]
	quest.420000000021051B.title: "雪傀儡"
	quest.420000000021051C.quest_desc: [
		"骷髅让浮台的弹药一直有货。",
		"做法：燧石、木棍、羽毛。骷髅会多掉一些。"
	]
	quest.420000000021051C.title: "箭农场"
	quest.420000000021051D.quest_desc: [
		"命中的东西会暂时发光。",
		"做法：荧石粉围着一支箭。"
	]
	quest.420000000021051D.title: "光灵箭"
	quest.420000000021051E.quest_desc: [
		"找到鞍就骑上去。",
		"可选 — Clowder 大厅的浮台看守卖一个。",
		"做法：在 Clowder 大厅（/clowder hub）的浮台看守店铺用钻石块交换。Chocobo 鞍是另一种物品。"
	]
	quest.420000000021051E.title: "鞍（狩猎）"
	quest.420000000021051F.quest_desc: [
		"给生物起名，让它再也不会消失。",
		"可选 — Clowder 大厅的印刻者卖一个。",
		"做法：钓鱼 / 稀有箱子，或 /clowder hub 的印刻者摊位（24丝线）。可选。"
	]
	quest.420000000021051F.title: "命名牌农场"
	quest.4200000000210520.quest_desc: [
		"拴住一条连结或线缆。",
		"做法：四根线围住黏液球。黏液是浮台堆肥（泥土、种子、骨粉）。"
	]
	quest.4200000000210520.title: "拴绳（狩猎）"
	quest.4200000000210521.quest_desc: [
		"鸡下得比你捡得还快。",
		"做法：给浮台上的鸡小麦种子，或生物农场章节的鸡舍。"
	]
	quest.4200000000210521.title: "鸡蛋储备"
	quest.4200000000210522.quest_desc: [
		"皮革和牛肉的储备。",
		"做法：熔炼腐肉，或在营火上烤。用燧石网筛泥土。/clowder hub 浮台看守以18丝线卖两个。"
	]
	quest.4200000000210522.title: "皮革储备"
	quest.4200000000210523.quest_desc: [
		"羊剪过毛，羊毛还会再长出来。",
		"做法：先给羊吃草再剪毛，或者四根线。"
	]
	quest.4200000000210523.title: "羊毛储备"
	quest.4200000000210524.quest_desc: [
		"给厨房备的食物。",
		"做法：把小麦给浮台上的牛。"
	]
	quest.4200000000210524.title: "牛肉储备"
	quest.4200000000210525.quest_desc: [
		"猪会给你，吃之前先煮熟。",
		"做法：把土豆或胡萝卜给浮台上的猪。"
	]
	quest.4200000000210525.title: "猪肉储备"
	quest.4200000000210526.quest_desc: [
		"鸡，用来做菜，也出羽毛。",
		"做法：把种子给浮台上的鸡。"
	]
	quest.4200000000210526.title: "鸡肉储备"
	quest.4200000000210527.quest_desc: [
		"羊肉，烤过比生的好。",
		"做法：把小麦给浮台上的羊。"
	]
	quest.4200000000210527.title: "羊肉储备"
	quest.4200000000210528.quest_desc: [
		"若你舍得用掉一只，就能酿一瓶幸运药水。",
		"可选——虚空也许永远不会给你一个。",
		"做法：兔子不会在浮台生成。可选。"
	]
	quest.4200000000210528.title: "兔子脚"
	quest.4200000000210529.quest_desc: [
		"一件展品，值得摆在龙蛋旁边。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000210529.title: "僵尸的头"
	quest.420000000021052A.quest_desc: [
		"和架子上的龙蛋很配。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000021052A.title: "骷髅头颅"
	quest.420000000021052B.quest_desc: [
		"再一颗头，摆上龙蛋旁的战利品架。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000021052B.title: "苦力怕的头"
	quest.420000000021052C.quest_desc: [
		"又是一颗头，挨着龙蛋才自在。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000021052C.title: "猪灵的头"
	quest.420000000021052D.quest_desc: [
		"最稀有的头颅，只有战斗结束后才能得到。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000021052D.title: "龙首"
	quest.420000000021052E.quest_desc: [
		"只有玩家碰巧掉落一个的时候。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.420000000021052E.title: "玩家的头"
	quest.420000000022052F.quest_desc: [
		"第一次制作得到2个——留一个以后给抄本。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：一块骨头、线、紫水晶。/clowder hub 浮台看守卖骨头。火花 / 低鸣之门。"
	]
	quest.420000000022052F.title: "骨铃"
	quest.4200000000220530.quest_desc: [
		"旧部族之歌的碎片——需要骨铃。",
		"做法：骨铃、紫水晶和红石，无序。产出两个。"
	]
	quest.4200000000220530.title: "灵碎片"
	quest.4200000000220531.quest_desc: [
		"把金属调向灵——骨铃周围放铜。",
		"做法：铜围住骨铃。产出两个。"
	]
	quest.4200000000220531.title: "铜共鸣器"
	quest.4200000000220532.quest_desc: [
		"标出网格的线——粉笔需要一块碎片。",
		"做法：两份骨粉、青金石和一块灵碎片，无序合成。产出四个。"
	]
	quest.4200000000220532.title: "仪式粉笔（部族）"
	quest.4200000000220533.quest_desc: [
		"放上这颗心——两只骨铃、一块灵碎片、两份皮革和四块木板（浮台看守出售皮革）。",
		"做法：两个骨铃、一块灵碎片、两份皮革和四块木板。空手按拍子敲（17–23 刻），得到 24 点脉动。"
	]
	quest.4200000000220533.title: "鼓心搏动"
	quest.4200000000220534.quest_desc: [
		"九个部族曾一起哼唱——需要备用的骨铃和碎片。",
		"做法：制作，或作为火花/部族编织的奖励。右键：网格如何运作。"
	]
	quest.4200000000220534.title: "灵之抄本"
	quest.4200000000220535.quest_desc: [
		"把地脉引入节拍。",
		"做法：放在天空下，靠近水/绿。脉动很慢。火花阶梯。"
	]
	quest.4200000000220535.title: "地脉收集器"
	quest.4200000000220536.quest_desc: [
		"为工具、法术和旅行携带脉动。在鼓心处把它充满。",
		"做法：先合成，再从鼓心灌满（用胞点击）。工具、法术和旅行都从胞里取用。"
	]
	quest.4200000000220536.title: "脉动胞"
	quest.4200000000220537.quest_desc: [
		"安入一个回声催化剂，它会在工作中磨损；在八格内加入两种不同的图腾之声。声音越多，歌越强。红石会让它暂停。",
		"做法：安放一个回声触媒，8格内放两个不同的图腾。红石会让它暂停。"
	]
	quest.4200000000220537.title: "脉动共鸣器"
	quest.4200000000220538.quest_desc: [
		"石之部族应声。",
		"做法：一只骨铃、两根原木、泥土和一台铜共鸣器。"
	]
	quest.4200000000220538.title: "土图腾"
	quest.4200000000220539.quest_desc: [
		"焰之部族应声。",
		"做法：一只骨铃、两根原木、木炭和一台铜共鸣器。"
	]
	quest.4200000000220539.title: "火图腾"
	quest.420000000022053A.quest_desc: [
		"潮之部族应声。",
		"做法：一只骨铃、两根原木、一个水桶（或瓷水桶）和一台铜共鸣器。"
	]
	quest.420000000022053A.title: "水图腾"
	quest.420000000022053B.quest_desc: [
		"风之部族应声。",
		"做法：一只骨铃、两根原木、一根羽毛和一台铜共鸣器。"
	]
	quest.420000000022053B.title: "气图腾"
	quest.420000000022053C.quest_desc: [
		"第五部族——执事之核。",
		"做法：一只骨铃、两根原木、一块灵碎片和一台铜共鸣器。"
	]
	quest.420000000022053C.title: "灵图腾"
	quest.420000000022053D.quest_desc: [
		"开始网格之歌。它等着石头或一件回声阶段的物品；粗金属在回声粉碎机上是砂砾。",
		"做法：灵之抄本 + 部族编织。安入石头或一件回声阶段物品。粗金属归回声粉碎机。"
	]
	quest.420000000022053D.title: "歌声台"
	quest.420000000022053E.quest_desc: [
		"在图腾之间导引谐波。",
		"做法：四台铜共鸣器围住红石。做出四个。"
	]
	quest.420000000022053E.title: "网格导体"
	quest.420000000022053F.quest_desc: [
		"哼唱第一阶段——打碎矿石。石头变成碎片；圆石变成砾石；粗金属变成砂砾。砂砾粉碎是每秒40脉动，持续4秒。",
		"做法：石头 + 骨铃 + 铜共鸣器。8格内有土图腾。石头 → 碎片；圆石 → 砾石；粗金属 → 砂砾。每秒40脉动，四秒。"
	]
	quest.420000000022053F.title: "回声粉碎机"
	quest.4200000000220540.quest_desc: [
		"听见粉碎的碎片。",
		"做法：把石头放进回声粉碎机（不是圆石）。泉等级的石头，或精准采集得到的石头。"
	]
	quest.4200000000220540.title: "回声碎片（部族）"
	quest.4200000000220541.quest_desc: [
		"哼唱第二阶段——调谐。",
		"做法：七块石头、一块灵碎片和一台铜共鸣器。"
	]
	quest.4200000000220541.title: "回声调谐"
	quest.4200000000220542.quest_desc: [
		"找到钥匙的回声。",
		"做法：灵之抄本 + 部族编织。站点、图腾和脉动消耗写在抄本那一页。"
	]
	quest.4200000000220542.title: "已调谐的回声"
	quest.4200000000220543.quest_desc: [
		"束缚阶段——把灵结到金属上。",
		"做法：七块石头、一块紫水晶碎片和一台铜共鸣器。"
	]
	quest.4200000000220543.title: "回声束缚"
	quest.4200000000220544.quest_desc: [
		"不会滑脱的回声。",
		"做法：灵之抄本 + 部族编织。站点、图腾和脉动消耗写在抄本那一页。"
	]
	quest.4200000000220544.title: "束缚回声"
	quest.4200000000220545.quest_desc: [
		"重织阶段——召来锭。",
		"做法：五块石头、一块金锭、两台铜共鸣器和一块灵碎片。"
	]
	quest.4200000000220545.title: "回声显化"
	quest.4200000000220546.quest_desc: [
		"不是熔炉炼出的金属，是灵脉以意志唤出的。",
		"做法：灵之抄本 + 部族编织。站点、图腾和脉动消耗写在抄本那一页。"
	]
	quest.4200000000220546.title: "显化锭"
	quest.4200000000220547.quest_desc: [
		"守住部族留下的东西。",
		"做法：七块木板、一个箱子和一只骨铃。"
	]
	quest.4200000000220547.title: "先祖储藏"
	quest.4200000000220548.quest_desc: [
		"朝边境连通的宝库。",
		"做法：一个先祖储藏、四块铁锭、一块灵碎片、两台铜共鸣器和一枚脉动胞。"
	]
	quest.4200000000220548.title: "深藏"
	quest.4200000000220549.quest_desc: [
		"一枚未写的印记，等着一场仪式把它填满。",
		"做法：七张纸、一块灵碎片和一只骨铃。做出两个。"
	]
	quest.4200000000220549.title: "空白印记"
	quest.420000000022054A.quest_desc: [
		"石之部族的印记。",
		"做法：一枚空白印记和泥土，无序。"
	]
	quest.420000000022054A.title: "土印记"
	quest.420000000022054B.quest_desc: [
		"焰之部族的印记。",
		"做法：一枚空白印记和木炭，无序。"
	]
	quest.420000000022054B.title: "火印记"
	quest.420000000022054C.quest_desc: [
		"潮之部族的印记。",
		"做法：一枚空白印记和一个水桶（或瓷水桶），无序。"
	]
	quest.420000000022054C.title: "水印记"
	quest.420000000022054D.quest_desc: [
		"风之部族的印记。",
		"做法：一枚空白印记和一根羽毛，无序。"
	]
	quest.420000000022054D.title: "气印记"
	quest.420000000022054E.quest_desc: [
		"执事部族的印记。",
		"做法：一枚空白印记和一块灵碎片，无序。"
	]
	quest.420000000022054E.title: "灵印记"
	quest.420000000022054F.quest_desc: [
		"献上印记。去问织机。",
		"做法：五块石头、一块紫水晶碎片和一只骨铃。"
	]
	quest.420000000022054F.title: "仪式基座"
	quest.4200000000220550.quest_desc: [
		"空手使用，演奏门之仪：用 A、S、D、F 敲中落下的拍子。打中 60% 就打开；不需要脉搏。",
		"做法：空手使用门鼓，演奏门之仪：用 A、S、D、F 敲中落下的拍子。打中 60% 就打开；不需要脉搏。先绑定回程指南针。"
	]
	quest.4200000000220550.title: "门鼓（部族）"
	quest.4200000000220551.quest_desc: [
		"用雕好的灵框装点你营地的门槛。指南针和门鼓负责旅行。",
		"做法：四块铁锭、两块灵碎片、两台铜共鸣器和一块紫水晶碎片。"
	]
	quest.4200000000220551.title: "灵门"
	quest.4200000000220552.quest_desc: [
		"消耗脉动的工具。",
		"做法：三块显化锭、一只骨铃和一根木棍。"
	]
	quest.4200000000220552.title: "灵装镐"
	quest.4200000000220553.quest_desc: [
		"消耗脉动的刃。",
		"做法：两块显化锭、一只骨铃和一根木棍。"
	]
	quest.4200000000220553.title: "灵装刃"
	quest.4200000000220554.quest_desc: [
		"来自边境的石头，踩在一个不该存在的地方脚下。",
		"做法：熔炼边境圆石。经门鼓进入边境去挖。"
	]
	quest.4200000000220554.title: "边境石（部族）"
	quest.4200000000220555.quest_desc: [
		"边境的碎石，平平无奇，却多得很。",
		"做法：经门鼓，在边境开采边境石。"
	]
	quest.4200000000220555.title: "边境圆石"
	quest.4200000000220556.quest_desc: [
		"长在阳光照不到的地方的木头。",
		"做法：经门鼓，砍伐边境的树。"
	]
	quest.4200000000220556.title: "边境原木"
	quest.4200000000220557.quest_desc: [
		"边境的锯材，出身虽怪，却很结实。",
		"做法：一根边境原木做出四块木板。"
	]
	quest.4200000000220557.title: "边境木板"
	quest.4200000000220558.quest_desc: [
		"没有一丝风也会低语的叶子。",
		"做法：经门鼓的边境树。剪刀或精准采集能保住树叶。"
	]
	quest.4200000000220558.title: "边境树叶"
	quest.4200000000220559.quest_desc: [
		"一根苇，残留的灵脉在里面低鸣。",
		"做法：在边境野外生长，躺在芦堰的箱子里，缚根者长老会拿它交易。"
	]
	quest.4200000000220559.title: "灵苇（部族）"
	quest.420000000022055A.quest_desc: [
		"在土图腾旁边，把粗铁送进回声粉碎机。会出来两份砂砾；用熔炉熔炼，或用高炉烧成锭。其他 Mods 可以提供带标签的粗金属。",
		"做法：灵之抄本 + 部族编织。站点、图腾和脉动消耗写在抄本那一页。"
	]
	quest.420000000022055A.title: "矿石记得两次"
	quest.420000000022055B.quest_desc: [
		"水把羊毛结成灵织布。从站点上方或侧面送入，再从下方取出成品。",
		"做法：灵之抄本 + 部族编织。站点、图腾和脉动消耗写在抄本那一页。"
	]
	quest.420000000022055B.title: "有声的布"
	quest.420000000022055C.quest_desc: [
		"在灵之下，把显化锭再显化一次。共鸣核心开启更强的装备和远路。",
		"做法：灵之抄本 + 部族编织。站点、图腾和脉动消耗写在抄本那一页。"
	]
	quest.420000000022055C.title: "活着的心"
	quest.420000000022055D.quest_desc: [
		"一枚上级胞带4,800脉动，一枚大胞则是19,200。出发前，在鼓心或共鸣器上给它充能。",
		"做法：一枚脉动胞、两枚共鸣核心和两块显化锭。"
	]
	quest.420000000022055D.title: "更长的歌"
	quest.420000000022055E.quest_desc: [
		"一座蓄槽装十六桶。桶和流体管道都能用。比较器读取充满程度；红石锁住注入和排出。打破它，液体留在掉落的方块上。天石储罐会倒空。",
		"做法：制作，用桶或管道装满，拾起——液体还在。AE2 的天石储罐一破坏就空。"
	]
	quest.420000000022055E.title: "留在铜里的雨"
	quest.420000000022055F.quest_desc: [
		"用调谐器标记机器的一面，再对中继板使用。对另一台机器使用，就会换掉标记。不要标记那块板。",
		"做法：一块灵碎片，放在两台铜共鸣器上方。"
	]
	quest.420000000022055F.title: "给远端起名"
	quest.4200000000220560.quest_desc: [
		"把板扣到箱子或机器的面上。用同一个独一无二的羁绊物品把两块板配成一对，或用调谐器绑定目的地。近处货物送到 32 格，每秒 16 件，花费 8 脉动。红石会让它暂停。自 5.0 起，这块板要八格内有一座醒着的气共鸣图腾，否则就停着，并说出缺的是哪一声。",
		"做法：一个漏斗、一个铜共鸣器、两份仪式粉笔，和一个显化锭。"
	]
	quest.4200000000220560.title: "物资之路"
	quest.4200000000220561.quest_desc: [
		"把板扣到储罐的面上。把两块板配成一对，或用调谐器绑定目的地。近处流体送到 32 格：每秒 250 mB，花费 8 脉动。两端都必须已加载。自 5.0 起，这块板要八格内有一座醒着的气共鸣图腾，否则就停着，并说出缺的是哪一声。",
		"做法：一个精魂蓄槽、一个铜共鸣器、两份仪式粉笔，和一个显化锭。"
	]
	quest.4200000000220561.title: "雨水之路"
	quest.4200000000220562.quest_desc: [
		"远达以每次成功的一拍 16 脉动，把物品送到至多 128 格。任何兼容 mod 的普通物品栏都能用。自 5.0 起，这块板要八格内有一座醒着的气共鸣图腾，否则就停着，并说出缺的是哪一声。",
		"做法：一个物品中继、两枚共鸣核心，和两颗末影珍珠。"
	]
	quest.4200000000220562.title: "穿过工坊"
	quest.4200000000220563.quest_desc: [
		"远达以每一拍 16 脉动，把流体送到至多 128 格。装满的接收端会安全停下；红石可以锁住接收蓄槽。自 5.0 起，这块板要八格内有一座醒着的气共鸣图腾，否则就停着，并说出缺的是哪一声。",
		"做法：一个流体中继、两枚共鸣核心，和两颗末影珍珠。"
	]
	quest.4200000000220563.title: "穿过水道"
	quest.4200000000220564.quest_desc: [
		"把 Tribal Power 接到 Mekanism、Powah 或 AE2 的能量接收器。每一点脉动变成 100 FE。无阶转换是每秒 60 脉动（6,000 FE/s）；在回声站给转接器升阶，空手状态会报出当前速率。它仍然不能接收 FE。红石会停止转换和输出。",
		"做法：五个铜锭、三个红石，和一枚共鸣核心。"
	]
	quest.4200000000220564.title: "节拍化作电流"
	quest.4200000000220565.quest_desc: [
		"六重法杖。潜行使用以轮换土、火、水、气、灵和织机。使用以施放；织机之声是系索，把目标拉向你八格，没有目标时潜行施放则是针脚，瞬移六格。携带充能的胞；灵之抄本说明每个法术及其消耗。",
		"做法：一枚灵之印、一枚共鸣核心、一块显化锭和两根原木。"
	]
	quest.4200000000220565.title: "一手六声"
	quest.4200000000220566.quest_desc: [
		"主手潜行使用石面：刻意切出三乘三，每块 8 脉动。通常的破坏保护和工具要求仍然有效。",
		"做法：两块显化锭、一枚共鸣核心和两台铜共鸣器。"
	]
	quest.4200000000220566.title: "石让出门洞"
	quest.4200000000220567.quest_desc: [
		"兜帽在充能的胞支撑时借你夜视。未联结的部件每四秒抽取 2 脉动；绑定的声花费 3。",
		"做法：五块灵织布，盔形。日后装上地脉透镜，它便能看见地脉。"
	]
	quest.4200000000220567.title: "寂静中的眼"
	quest.4200000000220568.quest_desc: [
		"长袍给予抗性。穿着它去干活，并让胞保持充能。",
		"做法：七块灵织布和一枚共鸣核心。"
	]
	quest.4200000000220568.title: "织成的庇护"
	quest.4200000000220569.quest_desc: [
		"织成的护腿借你速度。它的脉动消耗与其他部件分开。",
		"做法：六块灵织布和一枚共鸣核心。"
	]
	quest.4200000000220569.title: "营地跟上步伐"
	quest.420000000022056A.quest_desc: [
		"靴子能在下坠时借你缓降，只要脉动还在。绑定的归途仍然值得带着。",
		"做法：四块灵织布，靴形。"
	]
	quest.420000000022056A.title: "更缓的下落"
	quest.420000000022056B.quest_desc: [
		"把可再用的印安放在配对的图腾旁。六格的祝福每两秒花费 8 脉动。高红石会暂停它；空手潜行以收回印。",
		"做法：两块显化锭、两个铜锭、一枚共鸣核心和三块石头。"
	]
	quest.420000000022056B.title: "留下的祝福"
	quest.420000000022056C.quest_desc: [
		"潜行使用坚实地面的顶面以绑定它。在同一世界 128 格内，花费 20 脉动返回。给落点地面供能，以锁住抵达。",
		"做法：一枚指南针，四周是四块显化锭。"
	]
	quest.420000000022056C.title: "第一条归途"
	quest.420000000022056D.quest_desc: [
		"在同一维度内，任何距离都以 40 脉动返回。留一块干燥的落点，上方空出两格。",
		"做法：一枚路碑指南针，四周是四枚共鸣核心。"
	]
	quest.420000000022056D.title: "地平之外"
	quest.420000000022056E.quest_desc: [
		"到门鼓之外去寻边境水晶。人、物品和流体的星路都取用同一种后期材料。",
		"做法：在边境洞窟挖水晶，或在边境箱子里找到它。先有门鼓。"
	]
	quest.420000000022056E.title: "帷幕之外的声音"
	quest.420000000022056F.quest_desc: [
		"最终的指南针以 100 脉动跨越维度。探索之前先绑定安全的归途。旅行在两次使用之间等待五秒。",
		"做法：一枚地平指南针、两枚灵之印和两块边境水晶。"
	]
	quest.420000000022056F.title: "世界之间的路"
	quest.4200000000220570.quest_desc: [
		"星界货物跨越维度，没有距离上限。每一次成功的拍消耗32脉动。接收端必须已经加载；不会偷偷加载区块。自5.0起，这块板要八格内一座醒着的共鸣图腾（织机），否则就停着，并说出缺的是哪一声。",
		"做法：一台远距物品中继、两枚灵印、两块边境水晶。"
	]
	quest.4200000000220570.title: "补给越过帷幕"
	quest.4200000000220571.quest_desc: [
		"星界流体走的维度层级，与玩家和物品相同。让目标储罐保持加载。储罐已满，或世界未加载，就暂停，不消耗货物。自5.0起，这块板要八格内一座醒着的共鸣图腾（织机），否则就停着，并说出缺的是哪一声。",
		"做法：一台远距流体中继、两枚灵印、两块边境水晶。"
	]
	quest.4200000000220571.title: "雨越过帷幕"
	quest.4200000000220572.quest_desc: [
		"在路上打开你私人的54格深藏。这是同一座库，你的藏所和挎包共用它。与边境调谐之后，开启不再消耗。",
		"做法：六块灵织布、两枚共鸣核心，和一座深藏。"
	]
	quest.4200000000220572.title: "随身营地"
	quest.4200000000220573.quest_desc: [
		"门开向一个活着的国度。有的生物还带着旧歌；有的守着它碎掉的片段。温和的，用刷子刷。面对守护者时，带上充好的脉动胞，并留一条回程。",
		"做法：制作，或作为火花/部族编织的奖励。右键：网格如何运作。"
	]
	quest.4200000000220573.title: "归来之歌"
	quest.4200000000220574.quest_desc: [
		"一只黎明食草兽，角里带着森林的旧歌。用小麦繁殖；刷成年的，得到黎明丝绒。",
		"到主世界的森林和边境里找它。把它的试剂交回水之声下的回声束缚，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：刷一只成年黎明雄鹿。用小麦繁殖它们。"
	]
	quest.4200000000220574.title: "黎明雄鹿：归还的歌"
	quest.4200000000220575.quest_desc: [
		"一只羞怯的黄昏觅食者，尾巴标出安全的路。用甜浆果繁殖；刷成年的，得到灯绒。",
		"到主世界的森林和边境里找它。把它的试剂交回水之声下的回声束缚，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：刷一只成年灯狐。用甜浆果繁殖它们。"
	]
	quest.4200000000220575.title: "灯狐：归还的歌"
	quest.4200000000220576.quest_desc: [
		"一只耐心的湿地园丁，背着活的壳。用海草繁殖；刷成年的，得到自然脱落的苔背鳞。",
		"到主世界的沼泽和边境里找它。把它的试剂交回水之声下的回声束缚，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：刷一只成年苔背。用海草繁殖它们。"
	]
	quest.4200000000220576.title: "苔背：归还的歌"
	quest.4200000000220577.quest_desc: [
		"一场破碎火祭的残骸。它的近战会短暂点燃；把水放在近处。",
		"到主世界的森林和边境里找它。把它的试剂交回灵之声下的回声调谐，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从灰缚身上掉落。敌对的灵需要黑暗。"
	]
	quest.4200000000220577.title: "灰缚：归还的歌"
	quest.4200000000220578.quest_desc: [
		"被切断的地脉线扭曲的林园守护者。慢，但结实；打击会让旅人短暂生根。",
		"到主世界的森林和边境里找它。把它的试剂交回灵之声下的回声调谐，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从根缚身上掉落。敌对的灵需要黑暗。"
	]
	quest.4200000000220578.title: "根缚：归还的歌"
	quest.4200000000220579.quest_desc: [
		"藏在灵苇间的沼泽猎人。快击带着短毒。",
		"到主世界的沼泽和边境里找它。把它的试剂交回灵之声下的回声调谐，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从苇潜者身上掉落。敌对的灵需要黑暗。"
	]
	quest.4200000000220579.title: "苇潜者：归还的歌"
	quest.420000000022057A.quest_desc: [
		"晶田里的拾荒者，披着会唱歌的石甲。离它沉重的一推远一点。",
		"到边境里找它。把它的试剂交回灵之声下的回声调谐，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从碎背身上掉落。敌对的灵需要黑暗。"
	]
	quest.420000000022057A.title: "碎背：归还的歌"
	quest.420000000022057B.quest_desc: [
		"仍在看守古道的空哨。它的触碰会削弱攻击者的握力。",
		"到边境里找它。把它的试剂交回灵之声下的回声调谐，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从空心哨卫身上掉落。敌对的灵需要黑暗。"
	]
	quest.420000000022057B.title: "空心哨卫：归还的歌"
	quest.420000000022057C.quest_desc: [
		"以风暴为食的灵，有宽阔的帷幕之翼。明亮的微尘聚拢，预告一阵风；掩体打断这次攻击。",
		"到边境里找它。把它的试剂交回水之声下的回声束缚，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从风暴蛾身上掉落。敌对的灵需要黑暗。"
	]
	quest.420000000022057C.title: "风暴蛾：归还的歌"
	quest.420000000022057D.quest_desc: [
		"一只敏捷的余烬之灵。它在燃烧的飞矢前聚集火花；这法术从不点燃地形。",
		"到边境里找它。把它的试剂交回灵之声下的回声调谐，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从烬魔身上掉落。敌对的灵需要黑暗。"
	]
	quest.420000000022057D.title: "烬魔：归还的歌"
	quest.420000000022057E.quest_desc: [
		"一件漂浮的遗物，记得失落的部族。它预告的钟声会让人变慢；掩体打断这首歌。",
		"到边境里找它。把它的试剂交回灵之声下的回声调谐，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从悼钟掉落。敌对的灵需要黑暗。"
	]
	quest.420000000022057E.title: "悼钟：归来之歌"
	quest.420000000022057F.quest_desc: [
		"被格子里的裂隙吸引的猎手。它很快拉近距离，却不能独自穿梭于世界之间。",
		"到边境里找它。把它的试剂交回灵之声下的回声调谐，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从裂隙猎犬掉落。敌对的灵需要黑暗。"
	]
	quest.420000000022057F.title: "裂隙猎犬：归来之歌"
	quest.4200000000220580.quest_desc: [
		"破碎之歌的八足看守。咬噬会拖慢猎物，却不结网，也不损坏营地。",
		"到边境里找它。把它的试剂交回水之声下的回声束缚，换一种有用的材料。修有灯的路；敌对的灵需要黑暗。",
		"做法：从回声织者掉落。敌对的灵需要黑暗。"
	]
	quest.4200000000220580.title: "回声织者：归来之歌"
	quest.4200000000220581.quest_desc: [
		"田野笔记写完了。温和的收获和找回的遗物又成了布与回声。夜帷之下，营地以更丰满的歌作答。",
		"稀有奖励：一条 Clowder 共享生命，全队只此一次。整场战役里，这样的奖励只有六个。",
		"做法：灵之抄本 + 部族编织。站点、图腾和脉动消耗写在抄本那一页。"
	]
	quest.4200000000220581.title: "十三声，一片天"
	quest.4200000000220582.quest_desc: [
		"把营地的歌挂进铜里。灵灯笼不耗燃料便给出满光；红石会把它调暗。从黑暗中标出返回的安全路。",
		"做法：三个铜锭、一块灵碎片和一块木板。"
	]
	quest.4200000000220582.title: "归者的灯"
	quest.4200000000220583.quest_desc: [
		"这铃既是饰物，也是乐器。比较器在晴空给出0，雨中8，雷暴15。红石让它安静。",
		"做法：三块木板、三个铜锭和一枚骨铃。"
	]
	quest.4200000000220583.title: "听天气"
	quest.4200000000220584.quest_desc: [
		"一张雕桌能放27组。标准的物品管道和中继可以共享它的供品；比较器读取充满程度，红石则锁住取用。",
		"做法：一个箱子、一个已缚回声、两块木板和两块石头。"
	]
	quest.4200000000220584.title: "炉边一席"
	quest.4200000000220585.quest_desc: [
		"把林园照料放在作物的高度，放进9乘9的畦。种子放在第一行，收获填满下面两行。播种花费4点脉动，收获并重播花费12。在八格内供给动力。输出满了就保留作物，红石暂停工作。自5.0起，它要八格内有一座醒着的土之共鸣图腾，否则就停着，并说出缺的是哪一声。旁边再留一座水图腾，它就会浇灌畦上每一条沟。",
		"做法：一把铁锄、一枚土之印、一份缚回声、两个铜锭和两块木板。"
	]
	quest.4200000000220585.title: "园子还在唱"
	quest.4200000000220586.quest_desc: [
		"每秒八点脉动，挡住二十四格内的敌对生成。已有的生物还在。这层守护也会阻止摇篮的敌对召唤，所以把召唤地留在外面。红石立刻让守护沉默。自5.0起，它要八格内有一座醒着的灵之共鸣图腾，否则就停着，并说出缺的是哪一声。",
		"做法：一枚灵之印、两份缚回声、一块回声碎片和三块边境木板。"
	]
	quest.4200000000220586.title: "营边安静"
	quest.4200000000220587.quest_desc: [
		"路锚每秒用十六点脉动，让自己的区块保持醒着。在远处的中继接收端放一座，并维持当地的动力。同一维度里，最多三十二座锚可以同时运转。红石或空的缓冲会放开区块。自5.0起，它要八格内有一座醒着的土之共鸣图腾，否则就停着，并说出缺的是哪一声。",
		"做法：两块边境水晶、一只末影之眼、两个显化锭、一枚共鸣核心和三块边境石。"
	]
	quest.4200000000220587.title: "记得的营地"
	quest.4200000000220588.quest_desc: [
		"对受支持的生物潜行使用未充能的拟像，取下一个无害的印记。拟像会记住物种。首领不能被绑定；抄本会说明相容的灵，以及如何续绑。",
		"做法：一只骨铃、两块灵织布、一枚共鸣核心和一份缚回声。"
	]
	quest.4200000000220588.title: "借一声活的"
	quest.4200000000220589.quest_desc: [
		"把觉醒塑像安放在第一格，灵织布放在第二格。每次成功召唤消耗80点脉动、一块灵织布和一根缚丝。三格内留出安全的地面。附近八只生物会暂停召唤摇篮；红石会暂停全部工作和自动化。自5.0起，它要一座保存在八格内的灵之共鸣图腾，否则停着不动，并说出缺的是哪一声。",
		"做法：两块显化锭、一块边境水晶、两枚缚回声、一枚共鸣核心和三块边境木板。"
	]
	quest.4200000000220589.title: "借来之命的炉"
	quest.420000000022058A.quest_desc: [
		"把灵之封印放进仪式火盆。在八格以内放上土、风、灵图腾，附近要有200点脉动，物品栏里要有三块灵织布。用印记塑像点火盆，唤醒512根召唤丝。全部用尽后，再做一次这个仪式，以重续束缚。",
		"做法：灵之封印放入仪式火盆；土、风、灵图腾在8格内；200脉动；三块灵织布；使用印记塑像。"
	]
	quest.420000000022058A.title: "三声唤醒丝线"
	quest.420000000022058B.quest_desc: [
		"完成一次成功的召唤。失败或被拦住的尝试不消耗丝线，也不消耗祭品。每一道束缚能撑512次成功召唤；拆掉再放回召唤摇篮，绝不会更新这道束缚。塑像的提示显示剩余次数，比较器读取摇篮剩余的束缚强度。",
		"做法：从召唤摇篮完成一次成功的召唤。失败的尝试什么都不消耗。"
	]
	quest.420000000022058B.title: "摇篮的回答"
	quest.4200000000228001.quest_desc: [
		"门鼓之外，边境的草原与高地藏着沉没的先祖大厅。走进去就会勾上这项。每座厅沿墙四块传说石板；每一块都要读。箱子里有织机丝线、回声、灵织布和封印。空心哨卫仍在看守。",
		"做法：用门鼓进入边境，走进一座先祖大厅；然后读完它的四块传说石板。"
	]
	quest.4200000000228001.title: "守时的厅堂"
	quest.4200000000228002.quest_desc: [
		"织机丝线就是手里的织机：先祖大厅的箱子里有两到四根，未歌者扯出十六根或更多，织机缝匠的长老在友人声望换一根。它是第六声的试剂。",
		"做法：先祖大厅的箱子、未歌者，或友人声望的织机缝匠长老。"
	]
	quest.4200000000228002.title: "丝线本身的丝缕"
	quest.4200000000228003.quest_desc: [
		"八块边境石围着一块回声碎片，做出两块传说石板。放下去，石板会显示九个部族的一段；创造模式潜行使用会轮换是哪一个。用它们铺满你自己的厅。",
		"做法：八块边境石围着一块回声碎片。做出两块。"
	]
	quest.4200000000228003.title: "刻下你读到的"
	quest.4200000000228004.quest_desc: [
		"皮革铺在边境木板上，围着一枚共鸣核心。边境高地的鼓圈里已经有一面；这一面归你，安放在家里。打四下，拍与拍之间隔一口气，便有古老的东西升起。",
		"做法：三份皮革、五块边境木板和一枚共鸣核心。"
	]
	quest.4200000000228004.title: "不会响的鼓"
	quest.4200000000228005.quest_desc: [
		"未歌者是三段的鼓灵。节拍：潜行顶住它的冲击波。合唱：砍倒它召来的回声织者。静默：你用同样的四拍节奏敲响寂鼓之前，它不受伤。这一节奏会击晕它，并让你造成的伤害翻倍。带上充能的脉动胞，并备好归路。",
		"做法：在寂鼓处与未歌者战斗。节拍时潜行；静默时打四拍。"
	]
	quest.4200000000228005.title: "鼓还记得"
	quest.4200000000228006.quest_desc: [
		"每次击杀一枚未歌者之心，旁边还有织机丝线和共鸣核心。它只用来做织机图腾，别的做不了，所以省着花。",
		"做法：寂鼓处的未歌者每次击杀掉落一枚。"
	]
	quest.4200000000228006.title: "止息之鼓"
	quest.4200000000228007.quest_desc: [
		"在织机丝线与边境水晶之间放一枚未歌者之心，底下是边境木板。织机加入土、火、水、气与灵：给脉动共鸣器一个不同的声，也是回声拆织和地脉结契所要的调谐。",
		"做法：一枚未歌者之心、四枚边境水晶、两根织机丝线、两块边境木板。"
	]
	quest.4200000000228007.title: "第六声"
	quest.4200000000228008.quest_desc: [
		"一枚空白印记和织机丝线。安进仪式火盆后，织机印记祝福张力：每两秒为范围内每个人随身的脉动胞回补两点脉动，并借予幸运。",
		"做法：一枚空白印记和织机丝线，无序合成。"
	]
	quest.4200000000228008.title: "张力之印"
	quest.4200000000228009.quest_desc: [
		"织机丝线和铜共鸣器放在边境之石上。在织机之声下，回声拆织让网格倒着运转：一块显化锭变成两枚已束缚的回声，束缚变成两枚已调谐，调谐变成两块碎片，灵织布变成两份羊毛，一枚共鸣核心变成三块显化锭，任何磨损的灵装工具变成一块显化锭。",
		"做法：五块边境之石、织机丝线、两台铜共鸣器和一块灵碎片。"
	]
	quest.4200000000228009.title: "网格，倒着"
	quest.420000000022800A.quest_desc: [
		"把六叠法杖切到它的织机之声。系索会把目标朝你拉八格，花费六脉动；没有目标时潜行施放是缝针，在空中闪现六格，花费十。两个都用过后勾选这项。",
		"做法：六叠法杖切到织机之声。系索一个目标，然后潜行施放缝针。两者都发动后勾选。"
	]
	quest.420000000022800A.title: "系索与缝针"
	quest.420000000022800B.quest_desc: [
		"九座部族营地立在边境，每条丝缕一座：棚屋、一堆火、一座部族炉床、一座图腾、一面旗帜，还有四名部族亲族。用该部族所喜之物，或一块充能的脉动胞，右键炉床，你在他们那里的声望就会上升。伤害亲族扣25。拆掉部族旗帜扣5，炉床扣40。普通营地方块不扣。",
		"做法：用该部族所喜之物，或一块充能的脉动胞，右键边境的部族炉床。"
	]
	quest.420000000022800B.title: "一直暖着"
	quest.420000000022800C.quest_desc: [
		"客人在50，友人在150，亲族在400，声在800。炉边的击杀和完成的交易也算数。长老每个等级交易两样：砾歌者用粗矿换回声，印刻者卖印记和仪式石板，织机缝匠卖织机丝线和一枚路碑指南针，到亲族再卖一枚织机锚和一枚织机印记。`/tribalpower standing` 会列出全部九个。",
		"做法：和一个部族达到友人（150）。 /tribalpower standing."
	]
	quest.420000000022800C.title: "交好"
	quest.420000000022800D.quest_desc: [
		"到声音声望时，长老会把一枚部族标记按进你手里，只此一次。它打开该部族的抄本页，也是亲族图腾缺一不可的那一样材料。",
		"做法：和一个部族达到声（800）；长老给一次部族标记。"
	]
	quest.420000000022800D.title: "九方相合"
	quest.420000000022800E.quest_desc: [
		"拿着一枚部族标记。每个部族的都不一样；一共可以有九枚。",
		"做法：和一个部族达到声（800）；其长老给一次标记。"
	]
	quest.420000000022800E.title: "部族之标"
	quest.420000000022800F.quest_desc: [
		"一块部族标记、该部族调谐的共鸣图腾，以及两块灵织布。亲族图腾算作脉动共鸣器多出的一个不同的声，并把该部族的调谐借给站点，于是九个部族能把营地的歌带到十五声。",
		"做法：在合成格里放一块部族标记、该部族的共鸣图腾和两块灵织布。"
	]
	quest.420000000022800F.title: "不是声的声"
	quest.4200000000228010.quest_desc: [
		"营地的鼓手每隔几秒敲一下；把一面鼓心放在距其一八个方块内，每一拍就喂给它两点脉动。当鼓手正在喂你的网格时，勾选此项。",
		"做法：把鼓心放在营地鼓手的8格内；它在送入脉动时勾选。"
	]
	quest.4200000000228010.title: "营地守着节拍"
	quest.4200000000228011.quest_desc: [
		"两块石头和试剂围着印章；印章会还回来。结根放在大地印章旁边；600脉动。二十分钟内，火盆周围九个区块里的作物、树苗和茎长得更快。在安好该印章的仪式火盆上，于其仪式环内潜行使用仪式石板（四座基座在对角线上，粉笔把它们连起来）；脉动从八个方块内的网格抽取。",
		"做法：两块石头、一枚结根和一枚大地印章，无序合成；印章会回来。"
	]
	quest.4200000000228011.title: "仪式石板：绿色祝福"
	quest.4200000000228012.quest_desc: [
		"两块石头和试剂围着印章；印章会还回来。芦牙放在水之印章旁边；400脉动。二十分钟的雨，为了蓄槽和作物。在安好该印章的仪式火盆上，于其仪式环内潜行使用仪式石板（四座基座在对角线上，粉笔把它们连起来）；脉动从八个方块内的网格抽取。",
		"做法：两块石头、一枚芦牙和一枚水之印章，无序合成；印章会回来。"
	]
	quest.4200000000228012.title: "仪式石板：唤雨"
	quest.4200000000228013.quest_desc: [
		"两块石头和试剂围着印章；印章会还给你。风暴之翼放在风印记旁；400脉动。四十分钟晴空。在仪式环内，对安放着该印章的仪式火盆潜行使用石板（对角线上四座台座，粉笔将它们相连）；脉动从八格内的网格中抽取。",
		"做法：两块石头、一枚风暴之翼和一枚风印记，无序合成；印章会回来。"
	]
	quest.4200000000228013.title: "仪式石板：放晴"
	quest.4200000000228014.quest_desc: [
		"两块石头和试剂围着印章；印章会还给你。余烬之心放在火印记旁；800脉动。把夜催到下一次日出，对整个世界生效。在仪式环内，对安放着该印章的仪式火盆潜行使用石板（对角线上四座台座，粉笔将它们相连）；脉动从八格内的网格中抽取。",
		"做法：两块石头、一枚余烬之心和一枚火印记，无序合成；印章会回来。"
	]
	quest.4200000000228014.title: "仪式石板：唤晓"
	quest.4200000000228015.quest_desc: [
		"两块石头和试剂围着印章；印章会还给你。哨卫印记放在灵印记旁；600脉动。十五分钟内，六十四格内不生成敌对生物。在仪式环内，对安放着该印章的仪式火盆潜行使用石板（对角线上四座台座，粉笔将它们相连）；脉动从八格内的网格中抽取。",
		"做法：两块石头、一枚哨卫印记和一枚灵印记，无序合成；印章会回来。"
	]
	quest.4200000000228015.title: "仪式石板：静夜"
	quest.4200000000228016.quest_desc: [
		"两块石头和试剂围着印章；印章会还给你。织机丝线放在织机印记旁；1200脉动。把最近的图腾与六十四格内的另一座用一条三十分钟的地脉连起来，在它们之间导引脉动。在仪式环内，对安放着该印章的仪式火盆潜行使用石板（对角线上四座台座，粉笔将它们相连）；脉动从八格内的网格中抽取。",
		"做法：两块石头、织机丝线和一枚织机印记，无序合成；印章会回来。"
	]
	quest.4200000000228016.title: "仪式石板：地脉结契"
	quest.4200000000228017.quest_desc: [
		"举行任意一个仪式。若火盆周围的网格里脉动太少，什么都不会消耗，火盆会说出来。",
		"做法：在仪式环内的仪式火盆上潜行使用任意仪式石板，印章与脉动需相符。"
	]
	quest.4200000000228017.title: "第一次仪式"
	quest.4200000000228018.quest_desc: [
		"两块灵织布、一块灵碎片和该物种的试剂。对成年使魔使用。动物：百分之六十，失败时护符留下。残灵要与其部族达到声，百分之四十，失败时护符花掉。",
		"做法：两块灵织布、一块灵碎片和一份使魔试剂（黎明丝绒、灯笼绒、风暴之翼之类）。"
	]
	quest.4200000000228018.title: "给野物的护符"
	quest.4200000000228019.quest_desc: [
		"结契的使魔会跟随你，传送着跟上你，永不消失，你伤不了它，刷它时产出加倍。灯狐、苔背和黎明雄鹿是你的起点。残灵需要声。一名战士和两名帮手可以跟随；坐下的不算。",
		"做法：对成年使魔使用结缘护符。第一次结契时，进度会触发。"
	]
	quest.4200000000228019.title: "暗中的朋友"
	quest.420000000022801A.quest_desc: [
		"纸、灵织布和一块灵碎片。对玩家使用宪章，邀请其加入你的营地，或对空气使用以查看营地。`/tribalpower camp` 可以创建、邀请、加入、离开、踢出和改名。",
		"做法：纸、灵织布和一块灵碎片，无序。"
	]
	quest.420000000022801A.title: "众声的营地"
	quest.420000000022801B.quest_desc: [
		"营地成员共享每座深藏和每只旅人挎包背后的五十四格营地库，彼此算作对方装置的主人，汇集十二座路锚，并把部族名望的四分之一映到营地。Clowder 不是那个营地 — /tribalpower camp create <name> 才是。",
		"做法：/tribalpower camp create <name>（不是 Clowder）。第一次建立营地时，进度会触发。"
	]
	quest.420000000022801B.title: "一座库，一份预算"
	quest.420000000022801C.quest_desc: [
		"一块玻璃板，放在铜共鸣器和灵碎片之上。拿着时，透镜显示你所站之处的地脉强度，并把它画在周围的地面上；对地脉收集器或使魔潜行使用，可看它的数值。",
		"做法：一块玻璃板、一台铜共鸣器和一块灵碎片，排成一列。"
	]
	quest.420000000022801C.title: "看见地脉"
	quest.420000000022801D.quest_desc: [
		"石英在红石与铜共鸣器之上，下面是边境石。对准任何脉动容器时，按储存量的比例输出0到15的红石信号。",
		"做法：石英、两个红石、一台铜共鸣器和边境石。"
	]
	quest.420000000022801D.title: "脉动之针"
	quest.420000000022801E.quest_desc: [
		"红石火把在红石与铜共鸣器之上，下面是边境石。所对的容器达到或超过阈值时它才输出；右键在百分之25、50、75和100之间轮换。脉动驱动的自动化零件。",
		"做法：一支红石火把、两个红石、一台铜共鸣器和边境石。"
	]
	quest.420000000022801E.title: "歌里的一行"
	quest.420000000022801F.quest_desc: [
		"对任意部族方块潜行使用灵之抄本，得到一份明白的报告：储存的脉动、给它供能的发生器、八格内的调谐、当前配方缺什么、已满的输出、红石暂停、未加载的中继端。它告诉你一件你不知道的事时，勾选此项。",
		"做法：对部族方块潜行使用灵之抄本；报告指出真实故障时勾选。"
	]
	quest.420000000022801F.title: "问抄本为何"
	quest.4200000000228020.quest_desc: [
		"向石泉讨圆石。石不是造出来的；是请石留下。圆石只要形状和脉动；八格内有土图腾，它就能讨石。",
		"做法：五块圆石、一块回声碎片和一个鼓心。"
	]
	quest.4200000000228020.title: "石之泉"
	quest.4200000000228021.quest_desc: [
		"完成任意纹样。摆放就是仪式：散落的装置不算仪式。",
		"做法：放下灵之抄本里的仪式纹样；第一次圆完整时，进度会触发。"
	]
	quest.4200000000228021.title: "画下圆"
	quest.4200000000228022.quest_desc: [
		"向石泉讨第一块圆石。石不是造出来的；是请石留下。",
		"做法：让石泉运转，直到圆石出现。第一次留下时触发进度。"
	]
	quest.4200000000228022.title: "石留下"
	quest.4200000000228023.quest_desc: [
		"石泉工作时，对它潜行使用灵之抄本。报告点出储存的脉动或缺的图腾时，勾选此项。",
		"做法：对石泉潜行使用灵之抄本；报告指出真实故障或已满的缓冲时勾选。"
	]
	quest.4200000000228023.title: "泉作答"
	quest.4200000000228024.quest_desc: [
		"在泉边留一枚充能的胞，免得询问停住。",
		"做法：用鼓心充满一枚脉动胞，泉得到供给时勾选此项。"
	]
	quest.4200000000228024.title: "泉边的胞"
	quest.4200000000228025.quest_desc: [
		"网不找矿石；网给矿石一个落地的地方。把它安放在聆听坑上方。",
		"做法：四块边境石、两枚已调谐的回声、两份灵织布和一台铜共鸣器。"
	]
	quest.4200000000228025.title: "倾听的网"
	quest.4200000000228026.quest_desc: [
		"四块锚石撑住坑的四角。没有它们，网无处可立。",
		"做法：四块边境石放在一块回声碎片上。做出四个。"
	]
	quest.4200000000228026.title: "四座锚"
	quest.4200000000228027.quest_desc: [
		"经由聆听坑唤上第一份矿石。",
		"做法：共鸣网放在有锚石的坑上；第一份矿石出现时，进度会触发。"
	]
	quest.4200000000228027.title: "向地询问"
	quest.4200000000228028.quest_desc: [
		"坑里的金砂砾，是铁之后的下一道声。",
		"做法：继续向地询问；金砂砾到手时勾选。"
	]
	quest.4200000000228028.title: "坑中之金"
	quest.4200000000228029.quest_desc: [
		"坑会消耗脉动。在网上留一枚胞，免得询问停住。",
		"做法：用鼓心充满一枚脉动胞，安放到抄本所示之处。"
	]
	quest.4200000000228029.title: "坑守着节拍"
	quest.420000000022802A.quest_desc: [
		"十一扇门框和拱心石把路环成一圈。缺一框，就缺一步。",
		"做法：六块边境石、两个铜锭和一块回声碎片。做出四个。"
	]
	quest.420000000022802A.title: "路的框"
	quest.420000000022802B.quest_desc: [
		"拱心石是第十二块石。没有它，环只是纹样。",
		"做法：四扇门框、一枚共鸣核心、一块灵碎片和一枚脉动胞。"
	]
	quest.420000000022802B.title: "拱心石"
	quest.420000000022802C.quest_desc: [
		"点亮一座路门。十一扇框、一块拱心石，以及一个可去之处。",
		"做法：完成环并点亮它；路打开时，进度会触发。"
	]
	quest.420000000022802C.title: "开路"
	quest.420000000022802D.quest_desc: [
		"对拱心石潜行使用印记，把它记下。再用到第二块拱心石上，把两者系在一起。",
		"做法：一枚空白印记、织机丝线和一块灵碎片，无序。"
	]
	quest.420000000022802D.title: "写下目的地"
	quest.420000000022802E.quest_desc: [
		"经远门从一个维度走到另一个。织机从来不是一根丝线。",
		"做法：用门印记系住两块拱心石，然后走过远门。"
	]
	quest.420000000022802E.title: "长丝"
	quest.420000000022802F.quest_desc: [
		"火的发生器。把它安放在图腾近处；拿在手里的鼓心带不动这道声。",
		"做法：三个铜锭、一枚余烬结、一枚火印记和两块边境木板。"
	]
	quest.420000000022802F.title: "火之声"
	quest.4200000000228030.quest_desc: [
		"风的发生器。把它安放在图腾近处，好让六个彼此听见。",
		"做法：四份灵织布、一枚风暴之翼、一枚风印记和两块边境木板。"
	]
	quest.4200000000228030.title: "风之声"
	quest.4200000000228031.quest_desc: [
		"水的发生器。把它安放在图腾近处；水窖和泉听这道声。",
		"做法：两份皮革、三块边境木板、一枚结根和一枚水之印章。"
	]
	quest.4200000000228031.title: "水之声"
	quest.4200000000228032.quest_desc: [
		"醒钟是灵的长音。把它和另外五个一起安放在图腾近处。",
		"做法：一块钟碎片、四个铜锭、一枚灵之印和一块灵碎片。"
	]
	quest.4200000000228032.title: "大地的苏醒"
	quest.4200000000228033.quest_desc: [
		"第六台发电机。织机之声需要织机丝线；未歌者和织机缝匠的长老保管着它。",
		"做法：四块边境水晶、两根织机丝线、两块灵织布和一枚共鸣核心。"
	]
	quest.4200000000228033.title: "第六台发电机"
	quest.4200000000228034.quest_desc: [
		"石堆在场中储存脉动，让六个声共用一份缓冲。",
		"做法：六块边境石、两枚束缚回声和一枚脉动胞。"
	]
	quest.4200000000228034.title: "脉动石堆"
	quest.4200000000228035.quest_desc: [
		"让六台发电机都在彼此32格内运转，一种声音一台。",
		"做法：余烬号角、风竖琴、浪鼓、醒钟、织机锚和鼓心放在32格内。六声达成进度。"
	]
	quest.4200000000228035.title: "六声在唱"
	quest.4200000000228036.quest_desc: [
		"向一座水窖请求继续给予。十分钟的水，印章留下。",
		"做法：在仪式环内的仪式火盆上潜行使用石板，印章与脉动需相符。"
	]
	quest.4200000000228036.title: "不停给予的泉"
	quest.4200000000228037.quest_desc: [
		"未歌者仍记得的鼓圈。可选的纪念品。",
		"做法：寂鼓处的未歌者可能掉落它。可选。"
	]
	quest.4200000000228037.title: "鼓圈"
	quest.4200000000228038.quest_desc: [
		"第一次仪式之后的空白印记，准备好进入下一个环。",
		"做法：在火盆处举行第一次仪式；手里有一枚备用空白印记时勾选。"
	]
	quest.4200000000228038.title: "备用印记"
	quest.4200000000228039.quest_desc: [
		"火焰工坊。八格内的火图腾加上脉动，能跑所有熔炉配方，包括矿物砂砾。手里的鼓心维持不了这座窑。",
		"做法：熔炉 + 共鸣器 + 铃。火图腾。用脉动熔炼砂砾——手里的鼓心运转不了它。"
	]
	quest.4200000000228039.title: "窑中砂砾"
	quest.420000000022803A.quest_desc: [
		"为工坊织一枚配方印。空瓶会回到原来放它们的格子。侧面输入输出拒绝旁观者和别的营地。自5.0起，它要八格内一座醒着的共鸣图腾（织机），否则就停着，并说出缺的是哪一声。",
		"做法：灵之抄本写出印记织机的做法。把瓶子安放好；它们会回到那个格子。"
	]
	quest.420000000022803A.title: "为印记而设的织机"
	quest.420000000022803B.quest_desc: [
		"四盏便宜的脉动灯（荧光芦苇、碎片灯、回声壁灯、余烬碗）从网格每秒抽取1–2点脉动。红石会把它们调暗。",
		"做法：制作一盏碎片灯，放在脉动八格以内，想要夜晚就用红石把灯调暗。"
	]
	quest.420000000022803B.title: "饮脉动的灯"
	quest.420000000022803C.quest_desc: [
		"十枚灵护符戴在三个部族槽里，不用 Curios。天空配气就是创造飞行。潜行使用共鸣图腾来束缚一声；合唱在火盆上束缚附近的每一声。",
		"做法：制作天空护符，然后在气之图腾上潜行使用。灵之抄本：灵护符。"
	]
	quest.420000000022803C.title: "有声音的护符"
	quest.420000000022803D.quest_desc: [
		"水之工坊。在回声站给它升阶，和灵装一样；阶越高，加快时花的脉动越多。阶在捡起后仍在。自5.0起，它要八格内一座醒着的水之共鸣图腾，否则就停着，并说出缺的是哪一声。",
		"做法：灵之抄本的工坊页。把潮汐泵放在蓄槽的一面上，若它仍沉默，就潜行使用抄本。"
	]
	quest.420000000022803D.title: "给蓄槽的泵"
	quest.420000000022803E.quest_desc: [
		"每一点脉动仍然变成 100 FE。无阶转换是每秒 60 脉动。在回声调谐、再回声束缚、再回声显化给转接器升阶，空手状态会报出当前速率。它仍然不能接收 FE。",
		"做法：把谐能激发器依次潜行使用在回声调谐、回声束缚、回声显化上。诊断报出高于60的速率时勾选。"
	]
	quest.420000000022803E.title: "电流升阶"
	quest.420000000022803F.quest_desc: [
		"在已放置的共鸣图腾上潜行使用任意灵装部件或护符（40脉动），以束缚那一声。混搭是设计本意。图腾不会被消耗。织机需要一座织机图腾。",
		"做法：在附近有40脉动的图腾上，潜行使用工具、护甲或护符。提示框报出已束缚的声音时勾选。"
	]
	quest.420000000022803F.title: "束缚一声"
	quest.4200000000228040.quest_desc: [
		"一盏芦苇灯。给营地小路用的便宜脉动光。可选。",
		"做法：制作荧光芦苇。放在脉动附近。可选。"
	]
	quest.4200000000228040.title: "芦苇灯"
	quest.4200000000228041.quest_desc: [
		"一盏饮脉动的壁灯。可选。",
		"做法：制作回声壁灯并挂上。可选。"
	]
	quest.4200000000228041.title: "回声壁灯"
	quest.4200000000228042.quest_desc: [
		"一碗靠脉动点亮的营地火光。可选。",
		"做法：制作余烬碗。可选。"
	]
	quest.4200000000228042.title: "余烬碗"
	quest.4200000000228043.quest_desc: [
		"把风之护符从天花板挂下。边境营地家具：凳、桌、瓮、席、架，还有这个。可选。",
		"做法：制作风之护符并挂上。可选的纪念品。"
	]
	quest.4200000000228043.title: "风中的护符"
	quest.4200000000228044.quest_desc: [
		"合唱在仪式火盆上束缚附近每一座图腾的声音。手上已有天空就可以选做。",
		"做法：制作合唱护符，然后在声音范围内的火盆上潜行使用。可选。"
	]
	quest.4200000000228044.title: "附近的每一声"
	quest.4200000000228045.quest_desc: [
		"这把斧和镐一样消耗脉动。在回声站给它升阶；潜行使用图腾来束缚一声。可选。",
		"做法：制作灵装斧。镐有了之后可选。"
	]
	quest.4200000000228045.title: "伐木之刃"
	quest.4200000000228046.quest_desc: [
		"砖块和一只碗放在三块铜上方。把它放在点燃的营火、火、岩浆、熔岩或余烬碗上；它完全不索取脉动。最多四样食材加一只碗，次序不限，一餐大约十二秒。漏斗从上方和侧面送入，从下方取出饭食。",
		"做法：砖块和一只碗放在三块铜上方。把它放在营火、火、岩浆、熔岩或余烬碗上；不要脉动。"
	]
	quest.4200000000228046.title: "营地用锅"
	quest.4200000000228047.quest_desc: [
		"来自余烬荒地的炽热红块茎。你采下的就是种子；像马铃薯一样种在耕地上。灵装锄一挥就收割并重新种下。",
		"做法：经门鼓，在余烬荒地野生生长。你采下的就是种子；种在耕地上。"
	]
	quest.4200000000228047.title: "余烬根"
	quest.4200000000228048.quest_desc: [
		"在芦苇泽野生生长。采下一片，把采到的种下；在翻耕的土地上长四个阶段，蜜蜂会给它授粉。",
		"做法：经门鼓，在芦苇泽野生生长。把采到的种在耕地上。"
	]
	quest.4200000000228048.title: "沼米"
	quest.4200000000228049.quest_desc: [
		"来自雪原。它也算灵壶用的草药。",
		"做法：经门鼓，在雪原野生生长。把采到的种在耕地上。"
	]
	quest.4200000000228049.title: "霜莓"
	quest.420000000022804A.quest_desc: [
		"来自微光岭。既是灵壶的草药，也是作物。",
		"做法：经门鼓，在微光岭野生生长。把采到的种在耕地上。"
	]
	quest.420000000022804A.title: "微光豆"
	quest.420000000022804B.quest_desc: [
		"来自草原，也是大多数部族菜的底子。先种上一畦，再种别的。",
		"做法：经门鼓，在草原野生生长。把采到的种在耕地上。"
	]
	quest.420000000022804B.title: "草原谷物"
	quest.420000000022804C.quest_desc: [
		"两份草原谷物和一份铁砂砾，放进炉锅。吃下一部族的菜，便带着它的恩惠，持续五分钟；砾歌者的恩惠从矿石敲出更多。一个部族称你为友人后，其亲族用四份该族作物出售这道菜，在部族的炉前献上它自己的菜，得到六点名望。",
		"做法：两份草原谷物和一份铁砂砾，放进炉锅，置于热源上。砾歌者的亲族在友人声望时出售它。"
	]
	quest.420000000022804C.title: "砾歌者的面包"
	quest.420000000022804D.quest_desc: [
		"两份生猎物和一份余烬根。生猎物从边境的猎物身上掉落。缘行者的恩惠：潜行时你永不坠落。每个部族都有一道菜；JEI 在这口锅下列出全部九道。",
		"做法：两份生猎物和一份余烬根，放进炉锅。生猎物从边境的猎物身上掉落。"
	]
	quest.420000000022804D.title: "缘行者的肉干"
	quest.420000000022804E.quest_desc: [
		"看守的根泥、砂砾烤面包、一份余烬根和草原谷物放进锅里。把宴放在实心方块上，它盛六份；每一份都喂饱你，并给予土之祝福八分钟——挖得更快，站稳。每个声都有一场用自己的菜做成的宴。",
		"做法：看守的根泥、砂砾烤面包、余烬根和草原谷物放进炉锅。放下它；六份。"
	]
	quest.420000000022804E.title: "营地的一桌"
	quest.420000000022804F.quest_desc: [
		"骨头和铁围住炼药锅，下面放一只骨铃。把它放在热源上。三个座位：从你的袋子取出一份粗制试剂、一味边境草药，以及一种基料——玻璃瓶做成两份酊剂，蜜脾两份药膏，木炭四份熏香。一批是十秒，并从网格取24点脉动。八个方块内最近的图腾把歌唱进这锅药里。",
		"做法：骨头和铁围住炼药锅，下面放骨铃。把它放在热源上；8格内的图腾塑造这锅药。"
	]
	quest.420000000022804F.title: "火上的壶"
	quest.4200000000228050.quest_desc: [
		"试剂的家族选定药剂：引火是力量，冷却是抗火，解毒解除中毒，修补是生命恢复，以此类推。酊剂持续三分钟，并把瓶子还你。每种药剂都能解除灵症、未歌静默、绽损和地脉症。",
		"做法：灵壶——一份粗制试剂、一味边境草药和一只玻璃瓶。十秒，24点脉动，两份酊剂。"
	]
	quest.4200000000228050.title: "喝下"
	quest.4200000000228051.quest_desc: [
		"以蜜脾为基料。把药膏用在自己身上，或用在朋友、村民或你的使魔身上：一次三颗心，一切有害效果都消失，药剂持续酊剂一半的时间。有一叠这种东西，边境难熬的一夜和走回家，差别就在这里。",
		"做法：灵壶——一份粗制试剂、一味边境草药和一块蜜脾。一批两份药膏。"
	]
	quest.4200000000228051.title: "涂上"
	quest.4200000000228052.quest_desc: [
		"以木炭为基料。把熏香安放在仪式火盆里——最多十六支，不要印记，也不要脉动——每两秒，八格内的每个人都得到药剂，使魔被修补一颗心。每支燃烧三十秒。红石会把它熄灭；空手潜行即可取回。",
		"做法：灵壶——一份粗制试剂、一味边境草药和木炭。一批四支熏香；在仪式火盆里烧掉。"
	]
	quest.4200000000228052.title: "为众人点燃"
	quest.4200000000228053.quest_desc: [
		"一根木棍上放一块显化锭，两侧各一只骨铃。按住使用，每半秒修补你在六格内看着的人，或你自己：花费2点脉动，回复四分之三个心。它像其余灵装一样在回声台评级；从束缚起，每摇一次，灵症减轻一级。",
		"做法：一根木棍上放一块显化锭，两侧各一只骨铃。按住使用，修补你看着的人。"
	]
	quest.4200000000228053.title: "摇一摇"
	quest.4200000000228054.quest_desc: [
		"圆石放在岩浆块上，做出四个。在热上它们会冒汽。热石在五格内、头顶有屋顶时，在床上睡完整一夜：你醒来已完全痊愈、被净化，并带有十分钟灵之祝福，病无法上身。",
		"做法：圆石放在岩浆块上方，做出四个。放在有顶床五格内的热源上。"
	]
	quest.4200000000228054.title: "小屋一夜"
	quest.4200000000228055.quest_desc: [
		"两块石头、一块苔背鳞和灵苇围着一枚灵印记；印章会交还。在其仪式环内，对着坐有灵印记的火盆施放，消耗500脉动：十二格内的每个人恢复十颗心，被净化并得到祝福，环开启十分钟。先把倒下的使魔的灵之残响放上基座，它便会完整回来。",
		"做法：两块石头、一块苔背鳞、灵苇和一枚灵印记，无序合成；印章会回来。在其仪式环内，对坐着印章的火盆施放。"
	]
	quest.4200000000228055.title: "仪式石板：治愈之环"
	quest.4200000000228056.quest_desc: [
		"一块显化锭、一只骨铃和一根木棍斜向摆放。七点伤害，触及增加一点五，冲刺突刺重百分之三十五。它的下方是刃：在回声台评级，把脉动花在回声打击上，并接受一种图腾之声。它把裂隙猎犬隔在一臂之外。",
		"做法：显化锭、骨铃和木棍斜向摆放。在回声台像刃一样评级。"
	]
	quest.4200000000228056.title: "先要触及"
	quest.4200000000228057.quest_desc: [
		"四块显化锭在骨铃上方排成T形。十点伤害，触及增加一半，沉重——拿在手里时脚步变慢——并且是这一族里最宽、最强的横扫。戟、战斧、战锤、匕首、镰刀和三叉戟做法相同；每一件都在触及、速度和重量上彼此取舍。",
		"做法：四块显化锭在骨铃上方排成T形。沉重；最宽的横扫。"
	]
	quest.4200000000228057.title: "最宽的横扫"
	quest.4200000000228058.quest_desc: [
		"线和铜共鸣器围着骨铃。用你携带的电池中的脉动射出音波弹，也能装诗节箭。很快能再次松弦，赶时间可以只拉一半。",
		"做法：线和铜共鸣器围着骨铃。用携带的脉动射出音波弹。"
	]
	quest.4200000000228058.title: "会唱的弓"
	quest.4200000000228059.quest_desc: [
		"显化锭放在脉动弓两侧，绊线钩和木棍放在下方。按住使用来装填——先付10脉动，比满拉稍久——然后再次使用射出。大约再狠一半，几乎直线飞出，待发能保持多久都行。",
		"做法：显化锭放在脉动弓两侧，下方是绊线钩和木棍。按住使用装填，使用射出。"
	]
	quest.4200000000228059.title: "弓的更重姐妹"
	quest.420000000022805A.quest_desc: [
		"歌声台在产出旁有一个武器席。在够得到的地方立一座图腾，网格里要有脉动，把装有四份同一类已强化试剂的试剂袋留在快捷栏，放入一件灵装武器，选中试剂并按下涂油：四份试剂和32脉动。灼烧会燃烧，唤雷会让闪电走弧，嗜血会偷取生命，修补会修复武器——一共十一种，一次一种；换一种试剂就会替换它。除非整合包开放 tribalpower:anointable，否则只有灵装接受这台的工作。当一件武器带上一种时，勾选这项。",
		"做法：歌声台的武器席放入灵装武器，袋子里四份已强化试剂，32脉动；按下涂油。涂好后勾选。"
	]
	quest.420000000022805A.title: "刃中的试剂"
	quest.420000000022805B.quest_desc: [
		"藤蔓围着灵苇，再加一颗末影珍珠，做出两个。同一竖列的每一层各放一个；它们会彼此找到，不用连接，也不用能量。跳跃升到上方下一台升降机，潜行降到下方那一台，每个方向最多48格。顶上有天花板的升降机会被跳过。",
		"做法：藤蔓围着灵苇，再加一颗末影珍珠，做出两个。把它们叠在同一竖列；跳跃上升，潜行下降。"
	]
	quest.420000000022805B.title: "沿柱而上"
	quest.420000000022805C.quest_desc: [
		"线下面放灵苇。对生物使用就带走，对方块使用就放下，平安而完整。绝不能是玩家、首领或边境精英。织成是两次——一趟来回；铜瓮、显化瓮和共鸣瓮装得更多，共鸣的永不磨损。只剩一次时，它不会带走生物。",
		"做法：线下面放灵苇。对生物使用以带走，对方块使用以放下。两次。"
	]
	quest.420000000022805C.title: "带生物回家"
	quest.420000000022805D.quest_desc: [
		"皮革铺在木板上，围着音符盒。把门仪做成一场结尾没有传送门的游戏：其中收录的每首曲子，在拍子到达判定线时用 A、S、D、F 演奏。它记下你每首曲子的最高分，以及服务器前五名的榜。在真正的门鼓之前，先在这里练习。",
		"做法：皮革铺在木板上，围着音符盒。用它选一首曲子，并用 A、S、D、F 演奏。"
	]
	quest.420000000022805D.title: "为乐而鼓"
	quest.420000000022805E.quest_desc: [
		"四块荧石围着一枚灵印记，两块显化锭、一根金胡萝卜和灵织布。使用以佩戴；潜行使用打开三个护符槽。灯笼护符带着灵之声：夜视，而且你身上任何声的祝福都会再长一半。佩戴的护符从随身的脉动电池里，每个声每两秒消耗2点脉动。",
		"做法：四块荧石围着一枚灵印记，两块显化锭、一根金胡萝卜和灵织布。使用以佩戴；潜行使用打开槽位。"
	]
	quest.420000000022805E.title: "穿在身上的光"
	quest.420000000022805F.quest_desc: [
		"一旦部族称你为客人，就右键它的长老并交谈。向他们要活，他们会交给你一项请求——每天开放三个，每个部族手里只留一个，每个都付声望，每第三个给一枚部族标记。请他们讲故事，一条七步的路就开始了：友人、他们珍视的东西、在火堆边狩猎、营地里的一场仪式、他们的菜做好，以及他们派你去的地方。最后一步是与一名守护者的试炼。完成一则故事，并持有它的遗物。",
		"做法：在客人及以上右键部族的长老，请他们讲故事；七步止于一名守护者。进度在第一件遗物时触发。"
	]
	quest.420000000022805F.title: "讲过的故事"
	quest.4200000000228060.quest_desc: [
		"浮台看守的遗物。他们的故事在草原践踏之圈的奔踏之灵处结束；赢得试炼，长老便把它交给你。只要放在物品栏的任何地方，不论你的声望如何，它都把他们的恩惠留在你身上：你永不践踏田地。",
		"做法：与他们的长老完成浮台看守的故事；试炼是草原上的奔踏之灵。"
	]
	quest.4200000000228060.title: "守住的余烬"
	quest.4200000000228061.quest_desc: [
		"砾歌者的遗物。他们的故事止于水晶原歌唱裂隙处的棱镜巨蛇；赢得试炼，长老便把遗物交给你。只要放在物品栏的任何地方，不论你的声望如何，都会把他们的恩惠留在你身上：你从矿石里敲出更多。",
		"做法：和砾歌者的长老一起完成他们的故事；试炼是水晶原的棱镜巨蛇。"
	]
	quest.4200000000228061.title: "鸣石"
	quest.4200000000228062.quest_desc: [
		"缚根者的遗物。他们的故事止于芦苇泽溺根处的沼母；赢得试炼，长老便把遗物交给你。只要放在物品栏的任何地方，不论你的声望如何，都会把他们的恩惠留在你身上：你周围的作物赶着长。",
		"做法：和缚根者的长老一起完成他们的故事；试炼是芦苇泽的沼母。"
	]
	quest.4200000000228062.title: "初根"
	quest.4200000000228063.quest_desc: [
		"缘行者的遗物。他们的故事止于高地栖所处的风暴鹏；赢得试炼，长老便把遗物交给你。只要放在物品栏的任何地方，不论你的声望如何，都会把他们的恩惠留在你身上：潜行时你绝不会坠落。",
		"做法：和缘行者的长老一起完成他们的故事；试炼是高地上的风暴鹏。"
	]
	quest.4200000000228063.title: "桥钉"
	quest.4200000000228064.quest_desc: [
		"鼓心的遗物。他们的故事止于余烬荒地炉渣王座处的炉渣泰坦；赢得试炼，长老便把遗物交给你。只要放在物品栏的任何地方，不论你的声望如何，都会把他们的恩惠留在你身上：你挥得更快。",
		"做法：和鼓心的长老一起完成他们的故事；试炼是余烬荒地的炉渣泰坦。"
	]
	quest.4200000000228064.title: "稳鼓"
	quest.4200000000228065.quest_desc: [
		"纹织者的遗物。他们的故事止于浅滩潮石处的潮鼓手；打赢试炼，长老便把它交给你。只要放在物品栏的任何地方，不论你的声望如何，都会把他们的恩惠留在你身上：你附近的回声台产出加倍。",
		"做法：和他们的长老完成纹织者的故事；试炼是浅滩的潮鼓手。"
	]
	quest.4200000000228065.title: "Silent Gear"
	quest.4200000000228066.quest_desc: [
		"群居看守的遗物。他们的故事止于雪原石冢环处的石冢亡灵；打赢试炼，长老便把它交给你。只要放在物品栏的任何地方，不论你的声望如何，都会把他们的恩惠留在你身上：你从不被蜇。",
		"做法：和他们的长老完成群居看守的故事；试炼是雪原的石冢亡灵。"
	]
	quest.4200000000228066.title: "蜂巢印记"
	quest.4200000000228067.quest_desc: [
		"印刻者的遗物。他们的故事止于微光岭封印之门处的宝库哨卫；打赢试炼，长老便把它交给你。只要放在物品栏的任何地方，不论你的声望如何，都会把他们的恩惠留在你身上：你的护符只要一半脉动。",
		"做法：和他们的长老完成印刻者的故事；试炼是微光岭上的宝库哨卫。"
	]
	quest.4200000000228067.title: "礼印"
	quest.4200000000228068.quest_desc: [
		"织机缝匠的遗物。他们的故事止于寂鼓处的未歌者；打赢试炼，长老便把它交给你。只要放在物品栏的任何地方，不论你的声望如何，都会把他们的恩惠留在你身上：你唱得更便宜。",
		"做法：和他们的长老完成织机缝匠的故事；试炼是寂鼓处的未歌者。"
	]
	quest.4200000000228068.title: "第九丝线"
	quest.4200000000228069.quest_desc: [
		"每个部族的故事都完成了：面对过八位守护者和未歌者。九件遗物都在物品栏里，第九盟约便触手可及。`/tribalpower standing` 会显示你和每个部族的声望。",
		"做法：完成全部九则故事。第九件遗物在手时，进度触发。"
	]
	quest.4200000000228069.title: "九件遗物"
	quest.420000000022806A.quest_desc: [
		"余烬荒地的炉渣王座：一圈石头，中央是守护者祭坛，在磨制深板岩上，四支点燃的蜡烛之间，头顶是开阔的天空。空手潜行使用祭坛，它会告诉你要什么——八片岩浆鳞——然后放上去，退后。潜行顶住它的砸击；发怒后，石环点燃，烬魔从炉渣中升起。血量过半时它发怒，并召来本国的生物，那些什么也不掉。放着它半分钟，它会重新睡去；祭坛在两次召唤之间歇二十分钟。它掉落炉渣核心，它的倒下终结鼓心的故事。",
		"做法：空手潜行使用该国的守护者祭坛，放上它点名的试剂八份，然后打赢。击杀时进度触发。"
	]
	quest.420000000022806A.title: "炉渣泰坦止息"
	quest.420000000022806B.quest_desc: [
		"芦苇泽的溺根：一圈石头，中央是守护者祭坛，在磨制深板岩上，四支点燃的蜡烛之间，头顶是开阔的天空。空手潜行使用祭坛，它会告诉你要什么——八枚芦牙——然后放上去，退后。它的套索把你拖进去并让你变慢；站在实地上，砍掉它召来的苇潜者。血量过半时它发怒，并召来本国的生物，那些什么也不掉。放着它半分钟，它会重新睡去；祭坛在两次召唤之间歇二十分钟。它掉落泽心，它的倒下终结缚根者的故事。",
		"做法：空手潜行使用该国的守护者祭坛，放上它点名的试剂八份，然后打赢。击杀时进度触发。"
	]
	quest.420000000022806B.title: "沼母止息"
	quest.420000000022806C.quest_desc: [
		"雪原的石冢环：一圈石头，中央是守护者祭坛，在磨制深板岩上，四支点燃的蜡烛之间，头顶是开阔的天空。空手潜行使用祭坛，它会告诉你要什么——八枚霜颚——然后放上去，退后。它的气息冻住面前的一切。绕到背后；它召来的霜爬者很慢。血量过半时它发怒，并召来本国的生物，那些什么也不掉。放着它半分钟，它会重新睡去；祭坛在两次召唤之间歇二十分钟。它掉落石冢石，它的倒下终结群居看守的故事。",
		"做法：空手潜行使用该国的守护者祭坛，放上它点名的试剂八份，然后打赢。击杀时进度触发。"
	]
	quest.420000000022806C.title: "石冢亡灵止息"
	quest.420000000022806D.quest_desc: [
		"水晶原的歌唱裂隙：一圈石头，中央是守护者祭坛，在磨制深板岩上，四支点燃的蜡烛之间，头顶是开阔的天空。空手潜行使用祭坛，它会告诉你要什么——八块棱镜甲壳——然后放上去，退后。它射出光矢，把你标成发光。侧移，贴上去，当心它发怒后多出的第二支。血量过半时它发怒，并召来本国的生物，那些什么也不掉。放着它半分钟，它会重新睡去；祭坛在两次召唤之间歇二十分钟。它掉落棱镜核心，它的倒下终结砾歌者的故事。",
		"做法：空手潜行使用该国的守护者祭坛，放上它点名的试剂八份，然后打赢。击杀时进度触发。"
	]
	quest.420000000022806D.title: "棱镜巨蛇止息"
	quest.420000000022806E.quest_desc: [
		"微光岭的封印之门：一圈石头，中央是守护者祭坛，在磨制深板岩上，四支点燃的蜡烛之间，头顶是开阔的天空。空手潜行使用祭坛，它会告诉你要什么——八枚哨卫印记——然后放上去，退后。边境里最重的盔甲，还有一记把你扫下岭的横扫。发怒后，它每次护住自己三秒：等它过去。血量过半时它发怒，并召来本国的生物，那些什么也不掉。放着它半分钟，它会重新睡去；祭坛在两次召唤之间歇二十分钟。它掉落宝库之印，它的倒下终结印刻者的故事。",
		"做法：空手潜行使用该国的守护者祭坛，放上它点名的试剂八份，然后打赢。击杀时进度触发。"
	]
	quest.420000000022806E.title: "宝库哨卫止息"
	quest.420000000022806F.quest_desc: [
		"浅滩的潮石：一圈石头，中央是一座守护者祭坛，立在磨制深板岩上，四支点燃的蜡烛之间，头顶是开阔的天空。空手潜行使用祭坛，它会说出要什么——八枚卤牙——然后把它们放上去，再退后。每一拍都把所有人拉向它，并且伤人。从岸上打它，背靠着结实的东西。血量过半时它被激醒，召来本国的生物，那些生物什么也不掉。放着它半分钟，它会重新睡去；祭坛在两次召唤之间歇二十分钟。它掉落潮壳，倒下便终结纹织者的故事。",
		"做法：空手潜行使用该国的守护者祭坛，放上它点名的试剂八份，然后打赢。击杀时进度触发。"
	]
	quest.420000000022806F.title: "潮鼓手已静"
	quest.4200000000228070.quest_desc: [
		"草原上的践踏之圈：一圈石头，中央是一座守护者祭坛，立在磨制深板岩上，四支点燃的蜡烛之间，头顶是开阔的天空。空手潜行使用祭坛，它会说出要什么——八条腿筋——然后把它们放上去，再退后。它会冲锋。侧身躲开，趁它经过时打它；穴啮兽钻出来时，站到方块上。血量过半时它被激醒，召来本国的生物，那些生物什么也不掉。放着它半分钟，它会重新睡去；祭坛在两次召唤之间歇二十分钟。它掉落群角，倒下便终结浮台看守的故事。",
		"做法：空手潜行使用该国的守护者祭坛，放上它点名的试剂八份，然后打赢。击杀时进度触发。"
	]
	quest.4200000000228070.title: "奔踏之灵已静"
	quest.4200000000228071.quest_desc: [
		"高地的栖所：一圈石头，中央是一座守护者祭坛，立在磨制深板岩上，四支点燃的蜡烛之间，头顶是开阔的天空。空手潜行使用祭坛，它会说出要什么——八枚风暴之翼——然后把它们放上去，再退后。它俯冲，把你抛到空中；激醒后，每次俯冲都跟着闪电。弓和屋顶比盾牌更有用。血量过半时它被激醒，召来本国的生物，那些生物什么也不掉。放着它半分钟，它会重新睡去；祭坛在两次召唤之间歇二十分钟。它掉落风暴羽，倒下便终结缘行者的故事。",
		"做法：空手潜行使用该国的守护者祭坛，放上它点名的试剂八份，然后打赢。击杀时进度触发。"
	]
	quest.4200000000228071.title: "风暴鹏已静"
	quest.4200000000228072.quest_desc: [
		"八枚守护者核心和一枚未歌者之心，无序。一枚核心加一根织机丝线会改做成六枚共鸣核心，所以若两样都要，再取一套掉落。每位守护者的首领血条都是本部落的颜色。",
		"做法：八枚守护者核心和一枚未歌者之心，无序。九件遗物都带在身上，在织机圆阵中施放。"
	]
	quest.4200000000228072.title: "九者石板"
	quest.4200000000228073.quest_desc: [
		"画一个织机圆阵——仪典圆内的火盆里安置一枚织机印记——九件遗物都带在身上，施放石板；仪式在生效前先抽取脉动。九盏灯升起，每族一色。从此每个部族至少把你当作亲族，九项恩惠会在你身上安顿一阵，极光在你立于其下的每个夜晚都烧得饱满。每位玩家一次；第二次施放只会点亮圆阵。",
		"做法：织机印记放在仪典圆内的火盆里，九件遗物在物品栏；对火盆潜行使用石板。"
	]
	quest.4200000000228073.title: "织机应允"
	quest.4200000000228074.quest_desc: [
		"织机历史的十六块碎片刻在边境里：八块刻石在遗迹的墙上，八幅二乘二的壁画在守护者的场地上。右键其中一块就能读；灵之抄本会收下它，编年史一节把它排好顺序。把十六段读完，故事就完整。",
		"做法：右键边境遗迹里的全部八块刻石，以及守护者场地上的全部八幅壁画。"
	]
	quest.4200000000228074.title: "完整的编年史"
	quest.4200000000228075.quest_desc: [
		"嵌在边境遗迹的墙里——旧工坊、沉没的祠、坟丘、墓室、宝库。在找到的地方读它，再捡起来装到你自己的墙上；读过的，就一直算读过。",
		"做法：嵌在边境遗迹的墙里。读完，再打破它，装到你自己的墙上。"
	]
	quest.4200000000228075.title: "记得的石头"
	quest.4200000000228076.quest_desc: [
		"在每位守护者的场地上，宽两格、高两格，各自画着它所在的国度。读任何一部分，就读到整幅。整块放上，也整块取下；在创造模式里切下的壁画，潜行点击会换章节。",
		"做法：在每位守护者的场地上以二乘二立着。读完，再整块取下，放在家里。"
	]
	quest.4200000000228076.title: "画出国度的墙"
	quest.4200000000228077.quest_desc: [
		"边境自己会动。灰落、一场微光风暴、一场白障和芦雾把一个国度困住，并在白天唤起灵；每一种喂养一个声音的发生器，并妨碍另一个的。时不时，一个声音的地脉线会涌起：带着它的收集器产出加倍，但若站在没有收集器的光秃交叉处，地脉症会摇晃地面，抽干你的脉动。每个部族轮流守一个节日——入席便有礼物。漂到你身边的暖光是游魂；够到它，便得到一行它那国度的故事，和一份小礼物。风暴和涌动会提前两分钟通报，在聊天里，也在快捷栏上方。撑过一次，就勾选这项。",
		"做法：在一场天气、一次涌动或一个节日期间待在边境；经历过就勾选。"
	]
	quest.4200000000228077.title: "边境在呼吸"
	quest.420000000023058C.quest_desc: [
		"砾歌者从不一模一样地切两次石头。这张台子记得每一次切割。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：石头加台子零件在 JEI 里。放入方块，再选一种变体。"
	]
	quest.420000000023058C.title: "石匠台"
	quest.420000000023058D.quest_desc: [
		"木头也是同一套：一块变成一百块木板。",
		"做法：Chipped 的木匠台在 JEI 里。和石匠台同一个思路，用于木头。"
	]
	quest.420000000023058D.title: "木匠台"
	quest.420000000023058E.quest_desc: [
		"沙子变成玻璃，再把玻璃变成光愿意收下的每一种形状。",
		"做法：Chipped 的工作台在 JEI 里（石匠、木匠、吹玻璃匠……）。把方块放进台子，再选一种切法。"
	]
	quest.420000000023058E.title: "吹玻璃匠"
	quest.420000000023058F.quest_desc: [
		"羊毛和布，重织过——正合适，给一座正在修补织机的浮台。",
		"做法：Chipped 的工作台在 JEI 里（石匠、木匠、吹玻璃匠……）。把方块放进台子，再选一种切法。"
	]
	quest.420000000023058F.title: "织机台"
	quest.4200000000230590.quest_desc: [
		"树叶、树苗和生长的东西，按变体分好。",
		"做法：Chipped 的工作台在 JEI 里（石匠、木匠、吹玻璃匠……）。把方块放进台子，再选一种切法。"
	]
	quest.4200000000230590.title: "植物学家工作台"
	quest.4200000000230591.quest_desc: [
		"带色的方块，和更古怪的石头。选一种变体；台子留着其余的。",
		"做法：Chipped 的工作台在 JEI 里（石匠、木匠、吹玻璃匠……）。把方块放进台子，再选一种切法。"
	]
	quest.4200000000230591.title: "炼金台"
	quest.4200000000230592.quest_desc: [
		"金属和机器面板方块，按你的口味来切。",
		"做法：Chipped 的工作台在 JEI 里（石匠、木匠、吹玻璃匠……）。把方块放进台子，再选一种切法。"
	]
	quest.4200000000230592.title: "修补台"
	quest.4200000000230593.quest_desc: [
		"把方块送进石匠台，再从变体墙里选。",
		"做法：四个石头摆成方形，或用切石机。"
	]
	quest.4200000000230593.title: "石之一刀"
	quest.4200000000230594.quest_desc: [
		"木匠台对木头做同样的事。",
		"做法：合成格里放一根原木，得到四块。"
	]
	quest.4200000000230594.title: "木板之一刀"
	quest.4200000000230595.quest_desc: [
		"吹玻璃匠会的每一种玻璃板，都从这里开始。",
		"做法：熔炼沙子。用锤子把圆石敲成砾石，砾石敲成沙子，再送进熔炉。"
	]
	quest.4200000000230595.title: "玻璃之一刀"
	quest.4200000000230596.quest_desc: [
		"砾歌者最爱拿来争论的石头。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000230596.title: "深板岩变种"
	quest.4200000000230597.quest_desc: [
		"烧制黏土，一百种样子。",
		"做法：四个红砖。黏土球熔炼成红砖。"
	]
	quest.4200000000230597.title: "砖块变种"
	quest.4200000000230598.quest_desc: [
		"浮台的砂砾，切得细。",
		"做法：合成、烧炼、过筛，或从生物掉落。JEI 会列出浮台上的每一种来源。"
	]
	quest.4200000000230598.title: "砂岩变种"
	quest.4200000000240599.quest_desc: [
		"把浮台变成有人住的地方，第一件东西。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：橡木木板在 JEI 里。第一件 Handcrafted。"
	]
	quest.4200000000240599.title: "一把椅子"
	quest.420000000024059A.quest_desc: [
		"想事情时，把抄本放下的地方。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.420000000024059A.title: "一张桌子"
	quest.420000000024059B.quest_desc: [
		"桶干活的时候，给 Clowder 坐的地方。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.420000000024059B.title: "一条长凳"
	quest.420000000024059C.quest_desc: [
		"给那些你一直想再读的抄本页。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.420000000024059C.title: "一层架子"
	quest.420000000024059D.quest_desc: [
		"看着就该在那儿的 Handcrafted 储物。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.420000000024059D.title: "一个橱柜"
	quest.420000000024059E.quest_desc: [
		"浮台看守睡得安稳。你也该这样。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.420000000024059E.title: "一张精致的床"
	quest.420000000024059F.quest_desc: [
		"一盏灯、一页纸、两样都放得下的地方。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.420000000024059F.title: "床头柜"
	quest.42000000002405A0.quest_desc: [
		"切出一个框架，再用任意方块给它穿上。一种形状，每一种皮。",
		"做法：一个铁锭放在三个带框方块上方。用来切带框方块。"
	]
	quest.42000000002405A0.title: "框架锯"
	quest.42000000002405A1.quest_desc: [
		"一块空白的方块，等着一块伪装方块。",
		"做法：框架锯，然后是框架方块/台阶/楼梯。伪装是手持方块右键。"
	]
	quest.42000000002405A1.title: "框架方块"
	quest.42000000002405A2.quest_desc: [
		"半个框架；两倍的选择。",
		"做法：框架锯，然后是框架方块/台阶/楼梯。伪装是手持方块右键。"
	]
	quest.42000000002405A2.title: "框架台阶"
	quest.42000000002405A3.quest_desc: [
		"台阶会穿上它所靠的那面墙，不管是什么墙。",
		"做法：框架锯，然后是框架方块/台阶/楼梯。伪装是手持方块右键。"
	]
	quest.42000000002405A3.title: "框架楼梯"
	quest.42000000002405A4.quest_desc: [
		"给虚空从未给你的屋顶和屋脊线。",
		"做法：框架锯，然后是框架方块/台阶/楼梯。伪装是手持方块右键。"
	]
	quest.42000000002405A4.title: "框架斜坡"
	quest.42000000002405A5.quest_desc: [
		"缘行者用更少的东西跨过虚空。有模有样地走到下一座浮台。",
		"做法：在 JEI 里，用对应的石/木头做 Macaw 的桥。"
	]
	quest.42000000002405A5.title: "索桥"
	quest.42000000002405A6.quest_desc: [
		"浮台上的一顶屋顶。这上面的雨，从来只是野心。",
		"做法：在 JEI 里，用对应的木头做 Macaw 的屋顶。"
	]
	quest.42000000002405A6.title: "阁楼屋顶"
	quest.42000000002405A7.quest_desc: [
		"舒适也是基建。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.42000000002405A7.title: "沙发"
	quest.42000000002405A8.quest_desc: [
		"给 Farmer's Delight 这一套用的厨房台沿。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.42000000002405A8.title: "料理台"
	quest.42000000002405A9.quest_desc: [
		"胡须抄本在这里得到页边空白。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.42000000002405A9.title: "书桌"
	quest.42000000002405AA.quest_desc: [
		"和桌子配套的小储物。",
		"做法：木板做的 Handcrafted 家具在 JEI 里。第一把椅子是橡木的。"
	]
	quest.42000000002405AA.title: "抽屉"
	quest.42000000002405AB.quest_desc: [
		"藏进墙里的一道门槛。",
		"做法：框架锯，然后是框架方块/台阶/楼梯。伪装是手持方块右键。"
	]
	quest.42000000002405AB.title: "框架门"
	quest.42000000002405AC.quest_desc: [
		"薄薄一层盖；十足的伪装。",
		"做法：框架锯，然后是框架方块/台阶/楼梯。伪装是手持方块右键。"
	]
	quest.42000000002405AC.title: "框架镶板"
	quest.42000000002405AD.quest_desc: [
		"可按口味装扮的边缘栏杆。",
		"做法：框架锯，然后是框架方块/台阶/楼梯。伪装是手持方块右键。"
	]
	quest.42000000002405AD.title: "框架栅栏"
	quest.42000000002405AE.quest_desc: [
		"灰而诚实，像它出身的那把砂砾。",
		"做法：在 JEI 里，用对应的石/木头做 Macaw 的桥。"
	]
	quest.42000000002405AE.title: "安山岩桥"
	quest.42000000002505AF.quest_desc: [
		"一盏壁灯，不是羞愧地插上的火把。执事们自有标准。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：火把 + 铁粒。执事所的第一件制作。"
	]
	quest.42000000002505AF.title: "壁灯"
	quest.42000000002505B0.quest_desc: [
		"落下的沙。时钟丝缕之前，唯一诚实的钟。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B0.title: "沙漏"
	quest.42000000002505B1.quest_desc: [
		"让流体从方块里滴出来。小，却出奇地痛快。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B1.title: "水龙头"
	quest.42000000002505B2.quest_desc: [
		"用手转。鼓心也是从某处起步的。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B2.title: "曲柄"
	quest.42000000002505B3.quest_desc: [
		"把东西摆出来。一枚信物，一页纸，一座奖杯。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B3.title: "物品架"
	quest.42000000002505B4.quest_desc: [
		"装麻袋的麻袋。回收的杂乱，收拾好了。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B4.title: "麻袋"
	quest.42000000002505B5.quest_desc: [
		"把绽线锁起来，别靠近你那些更糟的主意。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B5.title: "保险箱"
	quest.42000000002505B6.quest_desc: [
		"把一页钉在整个 Clowder 都会读的地方。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B6.title: "告示板"
	quest.42000000002505B7.quest_desc: [
		"一只有野心的盆。在浮台薄的地方种一点。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B7.title: "种植箱"
	quest.42000000002505B8.quest_desc: [
		"把纺锤织机碎片抬到能被人欣赏的地方。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B8.title: "底座"
	quest.42000000002505B9.quest_desc: [
		"存放曲奇、蜜蜂，或是秩序那点小小的体面。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505B9.title: "罐子 (37)"
	quest.42000000002505BA.quest_desc: [
		"不用把整张床扛上梯子，就能设出生点。",
		"做法：在 JEI 里用羊毛。白色睡袋；有染色变体。不用整张床就能设出生点。"
	]
	quest.42000000002505BA.title: "睡袋"
	quest.42000000002505BB.quest_desc: [
		"睡过白天，好让生物遇见一个歇足的 Skybound。",
		"做法：在 JEI 里用羊毛 + 线。挂到绳索和钉子上。"
	]
	quest.42000000002505BB.title: "吊床"
	quest.42000000002505BC.quest_desc: [
		"把吊床挂在两根柱子之间，悬在落口之上，然后去试。",
		"做法：线和一块铁锭。先放两个，再挂上吊床。"
	]
	quest.42000000002505BC.title: "绳与钉"
	quest.42000000002505BD.quest_desc: [
		"更稳的火，照浮台的长夜。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505BD.title: "烛台"
	quest.42000000002505BE.quest_desc: [
		"攀、挂，或是搭桥。缘行者向来只信它。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505BE.title: "绳子 (37)"
	quest.42000000002505BF.quest_desc: [
		"红石一高兴，绳子就升降。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505BF.title: "滑轮方块"
	quest.42000000002505C0.quest_desc: [
		"落到它上面，虚空就忘了罚你。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505C0.title: "羽毛方块"
	quest.42000000002505C1.quest_desc: [
		"用粉笔写一份计划，让整个 Clowder 都能争论。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505C1.title: "黑板"
	quest.42000000002505C2.quest_desc: [
		"带上一个小东西，它宁可你别这么做。",
		"做法：在 JEI 里做 Supplementaries（壁灯、麻袋、保险箱、绳索……）。执事所会指出工作台的名字。"
	]
	quest.42000000002505C2.title: "笼子"
	quest.42000000002605C3.quest_desc: [
		"第一根导线。鼓心守住的脉动，如今有处可去。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：在轧机里轧铜板。本章从这里开始。"
	]
	quest.42000000002605C3.title: "铜线"
	quest.42000000002605C4.quest_desc: [
		"一边是旋转，另一边是 Forge 能量。两条丝缕在握手。",
		"做法：Create Crafts & Additions — 轧机出来的铜线，然后是连接器和电机。"
	]
	quest.42000000002605C4.title: "连接器"
	quest.42000000002605C5.quest_desc: [
		"能量变回旋转。时钟丝缕现在靠火花丝缕运转。",
		"做法：Create Crafts & Additions — 轧机出来的铜线，然后是连接器和电机。"
	]
	quest.42000000002605C5.title: "电动机"
	quest.42000000002605C6.quest_desc: [
		"在导线和活计之间保住电荷。",
		"做法：Create Crafts & Additions — 轧机出来的铜线，然后是连接器和电机。"
	]
	quest.42000000002605C6.title: "电容"
	quest.42000000002605C7.quest_desc: [
		"一堵储存电流的墙，浮台允许多大就建多大。",
		"做法：Create Crafts & Additions — 轧机出来的铜线，然后是连接器和电机。"
	]
	quest.42000000002605C7.title: "模块化蓄电器"
	quest.42000000002605C8.quest_desc: [
		"用锭做出棒和线——这是 Create 给压机的回答。",
		"做法：Create Crafts & Additions — 轧机出来的铜线，然后是连接器和电机。"
	]
	quest.42000000002605C8.title: "轧机"
	quest.42000000002605C9.quest_desc: [
		"不必靠附魔台的迷信来附魔。喂它经验，得到意图。",
		"做法：烈焰燃烧器之后是 Create Enchantment Industry。JEI 会标出印刷机和经验桶。"
	]
	quest.42000000002605C9.title: "烈焰附魔器"
	quest.42000000002605CA.quest_desc: [
		"液态的修习，随身带着。执事们会觉得这又俗又有用。",
		"做法：烈焰燃烧器之后是 Create Enchantment Industry。JEI 会标出印刷机和经验桶。"
	]
	quest.42000000002605CA.title: "经验桶"
	quest.42000000002605CB.quest_desc: [
		"抄一本书、一份图、一页纸。胡须抄本默默点头。",
		"做法：烈焰燃烧器之后是 Create Enchantment Industry。JEI 会标出印刷机和经验桶。"
	]
	quest.42000000002605CB.title: "印刷机"
	quest.42000000002605CC.quest_desc: [
		"熔岩与热，化为动力。一座桥，不是低鸣本身。",
		"做法：锇 + 熔炉 + 铜。第一台 Mekanism 发电机。"
	]
	quest.42000000002605CC.title: "热力发电机"
	quest.42000000002605CD.quest_desc: [
		"在一座全是天空的浮台上，太阳是谁都不配给的那一种资源。",
		"做法：Mekanism 工坊线之后，是 Mekanism 发电机。热力发电机是第一件合成。"
	]
	quest.42000000002605CD.title: "太阳能发电机"
	quest.42000000002605CE.quest_desc: [
		"浮台越高，它转得越猛。往高处建。",
		"做法：Mekanism 工坊线之后，是 Mekanism 发电机。热力发电机是第一件合成。"
	]
	quest.42000000002605CE.title: "风力发电机"
	quest.42000000002605CF.quest_desc: [
		"烧掉萌芽丝缕的盈余。浮台上没有废物。",
		"做法：Mekanism 工坊线之后，是 Mekanism 发电机。热力发电机是第一件合成。"
	]
	quest.42000000002605CF.title: "生物发电机"
	quest.42000000002605D0.quest_desc: [
		"给深入 Mekanism 的 Clowder 的后期动力。",
		"做法：Mekanism 工坊线之后，是 Mekanism 发电机。热力发电机是第一件合成。"
	]
	quest.42000000002605D0.title: "燃气发电机"
	quest.42000000002605D1.quest_desc: [
		"数字织机，装在口袋里。在浮台任何地方都能重织。",
		"做法：AE2 网络和充能的无线套件之后，是无线终端。JEI 会标出这项合成。"
	]
	quest.42000000002605D1.title: "无线终端 (38)"
	quest.42000000002605D2.quest_desc: [
		"Mekanism 的化学品，存在 AE2 网络里。两根后期的柱，编在一起。",
		"做法：AE2 外壳 + Mekanism 化学品之后，是 Applied Mekanistics 化学元件。"
	]
	quest.42000000002605D2.title: "化学元件"
	quest.42000000002605D3.quest_desc: [
		"给铜线载不动整道脉动的时候。",
		"做法：Create Crafts & Additions — 轧机出来的铜线，然后是连接器和电机。"
	]
	quest.42000000002605D3.title: "大型连接器"
	quest.42000000002605D4.quest_desc: [
		"一块能让你升级的蛋糕。别告诉厨房产线。",
		"做法：烈焰燃烧器之后是 Create Enchantment Industry。JEI 会标出印刷机和经验桶。"
	]
	quest.42000000002605D4.title: "经验蛋糕"
	quest.42000000002605D5.quest_desc: [
		"同一片免费的天空，再咬下更大的一口。",
		"做法：Mekanism 工坊线之后，是 Mekanism 发电机。热力发电机是第一件合成。"
	]
	quest.42000000002605D5.title: "高级太阳能"
	quest.42000000002605D6.quest_desc: [
		"每个化学元件都需要的外壳。",
		"做法：AE2 外壳 + Mekanism 化学品之后，是 Applied Mekanistics 化学元件。"
	]
	quest.42000000002605D6.title: "化学外壳"
	quest.42000000002605D7.quest_desc: [
		"把一份气体带离网络。",
		"做法：AE2 外壳 + Mekanism 化学品之后，是 Applied Mekanistics 化学元件。"
	]
	quest.42000000002605D7.title: "便携化学元件"
	quest.42000000002705D8.quest_desc: [
		"每条丝缕都有一位被切断扯断的守护者：变得凶野的织机造物。你不是在杀掉怪物，而是打败它，给丝缕重新加上张力。丝缕安放好之后，制作它的绽裂图腾，在竞技场外的任何地方使用，你和32格以内的每位 Clowder 同伴会被拉到它的舞台。获胜，你们每个人都把那名守护者的织成遗物带回家。失败，则被吐回去，图腾已耗尽。",
		"遗物从 Curios 遗物栏、副手或快捷栏生效：佩戴时的被动，以及带冷却的右键能力。 `/guardians leave` 放弃一场战斗； `/guardians status` 显示 Clowder 的记录。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：打勾。那条丝缕安放好之后，制作每一个绽裂图腾；在竞技场外使用。"
	]
	quest.42000000002705D8.title: "为那一刀作答"
	quest.42000000002705D9.quest_desc: [
		"巢穴之碗：四层泥土逐级下沉至泥坑的凹碗，上方是六座深色橡木的根拱，坑底有七道青绿的根缝在发光。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705D9.title: "图腾：卧榻"
	quest.42000000002705DA.quest_desc: [
		"生命每过四分之一，卧榻便砸下，用一层泥土灌满坑，身在其中时免疫。七道缝中有一道亮起：挖一条渠通到它，露出核心并击打，打破掩埋。第一道门，也是一道宽容的门。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705DA.title: "重新加张力：卧榻"
	quest.42000000002705DB.quest_desc: [
		"根心：受到的击退降低百分之六十，什么也拉不动你。扎根把你钉在地上五秒，身前有八颗伤害吸收的心。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705DB.title: "遗物：根心"
	quest.42000000002705DC.quest_desc: [
		"磨坑：一座深板岩采石场，地面有一圈旋转的磨石环，四条石筛滑槽把沙砾倒进中央砾坑。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705DC.title: "图腾：磨颚"
	quest.42000000002705DD.quest_desc: [
		"磨颚在嘴闭合时免疫。每条滑槽每十五秒掉落一块砾石；把一块搬到环上，让它滑进坑口，把嘴卡住张开十二秒。环在每个阶段都会反转，把大意的人推进坑里。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705DD.title: "重新加张力：磨颚"
	quest.42000000002705DE.quest_desc: [
		"磨核：免疫挖掘疲劳，手持筛网额外获得一次时运判定。撕裂会从你下一次打中的东西上削去2点护甲。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705DE.title: "遗物：磨核"
	quest.42000000002705DF.quest_desc: [
		"蔓生露台：叶冠下有四座花园台地，八根棚架柱，第二层有四座修剪台。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705DF.title: "图腾：荆母"
	quest.42000000002705E0.quest_desc: [
		"荆母从不出手；她播下会蔓延、一碰就灼人的荆棘树篱，每当一座修剪台被蔓住，她就回复。剪刀和斧能清掉它。在一座台上把八份树篱做成堆肥，放出一道修剪波，清开地面并震晕她——这是唯一干净的伤害窗口。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705E0.title: "重新加张力：荆母"
	quest.42000000002705E1.quest_desc: [
		"荆种：荆棘，且不受浆果或仙人掌伤害。绽放升起一圈树篱，并给你和圈内的 Clowder 生命恢复 II。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705E1.title: "遗物：荆种"
	quest.42000000002705E2.quest_desc: [
		"天空碎片：十块深板岩碎片漂在虚空之上，其间是崩塌的桥，首领落地的主碎片上有金色爪痕。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705E2.title: "图腾：缘行者"
	quest.42000000002705E3.quest_desc: [
		"一场纯粹的对决。缘行者在碎片之间来回跳，扑向离墙最远的人；金色爪痕会在它落地前一息标出落点——从上面走开。桥在你身后崩塌，稍后会回来。坠落要付六颗心，并被送回你的浮台。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705E3.title: "重新加张力：缘行者"
	quest.42000000002705E4.quest_desc: [
		"缘步：下落少于十二格没有摔落伤害，也不会从边缘滑落。缘步冲出六格，两次，结尾的一击更重。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705E4.title: "遗物：缘步"
	quest.42000000002705E5.quest_desc: [
		"锻鼓：熔岩坑上的黄铜鼓台，八把铜活塞锤，锤前有击打垫，四条熔岩渠穿过地面。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705E5.title: "图腾：鼓心"
	quest.42000000002705E6.quest_desc: [
		"鼓心只在每第四拍之后的一瞬间能受伤。你要在强拍时站上节拍台，蓄一朵按三倍计算的火花；第四拍熔岩渠会升起，所以要站在台上，别站进渠里。每一阶段节奏都会加快。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705E6.title: "重新加张力：鼓心"
	quest.42000000002705E7.quest_desc: [
		"鼓脉：每第四下多打中两颗心。强拍会使七格内的一切眩晕并击退。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705E7.title: "遗物：鼓脉"
	quest.42000000002705E8.quest_desc: [
		"擒纵：四个旋转的铜环，载着深色橡木序列砖，绕着铁毂，六座齿轮塔，以及一根十六格长、守着时间的摆锤。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705E8.title: "图腾：齿轮匠"
	quest.42000000002705E9.quest_desc: [
		"每个阶段齿轮匠都会上弦：砖块在转动的环上依次亮起，你有十二秒按顺序踩上去。成功则机壳打开八秒；失败则每座齿轮塔开火。摆锤是节拍器；它摆得远时，环会反向。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705E9.title: "重新加张力：齿轮匠"
	quest.42000000002705EA.quest_desc: [
		"齿轮环：急迫 I，工具损耗慢五分之一。倒回重置你携带的其他遗物，并把你弹回三秒前所在之处。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705EA.title: "遗物：齿轮环"
	quest.42000000002705EB.quest_desc: [
		"蜂巢：六边形的蜡质竞技场，有起落的巢房、蜜池，墙里有六个雄蜂巢房。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705EB.title: "图腾：蜂群心智"
	quest.42000000002705EC.quest_desc: [
		"蜂群心智很脆弱，但每一波它的六个巢房都会倾出雄蜂。把营火放在雄蜂巢房上，可封住它三十秒；六个都封上，王室便打开十秒。你自己的 Productive Bees 一看见雄蜂就会攻击。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705EC.title: "重新张紧：蜂群心智"
	quest.42000000002705ED.quest_desc: [
		"蜂群唤：蜜蜂从不与你为敌，十六格内的蜂箱快上十分之一。呼唤群：派出四只圣物蜂，追击你打中的东西。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705ED.title: "遗物：蜂群唤"
	quest.42000000002705EE.quest_desc: [
		"守护环：石砌圣所，有金圈，以及九根顶着紫水晶尖塔的纹柱，中央是金桩围成的九边台。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705EE.title: "图腾：破印者"
	quest.42000000002705EF.quest_desc: [
		"破印者藏在三道生效的结界后面。台桩每阶段点亮一次顺序——先看。按这个顺序驱散柱子，用 Ars 的驱散，或任意印记丝缕物品；弄错一个，三道都会重新武装，结界玻璃会咬人。对上三次，它就敞开十二秒。后面的阶段会打乱符文，并加上一个诱饵。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705EF.title: "重新张紧：破印者"
	quest.42000000002705F0.quest_desc: [
		"印痕：受到的魔法伤害减少五分之一。印痕护住你，或你看着的一名 Clowder 同伴，挡住一次重击。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705F0.title: "遗物：印痕"
	quest.42000000002705F1.quest_desc: [
		"坍塌织机：一座宽六十六格的织机，地板就是经线——综丝杆落下时，木板条散成丝线桥。",
		"四份绽线和四块该丝缕的方块，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705F1.title: "图腾：未织者"
	quest.42000000002705F2.quest_desc: [
		"五个阶段。每一段引用其余八种机制中的两种，持续三十秒，然后一根综丝杆落下，再散开三条板带。真身时只剩最后四条，经线是登上它所站横梁的唯一的路。在那里杀死它：重织。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705F2.title: "重新张紧：未织者"
	quest.42000000002705F3.quest_desc: [
		"织机丝线：你的 Clowder 织机张力再加二，衰减更慢。织机丝线把你的 Clowder 拴在你身边。它是真正重织的拱心石，也是两座封印竞技场的钥匙。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705F3.title: "遗物：织机丝线"
	quest.42000000002705F4.quest_desc: [
		"码头垃圾箱：码头本身的一角——木板院子、晾着布单的晾衣绳、一篮篮羊毛、一块红地毯。",
		"四份绽线和四份羊毛，围着一份虚空纱。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705F4.title: "图腾：绒絮傀儡"
	quest.42000000002705F5.quest_desc: [
		"唯一一场没有风险的战斗。傀儡扔出绒絮球，只让人失明一瞬间，并躲在洗好的衣服后面；拍打地毯，它就会打喷嚏、站不稳。它教你图腾、竞技场和大门。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705F5.title: "重新张紧：绒絮傀儡"
	quest.42000000002705F6.quest_desc: [
		"绒絮缕：免疫仙人掌、浆果和树篱伤害，也不会被推动。喷绒使附近生物失明，便于脱身。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705F6.title: "遗物：绒絮缕"
	quest.42000000002705F7.quest_desc: [
		"结园：草岛，上方是四环树篱迷宫，有缺口和岔刺，圆石小路，路上挂着绳结环。",
		"虚空纱周围放四份绽线和四片树叶。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705F7.title: "图腾：缠结"
	quest.42000000002705F8.quest_desc: [
		"蜘蛛用要砍三下才断的绳结封住你身后的路，并咬在死路里落单的人。在迷宫里别散开。可选，中期，一份外观奖。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705F8.title: "重新张紧：缠结"
	quest.42000000002705F9.quest_desc: [
		"结符：在蜘蛛网、灵魂沙、蜂蜜或细雪上不会减速，冰上滑动减半。缠结会把击中的第一只生物定在原地。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705F9.title: "遗物：结符"
	quest.42000000002705FA.quest_desc: [
		"两座疯狂的竞技场等在只有重织才能打开的门后。它们的图腾需要把织机丝线遗物放在合成格上，并且只回应已经合上自己天空的 Clowder。首领是你的十到二十倍大。把所有人都带上。",
		"做法：安放全部九条丝缕，然后重织。天空合拢时，进度会触发。"
	]
	quest.42000000002705FA.title: "封印之门"
	quest.42000000002705FB.quest_desc: [
		"割离：一块巨大的黑曜石碎片，被发光的那一刀横贯，二十块世界碎片在四周漂流，空中有青绿色的虚空之泪。",
		"绽线和黑曜石围在织机丝线遗物周围；遗物会交还。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705FB.title: "图腾：第一刀"
	quest.42000000002705FC.quest_desc: [
		"那一刀留在碎片上的形状，不是谁挥下的供词。每二十秒它横切碎片一道线，方块脱落十五秒；缝给予速度，但它的光束顺着缝走。漂流的碎片会碾压，虚空之泪会拉扯，生命降到五分之一时碎片沿那一刀裂成两半。仅在重织之后。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705FC.title: "恢复张力：第一刀"
	quest.42000000002705FD.quest_desc: [
		"第一刀碎片：切开结界阶段。整合包里最强，只留给通过的人。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705FD.title: "遗物：第一刀碎片"
	quest.42000000002705FE.quest_desc: [
		"上方织机：紫珀织体，九座丝缕桥通向九座有柱的台，二十七根大教堂的线伸向六十四格之上的拱心石。",
		"织机丝线遗物周围放绽线和紫珀；遗物会退还给你。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.42000000002705FE.title: "图腾：过织者"
	quest.42000000002705FF.quest_desc: [
		"你亲手修复的织机反过来对付你。过织者把九位守护者的影子投到各自的丝缕上；杀死一个影子，它的线会绷紧二十五秒，只有那时才能伤害织机本身。之后它投三个，再然后是全部九个。",
		"做法：使用对应的绽裂图腾，然后赢得竞技场。进度会完成这项。"
	]
	quest.42000000002705FF.title: "恢复张力：过织者"
	quest.4200000000270600.quest_desc: [
		"过织者的梭：每一件丝缕遗物的回响合于一体，并能重织一名倒下的 Clowder 同伴。",
		"胜利时在场的每位 Clowder 成员一份，直接进物品栏。",
		"做法：胡须抄本，绷断守护者——图腾、竞技场、遗物。图腾在浮台上应答。"
	]
	quest.4200000000270600.title: "遗物：过织者的梭"
	quest.42000000002805E3.quest_desc: [
		"野生的浮台奔者不会在虚空浮台上生成。在门鼓上演奏门仪（空手使用，用 A、S、D、F 敲拍子），然后去走边境。黄色的在草原和芦苇泽吃草。高地偏向优秀品级。雪原藏着绝妙品级。余烬荒原留着焰鸟。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：空手使用门鼓，演奏门之仪：用 A、S、D、F 敲中落下的拍子。打中 60% 就打开；不需要脉搏。先绑定回程指南针。"
	]
	quest.42000000002805E3.title: "前往边境"
	quest.42000000002805E4.quest_desc: [
		"野生 Gysahl 长在芦苇泽、草原和高地，泽里最密。采摘也会掉种子，用锄头破坏边境树叶或草还会掉更多种子。把种子种在家里的耕地上。",
		"做法：在边境采野生 Gysahl（芦苇泽最密）。采摘也会掉种子；种在家里的耕地上。"
	]
	quest.42000000002805E4.title: "Gysahl 青菜"
	quest.42000000002805E5.quest_desc: [
		"一本书和一片 Gysahl 叶。随处可用：书页列出你每只鸟的颜色、品级、组别、赛跑胜场和最后一颗坚果。",
		"做法：一本书和一份 Gysahl。随处可用；书页列出你自己的鸟。"
	]
	quest.42000000002805E5.title: "Chocobo 年鉴"
	quest.42000000002805E6.quest_desc: [
		"喂 Gysahl 来驯服一只野生黄色。用皮革、线和铁制作鞍，然后骑上。冲刺会突进；松开就能恢复耐力。",
		"做法：皮革、线和铁。用 Gysahl 驯服一只野生黄色，再给它装上鞍。"
	]
	quest.42000000002805E6.title: "Chocobo 鞍"
	quest.42000000002805E7.quest_desc: [
		"金粒围着时钟，再加一份 Gysahl。上了发条，就把你送到胡须风，再送回来。你走过边境之后，Esther 也站在 Clowder 大厅：骑上装了鞍的鸟去找她，或者问问胡须风的向导。",
		"做法：金粒围着时钟，再加一份 Gysahl。用它上发条前往胡须风再返回；装了鞍的鸟会跟你一起走。"
	]
	quest.42000000002805E7.title: "Chocobo 怀表"
	quest.42000000002805E8.quest_desc: [
		"手里的诱饵会引来野鸟，并在一片田野上勾出它们的轮廓。",
		"做法：制作诱饵。拿着它寻找边境的黄色。"
	]
	quest.42000000002805E8.title: "Chocobo 诱饵"
	quest.42000000002805E9.quest_desc: [
		"把 Gysahl 种子种在耕地上。家里一小块地，就是这条农事线的起点。",
		"做法：采野生 Gysahl 会掉种子，用锄头破坏草和边境树叶也会。种在耕地上。"
	]
	quest.42000000002805E9.title: "Gysahl 种子"
	quest.42000000002805EA.quest_desc: [
		"把一颗 Carob 坚果喂给两只性别相反的成体。两只品级为良好及以上的黄鸟加上 Carob，能孵出绿或蓝。每只亲鸟需要在 C 组拿过5次第一名；合计16次，颜色就必定。一只品级为优秀的绿和一只品级为优秀的蓝，各自有8次 B 组第一名，孵出黑（落空则是白；合计24次必定）。",
		"做法：胡须风的坚果看守 Bilo 出售 Carob。A 组比赛也会把它作为报酬。"
	]
	quest.42000000002805EA.title: "Carob 坚果"
	quest.42000000002805EB.quest_desc: [
		"阶梯中段的青草。训练速度、耐力、智力或协作；鸟会对每一种都吃饱。",
		"做法：胡须风的贤者 Wynn。"
	]
	quest.42000000002805EB.title: "Curiel 青草"
	quest.42000000002805EC.quest_desc: [
		"最高的训练青草。鸟吃饱更便宜的叶子后，再往阶梯上走。",
		"做法：胡须风的贤者 Wynn，或 S 组比赛的奖品。"
	]
	quest.42000000002805EC.title: "Sylkis 青草"
	quest.42000000002805ED.quest_desc: [
		"没有 Zeio，金不会孵出。一只品级为绝妙的黑加上一只品级为绝妙的黄，各自在 A 组拿过10次第一名（合计32次必定）。",
		"做法：胡须风的坚果看守 Bilo 出售 Zeio。S 组比赛很少把它作为报酬。"
	]
	quest.42000000002805ED.title: "Zeio 坚果"
	quest.42000000002805EE.quest_desc: [
		"在赛道上赢得的 GP。广场的摊位用 GP 给一切标价。",
		"做法：在胡须风的一轮里进入前三。骑上装了鞍的鸟去找 Esther 报名。"
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"第一颗配对坚果。天赋跟着坚果走，颜色跟着父母走，除非牵涉 Carob 或 Zeio。",
		"做法：胡须风的坚果看守 Bilo 出售 Pepio。C 组的一场胜利也可能把它作为报酬。"
	]
	quest.42000000002805EF.title: "Pepio 坚果"
	quest.42000000002805F0.quest_desc: [
		"两份 Gysahl 和骨粉。比普通青草高一阶。",
		"做法：无序合成——两份 Gysahl 和骨粉。"
	]
	quest.42000000002805F0.title: "Krakka 青草"
	quest.42000000002805F1.quest_desc: [
		"下一种训练青草。农场运转起来之后，可有可无。",
		"做法：贤者 Wynn，或 JEI 里列出的配方。"
	]
	quest.42000000002805F1.title: "Tantal 青草"
	quest.42000000002805F2.quest_desc: [
		"又一种训练青草。可选。",
		"做法：广场上的贤者 Wynn。"
	]
	quest.42000000002805F2.title: "Pahsana 青草"
	quest.42000000002805F3.quest_desc: [
		"又一种训练青草。可选。",
		"做法：广场上的贤者 Wynn。"
	]
	quest.42000000002805F3.title: "Mimett 青草"
	quest.42000000002805F4.quest_desc: [
		"又一种训练青草。可选。",
		"做法：广场上的贤者 Wynn。"
	]
	quest.42000000002805F4.title: "Reagan 青草"
	quest.42000000002805F5.quest_desc: [
		"中段坚果。可选。",
		"做法：胡须风的坚果看守 Bilo 出售 Luchile。"
	]
	quest.42000000002805F5.title: "Luchile 坚果"
	quest.42000000002805F6.quest_desc: [
		"中段坚果。可选。",
		"做法：胡须风的坚果看守 Bilo 出售 Saraha。"
	]
	quest.42000000002805F6.title: "Saraha 坚果"
	quest.42000000002805F7.quest_desc: [
		"中段坚果。可选。",
		"做法：胡须风的坚果看守 Bilo 出售 Lasan。"
	]
	quest.42000000002805F7.title: "Lasan 坚果"
	quest.42000000002805F8.quest_desc: [
		"中后期的配对坚果。可选。坚果看守 Bilo 出售它。",
		"做法：胡须风的坚果看守 Bilo 出售 Pram。"
	]
	quest.42000000002805F8.title: "Pram 坚果"
	quest.42000000002805F9.quest_desc: [
		"胡须风的集市摊位用 GP 出售烟花、拴绳、怀表和 Chocobo 年鉴。",
		"做法：纸加火药。可选的一爆。"
	]
	quest.42000000002805F9.title: "集市烟花"
	quest.42000000002805FA.quest_desc: [
		"后期配对坚果。可选。",
		"做法：胡须风的坚果看守 Bilo 出售 Porov。"
	]
	quest.42000000002805FA.title: "Porov 坚果"
	quest.42000000002905FB.quest_desc: [
		"虚空从未长出 Pam's 的灌木。用线网筛泥土。打破园圃，取得旱地种子——辣椒、玉米、仙人掌果。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：用线网或更好的网筛泥土（Ex Deorum 或虚空织机）。"
	]
	quest.42000000002905FB.title: "旱地园圃"
	quest.42000000002905FC.quest_desc: [
		"同一份泥土里的寒地作物。打破灌木；种你需要的。",
		"做法：用线网或更好的网筛泥土。"
	]
	quest.42000000002905FC.title: "霜寒园圃"
	quest.42000000002905FD.quest_desc: [
		"叶下的作物。同一张筛，另一丛灌木。",
		"做法：用线网或更好的网筛泥土。"
	]
	quest.42000000002905FD.title: "荫地园圃"
	quest.42000000002905FE.quest_desc: [
		"湿生作物。稻米和其余恋泽的种子都在这里。",
		"做法：用线网或更好的网筛泥土。"
	]
	quest.42000000002905FE.title: "泽湿园圃"
	quest.42000000002905FF.quest_desc: [
		"暖地作物。把一丛灌木收进箱子；种下去照样会蔓延。",
		"做法：用线网或更好的网筛泥土。"
	]
	quest.42000000002905FF.title: "热带园圃"
	quest.4200000000290600.quest_desc: [
		"六个里的最后一个。浮台上每一种 HarvestCraft 种子，起初都是这些灌木之一。",
		"做法：用线网或更好的网筛泥土。"
	]
	quest.4200000000290600.title: "风地园圃"
	quest.4200000000290601.quest_desc: [
		"不是 Farmer's Delight 的砧板。铜、木棍和木板。下锅之前，先处理好水果和蔬菜。",
		"做法：铜、木棍和木板。不是 Farmer's Delight 的砧板。"
	]
	quest.4200000000290601.title: "收获板"
	quest.4200000000290602.quest_desc: [
		"汤、炖菜和高汤。铜和一根木棍。每次合成后锅都会回来。",
		"做法：铜和一根木棍。每次无序烹饪后锅都会回来。"
	]
	quest.4200000000290602.title: "收获锅"
	quest.4200000000290603.quest_desc: [
		"煎锅餐食。铜和木棍。合成与 Delight 煎锅不同；JEI 能把它们分开。",
		"做法：铜和木棍。与 Delight 煎锅不同。"
	]
	quest.4200000000290603.title: "收获煎锅"
	quest.4200000000290604.quest_desc: [
		"酱汁和收汁。铜和一根木棍。把它放在锅旁边。",
		"做法：铜和一根木棍。"
	]
	quest.4200000000290604.title: "小锅"
	quest.4200000000290605.quest_desc: [
		"陶瓦环。派、面包，以及一切要烤箱形状的东西。",
		"做法：八块陶瓦围住空的中心。"
	]
	quest.4200000000290605.title: "烤模"
	quest.4200000000290606.quest_desc: [
		"木板和一根木棍。面糊、面团、沙拉。安静的台子。",
		"做法：木板和一根木棍。"
	]
	quest.4200000000290606.title: "搅拌碗"
	quest.4200000000290607.quest_desc: [
		"陶瓦。水果进去，汁挤出来。配树，别配菜园。",
		"做法：陶瓦。四块摆成T形。"
	]
	quest.4200000000290607.title: "榨汁机"
	quest.4200000000290608.quest_desc: [
		"木棍和原木。把面团擀平。烤模在等着。",
		"做法：原木两侧各放木棍。"
	]
	quest.4200000000290608.title: "辊子"
	quest.4200000000290609.quest_desc: [
		"燧石筛筛出的安山岩卵石，再加一根木棍。面粉、香料、酱泥。",
		"做法：安山岩（燧石筛筛泥土或沙砾得到的卵石）和一根木棍。"
	]
	quest.4200000000290609.title: "研磨器"
	quest.420000000029060A.quest_desc: [
		"一桶水分成八份。多数配方要的是这个，不是原版水桶。",
		"做法：一个水桶 → 八份淡水。"
	]
	quest.420000000029060A.title: "淡水"
	quest.420000000029060B.quest_desc: [
		"浮台上没有牛。椰子（铁网泥土）加淡水，或者以后再拆开一桶奶。",
		"做法：椰子（铁网泥土）加淡水，或拆开一桶奶。"
	]
	quest.420000000029060B.title: "鲜奶"
	quest.420000000029060C.quest_desc: [
		"锅里加水，或者研磨一次。几乎每道咸味配方都会要。",
		"做法：锅加上水或淡水。锅会回来。"
	]
	quest.420000000029060C.title: "盐"
	quest.420000000029060D.quest_desc: [
		"小麦过研磨器。面团从这里开始。",
		"做法：研磨器加上小麦（或其他出粉作物）。研磨器会回来。"
	]
	quest.420000000029060D.title: "面粉"
	quest.420000000029060E.quest_desc: [
		"面粉、盐和淡水。派和面包共用这块面团。",
		"做法：搅拌碗、面粉、水、盐。"
	]
	quest.420000000029060E.title: "面团"
	quest.420000000029060F.quest_desc: [
		"骨头或蔬菜放进锅。汤要的是一瓶这个，不是含糊的汤底。",
		"做法：锅加上骨头（浮台看守卖骨头）或剩下的蔬菜。"
	]
	quest.420000000029060F.title: "高汤"
	quest.4200000000290610.quest_desc: [
		"铁网泥土。在浮台上种；原版橡木不会掉落 Pam's 的苹果。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.4200000000290610.title: "苹果树"
	quest.4200000000290611.quest_desc: [
		"给调味汁和鱼用的酸。同一把铁筛。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.4200000000290611.title: "柠檬树"
	quest.4200000000290612.quest_desc: [
		"树皮香料。烘焙和茶。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.4200000000290612.title: "肉桂树"
	quest.4200000000290613.quest_desc: [
		"奶、油，还有热带菜。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.4200000000290613.title: "椰子棕榈"
	quest.4200000000290614.quest_desc: [
		"做甜食的豆荚。像其他的一样种下。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.4200000000290614.title: "香草藤"
	quest.4200000000290615.quest_desc: [
		"Pam's 的苹果树结普通苹果，比橡树叶掉的多得多。榨汁机和烤模都要这些。",
		"做法：橡木树叶只掉几个；Pam's 的苹果树（铁网泥土出的树苗）结很多。"
	]
	quest.4200000000290615.title: "Pam's 苹果"
	quest.4200000000290616.quest_desc: [
		"烤模、面团、糖、苹果。HarvestCraft 第一份完成的烘焙。",
		"做法：烤模、面团、糖、苹果树上的 Pam's 苹果。"
	]
	quest.4200000000290616.title: "苹果派（收获）"
	quest.4200000000290617.quest_desc: [
		"榨汁机加上混合水果。一杯不是西瓜汁的浮台饮料。",
		"做法：榨汁机和混合水果。"
	]
	quest.4200000000290617.title: "水果宾治"
	quest.4200000000290618.quest_desc: [
		"煎锅、面包、奶酪。树还在长，先吃一顿快午饭。",
		"做法：煎锅、面包、黄油和奶酪——全都来自淡水、椰奶和面粉。"
	]
	quest.4200000000290618.title: "烤芝士三明治"
	quest.4200000000290619.quest_desc: [
		"干旱辣椒、番茄、洋葱、豆子、香叶，还有肉或嫩豆腐。Food Extended 开始派上用场了。",
		"做法：锅、干旱辣椒、番茄、洋葱、豆、香叶，以及肉或嫩豆腐。"
	]
	quest.4200000000290619.title: "辣酱碗"
	quest.420000000029061A.quest_desc: [
		"研磨器的香料，园子的菜，锅上的活。",
		"做法：小锅、米、椰子、辣椒、黑胡椒、咖喱粉（香叶 + 芥末 + 肉桂）。"
	]
	quest.420000000029061A.title: "咖喱盘"
	quest.420000000029061B.quest_desc: [
		"面团、酱、肉。烤盘。一顿完整的 HarvestCraft 饭。",
		"做法：烤盘、面团、番茄、奶酪、意式辣香肠（猪肉培根，或枫树 + 大豆做的豆腐培根）。"
	]
	quest.420000000029061B.title: "意式辣香肠披萨"
	quest.420000000029061C.quest_desc: [
		"湿地园的米、胡萝卜、洋葱、豌豆和一枚蛋——在有鸡之前，由嫩豆腐顶上。",
		"做法：煎锅、湿地园的米、胡萝卜、洋葱、豌豆和一枚蛋——嫩豆腐算作蛋。"
	]
	quest.420000000029061C.title: "园蔬炒饭"
	quest.420000000029061D.quest_desc: [
		"茶叶和香叶下锅。荫园和湿地园两种都有。",
		"做法：锅、茶叶和香叶。荫园同时掉落茶和香料。"
	]
	quest.420000000029061D.title: "绿茶"
	quest.420000000029061E.quest_desc: [
		"油和咸香的果实。铁网的可选收获。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.420000000029061E.title: "橄榄树"
	quest.420000000029061F.quest_desc: [
		"果汁和果皮。可选。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.420000000029061F.title: "橙树"
	quest.4200000000290620.quest_desc: [
		"夏日的果实。可选。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.4200000000290620.title: "桃树"
	quest.4200000000290621.quest_desc: [
		"给研磨器的胡椒。可选。",
		"做法：用铁网筛泥土，得到厨房树苗，再种出果实。"
	]
	quest.4200000000290621.title: "胡椒树"
	quest.4200000000290622.quest_desc: [
		"煎炸用的油。可选常备。",
		"做法：在 JEI 里压榨种子或橄榄。可选常备。"
	]
	quest.4200000000290622.title: "食用油"
	quest.4200000000290623.quest_desc: [
		"奶和盐。可选常备。",
		"做法：锅和奶（椰子淡水奶也行）。"
	]
	quest.4200000000290623.title: "黄油"
	quest.4200000000290624.quest_desc: [
		"鸡蛋过一遍榨汁机。可选。",
		"做法：榨汁机和一枚蛋（嫩豆腐也算）。可选。"
	]
	quest.4200000000290624.title: "蛋黄酱"
	quest.4200000000290625.quest_desc: [
		"砧板、混合水果。可选。",
		"做法：砧板和混合水果。可选。"
	]
	quest.4200000000290625.title: "水果沙拉"
	quest.4200000000290626.quest_desc: [
		"意面之夜。可选。",
		"做法：园子和果树提供食材。大豆豆腐代替肉和蛋。JEI 会标出工作台。"
	]
	quest.4200000000290626.title: "意面晚餐"
	quest.4200000000290627.quest_desc: [
		"用来炫耀的早餐。可选。",
		"做法：园子和果树提供食材。大豆豆腐代替肉和蛋。JEI 会标出工作台。"
	]
	quest.4200000000290627.title: "培根煎饼"
	quest.4200000000290628.quest_desc: [
		"用铁网的土得到牛油果树苗，然后是煎锅、吐司、盐、蒜、香叶。",
		"做法：铁网的牛油果树苗，然后煎锅配吐司、盐、蒜、香叶。"
	]
	quest.4200000000290628.title: "牛油果吐司"
	quest.4200000000290629.quest_desc: [
		"不是 Delight 的汉堡。可选。",
		"做法：园子和果树提供食材。大豆豆腐代替肉和蛋。JEI 会标出工作台。"
	]
	quest.4200000000290629.title: "洋葱汉堡"
	quest.420000000029062A.quest_desc: [
		"榨汁机、苹果。可选。",
		"做法：榨汁机和 Pam's 的苹果。可选。"
	]
	quest.420000000029062A.title: "苹果汁"
	quest.420000000029062B.quest_desc: [
		"煎锅、面包和黄油。可选。",
		"做法：煎锅、面包和黄油。可选。"
	]
	quest.420000000029062B.title: "吐司一片"
	quest.42000000002A062C.quest_desc: [
		"四根木棍摆成方形。放在耕地上。原版种子种下去会转化——Mystical Agriculture 的种子不会。",
		"在同一方块再放一组木棍，做成杂交作物——一对空的，会继承旁边成熟作物的性状。四面都围上亲本，几分钟后它会自己结籽；在杂交处用骨粉会立刻强制尝试一次。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：四根木棍摆成方形。放在耕地上，再种一颗种子。"
	]
	quest.42000000002A062C.title: "木制作物棍"
	quest.42000000002A062D.quest_desc: [
		"书与笔（书、墨囊、羽毛）加上小麦种子。把它留在分析器里。",
		"做法：书与笔（书、墨囊、羽毛）加上小麦种子。木炭加玻璃瓶做成墨水。"
	]
	quest.42000000002A062D.title: "作物日志"
	quest.42000000002A062E.quest_desc: [
		"玻璃板和木棍。看着作物就能读出生长、产量和强度，不必采下。",
		"做法：木棍之间夹玻璃板，再加一根木棍当柄。看着已种下的作物。"
	]
	quest.42000000002A062E.title: "放大镜"
	quest.42000000002A062F.quest_desc: [
		"玻璃、石台阶、木板、木棍。把种子和日志一起放进去。育种就会显示出来。",
		"肥力是推动杂交的属性：新种子是10分里的1，每高一点，植株被选为亲本的概率就更高。分析，重种最好的，杂交就会更快到来。",
		"做法：玻璃板、石台阶、木板和木棍。先放进日志，再放种子。"
	]
	quest.42000000002A062F.title: "种子分析器"
	quest.42000000002A0630.quest_desc: [
		"这个整合包里杂草是关着的，但耙子仍能清掉一根木棍。还是带一把吧。",
		"做法：木棍上方放木栅栏。杂草是关着的；它仍能清掉一根木棍。"
	]
	quest.42000000002A0630.title: "木耙"
	quest.42000000002A0631.quest_desc: [
		"把植株连同属性一起拿起再放下。移动一个10-10而不弄坏它。",
		"做法：两个铁锭和一根木棍。把植株连同属性一起拿起。"
	]
	quest.42000000002A0631.title: "移植铲"
	quest.42000000002A0632.quest_desc: [
		"剪下一株成熟植株，取得剪取产物并重置它。花和部分 HarvestCraft 作物。",
		"做法：剪刀、铁和一根木棍。剪下成熟植株并重置它。"
	]
	quest.42000000002A0632.title: "剪取器"
	quest.42000000002A0633.quest_desc: [
		"带着一条育种线。从分析器装入，倒到木棍上。",
		"做法：皮革和线。从分析器装入。"
	]
	quest.42000000002A0633.title: "种子袋"
	quest.42000000002A0634.quest_desc: [
		"更结实的木棍。种植规则一样，撞到它们也不那么麻烦。",
		"做法：两个铁粒竖着摆，做出八根。"
	]
	quest.42000000002A0634.title: "铁制作物棍"
	quest.42000000002A0635.quest_desc: [
		"更好的耙子。即使杂草没了，仍是个习惯。",
		"做法：木棍上方放铁栏杆。"
	]
	quest.42000000002A0635.title: "铁耙"
	quest.42000000002A0636.quest_desc: [
		"为水渠存水。一座浮台上的农场，不必每天早上提着桶。",
		"做法：木板。为水渠存水。"
	]
	quest.42000000002A0636.title: "灌溉水箱"
	quest.42000000002A0637.quest_desc: [
		"把水箱的水沿着一行引过去。作物喝水渠里的水，不喝你的。",
		"做法：由水箱无序合成——一个水箱变成八条水渠。"
	]
	quest.42000000002A0637.title: "灌溉水渠"
	quest.42000000002A0638.quest_desc: [
		"不必拆掉水箱，就能停下或接通一条水路。",
		"做法：铁栏杆、红色染料和一个铁锭。不必拆掉水箱，就能停下或接通一条水路。"
	]
	quest.42000000002A0638.title: "水渠阀门"
	quest.42000000002A0639.quest_desc: [
		"下一小片方形的雨。把它放在木棍上方的水渠上。",
		"做法：把它放在木棍上方的水渠上。合成名称看 JEI。"
	]
	quest.42000000002A0639.title: "洒水器"
	quest.42000000002A063A.quest_desc: [
		"盖住水渠，这样你就能沿着一行走。",
		"做法：盖住水渠，这样你就能沿着一行走。"
	]
	quest.42000000002A063A.title: "水渠格栅"
	quest.42000000002A063B.quest_desc: [
		"读这间屋子。光照、湿度，作物停住的原因。",
		"做法：先合成，再放在房间里，读取光照和湿度。"
	]
	quest.42000000002A063B.title: "温室监测器"
	quest.42000000002A063C.quest_desc: [
		"后期的木棍。防火，固执，给那些对木头要求太高的植物。两株相邻的成熟作物可以杂交。",
		"做法：两块黑曜石竖着摆，做出八根。两株相邻的成熟作物可以杂交。"
	]
	quest.42000000002A063C.title: "黑曜石作物棍"
	quest.42000000002A063D.quest_desc: [
		"一条你能走上去的水渠。可选。",
		"做法：一条你能走上去的水渠。可选。"
	]
	quest.42000000002A063D.title: "空心水渠"
	quest.42000000002A063E.quest_desc: [
		"矿石作物会掉这些。可选的育种线。",
		"做法：木制作物棍用木棍做；日志是书与笔加上种子；分析器是玻璃和木头。种在耕地上。"
	]
	quest.42000000002A063E.title: "铜粒作物"
	quest.42000000002A063F.quest_desc: [
		"从木棍上得到石英。可选。",
		"做法：木制作物棍用木棍做；日志是书与笔加上种子；分析器是玻璃和木头。种在耕地上。"
	]
	quest.42000000002A063F.title: "石英碎片作物"
	quest.42000000002A0640.quest_desc: [
		"从作物得到的燃料。可选。",
		"做法：木制作物棍用木棍做；日志是书与笔加上种子；分析器是玻璃和木头。种在耕地上。"
	]
	quest.42000000002A0640.title: "煤炭卵石"
	quest.42000000002A0641.quest_desc: [
		"后期矿石作物。可选。",
		"做法：木制作物棍用木棍做；日志是书与笔加上种子；分析器是玻璃和木头。种在耕地上。"
	]
	quest.42000000002A0641.title: "绿宝石碎片作物"
	quest.42000000002A0642.quest_desc: [
		"后期矿石作物。可选。",
		"做法：木制作物棍用木棍做；日志是书与笔加上种子；分析器是玻璃和木头。种在耕地上。"
	]
	quest.42000000002A0642.title: "钻石碎片作物"
	quest.42000000002A0643.quest_desc: [
		"顶峰矿石作物。可选，而且慢。",
		"做法：木制作物棍用木棍做；日志是书与笔加上种子；分析器是玻璃和木头。种在耕地上。"
	]
	quest.42000000002A0643.title: "下界合金薄片"
	quest.42000000002A0644.quest_desc: [
		"AgriCraft 自己的花。可选。",
		"做法：木制作物棍用木棍做；日志是书与笔加上种子；分析器是玻璃和木头。种在耕地上。"
	]
	quest.42000000002A0644.title: "Amathyllis 花瓣"
	reward.5000000000060135.title: "回归丝线：Clowder 生命 +1"
	reward.5000000000080193.title: "回归丝线：Clowder 生命 +1"
	reward.50000000000901CC.title: "回归丝线：Clowder 生命 +1"
	reward.5000000000170337.title: "回归丝线：Clowder 生命 +1"
	reward.50000000002004DD.title: "回归丝线：Clowder 生命 +1"
