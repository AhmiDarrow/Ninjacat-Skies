	]
	quest.42000000001D0492.title: "无线合成"
	quest.42000000001D0493.quest_desc: [
		"发射物质球；要用之前先充能。",
		"做法：纺锤网络 — 从沙子得到 Certus，控制器要一个缚结。"
	]
	quest.42000000001D0493.title: "物质炮"
	quest.42000000001D0494.quest_desc: [
		"一块透明方块，用来做控制器外壳和线缆走线。",
		"做法：纺锤网络 — 从沙子得到 Certus，控制器要一个缚结。"
	]
	quest.42000000001D0494.title: "石英玻璃"
	quest.42000000001D0495.quest_desc: [
		"自己会发光的玻璃，不用火把。",
		"做法：纺锤网络 — 从沙子得到 Certus，控制器要一个缚结。"
	]
	quest.42000000001D0495.title: "荧光石英"
	quest.42000000001D0496.quest_desc: [
		"一块实心存储方块，四颗晶体凝成一块。",
		"做法：纺锤网络 — 从沙子得到 Certus，控制器要一个缚结。"
	]
	quest.42000000001D0496.title: "Fluix 块"
	quest.42000000001D0497.quest_desc: [
		"把一块存储元件分成几个更小的库存池。",
		"做法：纺锤网络 — 从沙子得到 Certus，控制器要一个缚结。"
	]
	quest.42000000001D0497.title: "元件工作台"
	quest.42000000001E0498.quest_desc: [
		"黏土和骨粉，通向瓷具的一步。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：黏土球 + 骨粉，无序合成。黏土来自张力桶。"
	]
	quest.42000000001E0498.title: "瓷黏土（虚空工艺）"
	quest.42000000001E0499.quest_desc: [
		"更轻的桶，对前期砂砾预算更省。",
		"做法：把瓷黏土塑成未烧的桶，然后熔炼。"
	]
	quest.42000000001E0499.title: "瓷桶"
	quest.42000000001E049A.quest_desc: [
		"在火上把方块熔成液体。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E049A.title: "瓷坩埚（虚空工艺）"
	quest.42000000001E049B.quest_desc: [
		"筛子的第一张网；慢，但能用。",
		"做法：九根线摆成3x3。砾歌者的摊位出售虚空织机的丝线网（线），筛出来的一样。"
	]
	quest.42000000001E049B.title: "线网（虚空工艺）"
	quest.42000000001E049C.quest_desc: [
		"比线筛得更快，值得升级。",
		"做法：四块燧石和五根线排成棋盘格。燧石来自砾石，或丝线 + 砾石。"
	]
	quest.42000000001E049C.title: "燧石网（虚空工艺）"
	quest.42000000001E049D.quest_desc: [
		"结实的中档网，筛得稳当。",
		"做法：四个铁锭和五根线排成棋盘格。没有摊位卖这个。"
	]
	quest.42000000001E049D.title: "铁网（Voidcraft）"
	quest.42000000001E049E.quest_desc: [
		"出的东西比铁更稀有。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E049E.title: "金网（Voidcraft）"
	quest.42000000001E049F.quest_desc: [
		"筛得够快，喂得饱一排漏斗。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E049F.title: "钻石网（Voidcraft）"
	quest.42000000001E04A0.quest_desc: [
		"筛子能装上的最好的网。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04A0.title: "下界合金网（Voidcraft）"
	quest.42000000001E04A1.quest_desc: [
		"用线纺成，是织机自己的纤维。",
		"做法：四根线 → 两团纱。张力桶：线 + 珍珠。四份织机绒絮。"
	]
	quest.42000000001E04A1.title: "虚空纱储备"
	quest.42000000001E04A2.quest_desc: [
		"织机的软门：柱、压机和控制器都要一个。",
		"做法：一圈虚空纱围住粘液球。"
	]
	quest.42000000001E04A2.title: "缚结储备"
	quest.42000000001E04A3.quest_desc: [
		"虚空织机做的基础筛网。",
		"做法：纱的周围绕上线。砾歌者的摊子卖一张。"
	]
	quest.42000000001E04A3.title: "丝线网（线）"
	quest.42000000001E04A4.quest_desc: [
		"虚空织机的网，比普通的线高一档。",
		"做法：丝线网（线）四周放上燧石。"
	]
	quest.42000000001E04A4.title: "丝线网（燧石）"
	quest.42000000001E04A5.quest_desc: [
		"虚空织机的网，为稳定产出而做。",
		"做法：丝线网（燧石）四周放上铁。丝缕细丝从这里开始。"
	]
	quest.42000000001E04A5.title: "丝线网（铁）"
	quest.42000000001E04A6.quest_desc: [
		"把砂砾再敲细一档：圆石到砾石，砾石到沙子，沙子到粉。",
		"做法：圆石 + 木棍。把砂砾敲成沙砾、沙子和粉。"
	]
	quest.42000000001E04A6.title: "纺锤锤（Voidcraft）"
	quest.42000000001E04A7.quest_desc: [
		"刮下树叶，得到树苗和蚕。",
		"做法：四根木棍。砾歌者的摊位卖一把。"
	]
	quest.42000000001E04A7.title: "纺锤曲杖"
	quest.42000000001E04A8.quest_desc: [
		"织机的筛架：把网绷上去，再喂砂砾。",
		"做法：木板围住一枚缚结。把网绷上，用漏斗送入砂砾，把它坐在漏斗上。"
	]
	quest.42000000001E04A8.title: "织机架"
	quest.42000000001E04A9.quest_desc: [
		"水和泥土变成黏土；线和一颗珍珠变成纱。",
		"做法：木板、线、虚空纱。倒入水（桶会回来），加入泥土 → 黏土。"
	]
	quest.42000000001E04A9.title: "张力桶（Voidcraft）"
	quest.42000000001E04AA.quest_desc: [
		"九块泥土折成一块，方便往上带。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04AA.title: "压缩泥土"
	quest.42000000001E04AB.quest_desc: [
		"九块圆石压紧，便宜，而且用不完。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04AB.title: "压缩圆石（Voidcraft）"
	quest.42000000001E04AC.quest_desc: [
		"九份砾石压实；压缩筛整块收下。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04AC.title: "压缩砾石"
	quest.42000000001E04AD.quest_desc: [
		"九块沙子压成一块，方便搬运。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04AD.title: "压缩沙子"
	quest.42000000001E04AE.quest_desc: [
		"九块粉压下去，理由一样。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04AE.title: "压缩粉"
	quest.42000000001E04AF.quest_desc: [
		"压实的下界石，好让物品栏轻一点。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04AF.title: "压缩下界岩"
	quest.42000000001E04B0.quest_desc: [
		"压实的末地石，等虚空要喂食时用得上。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04B0.title: "压缩末地石"
	quest.42000000001E04B1.quest_desc: [
		"深板岩九合一压实，归根结底仍只是石头。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04B1.title: "压缩深板岩"
	quest.42000000001E04B2.quest_desc: [
		"一下砸开整整一组压缩方块。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04B2.title: "压缩锤"
	quest.42000000001E04B3.quest_desc: [
		"更弱的锤子，用来敲开压缩方块。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04B3.title: "压缩铁锤"
	quest.42000000001E04B4.quest_desc: [
		"一张宽筛，一次能过好几堆砾石。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04B4.title: "压缩筛（Voidcraft）"
	quest.42000000001E04B5.quest_desc: [
		"筛得和橡木一样，只是木纹不同。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04B5.title: "白桦筛"
	quest.42000000001E04B6.quest_desc: [
		"发酵起来和其他任何桶一样。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04B6.title: "白桦桶"
	quest.42000000001E04B7.quest_desc: [
		"熔块和其他任何坩埚一样。",
		"做法：Ex Deorum 的筛、锤、坩埚或木桶。让网配上砂砾。"
	]
	quest.42000000001E04B7.title: "白桦坩埚"
	quest.42000000001E04B8.quest_desc: [
		"丝缕的货币；去赚，去花，千万别浪费。",
		"做法：任务奖励、织机架上铺了燧石网的泥土、执事储藏。"
	]
	quest.42000000001E04B8.title: "绽线储备"
	quest.42000000001E04B9.quest_desc: [
		"档案页和笔记。",
		"做法：把一条丝缕安到柱上，或在 /clowder hub 的印刻者摊位（8 丝线）。右键阅读；留着，不花掉。"
	]
	quest.42000000001E04B9.title: "抄本页"
	quest.42000000001E04BA.quest_desc: [
		"右键打开「从这里开始」。重音符（`）：任务列表。这本书不指派任务。",
		"做法：起始套件 / 码头箱子。右键这本书；反引号（`）就是任务列表。"
	]
	quest.42000000001E04BA.title: "胡须抄本"
	quest.42000000001F04BB.quest_desc: [
		"封死之前，包裹里的那张纸。",
		"九个部族为下一个 Clowder 留下了物资。用一份执事储藏拆开随机补给，或把四个小型储藏合成一个中型，三个中型合成一个大型。更大的封存有更多抽取和更广的补给池；分开打开能得到更多基础补给。里面不藏机器，也不藏进度信物，但每个封存都有很小的机会得到丝线碎片，以及更小的机会得到一整根回归丝线；封存越大，机会越好。",
		"做法：金锭和木板围着末影之眼。Packaged Auto 的第一个合成。"
	]
	quest.42000000001F04BB.title: "包裹组件"
	quest.42000000001F04BC.quest_desc: [
		"改成围着存好的样板做成的包裹外壳。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04BC.title: "ME 包裹组件"
	quest.42000000001F04BD.quest_desc: [
		"把物品封进包裹，让产线运走。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04BD.title: "封装器（封装）"
	quest.42000000001F04BE.quest_desc: [
		"给封装器再加一个封装槽。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04BE.title: "封装器扩展"
	quest.42000000001F04BF.quest_desc: [
		"把包裹拆回成散件。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04BF.title: "拆封器"
	quest.42000000001F04C0.quest_desc: [
		"把合成配方写到包裹样板上。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04C0.title: "编码器"
	quest.42000000001F04C1.quest_desc: [
		"照着写好的配方组装包裹。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04C1.title: "合成器"
	quest.42000000001F04C2.quest_desc: [
		"把包裹送到对得上的地址。",
		"做法：分配器标记、封装组件、两个潜影壳、四颗末影珍珠和一块铁块。壳：整合包配方，六块紫珀、两颗末影珍珠和一枚缚结。"
	]
	quest.42000000001F04C2.title: "分配器"
	quest.42000000001F04C3.quest_desc: [
		"标出分配器能送包裹去的目的地。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04C3.title: "分配器标记"
	quest.42000000001F04C4.quest_desc: [
		"把做好的包裹送进产线，等人来取。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04C4.title: "封装供应器"
	quest.42000000001F04C5.quest_desc: [
		"让远处的合成器改由这个方块来下请求。",
		"做法：代理标记、封装组件、两个潜影壳、两颗末影珍珠、两块哭泣黑曜石和一块铁块。壳：整合包配方，六块紫珀、两颗末影珍珠和一枚缚结。"
	]
	quest.42000000001F04C5.title: "合成代理"
	quest.42000000001F04C6.quest_desc: [
		"存下一批包裹配方，好再使用。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04C6.title: "配方匣"
	quest.42000000001F04C7.quest_desc: [
		"把一个方块的设置抄到另一个上，少点很多次。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04C7.title: "设置克隆器"
	quest.42000000001F04C8.quest_desc: [
		"往包裹里灌流体，不装物品。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04C8.title: "流体包裹填充器"
	quest.42000000001F04C9.quest_desc: [
		"封好的一捆物品，可以运走，也可以存放。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04C9.title: "包裹物品"
	quest.42000000001F04CA.quest_desc: [
		"一个包裹比普通那种装得多得多。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04CA.title: "容积包裹"
	quest.42000000001F04CB.quest_desc: [
		"标出合成代理该够到的位置。",
		"做法：先是包裹组件，然后封装器 / 编码器。ME 那部分需要 AE2 网络。"
	]
	quest.42000000001F04CB.title: "代理标记"
	quest.42000000001F04CC.quest_desc: [
		"把封装产线接到数字织机上。",
		"做法：纺锤网络 — 从沙子得到 Certus，控制器要一个缚结。"
	]
	quest.42000000001F04CC.title: "AE 接口"
	quest.42000000001F04CD.quest_desc: [
		"给封装产线提供合成样板。",
		"做法：纺锤网络 — 从沙子得到 Certus，控制器要一个缚结。"
	]
	quest.42000000001F04CD.title: "样板供应器（封装）"
	quest.42000000001F04CE.quest_desc: [
