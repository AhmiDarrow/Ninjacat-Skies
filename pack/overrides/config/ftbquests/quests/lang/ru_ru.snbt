{
	chapter.3100000000000001.chapter_subtitle: [
		"Проснись — выживи, заяви площадку, пусть Кодекс проснётся."
	]
	chapter.3100000000000001.title: "Прядь: Почва"
	chapter.3100000000000002.chapter_subtitle: [
		"Верни — втяни павший мир обратно в вещество."
	]
	chapter.3100000000000002.title: "Прядь: Камень"
	chapter.3100000000000003.chapter_subtitle: [
		"Укоренись — вырасти якоря, чтобы площадка перестала расползаться."
	]
	chapter.3100000000000003.title: "Прядь: Росток"
	chapter.3100000000000004.chapter_subtitle: [
		"Кромка — соберись и покинь площадку нарочно."
	]
	chapter.3100000000000004.title: "Прядь: Коготь"
	chapter.3100000000000005.chapter_subtitle: [
		"Гуди — ритм и пульс раньше проводов."
	]
	chapter.3100000000000005.title: "Прядь: Искра"
	chapter.3100000000000006.chapter_subtitle: [
		"Узор — фабрика как песня, которая несёт себя сама."
	]
	chapter.3100000000000006.title: "Прядь: Часы"
	chapter.3100000000000007.chapter_subtitle: [
		"Колония — держи в живых то, что держит в живых другое."
	]
	chapter.3100000000000007.title: "Прядь: Рой"
	chapter.3100000000000008.chapter_subtitle: [
		"Свяжи — печати, обряды и два пути косы в одном шнуре."
	]
	chapter.3100000000000008.title: "Прядь: Печать"
	chapter.3100000000000009.chapter_subtitle: [
		"Переплети — цифровой стан, Марка, Фрагмент."
	]
	chapter.3100000000000009.title: "Прядь: Веретено"
	chapter.310000000000000A.title: "Глубокое сито"
	chapter.310000000000000B.title: "Склад и рюкзаки"
	chapter.310000000000000C.title: "Цеха Mekanism"
	chapter.310000000000000D.title: "Сеть Powah"
	chapter.310000000000000E.title: "Арканная сторона"
	chapter.310000000000000F.chapter_subtitle: [
		"Команды, Зал, Столб и Разрыв."
	]
	chapter.310000000000000F.title: "Зал Clowder"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Кухонная линия"
	chapter.3100000000000013.title: "Боевые чары"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Декор площадки"
	chapter.3100000000000016.title: "Плацдарм Незера"
	chapter.3100000000000017.title: "Плацдарм Энда"
	chapter.3100000000000018.title: "Поля эссенции"
	chapter.3100000000000019.chapter_subtitle: [
		"Каждое гнездо — это кольцо чего-то вокруг цветка."
	]
	chapter.3100000000000019.title: "Пасека Роя"
	chapter.310000000000001A.title: "Трубы"
	chapter.310000000000001B.title: "Иной мир"
	chapter.310000000000001C.title: "Глубокие часовые механизмы"
	chapter.310000000000001D.title: "Сеть Веретена"
	chapter.310000000000001E.title: "Пустотное ремесло"
	chapter.310000000000001F.title: "Упакованные линии"
	chapter.3100000000000020.title: "QIO и вершина Mek"
	chapter.3100000000000021.title: "Охота и ферма"
	chapter.3100000000000022.title: "Племенное ткачество"
	chapter.3100000000000023.chapter_subtitle: [
		"Певуны щебня режут один камень сотней способов."
	]
	chapter.3100000000000023.title: "Каменотёс"
	chapter.3100000000000024.chapter_subtitle: [
		"Площадка — это уступ, пока кто-нибудь не поставит туда стул."
	]
	chapter.3100000000000024.title: "Убранство"
	chapter.3100000000000025.chapter_subtitle: [
		"Маленькие машины, которые оставили хранители."
	]
	chapter.3100000000000025.title: "Малые хранительства"
	chapter.3100000000000026.chapter_subtitle: [
		"Пульс Барабанных сердец учится бежать по меди."
	]
	chapter.3100000000000026.title: "Ток"
	chapter.3100000000000027.chapter_subtitle: [
		"Разрез порвал тринадцать стражей. Натяни заново каждую Прядь, одолев её стража."
	]
	chapter.3100000000000027.title: "Оборванные стражи"
	chapter.3100000000000028.chapter_subtitle: [
		"Иди по Марке. Приручи жёлтого. Esther ждёт в Зале после того, как ты там побываешь."
	]
	chapter.3100000000000028.title: "Бегуны площадки"
	chapter.3100000000000029.chapter_subtitle: [
		"Сады с сита. Готовь то, чего площадка пустоты никогда не растила."
	]
	chapter.3100000000000029.title: "Стол урожая"
	chapter.310000000000002A.chapter_subtitle: [
		"Палки для посевов, параметры, полив. На уступе сорняки не держатся."
	]
	chapter.310000000000002A.title: "Палки для посевов"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Крафт и натяжение"
	chapter_group.2100000000000003.title: "Переплести"
	chapter_group.2100000000000004.title: "Боковые тропы"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"Ты проснулся на уступе. Посмотри в пропасть, потом нажми сюда.",
		"Гравис (`) — это список заданий. Кодекс Усов — это Начни здесь.",
		"Как: нажми задание. Потом ударь дуб."
	]
	quest.4200000000018001.title: "Посмотри в пропасть"
	quest.4200000000010001.quest_desc: [
		"Ты — Skybound. Это то, что не упало.",
		"Восемь брёвен. Начни с дерева; оно начало с тебя.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: ударь дуб на своей площадке. Восемь брёвен начинают Пробуждение."
	]
	quest.4200000000010001.title: "Пробуждение на площадке"
	quest.4200000000010002.quest_desc: [
		"Земля — обещание, которое площадка даёт твоим ботинкам.",
		"Шестнадцать блоков. Расширь обещание.",
		"Как: стартовый сундук, сток булыжник+нить, остатки сита или /clowder hub (Хранители площадки)."
	]
	quest.4200000000010002.title: "На чём стоять"
	quest.4200000000010003.quest_desc: [
		"Рукам нужна поверхность. Всё, что после, — тоже поверхность.",
		"Как: четыре доски квадратом."
	]
	quest.4200000000010003.title: "Сделай верстак"
	quest.4200000000010004.quest_desc: [
		"Коготь будет позже. Пока — дерево, которое кусает.",
		"Как: три доски над двумя палками."
	]
	quest.4200000000010004.title: "Деревянная кирка"
	quest.4200000000010005.quest_desc: [
		"Зелень на фоне пропасти.",
		"Посади его, пока не проголодался.",
		"Как: сломай дубовые листья или /clowder hub Корневязы (8 Нить за четыре)."
	]
	quest.4200000000010005.title: "Первый саженец"
	quest.4200000000010006.quest_desc: [
		"Шестьдесят четыре доски — это площадка, которая перестаёт казаться уступом.",
		"Как: одно бревно в сетке крафта даёт четыре."
	]
	quest.4200000000010006.title: "Запас досок"
	quest.4200000000010007.quest_desc: [
		"Рукояти, остовы, кости инструментов.",
		"Как: две доски столбиком."
	]
	quest.4200000000010007.title: "Связка палок"
	quest.4200000000010008.quest_desc: [
		"Клади вещи туда, где они останутся. Clowder делит сундук раньше, чем что-либо ещё.",
		"Как: восемь досок вокруг пустого центра."
	]
	quest.4200000000010008.title: "Сундук для Clowder"
	quest.4200000000010009.quest_desc: [
		"Увидь край раньше, чем край увидит тебя.",
		"Как: уголь или древесный уголь над палкой. Родичи в /clowder hub продают пачку."
	]
	quest.4200000000010009.title: "Линия факелов"
	quest.420000000001000A.quest_desc: [
		"Лёд и лава делают камень там, где его не было.",
		"Площадки Обычный и Сложный везут и то, и другое. Хранители площадки в /clowder hub продают ведро.",
		"Как: лава рядом с водой (или тающий лёд). Бей камень молотом. Лавка Певунов щебня в /clowder hub продаёт связку."
	]
	quest.420000000001000A.title: "Запас булыжника"
	quest.420000000001000B.quest_desc: [
		"Тепло, которое ещё не Искра.",
		"Хранители площадки назвали бы это очагом.",
		"Как: восемь булыжников вокруг пустого центра."
	]
	quest.420000000001000B.title: "Жар печи"
	quest.420000000001000C.quest_desc: [
		"Голод — мягкая пустота. Восемь буханок закрывают её ненадолго.",
		"Как: три пшеницы в ряд, или /clowder hub Хранитель очага."
	]
	quest.420000000001000C.title: "Приготовь еду"
	quest.420000000001000D.quest_desc: [
		"Поставь лаву, растопи лёд в источник, наполни ведро.",
		"Лёгкий везёт воду; Обычный и Сложный везут части.",
		"Как: пустое ведро на источник воды. Обычный/Сложный: поставь лаву, растопи лёд, наполни."
	]
	quest.420000000001000D.title: "Поймай дождь"
	quest.420000000001000E.quest_desc: [
		"Обрезки Ткацкого стана, которые ещё держатся. Каждое задание возвращает немного.",
		"Распусти одну в бечёвку или потрать их на лавках Родичей в /clowder hub.",
		"Как: награды заданий, земля с кремнёвой сеткой на Раме ткацкого стана, тайники хранителя."
	]
	quest.420000000001000E.title: "Истрёпанная валюта"
	quest.420000000001000F.quest_desc: [
		"Повреждён, но всё ещё учит. Открой Начни здесь.",
		"ПКМ по книге и открой Начни здесь. Гравис (`): список заданий.",
		"Как: стартовый набор / сундук причала. ПКМ по книге; гравис (`) — список заданий."
	]
	quest.420000000001000F.title: "Кодекс в руке"
	quest.4200000000010010.quest_desc: [
		"Поставь точку возрождения.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010010.title: "Кровать-точка"
	quest.4200000000010011.quest_desc: [
		"Спускайся в глубину без верёвки. Дешёвая, хватит оставить по одной в каждой шахте.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010011.title: "Лестница вниз"
	quest.4200000000010012.quest_desc: [
		"Паутина припасена для будущих сеток. Каждое волокно рано или поздно пригодится.",
		"Как: распусти Истрёпанную нить (1 → 3). Пауки. Пух стана на Эховязи. Обратный сток пряжи."
	]
	quest.4200000000010012.title: "Запас бечёвки"
	quest.4200000000010013.quest_desc: [
		"Ускорь зелень.",
		"Как: кости в сетке, или сток Нить + гнилая плоть, или /clowder hub Хранители площадки."
	]
	quest.4200000000010013.title: "Запас костной муки"
	quest.4200000000010014.quest_desc: [
		"Расширь площадку.",
		"Как: стартовый сундук, сток булыжник+нить, остатки сита или /clowder hub (Хранители площадки)."
	]
	quest.4200000000010014.title: "Земляная площадка"
	quest.4200000000010015.quest_desc: [
		"Подрежь их сейчас, в компост потом. На площадке ничего не пропадает зря.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010015.title: "Дубовые листья"
	quest.4200000000010016.quest_desc: [
		"Тихий уголок.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010016.title: "Цветочный горшок"
	quest.4200000000010017.quest_desc: [
		"Бочка Ex Deorum: компост, и вода в глину медленным путём.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010017.title: "Бочка"
	quest.4200000000010018.quest_desc: [
		"Отход в муку.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010018.title: "Компостер"
	quest.4200000000010019.quest_desc: [
		"Прочерти ряд.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010019.title: "Деревянная мотыга"
	quest.420000000001001A.quest_desc: [
		"Валит брёвна быстрее голых рук. Первый настоящий инструмент, который есть у Skybound.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001001A.title: "Деревянный топор"
	quest.420000000001001B.quest_desc: [
		"Превращает землю и гравий в расчищенный грунт. Медленная, но работает.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001001B.title: "Деревянная лопата"
	quest.420000000001001C.quest_desc: [
		"Едва останавливает зомби, но всё же останавливает. Лучше, чем махать кулаком.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001001C.title: "Деревянный меч"
	quest.420000000001001D.quest_desc: [
		"Держит суп, рагу и почти ничего больше. Простая посуда для простой площадки.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001001D.title: "Миска"
	quest.420000000001001E.quest_desc: [
		"Пометь площадку.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001001E.title: "Рамка"
	quest.420000000001001F.quest_desc: [
		"Сделай это домом.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001001F.title: "Картина"
	quest.4200000000010020.quest_desc: [
		"Держит ветер и монстров с правильной стороны стены.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010020.title: "Дубовая дверь"
	quest.4200000000010021.quest_desc: [
		"Отмечает край, не закрывая обзор. Удобно там, где падение настоящее.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010021.title: "Дубовый забор"
	quest.4200000000010022.quest_desc: [
		"Превращает отвесную стену в то, по чему правда можно лезть.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010022.title: "Дубовые ступеньки"
	quest.4200000000010023.quest_desc: [
		"Полблока, вдвое больше вариантов пола. Полезно в тесноте.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010023.title: "Дубовая плита"
	quest.4200000000010024.quest_desc: [
		"Люки доступа.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010024.title: "Дубовый люк"
	quest.4200000000010025.quest_desc: [
		"Даёт сигнал, когда на неё наступают. Двери открываются сами.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010025.title: "Дубовая нажимная плита"
	quest.4200000000010026.quest_desc: [
		"Кнопка для импульсов редстоуна.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010026.title: "Дубовая кнопка"
	quest.4200000000010027.quest_desc: [
		"Огороди край площадки.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010027.title: "Калитка из палок"
	quest.4200000000010028.quest_desc: [
		"Готовит медленно, а дым видно очень далеко.",
		"Как: брёвна, палки и уголь или древесный уголь."
	]
	quest.4200000000010028.title: "Костёр"
	quest.4200000000010029.quest_desc: [
		"Вешает свет там, где факел смотрелся бы не к месту. Теплее свечение, та же работа.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010029.title: "Фонарь"
	quest.420000000001002A.quest_desc: [
		"Горит бледно-синим и не даёт почти ничему появиться рядом.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001002A.title: "Фонарь душ"
	quest.420000000001002B.quest_desc: [
		"Поднимается с тобой и исчезает, если потянуть. Строить высоко больше не страшно.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001002B.title: "Строительные леса"
	quest.420000000001002C.quest_desc: [
		"Цепь для подвесного украшения.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001002C.title: "Цепь"
	quest.420000000001002D.quest_desc: [
		"Зарешети край.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001002D.title: "Железные прутья"
	quest.420000000001002E.quest_desc: [
		"Стекло для окон площадки.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001002E.title: "Стеклянная панель"
	quest.420000000001002F.quest_desc: [
		"Мягкая, горючая и легко красится. Каждой площадке рано или поздно нужна кровать.",
		"Как: постриги овец после того, как дашь им траву, или четыре бечёвки."
	]
	quest.420000000001002F.title: "Белая шерсть"
	quest.4200000000010030.quest_desc: [
		"Тонкий слой шерсти для полов, которым не нужен целый блок.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010030.title: "Белый ковёр"
	quest.4200000000010031.quest_desc: [
		"Добавляет немного зелени и розового площадке из щебня.",
		"Как: мох плюс дуб, или костная мука на мох. Пчёлы принимают цветок."
	]
	quest.4200000000010031.title: "Цветущая азалия"
	quest.4200000000010032.quest_desc: [
		"Медленно расползается и смягчает вид платформ из сырого камня.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010032.title: "Блок мха"
	quest.4200000000010033.quest_desc: [
		"Свисающие корни под площадкой.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010033.title: "Свисающие корни"
	quest.4200000000010034.quest_desc: [
		"Цепляется к стенам и освещает их без единого факела.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010034.title: "Светящийся лишайник"
	quest.4200000000010035.quest_desc: [
		"Капельник для острого акцента.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010035.title: "Остроконечный капельник"
	quest.4200000000010036.quest_desc: [
		"Аметист в блоке. Печать позже захочет осколки.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010036.title: "Аметистовый блок"
	quest.4200000000010037.quest_desc: [
		"Девять слитков, плотно спрессованных. Зеленеет, если оставить снаружи.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010037.title: "Медный блок"
	quest.4200000000010038.quest_desc: [
		"Девять кусков необработанного железа, плотно сложенных, ждут печи.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010038.title: "Блок необработанного железа"
	quest.4200000000010039.quest_desc: [
		"Горит куда дольше, чем россыпь угля. Закинь в печь и уходи.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000010039.title: "Угольный блок"
	quest.420000000001003A.quest_desc: [
		"Кормит животных и замедляет падение. Фермеры держат его под рукой ради обоих дел.",
		"Как: девять пшениц. Из трёх пшениц тоже выходит хлеб."
	]
	quest.420000000001003A.title: "Сноп сена"
	quest.420000000001003B.quest_desc: [
		"Девять ламинарий, спрессованных в топливо. Плавит больше, чем кажется.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001003B.title: "Блок сушёной ламинарии"
	quest.420000000001003C.quest_desc: [
		"Бумага и кожа ждут, чтобы стать чем-то с рецептом.",
		"Как: три бумаги плюс кожа. Бумага — это сахарный тростник."
	]
	quest.420000000001003C.title: "Книга"
	quest.420000000001003D.quest_desc: [
		"Бумага для книг и карт.",
		"Как: три сахарного тростника в ряд. Тростник даёт просеивание земли кремнёвой сеткой или лучше."
	]
	quest.420000000001003D.title: "Бумага"
	quest.420000000001003E.quest_desc: [
		"Краске и книгам нужны чернила.",
		"Как: древесный уголь плюс стеклянная бутылка. Спруты здесь никогда не появляются."
	]
	quest.420000000001003E.title: "Чернильный мешок"
	quest.420000000001003F.quest_desc: [
		"Перья для стрел и книг.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000001003F.title: "Перо"
	quest.4200000000010040.quest_desc: [
		"Кожа для книг и наборов.",
		"Как: переплавь гнилую плоть или приготовь её на костре. Просей землю кремнёвой сеткой. /clowder hub Хранители площадки продают две за 18 Нить."
	]
	quest.4200000000010040.title: "Кожа"
	quest.4200000000010041.quest_desc: [
		"Верстак, саженец, очаг, вода, Кодекс. Площадка держится.",
		"Натяни Прядь: Хранители площадки отвечают, и жетон твой, чтобы его посадить.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.4200000000010041.quest_subtitle: "Пробуждение"
	quest.4200000000010041.title: "Узел Почвы"
	quest.4200000000010042.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.4200000000010042.title: "Посади Почву"
	quest.4200000000010043.quest_desc: [
		"Зомби на площадке без пещер. Пустота передаёт привет.",
		"Освети края.",
		"Как: убей зомби на площадке ночью. Освети края."
	]
	quest.4200000000010043.title: "Что-то вылезло"
	quest.4200000000020044.quest_desc: [
		"Нить, которая помнит, откуда пришла.",
		"Распусти Нить в бечёвку; четыре бечёвки прядут две пряжи.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: четыре бечёвки → две пряжи. Бочка натяжения: бечёвка + жемчуг. Четыре Пуха стана."
	]
	quest.4200000000020044.title: "Достань Пустотную пряжу"
	quest.4200000000020045.quest_desc: [
		"Булыжник и палки. Разбей упавшую крошку на гравий, песок и пыль.",
		"Как: булыжник + палки. Разбей крошку на гравий, песок и пыль."
	]
	quest.4200000000020045.title: "Молот веретена"
	quest.4200000000020046.quest_desc: [
		"Бечёвка вокруг пряжи. Ловит то, что уронил Ткацкий стан — и вычёсывает Пух стана из земли.",
		"Как: бечёвка вокруг пряжи. Лавка Певунов щебня продаёт одну."
	]
	quest.4200000000020046.title: "Продень сетку"
	quest.4200000000020047.quest_desc: [
		"Налей воду; ведро сразу возвращается. Добавь землю. Жди глину.",
		"Бечёвка и жемчужина в той же бочке дают пряжу.",
		"Как: доски, бечёвка и Пустотная пряжа. Налей воду (ведро возвращается), добавь землю → глина."
	]
	quest.4200000000020047.title: "Бочка натяжения"
	quest.4200000000020048.quest_desc: [
		"Шестнадцать глины из бочки. Загружай по восемь земли за раз.",
		"Как: Бочка натяжения — вода + земля. Эходробилка дробит песок в глину."
	]
	quest.4200000000020048.title: "Глиняный карман"
	quest.4200000000020049.quest_desc: [
		"Глина и костная мука. Слепи необожжённое ведро.",
		"Как: комок глины + костная мука, без формы. Глина берётся из Бочки натяжения."
	]
	quest.4200000000020049.title: "Фарфоровая глина"
	quest.420000000002004A.quest_desc: [
		"Переплавь. Фарфор носит лаву там, где железо ещё только слух.",
		"Как: слепи из фарфоровой глины необожжённое ведро, затем переплавь его."
	]
	quest.420000000002004A.title: "Фарфоровый инструмент"
	quest.420000000002004B.quest_desc: [
		"Певуны щебня звали каждый осколок по его эху.",
		"Сей, пока не услышишь железо.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.420000000002004B.title: "Просей упавшую крошку"
	quest.420000000002004C.quest_desc: [
		"Запасной набор ударов.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.420000000002004C.title: "Wooden Hammer"
	quest.420000000002004D.quest_desc: [
		"Материя из крошки. Шестьдесят четыре камня, что час назад были пылью.",
		"Как: лава рядом с водой (или тающий лёд). Бей камень молотом. Лавка Певунов щебня в /clowder hub продаёт связку."
	]
	quest.420000000002004D.title: "Галька"
	quest.420000000002004E.quest_desc: [
		"Пыль Ткацкого стана ждёт в гравии. Кремень тоже.",
		"Как: бей булыжник (Молот веретена или Эходробилка)."
	]
	quest.420000000002004E.title: "Гравийная тропа"
	quest.420000000002004F.quest_desc: [
		"Мелкая крошка. Стекло потом, и лучший улов железной сетки.",
		"Как: бей гравий."
	]
	quest.420000000002004F.title: "Запас песка"
	quest.4200000000020050.quest_desc: [
		"Пепел павшего мира. Редстоун и порох прячутся в нём.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.4200000000020050.title: "Куча пыли"
	quest.4200000000020051.quest_desc: [
		"Пряжа вокруг слизи. Компост площадки делает слизь.",
		"Узел — мягкие врата Ткацкого стана; оставь два.",
		"Как: кольцо Пустотной пряжи вокруг шарика слизи."
	]
	quest.4200000000020051.title: "Завяжи Связующий узел"
	quest.4200000000020052.quest_desc: [
		"Доски вокруг Узла. Натяни сетку, загрузи крошку, пусть работает.",
		"Воронки её кормят. Это первая машина площадки.",
		"Как: доски вокруг Связующего узла. Натяни сетку, подай крошку воронкой и поставь её на воронку."
	]
	quest.4200000000020052.title: "Поставь Раму ткацкого стана"
	quest.4200000000020053.quest_desc: [
		"Железо низкое и терпеливое. Восемь кусков с сетки.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.4200000000020053.title: "Iron Ore Chunk"
	quest.4200000000020054.quest_desc: [
		"Просеян из гравия по крупице. Сетка находит медь раньше твоих глаз.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.4200000000020054.title: "Copper Ore Chunk"
	quest.4200000000020055.quest_desc: [
		"Золото едва утруждается ответить. Четырёх хватит.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.4200000000020055.title: "Gold Ore Chunk"
	quest.4200000000020056.quest_desc: [
		"Заправь линию.",
		"Как: просей гравий или переплавь угольную руду."
	]
	quest.4200000000020056.title: "Уголь"
	quest.4200000000020057.quest_desc: [
		"Из кусков в сырьё. Плавь дальше.",
		"Как: просей гравий на куски железной руды; четыре дают блок железной руды, а его добыча роняет необработанное железо."
	]
	quest.4200000000020057.title: "Необработанное железо"
	quest.4200000000020058.quest_desc: [
		"Возврат платит. Шестнадцать слитков, которых пустота не хотела тебе отдавать.",
		"Как: переплавь необработанное железо / железную крошку (печь или Печь углей). Просей гравий ради кусков."
	]
	quest.4200000000020058.title: "Железный слиток"
	quest.4200000000020059.quest_desc: [
		"Провод и лампочки, а позже племенные резонаторы.",
		"Как: переплавь необработанную медь / медную крошку. Просей гравий."
	]
	quest.4200000000020059.title: "Медный слиток"
	quest.420000000002005A.quest_desc: [
		"Золочёные инструменты и золотые пластины для Ткачей узоров.",
		"Как: переплавь необработанное золото / золотую крошку. Более редкий улов сита."
	]
	quest.420000000002005A.title: "Золотой слиток"
	quest.420000000002005B.quest_desc: [
		"Более острый улов. Кремнёвые сетки вытряхивают Истрёпанную нить из крошки.",
		"Как: кремень вокруг нитяной сетки (бечёвка)."
	]
	quest.420000000002005B.title: "Кремнёвая сетка"
	quest.420000000002005C.quest_desc: [
		"Металлическая нить для более тяжёлой пыли. Железные сетки — там, где падает Волокно Пряди.",
		"Как: железо вокруг нитяной сетки (кремень). Здесь начинается Волокно Пряди."
	]
	quest.420000000002005C.title: "Железная сетка"
	quest.420000000002005D.quest_desc: [
		"Плавит и капает. Из булыжника в лаву, если дать время.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.420000000002005D.title: "Тигель"
	quest.420000000002005E.quest_desc: [
		"Бочка Ex Deorum: компост, и вода в глину медленным путём.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.420000000002005E.title: "Бочка (камень)"
	quest.420000000002005F.quest_desc: [
		"Удары тяжелее, жизнь длиннее.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.420000000002005F.title: "Stone Hammer"
	quest.4200000000020060.quest_desc: [
		"Дробит руду в гравий и крошку, шумный трюк за ситом.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.4200000000020060.title: "Iron Hammer"
	quest.4200000000020061.quest_desc: [
		"Сетка шире, девять за раз.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.4200000000020061.title: "Сжатое сито"
	quest.4200000000020062.quest_desc: [
		"Сквозь видно. Из песка в стекло.",
		"Как: переплавь песок. Молотом из булыжника в гравий, из гравия в песок, затем в печь."
	]
	quest.4200000000020062.title: "Стекло"
	quest.4200000000020063.quest_desc: [
		"Теперь носи дождь в железе.",
		"Как: три железных слитка, или /clowder hub Хранители площадки (8 Нитей). Наполни из растаявшего льда."
	]
	quest.4200000000020063.title: "Ведро"
	quest.4200000000020064.quest_desc: [
		"Жар из пустоты, в руке.",
		"Как: лавовый тигель Ex Deorum, или лавовое озеро Незера после обсидиана Когтя."
	]
	quest.4200000000020064.title: "Ведро лавы"
	quest.4200000000020065.quest_desc: [
		"Мысли о портале. Вода на источник лавы.",
		"Как: вода на источник лавы (или лава на воду). Сохрани источник лавы."
	]
	quest.4200000000020065.title: "Обсидиан"
	quest.4200000000020066.quest_desc: [
		"Редкая удача крошки. Два — это начало.",
		"Как: просей гравий железной сеткой или лучше, или алмазную руду в Эходробилке."
	]
	quest.4200000000020066.title: "Алмаз"
	quest.4200000000020067.quest_desc: [
		"Топливо для улучшения сетки.",
		"Как: гравий, или сток Нить + гравий."
	]
	quest.4200000000020067.title: "Кремень"
	quest.4200000000020068.quest_desc: [
		"Сделан из крошки и пыли, а не снят с крипера. Обращайся осторожно.",
		"Как: просей пыль или песок душ, или криперов на площадке ночью. Держи края освещёнными, когда уже есть немного."
	]
	quest.4200000000020068.title: "Порох"
	quest.4200000000020069.quest_desc: [
		"Искра захочет это. Держи сухим.",
		"Как: просей гравий или редстоуновую руду в Эходробилке после Возврата."
	]
	quest.4200000000020069.title: "Редстоун"
	quest.420000000002006A.quest_desc: [
		"Кормит стол зачарований. Синяя пыль, от которой снаряжение слушается лучше.",
		"Как: просей гравий или лазуритовую руду в Эходробилке."
	]
	quest.420000000002006A.title: "Лазурит"
	quest.420000000002006B.quest_desc: [
		"Обычная каменная смесь, нужная в основном для стройки и чтобы позже мешать рецепты.",
		"Как: просей гальку из земли/гравия, или булыжник плюс диорит в JEI."
	]
	quest.420000000002006B.title: "Андезит"
	quest.420000000002006C.quest_desc: [
		"Крапчатый камень, скорее украшение, чем опора. Певуны щебня звали его громким.",
		"Как: просей гальку, или булыжник плюс незерский кварц."
	]
	quest.420000000002006C.title: "Диорит"
	quest.420000000002006D.quest_desc: [
		"Плотный, с розовыми крапинками, хорош для пола, который хочет выделяться.",
		"Как: просей гальку, или диорит плюс незерский кварц."
	]
	quest.420000000002006D.title: "Гранит"
	quest.420000000002006E.quest_desc: [
		"Пористая порода из другого места. Горит вечно, стоит ей заняться.",
		"Как: Незер здесь — пустота, не земля. Лей лаву в бочку Ex Deorum с ведьминой водой (бочка воды на мицелии; споры мицелия просеиваются из земли)."
	]
	quest.420000000002006E.title: "Незерак"
	quest.420000000002006F.quest_desc: [
		"Тормозит каждый шаг по нему и кормит огонь душ более холодной синью.",
		"Как: песок в бочку Ex Deorum с ведьминой водой. В крепости комнаты с наростом держат немного. Три черепа на песке душ делают Иссушителя."
	]
	quest.420000000002006F.title: "Песок душ"
	quest.4200000000020070.quest_desc: [
		"Смолотый из светокамня Незера, годится для зелий и для более мягкого света.",
		"Как: просей песок душ или ведьм на площадке."
	]
	quest.4200000000020070.title: "Светопыль"
	quest.4200000000020071.quest_desc: [
		"Снимает листья с дерева, не замахиваясь топором на ствол.",
		"Как: четыре палки. Лавка Певунов щебня продаёт одну."
	]
	quest.4200000000020071.title: "Клюка"
	quest.4200000000020072.quest_desc: [
		"С сита, растущими кучами. На каждую сетку всё равно не хватает.",
		"Как: распусти Истрёпанную нить (1 → 3). Пауки. Пух стана на Эховязи. Обратный сток пряжи."
	]
	quest.4200000000020072.title: "Бечёвка"
	quest.4200000000020073.quest_desc: [
		"Связка для узлов — или рецепт компоста площадки.",
		"Как: две земли + семена пшеницы + костная мука (компост площадки), или /clowder hub Хранители площадки."
	]
	quest.4200000000020073.title: "Сгусток слизи"
	quest.4200000000020074.quest_desc: [
		"В костную муку, или целиком, чтобы вывести следующего волка стаи.",
		"Как: скелеты ночью, или /clowder hub Хранители площадки (16 Нити за 8)."
	]
	quest.4200000000020074.title: "Кость"
	quest.4200000000020075.quest_desc: [
		"Горький и слегка ядовитый. Идёт в зелья, никто не ест его просто так.",
		"Как: пауки на площадке ночью."
	]
	quest.4200000000020075.title: "Паучий глаз"
	quest.4200000000020076.quest_desc: [
		"Пряжа, фарфор, работающая Рама ткацкого стана, железо в сундуке.",
		"Натяни Прядь: Певуны щебня ответят.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.4200000000020076.quest_subtitle: "Возврат"
	quest.4200000000020076.title: "Узел Камня"
	quest.4200000000020077.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.4200000000020077.title: "Установи Камень"
	quest.4200000000020078.quest_desc: [
		"Крипер, с которым покончено. Порох дороже испуга.",
		"Как: убей трёх криперов. Награда — порох."
	]
	quest.4200000000020078.title: "Бум, потом"
	quest.4200000000030079.quest_desc: [
		"Процарапай ряды на площадке.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: два железных слитка над палкой."
	]
	quest.4200000000030079.title: "Железная мотыга"
	quest.420000000003007A.quest_desc: [
		"Хлеб — это инфраструктура. Тридцать две пшеницы — это поле, не грядка.",
		"Как: семена пшеницы на пашню, затем костная мука. Семена — ломая траву или из стартового сундука."
	]
	quest.420000000003007A.title: "Пшеничное поле"
	quest.420000000003007B.quest_desc: [
		"Сажай то, что ешь.",
		"Как: ломай траву или просей землю кремнёвой сеткой. Сажай на пашню; костная мука ускоряет первое поле."
	]
	quest.420000000003007B.title: "Мешочек семян"
	quest.420000000003007C.quest_desc: [
		"Скорость — это доброта. Компост и кости.",
		"Как: кости в сетке, или сток Нить + гнилая плоть, или /clowder hub Хранители площадки."
	]
	quest.420000000003007C.title: "Двигатель костной муки"
	quest.420000000003007D.quest_desc: [
		"Готовь урожай.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000003007D.title: "Нож фермера"
	quest.420000000003007E.quest_desc: [
		"Кухня начинается здесь.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000003007E.title: "Разделочная доска"
	quest.420000000003007F.quest_desc: [
		"Тёплая еда кормит не только голод.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000003007F.title: "Кухонный котёл"
	quest.4200000000030080.quest_desc: [
		"Растёт аккуратными кочанами, лучше в блюде, чем сырой.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000030080.title: "Капуста"
	quest.4200000000030081.quest_desc: [
		"Вьётся по своей шпалере и краснеет. Соус начинается здесь.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000030081.title: "Томат"
	quest.4200000000030082.quest_desc: [
		"Слёзы радости.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000030082.title: "Лук"
	quest.4200000000030083.quest_desc: [
		"Начинается ферма эссенции. Шестнадцать с первого ряда.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"Основа семян. Просей или вырасти.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Подними семена из эссенции.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030085.title: "Алтарь наполнения"
	quest.4200000000030086.quest_desc: [
		"Четыре вокруг алтаря.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030086.title: "Пьедестал наполнения"
	quest.4200000000030087.quest_desc: [
		"Вырасти ещё площадки.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030087.title: "Семена земли"
	quest.4200000000030088.quest_desc: [
		"Вырасти полог без топора.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030088.title: "Семена древесины"
	quest.4200000000030089.quest_desc: [
		"Выращено, не добыто. Собирай эссенцию, а не маши киркой.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030089.title: "Семена камня"
	quest.420000000003008A.quest_desc: [
		"Металл с культуры. Второй двигатель Возврата.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000003008A.title: "Семена железа"
	quest.420000000003008B.quest_desc: [
		"Культура, что даёт эссенцию меди вместо медной руды.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000003008B.title: "Семена меди"
	quest.420000000003008C.quest_desc: [
		"Позолоченная культура, что растит эссенцию золота прямо на площадке.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000003008C.title: "Семена золота"
	quest.420000000003008D.quest_desc: [
		"Превращает грядку в источник топлива, добыча не нужна.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000003008D.title: "Семена угля"
	quest.420000000003008E.quest_desc: [
		"Дождь в бутылке, с культуры.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000003008E.title: "Семена воды"
	quest.420000000003008F.quest_desc: [
		"Компактный рост для маленькой площадки.",
		"Как: терракотовый Botany Pot в JEI. Земля + семя в горшке; костная мука всё ещё помогает."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"Горшок, который собирает сам.",
		"Как: Botany Pot с воронкой в JEI. Стоит на сундуке/воронке и собирает урожай сам."
	]
	quest.4200000000030090.title: "Горшок-воронка"
	quest.4200000000030091.quest_desc: [
		"Подними ступень. Семена становятся жаднее и лучше.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"Более глубокая ступень эссенции культур, сильнее семян, с которых ты начал.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Девять костной муки в один блок. Хранение для двигателя.",
		"Как: девять костной муки. Кости со скелетов или от Хранителей площадки."
	]
	quest.4200000000030093.title: "Костный блок"
	quest.4200000000030094.quest_desc: [
		"Излишек Ростка, стопкой.",
		"Как: девять пшениц. Из трёх пшениц тоже выходит хлеб."
	]
	quest.4200000000030094.title: "Сенной силос"
	quest.4200000000030095.quest_desc: [
		"Лучше пашня. Корневязы одобрили бы.",
		"Как: поставь Органический компост и жди; он медленно зреет в Богатую почву."
	]
	quest.4200000000030095.title: "Плодородная почва"
	quest.4200000000030096.quest_desc: [
		"Корми почву, что кормит тебя.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000030096.title: "Органический компост"
	quest.4200000000030097.quest_desc: [
		"Посади ряд, накорми лошадь или просто съешь сырую.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000030097.title: "Морковь"
	quest.4200000000030098.quest_desc: [
		"Основная культура: картофель.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000030098.title: "Картофель"
	quest.4200000000030099.quest_desc: [
		"Растёт быстро и красит в красный. Суп, рагу или прямо из земли.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000030099.title: "Свёкла"
	quest.420000000003009A.quest_desc: [
		"Арбуз для еды и обмена.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000003009A.title: "Арбуз"
	quest.420000000003009B.quest_desc: [
		"Тыква для еды и декора.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000003009B.title: "Тыква"
	quest.420000000003009C.quest_desc: [
		"Бумага и сахар.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000003009C.title: "Сахарный тростник"
	quest.420000000003009D.quest_desc: [
		"Растёт без воды и ранит всё, что на него обопрётся.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000003009D.title: "Кактус"
	quest.420000000003009E.quest_desc: [
		"Быстро тянется вверх и горит жарко. Удобное топливо для площадки, где мало деревьев.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000003009E.title: "Бамбук"
	quest.420000000003009F.quest_desc: [
		"Ягоды, пока строишь.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000003009F.title: "Сладкие ягоды"
	quest.42000000000300A0.quest_desc: [
		"Растёт на брёвнах джунглей; его мелют в коричневый, которым сдабривают всё сладкое.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000300A0.title: "Какао"
	quest.42000000000300A1.quest_desc: [
		"Падает с дубовых листьев в свой срок. Бесплатная еда, рано или поздно.",
		"Как: дубовые листья роняют немного; яблоня Pam's (саженец из земли с железной сеткой) даёт много."
	]
	quest.42000000000300A1.title: "Яблоко"
	quest.42000000000300A2.quest_desc: [
		"Одна миска, без верстака. Ужин ленивого фермера.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000300A2.title: "Тушёные грибы"
	quest.42000000000300A3.quest_desc: [
		"Вкус улья, прежде чем начнётся более глубокая работа с пчёлами.",
		"Как: стеклянная бутылочка на полный улей. Костёр снизу."
	]
	quest.42000000000300A3.title: "Бутылочка мёда"
	quest.42000000000300A4.quest_desc: [
		"Растут на пещерных лозах и освещают тоннель, пока ты их ешь.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000300A4.title: "Светящиеся ягоды"
	quest.42000000000300A5.quest_desc: [
		"Основа каждого зелья, которое стоит разливать. Растёт только на песке душ.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000300A5.title: "Адский нарост"
	quest.42000000000300A6.quest_desc: [
		"Поле, кухня, восходит эссенция.",
		"Натяни Прядь: Корневязы ответят.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.42000000000300A6.quest_subtitle: "Корень"
	quest.42000000000300A6.title: "Узел Ростка"
	quest.42000000000300A7.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.42000000000300A7.title: "Усади Росток"
	quest.42000000000300A8.quest_desc: [
		"Корневязы рано или поздно вытягивают по одной.",
		"Не ешь её. И не выбрасывай.",
		"Как: редкий урожай картофеля. Необязательный секрет Ростка."
	]
	quest.42000000000300A8.title: "Не та картошка"
	quest.42000000000400A9.quest_desc: [
		"Режь пустоту по-своему. Восемь листов чертежей.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: четыре бумаги и один синий краситель, без формы. Даёт четыре листа."
	]
	quest.42000000000400A9.title: "Чертёжная бумага"
	quest.42000000000400AA.quest_desc: [
		"Чертежи в коробке.",
		"Четыре Бумага чертежей, без формы — занятие площадки стирает подарок Silent Gear за вход. ПКМ, чтобы развернуть стартовые чертежи.",
		"Как: четыре Бумага чертежей, без формы. ПКМ, чтобы развернуть стартовые чертежи. Занятие площадки стирает подарок Silent Gear за вход."
	]
	quest.42000000000400AA.title: "Набор чертежей"
	quest.42000000000400AB.quest_desc: [
		"Шаблон, с которого начинается модульный инструмент, прежде чем ты добавишь детали.",
		"Как: разверни Свёрток чертежей, или JEI. Коготь называет линейку инструментов."
	]
	quest.42000000000400AB.title: "Чертёж стержня"
	quest.42000000000400AC.quest_desc: [
		"Сформируй кирку, которая переживёт свой металл.",
		"Как: разверни Свёрток чертежей, или JEI. Коготь называет линейку инструментов."
	]
	quest.42000000000400AC.title: "Чертёж кирки"
	quest.42000000000400AD.quest_desc: [
		"Сформируй топор.",
		"Как: разверни Свёрток чертежей, или JEI. Коготь называет линейку инструментов."
	]
	quest.42000000000400AD.title: "Чертёж топора"
	quest.42000000000400AE.quest_desc: [
		"Сформируй лопату.",
		"Как: разверни Свёрток чертежей, или JEI. Коготь называет линейку инструментов."
	]
	quest.42000000000400AE.title: "Чертёж лопаты"
	quest.42000000000400AF.quest_desc: [
		"Сформируй клинок.",
		"Как: разверни Свёрток чертежей, или JEI. Коготь называет линейку инструментов."
	]
	quest.42000000000400AF.title: "Чертёж меча"
	quest.42000000000400B0.quest_desc: [
		"Место, чтобы расти.",
		"Как: JEI после Бумага чертежей. Коготь называет линейку улучшений."
	]
	quest.42000000000400B0.title: "Базовое улучшение"
	quest.42000000000400B1.quest_desc: [
		"Тридцать два слитка материала на детали.",
		"Как: переплавь необработанное железо / железную крошку (печь или Печь углей). Просей гравий ради кусков."
	]
	quest.42000000000400B1.title: "Железная масса"
	quest.42000000000400B2.quest_desc: [
		"Точит кромку дальше, чем может одно лишь железо.",
		"Как: просей гравий железной сеткой или лучше, или алмазную руду в Эходробилке."
	]
	quest.42000000000400B2.title: "Алмазный наконечник"
	quest.42000000000400B3.quest_desc: [
		"Листья и шерсть, а соты позже.",
		"Как: два железных слитка по диагонали. Стриги овец и пчелиные гнёзда."
	]
	quest.42000000000400B3.title: "Ножницы"
	quest.42000000000400B4.quest_desc: [
		"У площадок есть края. У монстров тоже.",
		"Как: шесть досок вокруг железа. Блок второй рукой."
	]
	quest.42000000000400B4.title: "Щит"
	quest.42000000000400B5.quest_desc: [
		"Переживи ночь нарочно.",
		"Как: восемь железных слитков. Переплавь щебень сита."
	]
	quest.42000000000400B5.title: "Железный нагрудник"
	quest.42000000000400B6.quest_desc: [
		"Берегись падения.",
		"Как: пять железных слитков."
	]
	quest.42000000000400B6.title: "Железный шлем"
	quest.42000000000400B7.quest_desc: [
		"Сначала закрывает ноги. Большая часть урона всё равно идёт снизу.",
		"Как: семь железных слитков."
	]
	quest.42000000000400B7.title: "Железные поножи"
	quest.42000000000400B8.quest_desc: [
		"Укрепляет опору на уступах, где оступиться значит пустота.",
		"Как: четыре железных слитка."
	]
	quest.42000000000400B8.title: "Железные ботинки"
	quest.42000000000400B9.quest_desc: [
		"Держи монстров пустоты на расстоянии.",
		"Как: три бечёвки и три палки."
	]
	quest.42000000000400B9.title: "Лук"
	quest.42000000000400BA.quest_desc: [
		"Шестьдесят четыре причины держать дистанцию.",
		"Как: кремень, палка, перо. Скелеты роняют лишние."
	]
	quest.42000000000400BA.title: "Связка стрел"
	quest.42000000000400BB.quest_desc: [
		"Освети путь насквозь.",
		"Как: железный слиток плюс кремень."
	]
	quest.42000000000400BB.title: "Огниво"
	quest.42000000000400BC.quest_desc: [
		"Десять блоков. Дверь, которую Кромкоходы узнали бы.",
		"Как: вода на источник лавы (или лава на воду). Сохрани источник лавы."
	]
	quest.42000000000400BC.title: "Рама из обсидиана"
	quest.42000000000400BD.quest_desc: [
		"Подготовка опоры. Где-то ещё существует.",
		"Как: жемчуг Эндера (лавка Кромкоходов / эндермены) плюс огненный порошок из крепости Незера после обсидиана Когтя. Запас из восьми глаз необязателен; кристаллы Энда используют тот же крафт."
	]
	quest.42000000000400BD.title: "Око Эндера"
	quest.42000000000400BE.quest_desc: [
		"Мягкая сила для твёрдых инструментов.",
		"Как: два алмаза, четыре обсидиана, книга. Алмазы из щебня на железной сетке."
	]
	quest.42000000000400BE.title: "Стол зачарований"
	quest.42000000000400BF.quest_desc: [
		"Чини и называй то, что несёшь.",
		"Как: три железных блока над четырьмя слитками."
	]
	quest.42000000000400BF.title: "Наковальня"
	quest.42000000000400C0.quest_desc: [
		"Назови своим.",
		"Как: рыбалка / редкие сундуки, или лавка Резчиков печатей в /clowder hub (24 Нить). Необязательно."
	]
	quest.42000000000400C0.title: "Бирка"
	quest.42000000000400C1.quest_desc: [
		"Стартовый шаблон модульной мотыги, собранной по частям.",
		"Как: разверни Свёрток чертежей, или JEI."
	]
	quest.42000000000400C1.title: "Чертеж мотыги"
	quest.42000000000400C2.quest_desc: [
		"Сносит широкую полосу посевов за один взмах, а не одно растение.",
		"Как: разверни Свёрток чертежей, или JEI."
	]
	quest.42000000000400C2.title: "Чертеж серпа"
	quest.42000000000400C3.quest_desc: [
		"Один инструмент: добывает, рубит и копает. Больше не меняешь в руке.",
		"Как: разверни Свёрток чертежей, или JEI."
	]
	quest.42000000000400C3.title: "Чертеж Paxel"
	quest.42000000000400C4.quest_desc: [
		"Ломает камень три на три одним ударом.",
		"Как: разверни Свёрток чертежей, или JEI."
	]
	quest.42000000000400C4.title: "Чертеж молота"
	quest.42000000000400C5.quest_desc: [
		"Роет широкие ямы в земле и песке быстрее любой лопаты.",
		"Как: разверни Свёрток чертежей, или JEI."
	]
	quest.42000000000400C5.title: "Чертеж экскаватора"
	quest.42000000000400C6.quest_desc: [
		"Маленький, быстрый и точный. Сделан для близкой работы, не для войны.",
		"Как: разверни Свёрток чертежей, или JEI."
	]
	quest.42000000000400C6.title: "Чертеж ножа"
	quest.42000000000400C7.quest_desc: [
		"Мягкая обшивка, легко зачаровывается, ценнее магией, чем защитой.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000400C7.title: "Части золотой брони"
	quest.42000000000400C8.quest_desc: [
		"Морской коготь.",
		"Необязательно — пустота может так и не предложить его.",
		"Как: только утопленники. Необязательно."
	]
	quest.42000000000400C8.title: "Трезубец"
	quest.42000000000400C9.quest_desc: [
		"Заряжается медленно, бьёт сильно и держит заряд, пока он не понадобится.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000400C9.title: "Арбалет"
	quest.42000000000400CA.quest_desc: [
		"Осмотри пустоту.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000400CA.title: "Подзорная труба"
	quest.42000000000400CB.quest_desc: [
		"Чертежи, железо на спине, дверь наружу.",
		"Натяни Прядь: Кромкоходы отвечают. Коса открывается.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.42000000000400CB.quest_subtitle: "Кромка"
	quest.42000000000400CB.title: "Узел Когтя"
	quest.42000000000400CC.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.42000000000400CC.title: "Усади Коготь"
	quest.42000000000400CD.quest_desc: [
		"Что-то высокое посмотрело в ответ. Кромкоходы звали их стражами дверей.",
		"Как: убей эндермена. Жемчуг Эндера также бывает в лавке Кромкоходов."
	]
	quest.42000000000400CD.title: "Кромка Кромки"
	quest.42000000000500CE.quest_desc: [
		"Короткий сигнал перед Гулом. Шестьдесят четыре пыли.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: просей гравий или редстоуновую руду в Эходробилке после Возврата."
	]
	quest.42000000000500CE.title: "Пыль редстоуна"
	quest.42000000000500CF.quest_desc: [
		"Параллельное тепло. Восемь — это ряд, не печь.",
		"Как: восемь булыжников вокруг пустого центра."
	]
	quest.42000000000500CF.title: "Ряд печей"
	quest.42000000000500D0.quest_desc: [
		"Двигай крошку без рук.",
		"Как: пять железа вокруг сундука. Поставь её под Раму ткацкого стана или Бочку натяжения (извлекает ВНИЗ)."
	]
	quest.42000000000500D0.title: "Линия воронок"
	quest.42000000000500D1.quest_desc: [
		"Замерь удар.",
		"Как: незер-кварц, редстоун-факел, камень. Кварц сеется из песка душ; поход в Незер не нужен."
	]
	quest.42000000000500D1.title: "Компаратор"
	quest.42000000000500D2.quest_desc: [
		"Кость, бечёвка, аметист. Первый удар.",
		"Даёт два — один оставь для Кодекса духов.",
		"Как: одна кость, бечёвка, аметист. /clowder hub Хранители площадки продают кости. Врата Искра / Гул."
	]
	quest.42000000000500D2.title: "Гул: Костяной перезвон"
	quest.42000000000500D3.quest_desc: [
		"Осколок старой песни племени. Нужен перезвон.",
		"Как: Костяной перезвон, аметист и редстоун, без формы. Даёт два."
	]
	quest.42000000000500D3.title: "Гул: Осколок духа"
	quest.42000000000500D4.quest_desc: [
		"Медь вокруг перезвона: металл, настроенный на дух.",
		"Как: медь вокруг Костяного перезвона. Даёт два."
	]
	quest.42000000000500D4.title: "Гул: Медный резонатор"
	quest.42000000000500D5.quest_desc: [
		"Ударь. Держи Пульс. Слушай, прежде чем что-либо проводить.",
		"Два перезвона, один осколок, две кожи, четыре доски — Хранители площадки у /clowder hub продают кожу.",
		"Как: два Костяных перезвона, один Осколок духа, две кожи и четыре доски. Бей с пустыми руками в такт (17–23 тиков) ради 24 Пульса."
	]
	quest.42000000000500D5.title: "Гул: Барабанное сердце"
	quest.42000000000500D6.quest_desc: [
		"Носи Пульс для инструментов, чар и пути — нужны Резонатор + Осколок.",
		"Как: скрафти, затем заполни от Барабанного сердца (клик ячейкой). Инструменты, чары и путь берут из ячейки."
	]
	quest.42000000000500D6.title: "Гул: Ячейка Пульса"
	quest.42000000000500D7.quest_desc: [
		"Тяни окружающую лей в удары под открытым небом. Голоса тотемов добавляют; Барабанное сердце не нужно.",
		"Как: поставь под небом, рядом с водой/зеленью. Медленный Пульс. Лестница Искры."
	]
	quest.42000000000500D7.title: "Гул: Сборщик лей"
	quest.42000000000500D8.quest_desc: [
		"Установи катализатор эха (он изнашивается в работе) и два разных стихийных тотема. Лагерь поёт свою силу; редстоун ставит гармонию на паузу.",
		"Как: установи катализатор эха и два разных тотема в пределах 8. Редстоун его ставит на паузу."
	]
	quest.42000000000500D8.title: "Гул: Резонатор Пульса"
	quest.42000000000500D9.quest_desc: [
		"Буфер для энергии Forge — мост от Пульса к проводу, если хочешь.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500D9.title: "Стартовая ячейка Powah"
	quest.42000000000500DA.quest_desc: [
		"Жги топливо ради энергии Forge.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500DA.title: "Сжигатель Powah"
	quest.42000000000500DB.quest_desc: [
		"Веди энергию дальше.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500DB.title: "Кабель Powah"
	quest.42000000000500DC.quest_desc: [
		"Сила неба, на площадке, которая вся из неба.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500DC.title: "Стартовая солнечная панель"
	quest.42000000000500DD.quest_desc: [
		"Сжигает разницу тепла в силу. Корми его жаром с одной стороны, холодом с другой.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500DD.title: "Термогенератор"
	quest.42000000000500DE.quest_desc: [
		"Заряжает предметы в кольце стержней.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500DE.title: "Зарядная сфера"
	quest.42000000000500DF.quest_desc: [
		"Корми сферу.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500DF.title: "Стержень зарядки"
	quest.42000000000500E0.quest_desc: [
		"Пригоршня запасённой силы.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500E0.title: "Батарея"
	quest.42000000000500E1.quest_desc: [
		"Поворачивает машины на месте, вместо того чтобы ломать и ставить заново.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000500E1.title: "Гаечный ключ"
	quest.42000000000500E2.quest_desc: [
		"Плавит руду вдвое быстрее обычной печи, только руду.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500E2.title: "Плавильная печь"
	quest.42000000000500E3.quest_desc: [
		"Готовит мясо вдвое быстрее костра, только еду.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500E3.title: "Коптильня"
	quest.42000000000500E4.quest_desc: [
		"Девять угля, плотно спрессованных. Один блок держится дольше целого стака кусков.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500E4.title: "Угольный блок (Искра)"
	quest.42000000000500E5.quest_desc: [
		"Подталкивает по одному предмету в то, что стоит перед ним.",
		"Как: булыжник вокруг редстоуна."
	]
	quest.42000000000500E5.title: "Выбрасыватель"
	quest.42000000000500E6.quest_desc: [
		"Толкай с умыслом.",
		"Как: булыжник, лук и редстоун."
	]
	quest.42000000000500E6.title: "Раздатчик"
	quest.42000000000500E7.quest_desc: [
		"Толкает блок вперёд по сигналу, потом ждёт следующего.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500E7.title: "Поршень"
	quest.42000000000500E8.quest_desc: [
		"Выталкивает блок и тянет его назад, когда сигнал пропадает.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500E8.title: "Липкий поршень"
	quest.42000000000500E9.quest_desc: [
		"Наблюдатель читает ритм.",
		"Как: булыжник, редстоун и незерский кварц."
	]
	quest.42000000000500E9.title: "Наблюдатель"
	quest.42000000000500EA.quest_desc: [
		"Повторитель задаёт такт схеме.",
		"Как: редстоуновый факел, редстоун, камень. Глава про трубы берёт его для часов."
	]
	quest.42000000000500EA.title: "Повторитель"
	quest.42000000000500EB.quest_desc: [
		"Фиксирует попадание с силой сигнала по близости к центру.",
		"Как: редстоун вокруг сена. Сено — это три пшеницы."
	]
	quest.42000000000500EB.title: "Мишень"
	quest.42000000000500EC.quest_desc: [
		"Уводит удар от твоей крыши и заземляет заряд.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500EC.title: "Громоотвод"
	quest.42000000000500ED.quest_desc: [
		"Время для энергии.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500ED.title: "Часы"
	quest.42000000000500EE.quest_desc: [
		"Свет без факелов.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500EE.title: "Медная лампа"
	quest.42000000000500EF.quest_desc: [
		"Загорается от сигнала и гаснет в тот миг, когда он пропадает.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500EF.title: "Редстоуновый фонарь"
	quest.42000000000500F0.quest_desc: [
		"Читает небо и шлёт сигнал, который растёт и падает вместе с солнцем.",
		"Как: стекло, незерский кварц, деревянные плиты."
	]
	quest.42000000000500F0.title: "Датчик дневного света"
	quest.42000000000500F1.quest_desc: [
		"Включает и выключает сигнал вручную. Самый старый переключатель, какой есть.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F1.title: "Рычаг"
	quest.42000000000500F2.quest_desc: [
		"Кнопка даёт импульс редстоуна.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F2.title: "Кнопка"
	quest.42000000000500F3.quest_desc: [
		"Шлёт сигнал, когда на нём стоит что-то тяжелее воздуха.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F3.title: "Нажимная плита"
	quest.42000000000500F4.quest_desc: [
		"Натянутая бечёвкой поперёк тропы, ловит всё, что её пересекает.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F4.title: "Крюк"
	quest.42000000000500F5.quest_desc: [
		"Играет одну ноту на каждый тип блока под собой. Барабанные сердца слышат песню в их ряду.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F5.title: "Нотный блок"
	quest.42000000000500F6.quest_desc: [
		"Проигрыватель для настроения площадки.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F6.title: "Проигрыватель"
	quest.42000000000500F7.quest_desc: [
		"Катится от тяжести или толчка. Нет рельсов — нет езды.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F7.title: "Вагонетка"
	quest.42000000000500F8.quest_desc: [
		"Рельсы через пролёт пустоты.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F8.title: "Рельсы"
	quest.42000000000500F9.quest_desc: [
		"Энергорельсы для вагонеток.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500F9.title: "Энергорельсы"
	quest.42000000000500FA.quest_desc: [
		"Читает проезжающую вагонетку и даёт сигнал, когда она прокатывается.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000500FA.title: "Рельсы с датчиком"
	quest.42000000000500FB.quest_desc: [
		"Запасная солнечная сборка.",
		"Как: три стекла, три лазурита и три Зеркала, по ряду каждого."
	]
	quest.42000000000500FB.title: "Ячейка Solar Flux"
	quest.42000000000500FC.quest_desc: [
		"Простые трубы для предметов.",
		"Как: железо + редстоун. Направь грани гаечным ключом Pipez."
	]
	quest.42000000000500FC.title: "Предметы Pipez"
	quest.42000000000500FD.quest_desc: [
		"Простые трубы для жидкостей.",
		"Как: железо + вёдра + редстоун. Использование присев гаечным ключом по стороне, чтобы извлекать; ПКМ по этой стороне для фильтров."
	]
	quest.42000000000500FD.title: "Жидкости Pipez"
	quest.42000000000500FE.quest_desc: [
		"Обычные энергетические трубы между машинами.",
		"Как: железо + редстоун. Несёт FE между машинами."
	]
	quest.42000000000500FE.title: "Энергия Pipez"
	quest.42000000000500FF.quest_desc: [
		"Задаёт, какие стороны трубы извлекают из машины, или отключает сторону, не ломая трубу.",
		"Как: два кремня и две палки. Использование присев по стороне трубы у машины, чтобы извлекала, ещё раз — чтобы отключить; ПКМ по извлекающей стороне для фильтров."
	]
	quest.42000000000500FF.title: "Гаечный ключ Pipez"
	quest.4200000000050100.quest_desc: [
		"Метит линии решётки — нужен Осколок духа.",
		"Как: две костные муки, лазурит и Осколок духа, бесформенно. Даёт четыре."
	]
	quest.4200000000050100.title: "Ритуальный мел"
	quest.4200000000050101.quest_desc: [
		"Барабан ударен, Пульс удержан, резонатор усажен.",
		"Натяни Прядь: Барабанные сердца отвечают.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.4200000000050101.quest_subtitle: "Гул"
	quest.4200000000050101.title: "Узел Искры"
	quest.4200000000050102.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.4200000000050102.title: "Усади Искру"
	quest.4200000000050103.quest_desc: [
		"Иди по Племенному ткачеству через очистку эха к Резонансному ядру. Гармонический энергизатор превращает гармонию лагеря в FE для машин этой главы. Преобразование без ранга — 60 Пульса в секунду; повысь ранг на станциях эха, чтобы было больше. Он не может принимать FE. Редстоун ставит на паузу и преобразование, и выдачу.",
		"Как: пять медных слитков, три редстоуна и одно Резонансное ядро."
	]
	quest.4200000000050103.title: "Гул становится током"
	quest.4200000000050104.quest_desc: [
		"Ведьма, на твоей площадке, ночью. Барабаны тебя не предупредили.",
		"Как: убей ведьму на площадке ночью."
	]
	quest.4200000000050104.title: "Беда в бутылке"
	quest.4200000000060105.quest_desc: [
		"Руки, что работают, пока ты спишь. Тридцать два.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: андезит + железный самородок на верстаке (или в смесителе)."
	]
	quest.4200000000060105.title: "Андезитовый сплав"
	quest.4200000000060106.quest_desc: [
		"Хребет вращения.",
		"Как: андезитовый сплав в рецепте резки / крафте, указанном в JEI."
	]
	quest.4200000000060106.title: "Вал"
	quest.4200000000060107.quest_desc: [
		"Одна шестерня. Потом та же шестерня ещё раз.",
		"Как: вал + доски."
	]
	quest.4200000000060107.title: "Шестерня"
	quest.4200000000060108.quest_desc: [
		"Больше зубьев, медленнее оборот.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060108.title: "Большая шестерня"
	quest.4200000000060109.quest_desc: [
		"Андезитовый кожух — каркас Create.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060109.title: "Андезитовый корпус"
	quest.420000000006010A.quest_desc: [
		"Река в небе, крутится.",
		"Как: восемь досок вокруг вала. Рядом нужен поток воды."
	]
	quest.420000000006010A.title: "Водяное колесо"
	quest.420000000006010B.quest_desc: [
		"Даёт вращение от руки, когда больше ничего ещё не крутится.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006010B.title: "Рукоятка"
	quest.420000000006010C.quest_desc: [
		"Смели щебень в пыль, без молота.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006010C.title: "Жёрнов"
	quest.420000000006010D.quest_desc: [
		"Чаша держит смешивание Create.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006010D.title: "Чаша"
	quest.420000000006010E.quest_desc: [
		"Пластины и дорожки.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006010E.title: "Механический пресс"
	quest.420000000006010F.quest_desc: [
		"Рецепты пачками, быстро.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006010F.title: "Механический смешиватель"
	quest.4200000000060110.quest_desc: [
		"Плоская поверхность, что держит предмет неподвижно для ремня или пресса.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060110.title: "Депо"
	quest.4200000000060111.quest_desc: [
		"Ремни везут предметы вдоль валов.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060111.title: "Соединитель ремня"
	quest.4200000000060112.quest_desc: [
		"Роняет предметы прямо вниз между машинами, ремень не нужен.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060112.title: "Жёлоб"
	quest.4200000000060113.quest_desc: [
		"Промывка, сушка и гравий в песок.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060113.title: "Вентилятор в корпусе"
	quest.4200000000060114.quest_desc: [
		"Рука на валу.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060114.title: "Автономный активатор"
	quest.4200000000060115.quest_desc: [
		"Режет брёвна в доски или деревья в лесоматериал, если вращения хватает.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060115.title: "Механическая пила"
	quest.4200000000060116.quest_desc: [
		"Бури сквозь блоки щебня.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060116.title: "Механический бур"
	quest.4200000000060117.quest_desc: [
		"Срежь посевы по крутящейся дуге.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060117.title: "Механический комбайн"
	quest.4200000000060118.quest_desc: [
		"Грузит или выгружает груз остановившегося поезда, и тебе не нужно поднимать ни один сундук.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060118.title: "Портативный складской интерфейс"
	quest.4200000000060119.quest_desc: [
		"Складывает объём девяти сундуков в один большой блок.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060119.title: "Хранилище предметов"
	quest.420000000006011A.quest_desc: [
		"Держит жидкость оптом и соединяется с соседями, чтобы держать больше.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006011A.title: "Жидкостный бак"
	quest.420000000006011B.quest_desc: [
		"Лей жидкости в чаши.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006011B.title: "Дозатор"
	quest.420000000006011C.quest_desc: [
		"Качай жидкости из источника.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006011C.title: "Шланговая катушка"
	quest.420000000006011D.quest_desc: [
		"Отмечает сторону постройки для жидкостей, нарядный родич андезита.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006011D.title: "Медный корпус"
	quest.420000000006011E.quest_desc: [
		"Покрывает точные машины, те, что одно вращение удовлетворить не может.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006011E.title: "Латунный корпус"
	quest.420000000006011F.quest_desc: [
		"Часовое сердце. Хочет Связующий узел в своём центре.",
		"Ткацкий стан, просящий, чтобы его включили.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006011F.title: "Механизм точности"
	quest.4200000000060120.quest_desc: [
		"Управляй скоростью вращения.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060120.title: "Регулятор скорости вращения"
	quest.4200000000060121.quest_desc: [
		"Поверни за угол.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060121.title: "Угловая передача"
	quest.4200000000060122.quest_desc: [
		"Муфта останавливает линию валов.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060122.title: "Сцепление"
	quest.4200000000060123.quest_desc: [
		"Переключатель передач переворачивает вращение.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060123.title: "Реверсивная передача"
	quest.4200000000060124.quest_desc: [
		"Запрограммированное вращение. Песня Ткачей узоров, записанная.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060124.title: "Последовательная коробка передач"
	quest.4200000000060125.quest_desc: [
		"Мешает ингредиенты в чаше, когда крутится достаточно быстро.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060125.title: "Венчик"
	quest.4200000000060126.quest_desc: [
		"Крутится на валу и толкает воздух или лодку, смотря куда ты его поставишь.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060126.title: "Пропеллер"
	quest.4200000000060127.quest_desc: [
		"Ловит ветер на мельнице и легко красится, если хочешь узор.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060127.title: "Белый парус"
	quest.4200000000060128.quest_desc: [
		"Превращает кольцо парусов во вращение, снятое прямо с неба.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060128.title: "Подшипник ветряной мельницы"
	quest.4200000000060129.quest_desc: [
		"Крутит целое строение вокруг неподвижной точки, со стенами и всем прочим.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060129.title: "Механический вращатель"
	quest.420000000006012A.quest_desc: [
		"Портал скользит вдоль рельса.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006012A.title: "Каретка линейного привода"
	quest.420000000006012B.quest_desc: [
		"Превращает неподвижную постройку в ту, что едет по рельсам.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006012B.title: "Вагонеточный сборщик"
	quest.420000000006012C.quest_desc: [
		"Сцепляет две вагонетки, чтобы они шли одним поездом.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006012C.title: "Вагонеточная сцепка"
	quest.420000000006012D.quest_desc: [
		"Прокладывает путь, по которому едет вагонетка или конструкция.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006012D.title: "Рельсы"
	quest.420000000006012E.quest_desc: [
		"Дверь поезда для вагонов.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006012E.title: "Дверь поезда"
	quest.420000000006012F.quest_desc: [
		"Составляй маршруты поезда.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.420000000006012F.title: "Расписание"
	quest.4200000000060130.quest_desc: [
		"Показывает число откуда-то ещё на блоке, который ты реально видишь.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060130.title: "Передатчик информации"
	quest.4200000000060131.quest_desc: [
		"Табло показывает данные.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060131.title: "Механическое табло"
	quest.4200000000060132.quest_desc: [
		"Стреляет картофелиной достаточно сильно, чтобы отбросить что-нибудь. В основном ради смеха.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060132.title: "Картофельная пушка"
	quest.4200000000060133.quest_desc: [
		"Достаёт и ломает блоки дальше, чем достаёт рука.",
		"Как: крафт Create в JEI (верстак, пресс, смеситель или установщик). Андезитовый сплав и водяное колесо начинают линию."
	]
	quest.4200000000060133.title: "Длиннохват"
	quest.4200000000060134.quest_desc: [
		"Колесо, пресс, смеситель, вентилятор, часовое сердце.",
		"Натяни Прядь: ответ Ткачей узоров.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.4200000000060134.quest_subtitle: "Узор"
	quest.4200000000060134.title: "Узел Часов"
	quest.4200000000060135.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Редкая награда: одна общая жизнь Clowder, один раз на всю команду. Таких наград в кампании только шесть.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.4200000000060135.title: "Посади Часы"
	quest.4200000000060136.quest_desc: [
		"Двадцать скелетов. Узор держится, если не гасить свет.",
		"Как: убей двадцать скелетов. Держи площадку освещённой."
	]
	quest.4200000000060136.title: "Стук в шестернях"
	quest.4200000000070137.quest_desc: [
		"Поставь дубовое гнездо на площадку и нажми по нему ПКМ маленьким цветком. Жди. Из дерева выйдет что-то с крыльями.",
		"Посмотри на неё. Это засчитывается.",
		"Как: ПКМ по дубовому гнезду маленьким цветком, затем посмотри на первую пчелу, которая вылетит."
	]
	quest.4200000000070137.quest_subtitle: "Колония"
	quest.4200000000070137.title: "Первые крылья"
	quest.4200000000070138.quest_desc: [
		"Восемь дубовых брёвен вокруг маленького цветка. Поставь его и разбуди другим цветком; дерево помнит крылья.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.4200000000070138.title: "Дубовое кольцо"
	quest.4200000000070139.quest_desc: [
		"Костная мука на траву. Пчёлы не остаются там, где ничего не цветёт.",
		"Как: костная мука на траву. Пчёлам нужен любой маленький цветок."
	]
	quest.4200000000070139.title: "Цветок, за который спорят"
	quest.420000000007013A.quest_desc: [
		"Доски и цветы — дом, в который переедет дикая пчела.",
		"Как: три маленьких цветка между двумя рядами досок. Рой называет гнездо."
	]
	quest.420000000007013A.title: "Пчелиное гнездо"
	quest.420000000007013B.quest_desc: [
		"Колонии на ветру. Лавка Хранителей колонии в /clowder hub продаёт соты, если ни одни не пролетят мимо.",
		"Как: постриги гнездо или улей, когда пчёлы поработают на цветке. Лавка Хранителей колонии в /clowder hub продаёт восемь за 16 Нить."
	]
	quest.420000000007013B.title: "Пчелиные соты"
	quest.420000000007013C.quest_desc: [
		"Дом для работниц.",
		"Как: три соты и шесть досок. Костёр снизу их успокаивает."
	]
	quest.420000000007013C.title: "Улей"
	quest.420000000007013D.quest_desc: [
		"Сладкая, липкая и печи нужнее, чем твоему желудку.",
		"Как: стеклянная бутылочка на полный улей. Костёр снизу."
	]
	quest.420000000007013D.title: "Бутылочка мёда (Рой)"
	quest.420000000007013E.quest_desc: [
		"Закуска, которая успокаивает взбудораженную пчелу, прежде чем ты полезешь в улей.",
		"Как: соты плюс бутылочка мёда, без формы."
	]
	quest.420000000007013E.title: "Медовое угощение"
	quest.420000000007013F.quest_desc: [
		"Гравий вокруг цветка. Пчёлы-шахтёры и копатели любят пыль.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.420000000007013F.title: "Кольцо щебня"
	quest.4200000000070140.quest_desc: [
		"Каменистая земля вокруг цветка. Листорезы и пепельные шахтёры.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.4200000000070140.title: "Кольцо каменистой земли"
	quest.4200000000070141.quest_desc: [
		"Камень вокруг цветка. Пчёлы-каменщицы, и копатели, что едят камень.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.4200000000070141.title: "Кольцо камня"
	quest.4200000000070142.quest_desc: [
		"Продуктивный дом.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.4200000000070142.title: "Продвинутый улей"
	quest.4200000000070143.quest_desc: [
		"Даёт улью больше места, прежде чем он роится в поисках нового.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.4200000000070143.title: "Ящик расширения"
	quest.4200000000070144.quest_desc: [
		"Разливает добычу без твоей руки.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.4200000000070144.title: "Разливочная машина"
	quest.4200000000070145.quest_desc: [
		"Крути соты во всё, что они прячут.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.4200000000070145.title: "Центрифуга"
	quest.4200000000070146.quest_desc: [
		"То же самое, быстрее, на энергии.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.4200000000070146.title: "Механизированная центрифуга"
	quest.4200000000070147.quest_desc: [
		"Вылавливает пчелу из воздуха сетью, без единого ужаления.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.4200000000070147.title: "Ловец"
	quest.4200000000070148.quest_desc: [
		"Носи пчелу, как фонарь.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.4200000000070148.title: "Пчелиная клетка"
	quest.4200000000070149.quest_desc: [
		"Выведи гены, какие хочешь.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.4200000000070149.title: "Инкубатор"
	quest.420000000007014A.quest_desc: [
		"Сведи две колонии нарочно.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.420000000007014A.title: "Камера разведения"
	quest.420000000007014B.quest_desc: [
		"Сортируй признаки, как семя.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.420000000007014B.title: "Индексер генов"
	quest.420000000007014C.quest_desc: [
		"Стопка лакомств: жалованье колонии.",
		"Как: соты плюс бутылочка мёда, без формы."
	]
	quest.420000000007014C.title: "Улучшение корма"
	quest.420000000007014D.quest_desc: [
		"Одна из более глубоких культур эссенции, выращенная далеко за основами.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000007014D.title: "Алмазные семена"
	quest.420000000007014E.quest_desc: [
		"Грядка, которая даёт пыль, вместо того чтобы её выкапывать.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000007014E.title: "Семена редстоуна"
	quest.420000000007014F.quest_desc: [
		"Растит синюю эссенцию, которой столы зачарований всегда голодны.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000007014F.title: "Семена лазурита"
	quest.4200000000070150.quest_desc: [
		"Кварц, выращенный на грядке, а не выкопанный в пещерах Незера.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000070150.title: "Семена незер-кварца"
	quest.4200000000070151.quest_desc: [
		"Более мягкий способ выращивать свет, чем добывать потолок Незера.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000070151.title: "Семена светокамня"
	quest.4200000000070152.quest_desc: [
		"Закалённая культура, что даёт эссенцию обсидиана, и ни одного ведра лавы в поле зрения.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000070152.title: "Семена обсидиана"
	quest.4200000000070153.quest_desc: [
		"Высокая эссенция. Поля теперь промышленность.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000070153.title: "Imperium"
	quest.4200000000070154.quest_desc: [
		"Последний уровень эссенции. Что бы ты ни строил, это хорошая версия.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"Излишек Роя, стопкой.",
		"Как: четыре бутылочки мёда. Бутылочки возвращаются."
	]
	quest.4200000000070155.title: "Блок мёда"
	quest.4200000000070156.quest_desc: [
		"Пчела, которой не было, пока ты не построил гнездо.",
		"Шахтёр, каменщица, копатель, плотник — посмотри на одну.",
		"Как: посмотри на Productive Bee после того, как гнездо проснётся. Первые крылья — это дубовое гнездо."
	]
	quest.4200000000070156.quest_subtitle: "Колония"
	quest.4200000000070156.title: "Гудит что-то новое"
	quest.4200000000070157.quest_desc: [
		"Песок вокруг цветка. Пепельные и шоколадные шахтёры.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.4200000000070157.title: "Кольцо песка"
	quest.4200000000070158.quest_desc: [
		"Сахарный тростник вокруг цветка. Тростниковые пчёлы и каменщицы.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.4200000000070158.title: "Кольцо тростника"
	quest.4200000000070159.quest_desc: [
		"Блоки слизи вокруг цветка. Угадай.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.4200000000070159.title: "Кольцо слизи"
	quest.420000000007015A.quest_desc: [
		"Сено вокруг цветка. Шмели, и обычные пчёлы тоже.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.420000000007015A.title: "Кольцо сена"
	quest.420000000007015B.quest_desc: [
		"Снег вокруг цветка. Пчёлы-потницы, как ни странно.",
		"Как: кольцо из материала гнезда вокруг маленького цветка. Поставь его, затем ПКМ маленьким цветком, чтобы разбудить; пчёлы вылетают через некоторое время."
	]
	quest.420000000007015B.title: "Кольцо снега"
	quest.420000000007015C.quest_desc: [
		"Сжигает мёд ради энергии. Улей на двух работах.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.420000000007015C.title: "Медовый генератор"
	quest.420000000007015D.quest_desc: [
		"Держит одну пчелу на виду, с крыльями и всем прочим, без пристроенного улья.",
		"Как: крафты Productive Bees смотри в JEI. Рой называет улей, центрифугу и шаги разведения."
	]
	quest.420000000007015D.title: "Банка"
	quest.420000000007015E.quest_desc: [
		"Успокаивает улей, полный пчёл, прежде чем ты полезешь за сотами.",
		"Как: брёвна, палки и уголь или древесный уголь."
	]
	quest.420000000007015E.title: "Костёр (Рой)"
	quest.420000000007015F.quest_desc: [
		"Кормит пчёл и цветёт дважды в год, а остальное время вечнозелёная.",
		"Как: мох плюс дуб, или костная мука на мох. Пчёлы принимают цветок."
	]
	quest.420000000007015F.title: "Цветущая азалия (Рой)"
	quest.4200000000070160.quest_desc: [
		"Высокий, жёлтый и всегда лицом к солнцу. Пчёлы легко его находят.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000070160.title: "Подсолнух"
	quest.4200000000070161.quest_desc: [
		"Два блока лилового цветения, ради которых пчёлы пересекут площадку.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000070161.title: "Сирень"
	quest.4200000000070162.quest_desc: [
		"Высокий цветок, который пчёлы любят, и ещё один цвет для сада.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000070162.title: "Розовый куст"
	quest.4200000000070163.quest_desc: [
		"Розовый и пышный, сажается там, где улью рядом нужно больше корма.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000070163.title: "Пион"
	quest.4200000000070164.quest_desc: [
		"Низкий одиночный цветок, но пчёлам всё равно на рост.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000070164.title: "Оранжевый тюльпан"
	quest.4200000000070165.quest_desc: [
		"Гнездо, которое ты построил, улей, который ты перенёс, центрифуга, инкубатор, поля эссенции.",
		"Дай Пряди натяжение: отвечают Хранители колонии.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.4200000000070165.quest_subtitle: "Колония"
	quest.4200000000070165.title: "Узел Роя"
	quest.4200000000070166.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.4200000000070166.title: "Посади Рой"
	quest.4200000000070167.quest_desc: [
		"Ты убил пчелу.",
		"Хранители колонии хотят поговорить. Вот бутылочка; подумай об этом.",
		"Как: убей пчелу (скрыто). Бутылочка — это урок."
	]
	quest.4200000000070167.title: "Сожаление"
	quest.4200000000080168.quest_desc: [
		"Хранители оставили фокусы в кристалле. Тридцать два осколка.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: сито, или цветущий аметист, если растишь линию жеод. Occultism хочет осколки."
	]
	quest.4200000000080168.title: "Аметист"
	quest.4200000000080169.quest_desc: [
		"ПКМ по Столбу натяжения, держа 16 Волокон Пряди. Ни одну Прядь сажать не нужно.",
		"Связать начинается здесь.",
		"Как: ПКМ по Столбу натяжения, держа 16 Волокон Пряди. Просей гравий или песок железной сеткой Нити, чтобы их найти."
	]
	quest.4200000000080169.title: "Шнур косы"
	quest.420000000008016A.quest_desc: [
		"Запиши обряд, прежде чем вырезать его.",
		"Как: книга, чернильный мешок, перо. Древесный уголь плюс стеклянная бутылочка дают чернила."
	]
	quest.420000000008016A.title: "Книга и перо"
	quest.420000000008016B.quest_desc: [
		"Мягкая сила для твёрдых инструментов.",
		"Как: два алмаза, четыре обсидиана, книга. Алмазы из щебня на железной сетке."
	]
	quest.420000000008016B.title: "Стол зачарований (Печать)"
	quest.420000000008016C.quest_desc: [
		"Заправь стол.",
		"Как: девять лазуритов. Просей гравий или лазуритовую руду в Эходробилке."
	]
	quest.420000000008016C.title: "Лазуритовый блок"
	quest.420000000008016D.quest_desc: [
		"Окружает стол зачарований, чтобы открыть его сильнейшие чары.",
		"Как: шесть досок и три книги. Книги — это бумага плюс кожа."
	]
	quest.420000000008016D.title: "Книжная полка"
	quest.420000000008016E.quest_desc: [
		"Глубоко лечит и даёт сияние, которое гаснет через минуту.",
		"Как: восемь золота вокруг яблока. Не зачарованное."
	]
	quest.420000000008016E.title: "Золотое яблоко"
	quest.420000000008016F.quest_desc: [
		"Минуй падение.",
		"Как: эндермены, или лавка Кромкоходов в /clowder hub."
	]
	quest.420000000008016F.title: "Жемчуг Эндера"
	quest.4200000000080170.quest_desc: [
		"Превращает пузырьки с водой в нечто с настоящим эффектом.",
		"Как: огненный стержень над тремя булыжниками. Стержень — из крепости Незера, после обсидиана Когтя."
	]
	quest.4200000000080170.title: "Варочная стойка"
	quest.4200000000080171.quest_desc: [
		"Жар для зелий.",
		"Как: скрафти из огненного стержня или возьми в крепости после обсидиана Когтя."
	]
	quest.4200000000080171.title: "Огненный порошок"
	quest.4200000000080172.quest_desc: [
		"Питает варочную стойку и доказывает, что ты уже схватился с Незером.",
		"Как: крепость Незера после обсидиана Когтя. Зельям нужен стержень; Ars и Occultism его не ждут."
	]
	quest.4200000000080172.title: "Огненный стержень"
	quest.4200000000080173.quest_desc: [
		"Нарочно скручивает эффект зелья во что-то хуже.",
		"Как: паучий глаз, коричневый гриб, сахар."
	]
	quest.4200000000080173.title: "Маринованный глаз"
	quest.4200000000080174.quest_desc: [
		"Светопыль для рецептов.",
		"Как: просей песок душ или ведьм на площадке."
	]
	quest.4200000000080174.title: "Светопыль (Печать)"
	quest.4200000000080175.quest_desc: [
		"Дыхание того, что стережёт Энд.",
		"Как: стеклянный пузырёк на дракона. Острова Энда больше нет. Необязательно."
	]
	quest.4200000000080175.title: "Драконье дыхание"
	quest.4200000000080176.quest_desc: [
		"Ещё один шанс.",
		"Необязательно — рейды не доходят до площадки, и сборка его не создаёт.",
		"Как: только награды заданий. Посади Часы и Посади Печать дают по одному, а подарки поздних Узлов Пряди дают ещё. Рейды и заклинатели никогда не приходят на площадку. Необязательно."
	]
	quest.4200000000080176.title: "Тотем"
	quest.4200000000080177.quest_desc: [
		"Хранит Источник, топливо, которое сжигают заклинания.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.4200000000080177.title: "Исходный самоцвет"
	quest.4200000000080178.quest_desc: [
		"Выращено, не найдено. Древесина для инструментов заклинания и пьедесталов чар.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.4200000000080178.title: "Арканное древо"
	quest.4200000000080179.quest_desc: [
		"Первые заклинания. Магия наравне, если хочешь её рядом с обрядами.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.4200000000080179.title: "Книга заклинаний Посвящённого"
	quest.420000000008017A.quest_desc: [
		"Арканная культура, выращенная ради ткани не меньше, чем ради магии.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008017A.title: "Чароцвет"
	quest.420000000008017B.quest_desc: [
		"Жаровня для ритуальной работы.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008017B.title: "Ритуальная жаровня"
	quest.420000000008017C.quest_desc: [
		"Показывает реагент и подаёт его в ритуал, которому он нужен.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008017C.title: "Аркановый пьедестал"
	quest.420000000008017D.quest_desc: [
		"Записывай заклинания и страницы.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008017D.title: "Стол писцов"
	quest.420000000008017E.quest_desc: [
		"Напитай реагенты источником.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008017E.title: "Камера Впитывания"
	quest.420000000008017F.quest_desc: [
		"Хранит запас Источника, чтобы заклинание не иссякло на полуслове.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008017F.title: "Кувшин с Истоком"
	quest.4200000000080180.quest_desc: [
		"Зови духов по именам.",
		"Как: книга и Семена демонического сна, бесформенно. Прочитай; дальше Духовный огонь."
	]
	quest.4200000000080180.title: "Словарь Occultism"
	quest.4200000000080181.quest_desc: [
		"Холодное пламя для ритуалов, которые обычный огонь не закончит.",
		"Как: зажги Духовный огонь, как показывает Словарь духов (Горит!), затем брось в него андезит."
	]
	quest.4200000000080181.title: "Духовный огонь"
	quest.4200000000080182.quest_desc: [
		"Фокус для призыва. Обряды терпеливы.",
		"Как: золото вокруг жертвенной чаши. Словарь называет ритуал."
	]
	quest.4200000000080182.title: "Золотая жертвенная чаша"
	quest.4200000000080183.quest_desc: [
		"Сердце крафта на ауре, настроенное на землю вокруг.",
		"Как: Ритуал леса (JEI): три камня, Золотой лист, золотой слиток и Жетон радости. Линия Сердца ауры."
	]
	quest.4200000000080183.title: "Природный алтарь"
	quest.4200000000080184.quest_desc: [
		"Растение, пропитанное высокой аурой и спряденное во что-то более редкое.",
		"Как: четыре листа и четыре золотых самородка вокруг короткой травы дают четыре Блестящих волокна. Положи её в крону дерева; листья со временем станут золотыми."
	]
	quest.4200000000080184.title: "Блестящее волокно"
	quest.4200000000080185.quest_desc: [
		"Материал, тронутый аурой, ценнее, чем кажется, лёжа на земле.",
		"Как: сломай золотые листья, выросшие из Блестящего волокна."
	]
	quest.4200000000080185.title: "Золотой лист"
	quest.4200000000080186.quest_desc: [
		"Железо, впитавшее окружающую ауру, пока не стало дороже руды.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000080186.title: "Насыщенное железо"
	quest.4200000000080187.quest_desc: [
		"Даёт видеть уровень ауры земли вокруг тебя.",
		"Как: Золотой лист + паучий глаз. Показывает местную ауру."
	]
	quest.4200000000080187.title: "Глаз"
	quest.4200000000080188.quest_desc: [
		"Жетон радости. Природный алтарь и Травоядный поглотитель собираются на нём.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000080188.title: "Знак радости"
	quest.4200000000080189.quest_desc: [
		"Запас пергамента для заклинаний.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.4200000000080189.title: "Пергамент для заклинаний"
	quest.420000000008018A.quest_desc: [
		"Метит место, куда вернуться словом, а не шагом.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008018A.title: "Варп-свиток"
	quest.420000000008018B.quest_desc: [
		"Посади, ухаживай и собери ткань, пропитанную слабой магией.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008018B.title: "Посев магацвета"
	quest.420000000008018C.quest_desc: [
		"Пустая страница, на которую пишут заклинание.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.420000000008018C.title: "Пустой глиф"
	quest.420000000008018D.quest_desc: [
		"Творит боевые заклинания, ни разу не касаясь жезла.",
		"Как: три цепи, четыре кожи и две бумаги. Глава заклинаний называет чернила."
	]
	quest.420000000008018D.title: "Книга заклинаний Iron"
	quest.420000000008018E.quest_desc: [
		"Топливо, которое заклинатели сжигают, заклинание за заклинанием.",
		"Как: убивай заклинателей или крафти то, что указано в JEI. Топливо для чернил и книг."
	]
	quest.420000000008018E.title: "Эссенция волшебства"
	quest.420000000008018F.quest_desc: [
		"Вписывает заклинание в книгу, по одному уровню за раз.",
		"Как: бутылочка + эссенция + краситель. Первые чернила для надписи."
	]
	quest.420000000008018F.title: "Обычные чернила"
	quest.4200000000080190.quest_desc: [
		"Цвет для обрядов.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000080190.title: "Мистический цветок"
	quest.4200000000080191.quest_desc: [
		"Эхо глубинной тьмы.",
		"Необязательно — пустота может так и не предложить его.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000080191.title: "Осколок эха"
	quest.4200000000080192.quest_desc: [
		"Коса спрядена, зелья разлиты, заклинания и духи призваны.",
		"Дай натяжение Пряди: Резчики печатей отвечают.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.4200000000080192.quest_subtitle: "Связать"
	quest.4200000000080192.title: "Узел Печати"
	quest.4200000000080193.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Редкая награда: одна общая жизнь Clowder, один раз на всю команду. Таких наград в кампании только шесть.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.4200000000080193.title: "Посади Печать"
	quest.4200000000080194.quest_desc: [
		"Яблоко, которое хранители так и не съели. Тебе тоже, наверное, не стоит.",
		"Как: не крафт площадки. Необязательный секрет — он не закрывает путь к Узлу Печати."
	]
	quest.4200000000080194.title: "Старое золото"
	quest.4200000000090195.quest_desc: [
		"Железная сетка, щебень или песок, терпение.",
		"Волокно Пряди — собственная нить Ткацкого стана. Коса прядётся из него.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: нитяная сетка (железо) на щебне, песке или пыли (Рама ткацкого стана или сито)."
	]
	quest.4200000000090195.title: "Спряди Волокно"
	quest.4200000000090196.quest_desc: [
		"Шестнадцать Волокон, один ПКМ по Столбу натяжения.",
		"Связывание началось; переплести — отсюда.",
		"Как: ПКМ по Столбу натяжения, держа 16 Волокон Пряди. Просей гравий или песок железной сеткой Нити, чтобы их найти."
	]
	quest.4200000000090196.title: "Срасти косу"
	quest.4200000000090197.quest_desc: [
		"Кварц Certus — холодная нить цифрового ткацкого стана.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.4200000000090197.title: "Холодный уток"
	quest.4200000000090198.quest_desc: [
		"Молотый кварц, основа, из которой собран цифровой ткацкий стан.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.4200000000090198.title: "Пыль Certus"
	quest.4200000000090199.quest_desc: [
		"Блок-оболочка каждой машины сети, добытый из залежей Certus.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.4200000000090199.title: "Небесный камень"
	quest.420000000009019A.quest_desc: [
		"Fluix — certus, кварц и редстоун, заряженные в воде.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.420000000009019A.title: "Заряженная основа"
	quest.420000000009019B.quest_desc: [
		"Смесь кварца, редстоуна и стекла, мелко смолотая для крафта в сети.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.420000000009019B.title: "Флюисовая пыль"
	quest.420000000009019C.quest_desc: [
		"Кремний для процессоров AE2.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.420000000009019C.title: "Кремний"
	quest.420000000009019D.quest_desc: [
		"Начертатель вдавливает схемы так, как ткацкий стан вдавливает ткань.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.420000000009019D.title: "Вдави узор"
	quest.420000000009019E.quest_desc: [
		"Штампует кремниевую пластину так, как ткацкий стан вдавливает ткань.",
		"Как: железный блок, Связующий узел, железо и кварц. AE2 копирует только пресс, который у тебя уже есть."
	]
	quest.420000000009019E.title: "Кремниевый пресс для высекателя"
	quest.420000000009019F.quest_desc: [
		"Штампует матрицу логического процессора, по одному оттиску за раз.",
		"Как: железный блок, Связующий узел, железо и золото. Первая копия — крафт Узла."
	]
	quest.420000000009019F.title: "Логический пресс"
	quest.42000000000901A0.quest_desc: [
		"Штампует матрицу вычислительного процессора.",
		"Как: железный блок, Связующий узел, железо и certus (сито, песок). Первая копия — крафт Узла."
	]
	quest.42000000000901A0.title: "Вычислительный пресс"
	quest.42000000000901A1.quest_desc: [
		"Крафт инженерной матрицы.",
		"Как: железный блок, Связующий узел, железо и алмаз. Первая копия — крафт Узла."
	]
	quest.42000000000901A1.title: "Инженерный пресс"
	quest.42000000000901A2.quest_desc: [
		"Логический процессор для AE2.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901A2.title: "Логический процессор"
	quest.42000000000901A3.quest_desc: [
		"Деталь шаблонов автокрафта, из кремния и кварца certus.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901A3.title: "Вычислительный процессор"
	quest.42000000000901A4.quest_desc: [
		"Более плотный процессор, нужный для требовательных частей сети.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901A4.title: "Инженерный процессор"
	quest.42000000000901A5.quest_desc: [
		"Держит ячейки, в которых лежит всё, что помнит сеть.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901A5.title: "МЭ накопитель"
	quest.42000000000901A6.quest_desc: [
		"Оболочка, внутри которой собирают ячейку хранения.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901A6.title: "Корпус ячейки предметов"
	quest.42000000000901A7.quest_desc: [
		"Первый цифровой сундук.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901A7.title: "Ячейка предметов 1k"
	quest.42000000000901A8.quest_desc: [
		"Глянь на сеть.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901A8.title: "МЭ терминал"
	quest.42000000000901A9.quest_desc: [
		"Даёт крафтить прямо из того, что сеть уже хранит.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901A9.title: "Терминал крафта"
	quest.42000000000901AA.quest_desc: [
		"Контроллер. Хочет Связующий узел в своём центре.",
		"Ядро Веретена.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901AA.title: "Цифровой ткацкий стан"
	quest.42000000000901AB.quest_desc: [
		"Используй его с пустыми руками и сыграй Обряд врат: бей по падающим долям на A, S, D, F. Набери 60% — и он откроется; Пульс не нужен.",
		"Как: используй Барабан врат с пустыми руками и сыграй Обряд врат: бей по падающим долям на A, S, D, F. Набери 60% — и он откроется; Пульс не нужен. Сначала привяжи компас возврата."
	]
	quest.42000000000901AB.title: "Барабан врат"
	quest.42000000000901AC.quest_desc: [
		"Опора из-за врат. Принеси одну домой.",
		"Как: переплавь Булыжник Марки. Добывай его в Марке, через Барабан врат."
	]
	quest.42000000000901AC.title: "Камень Марша"
	quest.42000000000901AD.quest_desc: [
		"Несёт каналы сети от одной машины к следующей.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901AD.title: "Кабель Fluix"
	quest.42000000000901AE.quest_desc: [
		"Затягивай предметы в хранилище.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901AE.title: "Шина импорта"
	quest.42000000000901AF.quest_desc: [
		"Выталкивает предметы из сети в сундук или машину.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901AF.title: "Шина экспорта"
	quest.42000000000901B0.quest_desc: [
		"Читает внешний инвентарь в сеть, будто это ячейка.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B0.title: "Шина хранения"
	quest.42000000000901B1.quest_desc: [
		"Добавляет автокрафту сети запас для крупных заказов.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B1.title: "Блок создания"
	quest.42000000000901B2.quest_desc: [
		"Даёт больше заданий крафта идти сразу.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B2.title: "Блок обработки создания"
	quest.42000000000901B3.quest_desc: [
		"Хранит шаблоны, из которых сеть берёт, пока крафтит.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B3.title: "1К хранилище создания"
	quest.42000000000901B4.quest_desc: [
		"Подаёт шаблоны машинам, как ткацкий стан подаёт нить в челнок.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B4.title: "Поставщик шаблонов"
	quest.42000000000901B5.quest_desc: [
		"Собирает по шаблонам. Хочет Шнур косы в самом сердце.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B5.title: "Молекулярный сборщик"
	quest.42000000000901B6.quest_desc: [
		"Пустой шаблон, ждёт, пока в него запишут рецепт.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B6.title: "Пустой шаблон"
	quest.42000000000901B7.quest_desc: [
		"Подай энергию в цифровой ткацкий стан.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B7.title: "Приёмщик энергии"
	quest.42000000000901B8.quest_desc: [
		"Жги для AE — необязательная ветка энергии.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B8.title: "Резонирующая камера"
	quest.42000000000901B9.quest_desc: [
		"Ячейка хранения просторнее предыдущего размера.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901B9.title: "Ячейка предметов 4k"
	quest.42000000000901BA.quest_desc: [
		"Вмещает куда больше любого сундука, самая плотная ячейка, пока накопитель не заполнится.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901BA.title: "Ячейка предметов 16k"
	quest.42000000000901BB.quest_desc: [
		"Оболочка, внутри которой собирают ячейку жидкостей.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901BB.title: "Корпус жидкостной ячейки"
	quest.42000000000901BC.quest_desc: [
		"Цифровой бак: хранит жидкость, и сеть может взять её откуда угодно.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901BC.title: "Жидкостная ячейка 1k"
	quest.42000000000901BD.quest_desc: [
		"Ставит блоки из сети так, как ставила бы рука, хотя руки нет.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901BD.title: "Плоскость формирования"
	quest.42000000000901BE.quest_desc: [
		"Ломает блоки перед собой и подаёт их в сеть.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901BE.title: "Плоскость аннигиляции"
	quest.42000000000901BF.quest_desc: [
		"Редстоун из сети.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901BF.title: "Излучатель уровня"
	quest.42000000000901C0.quest_desc: [
		"Соединяет сеть с миром и меняет предметы через край.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901C0.title: "Интерфейс"
	quest.42000000000901C1.quest_desc: [
		"Связывает две сети на расстоянии, до которого обычный кабель не достаёт.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901C1.title: "Квантовое кольцо"
	quest.42000000000901C2.quest_desc: [
		"Парная половина квантового кольца, связывающая две сети.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901C2.title: "Квантовая связь"
	quest.42000000000901C3.quest_desc: [
		"Достаёт сеть откуда угодно в радиусе, без кабеля под ногами.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901C3.title: "Беспроводной терминал"
	quest.42000000000901C4.quest_desc: [
		"Копирует настройки одной машины на другую, без повторного ввода.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901C4.title: "Карта памяти"
	quest.42000000000901C5.quest_desc: [
		"Сетевой инструмент для AE2.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901C5.title: "Сетевой инструмент"
	quest.42000000000901C6.quest_desc: [
		"Заряжает кварц certus, пока тот не будет готов к более тонкой работе.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901C6.title: "Зарядник"
	quest.42000000000901C7.quest_desc: [
		"Ускоряет растущую почку кристалла до грозди полного размера.",
		"Как: Сеть Веретена — Certus из песка, контроллеру нужен Связующий узел."
	]
	quest.42000000000901C7.title: "Ускоритель роста кристаллов"
	quest.42000000000901C8.quest_desc: [
		"Доказательство полога Марки — необязательный сувенир, когда переплетаешь.",
		"Как: растёт дико в Марке, лежит в сундуках тростниковой запруды, и Старейшина Корневязов им торгует."
	]
	quest.42000000000901C8.title: "Тростник духа"
	quest.42000000000901C9.quest_desc: [
		"Коса, цифровой ткацкий стан, врата, камень Марки.",
		"Натяни девятую Прядь. Потом Фрагмент, потом Столб.",
		"Забери и выбери один дар племени: Нить Возвращения ещё на одну общую жизнь или припасы.",
		"Как: закончи связанные с этим задания, затем забери жетон Пряди. Посади жетон на свой Столб натяжения."
	]
	quest.42000000000901C9.quest_subtitle: "Переплести"
	quest.42000000000901C9.title: "Узел Веретена"
	quest.42000000000901CA.quest_desc: [
		"ПКМ жетоном по Столбу натяжения своего Clowder.",
		"Насечка загорается, племя звенит, площадка меняется.",
		"Как: ПКМ по своему Столбу натяжения с жетоном Пряди в руке."
	]
	quest.42000000000901CA.title: "Установи Веретено"
	quest.42000000000901CB.quest_desc: [
		"Девять посажены, один камень Марки, один правый клик по Столбу: Фрагмент.",
		"Посади его. Разрез закрывается над твоей площадкой.",
		"Как: девять жетонов посажены, затем правый клик по Столбу с Камнем Марки."
	]
	quest.42000000000901CB.quest_subtitle: "Переплести"
	quest.42000000000901CB.title: "Фрагмент ткацкого стана"
	quest.42000000000901CC.quest_desc: [
		"Посади Фрагмент на Столб натяжения.",
		"Девять племён, одна нить. Иди и посмотри, что Марка сберегла для тебя.",
		"Редкая награда: одна общая жизнь Clowder, один раз на всю команду. Таких наград в кампании только шесть.",
		"Как: посади Фрагмент ткацкого стана Веретена на Столб натяжения. Достижение срабатывает, когда небо закрывается."
	]
	quest.42000000000901CC.quest_subtitle: "Разрез, закрыт"
	quest.42000000000901CC.title: "Переплести"
	quest.42000000000901CD.quest_desc: [
		"Иссушитель, на площадке, в небе. Швецы стана сначала впечатлились бы, а потом пришли в ярость.",
		"Как: Иссушитель (три черепа на песке душ), или лавка Барабанных сердец в /clowder hub один раз, за 12 Рулонов Нити (972 Нити). Необязательный трофей — он не закрывает Энд и не закрывает Ферму монстров на 100%."
	]
	quest.42000000000901CD.title: "Звезда, как-то"
	quest.42000000000A01CE.quest_desc: [
		"Листья роняют больше саженцев.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01CE.title: "Основы клюки"
	quest.42000000000A01CF.quest_desc: [
		"Просеивает быстрее деревянной клюки и служит куда дольше.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01CF.title: "Bone Crook"
	quest.42000000000A01D0.quest_desc: [
		"Самая простая сетка. Всё, что ты просеиваешь, сначала проходит через неё.",
		"Как: девять бечёвок в 3x3. Лавка Певунов щебня продаёт нитяную сетку (бечёвка) Пустотного стана, и она просеивает то же самое."
	]
	quest.42000000000A01D0.title: "String Mesh"
	quest.42000000000A01D1.quest_desc: [
		"Ловит осколки мельче, чем бечёвка. Меньше обрезков проскальзывает сквозь плетение.",
		"Как: четыре кремня и пять бечёвок шахматным узором. Кремень — из гравия, или Нить + гравий."
	]
	quest.42000000000A01D1.title: "Кремнёвая сетка (сито)"
	quest.42000000000A01D2.quest_desc: [
		"Железные нити ловят более тяжёлую крошку и вытягивают более редкие обрезки из кучи.",
		"Как: четыре железных слитка и пять бечёвок шахматным узором. Ни одна лавка этого не продаёт."
	]
	quest.42000000000A01D2.title: "Железная сетка (сито)"
	quest.42000000000A01D3.quest_desc: [
		"Сетка золотого уровня. Шансы сдвигаются к рудам, которые важны.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01D3.title: "Golden Mesh"
	quest.42000000000A01D4.quest_desc: [
		"Просей этим гравий, и алмазы будут попадаться куда чаще.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01D4.title: "Diamond Mesh"
	quest.42000000000A01D5.quest_desc: [
		"Самая тонкая из сделанных сеток. Ничто не просеивает лучше незеритовой нити.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01D5.title: "Netherite Mesh"
	quest.42000000000A01D6.quest_desc: [
		"Глина, выглаженная дочиста, готова обжечься в тигель, который держит настоящий жар.",
		"Как: комок глины + костная мука, без формы. Глина берётся из Бочки натяжения."
	]
	quest.42000000000A01D6.title: "Фарфоровая глина (сито)"
	quest.42000000000A01D7.quest_desc: [
		"Фарфоровая глина, сформованная в тигель. Обожги его в печи.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01D7.title: "Необожжённый тигель"
	quest.42000000000A01D8.quest_desc: [
		"Держит жар плавки и не трескается. Переплавь то, что вытащило сито.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01D8.title: "Porcelain Crucible"
	quest.42000000000A01D9.quest_desc: [
		"Плещет воду по посевам, не вытаптывая ряды.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01D9.title: "Деревянная лейка"
	quest.42000000000A01DA.quest_desc: [
		"Брызги шире и бак глубже. За один заход польёшь больше площадки.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01DA.title: "Железная лейка"
	quest.42000000000A01DB.quest_desc: [
		"Пущенный на листву, прядёт шёлк, пока ест.",
		"Как: ломай листву клюкой; шелкопряды иногда выпадают."
	]
	quest.42000000000A01DB.title: "Silkworm"
	quest.42000000000A01DC.quest_desc: [
		"Странная вода, что подталкивает саженцы и семена к более странным культурам.",
		"Как: бочка воды на мицелии становится ведьминой водой; наполни из неё ведро. Споры мицелия просеиваются из земли."
	]
	quest.42000000000A01DC.title: "Witch Water Bucket"
	quest.42000000000A01DD.quest_desc: [
		"Разбросай их, и мицелий ползёт наружу, блок за терпеливым блоком.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01DD.title: "Mycelium Spores"
	quest.42000000000A01DE.quest_desc: [
		"Брось на землю, и трава расползётся, не дожидаясь дождя.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01DE.title: "Grass Seeds"
	quest.42000000000A01DF.quest_desc: [
		"Крошка вместо булыжника. Снова отдай её молоту, чтобы получить ещё.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01DF.title: "Stone Pebble"
	quest.42000000000A01E0.quest_desc: [
		"Девять булыжников, плотно сложенных в камень хранения для растущей площадки.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01E0.title: "Сжатый булыжник"
	quest.42000000000A01E1.quest_desc: [
		"Дробит булыжник в гравий быстрее любого молота до него.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01E1.title: "Netherite Hammer"
	quest.42000000000A01E2.quest_desc: [
		"Камень Незера, измельчённый в пыль. И базальт, и чернокамень начинаются здесь.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01E2.title: "Blackstone Pebble"
	quest.42000000000A01E3.quest_desc: [
		"Глубинный сланец, измельчённый в крошку, снова готов для сита.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01E3.title: "Deepslate Pebble"
	quest.42000000000A01E4.quest_desc: [
		"Бледный камень из глубокого просева, в основном годится для стройки.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01E4.title: "Кальцит"
	quest.42000000000A01E5.quest_desc: [
		"Серый камень из глубин, простой и лёгкий в обработке.",
		"Как: сито, молот, тигель или бочка Ex Deorum. Подбери сетку под крошку."
	]
	quest.42000000000A01E5.title: "Туф"
	quest.42000000000A01E6.quest_desc: [
		"Медленно растёт под землёй; сложи его стопкой и дай снова накапать в сталактиты.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000A01E6.title: "Капельник"
	quest.42000000000A01E7.quest_desc: [
		"Быстро впитывает стоячую воду, кстати после затопленной фермы.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000A01E7.title: "Губка"
	quest.42000000000B01E8.quest_desc: [
		"Связывает хранилище вокруг в одну сеть с поиском.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: деревянная бочка или сундук, два компаратора, доски и камень. Связывает ближайшие бочки Sophisticated."
	]
	quest.42000000000B01E8.title: "Складской контроллер"
	quest.42000000000B01E9.quest_desc: [
		"Бочка с улучшениями: фильтры, воронки, магниты, пустота.",
		"Как: улучши бочку медью. JEI называет крафт."
	]
	quest.42000000000B01E9.title: "Медная бочка"
	quest.42000000000B01EA.quest_desc: [
		"Больше ячеек, больше рядов улучшений.",
		"Как: бочки и улучшения в JEI. Контроллер связывает стену из бочек."
	]
	quest.42000000000B01EA.title: "Железная бочка"
	quest.42000000000B01EB.quest_desc: [
		"Затягивает выброшенные предметы прямо в бочку с другого края площадки.",
		"Как: бочки и улучшения в JEI. Контроллер связывает стену из бочек."
	]
	quest.42000000000B01EB.title: "Продвинутое улучшение «Магнит»"
	quest.42000000000B01EC.quest_desc: [
		"В одну сторону входит, из другой выходит, блок воронки не нужен.",
		"Как: бочки и улучшения в JEI. Контроллер связывает стену из бочек."
	]
	quest.42000000000B01EC.title: "Улучшение «Воронка»"
	quest.42000000000B01ED.quest_desc: [
		"Удаляет всё сверх вместимости, чтобы ящик никогда не застревал.",
		"Как: бочки и улучшения в JEI. Контроллер связывает стену из бочек."
	]
	quest.42000000000B01ED.title: "Улучшение пустоты"
	quest.42000000000B01EE.quest_desc: [
		"Затягивает близкие предметы прямо в хранилище, на котором оно стоит.",
		"Как: бочки и улучшения в JEI. Контроллер связывает стену из бочек."
	]
	quest.42000000000B01EE.title: "Улучшение подбора"
	quest.42000000000B01EF.quest_desc: [
		"Одна ячейка, разобранная и на виду. Самый простой способ хранить предметы оптом.",
		"Как: дубовые брёвна + сундук. Первый ящик."
	]
	quest.42000000000B01EF.title: "Дубовый ящик 1x1"
	quest.42000000000B01F0.quest_desc: [
		"Две ячейки рядом, чтобы похожие предметы лежали отдельно.",
		"Как: дубовые ящики 1x1 / 1x2 / 2x2, затем уплотняющий ящик и контроллер. JEI называет крафт."
	]
	quest.42000000000B01F0.title: "Дубовый ящик 1x2"
	quest.42000000000B01F1.quest_desc: [
		"Четыре ячейки в одной раме. Плотное хранение на малой площади.",
		"Как: дубовые ящики 1x1 / 1x2 / 2x2, затем уплотняющий ящик и контроллер. JEI называет крафт."
	]
	quest.42000000000B01F1.title: "Дубовый ящик 2x2"
	quest.42000000000B01F2.quest_desc: [
		"Сам прессует содержимое в блоки по мере заполнения.",
		"Как: дубовые ящики 1x1 / 1x2 / 2x2, затем уплотняющий ящик и контроллер. JEI называет крафт."
	]
	quest.42000000000B01F2.title: "Сжимающий ящик"
	quest.42000000000B01F3.quest_desc: [
		"Связывает хранилище вокруг в одну сеть с поиском.",
		"Как: дубовые ящики 1x1 / 1x2 / 2x2, затем уплотняющий ящик и контроллер. JEI называет крафт."
	]
	quest.42000000000B01F3.title: "Контроллер склада (Склад)"
	quest.42000000000B01F4.quest_desc: [
		"Затягивает близкие предметы прямо в ящик.",
		"Как: дубовые ящики 1x1 / 1x2 / 2x2, затем уплотняющий ящик и контроллер. JEI называет крафт."
	]
	quest.42000000000B01F4.title: "Улучшение-сборщик"
	quest.42000000000B01F5.quest_desc: [
		"Вытягивает предметы из сундука или машины рядом.",
		"Как: дубовые ящики 1x1 / 1x2 / 2x2, затем уплотняющий ящик и контроллер. JEI называет крафт."
	]
	quest.42000000000B01F5.title: "Улучшение-вытягиватель"
	quest.42000000000B01F6.quest_desc: [
		"Выталкивает хранимые предметы в инвентарь рядом.",
		"Как: дубовые ящики 1x1 / 1x2 / 2x2, затем уплотняющий ящик и контроллер. JEI называет крафт."
	]
	quest.42000000000B01F6.title: "Улучшение-выталкиватель"
	quest.42000000000B01F7.quest_desc: [
		"Удаляет всё сверх вместимости, чтобы ящик никогда не застревал.",
		"Как: дубовые ящики 1x1 / 1x2 / 2x2, затем уплотняющий ящик и контроллер. JEI называет крафт."
	]
	quest.42000000000B01F7.title: "Улучшение пустоты (Склад)"
	quest.42000000000B01F8.quest_desc: [
		"Переносной инвентарь, который освобождает панель быстрого доступа и карманы.",
		"Как: кожа + сундук. Затем улучшения из железа/золота/алмаза."
	]
	quest.42000000000B01F8.title: "Рюкзак"
	quest.42000000000B01F9.quest_desc: [
		"Больше ячеек, чем у простого рюкзака, и ячейка, чтобы его улучшить.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B01F9.title: "Железный рюкзак"
	quest.42000000000B01FA.quest_desc: [
		"Ещё просторнее, и остаются ячейки под полезные улучшения.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B01FA.title: "Золотой рюкзак"
	quest.42000000000B01FB.quest_desc: [
		"Самые глубокие карманы, пока зачарование не уведёт хранение ещё дальше.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B01FB.title: "Алмазный рюкзак"
	quest.42000000000B01FC.quest_desc: [
		"Затягивает близкие предметы прямо в хранилище, на котором оно стоит.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B01FC.title: "Улучшение подбора (Склад)"
	quest.42000000000B01FD.quest_desc: [
		"Фильтрует то, что входит в рюкзаки.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B01FD.title: "Улучшение «Фильтр»"
	quest.42000000000B01FE.quest_desc: [
		"Позволяет рюкзаку крафтить из того, что уже лежит внутри.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B01FE.title: "Улучшение: «Верстак»"
	quest.42000000000B01FF.quest_desc: [
		"Автоматически кормит тебя из своих запасов, когда голод падает.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B01FF.title: "Улучшение «Кормление»"
	quest.42000000000B0200.quest_desc: [
		"Меняет сломанный инструмент на целый из рюкзака.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B0200.title: "Улучшение «Загрузка»"
	quest.42000000000B0201.quest_desc: [
		"Опустошает рюкзак в ближайшие сундуки, когда ты подходишь.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B0201.title: "Улучшение «Разгрузка»"
	quest.42000000000B0202.quest_desc: [
		"Добавляет бак для жидкости внутрь рюкзака, чтобы таскать её.",
		"Как: кожаный рюкзак, затем улучшения из железа/золота/алмаза в JEI."
	]
	quest.42000000000B0202.title: "Улучшение «Резервуар»"
	quest.42000000000C0203.quest_desc: [
		"Основной металл большинства машин и корпусов этой линии.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0203.title: "Стальной слиток"
	quest.42000000000C0204.quest_desc: [
		"Основной металл большинства кабелей, баков и ранних машин.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0204.title: "Осмиевый слиток"
	quest.42000000000C0205.quest_desc: [
		"Твёрдый сплав из спрессованной обсидиановой пыли, для более крепкого снаряжения.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0205.title: "Очищенный обсидиан"
	quest.42000000000C0206.quest_desc: [
		"Простейшая логическая плата. Большинству ранних машин нужно несколько.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0206.title: "Базовая схема управления"
	quest.42000000000C0207.quest_desc: [
		"Плата логики поострее, для машин на ступень выше по линии.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0207.title: "Продвинутая схема управления"
	quest.42000000000C0208.quest_desc: [
		"Самая острая плата логики, только для верхних машин линии.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0208.title: "Элитная схема управления"
	quest.42000000000C0209.quest_desc: [
		"Насыщает металлы углеродом, редстоуном или алмазной пылью перед плавкой.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0209.title: "Металлургический наполнитель"
	quest.42000000000C020A.quest_desc: [
		"Удваивает большинство сырой руды: две пыли вместо одной.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C020A.title: "Камера обогащения"
	quest.42000000000C020B.quest_desc: [
		"Мели или дроби сырьё пачками.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C020B.title: "Дробитель"
	quest.42000000000C020C.quest_desc: [
		"Плавит руду на энергии, а не на топливе, и чуть быстрее.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C020C.title: "Энергетическая плавильня"
	quest.42000000000C020D.quest_desc: [
		"Очищает обогащённую руду кислородом ради третьего выхода, иногда больше.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C020D.title: "Камера очистки"
	quest.42000000000C020E.quest_desc: [
		"Впрыскивает газ в руду ради самого богатого выхода линии.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C020E.title: "Химическая инъекция"
	quest.42000000000C020F.quest_desc: [
		"Прессует пыль осмия в слитки быстрее, чем печь сама по себе.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C020F.title: "Осмиевый компрессор"
	quest.42000000000C0210.quest_desc: [
		"Одна ячейка стопки, куда больше, чем вмещает сундук.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0210.title: "Базовый ящик"
	quest.42000000000C0211.quest_desc: [
		"Хранит глубокий запас одной жидкости в одном блоке.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0211.title: "Базовый жидкостный бак"
	quest.42000000000C0212.quest_desc: [
		"Сглаживает энергию между машинами, чтобы скачки не стопорили линию.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0212.title: "Базовый энергетический куб"
	quest.42000000000C0213.quest_desc: [
		"Несёт энергию к машинам. Самый обычный кабель на площадке.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0213.title: "Базовый универсальный провод"
	quest.42000000000C0214.quest_desc: [
		"Гоняет жидкости между баками и машинами вдоль площадки.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0214.title: "Базовая механическая труба"
	quest.42000000000C0215.quest_desc: [
		"Автоматически переносит предметы между связанными инвентарями.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0215.title: "Базовый логистический транспортёр"
	quest.42000000000C0216.quest_desc: [
		"Крутит, работает как ключ и перенастраивает грани машин одним инструментом.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0216.title: "Конфигуратор"
	quest.42000000000C0217.quest_desc: [
		"Реактивный ранец Mek — подъём по желанию.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0217.title: "Реактивный ранец"
	quest.42000000000C0218.quest_desc: [
		"Смягчает урон от падения и выигрывает секунду, прежде чем пустота тебя заберёт.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0218.title: "Бегунки"
	quest.42000000000C0219.quest_desc: [
		"Один инструмент: копает, режет и дерётся, острее с каждым улучшением.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C0219.title: "Атомный разборщик"
	quest.42000000000C021A.quest_desc: [
		"Несущий каркас, вокруг которого собирают большинство многоблочных машин.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C021A.title: "Стальной корпус"
	quest.42000000000C021B.quest_desc: [
		"Связывает две точки, и шаг сквозь них пропускает путь между ними.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C021B.title: "Телепорт"
	quest.42000000000C021C.quest_desc: [
		"Сам копает широкий радиус и сортирует добычу для тебя.",
		"Как: глава Цеха Mekanism — куски руды из сита, затем заводская линия."
	]
	quest.42000000000C021C.title: "Цифровой шахтёр"
	quest.42000000000D021D.quest_desc: [
		"Липкий базовый ингредиент, на котором держится большинство машин сети.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D021D.title: "Диэлектрическая паста"
	quest.42000000000D021E.quest_desc: [
		"Запаси порцию энергии.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D021E.title: "Базовый конденсатор"
	quest.42000000000D021F.quest_desc: [
		"Держит глубокий запас энергии для машин вокруг.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D021F.title: "Базовая энергоячейка"
	quest.42000000000D0220.quest_desc: [
		"Жжёт топливо в энергию эффективнее простой печи.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0220.title: "Базовый сжигатель"
	quest.42000000000D0221.quest_desc: [
		"Превращает лаву в ровную энергию, пока лава не кончится.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0221.title: "Базовый сжигатель магмы"
	quest.42000000000D0222.quest_desc: [
		"Даёт энергию от дневного света, больше, чем одна ячейка сама по себе.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0222.title: "Базовая солнечная панель"
	quest.42000000000D0223.quest_desc: [
		"Даёт энергию из разницы тепла между горячими и холодными блоками рядом.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0223.title: "Базовый термогенератор"
	quest.42000000000D0224.quest_desc: [
		"Ровно жжёт твёрдое топливо, давая сильную и надёжную струйку энергии.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0224.title: "Базовый реактор"
	quest.42000000000D0225.quest_desc: [
		"Передаёт больше энергии за тик, чем стартовый кабель.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0225.title: "Базовый энергокабель"
	quest.42000000000D0226.quest_desc: [
		"Заряжает тебя напрямую, без проводов и слотов.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0226.title: "Базовый передатчик игрока"
	quest.42000000000D0227.quest_desc: [
		"Подаёт энергию в ближние машины так, как воронка подаёт предметы.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0227.title: "Базовая энергетическая воронка"
	quest.42000000000D0228.quest_desc: [
		"Быстрее заряжает ячейки зарядки, если стоит рядом со сборкой из кристаллов.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0228.title: "Базовый стержень зарядки"
	quest.42000000000D0229.quest_desc: [
		"Карманный запас энергии, чтобы носить его руками от машины к машине.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D0229.title: "Базовая батарея"
	quest.42000000000D022A.quest_desc: [
		"Первый уровень кристалла для камеры ячеек стержня зарядки.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D022A.title: "Ниотиевый кристалл"
	quest.42000000000D022B.quest_desc: [
		"Более сильный уровень кристалла, дальше по сборке камеры зарядки.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D022B.title: "Резонансный кристалл"
	quest.42000000000D022C.quest_desc: [
		"Самый сильный уровень кристалла, который вмещает камера зарядки.",
		"Как: глава Сеть Powah — сфера зарядки и кабели, когда появится Пульс Искры."
	]
	quest.42000000000D022C.title: "Нитрокристалл"
	quest.42000000000E022D.quest_desc: [
		"Спрядено из цветка мага и вплетено в мантии и снаряжение для заклинаний.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E022D.title: "Волокно мага"
	quest.42000000000E022E.quest_desc: [
		"Цветок, у которого после сбора на стебле снова растёт волокно.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E022E.title: "Чароцвет"
	quest.42000000000E022F.quest_desc: [
		"Хранит плотный бассейн источника, топливо за каждым заклинанием.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E022F.title: "Блок из самоцветов Истока"
	quest.42000000000E0230.quest_desc: [
		"Вмещает больше глифов, чем позволяет стартовая книга.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0230.title: "Книга заклинаний ученика"
	quest.42000000000E0231.quest_desc: [
		"Самая большая книга заклинаний, места хватает на целый арсенал глифов.",
		"Как: Книга заклинаний мага, три жемчуга Эндера, два изумруда, Тотем бессмертия, Звезда Нижнего мира и Дань Wilden, без формы. Тотем: рецепт модпака, четыре золотых блока и четыре изумруда вокруг золотого яблока."
	]
	quest.42000000000E0231.title: "Книга заклинаний архимага"
	quest.42000000000E0232.quest_desc: [
		"Сам творит привязанное заклинание, как только чует цель.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0232.title: "Турель заклинаний"
	quest.42000000000E0233.quest_desc: [
		"Творит привязанное заклинание по ровному таймеру, а не когда видит.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0233.title: "Заклинательная туррель с таймером"
	quest.42000000000E0234.quest_desc: [
		"Основа для создания книг заклинаний, жезлов и прочего арканного снаряжения.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0234.title: "Чародейский аппарат"
	quest.42000000000E0235.quest_desc: [
		"Стоит внутри чародейского аппарата и приводит в ход его рецепты.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0235.title: "Аркановое ядро"
	quest.42000000000E0236.quest_desc: [
		"Носит источник между арканной точкой и связанной банкой или заклинанием.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0236.title: "Реле"
	quest.42000000000E0237.quest_desc: [
		"Делит одну линию источника, чтобы питать сразу несколько мест.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0237.title: "Разветвитель реле"
	quest.42000000000E0238.quest_desc: [
		"Превращает рост ближних посевов в медленную струйку источника.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0238.title: "Агрономическое сочетание"
	quest.42000000000E0239.quest_desc: [
		"Превращает жар ближней лавы в ровную струйку источника.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0239.title: "Вулканическое сочетание"
	quest.42000000000E023A.quest_desc: [
		"Призывает wixie, которая делает рецепты за тебя, пока ты работаешь в другом месте.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E023A.title: "Талисман Викси"
	quest.42000000000E023B.quest_desc: [
		"Призывает starbuncle, который по приказу приносит предметы из хранилища.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E023B.title: "Талисман Звездоуха"
	quest.42000000000E023C.quest_desc: [
		"Призывает drygmy, который рядом медленно создаёт выбранный ресурс.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E023C.title: "Талисман Дрыгма"
	quest.42000000000E023D.quest_desc: [
		"Призывает whirlisprig, который сам ухаживает за посевами и растит их.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E023D.title: "Талисман Вертявки"
	quest.42000000000E023E.quest_desc: [
		"Призывает голема, который собирает аметистовые почки, не поднимая кирку.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E023E.title: "Талисман Аметистового Голема"
	quest.42000000000E023F.quest_desc: [
		"Подбирает и ставит блоки издалека, связывая машины на расстоянии.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E023F.title: "Жезл Владычества"
	quest.42000000000E0240.quest_desc: [
		"Помечает предмет как разрешённый, когда его кладут в фильтр.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0240.title: "Свиток разрешения"
	quest.42000000000E0241.quest_desc: [
		"Помечает предмет как запрещённый, когда его кладут в фильтр.",
		"Как: Арканная сторона — арканное древо и ягода источника из мха, затем каскад."
	]
	quest.42000000000E0241.title: "Свиток запрета"
	quest.42000000000F0242.quest_desc: [
		"Брёвна вокруг Связующего узла, Нить сверху. Поставь его на площадку.",
		"Стой рядом: площадка начинает лечить тебя, когда Прядь посажена.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: брёвна вокруг Связующего узла, Нить сверху. Поставь его на площадку. Посмотри на него, чтобы завершить."
	]
	quest.42000000000F0242.title: "Поставь Столб"
	quest.42000000000F0243.quest_desc: [
		"Ключ узла в руке, или /clowder hub. Здесь встречается каждый Clowder сервера.",
		"/clowder return вернёт тебя домой.",
		"Как: Ключ узла или `/clowder hub`. `/clowder return` возвращает домой."
	]
	quest.42000000000F0243.title: "Войди в Зал"
	quest.42000000000F0244.quest_desc: [
		"Над Причалом стоит медленная тёмная колонна: сам разрез.",
		"Она истончается, когда Clowders сажают Пряди. Возвращайся и проверяй её время от времени.",
		"Как: /clowder hub, посмотри вверх на тёмную колонну над Причалом, затем нажми галочку."
	]
	quest.42000000000F0244.title: "Посмотри на Разрыв"
	quest.42000000000F0245.quest_desc: [
		"Запиши площадку на своё имя.",
		"Как: K открывает панель острова. Держи Хартию; используй её присев на земле площадки Верхнего мира, чтобы запечатать появление. Начни здесь называет шаги."
	]
	quest.42000000000F0245.title: "Хартия острова"
	quest.42000000000F0246.quest_desc: [
		"Открывает путь назад в Зал Clowder из любой точки Пряди.",
		"Как: стартовый набор / Зал. `/clowder hub` и Ключ узла ведут в Зал Clowder; `/clowder return` возвращает домой."
	]
	quest.42000000000F0246.title: "Ключ узла"
	quest.42000000000F0247.quest_desc: [
		"Узор флага, который показывает, как далеко дошла твоя Прядь.",
		"Как: скрафти в Зале или в JEI. Метка флага, не жетон Пряди."
	]
	quest.42000000000F0247.title: "Флаг Пряди"
	quest.42000000000F0248.quest_desc: [
		"Гравис (`) открывает список заданий. ПКМ по Кодексу Усов для Начни здесь. Та же кампания; без клика с Shift по книге.",
		"Как: книга и любой камень, бесформенно. Гравис (`) открывает тот же список без неё."
	]
	quest.42000000000F0248.title: "Список заданий"
	quest.42000000000F0249.quest_desc: [
		"Не голодай в вылазках за притязанием.",
		"Как: восемь золотых самородков вокруг моркови. Морковь — редкая добыча зомби; перекус необязателен."
	]
	quest.42000000000F0249.title: "Перекус для притязаний"
	quest.42000000000F024A.quest_desc: [
		"Наносит площадки вокруг тебя, пока твой Clowder расползается наружу.",
		"Как: компас, окружённый бумагой."
	]
	quest.42000000000F024A.title: "Карта"
	quest.42000000000F024B.quest_desc: [
		"Указывает назад на точку появления мира; полезно, когда площадок становится много.",
		"Как: железо вокруг редстоуна."
	]
	quest.42000000000F024B.title: "Компас"
	quest.42000000000F024C.quest_desc: [
		"Привязывает компас к одной точной точке, а не к точке появления.",
		"Как: незеритовый слиток в резных каменных кирпичах. Поздняя роскошь Clowder."
	]
	quest.42000000000F024C.title: "Магнетит"
	quest.42000000000F024D.quest_desc: [
		"Указывает на твою последнюю смерть, чтобы ничто не осталось потерянным в пустоте.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000F024D.title: "Компас восстановления"
	quest.42000000000F024E.quest_desc: [
		"Звонит достаточно громко, чтобы собрать весь Clowder на одной площадке.",
		"Как: рецепта нет. Ритуал Occultism «Связь с диким духом» делает один, но нужна коза, а козы до площадки не доходят. Необязательно."
	]
	quest.42000000000F024E.title: "Колокол"
	quest.42000000000F024F.quest_desc: [
		"Держит книгу открытой, чтобы её читал весь Clowder.",
		"Как: деревянные плиты вокруг книжной полки."
	]
	quest.42000000000F024F.title: "Кафедра"
	quest.42000000000F0250.quest_desc: [
		"Метит район, чтобы новички знали, какая площадка какая.",
		"Как: доски над палкой."
	]
	quest.42000000000F0250.title: "Дубовая табличка"
	quest.42000000000F0251.quest_desc: [
		"Пустой флаг, готовый принять цвета Clowder.",
		"Как: шесть шерсти над палкой."
	]
	quest.42000000000F0251.title: "Белый флаг"
	quest.42000000000F0252.quest_desc: [
		"Щит, готовый под флаги.",
		"Как: шесть досок вокруг железа. Блок второй рукой."
	]
	quest.42000000000F0252.title: "Щит готов к флагу"
	quest.42000000000F0253.quest_desc: [
		"Запусти их, когда Прядь наконец снова соберётся.",
		"Как: бумага плюс порох. Необязательный залп."
	]
	quest.42000000000F0253.title: "Фейерверк"
	quest.42000000000F0254.quest_desc: [
		"Поделись с Залом.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000F0254.title: "Дань печенья"
	quest.42000000000F0255.quest_desc: [
		"Общая еда, чтобы отпраздновать Прядь, по-настоящему переплетённую.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000F0255.title: "Торт"
	quest.42000000000F0256.quest_desc: [
		"Кошачья пластинка — настроение сборки.",
		"Необязательно — пустота может так и не предложить его.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000F0256.title: "Пластинка"
	quest.42000000000F0257.quest_desc: [
		"Ведёт приручённое или купленное животное обратно на площадку, без погони.",
		"Как: четыре бечёвки вокруг сгустка слизи. Слизь — это компост площадки (земля, семена, костная мука)."
	]
	quest.42000000000F0257.title: "Поводок"
	quest.42000000000F0258.quest_desc: [
		"Садись верхом, когда найдёшь седло.",
		"Необязательно — Хранители площадки в Зале Clowder продают одно.",
		"Как: обменяй алмазный блок у Хранителей площадки в их лавке в Зале Clowder (/clowder hub). Седло Chocobo — другой предмет."
	]
	quest.42000000000F0258.title: "Седло"
	quest.42000000000F0259.quest_desc: [
		"На день, когда кто-нибудь построит море. Необязательно.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000000F0259.title: "Лодка"
	quest.4200000000110278.quest_desc: [
		"Показывает, где аура сгущается или редеет по земле.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: Золотой лист + паучий глаз. Показывает местную ауру."
	]
	quest.4200000000110278.title: "Глаз (Аура)"
	quest.4200000000110279.quest_desc: [
		"Сплетено из золота, чтобы напитать растения сгущённой аурой.",
		"Как: четыре листа и четыре золотых самородка вокруг короткой травы дают четыре Блестящих волокна. Положи её в крону дерева; листья со временем станут золотыми."
	]
	quest.4200000000110279.title: "Сияющее волокно (Аура)"
	quest.420000000011027A.quest_desc: [
		"Очищенный материал для рецептов алтаря более высоких ступеней.",
		"Как: сломай золотые листья, выросшие из Блестящего волокна."
	]
	quest.420000000011027A.title: "Сусальное золото (Аура)"
	quest.420000000011027B.quest_desc: [
		"Листья, что держат мягкое золотое сияние круглый год.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011027B.title: "Золотые листья"
	quest.420000000011027C.quest_desc: [
		"Держит ингредиент для Ритуала леса, поставленный вокруг саженца.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011027C.title: "Деревянная подставка"
	quest.420000000011027D.quest_desc: [
		"Алтарь, где аура питает более сильные рецепты крафта.",
		"Как: Ритуал леса (JEI): три камня, Золотой лист, золотой слиток и Жетон радости. Линия Сердца ауры."
	]
	quest.420000000011027D.title: "Природный алтарь (Аура)"
	quest.420000000011027E.quest_desc: [
		"Железо, заряженное аурой, шаг к Слитку глубин.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011027E.title: "Насыщенное железо (Аура)"
	quest.420000000011027F.quest_desc: [
		"Кора, снятая с древних деревьев, полезна в рецептах ауры.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011027F.title: "Древняя кора"
	quest.4200000000110280.quest_desc: [
		"Жетон радости. Природный алтарь и Травоядный поглотитель собираются на нём.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110280.title: "Жетон радости (Аура)"
	quest.4200000000110281.quest_desc: [
		"Жетон страха. Умалитель кроны и Затяжной поглотитель собираются на одном.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110281.title: "Знак страха"
	quest.4200000000110282.quest_desc: [
		"Жетон гнева. Крошащийся катализатор и Метка выстрела требуют один.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110282.title: "Знак гнева"
	quest.4200000000110283.quest_desc: [
		"Жетон скорби. Стол подношений и Распутыватель смертных требуют один.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110283.title: "Знак скорби"
	quest.4200000000110284.quest_desc: [
		"Дух ауры для ритуалов.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110284.title: "Дух призыва"
	quest.4200000000110285.quest_desc: [
		"Дух рождения для обрядов ауры.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110285.title: "Дух рождения"
	quest.4200000000110286.quest_desc: [
		"Хранит запас ауры на случай, когда земля оскудеет.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110286.title: "Сокровищница ауры"
	quest.4200000000110287.quest_desc: [
		"Поздно. Только если Аура этого хочет.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110287.title: "Творческий катализатор"
	quest.4200000000110288.quest_desc: [
		"Показывает ауру и условия появления на большем участке земли.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110288.title: "Экологический окуляр"
	quest.4200000000110289.quest_desc: [
		"Поставленный рядом с Природным алтарём, открывает рецепты дробления алтаря.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110289.title: "Разрушающий катализатор"
	quest.420000000011028A.quest_desc: [
		"Поставленный рядом с Природным алтарём, открывает рецепты трансмутации алтаря.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011028A.title: "Трансмутационный катализатор"
	quest.420000000011028B.quest_desc: [
		"Небесные слитки, порченое золото и обломок незерита, спрессованные в Слиток глубин.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011028B.title: "Слиток глубин"
	quest.420000000011028C.quest_desc: [
		"Отмечает схему фермы, которая тянет ауру, чтобы посевы росли быстрее.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011028C.title: "Фермерский трафарет"
	quest.420000000011028D.quest_desc: [
		"Создаёт ауру всякий раз, когда снаряд падает рядом.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011028D.title: "Магическая мишень"
	quest.420000000011028E.quest_desc: [
		"Медленно создаёт ауру из цветов, цветущих рядом.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011028E.title: "Травоядный поглотитель"
	quest.420000000011028F.quest_desc: [
		"Медленно создаёт ауру из дубов, растущих рядом.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.420000000011028F.title: "Усмиритель дубов"
	quest.4200000000110290.quest_desc: [
		"Цветок из Энда, и на площадке ему странно уютно.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110290.title: "Роза забвения"
	quest.4200000000110291.quest_desc: [
		"Освещает область, чтобы там не появлялись враждебные существа.",
		"Как: Блестящее волокно на деревьях → Золотой лист → Природный алтарь. Глава ауры называет жетоны и генераторы."
	]
	quest.4200000000110291.title: "Лампа безопасности"
	quest.4200000000120292.quest_desc: [
		"Готовит блюда вроде рагу, которых хватает больше чем на одну тарелку за раз.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000120292.title: "Кастрюля (Кухня)"
	quest.4200000000120293.quest_desc: [
		"Сковорода жарит блюда.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000120293.title: "Сковорода"
	quest.4200000000120294.quest_desc: [
		"Плита для Farmer's Delight.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000120294.title: "Кухонная плита"
	quest.4200000000120295.quest_desc: [
		"Режет мясо и овощи на ингредиенты, которые требуют другие рецепты.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000120295.title: "Разделочная доска (Кухня)"
	quest.4200000000120296.quest_desc: [
		"Корзина, чтобы таскать урожай.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000120296.title: "Корзина"
	quest.4200000000120297.quest_desc: [
		"По ней лезешь, как по лиане, и она нужна нескольким кухонным рецептам.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000120297.title: "Верёвка"
	quest.4200000000120298.quest_desc: [
		"Ловит долгое падение и подбрасывает тебя обратно целым и невредимым.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.4200000000120298.title: "Страховочная сеть"
	quest.4200000000120299.quest_desc: [
		"Ускоряет рост ближайших посевов, когда вспашешь её и засеешь.",
		"Как: поставь Органический компост и жди; он медленно зреет в Богатую почву."
	]
	quest.4200000000120299.title: "Богатая почва (Кухня)"
	quest.420000000012029A.quest_desc: [
		"Превращает пищевые отходы в компост, чтобы обогащать почву.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000012029A.title: "Органический компост (Кухня)"
	quest.420000000012029B.quest_desc: [
		"Сытная еда, завёрнутая в капусту, восстанавливает солидный кусок голода.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000012029B.title: "Голубцы"
	quest.420000000012029C.quest_desc: [
		"Быстро готовится, быстро съедается, приличная сытость за этот труд.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000012029C.title: "Сэндвич с беконом"
	quest.420000000012029D.quest_desc: [
		"Слоёное блюдо, которое восстанавливает больше голода, чем части по отдельности.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000012029D.title: "Гамбургер"
	quest.420000000012029E.quest_desc: [
		"Согревающая миска, которая восстанавливает голод и насыщение разом.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000012029E.title: "Куриный суп"
	quest.420000000012029F.quest_desc: [
		"Говяжье рагу насыщает крепко.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.420000000012029F.title: "Тушёная говядина"
	quest.42000000001202A0.quest_desc: [
		"Лапша и бульон, сытно настолько, что хватит на целый рабочий день.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A0.title: "Лапшичный суп"
	quest.42000000001202A1.quest_desc: [
		"Запечённый десерт, который стоит ожидания и восстанавливает щедрый кусок голода.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A1.title: "Яблочный пирог"
	quest.42000000001202A2.quest_desc: [
		"Кисло-сладкий, один из самых сытных десертов на площадке.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A2.title: "Чизкейк со сладкими ягодами"
	quest.42000000001202A3.quest_desc: [
		"Рис для кухонной линии.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A3.title: "Рис"
	quest.42000000001202A4.quest_desc: [
		"Уютная еда кухонной линии.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A4.title: "Жареный рис"
	quest.42000000001202A5.quest_desc: [
		"Маленькие фаршированные свёртки, быстро готовятся партиями.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A5.title: "Пельмени"
	quest.42000000001202A6.quest_desc: [
		"Тёплый напиток из какао-бобов и молока.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A6.title: "Горячее какао"
	quest.42000000001202A7.quest_desc: [
		"Прохладный напиток из арбуза, быстро восстанавливает немного голода.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A7.title: "Арбузный сок"
	quest.42000000001202A8.quest_desc: [
		"Тканое полотно для нескольких рецептов кухни и декора.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A8.title: "Холст"
	quest.42000000001202A9.quest_desc: [
		"Мягкий тканый пол, другая фактура вместо голого дерева.",
		"Как: рецепт Farmer's Delight в JEI (верстак, разделочная доска или котёл). Семена культур — из просеивания земли."
	]
	quest.42000000001202A9.title: "Татами"
	quest.42000000001302AA.quest_desc: [
		"Первая книга, которая даёт тебе творить чары в настоящем бою.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: три цепи, четыре кожи и две бумаги. Глава заклинаний называет чернила."
	]
	quest.42000000001302AA.title: "Железная книга чар"
	quest.42000000001302AB.quest_desc: [
		"Вмещает больше ячеек чар, чем железная книга до неё.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302AB.title: "Золотая книга чар"
	quest.42000000001302AC.quest_desc: [
		"Книга покрепче, с ещё большим местом для чар.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302AC.title: "Алмазная книга чар"
	quest.42000000001302AD.quest_desc: [
		"Питает колдовство и лежит в основе большинства рецептов чар.",
		"Как: убивай заклинателей или крафти то, что указано в JEI. Топливо для чернил и книг."
	]
	quest.42000000001302AD.title: "Арканическая эссенция (Чары)"
	quest.42000000001302AE.quest_desc: [
		"Записывай заклинания и страницы.",
		"Как: бутылочка + эссенция + краситель. Первые чернила для надписи."
	]
	quest.42000000001302AE.title: "Обычные чернила"
	quest.42000000001302AF.quest_desc: [
		"Вписывает в книгу чары и свитки необычного уровня.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302AF.title: "Необычные чернила"
	quest.42000000001302B0.quest_desc: [
		"Вписывает в книгу чары и свитки редкого уровня.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B0.title: "Редкие чернила"
	quest.42000000001302B1.quest_desc: [
		"Вписывает в книгу чары и свитки эпического уровня.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B1.title: "Эпические чернила"
	quest.42000000001302B2.quest_desc: [
		"Вписывает самые редкие и сильные чары, какие книга может вместить.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B2.title: "Легендарные чернила"
	quest.42000000001302B3.quest_desc: [
		"Творит чары один раз, и их не нужно учить по книге.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B3.title: "Свиток"
	quest.42000000001302B4.quest_desc: [
		"Магическая ткань для мантий.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B4.title: "Магическая ткань"
	quest.42000000001302B5.quest_desc: [
		"Лёгкая броня: колдовство важнее простой защиты.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B5.title: "Шлем странствующего мага"
	quest.42000000001302B6.quest_desc: [
		"Нагрудник под скорость колдовства, а не под принятый урон.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B6.title: "Нагрудник странствующего мага"
	quest.42000000001302B7.quest_desc: [
		"Посох, который проводит огненные чары с дополнительной силой.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B7.title: "Пириевый посох"
	quest.42000000001302B8.quest_desc: [
		"Скромный посох для заклинателя, который только начинает.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302B8.title: "Посох старца"
	quest.42000000001302B9.quest_desc: [
		"Клинок, который карает заклинателей и рассекает их защиту.",
		"Как: рецепт модпака, два Арканических слитка по диагонали, цепь с каждой стороны и алмаз у рукояти. Единственный дикий носитель живёт в крепостях заклинателей, а у площадки их никогда нет."
	]
	quest.42000000001302B9.title: "Магоборец"
	quest.42000000001302BA.quest_desc: [
		"Самая ранняя книга чар: ячеек мало, но её легко достать.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302BA.title: "Медная книга чар"
	quest.42000000001302BB.quest_desc: [
		"Самая сильная книга чар: в ней больше всего ячеек чар.",
		"Как: четыре Арканические ткани, два Флакона крови, незеритовый слиток, Бутылка молнии и Разрушенная книга (рецепт модпака). JEI называет это Древним кодексом."
	]
	quest.42000000001302BB.title: "Незеритовая книга чар"
	quest.42000000001302BC.quest_desc: [
		"Очищенный металл для снаряжения колдовства высокого уровня.",
		"Как: Арканическая эссенция и чернила, затем книга чар. Глава Чары называет лестницу."
	]
	quest.42000000001302BC.title: "Волшебный слиток"
	quest.42000000001302BD.quest_desc: [
		"Повреждённая книга, из которой снова можно собрать знание.",
		"Как: рецепт модпака, зачарованная книга в кольце из четырёх Арканических эссенций и четырёх песков душ. JEI называет это Разрушенной книгой."
	]
	quest.42000000001302BD.title: "Разрушенный кодекс"
	quest.42000000001402BE.quest_desc: [
		"Первая деталь Solar Flux. Из неё делают ячейки, покрытия и Пустое улучшение.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: три стекла над железным слитком дают три Зеркала."
	]
	quest.42000000001402BE.title: "Зеркало"
	quest.42000000001402BF.quest_desc: [
		"Первый уровень солнечной ячейки: слабая, но дешёвая в стопке.",
		"Как: три стекла, три лазурита и три Зеркала, по ряду каждого."
	]
	quest.42000000001402BF.title: "Фотоэлемент 1"
	quest.42000000001402C0.quest_desc: [
		"Солнечная ячейка посильнее, на ступень выше прошлого уровня.",
		"Как: три комка глины, три лазурита, два Зеркала и Фотоэлемент I."
	]
	quest.42000000001402C0.title: "Фотоэлемент 2"
	quest.42000000001402C1.quest_desc: [
		"Солнечная ячейка среднего уровня: с панели заметно больше выход.",
		"Как: три стекла, три светопыли, два обсидиана и Фотоэлемент II."
	]
	quest.42000000001402C1.title: "Фотоэлемент 3"
	quest.42000000001402C2.quest_desc: [
		"Солнечная ячейка высокого уровня для панели, которую наращивают.",
		"Как: три Пылающих покрытия, две светопыли, алмаз, два кварцевых блока и Фотоэлемент III."
	]
	quest.42000000001402C2.title: "Фотоэлемент 4"
	quest.42000000001402C3.quest_desc: [
		"Почти верхний уровень: эта ячейка тянет серьёзную мощь из дневного света.",
		"Как: три Изумрудных стекла, два блока светокамня, алмазный блок, кварцевый блок и два Фотоэлемента IV. Даёт два."
	]
	quest.42000000001402C3.title: "Фотоэлемент 5"
	quest.42000000001402C4.quest_desc: [
		"Самая сильная из сделанных солнечных ячеек, потолок одной панели.",
		"Как: три Эндеровых стекла, два блока светокамня, изумрудный блок, кварцевый блок и два Фотоэлемента V. Даёт два."
	]
	quest.42000000001402C4.title: "Фотоэлемент 6"
	quest.42000000001402C5.quest_desc: [
		"Позволяет солнечной панели держать больший запас накопленной энергии.",
		"Как: пять блоков редстоуна, алмазный блок и Пустое улучшение."
	]
	quest.42000000001402C5.title: "Улучшение вместимости"
	quest.42000000001402C6.quest_desc: [
		"Выжимает больше энергии из того же солнечного света.",
		"Как: три Зеркала, Пустое улучшение и Фотоэлемент I."
	]
	quest.42000000001402C6.title: "Улучшение эффективности"
	quest.42000000001402C7.quest_desc: [
		"Позволяет солнечной панели отдавать энергию быстрее.",
		"Как: шесть редстоуна и два золотых слитка вокруг Пустого улучшения."
	]
	quest.42000000001402C7.title: "Улучшение передачи"
	quest.42000000001402C8.quest_desc: [
		"Передаёт энергию машинам у панели, в пределах нескольких блоков.",
		"Как: четыре железных слитка, два поршня и два редстоуна вокруг Пустого улучшения."
	]
	quest.42000000001402C8.title: "Улучшение перехода"
	quest.42000000001402C9.quest_desc: [
		"Шлёт энергию игрокам, стоящим у панели.",
		"Как: четыре светопыли и четыре Ока Эндера вокруг Пустого улучшения."
	]
	quest.42000000001402C9.title: "Рассеивающее улучшение"
	quest.42000000001402CA.quest_desc: [
		"Шлёт энергию одному связанному блоку в радиусе, кабель не нужен.",
		"Как: четыре эндер-жемчуга и четыре блока редстоуна вокруг Рассеивающего улучшения."
	]
	quest.42000000001402CA.title: "Улучшение зарядки блока"
	quest.42000000001402CB.quest_desc: [
		"Даёт панели переплавлять предметы запасённым солнечным светом, а не топливом.",
		"Как: пять углей, печь и два Пылающих покрытия вокруг Пустого улучшения."
	]
	quest.42000000001402CB.title: "Улучшение печи"
	quest.42000000001402CC.quest_desc: [
		"Зеркальное стекло с изумрудом. Эндер-стекло и Фотоэлемент V делают на его основе.",
		"Как: изумруд между двумя Зеркалами столбиком даёт два."
	]
	quest.42000000001402CC.title: "Изумрудное стекло"
	quest.42000000001402CD.quest_desc: [
		"Изумрудное стекло, заряженное жемчугом и оком. Фотоэлемент VI делают на его основе.",
		"Как: три Изумрудных стекла над Оком Эндера между двумя эндер-жемчугами дают три."
	]
	quest.42000000001402CD.title: "Эндер-стекло"
	quest.42000000001402CE.quest_desc: [
		"Зеркальная отделка, припылённая огненным порошком. Фотоэлемент IV и Улучшение печи её используют.",
		"Как: огненный порошок между двумя Зеркалами столбиком даёт два."
	]
	quest.42000000001402CE.title: "Пылающее покрытие"
	quest.42000000001402CF.quest_desc: [
		"Улучшение без назначения, из которого крафтится любой тип улучшения.",
		"Как: четыре булыжника вокруг Зеркала."
	]
	quest.42000000001402CF.title: "Пустое улучшение"
	quest.42000000001502D0.quest_desc: [
		"Простой, надёжный камень для стен и полов.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: четыре камня квадратом, или камнерез."
	]
	quest.42000000001502D0.title: "Каменные кирпичи"
	quest.42000000001502D1.quest_desc: [
		"Замшелая кирпичная отделка площадки.",
		"Как: каменные кирпичи плюс лианы или мох. Потом камнерез."
	]
	quest.42000000001502D1.title: "Замшелые каменные кирпичи"
	quest.42000000001502D2.quest_desc: [
		"Обветренные каменные кирпичи, потрёпанные и потрескавшиеся.",
		"Как: переплавь каменные кирпичи."
	]
	quest.42000000001502D2.title: "Потрескавшиеся каменные кирпичи"
	quest.42000000001502D3.quest_desc: [
		"Резные каменные кирпичи для отделки и акцентных линий.",
		"Как: две плиты из каменных кирпичей, или камнерез."
	]
	quest.42000000001502D3.title: "Резные каменные кирпичи"
	quest.42000000001502D4.quest_desc: [
		"Ровная каменная отделка для полов.",
		"Как: переплавь камень. Плиты берутся в камнерезе."
	]
	quest.42000000001502D4.title: "Гладкий камень"
	quest.42000000001502D5.quest_desc: [
		"Серый камень, отполированный до гладкости.",
		"Как: четыре андезита, или камнерез."
	]
	quest.42000000001502D5.title: "Полированный андезит"
	quest.42000000001502D6.quest_desc: [
		"Ярко-белый камень, гладко отполированный.",
		"Как: четыре диорита, или камнерез."
	]
	quest.42000000001502D6.title: "Полированный диорит"
	quest.42000000001502D7.quest_desc: [
		"Тёплый розовый камень, отполированный для отделки.",
		"Как: четыре гранита, или камнерез."
	]
	quest.42000000001502D7.title: "Полированный гранит"
	quest.42000000001502D8.quest_desc: [
		"Обожжённые глиняные блоки, тёплый красный на сером камне.",
		"Как: четыре предмета «кирпич». Комки глины переплавляются в кирпичи."
	]
	quest.42000000001502D8.title: "Кирпичи"
	quest.42000000001502D9.quest_desc: [
		"Бледная уплотнённая грязь, сформованная в отделку построек.",
		"Как: четыре уплотнённых грязи. Грязь — это земля плюс бутылка воды; грязь и пшеница дают уплотнённую грязь."
	]
	quest.42000000001502D9.title: "Саман"
	quest.42000000001502DA.quest_desc: [
		"Тёмные каменные кирпичи, добытые из глубины.",
		"Как: полированный глубинный сланец квадратом, или камнерез. Четыре гальки глубинного сланца (просей землю) дают булыжный глубинный сланец."
	]
	quest.42000000001502DA.title: "Кирпичи из глубинного сланца"
	quest.42000000001502DB.quest_desc: [
		"Гладкая тёмная плитка для более изящного пола.",
		"Как: кирпичи из глубинного сланца квадратом, или камнерез."
	]
	quest.42000000001502DB.title: "Плитки из глубинного сланца"
	quest.42000000001502DC.quest_desc: [
		"Тёмный камень Незера, крепкий и простой.",
		"Как: ведьмина вода, влитая в бочку лавы, или четыре гальки чернита. Твердыни сложены из него."
	]
	quest.42000000001502DC.title: "Чернит"
	quest.42000000001502DD.quest_desc: [
		"Чернит, отполированный до глянцевого тёмного блеска.",
		"Как: четыре чернита, или камнерез. Незер после Когтя."
	]
	quest.42000000001502DD.title: "Полированный чернит"
	quest.42000000001502DE.quest_desc: [
		"Чернит с вкраплениями золота, редкий и декоративный.",
		"Как: бастион Незера после обсидиана Когтя. Конечная ветка декора, не дальнейшие врата."
	]
	quest.42000000001502DE.title: "Позолоченный чернит"
	quest.42000000001502DF.quest_desc: [
		"Ярко-белый блок, основа декора площадки.",
		"Как: четыре незерских кварца. Незер после Когтя."
	]
	quest.42000000001502DF.title: "Кварцевый блок"
	quest.42000000001502E0.quest_desc: [
		"Кварц, выглаженный для чистой отделки.",
		"Как: переплавь кварцевый блок."
	]
	quest.42000000001502E0.title: "Гладкий кварц"
	quest.42000000001502E1.quest_desc: [
		"Фиолетовый камень Энда, странный акцент.",
		"Как: четыре прожаренных плода хоруса. Плод хоруса — это лавка Кромкоходов."
	]
	quest.42000000001502E1.title: "Пурпурный блок"
	quest.42000000001502E2.quest_desc: [
		"Камень, рождённый морем, со слабым синим мерцанием.",
		"Как: нужны осколки призмарина. Только океан. Необязательно."
	]
	quest.42000000001502E2.title: "Призмарин"
	quest.42000000001502E3.quest_desc: [
		"Более тёмный призмарин, хорош для глубоких акцентов.",
		"Как: нужны осколки призмарина. Только океан. Необязательно."
	]
	quest.42000000001502E3.title: "Тёмный призмарин"
	quest.42000000001502E4.quest_desc: [
		"Ровный свет, поднятый с океанского дна.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502E4.title: "Морской фонарь"
	quest.42000000001502E5.quest_desc: [
		"Тёплый оранжевый свет, выращенный из гриба Незера.",
		"Как: растёт на огромных грибах. Посади гриб на нилий и посыпь костной мукой."
	]
	quest.42000000001502E5.title: "Грибосвет"
	quest.42000000001502E6.quest_desc: [
		"Мягкий жёлтый свет, совсем без пламени.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502E6.title: "Охристый лягушачий фонарь"
	quest.42000000001502E7.quest_desc: [
		"Бледный светящийся свет с перламутровым отливом.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502E7.title: "Перламутровый лягушачий фонарь"
	quest.42000000001502E8.quest_desc: [
		"Прохладный зелёный свет, без пламени и безопасный в помещении.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502E8.title: "Зелёный лягушачий фонарь"
	quest.42000000001502E9.quest_desc: [
		"Стекло, которое не пускает свет, но оставляет вид.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502E9.title: "Тонированное стекло"
	quest.42000000001502EA.quest_desc: [
		"Мягкое белое стекло для нежного света из окна.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502EA.title: "Белое стекло"
	quest.42000000001502EB.quest_desc: [
		"Бледно-голубое стекло, близкое к открытому небу.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502EB.title: "Светло-синее стекло"
	quest.42000000001502EC.quest_desc: [
		"Прохладное бирюзовое стекло для более спокойной комнаты.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502EC.title: "Бирюзовое стекло"
	quest.42000000001502ED.quest_desc: [
		"Густо-фиолетовое стекло, кивок пустоте внизу.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502ED.title: "Фиолетовое стекло"
	quest.42000000001502EE.quest_desc: [
		"Маленькое ровное пламя для света настроения.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502EE.title: "Свеча"
	quest.42000000001502EF.quest_desc: [
		"Бледная свеча, едва заметная на светлых стенах.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502EF.title: "Белая свеча"
	quest.42000000001502F0.quest_desc: [
		"Безопасно лезь по краю площадки.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F0.title: "Башня из строительных лесов"
	quest.42000000001502F1.quest_desc: [
		"Лестницы для вертикальных площадок.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F1.title: "Запас лестниц"
	quest.42000000001502F2.quest_desc: [
		"Рельсы через пустоту.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F2.title: "Запасной рельс"
	quest.42000000001502F3.quest_desc: [
		"Держит тебя на плаву, если площадка когда-нибудь встретит воду.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F3.title: "Дубовая лодка"
	quest.42000000001502F4.quest_desc: [
		"Декор для стен площадки.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F4.title: "Запасная картина"
	quest.42000000001502F5.quest_desc: [
		"Показывает полный комплект брони на площадке.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F5.title: "Стойка для брони"
	quest.42000000001502F6.quest_desc: [
		"Держит выставленный предмет, который никогда не гаснет.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F6.title: "Светящаяся рамка"
	quest.42000000001502F7.quest_desc: [
		"Цветочные горшки для зелени.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F7.title: "Запасной цветочный горшок"
	quest.42000000001502F8.quest_desc: [
		"Подвесные таблички для комнат.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F8.title: "Дубовая подвесная табличка"
	quest.42000000001502F9.quest_desc: [
		"Ткацкий стан для работы с флагами.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502F9.title: "Ткацкий стан"
	quest.42000000001502FA.quest_desc: [
		"Режет камень в точные формы, без отходов.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502FA.title: "Камнерез"
	quest.42000000001502FB.quest_desc: [
		"Чинит инструменты и снимает чары, которые тебе не нужны.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502FB.title: "Точило"
	quest.42000000001502FC.quest_desc: [
		"Улучшает снаряжение кузнечными шаблонами и незеритом.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502FC.title: "Стол кузнеца"
	quest.42000000001502FD.quest_desc: [
		"Нанеси сетку острова.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502FD.title: "Стол картографа"
	quest.42000000001502FE.quest_desc: [
		"Рабочее место жителя, на площадке в основном украшение.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502FE.title: "Стол лучника"
	quest.42000000001502FF.quest_desc: [
		"Плавит руду вдвое быстрее обычной печи.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.42000000001502FF.title: "Запасная плавильная печь"
	quest.4200000000150300.quest_desc: [
		"Готовит еду вдвое быстрее обычной печи.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000150300.title: "Запасная коптильня"
	quest.4200000000150301.quest_desc: [
		"Держит немного воды, красителя или зелья.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000150301.title: "Котёл"
	quest.4200000000150302.quest_desc: [
		"Автоматически переносит предметы между контейнерами снизу и сверху.",
		"Как: пять железа вокруг сундука. Поставь её под Раму ткацкого стана или Бочку натяжения (извлекает ВНИЗ)."
	]
	quest.4200000000150302.title: "Запасная воронка"
	quest.4200000000150303.quest_desc: [
		"Выстреливает или использует то, что в него загрузишь.",
		"Как: булыжник, лук и редстоун."
	]
	quest.4200000000150303.title: "Запасной раздатчик"
	quest.4200000000150304.quest_desc: [
		"Даёт импульс редстоуна, когда блок впереди меняется.",
		"Как: булыжник, редстоун и незерский кварц."
	]
	quest.4200000000150304.title: "Запасной наблюдатель"
	quest.4200000000150305.quest_desc: [
		"Постоянный сильный сигнал редстоуна в виде блока.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000150305.title: "Блок редстоуна"
	quest.4200000000150306.quest_desc: [
		"Шлёт силу сигнала по тому, насколько точно попадёшь.",
		"Как: редстоун вокруг сена. Сено — это три пшеницы."
	]
	quest.4200000000150306.title: "Запасная мишень"
	quest.4200000000150307.quest_desc: [
		"Играет одну ноту, когда его ударишь или подашь сигнал. Настрой вручную.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000150307.title: "Запасной нотный блок"
	quest.4200000000150308.quest_desc: [
		"Играет пластинки по всей площадке.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.4200000000150308.title: "Запасной проигрыватель"
	quest.4200000000150309.quest_desc: [
		"Колокол отмечает Clowder.",
		"Как: рецепта нет. Ритуал Occultism «Связь с диким духом» делает один, но нужна коза, а козы до площадки не доходят. Необязательно."
	]
	quest.4200000000150309.title: "Запасной колокол"
	quest.420000000015030A.quest_desc: [
		"Ставит твою точку возрождения в Незере и заряжается светокамнем.",
		"Как: плачущий обсидиан плюс светокамень. Возрождение только в Незере."
	]
	quest.420000000015030A.title: "Якорь возрождения"
	quest.420000000015030B.quest_desc: [
		"Привязывает компас к этому самому блоку, а не к точке появления.",
		"Как: незеритовый слиток в резных каменных кирпичах. Поздняя роскошь Clowder."
	]
	quest.420000000015030B.title: "Запасной магнетит"
	quest.420000000015030C.quest_desc: [
		"Безопасно отводит удары молнии от площадки.",
		"Как: скрафти, переплавь, просей или добудь с монстра. JEI перечисляет каждый источник на площадке."
	]
	quest.420000000015030C.title: "Запасной громоотвод"
	quest.420000000015030D.quest_desc: [
		"Личное хранилище, которое следует за тобой, куда бы ты ни пошёл.",
		"Как: восемь обсидиана вокруг Ока Эндера. Око — жемчуг Эндера плюс огненный порошок."
	]
	quest.420000000015030D.title: "Сундук Эндера"
	quest.420000000015030E.quest_desc: [
		"Крафтится в шалкеровый ящик для безопасного хранения стопками.",
		"Как: рецепт модпака, шесть блоков пурпура, два жемчуга Эндера и Связующий узел. Шалкеры здесь никогда не появляются. Необязательно."
	]
	quest.420000000015030E.title: "Панцирь шалкера"
	quest.420000000016030F.quest_desc: [
		"Пол и стены везде, где строишь над лавой.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: Незер здесь — пустота, не земля. Лей лаву в бочку Ex Deorum с ведьминой водой (бочка воды на мицелии; споры мицелия просеиваются из земли)."
	]
	quest.420000000016030F.title: "Запас незерака"
	quest.4200000000160310.quest_desc: [
		"Обожжённый грязекамень, стянутый кварцем. Держит форму у огня.",
		"Как: переплавь незерак, затем четыре предмета незерского кирпича."
	]
	quest.4200000000160310.title: "Незерские кирпичи"
	quest.4200000000160311.quest_desc: [
		"Адский нарост, запечённый в кирпич. Цвет теплее, прочность та же.",
		"Как: незерские кирпичи плюс адский нарост. Незер после Когтя."
	]
	quest.4200000000160311.title: "Красные незерские кирпичи"
	quest.4200000000160312.quest_desc: [
		"Остывший столб магмы, нарезанный блоками, чтобы было куда встать.",
		"Как: лава, текущая по почве душ рядом с синим льдом, или четыре гальки базальта из просева измельчённого чернокамня."
	]
	quest.4200000000160312.title: "Базальт"
	quest.4200000000160313.quest_desc: [
		"Базальт, отшлифованный до гладкости. Читается как камень, не как подмостки.",
		"Как: камнерез, или четыре базальта."
	]
	quest.4200000000160313.title: "Полированный базальт"
	quest.4200000000160314.quest_desc: [
		"Базальт без гребней. Хорош для ровных полов и отделки.",
		"Как: переплавь базальт."
	]
	quest.4200000000160314.title: "Гладкий базальт"
	quest.4200000000160315.quest_desc: [
		"Булыжник Незера. Крафти его дальше, в инструменты и кирпичи.",
		"Как: ведьмина вода, влитая в бочку лавы, или четыре гальки чернита. Твердыни сложены из него."
	]
	quest.4200000000160315.title: "Запас чернокамня"
	quest.4200000000160316.quest_desc: [
		"Греет ближнюю воду до кипения и ранит босые ноги.",
		"Как: четыре сгустка магмы. Сгусток слизи в лавовой бочке делает сгусток магмы."
	]
	quest.4200000000160316.title: "Магмовый блок"
	quest.4200000000160317.quest_desc: [
		"Запас песка душ под ногу.",
		"Как: песок в бочку Ex Deorum с ведьминой водой. В крепости комнаты с наростом держат немного. Три черепа на песке душ делают Иссушителя."
	]
	quest.4200000000160317.title: "Запас песка душ"
	quest.4200000000160318.quest_desc: [
		"Даёт гореть огню душ и факелам душ вместо обычного пламени.",
		"Как: песок душ, брошенный в лавовую бочку Ex Deorum."
	]
	quest.4200000000160318.title: "Почва душ"
	quest.4200000000160319.quest_desc: [
		"Дробится в четыре пыли или освещает комнату без дыма.",
		"Как: четыре светопыли. Пыль просеивается из песка душ."
	]
	quest.4200000000160319.title: "Светокамень"
	quest.420000000016031A.quest_desc: [
		"Гриб, который светится сам. Проводка не нужна.",
		"Как: растёт на огромных грибах. Посади гриб на нилий и посыпь костной мукой."
	]
	quest.420000000016031A.title: "Запас грибосвета"
	quest.420000000016031B.quest_desc: [
		"Девять адских наростов, собранных в блок. В основном украшение и краситель.",
		"Как: девять адских наростов. Нарост просеивается из песка душ или растёт в садах крепости."
	]
	quest.420000000016031B.title: "Блок адского нароста"
	quest.420000000016031C.quest_desc: [
		"Синий родич багрового блока. Тот же рецепт, цвет холоднее.",
		"Как: растёт на огромных искажённых грибах. Посыпь костной мукой искажённый гриб на искажённом нилии."
	]
	quest.420000000016031C.title: "Блок искажённого нароста"
	quest.420000000016031D.quest_desc: [
		"Древесина, которая не древесина. С неё снимается кора, и выходят доски, как с любого бревна.",
		"Как: споры багрового нилия (просей измельчённый незерак) на незерак, костная мука на нилий, чтобы вышел гриб, затем костная мука на гриб."
	]
	quest.420000000016031D.title: "Багровый стебель"
	quest.420000000016031E.quest_desc: [
		"Другой грибной ствол. Доски выходят синими, а не красными.",
		"Как: споры искажённого нилия (просей измельчённый незерак) на незерак, костная мука на нилий, чтобы вышел гриб, затем костная мука на гриб."
	]
	quest.420000000016031E.title: "Искажённый стебель"
	quest.420000000016031F.quest_desc: [
		"Цепь для подвесного украшения.",
		"Как: багровые леса после Когтя. Свисают с потолка."
	]
	quest.420000000016031F.title: "Плакучие лианы"
	quest.4200000000160320.quest_desc: [
		"Взбирается по искажённому лесу и отмечает опору в дымке.",
		"Как: искажённые леса после Когтя. Растут вверх с нилия."
	]
	quest.4200000000160320.title: "Искажённые лианы"
	quest.4200000000160321.quest_desc: [
		"Плачет фиолетовым светом и закрепляет точку возрождения в Незере.",
		"Как: сундуки бастиона, обмен с пиглинами или пчёлы Draconic на обсидиане. Разрушенные порталы здесь не появляются."
	]
	quest.4200000000160321.title: "Плачущий обсидиан"
	quest.4200000000160322.quest_desc: [
		"Зарыт под обычными рудами. Переплавляй его к незериту.",
		"Как: разбей молотом чернокамень в измельчённый чернокамень и просей его. В сундуках бастиона есть немного."
	]
	quest.4200000000160322.title: "Древние обломки"
	quest.4200000000160323.quest_desc: [
		"Четыре лома и четыре золотых слитка дают один незеритовый слиток.",
		"Как: переплавь древние обломки. Четыре лома плюс золото дают слиток."
	]
	quest.4200000000160323.title: "Незеритовый лом"
	quest.4200000000160324.quest_desc: [
		"Самый твёрдый металл, что когда-либо удержит рука Skybound.",
		"Как: четыре лома плюс четыре золота. Обломки — редкий Незер после Когтя."
	]
	quest.4200000000160324.title: "Незеритовый слиток"
	quest.4200000000160325.quest_desc: [
		"Топливо и для варочных стоек, и для плавилен. Держи стопку про запас.",
		"Как: крепость Незера после обсидиана Когтя. Зельям нужен стержень; Ars и Occultism его не ждут."
	]
	quest.4200000000160325.title: "Запас огненных стержней"
	quest.4200000000160326.quest_desc: [
		"Зелью регенерации нужна одна, и ещё терпение рядом с гастом.",
		"Как: гасты Незера после обсидиана Когтя."
	]
	quest.4200000000160326.title: "Слеза гаста"
	quest.4200000000160327.quest_desc: [
		"Варится в огнестойкость или снова крафтится в магмовый блок.",
		"Как: сгусток слизи, брошенный в лавовую бочку, слизь плюс огненный порошок, или магмовые кубы."
	]
	quest.4200000000160327.title: "Сгусток магмы"
	quest.4200000000160328.quest_desc: [
		"Три призывают Иссушителя. Один и на полке смотрится неплохо.",
		"Как: крепость Незера после обсидиана Когтя. Три черепа запускают Иссушителя."
	]
	quest.4200000000160328.title: "Череп визер-скелета"
	quest.4200000000160329.quest_desc: [
		"Пиглины меняют на золото. Самородок работает не хуже слитка.",
		"Как: один слиток даёт девять, или незерская золотая руда."
	]
	quest.4200000000160329.title: "Куча золотых самородков"
	quest.420000000016032A.quest_desc: [
		"Плавится в золото и копается быстрее руды, в честь которой назван.",
		"Как: комбайнер Mekanism, восемь необработанного золота плюс незерак. В пустом Незере нет руды."
	]
	quest.420000000016032A.title: "Незерская золотая руда"
	quest.420000000016032B.quest_desc: [
		"Ярко-белый камень: и строить из него, и вести сигналы компаратора.",
		"Как: просей песок душ, или обмен с пиглинами."
	]
	quest.420000000016032B.title: "Кварц"
	quest.420000000016032C.quest_desc: [
		"Брошенный, зажигает огонь. Заряженный в раздатчик — тоже.",
		"Как: огненный порошок, уголь и порох."
	]
	quest.420000000016032C.title: "Огненный заряд"
	quest.4200000000178001.quest_desc: [
		"Двенадцать рамок портала — не крафт площадки, так что Энд всего в одном укусе.",
		"Съешь, чтобы встать на обсидиановой площадке Энда; съешь оставшуюся половину, чтобы вернуться домой, туда, откуда ел.",
		"Как: пять жемчужин Энда, две кости и два огненных порошка на верстаке."
	]
	quest.4200000000178001.title: "Яблоко Энда"
	quest.420000000017032D.quest_desc: [
		"Бледный камень с дальней стороны. Тяжёлый, простой и бесконечный.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: плод хоруса и жемчуг Энда (лавка Кромкоходов) вокруг Связующего узла. Даёт восемь. Острова Энда больше нет."
	]
	quest.420000000017032D.title: "Эндерняк"
	quest.420000000017032E.quest_desc: [
		"Эндерняк, нарезанный квадратом, для более чистых линий на площадке Энда.",
		"Как: четыре Эндерняка квадратом, или камнерез. Эндерняк — это крафт Узла."
	]
	quest.420000000017032E.title: "Эндерняковые кирпичи"
	quest.420000000017032F.quest_desc: [
		"Выращен из плода хоруса, затем запечён в строительный камень.",
		"Как: четыре прожаренных плода хоруса. Плод хоруса — это лавка Кромкоходов."
	]
	quest.420000000017032F.title: "Запас пурпурного блока"
	quest.4200000000170330.quest_desc: [
		"Пурпур с узором колонны, ориентируется, как поставишь.",
		"Как: две пурпурные плиты, или камнерез. Сначала приготовленный плод хоруса."
	]
	quest.4200000000170330.title: "Пурпурная колонна"
	quest.4200000000170331.quest_desc: [
		"Холодный свет, что никогда не мерцает и заодно служит столбом для рельсов.",
		"Как: огненный стержень плюс приготовленный плод хоруса. Незер после Когтя; хорус — лавка Кромкоходов."
	]
	quest.4200000000170331.title: "Стержень Энда"
	quest.4200000000170332.quest_desc: [
		"Съешь — и телепортируешься коротким непредсказуемым прыжком.",
		"Как: лавка Кромкоходов в /clowder hub. Внешние острова Энда исчезли."
	]
	quest.4200000000170332.title: "Плод хоруса"
	quest.4200000000170333.quest_desc: [
		"Плод хоруса приготовлен. Крафтится в пурпур и красители, не телепортируя тебя.",
		"Как: переплавь плод хоруса из лавки Кромкоходов."
	]
	quest.4200000000170333.title: "Приготовленный хорус"
	quest.4200000000170334.quest_desc: [
		"Брось его — и окажешься там, где он упадёт, минус немного здоровья.",
		"Как: эндермены, или лавка Кромкоходов в /clowder hub."
	]
	quest.4200000000170334.title: "Запас эндер-жемчуга"
	quest.4200000000170335.quest_desc: [
		"Запас очей Эндера.",
		"Как: жемчуг Эндера (лавка Кромкоходов / эндермены) плюс огненный порошок из крепости Незера после обсидиана Когтя. Запас из восьми глаз необязателен; кристаллы Энда используют тот же крафт."
	]
	quest.4200000000170335.title: "Запас ока Эндера"
	quest.4200000000170336.quest_desc: [
		"Дыхание дракона для зелий.",
		"Как: стеклянный пузырёк на дракона. Острова Энда больше нет. Необязательно."
	]
	quest.4200000000170336.title: "Запас дыхания дракона"
	quest.4200000000170337.quest_desc: [
		"Единственный трофей дракона. Если кликнуть, никогда не сидит на месте.",
		"Редкая награда: одна общая жизнь Clowder, один раз на всю команду. Таких наград в кампании только шесть.",
		"Как: дракон ушёл вместе с островом Энда. Необязательный трофей — он не закрывает сундуки Края."
	]
	quest.4200000000170337.title: "Показ яйца дракона"
	quest.4200000000170338.quest_desc: [
		"Элитры для пути по небу.",
		"Необязательно — пустота может так и не предложить его.",
		"Как: города Энда исчезли. Необязательно."
	]
	quest.4200000000170338.title: "Показ элитр"
	quest.4200000000170339.quest_desc: [
		"Панцири шалкера для ящиков.",
		"Необязательно — здесь нет шалкеров, поэтому пак крафтит панцири.",
		"Как: рецепт модпака, шесть блоков пурпура, два жемчуга Эндера и Связующий узел. Шалкеры здесь никогда не появляются. Необязательно."
	]
	quest.4200000000170339.title: "Запас панциря шалкера"
	quest.420000000017033A.quest_desc: [
		"Переносной сундук, который хранит содержимое, когда ломаешь его.",
		"Необязательно — Кромкоходы в Зале Clowder продают одну.",
		"Как: два Панциря шалкера вокруг сундука (панцири — рецепт пака), или лавка Кромкоходов в /clowder hub за 22 Мотока Нити (198 Нити). Необязательно."
	]
	quest.420000000017033A.title: "Показ ящика шалкера"
	quest.420000000017033B.quest_desc: [
		"Кристаллы Энда — осторожно.",
		"Как: стекло, око Эндера, слеза гаста. Незер после обсидиана Когтя; яйцо необязательно."
	]
	quest.420000000017033B.title: "Показ кристалла Энда"
	quest.420000000017033C.quest_desc: [
		"Каждый сундук Эндера на каждой площадке делит одно скрытое хранилище.",
		"Как: восемь обсидиана вокруг Ока Эндера. Око — жемчуг Эндера плюс огненный порошок."
	]
	quest.420000000017033C.title: "Показ сундука Эндера"
	quest.420000000017033D.quest_desc: [
		"Посади его на камень Энда, и плод хоруса растёт вверх.",
		"Как: внешние острова Энда исчезли. Плод хоруса — в лавке Кромкоходов. Необязательно."
	]
	quest.420000000017033D.title: "Цветок хоруса"
	quest.420000000017033E.quest_desc: [
		"Двенадцать таких, заполненных глазами, открывают путь в Энд.",
		"Как: это не крафт площадки. Необязательно."
	]
	quest.420000000017033E.title: "Рамка портала Энда"
	quest.420000000017033F.quest_desc: [
		"Цемент, ставший твёрдым. Тёмный, как пустота, и постоянный, когда застынет.",
		"Как: цемент плюс вода. Порошок — это песок, гравий и краситель."
	]
	quest.420000000017033F.title: "Чёрный бетон"
	quest.4200000000170340.quest_desc: [
		"Кричащий акцентный цвет для тихого, бледного биома.",
		"Как: цемент плюс вода. Порошок — это песок, гравий и краситель."
	]
	quest.4200000000170340.title: "Фиолетовый бетон"
	quest.4200000000170341.quest_desc: [
		"Лава, остывшая при контакте с водой. Взрывостойкая, медленно добывается.",
		"Как: вода на источник лавы (или лава на воду). Сохрани источник лавы."
	]
	quest.4200000000170341.title: "Запас обсидиана"
	quest.4200000000170342.quest_desc: [
		"Слабо светится и, заряженный, выбрасывает тебя с якоря возрождения.",
		"Как: сундуки бастиона, обмен с пиглинами или пчёлы Draconic на обсидиане. Разрушенные порталы здесь не появляются."
	]
	quest.4200000000170342.title: "Запас плачущего обсидиана"
	quest.4200000000170343.quest_desc: [
		"Заряди его светокамнем, чтобы задать точку возрождения в Незере.",
		"Как: плачущий обсидиан плюс светокамень. Возрождение только в Незере."
	]
	quest.4200000000170343.title: "Показ якоря возрождения"
	quest.4200000000170344.quest_desc: [
		"В неосновной руке отменяет один удар, иначе смертельный.",
		"Как: только награды заданий. Посади Часы и Посади Печать дают по одному, а подарки поздних Узлов Пряди дают ещё. Рейды и заклинатели никогда не приходят на площадку. Необязательно."
	]
	quest.4200000000170344.title: "Показ тотема"
	quest.4200000000170345.quest_desc: [
		"Единственная добыча Иссушителя. Маяку нужна одна, чтобы зажечься.",
		"Как: Иссушитель (три черепа на песке душ), или лавка Барабанных сердец в /clowder hub один раз, за 12 Рулонов Нити (972 Нити). Необязательный трофей — он не закрывает Энд и не закрывает Ферму монстров на 100%."
	]
	quest.4200000000170345.title: "Показ звезды Незера"
	quest.4200000000170346.quest_desc: [
		"Питается пирамидой из минеральных блоков и даёт эффекты, пока ты стоишь в зоне.",
		"Как: звезда Незера, стекло и обсидиан. Необязательный трофей — океанские ветки висят на Запасе обсидиана."
	]
	quest.4200000000170346.title: "Показ маяка"
	quest.4200000000170347.quest_desc: [
		"В кольце из призмарина даёт под водой подводное дыхание и спешку.",
		"Необязательно — пустота может так и не предложить его.",
		"Как: нужны Сердце моря и наутилус. Только океан. Необязательно."
	]
	quest.4200000000170347.title: "Показ морского источника"
	quest.4200000000170348.quest_desc: [
		"Восемь окружают морской источник, а одна крафтится в компас моря.",
		"Необязательно — пустота может так и не предложить его.",
		"Как: только океан. Необязательно."
	]
	quest.4200000000170348.title: "Раковина наутилуса"
	quest.4200000000170349.quest_desc: [
		"Редкая добыча утопленника. Брось его или направь молнию в грозу.",
		"Как: только утопленники. Необязательно."
	]
	quest.4200000000170349.title: "Показ трезубца"
	quest.420000000018034A.quest_desc: [
		"Базовая эссенция. Кормит и ускорители роста, и переработчики.",
		"Девять племён оставили припасы для следующего Clowder. Используй тайник хранителя, чтобы распаковать случайные припасы, или скрафти четыре малых тайника в один средний и три средних в один большой. Большие печати дают больше бросков и более широкий пул припасов; открывать по отдельности даёт больше простых припасов. Внутри не прячутся машины и жетоны прогресса, но у каждой печати есть небольшой шанс Осколка Нити и очень маленький шанс целой Нити возврата; у больших печатей шанс лучше.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018034A.title: "Запас Inferium"
	quest.420000000018034B.quest_desc: [
		"Недоделанное семя. Без эссенции ничего не вырастет.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018034B.title: "Основа Prosperity"
	quest.420000000018034C.quest_desc: [
		"Расходуется один раз и поднимает эссенцию на следующий уровень.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018034C.title: "Наполняющий кристалл"
	quest.420000000018034D.quest_desc: [
		"Эссенция второго уровня, очищенная из стопок Inferium.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018034D.title: "Запас Prudentium"
	quest.420000000018034E.quest_desc: [
		"Эссенция третьего уровня, на ступень выше Prudentium.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018034E.title: "Запас Tertium"
	quest.420000000018034F.quest_desc: [
		"Эссенция четвёртого уровня, близко к вершине цепочки.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018034F.title: "Запас Imperium"
	quest.4200000000180350.quest_desc: [
		"Эссенция пятого уровня, почти на пределе очистки.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180350.title: "Запас Supremium"
	quest.4200000000180351.quest_desc: [
		"Очищенная вершина. Нужна для сильнейшего снаряжения и семян.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180351.title: "Пробуждённая эссенция"
	quest.4200000000180352.quest_desc: [
		"Главная деталь, чтобы пробудить эссенцию до конечной формы.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180352.title: "Алтарь пробуждения"
	quest.4200000000180353.quest_desc: [
		"Окружи алтарь ими, чтобы завершить пробуждение.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180353.title: "Пьедестал пробуждения"
	quest.4200000000180354.quest_desc: [
		"Кристалл инфузии, у которого не кончаются заряды.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180354.title: "Мастер-кристалл"
	quest.4200000000180355.quest_desc: [
		"Хранит эссенцию оптом, чтобы машины не пересыхали.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180355.title: "Сосуд для эссенции"
	quest.4200000000180356.quest_desc: [
		"Базовая деталь любой машины на эссенции.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180356.title: "Корпус механизма"
	quest.4200000000180357.quest_desc: [
		"Следит за посевами рядом и ломает их в тот миг, когда они созревают.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180357.title: "Комбайн"
	quest.4200000000180358.quest_desc: [
		"Превращает лишние семена обратно в эссенцию, а не в хлам.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180358.title: "Seed Reprocessor"
	quest.4200000000180359.quest_desc: [
		"Ускоряет посевы рядом эссенцией Inferium.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180359.title: "Ускоритель Inferium"
	quest.420000000018035A.quest_desc: [
		"Ускоритель посильнее, на ярус выше Inferium.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018035A.title: "Ускоритель Prudentium"
	quest.420000000018035B.quest_desc: [
		"Ускорение среднего яруса для поля, где работы больше.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018035B.title: "Ускоритель Tertium"
	quest.420000000018035C.quest_desc: [
		"Почти наверху шкалы скорости роста.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018035C.title: "Ускоритель Imperium"
	quest.420000000018035D.quest_desc: [
		"Самый быстрый ускоритель, который может собрать эссенция.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018035D.title: "Ускоритель Supremium"
	quest.420000000018035E.quest_desc: [
		"Простой плеск воды для жаждущих посевов.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018035E.title: "Лейка"
	quest.420000000018035F.quest_desc: [
		"Лейка, насыщенная Inferium, достаёт дальше.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018035F.title: "Лейка Inferium"
	quest.4200000000180360.quest_desc: [
		"За раз поливает больше посевов, чем простая лейка.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180360.title: "Лейка Prudentium"
	quest.4200000000180361.quest_desc: [
		"Лейка среднего яруса, с заметно более широким плеском.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180361.title: "Лейка Tertium"
	quest.4200000000180362.quest_desc: [
		"За один проход поливает широкий участок поля.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180362.title: "Лейка Imperium"
	quest.4200000000180363.quest_desc: [
		"Самый широкий плеск, на который способна лейка.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180363.title: "Лейка Supremium"
	quest.4200000000180364.quest_desc: [
		"Ускоряет рост, если бросишь её на уже посаженные культуры.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180364.title: "Удобряющая эссенция"
	quest.4200000000180365.quest_desc: [
		"Пыль, из которой делают слитки Soulium. Компонент для враждебных семян.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180365.title: "Соулиевая пыль"
	quest.4200000000180366.quest_desc: [
		"Пыль Soulium, связанная со слитком Prosperity, тёмная и чуть холодная.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180366.title: "Соулиевый слиток"
	quest.4200000000180367.quest_desc: [
		"Сделан из Soulium. Наносит дополнительный урон враждебным мобам.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180367.title: "Соулиевый кинжал"
	quest.4200000000180368.quest_desc: [
		"Недоделанное семя для выращивания враждебных мобов.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180368.title: "Соулиевая семенная основа"
	quest.4200000000180369.quest_desc: [
		"Выращивай пыль редстоуна, а не добывай её.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180369.title: "Семена редстоуна (Поля)"
	quest.420000000018036A.quest_desc: [
		"Поле синевы вместо пещеры, полной синевы.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018036A.title: "Семена лазурита (Поля)"
	quest.420000000018036B.quest_desc: [
		"Растит алмазы на стебле, а не под землёй.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018036B.title: "Алмазные семена (Поля)"
	quest.420000000018036C.quest_desc: [
		"Выращивает изумруды без единой сделки с жителем.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018036C.title: "Изумрудные семена"
	quest.420000000018036D.quest_desc: [
		"Растит обсидиан, и ни одного ведра воды в поле зрения.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018036D.title: "Семена обсидиана (Поля)"
	quest.420000000018036E.quest_desc: [
		"Выращивает кварц, не ступая в Незер.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018036E.title: "Семена незер-кварца (Поля)"
	quest.420000000018036F.quest_desc: [
		"Растит свет без похода к потолку Незера.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.420000000018036F.title: "Семена светокамня (Поля)"
	quest.4200000000180370.quest_desc: [
		"Самая редкая культура. Растит лом к самому твёрдому металлу.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180370.title: "Незеритовые семена"
	quest.4200000000180371.quest_desc: [
		"Выращивает осколки аметиста без единой жеоды.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180371.title: "Аметистовые семена"
	quest.4200000000180372.quest_desc: [
		"Растит бутылочки мёда без единого ужаления.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180372.title: "Медовые семена"
	quest.4200000000180373.quest_desc: [
		"Выращивает призмарин без океанского монумента рядом.",
		"Как: рецепт Mystical Agriculture в JEI. Inferium и Prosperity берутся из сита; семена насыщают на Алтаре инфузии."
	]
	quest.4200000000180373.title: "Семена призмарина"
	quest.4200000000180374.quest_desc: [
