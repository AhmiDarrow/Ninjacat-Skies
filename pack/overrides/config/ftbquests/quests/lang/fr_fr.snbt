	]
	quest.42000000001C0420.title: "Chaîne réglable"
	quest.42000000001C0421.quest_desc: [
		"Tourne avec l'eau qui tombe, lentement mais sûrement.",
		"Comment : huit planches autour d'un Arbre. Il faut un courant d'eau à côté."
	]
	quest.42000000001C0421.title: "Roue à aubes (Horlogerie)"
	quest.42000000001C0422.quest_desc: [
