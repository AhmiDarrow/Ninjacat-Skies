	quest.42000000001903A9.quest_desc: [
		"Fait éclore des larves d'abeille en nouvelles abeilles aux traits utiles.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903A9.title: "Incubateur (Rucher)"
	quest.42000000001903AA.quest_desc: [
		"Accouple deux abeilles et produit une descendance aux traits mélangés.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903AA.title: "Chambre d'élevage (Rucher)"
	quest.42000000001903AB.quest_desc: [
		"Lit les traits d'une abeille et les note pour l'élevage.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903AB.title: "Indexeur de gènes (Rucher)"
	quest.42000000001903AC.quest_desc: [
		"Brûle du miel pour un filet d'énergie lent et régulier.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903AC.title: "Générateur de miel (Rucher)"
	quest.42000000001903AD.quest_desc: [
		"Un en-cas qui garde une abeille en cage calme et en bonne santé.",
		"Comment : rayon de miel plus une fiole de miel, sans forme."
	]
	quest.42000000001903AD.title: "Friandise au miel (Rucher)"
	quest.42000000001903AE.quest_desc: [
		"Un seau plein de miel, prêt à verser ou à brûler.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903AE.title: "Seau de miel"
	quest.42000000001903AF.quest_desc: [
		"Fond pour des bougies, ou scelle le cadre d'une ruche.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903AF.title: "Stock de cire"
	quest.42000000001903B0.quest_desc: [
		"Un rayon de miel qu'on peut régler pour n'importe quelle abeille.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903B0.title: "Rayon configurable"
	quest.42000000001903B1.quest_desc: [
		"Les traits d'une abeille, extraits et prêts à mettre en fiole.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903B1.title: "Échantillon de gène"
	quest.42000000001903B2.quest_desc: [
		"La génétique d'une abeille, gardée pour un élevage plus tard.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903B2.title: "Fiole de gènes"
	quest.42000000001903B3.quest_desc: [
		"Quatre rayons pressés en bloc, surtout pour bâtir.",
		"Comment : quatre rayons de miel."
	]
	quest.42000000001903B3.title: "Bloc de rayon de miel"
	quest.42000000001903B4.quest_desc: [
		"Ralentit les chutes et le déplacement. Collant sous les pieds, sucré dans un entonnoir.",
		"Comment : quatre fioles de miel. Les fioles reviennent."
	]
	quest.42000000001903B4.title: "Bloc de miel (rucher)"
	quest.42000000001903B5.quest_desc: [
		"Une ruche sauvage. Enfume-la pour la calmer avant de prendre le rayon.",
		"Comment : trois rayons de miel et six planches. Un feu de camp en dessous les calme."
	]
	quest.42000000001903B5.title: "Ruche de base"
	quest.42000000001903B6.quest_desc: [
		"La fumée par en dessous garde les abeilles calmes pendant la récolte.",
		"Comment : bûches, bâtons, et charbon ou charbon de bois."
	]
	quest.42000000001903B6.title: "Feu de camp en dessous"
	quest.42000000001903B7.quest_desc: [
		"Des fleurs pour le travail des abeilles.",
		"Comment : poudre d'os sur l'herbe, ou une petite fleur pour le nid de chêne."
	]
	quest.42000000001903B7.title: "Tapis de fleurs"
	quest.42000000001903B8.quest_desc: [
		"Plus de fleurs à proximité, plus de pollen pour la ruche.",
		"Comment : poudre d'os sur l'herbe. Les abeilles veulent n'importe quelle petite fleur."
	]
	quest.42000000001903B8.title: "Champ de pissenlits"
	quest.42000000001903B9.quest_desc: [
		"Une fleur plus voyante, que certaines abeilles préfèrent aux pissenlits.",
		"Comment : mousse plus chêne, ou de la poudre d'os sur la mousse. Les abeilles acceptent la fleur."
	]
	quest.42000000001903B9.title: "Floraison d'azalée"
	quest.42000000001903BA.quest_desc: [
		"Un fruit de l'End que certaines abeilles butinent de bon cœur.",
		"Comment : étal des Marche-lisières à /clowder hub. Les îles extérieures de l'End ont disparu."
	]
	quest.42000000001903BA.title: "Encas chorus"
	quest.42000000001903BB.quest_desc: [
		"Un favori étrange pour quelques-unes des abeilles les plus coriaces.",
		"Comment : de l'eau sur une source de lave (ou de la lave sur l'eau). Garde la source de lave."
	]
	quest.42000000001903BB.title: "Friandise d'obsidienne"
	quest.42000000001903BC.quest_desc: [
		"Plus de chambres pour la ruche, taillées dans du bouleau cette fois.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903BC.title: "Extension en bouleau"
	quest.42000000001903BD.quest_desc: [
		"Des chambres lambrissées de sapin, boulonnées à la ruche.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903BD.title: "Extension en sapin"
	quest.42000000001903BE.quest_desc: [
		"Lambris de chêne noir, même but : plus de chambres pour les abeilles.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903BE.title: "Extension en chêne noir"
	quest.42000000001903BF.quest_desc: [
		"Des chambres en acacia pour une ruche devenue trop grande pour elle-même.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903BF.title: "Extension en acacia"
	quest.42000000001903C0.quest_desc: [
		"Des chambres en acajou, aussi spacieuses que les autres.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903C0.title: "Extension en acajou"
	quest.42000000001903C1.quest_desc: [
		"Des chambres lambrissées de cerisier, pure affaire de style.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903C1.title: "Extension en cerisier"
	quest.42000000001903C2.quest_desc: [
		"Des chambres lambrissées de carmin pour une ruche passée au Nether.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903C2.title: "Extension carmin"
	quest.42000000001903C3.quest_desc: [
		"Des chambres lambrissées de bois biscornu, la moitié bleue de la paire.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903C3.title: "Extension biscornue"
	quest.42000000001903C4.quest_desc: [
		"Des chambres de bambou, plus légères et tout aussi pratiques.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903C4.title: "Extension en bambou"
	quest.42000000001903C5.quest_desc: [
		"Des chambres de palétuvier, le bois le plus récent de la liste.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.42000000001903C5.title: "Extension en palétuvier"
	quest.42000000001903C6.quest_desc: [
		"Du miel que tu bois à même la fiole.",
		"Comment : fiole en verre sur une ruche pleine. Feu de camp en dessous."
	]
	quest.42000000001903C6.title: "Stock de fioles de miel"
	quest.42000000001903C7.quest_desc: [
		"Se fabrique en friandises et gâteaux pour un Clowder affamé.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001903C7.title: "Stock de sucre"
	quest.42000000001903C8.quest_desc: [
		"Vides, en attente de miel, de potions ou d'expérience.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001903C8.title: "Stock de fioles"
	quest.42000000001903C9.quest_desc: [
		"Une paire de rechange pour couper le rayon sans blesser les abeilles.",
		"Comment : deux lingots de fer en diagonale. Tonds moutons et nids d'abeilles."
	]
	quest.42000000001903C9.title: "Cisailles de rechange"
	quest.42000000001A03CA.quest_desc: [
		"Un bloc qui envoie les objets là où tu lui dis — le système nerveux de la plateforme.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : lingots de fer et barreaux de fer autour d'un module vierge ; ça en donne quatre. Les modules vont dans le routeur."
	]
	quest.42000000001A03CA.title: "Routeur modulaire"
	quest.42000000001A03CB.quest_desc: [
		"La carte sur laquelle s'écrit chaque comportement du routeur.",
		"Comment : Routeur modulaire plus modules vierges dans JEI. Extracteur/émetteur/briseur se placent dans le routeur."
	]
	quest.42000000001A03CB.title: "Module vierge"
	quest.42000000001A03CC.quest_desc: [
		"Tire des objets d'un voisin vers le routeur.",
		"Comment : Routeur modulaire plus modules vierges dans JEI. Extracteur/émetteur/briseur se placent dans le routeur."
	]
	quest.42000000001A03CC.title: "Module tireur"
	quest.42000000001A03CD.quest_desc: [
		"Pousse les objets vers un point marqué, de l'autre côté de la plateforme.",
		"Comment : Routeur modulaire plus modules vierges dans JEI. Extracteur/émetteur/briseur se placent dans le routeur."
	]
	quest.42000000001A03CD.title: "Module émetteur"
	quest.42000000001A03CE.quest_desc: [
		"Casse un bloc devant le routeur et garde ce qui tombe.",
		"Comment : Routeur modulaire plus modules vierges dans JEI. Extracteur/émetteur/briseur se placent dans le routeur."
	]
	quest.42000000001A03CE.title: "Module disjoncteur"
	quest.42000000001A03CF.quest_desc: [
		"Place un bloc là où pointe le routeur.",
		"Comment : Routeur modulaire plus modules vierges dans JEI. Extracteur/émetteur/briseur se placent dans le routeur."
	]
	quest.42000000001A03CF.title: "Module de placement"
	quest.42000000001A03D0.quest_desc: [
		"Émets de la redstone quand le contenu du routeur franchit un seuil.",
		"Comment : Routeur modulaire plus modules vierges dans JEI. Extracteur/émetteur/briseur se placent dans le routeur."
	]
	quest.42000000001A03D0.title: "Module détecteur"
	quest.42000000001A03D1.quest_desc: [
		"Porte les objets entre coffres, machines et plateformes.",
		"Comment : fer + redstone. Règle les faces avec la clé Pipez."
	]
	quest.42000000001A03D1.title: "Tuyau d'item"
	quest.42000000001A03D2.quest_desc: [
		"Porte les liquides entre réservoirs et machines, sans course au seau.",
		"Comment : fer + seaux + redstone. Utilisation accroupie de la clé sur un côté pour extraire ; clic droit sur ce côté pour les filtres."
	]
	quest.42000000001A03D2.title: "Tuyau de fluide"
	quest.42000000001A03D3.quest_desc: [
		"Porte l'énergie entre les machines qui la font et celles qui en ont besoin.",
		"Comment : fer + redstone. Porte des FE entre les machines."
	]
	quest.42000000001A03D3.title: "Tuyau d'énergie"
	quest.42000000001A03D4.quest_desc: [
		"Porte les produits chimiques entre les machines qui les traitent.",
		"Comment : tuyaux de fer + redstone dans JEI. Utilisation accroupie de la clé pour régler les côtés d'extraction ; clic droit sur l'un pour les filtres. Le chapitre des tuyaux est toute l'échelle."
	]
	quest.42000000001A03D4.title: "Tuyau de gaz"
	quest.42000000001A03D5.quest_desc: [
		"Un tuyau, plein de tâches.",
		"Comment : tuyaux de fer + redstone dans JEI. Utilisation accroupie de la clé pour régler les côtés d'extraction ; clic droit sur l'un pour les filtres. Le chapitre des tuyaux est toute l'échelle."
	]
	quest.42000000001A03D5.title: "Tuyau universel"
	quest.42000000001A03D6.quest_desc: [
		"Utilise accroupi un côté du tuyau pour qu'il tire d'une machine, ou pour le couper.",
		"Comment : deux silex et deux bâtons. Utilisation accroupie d'un côté de tuyau sur une machine pour qu'il extraie, encore une fois pour le couper ; clic droit sur un côté qui extrait pour les filtres."
	]
	quest.42000000001A03D6.title: "Clé à pipe"
	quest.42000000001A03D7.quest_desc: [
		"Amélioration de vitesse pour un tuyau.",
		"Comment : tuyaux de fer + redstone dans JEI. Utilisation accroupie de la clé pour régler les côtés d'extraction ; clic droit sur l'un pour les filtres. Le chapitre des tuyaux est toute l'échelle."
	]
	quest.42000000001A03D7.title: "Amélioration basique"
	quest.42000000001A03D8.quest_desc: [
		"Insère-la dans un tuyau pour en bouger plus par tick.",
		"Comment : tuyaux de fer + redstone dans JEI. Utilisation accroupie de la clé pour régler les côtés d'extraction ; clic droit sur l'un pour les filtres. Le chapitre des tuyaux est toute l'échelle."
	]
	quest.42000000001A03D8.title: "Amélioration améliorée"
	quest.42000000001A03D9.quest_desc: [
		"Une amélioration plus solide, pour une ligne sous forte charge.",
		"Comment : tuyaux de fer + redstone dans JEI. Utilisation accroupie de la clé pour régler les côtés d'extraction ; clic droit sur l'un pour les filtres. Le chapitre des tuyaux est toute l'échelle."
	]
	quest.42000000001A03D9.title: "Amélioration avancée"
	quest.42000000001A03DA.quest_desc: [
		"Le plus haut palier de débit Pipez.",
		"Comment : tuyaux de fer + redstone dans JEI. Utilisation accroupie de la clé pour régler les côtés d'extraction ; clic droit sur l'un pour les filtres. Le chapitre des tuyaux est toute l'échelle."
	]
	quest.42000000001A03DA.title: "Amélioration ultime"
	quest.42000000001A03DB.quest_desc: [
		"Retire les plafonds de débit de Pipez.",
		"Comment : créatif seulement ; Pipez n'a aucune recette de survie pour ça. Facultatif."
	]
	quest.42000000001A03DB.title: "Amélioration infinie"
	quest.42000000001A03DC.quest_desc: [
		"Règle quels objets un bout de tuyau accepte ou ignore.",
		"Comment : tuyaux de fer + redstone dans JEI. Utilisation accroupie de la clé pour régler les côtés d'extraction ; clic droit sur l'un pour les filtres. Le chapitre des tuyaux est toute l'échelle."
	]
	quest.42000000001A03DC.title: "Outil filtre"
	quest.42000000001A03DD.quest_desc: [
		"Le déménageur d'origine. Lent, bon marché, et toujours utile.",
		"Comment : cinq fers autour d'un coffre. Pose-le sous un Cadre de métier ou un Tonneau de tension (extraction vers le BAS)."
	]
	quest.42000000001A03DD.title: "Entonnoir de rechange (Tuyaux)"
	quest.42000000001A03DE.quest_desc: [
		"Ligne de droppers pour la logistique.",
		"Comment : de la roche autour de redstone."
	]
	quest.42000000001A03DE.title: "Ligne de droppers"
	quest.42000000001A03DF.quest_desc: [
		"Tire ou place ce qui est chargé dès qu'il reçoit un signal.",
		"Comment : roche, arc et redstone."
	]
	quest.42000000001A03DF.title: "Ligne de distributeurs"
	quest.42000000001A03E0.quest_desc: [
		"Lit le remplissage d'un conteneur et sort un signal.",
		"Comment : quartz du Nether, torche de redstone, pierre. Le quartz se tamise dans le sable des âmes ; pas besoin d'un voyage au Nether."
	]
	quest.42000000001A03E0.title: "Comparateur (Tuyaux)"
	quest.42000000001A03E1.quest_desc: [
		"L'observateur lit le rythme.",
		"Comment : roche, redstone et quartz du Nether."
	]
	quest.42000000001A03E1.title: "Ligne d'observateurs"
	quest.42000000001A03E2.quest_desc: [
		"Une source de signal toujours allumée, ou un inverseur à côté d'un levier.",
		"Comment : de la redstone sur un bâton."
	]
	quest.42000000001A03E2.title: "Torche de redstone"
	quest.42000000001A03E3.quest_desc: [
		"Le répéteur cadence le circuit.",
		"Comment : torche de redstone, redstone, pierre. Le chapitre des tuyaux s'en sert pour les horloges."
	]
	quest.42000000001A03E3.title: "Répéteur (Tuyaux)"
	quest.42000000001A03E4.quest_desc: [
		"Frappé par un projectile, il envoie un signal selon la force.",
		"Comment : redstone autour du foin. Le foin, c'est trois blés."
	]
	quest.42000000001A03E4.title: "Cible"
	quest.42000000001A03E5.quest_desc: [
		"Lit le ciel et signale selon la lumière ou l'heure.",
		"Comment : verre, quartz du Nether, dalles de bois."
	]
	quest.42000000001A03E5.title: "Capteur de lumière du jour (Tuyaux)"
	quest.42000000001A03E6.quest_desc: [
		"Tient un livre et signale quand on tourne une page.",
		"Comment : des dalles de bois autour d'une bibliothèque."
	]
	quest.42000000001A03E6.title: "Pupitre (Tuyaux)"
	quest.42000000001A03E7.quest_desc: [
		"Signale tant qu'il est ouvert, comme un coffre avec un fil-piège.",
		"Comment : un crochet de fil-piège plus un coffre."
	]
	quest.42000000001A03E7.title: "Coffre piégé"
	quest.42000000001A03E8.quest_desc: [
		"Charge un tapis, ou en retire les objets, selon le sens.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.42000000001A03E8.title: "Entonnoir Create"
	quest.42000000001A03E9.quest_desc: [
		"Un entonnoir capable de filtrer ce qu'il déplace.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.42000000001A03E9.title: "Entonnoir de laiton"
	quest.42000000001A03EA.quest_desc: [
		"Laisse tomber les objets tout droit, d'un étage à l'autre.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.42000000001A03EA.title: "Goulotte (Tuyaux)"
	quest.42000000001A03EB.quest_desc: [
		"Une goulotte qui peut filtrer les objets et les retenir.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.42000000001A03EB.title: "Chute intelligente"
	quest.42000000001A03EC.quest_desc: [
		"Trie et déplace les objets, avec une priorité réglable par face.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000001A03EC.title: "Logistique Mek"
	quest.42000000001A03ED.quest_desc: [
		"Déplace les fluides sous pression, donc ils montent aussi bien qu'ils descendent.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000001A03ED.title: "Tuyau Mek"
	quest.42000000001A03EE.quest_desc: [
		"Porte l'énergie entre les machines, avec plusieurs paliers de débit.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000001A03EE.title: "Câble Mek"
	quest.42000000001A03EF.quest_desc: [
		"Déplace les produits chimiques et les gaz dans une ligne étanche.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000001A03EF.title: "Tube Mek"
	quest.42000000001A03F0.quest_desc: [
		"Une ligne plus rapide pour déplacer les objets sur une plateforme affairée.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000001A03F0.title: "Transporteur avancé"
	quest.42000000001A03F1.quest_desc: [
		"Encore plus rapide, pour un réseau qui a dépassé les bases.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000001A03F1.title: "Transporteur d'élite"
	quest.42000000001A03F2.quest_desc: [
		"La ligne d'objets la plus rapide, pour une plateforme au maximum.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000001A03F2.title: "Transporteur ultime"
	quest.42000000001A03F3.quest_desc: [
		"La ligne d'énergie au plus haut débit, pour les salles de machines lourdes.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000001A03F3.title: "Câble ultime"
	quest.42000000001B03F4.quest_desc: [
		"Liste chaque esprit que tu peux lier, et ce qu'il lui faut.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : un livre et des Graines de rêve de démon, sans forme. Lis-le ; le Feu spirituel vient ensuite."
	]
	quest.42000000001B03F4.title: "Dictionnaire des esprits"
	quest.42000000001B03F5.quest_desc: [
		"Brûle en violet et ne se propage jamais. Sert à allumer les rituels.",
		"Comment : allume le Feu spirituel comme le montre le Dictionnaire des esprits (Ça brûle !), puis jette de l'andésite dedans."
	]
	quest.42000000001B03F5.title: "Feu des esprits (Outremonde)"
	quest.42000000001B03F6.quest_desc: [
		"Pointe vers le minerai enfoui ou les structures cachées tout près.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03F6.title: "Bâton de divination"
	quest.42000000001B03F7.quest_desc: [
		"Efface la craie rituelle du sol quand tu as fini.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03F7.title: "Brosse"
	quest.42000000001B03F8.quest_desc: [
		"Devient un arbre qui n'appartient pas à ce monde.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03F8.title: "Jeune pousse de l'Autre Monde"
	quest.42000000001B03F9.quest_desc: [
		"Bois d'un arbre étranger, utilisé dans les rituels de liaison.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03F9.title: "Bûche de l'Autre Monde"
	quest.42000000001B03FA.quest_desc: [
		"Tient une offrande le temps d'un rituel de liaison.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03FA.title: "Bol sacrificiel"
	quest.42000000001B03FB.quest_desc: [
		"Un bol doré qui accélère le rituel dans lequel il sert.",
		"Comment : de l'or autour d'un bol sacrificiel. Le dictionnaire nomme le rituel."
	]
	quest.42000000001B03FB.title: "Bol d'or"
	quest.42000000001B03FC.quest_desc: [
		"Un contrat non signé, qui attend le nom d'un esprit.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03FC.title: "Livre de liaison vide"
	quest.42000000001B03FD.quest_desc: [
		"Lie la classe d'esprit la plus faible, un bon premier essai.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03FD.title: "Livre de Foliot"
	quest.42000000001B03FE.quest_desc: [
		"Lie un esprit de force moyenne, un travail plus fort qu'un foliot.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03FE.title: "Livre de Djinni"
	quest.42000000001B03FF.quest_desc: [
		"Lie un esprit farouche. Le rituel demande plus de préparation.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B03FF.title: "Livre de Afrit"
	quest.42000000001B0400.quest_desc: [
		"Lie l'esprit le plus fort du dictionnaire.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B0400.title: "Livre de Marid"
	quest.42000000001B0401.quest_desc: [
		"Un focus qui aide un rituel à garder sa forme.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B0401.title: "Gemme accordée à l'esprit"
	quest.42000000001B0402.quest_desc: [
		"Minerai d'au-delà de ce monde, fondu en Iesnium.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B0402.title: "Brut Iesnium"
	quest.42000000001B0403.quest_desc: [
		"Un métal qui n'existe que de l'autre côté.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B0403.title: "L'ingot d'Iesnium "
	quest.42000000001B0404.quest_desc: [
		"Envoie des mineurs spirituels liés dans l'Outremonde, pour creuser.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B0404.title: "Mineshaft dimensionnelles"
	quest.42000000001B0405.quest_desc: [
		"L'esprit le plus faible, mis à miner sous terre.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B0405.title: "Mineur Foliot"
	quest.42000000001B0406.quest_desc: [
		"Relie les jarres de stockage d'esprits en un seul réseau consultable.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B0406.title: "Contrôleur de stockage (Outremonde)"
	quest.42000000001B0407.quest_desc: [
		"Attire certains esprits vers un cercle rituel.",
		"Comment : tamis, ou améthyste bourgeonnante si tu fais pousser une ligne de géodes. Occultism veut des éclats."
	]
	quest.42000000001B0407.title: "Focalisateur d'améthyste"
	quest.42000000001B0408.quest_desc: [
		"Fond pour des bols dorés et d'autre matériel rituel.",
		"Comment : fais fondre de l'or brut / du gravillon d'or. Prise de tamis plus rare."
	]
	quest.42000000001B0408.title: "Stock de lingot d'or"
	quest.42000000001B0409.quest_desc: [
		"Pages blanches, prêtes à devenir un livre de liaison.",
		"Comment : trois papiers plus du cuir. Le papier, c'est de la canne à sucre."
	]
	quest.42000000001B0409.title: "Stock de livres"
	quest.42000000001B040A.quest_desc: [
		"Teint la craie rituelle pour marquer un cercle d'invocation.",
		"Comment : bleu plus rouge, ou une fleur violette. Occultism en veut."
	]
	quest.42000000001B040A.title: "Teinture violette"
	quest.42000000001B040B.quest_desc: [
		"Teint la craie rituelle, une marque plus simple que le violet.",
		"Comment : poudre d'os dans une grille, ou une fleur blanche."
	]
	quest.42000000001B040B.title: "Teinture blanche"
	quest.42000000001B040C.quest_desc: [
		"Teint la craie rituelle pour un cercle plus sombre.",
		"Comment : charbon de bois ou une poche d'encre (charbon de bois plus une bouteille en verre)."
	]
	quest.42000000001B040C.title: "Teinture noire"
	quest.42000000001B040D.quest_desc: [
		"Sol rituel, d'une texture que les rituels semblent aimer.",
		"Comment : du sable dans un tonneau d'Ex Deorum d'eau de sorcière. Les salles à verrues de la forteresse en gardent un peu. Trois crânes sur du sable des âmes font un Wither."
	]
	quest.42000000001B040D.title: "Réserve de sable des âmes (Autre-monde)"
	quest.42000000001B040E.quest_desc: [
		"Une couche de base pour les rituels qui penchent vers le feu.",
		"Comment : le Nether ici est le vide, pas un terrain. Verse de la lave dans un tonneau d'Ex Deorum d'eau de sorcière (un tonneau d'eau posé sur du mycélium ; les spores de mycélium se tamisent depuis la terre)."
	]
	quest.42000000001B040E.title: "Stock de Netherrack (Autre-monde)"
	quest.42000000001B040F.quest_desc: [
		"Un cadre sombre et stable pour un cercle rituel.",
		"Comment : de l'eau sur une source de lave (ou de la lave sur l'eau). Garde la source de lave."
	]
	quest.42000000001B040F.title: "Stock d'obsidienne (Autre-monde)"
	quest.42000000001B0410.quest_desc: [
		"Une offrande vers laquelle certains esprits sont attirés.",
		"Comment : endermen, ou l'étal des Marche-lisières à /clowder hub."
	]
	quest.42000000001B0410.title: "Stock de perles de l'Ender (Autre-monde)"
	quest.42000000001B0411.quest_desc: [
		"Une offrande de grande valeur pour un rituel exigeant.",
		"Comment : tamise le gravier avec une maille de fer ou mieux, ou du minerai de diamant au Bris d'écho."
	]
	quest.42000000001B0411.title: "Stock de diamants"
	quest.42000000001B0412.quest_desc: [
		"Un livre de liaison avec un foliot déjà scellé dedans.",
		"Comment : Dictionnaire des esprits, puis Feu des esprits et des bols. Le chapitre Outremonde nomme les rites."
	]
	quest.42000000001B0412.title: "Livre lié de Foliot"
