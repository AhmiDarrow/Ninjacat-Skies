{
	chapter.3100000000000001.chapter_subtitle: [
		"Réveille-toi — survis, prends la plateforme, laisse le Codex s'éveiller."
	]
	chapter.3100000000000001.title: "Brin : Terre"
	chapter.3100000000000002.chapter_subtitle: [
		"Récupère — ramène le monde tombé dans la matière."
	]
	chapter.3100000000000002.title: "Brin : Pierre"
	chapter.3100000000000003.chapter_subtitle: [
		"Enracine — fais pousser des ancres pour que la plateforme cesse de s'effilocher."
	]
	chapter.3100000000000003.title: "Brin : Pousse"
	chapter.3100000000000004.chapter_subtitle: [
		"Lisière — équipe-toi et quitte la plateforme exprès."
	]
	chapter.3100000000000004.title: "Brin : Griffe"
	chapter.3100000000000005.chapter_subtitle: [
		"Bourdonne — le rythme et la pulsation avant les fils."
	]
	chapter.3100000000000005.title: "Brin : Étincelle"
	chapter.3100000000000006.chapter_subtitle: [
		"Motif — une usine comme un chant qui se porte seul."
	]
	chapter.3100000000000006.title: "Brin : Horloge"
	chapter.3100000000000007.chapter_subtitle: [
		"Colonie — garde en vie quelque chose qui garde autre chose en vie."
	]
	chapter.3100000000000007.title: "Brin : Essaim"
	chapter.3100000000000008.chapter_subtitle: [
		"Lie — des sceaux, des rites, et deux sentiers de tresse dans un cordon."
	]
	chapter.3100000000000008.title: "Brin : Sceau"
	chapter.3100000000000009.chapter_subtitle: [
		"Retisse — le métier numérique, la Marche, le Fragment."
	]
	chapter.3100000000000009.title: "Brin : Fuseau"
	chapter.310000000000000A.title: "Tamis profond"
	chapter.310000000000000B.title: "Stockage et sacs"
	chapter.310000000000000C.title: "Ateliers Mekanism"
	chapter.310000000000000D.title: "Réseau Powah"
	chapter.310000000000000E.title: "Côté arcanique"
	chapter.310000000000000F.chapter_subtitle: [
		"Équipes, la Salle, le Poteau et l'Effilochure."
	]
	chapter.310000000000000F.title: "Salle Clowder"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Ligne de cuisine"
	chapter.3100000000000013.title: "Sorts de bataille"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Décor de plateforme"
	chapter.3100000000000016.title: "Prise dans le Nether"
	chapter.3100000000000017.title: "Prise dans l'End"
	chapter.3100000000000018.title: "Champs d'essence"
	chapter.3100000000000019.chapter_subtitle: [
		"Chaque nid est un anneau de quelque chose autour d'une fleur."
	]
	chapter.3100000000000019.title: "Rucher de l'Essaim"
	chapter.310000000000001A.title: "Tuyauterie"
	chapter.310000000000001B.title: "Autre-monde"
	chapter.310000000000001C.title: "Horlogerie profonde"
	chapter.310000000000001D.title: "Réseau du Fuseau"
	chapter.310000000000001E.title: "Artisanat du vide"
	chapter.310000000000001F.title: "Lignes emballées"
	chapter.3100000000000020.title: "QIO et le sommet Mek"
	chapter.3100000000000021.title: "Chasse et ferme"
	chapter.3100000000000022.title: "Tissage tribal"
	chapter.3100000000000023.chapter_subtitle: [
		"Les Chanteurs de gravier taillent une pierre de cent façons."
	]
	chapter.3100000000000023.title: "Tailleur de pierre"
	chapter.3100000000000024.chapter_subtitle: [
		"Une plateforme n'est qu'une corniche tant que personne n'y pose une chaise."
	]
	chapter.3100000000000024.title: "Ameublement"
	chapter.3100000000000025.chapter_subtitle: [
		"Les petites machines que les intendants ont laissées."
	]
	chapter.3100000000000025.title: "Petites intendances"
	chapter.3100000000000026.chapter_subtitle: [
		"La pulsation des Cœurs-tambours apprend à courir dans le cuivre."
	]
	chapter.3100000000000026.title: "Le courant"
	chapter.3100000000000027.chapter_subtitle: [
		"La Coupe a rompu treize gardiens. Retends chaque Brin en battant son gardien."
	]
	chapter.3100000000000027.title: "Gardiens rompus"
	chapter.3100000000000028.chapter_subtitle: [
		"Marche la Marche. Apprivoise un jaune. Esther t'attend à la Salle une fois que tu y es allé."
	]
	chapter.3100000000000028.title: "Coureurs de plateforme"
	chapter.3100000000000029.chapter_subtitle: [
		"Jardins issus du tamis. Cuisine ce qu'une plateforme du vide n'a jamais fait pousser."
	]
	chapter.3100000000000029.title: "Table des récoltes"
	chapter.310000000000002A.chapter_subtitle: [
		"Bâtons de culture, statistiques, irrigation. Sur une corniche, les mauvaises herbes ne prennent pas."
	]
	chapter.310000000000002A.title: "Bâtons de culture"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Fabriquer et tension"
	chapter_group.2100000000000003.title: "Retisser"
	chapter_group.2100000000000004.title: "Chemins de côté"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"Tu t'es réveillé sur une corniche. Regarde le vide, puis clique ici.",
		"L'accent grave (`) est la liste des tâches. Le Codex des Moustaches, c'est Commence ici.",
		"Comment : clique la quête. Puis frappe le chêne."
	]
	quest.4200000000018001.title: "Regarde le vide"
	quest.4200000000010001.quest_desc: [
		"Tu es Skybound. Voici ce qui n'est pas tombé.",
		"Huit bûches. Commence par l'arbre ; c'est lui qui a commencé avec toi.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : frappe le chêne sur ta plateforme. Huit bûches lancent Éveil."
	]
	quest.4200000000010001.title: "Éveil sur une plateforme"
	quest.4200000000010002.quest_desc: [
		"La terre est une promesse que la plateforme fait à tes bottes.",
		"Seize blocs. Élargis la promesse.",
		"Comment : coffre de départ, puits roche+fil, restes du tamis, ou /clowder hub (Gardiens de la plateforme)."
	]
	quest.4200000000010002.title: "De quoi poser le pied"
	quest.4200000000010003.quest_desc: [
		"Les mains ont besoin d'une surface. Tout ce qui vient après est une surface.",
		"Comment : quatre planches en carré."
	]
	quest.4200000000010003.title: "Fabrique un établi"
	quest.4200000000010004.quest_desc: [
		"Griffe viendra plus tard. Pour l'instant, du bois qui mord.",
		"Comment : trois planches sur deux bâtons."
	]
	quest.4200000000010004.title: "Pioche en bois"
	quest.4200000000010005.quest_desc: [
		"Du vert face au vide.",
		"Plante-le avant d'avoir faim.",
		"Comment : casse des feuilles de chêne, ou /clowder hub Lie-racines (8 Fil pour quatre)."
	]
	quest.4200000000010005.title: "Première pousse"
	quest.4200000000010006.quest_desc: [
		"Soixante-quatre planches, c'est une plateforme qui cesse de ressembler à une corniche.",
		"Comment : une bûche dans la grille de fabrication en fait quatre."
	]
	quest.4200000000010006.title: "Stock de planches"
	quest.4200000000010007.quest_desc: [
		"Manches, cadres, les os des outils.",
		"Comment : deux planches en colonne."
	]
	quest.4200000000010007.title: "Botte de bâtons"
	quest.4200000000010008.quest_desc: [
		"Pose les choses là où elles restent. Un Clowder partage un coffre avant de partager quoi que ce soit d'autre.",
		"Comment : huit planches autour d'un centre vide."
	]
	quest.4200000000010008.title: "Coffre pour le Clowder"
	quest.4200000000010009.quest_desc: [
		"Vois le bord avant que le bord te voie.",
		"Comment : charbon ou charbon de bois sur un bâton. Les Proches de /clowder hub vendent un paquet."
	]
	quest.4200000000010009.title: "Ligne de torches"
	quest.420000000001000A.quest_desc: [
		"La glace et la lave font de la pierre là où il n'y en avait pas.",
		"Les plateformes Normal et Difficile livrent les deux. Les Gardiens de la plateforme à /clowder hub vendent un seau.",
		"Comment : lave à côté de l'eau (ou glace fondue). Martèle la pierre. L'étal des Chanteurs de gravier à /clowder hub vend un lot."
	]
	quest.420000000001000A.title: "Réserve de roche"
	quest.420000000001000B.quest_desc: [
		"Une chaleur qui n'est pas encore Étincelle.",
		"Les Gardiens de la plateforme auraient appelé ça un foyer.",
		"Comment : huit roches autour d'un centre vide."
	]
	quest.420000000001000B.title: "Chaleur du fourneau"
	quest.420000000001000C.quest_desc: [
		"La faim est un vide doux. Huit pains le ferment un moment.",
		"Comment : trois blés en ligne, ou /clowder hub Gardien du foyer."
	]
	quest.420000000001000C.title: "Cuis un repas"
	quest.420000000001000D.quest_desc: [
		"Pose de la lave, fais fondre la glace en une source, remplis le seau.",
		"Facile livre l'eau ; Normal et Difficile livrent les pièces.",
		"Comment : seau vide sur une source d'eau. Normal/Difficile : pose la lave, fais fondre la glace, remplis."
	]
	quest.420000000001000D.title: "Attrape la pluie"
	quest.420000000001000E.quest_desc: [
		"Des chutes du Métier à tisser qui tiennent encore. Chaque quête en rend un peu.",
		"Détisse-en un pour de la ficelle, ou dépense-les aux étals des Proches dans /clowder hub.",
		"Comment : récompenses de quêtes, terre à maille de silex sur un Cadre de métier, caches de l'intendant."
	]
	quest.420000000001000E.title: "Monnaie effilochée"
	quest.420000000001000F.quest_desc: [
		"Abîmé, mais il enseigne encore. Ouvre Commence ici.",
		"Clic droit sur le livre et ouvre Commence ici. Accent grave (`) : la liste des tâches.",
		"Comment : kit de départ / coffre du quai. Clic droit sur le livre ; l'accent grave (`) est la liste des tâches."
	]
	quest.420000000001000F.title: "Codex en main"
	quest.4200000000010010.quest_desc: [
		"Pose un point d'apparition.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010010.title: "Lit revendiqué"
	quest.4200000000010011.quest_desc: [
		"Descends dans les profondeurs sans corde. Assez bon marché pour en laisser une dans chaque puits.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010011.title: "Échelle en bas"
	quest.4200000000010012.quest_desc: [
		"Soie d'araignée mise de côté pour les mailles plus tard. Chaque fibre finit par servir.",
		"Comment : détisse le Fil effiloché (1 → 3). Araignées. Peluche du métier sur un Lien d'écho. Dépense inverse du filé."
	]
	quest.4200000000010012.title: "Réserve de ficelle"
	quest.4200000000010013.quest_desc: [
		"Accélère le vert.",
		"Comment : os en grille, ou dépense Fil + chair putréfiée, ou /clowder hub Gardiens de la plateforme."
	]
	quest.4200000000010013.title: "Stock de poudre d'os"
	quest.4200000000010014.quest_desc: [
		"Élargis la plateforme.",
		"Comment : coffre de départ, puits roche+fil, restes du tamis, ou /clowder hub (Gardiens de la plateforme)."
	]
	quest.4200000000010014.title: "Plateforme de terre"
	quest.4200000000010015.quest_desc: [
		"Taille-les maintenant, composte-les plus tard. Sur une plateforme, rien ne se perd.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010015.title: "Feuilles de chêne"
	quest.4200000000010016.quest_desc: [
		"Un coin tranquille.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010016.title: "Pot de fleurs"
	quest.4200000000010017.quest_desc: [
		"Le tonneau d'Ex Deorum : compost, et l'eau en argile, lentement.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010017.title: "Tonneau"
	quest.4200000000010018.quest_desc: [
		"Déchet en poudre.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010018.title: "Composteur"
	quest.4200000000010019.quest_desc: [
		"Griffe un sillon.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010019.title: "Houe en bois"
	quest.420000000001001A.quest_desc: [
		"Abat les bûches plus vite que les mains nues. Le premier vrai outil qu'un Skybound possède.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001001A.title: "Hache en bois"
	quest.420000000001001B.quest_desc: [
		"Change la terre et le gravier en sol dégagé. Lente, mais elle marche.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001001B.title: "Pelle en bois"
	quest.420000000001001C.quest_desc: [
		"Arrête à peine un zombie, mais elle en arrête un. Mieux que de balancer un poing.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001001C.title: "Épée en bois"
	quest.420000000001001D.quest_desc: [
		"Tient la soupe, le ragoût, et pas grand-chose d'autre. Vaisselle simple pour une plateforme simple.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001001D.title: "Bol"
	quest.420000000001001E.quest_desc: [
		"Étiquette la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001001E.title: "Cadre"
	quest.420000000001001F.quest_desc: [
		"Fais-en un foyer.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001001F.title: "Tableau"
	quest.4200000000010020.quest_desc: [
		"Garde le vent et les monstres du bon côté du mur.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010020.title: "Porte en chêne"
	quest.4200000000010021.quest_desc: [
		"Marque un bord sans boucher la vue. Pratique là où la chute est réelle.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010021.title: "Barrière en chêne"
	quest.4200000000010022.quest_desc: [
		"Change un mur à pic en quelque chose que tu peux vraiment grimper.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010022.title: "Escalier en chêne"
	quest.4200000000010023.quest_desc: [
		"Un demi-bloc, deux fois plus de sols possibles. Utile dans les espaces serrés.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010023.title: "Dalle en chêne"
	quest.4200000000010024.quest_desc: [
		"Trappes d'accès.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010024.title: "Trappe en chêne"
	quest.4200000000010025.quest_desc: [
		"Envoie un signal quand quelque chose marche dessus. Les portes s'ouvrent toutes seules.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010025.title: "Plaque de pression en chêne"
	quest.4200000000010026.quest_desc: [
		"Bouton pour des impulsions de redstone.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010026.title: "Bouton en chêne"
	quest.4200000000010027.quest_desc: [
		"Clôture le bord de la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010027.title: "Portillon en bâtons"
	quest.4200000000010028.quest_desc: [
		"Cuit lentement et laisse la fumée visible à des lieues.",
		"Comment : bûches, bâtons, et charbon ou charbon de bois."
	]
	quest.4200000000010028.title: "Feu de camp"
	quest.4200000000010029.quest_desc: [
		"Accroche de la lumière là où une torche jurerait. Lueur plus chaude, même travail.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010029.title: "Lanterne"
	quest.420000000001002A.quest_desc: [
		"Brûle d'un bleu pâle et empêche presque tout d'apparaître à côté.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001002A.title: "Lanterne des âmes"
	quest.420000000001002B.quest_desc: [
		"Il grimpe avec toi et disparaît quand tu tires dessus. Construire en hauteur n'effraie plus.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001002B.title: "Échafaudage"
	quest.420000000001002C.quest_desc: [
		"Chaîne pour un style suspendu.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001002C.title: "Chaîne"
	quest.420000000001002D.quest_desc: [
		"Mets le bord en cage.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001002D.title: "Barreaux de fer"
	quest.420000000001002E.quest_desc: [
		"Du verre pour les fenêtres de la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001002E.title: "Vitre"
	quest.420000000001002F.quest_desc: [
		"Douce, inflammable et facile à teindre. Toute plateforme finit par avoir besoin d'un lit.",
		"Comment : tonds les moutons après leur avoir donné de l'herbe, ou quatre ficelles."
	]
	quest.420000000001002F.title: "Laine blanche"
	quest.4200000000010030.quest_desc: [
		"Une fine couche de laine pour les sols qui n'ont pas besoin d'un bloc entier.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010030.title: "Tapis blanc"
	quest.4200000000010031.quest_desc: [
		"Apporte un peu de vert et de rose à une plateforme de gravier.",
		"Comment : mousse plus chêne, ou de la poudre d'os sur la mousse. Les abeilles acceptent la fleur."
	]
	quest.4200000000010031.title: "Azalée en fleurs"
	quest.4200000000010032.quest_desc: [
		"S'étend lentement et adoucit l'aspect des plateformes de pierre brute.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010032.title: "Bloc de mousse"
	quest.4200000000010033.quest_desc: [
		"Racines suspendues sous la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010033.title: "Racines suspendues"
	quest.4200000000010034.quest_desc: [
		"S'accroche aux murs et les éclaire sans une seule torche.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010034.title: "Lichen lumineux"
	quest.4200000000010035.quest_desc: [
		"Spéléothème pour un style pointu.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010035.title: "Spéléothème pointu"
	quest.4200000000010036.quest_desc: [
		"De l'améthyste en bloc. Sceau voudra des éclats plus tard.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010036.title: "Bloc d'améthyste"
	quest.4200000000010037.quest_desc: [
		"Neuf lingots pressés ensemble. Il verdit si tu le laisses dehors.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010037.title: "Bloc de cuivre"
	quest.4200000000010038.quest_desc: [
		"Neuf morceaux de fer brut empilés serré, en attente d'un fourneau.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010038.title: "Bloc de fer brut"
	quest.4200000000010039.quest_desc: [
		"Brûle bien plus longtemps que le charbon en vrac. Nourris le fourneau et va-t'en.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000010039.title: "Bloc de charbon"
	quest.420000000001003A.quest_desc: [
		"Nourrit les animaux et ralentit une chute. Les fermiers le gardent près d'eux pour les deux.",
		"Comment : neuf blés. Trois blés font aussi du pain."
	]
	quest.420000000001003A.title: "Meule de foin"
	quest.420000000001003B.quest_desc: [
		"Neuf varechs pressés en combustible. Fond plus que ça n'en a l'air.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001003B.title: "Bloc de varech séché"
	quest.420000000001003C.quest_desc: [
		"Papier et cuir, en attente de devenir quelque chose qui a une recette.",
		"Comment : trois papiers plus du cuir. Le papier, c'est de la canne à sucre."
	]
	quest.420000000001003C.title: "Livre"
	quest.420000000001003D.quest_desc: [
		"Du papier pour les livres et les cartes.",
		"Comment : trois cannes à sucre d'affilée. La canne vient en tamisant de la terre avec une maille de silex ou mieux."
	]
	quest.420000000001003D.title: "Papier"
	quest.420000000001003E.quest_desc: [
		"La teinture et les livres ont besoin d'encre.",
		"Comment : charbon de bois plus une bouteille en verre. Les poulpes n'apparaissent jamais ici."
	]
	quest.420000000001003E.title: "Poche d'encre"
	quest.420000000001003F.quest_desc: [
		"Des plumes pour les flèches et les livres.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000001003F.title: "Plume"
	quest.4200000000010040.quest_desc: [
		"Du cuir pour les livres et les kits.",
		"Comment : fais fondre de la chair putréfiée ou cuis-la au feu de camp. Tamise de la terre avec une maille de silex. /clowder hub Les Gardiens de la plateforme en vendent deux pour 18 Fil."
	]
	quest.4200000000010040.title: "Cuir"
	quest.4200000000010041.quest_desc: [
		"Établi, pousse, foyer, eau, Codex. La plateforme tient.",
		"Tends le Brin : les Gardiens de la plateforme répondent, et le jeton est à toi pour l'asseoir.",
		"Réclame-le et choisis un cadeau de la tribu : un Fil du Retour pour une vie partagée de plus, ou des fournitures.",
		"Comment : termine les quêtes liées à celle-ci, puis réclame-la pour le jeton de Brin. Assieds le jeton à ton Poteau de tension."
	]
	quest.4200000000010041.quest_subtitle: "Éveil"
	quest.4200000000010041.title: "Nœud de Terre"
	quest.4200000000010042.quest_desc: [
		"Clic droit sur le Poteau de tension de ton Clowder avec le jeton.",
		"L'encoche s'allume, la tribu sonne, la plateforme change.",
		"Comment : clic droit sur ton Poteau de tension avec le jeton de Brin en main."
	]
	quest.4200000000010042.title: "Assieds Terre"
	quest.4200000000010043.quest_desc: [
		"Un zombie sur une plateforme sans grottes. Le vide envoie ses salutations.",
		"Éclaire les bords.",
		"Comment : tue un zombie sur la plateforme la nuit. Éclaire les bords."
	]
	quest.4200000000010043.title: "Quelque chose est remonté"
	quest.4200000000020044.quest_desc: [
		"Un Fil qui se souvient d'où il vient.",
		"Détisse le Fil en ficelle ; quatre ficelles filent deux filés.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : quatre ficelles → deux filés. Tonneau de tension : ficelle + perle. Quatre Peluches du métier."
	]
	quest.4200000000020044.title: "Tire l'Écheveau du vide"
	quest.4200000000020045.quest_desc: [
		"Roche et bâtons. Brise le gravillon tombé en gravier, sable et poussière.",
		"Comment : roche + bâtons. Brise le gravillon en gravier, sable et poussière."
	]
	quest.4200000000020045.title: "Marteau à fuseau"
	quest.4200000000020046.quest_desc: [
		"Ficelle autour du filé. Elle attrape ce que le Métier à tisser a lâché — et peigne la Peluche du métier hors de la terre.",
		"Comment : ficelle autour du filé. L'étal des Chanteurs de gravier en vend une."
	]
	quest.4200000000020046.title: "Enfile la maille"
	quest.4200000000020047.quest_desc: [
		"Verse de l'eau ; le seau revient tout de suite. Ajoute de la terre. Attends l'argile.",
		"Ficelle et une perle dans le même tonneau font du filé.",
		"Comment : planches, ficelle et Écheveau du vide. Verse de l'eau (le seau revient), ajoute de la terre → argile."
	]
	quest.4200000000020047.title: "Tonneau de tension"
	quest.4200000000020048.quest_desc: [
		"Seize argiles du tonneau. Charge huit terres à la fois.",
		"Comment : Tonneau de tension — eau + terre. Le Bris d'écho martèle le sable en argile."
	]
	quest.4200000000020048.title: "Poche d'argile"
	quest.4200000000020049.quest_desc: [
		"Argile et poudre d'os. Forme le seau non cuit.",
		"Comment : boule d'argile + poudre d'os, sans forme. L'argile vient du Tonneau de tension."
	]
	quest.4200000000020049.title: "Argile de porcelaine"
	quest.420000000002004A.quest_desc: [
		"Fais-le fondre. La porcelaine porte la lave là où le fer n'est encore qu'une rumeur.",
		"Comment : forme l'argile de porcelaine en un seau non cuit, puis fais-le fondre."
	]
	quest.420000000002004A.title: "Outil de porcelaine"
	quest.420000000002004B.quest_desc: [
		"Les Chanteurs de gravier nommaient chaque éclat d'après son écho.",
		"Tamise jusqu'à entendre le fer.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.420000000002004B.title: "Tamise le gravillon tombé"
	quest.420000000002004C.quest_desc: [
		"Un jeu de coups en réserve.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.420000000002004C.title: "Wooden Hammer"
	quest.420000000002004D.quest_desc: [
		"De la matière tirée du gravillon. Soixante-quatre pierres qui étaient poussière il y a une heure.",
		"Comment : lave à côté de l'eau (ou glace fondue). Martèle la pierre. L'étal des Chanteurs de gravier à /clowder hub vend un lot."
	]
	quest.420000000002004D.title: "Cailloux"
	quest.420000000002004E.quest_desc: [
		"La poussière du Métier à tisser attend dans le gravier. Le silex aussi.",
		"Comment : martèle la roche (Marteau à fuseau ou Bris d'écho)."
	]
	quest.420000000002004E.title: "Chemin de gravier"
	quest.420000000002004F.quest_desc: [
		"Gravillon fin. Le verre plus tard, et la meilleure prise de la maille de fer.",
		"Comment : martèle le gravier."
	]
	quest.420000000002004F.title: "Cache de sable"
	quest.4200000000020050.quest_desc: [
		"Cendre du monde tombé. La redstone et la poudre à canon s'y cachent.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.4200000000020050.title: "Tas de poussière"
	quest.4200000000020051.quest_desc: [
		"Filé autour du slime. Le compost de plateforme fait le slime.",
		"Le Nœud est la porte souple du Métier à tisser ; garde-en deux.",
		"Comment : anneau d'Écheveau du vide autour d'une boule de slime."
	]
	quest.4200000000020051.title: "Noue un Nœud liant"
	quest.4200000000020052.quest_desc: [
		"Des planches autour d'un Nœud. Tends une maille, charge le gravillon, laisse-la travailler.",
		"Les entonnoirs le nourrissent. C'est la première machine de la plateforme.",
		"Comment : planches autour d'un Nœud liant. Tends une maille, verse le gravillon par un entonnoir, pose-le sur un entonnoir."
	]
	quest.4200000000020052.title: "Dresse le Cadre de métier"
	quest.4200000000020053.quest_desc: [
		"Le fer est grave et patient. Huit fragments de la maille.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.4200000000020053.title: "Iron Ore Chunk"
	quest.4200000000020054.quest_desc: [
		"Tamisé du gravier, petit à petit. La maille trouve le cuivre avant tes yeux.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.4200000000020054.title: "Copper Ore Chunk"
	quest.4200000000020055.quest_desc: [
		"L'or se donne à peine la peine de répondre. Quatre suffisent.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.4200000000020055.title: "Gold Ore Chunk"
	quest.4200000000020056.quest_desc: [
		"Alimente la ligne.",
		"Comment : tamise le gravier, ou fais fondre du minerai de charbon."
	]
	quest.4200000000020056.title: "Charbon"
	quest.4200000000020057.quest_desc: [
		"Des fragments au brut. Continue à fondre.",
		"Comment : tamise le gravier pour des fragments de minerai de fer ; quatre font un bloc de minerai de fer, et le miner lâche du fer brut."
	]
	quest.4200000000020057.title: "Fer brut"
	quest.4200000000020058.quest_desc: [
		"Récupération paie. Seize lingots que le vide ne voulait pas te laisser.",
		"Comment : fais fondre du fer brut / du gravillon de fer (fourneau ou Four à braises). Tamise le gravier pour des morceaux."
	]
	quest.4200000000020058.title: "Lingot de fer"
	quest.4200000000020059.quest_desc: [
		"Câble et ampoules, et des résonateurs tribaux plus tard.",
		"Comment : fais fondre du cuivre brut / du gravillon de cuivre. Tamise le gravier."
	]
	quest.4200000000020059.title: "Lingot de cuivre"
	quest.420000000002005A.quest_desc: [
		"Outils dorés, et des plaques d'or pour les Tisserands de motifs.",
		"Comment : fais fondre de l'or brut / du gravillon d'or. Prise de tamis plus rare."
	]
	quest.420000000002005A.title: "Lingot d'or"
	quest.420000000002005B.quest_desc: [
		"Prise plus nette. Les mailles de silex secouent le Fil effiloché hors du gravillon.",
		"Comment : du silex autour d'une maille de Fil (ficelle)."
	]
	quest.420000000002005B.title: "Maille de silex"
	quest.420000000002005C.quest_desc: [
		"Fil métallique pour la poussière plus lourde. Les mailles de fer sont là où tombe le Filament de Brin.",
		"Comment : du fer autour d'une maille de Fil (silex). Le Filament de Brin commence ici."
	]
	quest.420000000002005C.title: "Maille de fer"
	quest.420000000002005D.quest_desc: [
		"Fond et goutte. De la roche à la lave, avec le temps.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.420000000002005D.title: "Creuset"
	quest.420000000002005E.quest_desc: [
		"Le tonneau d'Ex Deorum : compost, et l'eau en argile, lentement.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.420000000002005E.title: "Tonneau (pierre)"
	quest.420000000002005F.quest_desc: [
		"Des coups plus durs, une vie plus longue.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.420000000002005F.title: "Stone Hammer"
	quest.4200000000020060.quest_desc: [
		"Écrase le minerai en gravier et en gravillon, l'astuce bruyante derrière le tamis.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.4200000000020060.title: "Iron Hammer"
	quest.4200000000020061.quest_desc: [
		"Maille plus large, neuf d'un coup.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.4200000000020061.title: "Tamis compressé"
	quest.4200000000020062.quest_desc: [
		"On voit au travers. Du sable au verre.",
		"Comment : fais fondre du sable. Martèle la roche en gravier, le gravier en sable, puis au fourneau."
	]
	quest.4200000000020062.title: "Verre"
	quest.4200000000020063.quest_desc: [
		"Porte la pluie dans du fer, maintenant.",
		"Comment : trois lingots de fer, ou /clowder hub Gardiens de la plateforme (8 Fil). Remplis-le à partir de glace fondue."
	]
	quest.4200000000020063.title: "Seau"
	quest.4200000000020064.quest_desc: [
		"La chaleur du vide, en main.",
		"Comment : creuset de lave Ex Deorum, ou un bassin de lave du Nether après l'obsidienne de Griffe."
	]
	quest.4200000000020064.title: "Seau de lave"
	quest.4200000000020065.quest_desc: [
		"Idées de portail. De l'eau sur une source de lave.",
		"Comment : de l'eau sur une source de lave (ou de la lave sur l'eau). Garde la source de lave."
	]
	quest.4200000000020065.title: "Obsidienne"
	quest.4200000000020066.quest_desc: [
		"Chance rare du gravillon. Deux, c'est un début.",
		"Comment : tamise le gravier avec une maille de fer ou mieux, ou du minerai de diamant au Bris d'écho."
	]
	quest.4200000000020066.title: "Diamant"
	quest.4200000000020067.quest_desc: [
		"Carburant d'amélioration de maille.",
		"Comment : gravier, ou dépense Fil + gravier."
	]
	quest.4200000000020067.title: "Silex"
	quest.4200000000020068.quest_desc: [
		"Faite de gravillon et de poussière, pas ramassée sur un creeper. Manipule-la avec soin.",
		"Comment : tamise de la poussière ou du sable des âmes, ou des creepers sur la plateforme la nuit. Garde les bords éclairés une fois que tu en as."
	]
	quest.4200000000020068.title: "Poudre à canon"
	quest.4200000000020069.quest_desc: [
		"Étincelle en voudra. Garde-le au sec.",
		"Comment : tamise le gravier, ou du minerai de redstone au Bris d'écho après Récupération."
	]
	quest.4200000000020069.title: "Redstone"
	quest.420000000002006A.quest_desc: [
		"Nourrit la table d'enchantement. Poussière bleue qui fait mieux obéir l'équipement.",
		"Comment : tamise le gravier, ou du minerai de lapis-lazuli au Bris d'écho."
	]
	quest.420000000002006A.title: "Lapis-lazuli"
	quest.420000000002006B.quest_desc: [
		"Un mélange de pierre courant, utile surtout pour bâtir et pour mélanger des recettes plus tard.",
		"Comment : tamise des galets de terre/gravier, ou roche plus diorite dans JEI."
	]
	quest.420000000002006B.title: "Andésite"
	quest.420000000002006C.quest_desc: [
		"Pierre mouchetée, plus décorative que structurelle. Les Chanteurs de gravier l'appelaient la bruyante.",
		"Comment : tamise des galets, ou roche plus quartz du Nether."
	]
	quest.420000000002006C.title: "Diorite"
	quest.420000000002006D.quest_desc: [
		"Dense et piquetée de rose, bonne pour un sol qui veut se faire remarquer.",
		"Comment : tamise des galets, ou diorite plus quartz du Nether."
	]
	quest.420000000002006D.title: "Granite"
	quest.420000000002006E.quest_desc: [
		"Roche poreuse de l'autre lieu. Elle brûle sans fin dès qu'elle prend.",
		"Comment : le Nether ici est le vide, pas un terrain. Verse de la lave dans un tonneau d'Ex Deorum d'eau de sorcière (un tonneau d'eau posé sur du mycélium ; les spores de mycélium se tamisent depuis la terre)."
	]
	quest.420000000002006E.title: "Netherrack"
	quest.420000000002006F.quest_desc: [
		"Ralentit chaque pas qui le traverse, et nourrit le feu des âmes d'un bleu plus froid.",
		"Comment : du sable dans un tonneau d'Ex Deorum d'eau de sorcière. Les salles à verrues de la forteresse en gardent un peu. Trois crânes sur du sable des âmes font un Wither."
	]
	quest.420000000002006F.title: "Sable des âmes"
	quest.4200000000020070.quest_desc: [
		"Broyée à partir de la pierre lumineuse du Nether, utile pour les potions et pour une lumière plus douce.",
		"Comment : tamise du sable des âmes, ou des sorcières sur la plateforme."
	]
	quest.4200000000020070.title: "Poudre de pierre lumineuse"
	quest.4200000000020071.quest_desc: [
		"Arrache les feuilles d'un arbre sans abattre la hache sur le tronc.",
		"Comment : quatre bâtons. L'étal des Chanteurs de gravier en vend une."
	]
	quest.4200000000020071.title: "Crosse"
	quest.4200000000020072.quest_desc: [
		"Tirée du tamis, en tas qui grossissent. Jamais tout à fait assez pour chaque maille.",
		"Comment : détisse le Fil effiloché (1 → 3). Araignées. Peluche du métier sur un Lien d'écho. Dépense inverse du filé."
	]
	quest.4200000000020072.title: "Ficelle"
	quest.4200000000020073.quest_desc: [
		"Liant à nœuds — ou recette de compost de plateforme.",
		"Comment : deux terres + graines de blé + poudre d'os (compost de plateforme), ou /clowder hub Gardiens de la plateforme."
	]
	quest.4200000000020073.title: "Boule de slime"
	quest.4200000000020074.quest_desc: [
		"Réduit en poudre d'os, ou gardé entier pour élever le prochain loup de la meute.",
		"Comment : des squelettes la nuit, ou /clowder hub Gardiens de la plateforme (16 Fil pour 8)."
	]
	quest.4200000000020074.title: "Os"
	quest.4200000000020075.quest_desc: [
		"Amer et un peu toxique. On s'en sert pour les potions ; personne ne le mange nature.",
		"Comment : des araignées sur la plateforme, la nuit."
	]
	quest.4200000000020075.title: "Œil d'araignée"
	quest.4200000000020076.quest_desc: [
		"Filé, porcelaine, un Cadre de métier en état de marche, du fer dans le coffre.",
		"Tends le Brin : les Chanteurs de gravier répondent.",
		"Réclame-le et choisis un cadeau de la tribu : un Fil du Retour pour une vie partagée de plus, ou des fournitures.",
		"Comment : termine les quêtes liées à celle-ci, puis réclame-la pour le jeton de Brin. Assieds le jeton à ton Poteau de tension."
	]
	quest.4200000000020076.quest_subtitle: "Récupération"
	quest.4200000000020076.title: "Nœud de Pierre"
	quest.4200000000020077.quest_desc: [
		"Clic droit sur le Poteau de tension de ton Clowder avec le jeton.",
		"L'encoche s'allume, la tribu sonne, la plateforme change.",
		"Comment : clic droit sur ton Poteau de tension avec le jeton de Brin en main."
	]
	quest.4200000000020077.title: "Assieds Pierre"
	quest.4200000000020078.quest_desc: [
		"Un creeper, réglé. La poudre à canon vaut plus que la peur.",
		"Comment : tue trois creepers. La poudre à canon est la récompense."
	]
	quest.4200000000020078.title: "Boum, plus tard"
	quest.4200000000030079.quest_desc: [
		"Griffe des rangs dans la plateforme.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : deux lingots de fer au-dessus d'un bâton."
	]
	quest.4200000000030079.title: "Houe en fer"
	quest.420000000003007A.quest_desc: [
		"Le pain, c'est l'infrastructure. Trente-deux blés font un champ, pas une plate-bande.",
		"Comment : des graines de blé sur de la terre labourée, puis de la poudre d'os. Les graines viennent en cassant l'herbe, ou du coffre de départ."
	]
	quest.420000000003007A.title: "Champ de blé"
	quest.420000000003007B.quest_desc: [
		"Plante ce que tu manges.",
		"Comment : casse de l'herbe, ou tamise de la terre avec une maille de silex. Plante sur terre labourée ; la poudre d'os accélère le premier champ."
	]
	quest.420000000003007B.title: "Pochette de graines"
	quest.420000000003007C.quest_desc: [
		"Aller vite, c'est de la gentillesse. Compost et os.",
		"Comment : os en grille, ou dépense Fil + chair putréfiée, ou /clowder hub Gardiens de la plateforme."
	]
	quest.420000000003007C.title: "Moteur à poudre d'os"
	quest.420000000003007D.quest_desc: [
		"Prépare la récolte.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000003007D.title: "Couteau du fermier"
	quest.420000000003007E.quest_desc: [
		"Une cuisine commence ici.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000003007E.title: "Planche à découper"
	quest.420000000003007F.quest_desc: [
		"Les plats chauds nourrissent plus que la faim.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000003007F.title: "Marmite"
	quest.4200000000030080.quest_desc: [
		"Pousse en pommes nettes, meilleure cuisinée dans un plat que crue.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000030080.title: "Chou"
	quest.4200000000030081.quest_desc: [
		"Grimpe à son propre treillis et mûrit rouge. La sauce commence ici.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000030081.title: "Tomate"
	quest.4200000000030082.quest_desc: [
		"Larmes de joie.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000030082.title: "Oignon"
	quest.4200000000030083.quest_desc: [
		"La culture d'essence commence. Seize au premier rang.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"L'ossature des graines. Tamise-la ou cultive-la.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Élève des graines à partir d'essence.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030085.title: "Autel d'infusion"
	quest.4200000000030086.quest_desc: [
		"Quatre autour de l'autel.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030086.title: "Piédestal d'infusion"
	quest.4200000000030087.quest_desc: [
		"Fais pousser plus de plateforme.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030087.title: "Graines de terre"
	quest.4200000000030088.quest_desc: [
		"Fais pousser la canopée sans la hache.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030088.title: "Graines de bois"
	quest.4200000000030089.quest_desc: [
		"Cultivé, pas miné. Récolte l'essence au lieu de manier une pioche.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030089.title: "Graines de pierre"
	quest.420000000003008A.quest_desc: [
		"Du métal issu d'une culture. Le second moteur de Récupération.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000003008A.title: "Graines de fer"
	quest.420000000003008B.quest_desc: [
		"Une culture qui donne de l'essence de cuivre au lieu de minerai de cuivre.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000003008B.title: "Graines de cuivre"
	quest.420000000003008C.quest_desc: [
		"Une culture dorée qui fait pousser de l'essence d'or pile sur la plateforme.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000003008C.title: "Graines d'or"
	quest.420000000003008D.quest_desc: [
		"Transforme une parcelle en source de combustible, sans miner.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000003008D.title: "Graines de charbon"
	quest.420000000003008E.quest_desc: [
		"De la pluie en bouteille, tirée d'une culture.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000003008E.title: "Graines d'eau"
	quest.420000000003008F.quest_desc: [
		"Croissance compacte pour une petite plateforme.",
		"Comment : Botany Pot en terre cuite dans JEI. Terre + une graine dans le pot ; la poudre d'os aide encore."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"Le pot qui se récolte tout seul.",
		"Comment : Botany Pot à entonnoir dans JEI. Il se pose sur un coffre/entonnoir et se récolte tout seul."
	]
	quest.4200000000030090.title: "Pot-entonnoir"
	quest.4200000000030091.quest_desc: [
		"Monte d'un grade. Les graines deviennent plus avides et meilleures.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"Un grade plus profond d'essence de culture, plus fort que les graines avec lesquelles tu as commencé.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Neuf poudres d'os pour un bloc. Du stockage pour le moteur.",
		"Comment : neuf poudres d'os. Os de squelettes ou des Gardiens de la plateforme."
	]
	quest.4200000000030093.title: "Bloc d'os"
	quest.4200000000030094.quest_desc: [
		"Surplus de Pousse, empilé.",
		"Comment : neuf blés. Trois blés font aussi du pain."
	]
	quest.4200000000030094.title: "Silo à foin"
	quest.4200000000030095.quest_desc: [
		"Meilleure terre cultivable. Les Lie-racines approuveraient.",
		"Comment : pose du Compost organique et attends ; il mûrit lentement en Terre riche."
	]
	quest.4200000000030095.title: "Terre fertile"
	quest.4200000000030096.quest_desc: [
		"Nourris la terre qui te nourrit.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000030096.title: "Composte organique"
	quest.4200000000030097.quest_desc: [
		"Plante un rang, nourris un cheval, ou mange-la crue.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000030097.title: "Carotte"
	quest.4200000000030098.quest_desc: [
		"Culture de base : la pomme de terre.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000030098.title: "Pomme de terre"
	quest.4200000000030099.quest_desc: [
		"Pousse vite et teint en rouge. Soupe, ragoût, ou droit sorti du sol.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000030099.title: "Betterave"
	quest.420000000003009A.quest_desc: [
		"Pastèque pour la nourriture et les échanges.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000003009A.title: "Pastèque"
	quest.420000000003009B.quest_desc: [
		"Citrouille pour la nourriture et la déco.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000003009B.title: "Citrouille"
	quest.420000000003009C.quest_desc: [
		"Papier et sucre.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000003009C.title: "Canne à sucre"
	quest.420000000003009D.quest_desc: [
		"Pousse sans eau et blesse tout ce qui s'y appuie.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000003009D.title: "Cactus"
	quest.420000000003009E.quest_desc: [
		"Monte vite et brûle chaud. Combustible pratique pour une plateforme pauvre en arbres.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000003009E.title: "Bambou"
	quest.420000000003009F.quest_desc: [
		"Des baies pendant que tu construis.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000003009F.title: "Baies sucrées"
	quest.42000000000300A0.quest_desc: [
		"Cultivé sur des bûches de jungle, moulu en ce brun qui parfume tout le sucré.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000300A0.title: "Cacao"
	quest.42000000000300A1.quest_desc: [
		"Tombe des feuilles de chêne en son temps. De la nourriture gratuite, tôt ou tard.",
		"Comment : les feuilles de chêne en lâchent quelques-unes ; un pommier Pam's (plant issu de terre à maille de fer) en porte beaucoup."
	]
	quest.42000000000300A1.title: "Pomme"
	quest.42000000000300A2.quest_desc: [
		"Un bol, pas d'établi. Le dîner du fermier paresseux.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000300A2.title: "Ragoût de champignons"
	quest.42000000000300A3.quest_desc: [
		"Un goût de la ruche avant que le travail plus profond avec les abeilles commence.",
		"Comment : fiole en verre sur une ruche pleine. Feu de camp en dessous."
	]
	quest.42000000000300A3.title: "Fiole de miel"
	quest.42000000000300A4.quest_desc: [
		"Elles poussent sur des lianes de grotte et éclairent le tunnel pendant que tu les manges.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000300A4.title: "Baies lumineuses"
	quest.42000000000300A5.quest_desc: [
		"La base de chaque potion qui vaut d'être mise en fiole. Ne pousse que sur le sable des âmes.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000300A5.title: "Verrues du Nether"
	quest.42000000000300A6.quest_desc: [
		"Un champ, une cuisine, l'essence qui monte.",
		"Mets le Brin en tension : les Lie-racines répondent.",
		"Réclame-le et choisis un cadeau de la tribu : un Fil du Retour pour une vie partagée de plus, ou des fournitures.",
		"Comment : termine les quêtes liées à celle-ci, puis réclame-la pour le jeton de Brin. Assieds le jeton à ton Poteau de tension."
	]
	quest.42000000000300A6.quest_subtitle: "Racine"
	quest.42000000000300A6.title: "Nœud de Pousse"
	quest.42000000000300A7.quest_desc: [
		"Clic droit sur le Poteau de tension de ton Clowder avec le jeton.",
		"L'encoche s'allume, la tribu sonne, la plateforme change.",
		"Comment : clic droit sur ton Poteau de tension avec le jeton de Brin en main."
	]
	quest.42000000000300A7.title: "Assieds Pousse"
	quest.42000000000300A8.quest_desc: [
		"Les Lie-racines en tirent chacun une, tôt ou tard.",
		"Ne la mange pas. Ne la jette pas non plus.",
		"Comment : une rare récolte de pomme de terre. Secret optionnel de Pousse."
	]
	quest.42000000000300A8.title: "Mauvaise patate"
	quest.42000000000400A9.quest_desc: [
		"Découpe le vide à ta façon. Huit feuilles de plans.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : quatre papiers et une teinture bleue, sans forme. Donne quatre feuilles."
	]
	quest.42000000000400A9.title: "Blueprint Paper"
	quest.42000000000400AA.quest_desc: [
		"Des plans dans une boîte.",
		"Quatre Papier de plans, sans forme — revendiquer une plateforme efface le cadeau d'arrivée de Silent Gear. Clic droit pour déballer les plans de départ.",
		"Comment : quatre Papier de plans, sans forme. Clic droit pour déballer les plans de départ. Revendiquer une plateforme efface le cadeau d'arrivée de Silent Gear."
	]
	quest.42000000000400AA.title: "Blueprint Package"
	quest.42000000000400AB.quest_desc: [
		"Le modèle dont part un outil modulaire, avant que tu y ajoutes ses pièces.",
		"Comment : déballe le Paquet de plans, ou JEI. Griffe nomme la ligne d'outils."
	]
	quest.42000000000400AB.title: "Plan de tige"
	quest.42000000000400AC.quest_desc: [
		"Forme une pioche qui dure plus que son métal.",
		"Comment : déballe le Paquet de plans, ou JEI. Griffe nomme la ligne d'outils."
	]
	quest.42000000000400AC.title: "Plan de pioche"
	quest.42000000000400AD.quest_desc: [
		"Forme une hache.",
		"Comment : déballe le Paquet de plans, ou JEI. Griffe nomme la ligne d'outils."
	]
	quest.42000000000400AD.title: "Plan de hache"
	quest.42000000000400AE.quest_desc: [
		"Forme une pelle.",
		"Comment : déballe le Paquet de plans, ou JEI. Griffe nomme la ligne d'outils."
	]
	quest.42000000000400AE.title: "Plan de pelle"
	quest.42000000000400AF.quest_desc: [
		"Forme une lame.",
		"Comment : déballe le Paquet de plans, ou JEI. Griffe nomme la ligne d'outils."
	]
	quest.42000000000400AF.title: "Plan d'épée"
	quest.42000000000400B0.quest_desc: [
		"De la place pour grandir.",
		"Comment : JEI après le Papier de plans. Griffe nomme la ligne d'améliorations."
	]
	quest.42000000000400B0.title: "Upgrade Base"
	quest.42000000000400B1.quest_desc: [
		"Trente-deux lingots de matériau pour les pièces.",
		"Comment : fais fondre du fer brut / du gravillon de fer (fourneau ou Four à braises). Tamise le gravier pour des morceaux."
	]
	quest.42000000000400B1.title: "Masse de fer"
	quest.42000000000400B2.quest_desc: [
		"Aiguise le tranchant au-delà de ce que le fer seul peut.",
		"Comment : tamise le gravier avec une maille de fer ou mieux, ou du minerai de diamant au Bris d'écho."
	]
	quest.42000000000400B2.title: "Pointe de diamant"
	quest.42000000000400B3.quest_desc: [
		"Des feuilles et de la laine, et des rayons plus tard.",
		"Comment : deux lingots de fer en diagonale. Tonds moutons et nids d'abeilles."
	]
	quest.42000000000400B3.title: "Cisailles"
	quest.42000000000400B4.quest_desc: [
		"Les plateformes ont des bords. Les monstres aussi.",
		"Comment : six planches autour du fer. Blocage en main secondaire."
	]
	quest.42000000000400B4.title: "Bouclier"
	quest.42000000000400B5.quest_desc: [
		"Survis à la nuit exprès.",
		"Comment : huit lingots de fer. Fais fondre du gravier de tamis."
	]
	quest.42000000000400B5.title: "Plastron en fer"
	quest.42000000000400B6.quest_desc: [
		"Attention à la chute.",
		"Comment : cinq lingots de fer."
	]
	quest.42000000000400B6.title: "Casque en fer"
	quest.42000000000400B7.quest_desc: [
		"Couvre d'abord les jambes. La plupart des dégâts viennent d'en bas, de toute façon.",
		"Comment : sept lingots de fer."
	]
	quest.42000000000400B7.title: "Jambières en fer"
	quest.42000000000400B8.quest_desc: [
		"Assure ton appui sur les rebords où un faux pas, c'est le vide.",
		"Comment : quatre lingots de fer."
	]
	quest.42000000000400B8.title: "Bottes en fer"
	quest.42000000000400B9.quest_desc: [
		"Tiens les monstres du vide à distance.",
		"Comment : trois ficelles et trois bâtons."
	]
	quest.42000000000400B9.title: "Arc"
	quest.42000000000400BA.quest_desc: [
		"Soixante-quatre raisons de garder tes distances.",
		"Comment : silex, bâton, plume. Les squelettes en lâchent en plus."
	]
	quest.42000000000400BA.title: "Liasse de flèches"
	quest.42000000000400BB.quest_desc: [
		"Éclaire le passage.",
		"Comment : lingot de fer plus silex."
	]
	quest.42000000000400BB.title: "Briquet"
	quest.42000000000400BC.quest_desc: [
		"Dix blocs. Une porte que les Marche-lisières reconnaîtraient.",
		"Comment : de l'eau sur une source de lave (ou de la lave sur l'eau). Garde la source de lave."
	]
	quest.42000000000400BC.title: "Cadre d'obsidienne"
	quest.42000000000400BD.quest_desc: [
		"Préparation d'une prise. Ailleurs existe.",
		"Comment : perle de l'Ender (étal des Marche-lisières / endermen) plus poudre de Blaze d'une forteresse du Nether, après l'obsidienne de Griffe. Le stock de huit yeux est facultatif ; les cristaux de l'End utilisent la même fabrication."
	]
	quest.42000000000400BD.title: "Œil de l'Ender"
	quest.42000000000400BE.quest_desc: [
		"Pouvoir doux pour outils durs.",
		"Comment : deux diamants, quatre obsidienne, livre. Les diamants viennent du gravier à maille de fer."
	]
	quest.42000000000400BE.title: "Table d'enchantement"
	quest.42000000000400BF.quest_desc: [
		"Répare et nomme ce que tu portes.",
		"Comment : trois blocs de fer sur quatre lingots."
	]
	quest.42000000000400BF.title: "Enclume"
	quest.42000000000400C0.quest_desc: [
		"Appelle-le tien.",
		"Comment : pêche / coffres rares, ou l'étal des Graveurs de sceaux à /clowder hub (24 Fil). Facultatif."
	]
	quest.42000000000400C0.title: "Étiquette"
	quest.42000000000400C1.quest_desc: [
		"Le modèle de départ d'une houe modulaire, montée pièce par pièce.",
		"Comment : déballe le Paquet de plans, ou JEI."
	]
	quest.42000000000400C1.title: "Plan de houe"
	quest.42000000000400C2.quest_desc: [
		"Dégage une large bande de cultures d'un coup, au lieu d'une plante.",
		"Comment : déballe le Paquet de plans, ou JEI."
	]
	quest.42000000000400C2.title: "Plan de faucille"
	quest.42000000000400C3.quest_desc: [
		"Un outil qui mine, coupe et creuse. Plus besoin de changer dans ta main.",
		"Comment : déballe le Paquet de plans, ou JEI."
	]
	quest.42000000000400C3.title: "Plan de Paxel"
	quest.42000000000400C4.quest_desc: [
		"Casse la pierre en trois sur trois d'un seul coup.",
		"Comment : déballe le Paquet de plans, ou JEI."
	]
	quest.42000000000400C4.title: "Plan de marteau"
	quest.42000000000400C5.quest_desc: [
		"Creuse de larges trous dans la terre et le sable, plus vite que n'importe quelle pelle.",
		"Comment : déballe le Paquet de plans, ou JEI."
	]
	quest.42000000000400C5.title: "Plan d'excavateur"
	quest.42000000000400C6.quest_desc: [
		"Petit, rapide et précis. Fait pour le travail de près, pas pour la guerre.",
		"Comment : déballe le Paquet de plans, ou JEI."
	]
	quest.42000000000400C6.title: "Plan de couteau"
	quest.42000000000400C7.quest_desc: [
		"Un placage souple, facile à enchanter, qui vaut plus par sa magie que par sa défense.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000400C7.title: "Pièces d'armure en or"
	quest.42000000000400C8.quest_desc: [
		"Griffe de mer.",
		"Facultatif — le vide peut ne jamais t'en offrir un.",
		"Comment : noyés seulement. Facultatif."
	]
	quest.42000000000400C8.title: "Trident"
	quest.42000000000400C9.quest_desc: [
		"Se charge lentement, frappe fort, et garde sa charge jusqu'à ce que tu en aies besoin.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000400C9.title: "Arbalète"
	quest.42000000000400CA.quest_desc: [
		"Scrute le vide.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000400CA.title: "Longue-vue"
	quest.42000000000400CB.quest_desc: [
		"Plans, du fer sur le dos, une porte vers le dehors.",
		"Tends le Brin : les Marche-lisières répondent. La tresse s'ouvre.",
		"Réclame-le et choisis un cadeau de la tribu : un Fil du Retour pour une vie partagée de plus, ou des fournitures.",
		"Comment : termine les quêtes liées à celle-ci, puis réclame-la pour le jeton de Brin. Assieds le jeton à ton Poteau de tension."
	]
	quest.42000000000400CB.quest_subtitle: "Lisière"
	quest.42000000000400CB.title: "Nœud de Griffe"
	quest.42000000000400CC.quest_desc: [
		"Clic droit sur le Poteau de tension de ton Clowder avec le jeton.",
		"L'encoche s'allume, la tribu sonne, la plateforme change.",
		"Comment : clic droit sur ton Poteau de tension avec le jeton de Brin en main."
	]
	quest.42000000000400CC.title: "Assieds Griffe"
	quest.42000000000400CD.quest_desc: [
		"Quelque chose de haut a rendu le regard. Les Marche-lisières les appelaient gardiens des portes.",
		"Comment : tue un enderman. Les perles de l'Ender viennent aussi de l'étal des Marche-lisières."
	]
	quest.42000000000400CD.title: "Lisière de la Lisière"
	quest.42000000000500CE.quest_desc: [
		"Un bref signal avant le Bourdon. Soixante-quatre de poussière.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : tamise le gravier, ou du minerai de redstone au Bris d'écho après Récupération."
	]
	quest.42000000000500CE.title: "Poudre de redstone"
	quest.42000000000500CF.quest_desc: [
		"Chaleur en parallèle. Huit, c'est une ligne, pas un fourneau.",
		"Comment : huit roches autour d'un centre vide."
	]
	quest.42000000000500CF.title: "Rangée de fourneaux"
	quest.42000000000500D0.quest_desc: [
		"Déplace le gravillon sans les mains.",
		"Comment : cinq fers autour d'un coffre. Pose-le sous un Cadre de métier ou un Tonneau de tension (extraction vers le BAS)."
	]
	quest.42000000000500D0.title: "Ligne d'entonnoirs"
	quest.42000000000500D1.quest_desc: [
		"Mesure le battement.",
		"Comment : quartz du Nether, torche de redstone, pierre. Le quartz se tamise dans le sable des âmes ; pas besoin d'un voyage au Nether."
	]
	quest.42000000000500D1.title: "Comparateur"
	quest.42000000000500D2.quest_desc: [
		"Os, ficelle, améthyste. Le premier battement.",
		"Ça en donne deux — garde-en un pour le Codex des Esprits.",
		"Comment : un os, de la ficelle, de l'améthyste. /clowder hub Les Gardiens de la plateforme vendent des os. Porte Étincelle / Bourdon."
	]
	quest.42000000000500D2.title: "Bourdon : Carillon d'os"
	quest.42000000000500D3.quest_desc: [
		"Un éclat d'un vieux chant de tribu. Il lui faut un carillon.",
		"Comment : Carillon d'os, améthyste et redstone, sans forme. En donne deux."
	]
	quest.42000000000500D3.title: "Bourdon : Éclat d'esprit"
	quest.42000000000500D4.quest_desc: [
		"Du cuivre autour d'un carillon : du métal accordé à l'esprit.",
		"Comment : du cuivre autour d'un Carillon d'os. En donne deux."
	]
	quest.42000000000500D4.title: "Bourdon : Résonateur de cuivre"
	quest.42000000000500D5.quest_desc: [
		"Frappe-le. Tiens un Pouls. Écoute avant de câbler quoi que ce soit.",
		"Deux carillons, un éclat, deux cuirs, quatre planches — les Gardiens de la plateforme à /clowder hub vendent du cuir.",
		"Comment : deux Carillons d'os, un Éclat d'esprit, deux cuirs et quatre planches. Frappe à mains vides en rythme (17–23 ticks) pour 24 de Pouls."
	]
	quest.42000000000500D5.title: "Bourdon : Cœur-tambour"
	quest.42000000000500D6.quest_desc: [
		"Porte du Pouls pour les outils, les sorts et le voyage — il faut Résonateur + Éclat.",
		"Comment : fabrique-la, puis remplis-la depuis un Cœur-tambour (clic avec la cellule). Outils, sorts et voyage puisent dans la cellule."
	]
	quest.42000000000500D6.title: "Bourdon : Cellule de Pouls"
	quest.42000000000500D7.quest_desc: [
		"Tire la ley ambiante en battements sous ciel ouvert. Les voix des totems s'ajoutent ; un Cœur-tambour n'est pas requis.",
		"Comment : place-le sous le ciel, près d'eau/vert. Pouls lent. Échelle d'Étincelle."
	]
	quest.42000000000500D7.title: "Bourdon : Collecteur de ley"
	quest.42000000000500D8.quest_desc: [
		"Pose un catalyseur d'écho (il s'use en travaillant) et deux totems élémentaires différents. Le camp chante sa propre puissance ; la redstone met l'harmonie en pause.",
		"Comment : pose un catalyseur d'écho et deux totems différents dans un rayon de 8. La redstone le met en pause."
	]
	quest.42000000000500D8.title: "Bourdon : Résonateur de Pouls"
	quest.42000000000500D9.quest_desc: [
		"Un tampon d'énergie de Forge — le pont du Pouls au fil, si tu en veux un.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500D9.title: "Cellule de départ Powah"
	quest.42000000000500DA.quest_desc: [
		"Brûle du combustible pour l'énergie de Forge.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500DA.title: "Brûleur Powah"
	quest.42000000000500DB.quest_desc: [
		"Fais avancer l'énergie.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500DB.title: "Câble Powah"
	quest.42000000000500DC.quest_desc: [
		"La puissance du ciel, sur une plateforme qui n'est que ciel.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500DC.title: "Panneau solaire de départ"
	quest.42000000000500DD.quest_desc: [
		"Brûle un écart de chaleur en puissance. Nourris-le chaud d'un côté, froid de l'autre.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500DD.title: "Générateur thermique"
	quest.42000000000500DE.quest_desc: [
		"Charge des objets dans un anneau de bâtons.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500DE.title: "Orbe énergisant"
	quest.42000000000500DF.quest_desc: [
		"Nourris l'orbe.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500DF.title: "Bâton d'énergie"
	quest.42000000000500E0.quest_desc: [
		"Une poche d'énergie stockée.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500E0.title: "Batterie"
	quest.42000000000500E1.quest_desc: [
		"Tourne les machines sur place au lieu de les casser et de les reposer.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000500E1.title: "Clé à molette"
	quest.42000000000500E2.quest_desc: [
		"Fond le minerai deux fois plus vite qu'un fourneau ordinaire, minerai seulement.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500E2.title: "Haut fourneau"
	quest.42000000000500E3.quest_desc: [
		"Cuit la viande deux fois plus vite qu'un feu de camp, nourriture seulement.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500E3.title: "Fumoir"
	quest.42000000000500E4.quest_desc: [
		"Neuf charbons pressés, denses. Un bloc dure plus qu'une pile entière de morceaux.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500E4.title: "Bloc de charbon (Étincelle)"
	quest.42000000000500E5.quest_desc: [
		"Pousse un objet à la fois vers ce qui est devant.",
		"Comment : de la roche autour de redstone."
	]
	quest.42000000000500E5.title: "Dropper"
	quest.42000000000500E6.quest_desc: [
		"Pousse avec intention.",
		"Comment : roche, arc et redstone."
	]
	quest.42000000000500E6.title: "Distributeur"
	quest.42000000000500E7.quest_desc: [
		"Pousse un bloc en avant à un signal, puis attend le suivant.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500E7.title: "Piston"
	quest.42000000000500E8.quest_desc: [
		"Pousse un bloc et le ramène quand le signal tombe.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500E8.title: "Piston collant"
	quest.42000000000500E9.quest_desc: [
		"L'observateur lit le rythme.",
		"Comment : roche, redstone et quartz du Nether."
	]
	quest.42000000000500E9.title: "Observateur"
	quest.42000000000500EA.quest_desc: [
		"Le répéteur cadence le circuit.",
		"Comment : torche de redstone, redstone, pierre. Le chapitre des tuyaux s'en sert pour les horloges."
	]
	quest.42000000000500EA.title: "Répéteur"
	quest.42000000000500EB.quest_desc: [
		"Enregistre un impact, avec une force de signal selon la proximité du centre.",
		"Comment : redstone autour du foin. Le foin, c'est trois blés."
	]
	quest.42000000000500EB.title: "Cible"
	quest.42000000000500EC.quest_desc: [
		"Détourne un éclair de ton toit et met la charge à la terre.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500EC.title: "Paratonnerre"
	quest.42000000000500ED.quest_desc: [
		"L'heure de l'énergie.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500ED.title: "Horloge"
	quest.42000000000500EE.quest_desc: [
		"De la lumière sans torches.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500EE.title: "Ampoule en cuivre"
	quest.42000000000500EF.quest_desc: [
		"S'allume sur un signal et s'éteint dès qu'il s'arrête.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500EF.title: "Lampe à redstone"
	quest.42000000000500F0.quest_desc: [
		"Lit le ciel et envoie un signal qui monte et descend avec le soleil.",
		"Comment : verre, quartz du Nether, dalles de bois."
	]
	quest.42000000000500F0.title: "Capteur de lumière du jour"
	quest.42000000000500F1.quest_desc: [
		"Bascule un signal à la main. Le plus vieil interrupteur qui soit.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F1.title: "Levier"
	quest.42000000000500F2.quest_desc: [
		"Le bouton donne une impulsion de redstone.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F2.title: "Bouton"
	quest.42000000000500F3.quest_desc: [
		"Envoie un signal quand quelque chose de plus lourd que l'air se tient dessus.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F3.title: "Plaque de pression"
	quest.42000000000500F4.quest_desc: [
		"Tendue en ficelle en travers d'un chemin, elle attrape tout ce qui passe.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F4.title: "Crochet"
	quest.42000000000500F5.quest_desc: [
		"Joue une note par type de bloc en dessous. Les Cœurs-tambours entendent un chant dans une rangée.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F5.title: "Bloc musical"
	quest.42000000000500F6.quest_desc: [
		"Jukebox pour le moral de la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F6.title: "Jukebox"
	quest.42000000000500F7.quest_desc: [
		"Roule sous la gravité ou une poussée. Sans rails, pas de trajet.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F7.title: "Wagonnet"
	quest.42000000000500F8.quest_desc: [
		"Des rails à travers la portée du vide.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F8.title: "Rail"
	quest.42000000000500F9.quest_desc: [
		"Rail de propulsion pour wagonnets.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500F9.title: "Rail de propulsion"
	quest.42000000000500FA.quest_desc: [
		"Lit un wagonnet qui passe et envoie un signal quand il roule dessus.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000500FA.title: "Rail détecteur"
	quest.42000000000500FB.quest_desc: [
		"Fabrication solaire de rechange.",
		"Comment : trois verres, trois lapis-lazulis et trois Miroirs, une rangée de chaque."
	]
	quest.42000000000500FB.title: "Cellule Solar Flux"
	quest.42000000000500FC.quest_desc: [
		"Tuyaux d'objets simples.",
		"Comment : fer + redstone. Règle les faces avec la clé Pipez."
	]
	quest.42000000000500FC.title: "Pipez d'objets"
	quest.42000000000500FD.quest_desc: [
		"Tuyaux de fluides simples.",
		"Comment : fer + seaux + redstone. Utilisation accroupie de la clé sur un côté pour extraire ; clic droit sur ce côté pour les filtres."
	]
	quest.42000000000500FD.title: "Pipez de fluides"
	quest.42000000000500FE.quest_desc: [
		"Tuyaux d'énergie tout simples entre les machines.",
		"Comment : fer + redstone. Porte des FE entre les machines."
	]
	quest.42000000000500FE.title: "Pipez d'énergie"
	quest.42000000000500FF.quest_desc: [
		"Choisit quels côtés du tuyau extraient d'une machine, ou en coupe un, sans casser le tuyau.",
		"Comment : deux silex et deux bâtons. Utilisation accroupie d'un côté de tuyau sur une machine pour qu'il extraie, encore une fois pour le couper ; clic droit sur un côté qui extrait pour les filtres."
	]
	quest.42000000000500FF.title: "Clé Pipez"
	quest.4200000000050100.quest_desc: [
		"Marque les lignes du treillis — nécessite un Éclat d'esprit.",
		"Comment : deux poudres d'os, du lapis-lazuli et un Éclat d'esprit, sans forme. Donne quatre."
	]
	quest.4200000000050100.title: "Craie rituelle"
	quest.4200000000050101.quest_desc: [
		"Un tambour frappé, une Pulsation tenue, un Résonateur assis.",
		"Tends le Brin : les Cœurs-tambours répondent.",
		"Réclame-le et choisis un cadeau de la tribu : un Fil du Retour pour une vie partagée de plus, ou des fournitures.",
		"Comment : termine les quêtes liées à celle-ci, puis réclame-la pour le jeton de Brin. Assieds le jeton à ton Poteau de tension."
	]
	quest.4200000000050101.quest_subtitle: "Bourdon"
	quest.4200000000050101.title: "Nœud d'Étincelle"
	quest.4200000000050102.quest_desc: [
		"Clic droit sur le Poteau de tension de ton Clowder avec le jeton.",
		"L'encoche s'allume, la tribu sonne, la plateforme change.",
		"Comment : clic droit sur ton Poteau de tension avec le jeton de Brin en main."
	]
	quest.4200000000050102.title: "Assieds Étincelle"
	quest.4200000000050103.quest_desc: [
		"Suis le Tissage tribal par l'affinage d'écho jusqu'à un Noyau résonnant. L'Énergiseur harmonique transforme l'harmonie du camp en FE pour les machines de ce chapitre. La conversion sans rang est de 60 de Pulsation par seconde ; monte-la en rang aux stations d'écho pour en avoir plus. Il ne peut pas recevoir de FE. La redstone met en pause la conversion et l'exportation.",
		"Comment : cinq lingots de cuivre, trois redstone et un Noyau résonnant."
	]
	quest.4200000000050103.title: "Le bourdon devient courant"
	quest.4200000000050104.quest_desc: [
		"Une sorcière, sur ta plateforme, la nuit. Les tambours ne t'ont pas prévenu.",
		"Comment : tue une sorcière sur la plateforme, la nuit."
	]
	quest.4200000000050104.title: "Souci en bouteille"
	quest.4200000000060105.quest_desc: [
		"Des mains qui travaillent pendant que tu dors. Trente-deux.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : andésite + pépite de fer dans un établi (ou un mélangeur)."
	]
	quest.4200000000060105.title: "Alliage d'andésite"
	quest.4200000000060106.quest_desc: [
		"La colonne vertébrale de la rotation.",
		"Comment : alliage d'andésite dans une recette de découpe / de fabrication, listée dans JEI."
	]
	quest.4200000000060106.title: "Rotor"
	quest.4200000000060107.quest_desc: [
		"Une roue dentée. Puis la même roue dentée encore.",
		"Comment : Arbre + planches."
	]
	quest.4200000000060107.title: "Roue dentée"
	quest.4200000000060108.quest_desc: [
		"Plus de dents, tour plus lent.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.4200000000060108.title: "Grande roue dentée"
	quest.4200000000060109.quest_desc: [
		"L'habillage d'andésite est le cadre de Create.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.4200000000060109.title: "Boitier d'andésite"
	quest.420000000006010A.quest_desc: [
		"Une rivière dans le ciel, qui tourne.",
		"Comment : huit planches autour d'un Arbre. Il faut un courant d'eau à côté."
	]
	quest.420000000006010A.title: "Roue à eau"
	quest.420000000006010B.quest_desc: [
		"Produit la rotation à la main quand rien d'autre ne tourne encore.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.420000000006010B.title: "Manivelle"
	quest.420000000006010C.quest_desc: [
		"Mouds le gravier en poussière, sans marteau.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.420000000006010C.title: "Meule"
	quest.420000000006010D.quest_desc: [
		"Le bassin contient le mélange de Create.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.420000000006010D.title: "Bassin"
	quest.420000000006010E.quest_desc: [
		"Plaques et chemins.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.420000000006010E.title: "Presse mécanique"
	quest.420000000006010F.quest_desc: [
		"Recettes en gros, vite.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.420000000006010F.title: "Mixeur mécanique"
	quest.4200000000060110.quest_desc: [
		"Une surface plate qui tient un objet immobile pour la bande ou la presse.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.4200000000060110.title: "Dépôt"
	quest.4200000000060111.quest_desc: [
		"Les bandes déplacent les objets le long des Arbres.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.4200000000060111.title: "Connecteur de bande"
	quest.4200000000060112.quest_desc: [
		"Laisse tomber les objets tout droit entre les machines, sans avoir besoin de bande.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.4200000000060112.title: "Chute"
	quest.4200000000060113.quest_desc: [
		"Lavage, séchage, et gravier en sable.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.4200000000060113.title: "Ventilateur enchâssé"
	quest.4200000000060114.quest_desc: [
		"Une main sur un Arbre.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.4200000000060114.title: "Déployeur"
	quest.4200000000060115.quest_desc: [
		"Coupe les bûches en planches, ou les arbres en bois, s'il y a assez de rotation.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.4200000000060115.title: "Scie mécanique"
	quest.4200000000060116.quest_desc: [
		"Fore à travers les blocs de gravier.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
