		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.420000000007014B.title: "Indexeur de gènes"
	quest.420000000007014C.quest_desc: [
		"Une pile de friandises : la paie de la colonie.",
		"Comment : rayon de miel plus une fiole de miel, sans forme."
	]
	quest.420000000007014C.title: "Amélioration de nourrissage"
	quest.420000000007014D.quest_desc: [
		"L'une des cultures d'essence les plus profondes, poussée bien au-delà des bases.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000007014D.title: "Graines de diamant"
	quest.420000000007014E.quest_desc: [
		"Une parcelle qui donne de la poussière au lieu de la creuser.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000007014E.title: "Graines de redstone"
	quest.420000000007014F.quest_desc: [
		"Fait pousser l'essence bleue dont les tables d'enchantement ont toujours faim.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000007014F.title: "Graines de lapis-lazuli"
	quest.4200000000070150.quest_desc: [
		"Du quartz poussé sur une culture, au lieu d'être creusé dans les grottes du Nether.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000070150.title: "Graines de quartz du Nether"
	quest.4200000000070151.quest_desc: [
		"Une façon plus douce de cultiver la lumière que de miner le plafond du Nether.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000070151.title: "Graines de pierre lumineuse"
	quest.4200000000070152.quest_desc: [
		"Une culture durcie qui donne de l'essence d'obsidienne, sans un seau de lave en vue.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000070152.title: "Graines d'obsidienne"
	quest.4200000000070153.quest_desc: [
		"Essence haute. Les champs sont une industrie, maintenant.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000070153.title: "Imperium"
	quest.4200000000070154.quest_desc: [
		"Le dernier palier d'essence. Quoi que tu construises, c'est la bonne version.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"Surplus d'Essaim, empilé.",
		"Comment : quatre fioles de miel. Les fioles reviennent."
	]
	quest.4200000000070155.title: "Bloc de miel"
	quest.4200000000070156.quest_desc: [
		"Une abeille qui n'existait pas avant que tu aies construit le nid.",
		"Mineuse, maçonne, fouisseuse, charpentière — regarde-en une.",
		"Comment : regarde une Productive Bee après qu'un nid se réveille. Premières ailes, c'est le nid de chêne."
	]
	quest.4200000000070156.quest_subtitle: "Colonie"
	quest.4200000000070156.title: "Quelque chose de neuf bourdonne"
	quest.4200000000070157.quest_desc: [
		"Du sable autour d'une fleur. Mineuses cendrées et au chocolat.",
		"Comment : anneau du matériau du nid autour d'une petite fleur. Pose-le, puis clic droit avec une petite fleur pour le réveiller ; les abeilles sortent au bout d'un moment."
	]
	quest.4200000000070157.title: "Anneau de sable"
	quest.4200000000070158.quest_desc: [
		"Canne à sucre autour d'une fleur. Abeilles des roseaux et maçonnes.",
		"Comment : anneau du matériau du nid autour d'une petite fleur. Pose-le, puis clic droit avec une petite fleur pour le réveiller ; les abeilles sortent au bout d'un moment."
	]
	quest.4200000000070158.title: "Anneau de roseau"
	quest.4200000000070159.quest_desc: [
		"Des blocs de slime autour d'une fleur. Devine.",
		"Comment : anneau du matériau du nid autour d'une petite fleur. Pose-le, puis clic droit avec une petite fleur pour le réveiller ; les abeilles sortent au bout d'un moment."
	]
	quest.4200000000070159.title: "Anneau de slime"
	quest.420000000007015A.quest_desc: [
		"Du foin autour d'une fleur. Des bourdons, et des abeilles ordinaires aussi.",
		"Comment : anneau du matériau du nid autour d'une petite fleur. Pose-le, puis clic droit avec une petite fleur pour le réveiller ; les abeilles sortent au bout d'un moment."
	]
	quest.420000000007015A.title: "Anneau de foin"
	quest.420000000007015B.quest_desc: [
		"De la neige autour d'une fleur. Des abeilles de la sueur, curieusement.",
		"Comment : anneau du matériau du nid autour d'une petite fleur. Pose-le, puis clic droit avec une petite fleur pour le réveiller ; les abeilles sortent au bout d'un moment."
	]
	quest.420000000007015B.title: "Anneau de neige"
	quest.420000000007015C.quest_desc: [
		"Brûle du miel pour l'énergie. Une ruche qui fait double service.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.420000000007015C.title: "Générateur de miel"
	quest.420000000007015D.quest_desc: [
		"Expose une abeille, ailes comprises, sans ruche attachée.",
		"Comment : les crafts de Productive Bees sont dans JEI. Essaim nomme la ruche, la centrifugeuse et les étapes d'élevage."
	]
	quest.420000000007015D.title: "Bocal"
	quest.420000000007015E.quest_desc: [
		"Calme une ruche pleine d'abeilles avant que tu ailles chercher du rayon de miel.",
		"Comment : bûches, bâtons, et charbon ou charbon de bois."
	]
	quest.420000000007015E.title: "Feu de camp (Essaim)"
	quest.420000000007015F.quest_desc: [
		"Nourrit les abeilles et fleurit deux fois l'an, toujours vert le reste du temps.",
		"Comment : mousse plus chêne, ou de la poudre d'os sur la mousse. Les abeilles acceptent la fleur."
	]
	quest.420000000007015F.title: "Azalée fleurie (Essaim)"
	quest.4200000000070160.quest_desc: [
		"Haut, jaune, et toujours tourné vers le soleil. Les abeilles le trouvent facilement.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000070160.title: "Tournesol"
	quest.4200000000070161.quest_desc: [
		"Deux blocs de floraison violette que les abeilles traverseront une plateforme pour atteindre.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000070161.title: "Lilas"
	quest.4200000000070162.quest_desc: [
		"Une grande fleur que les abeilles préfèrent, et une couleur de plus pour le jardin.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000070162.title: "Rosier"
	quest.4200000000070163.quest_desc: [
		"Rose et pleine, plantée là où une ruche a besoin de plus de butinage tout près.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000070163.title: "Pivoine"
	quest.4200000000070164.quest_desc: [
		"Une fleur courte et seule, mais les abeilles se moquent de la hauteur.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000070164.title: "Tulipe orange"
	quest.4200000000070165.quest_desc: [
		"Un nid que tu as construit, une ruche que tu as déplacée, une centrifugeuse, un incubateur, des champs d'essence.",
		"Mets le Brin en tension : les Gardiens de la colonie répondent.",
		"Réclame-le et choisis un cadeau de la tribu : un Fil du Retour pour une vie partagée de plus, ou des fournitures.",
		"Comment : termine les quêtes liées à celle-ci, puis réclame-la pour le jeton de Brin. Assieds le jeton à ton Poteau de tension."
	]
	quest.4200000000070165.quest_subtitle: "Colonie"
	quest.4200000000070165.title: "Nœud d'Essaim"
	quest.4200000000070166.quest_desc: [
		"Clic droit sur le Poteau de tension de ton Clowder avec le jeton.",
		"L'encoche s'allume, la tribu sonne, la plateforme change.",
		"Comment : clic droit sur ton Poteau de tension avec le jeton de Brin en main."
	]
	quest.4200000000070166.title: "Assieds Essaim"
	quest.4200000000070167.quest_desc: [
		"Tu as tué une abeille.",
		"Les Gardiens de la colonie voudraient te parler. Voici une fiole ; réfléchis-y.",
		"Comment : tue une abeille (caché). La fiole est la leçon."
	]
	quest.4200000000070167.title: "Regret"
	quest.4200000000080168.quest_desc: [
		"Les intendants ont laissé des tours dans le cristal. Trente-deux éclats.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : tamis, ou améthyste bourgeonnante si tu fais pousser une ligne de géodes. Occultism veut des éclats."
	]
	quest.4200000000080168.title: "Améthyste"
	quest.4200000000080169.quest_desc: [
		"Clic droit sur le Poteau de tension en tenant 16 Filaments de Brin. Aucun Brin n'a à être assis.",
		"Lier commence ici.",
		"Comment : clic droit sur le Poteau de tension en tenant 16 Filaments de Brin. Tamise du gravier ou du sable avec une maille de Fil en fer pour les trouver."
	]
	quest.4200000000080169.title: "Cordon de tresse"
	quest.420000000008016A.quest_desc: [
		"Écris le rite avant de le graver.",
		"Comment : livre, poche d'encre, plume. Du charbon de bois plus une fiole font l'encre."
	]
	quest.420000000008016A.title: "Livre et plume"
	quest.420000000008016B.quest_desc: [
		"Pouvoir doux pour outils durs.",
		"Comment : deux diamants, quatre obsidienne, livre. Les diamants viennent du gravier à maille de fer."
	]
	quest.420000000008016B.title: "Table d'enchantement (Sceau)"
	quest.420000000008016C.quest_desc: [
		"Alimente la table.",
		"Comment : neuf lapis-lazuli. Tamise le gravier, ou du minerai de lapis-lazuli au Bris d'écho."
	]
	quest.420000000008016C.title: "Bloc de lapis-lazuli"
	quest.420000000008016D.quest_desc: [
		"Entoure une table d'enchantement pour ouvrir ses enchantements les plus forts.",
		"Comment : six planches et trois livres. Les livres, c'est papier plus cuir."
	]
	quest.420000000008016D.title: "Bibliothèque"
	quest.420000000008016E.quest_desc: [
		"Soigne en profondeur et donne un éclat qui s'efface au bout d'une minute.",
		"Comment : huit d'or autour d'une pomme. Pas l'enchantée."
	]
	quest.420000000008016E.title: "Pomme dorée"
	quest.420000000008016F.quest_desc: [
		"Saute la chute.",
		"Comment : endermen, ou l'étal des Marche-lisières à /clowder hub."
	]
	quest.420000000008016F.title: "Perle de l'Ender"
	quest.4200000000080170.quest_desc: [
		"Transforme des fioles d'eau en quelque chose qui a un vrai effet.",
		"Comment : bâton de Blaze au-dessus de trois roches. Le bâton vient d'une forteresse du Nether, après l'obsidienne de Griffe."
	]
	quest.4200000000080170.title: "Alambic"
	quest.4200000000080171.quest_desc: [
		"La chaleur des potions.",
		"Comment : fabrique-le à partir d'un bâton de Blaze, ou prends-le dans une forteresse après l'obsidienne de Griffe."
	]
	quest.4200000000080171.title: "Poudre de Blaze"
	quest.4200000000080172.quest_desc: [
		"Alimente l'alambic et prouve que tu as déjà affronté le Nether.",
		"Comment : forteresse du Nether après l'obsidienne de Griffe. Les potions veulent un bâton ; Ars et Occultism n'attendent pas."
	]
	quest.4200000000080172.title: "Bâton de Blaze"
	quest.4200000000080173.quest_desc: [
		"Tord l'effet d'une potion vers quelque chose de pire, exprès.",
		"Comment : œil d'araignée, champignon brun, sucre."
	]
	quest.4200000000080173.title: "Œil fermenté"
	quest.4200000000080174.quest_desc: [
		"Poudre de pierre lumineuse pour les recettes.",
		"Comment : tamise du sable des âmes, ou des sorcières sur la plateforme."
	]
	quest.4200000000080174.title: "Poudre de pierre lumineuse (Sceau)"
	quest.4200000000080175.quest_desc: [
		"Souffle de ce qui garde l'End.",
		"Comment : fiole de verre sur le dragon. L'île de l'End a disparu. Facultatif."
	]
	quest.4200000000080175.title: "Souffle de dragon"
	quest.4200000000080176.quest_desc: [
		"Une chance de plus.",
		"Facultatif — aucun raid n'atteint la plateforme, et le pack n'en fabrique pas.",
		"Comment : récompenses de quêtes seulement. Assieds Horloge et Assieds Sceau en donnent un chacun, et les cadeaux des Nœuds de Brin tardifs en offrent davantage. Les raids et les évocateurs n'arrivent jamais sur la plateforme. Facultatif."
	]
	quest.4200000000080176.title: "Totem"
	quest.4200000000080177.quest_desc: [
		"Stocke la Source, le carburant que les sorts brûlent.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.4200000000080177.title: "Gemme source"
	quest.4200000000080178.quest_desc: [
		"Cultivé, pas trouvé. Du bois pour les outils d'incantation et les piédestaux de sorts.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.4200000000080178.title: "Bois arcanique"
	quest.4200000000080179.quest_desc: [
		"Premiers sorts. Une magie du même rang, si tu la veux à côté des rites.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.4200000000080179.title: "Livre de sorts novice"
	quest.420000000008017A.quest_desc: [
		"Une culture arcanique, cultivée autant pour son tissu que pour sa magie.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008017A.title: "Magefleur"
	quest.420000000008017B.quest_desc: [
		"Brasero pour le travail rituel.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008017B.title: "Brasero rituel"
	quest.420000000008017C.quest_desc: [
		"Expose un réactif et l'envoie au rituel qui en a besoin.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008017C.title: "Piédestal arcanique"
	quest.420000000008017D.quest_desc: [
		"Écris sorts et pages.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008017D.title: "Table des scribes"
	quest.420000000008017E.quest_desc: [
		"Imprègne les réactifs de source.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008017E.title: "Chambre d'imprégnation"
	quest.420000000008017F.quest_desc: [
		"Stocke de la Source en plus, pour qu'un sort ne tombe pas à sec en plein lancer.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008017F.title: "Pot source"
	quest.4200000000080180.quest_desc: [
		"Appelle les esprits par leur nom.",
		"Comment : un livre et des Graines de rêve de démon, sans forme. Lis-le ; le Feu spirituel vient ensuite."
	]
	quest.4200000000080180.title: "Dictionnaire d'Occultism"
	quest.4200000000080181.quest_desc: [
		"Une flamme froide pour les rituels que le feu ordinaire ne finit pas.",
		"Comment : allume le Feu spirituel comme le montre le Dictionnaire des esprits (Ça brûle !), puis jette de l'andésite dedans."
	]
	quest.4200000000080181.title: "Feu spirituel"
	quest.4200000000080182.quest_desc: [
		"Un focus pour l'invocation. Les rites sont patients.",
		"Comment : de l'or autour d'un bol sacrificiel. Le dictionnaire nomme le rituel."
	]
	quest.4200000000080182.title: "Bol sacrificiel doré"
	quest.4200000000080183.quest_desc: [
		"Le cœur de la fabrication fondée sur l'aura, accordé à la terre autour.",
		"Comment : Rituel de la forêt (JEI) : trois pierres, une Feuille d'or, un lingot d'or et un Jeton de joie. Ligne du Cœur de l'aura."
	]
	quest.4200000000080183.title: "Autel de la Nature"
	quest.4200000000080184.quest_desc: [
		"Une plante imprégnée d'une aura haute, filée en quelque chose de plus rare.",
		"Comment : quatre feuilles et quatre pépites d'or autour d'herbe courte font quatre Fibres brillantes. Place-la dans la couronne d'un arbre ; ses feuilles deviennent dorées avec le temps."
	]
	quest.4200000000080184.title: "Fibres Brillantes"
	quest.4200000000080185.quest_desc: [
		"Matériau touché par l'aura, plus précieux qu'il n'en a l'air, posé par terre.",
		"Comment : casse les feuilles dorées issues de la Fibre brillante."
	]
	quest.4200000000080185.title: "Feuilles Brillantes"
	quest.4200000000080186.quest_desc: [
		"Du fer qui a bu l'aura ambiante, jusqu'à valoir plus que le minerai.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000080186.title: "Fer imprégné"
	quest.4200000000080187.quest_desc: [
		"Te laisse voir le niveau d'aura de la terre autour de toi.",
		"Comment : Feuille d'or + œil d'araignée. Montre l'aura locale."
	]
	quest.4200000000080187.title: "Œil"
	quest.4200000000080188.quest_desc: [
		"Un jeton de joie. L'Autel naturel et l'Absorbeur herbivore se bâtissent dessus.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000080188.title: "Insigne de Joie"
	quest.4200000000080189.quest_desc: [
		"Stock de parchemin de sort.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.4200000000080189.title: "Parchemin de sort"
	quest.420000000008018A.quest_desc: [
		"Marque un lieu où revenir par un mot, pas par une marche.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008018A.title: "Parchemin de distorsion"
	quest.420000000008018B.quest_desc: [
		"Plante-la, soigne-la, et récolte un tissu imbibé de magie basse.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008018B.title: "Culture de fleur de mage"
	quest.420000000008018C.quest_desc: [
		"La page vide sur laquelle un sort s'écrit.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.420000000008018C.title: "Glyphe vierge"
	quest.420000000008018D.quest_desc: [
		"Lance des sorts de combat sans jamais toucher une baguette.",
		"Comment : trois chaînes, quatre cuirs et deux papiers. Le chapitre Sorts nomme l'encre."
	]
	quest.420000000008018D.title: "Livre de sorts d'Iron"
	quest.420000000008018E.quest_desc: [
		"Le carburant que les lanceurs brûlent, sort après sort.",
		"Comment : tue des lanceurs ou fabrique ce que liste JEI. Carburant pour l'encre et les livres."
	]
	quest.420000000008018E.title: "Essence arcanique"
	quest.420000000008018F.quest_desc: [
		"Inscrit un sort dans un livre, un palier à la fois.",
		"Comment : fiole + essence + teinture. La première encre d'inscription."
	]
	quest.420000000008018F.title: "Encre commune"
	quest.4200000000080190.quest_desc: [
		"Couleur pour les rites.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000080190.title: "Fleur mystique"
	quest.4200000000080191.quest_desc: [
		"Écho des profondeurs obscures.",
		"Facultatif — le vide peut ne jamais t'en offrir un.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000080191.title: "Éclat d'écho"
	quest.4200000000080192.quest_desc: [
		"Une tresse filée, des potions embouteillées, des sorts et des esprits appelés.",
		"Mets le Brin sous tension : les Graveurs de sceaux répondent.",
		"Réclame-le et choisis un cadeau de la tribu : un Fil du Retour pour une vie partagée de plus, ou des fournitures.",
		"Comment : termine les quêtes liées à celle-ci, puis réclame-la pour le jeton de Brin. Assieds le jeton à ton Poteau de tension."
	]
	quest.4200000000080192.quest_subtitle: "Lier"
	quest.4200000000080192.title: "Nœud de Sceau"
	quest.4200000000080193.quest_desc: [
		"Clic droit sur le Poteau de tension de ton Clowder avec le jeton.",
		"L'encoche s'allume, la tribu sonne, la plateforme change.",
		"Récompense rare : une vie partagée de Clowder, une seule fois pour toute l'équipe. Seulement six récompenses de ce genre existent dans la campagne.",
		"Comment : clic droit sur ton Poteau de tension avec le jeton de Brin en main."
	]
	quest.4200000000080193.title: "Assieds le Sceau"
	quest.4200000000080194.quest_desc: [
		"Une pomme que les intendants n'ont jamais mangée. Toi non plus, probablement.",
		"Comment : pas une fabrication de la plateforme. Secret facultatif — il ne conditionne pas le Nœud de Sceau."
	]
	quest.4200000000080194.title: "Vieil or"
	quest.4200000000090195.quest_desc: [
		"Une maille de fer, du gravier ou du sable, de la patience.",
		"Le Filament de Brin est le fil propre du Métier à tisser. La tresse se file à partir de lui.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : maille de Fil (fer) sur gravier, sable ou poussière (Cadre de métier ou tamis)."
	]
	quest.4200000000090195.title: "File le Filament"
	quest.4200000000090196.quest_desc: [
		"Seize Filaments, un clic droit sur le Poteau de tension.",
		"La ligature a commencé ; on commence ici à retisser.",
		"Comment : clic droit sur le Poteau de tension en tenant 16 Filaments de Brin. Tamise du gravier ou du sable avec une maille de Fil en fer pour les trouver."
	]
	quest.4200000000090196.title: "Épisse une tresse"
	quest.4200000000090197.quest_desc: [
		"Quartz Certus — le fil froid d'un métier à tisser numérique.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.4200000000090197.title: "Trame froide"
	quest.4200000000090198.quest_desc: [
		"Du quartz broyé, le matériau de base dont on bâtit le métier à tisser numérique.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.4200000000090198.title: "Poussière de Certus"
	quest.4200000000090199.quest_desc: [
		"Le bloc coque de chaque machine du réseau, extrait des gisements de Certus.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.4200000000090199.title: "Pierre de ciel"
	quest.420000000009019A.quest_desc: [
		"Fluix — certus, quartz et redstone chargés dans l'eau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.420000000009019A.title: "Chaîne chargée"
	quest.420000000009019B.quest_desc: [
		"Un mélange de quartz, de redstone et de verre, broyé fin pour fabriquer sur le réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.420000000009019B.title: "Poussière de Fluix"
	quest.420000000009019C.quest_desc: [
		"Du silicium pour les processeurs d'AE2.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.420000000009019C.title: "Silicone"
	quest.420000000009019D.quest_desc: [
		"L'inscripteur presse les circuits comme le Métier à tisser presse le tissu.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.420000000009019D.title: "Presse le motif"
	quest.420000000009019E.quest_desc: [
		"Estampille une plaque de silicium comme le Métier à tisser presse le tissu.",
		"Comment : bloc de fer, Nœud liant, fer et quartz. AE2 ne duplique qu'une presse que tu as déjà."
	]
	quest.420000000009019E.title: "Matrice de presse de silicone"
	quest.420000000009019F.quest_desc: [
		"Estampille la matrice d'un processeur logique, une frappe à la fois.",
		"Comment : bloc de fer, Nœud liant, fer et or. La première copie est l'artisanat du Nœud."
	]
	quest.420000000009019F.title: "Presse logique"
	quest.42000000000901A0.quest_desc: [
		"Estampille la matrice d'un processeur de calcul.",
		"Comment : bloc de fer, Nœud liant, fer et certus (tamis, sable). La première copie est l'artisanat du Nœud."
	]
	quest.42000000000901A0.title: "Presse de calcul"
	quest.42000000000901A1.quest_desc: [
		"Fabrication de la matrice d'ingénierie.",
		"Comment : bloc de fer, Nœud liant, fer et diamant. La première copie est l'artisanat du Nœud."
	]
	quest.42000000000901A1.title: "Presse d'ingénierie"
	quest.42000000000901A2.quest_desc: [
		"Processeur logique pour AE2.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901A2.title: "Processeur logique"
	quest.42000000000901A3.quest_desc: [
		"Un composant des modèles d'auto-fabrication, fait de silicium et de quartz certus.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901A3.title: "Processeur de calcul"
	quest.42000000000901A4.quest_desc: [
		"Un processeur plus dense, nécessaire aux pièces plus exigeantes du réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901A4.title: "Processeur d'ingénierie"
	quest.42000000000901A5.quest_desc: [
		"Abrite les cellules qui gardent tout ce dont le réseau se souvient.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901A5.title: "Range-disque ME"
	quest.42000000000901A6.quest_desc: [
		"La coque dans laquelle se construit une cellule de stockage.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901A6.title: "Boîtier de cellule d'objets"
	quest.42000000000901A7.quest_desc: [
		"Le premier coffre numérique.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901A7.title: "Cellule d'objets 1k"
	quest.42000000000901A8.quest_desc: [
		"Vois le réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901A8.title: "Terminal ME"
	quest.42000000000901A9.quest_desc: [
		"Te laisse fabriquer directement à partir de ce que le réseau tient déjà.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901A9.title: "Terminal de fabrication"
	quest.42000000000901AA.quest_desc: [
		"Le contrôleur. Veut un Nœud liant en son centre.",
		"Cœur de Fuseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901AA.title: "Métier numérique"
	quest.42000000000901AB.quest_desc: [
		"Utilise-le à mains vides et joue le Rite de la porte : frappe les temps qui tombent sur A, S, D, F. Atteins 60% et il s'ouvre ; pas besoin de Pouls.",
		"Comment : utilise le Tambour de porte à mains vides et joue le Rite de la porte : frappe les temps qui tombent sur A, S, D, F. Atteins 60% et il s'ouvre ; pas besoin de Pouls. Lie d'abord une boussole de retour."
	]
	quest.42000000000901AB.title: "Tambour de porte"
	quest.42000000000901AC.quest_desc: [
		"Un appui venu d'au-delà de la porte. Ramènes-en un.",
		"Comment : fais fondre la Roche de la Marche. Mine-la dans la Marche, par un Tambour de porte."
	]
	quest.42000000000901AC.title: "Pierre de la Marche"
	quest.42000000000901AD.quest_desc: [
		"Porte les canaux du réseau d'une machine à la suivante.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901AD.title: "Câble de Fluix"
	quest.42000000000901AE.quest_desc: [
		"Tire les objets vers le stockage.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901AE.title: "Bus d'importation"
	quest.42000000000901AF.quest_desc: [
		"Pousse les objets hors du réseau, dans un coffre ou une machine.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901AF.title: "Bus d'exportation"
	quest.42000000000901B0.quest_desc: [
		"Lit un inventaire extérieur dans le réseau, comme si c'était une cellule.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B0.title: "Bus de stockage"
	quest.42000000000901B1.quest_desc: [
		"Ajoute de la capacité de fabrication en masse à l'auto-fabrication du réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B1.title: "Unité de fabrication"
	quest.42000000000901B2.quest_desc: [
		"Fait tourner plus de tâches de fabrication en même temps.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B2.title: "Unité de co-traitement"
	quest.42000000000901B3.quest_desc: [
		"Garde des modèles où le réseau puise pendant qu'il fabrique.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B3.title: "Disque 1k pour la fabrication"
	quest.42000000000901B4.quest_desc: [
		"Alimente les machines en motifs, comme un métier à tisser alimente la navette en fil.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B4.title: "Fournisseur de motifs"
	quest.42000000000901B5.quest_desc: [
		"Construit à partir de motifs. Veut un Cordon de tresse en son cœur.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B5.title: "Assembleur moléculaire"
	quest.42000000000901B6.quest_desc: [
		"Un motif vide, qui attend qu'on y encode une recette.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B6.title: "Modèle vide"
	quest.42000000000901B7.quest_desc: [
		"Envoie de l'énergie dans le métier numérique.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B7.title: "Acceptateur énergétique"
	quest.42000000000901B8.quest_desc: [
		"Brûle pour AE — branche d'énergie facultative.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B8.title: "Chambre de vibration"
	quest.42000000000901B9.quest_desc: [
		"Une cellule de stockage avec plus de place que la taille d'avant.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901B9.title: "Cellule d'objets 4k"
	quest.42000000000901BA.quest_desc: [
		"Contient bien plus que n'importe quel coffre, la cellule la plus dense avant que le lecteur se remplisse.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901BA.title: "Cellule d'objets 16k"
	quest.42000000000901BB.quest_desc: [
		"La coque dans laquelle se construit une cellule de fluide.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901BB.title: "Boîtier de cellule de fluide"
	quest.42000000000901BC.quest_desc: [
		"Un réservoir numérique, qui stocke un liquide que le réseau peut tirer de n'importe où.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901BC.title: "Cellule de fluide 1k"
	quest.42000000000901BD.quest_desc: [
		"Pose des blocs venus du réseau comme le ferait une main, sans en avoir une.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901BD.title: "Plan de formation"
	quest.42000000000901BE.quest_desc: [
		"Casse les blocs devant lui et les envoie dans le réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901BE.title: "Plan d'annihilation"
	quest.42000000000901BF.quest_desc: [
		"Redstone du réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901BF.title: "Émetteur de niveau"
	quest.42000000000901C0.quest_desc: [
		"Relie le réseau au monde, et échange des objets par-dessus le bord.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901C0.title: "Interface"
	quest.42000000000901C1.quest_desc: [
		"Relie deux réseaux sur une distance que le câble ordinaire n'atteint pas.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901C1.title: "Anneau quantique"
	quest.42000000000901C2.quest_desc: [
		"La moitié appariée d'un anneau quantique, qui noue deux réseaux ensemble.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901C2.title: "Lien quantique"
	quest.42000000000901C3.quest_desc: [
		"Atteint le réseau de n'importe où à portée, sans câble sous les pieds.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901C3.title: "Terminal sans fil"
	quest.42000000000901C4.quest_desc: [
		"Copie les réglages d'une machine sur une autre sans les retaper.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901C4.title: "Carte mémoire"
	quest.42000000000901C5.quest_desc: [
		"Outil réseau pour AE2.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901C5.title: "Outil de réseau"
	quest.42000000000901C6.quest_desc: [
		"Charge le quartz certus jusqu'à ce qu'il soit prêt pour un ouvrage plus fin.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901C6.title: "Chargeur"
	quest.42000000000901C7.quest_desc: [
		"Accélère un bourgeon de cristal en croissance vers une grappe de pleine taille.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000000901C7.title: "Accélérateur de croissance des cristaux"
	quest.42000000000901C8.quest_desc: [
		"Preuve de la canopée de la Marche — souvenir facultatif, quand tu retisses.",
		"Comment : pousse à l'état sauvage dans la Marche, attend dans les coffres du barrage de roseaux, et un Ancien des Lie-racines l'échange."
	]
	quest.42000000000901C8.title: "Roseau d'esprit"
	quest.42000000000901C9.quest_desc: [
		"Une tresse, un métier numérique, une porte, une pierre de la Marche.",
		"Tends le neuvième Brin. Puis le Fragment, puis le Poteau.",
		"Réclame-le et choisis un cadeau de la tribu : un Fil du Retour pour une vie partagée de plus, ou des fournitures.",
		"Comment : termine les quêtes liées à celle-ci, puis réclame-la pour le jeton de Brin. Assieds le jeton à ton Poteau de tension."
	]
	quest.42000000000901C9.quest_subtitle: "Retisser"
	quest.42000000000901C9.title: "Nœud de Fuseau"
	quest.42000000000901CA.quest_desc: [
		"Clic droit sur le Poteau de tension de ton Clowder avec le jeton.",
		"L'encoche s'allume, la tribu sonne, la plateforme change.",
		"Comment : clic droit sur ton Poteau de tension avec le jeton de Brin en main."
	]
	quest.42000000000901CA.title: "Assieds Fuseau"
	quest.42000000000901CB.quest_desc: [
		"Neuf assis, une pierre de la Marche, un clic droit sur le Poteau : le Fragment.",
		"Assieds-le. La coupe se referme au-dessus de ta plateforme.",
		"Comment : neuf jetons assis, puis clic droit sur le Poteau avec la Pierre de la Marche."
	]
	quest.42000000000901CB.quest_subtitle: "Retisser"
	quest.42000000000901CB.title: "Fragment du métier"
	quest.42000000000901CC.quest_desc: [
		"Assieds le Fragment au Poteau de tension.",
		"Neuf tribus, un fil. Va voir ce que la Marche t'a gardé.",
		"Récompense rare : une vie partagée de Clowder, une seule fois pour toute l'équipe. Seulement six récompenses de ce genre existent dans la campagne.",
		"Comment : assieds le Fragment du métier de Fuseau au Poteau de tension. Le progrès se déclenche quand le ciel se referme."
	]
	quest.42000000000901CC.quest_subtitle: "La coupe, fermée"
	quest.42000000000901CC.title: "Retisser"
	quest.42000000000901CD.quest_desc: [
		"Un Wither, sur une plateforme, dans le ciel. Les Couseurs du métier auraient été impressionnés, puis furieux.",
		"Comment : Wither (trois crânes sur du sable des âmes), ou l'étal des Cœurs-tambours à /clowder hub une fois, pour 12 Rouleaux de Fil (972 Fil). Trophée facultatif — il ne bloque ni l'End ni la Ferme de monstres à 100%."
	]
	quest.42000000000901CD.title: "Une étoile, tant bien que mal"
	quest.42000000000A01CE.quest_desc: [
		"Les feuilles lâchent plus de pousses.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01CE.title: "Bases de la crosse"
	quest.42000000000A01CF.quest_desc: [
		"Tamise plus vite que la crosse en bois, et dure bien plus longtemps.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01CF.title: "Bone Crook"
	quest.42000000000A01D0.quest_desc: [
		"La maille la plus simple. Tout ce que tu tamises commence par passer ici.",
		"Comment : neuf ficelles en 3x3. L'étal des Chanteurs de gravier vend la maille de Fil (ficelle) du Métier du vide, qui tamise pareil."
	]
	quest.42000000000A01D0.title: "String Mesh"
	quest.42000000000A01D1.quest_desc: [
		"Attrape des éclats plus fins que la ficelle. Moins de chutes filent à travers le tissage.",
		"Comment : quatre silex et cinq ficelles en damier. Le silex vient du gravier, ou de Fil + gravier."
	]
	quest.42000000000A01D1.title: "Maille de silex (tamis)"
	quest.42000000000A01D2.quest_desc: [
		"Les fils de fer attrapent un gravillon plus lourd et tirent des chutes plus rares du tas.",
		"Comment : quatre lingots de fer et cinq ficelles en damier. Aucun étal ne le vend."
	]
	quest.42000000000A01D2.title: "Maille de fer (tamis)"
	quest.42000000000A01D3.quest_desc: [
		"Maille de palier or. Les chances penchent vers les minerais qui comptent.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01D3.title: "Golden Mesh"
	quest.42000000000A01D4.quest_desc: [
		"Tamise du gravier avec ça, et les diamants sortent bien plus souvent.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01D4.title: "Diamond Mesh"
	quest.42000000000A01D5.quest_desc: [
		"La maille la plus fine qui soit. Rien ne tamise mieux que le fil de netherite.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01D5.title: "Netherite Mesh"
	quest.42000000000A01D6.quest_desc: [
		"Argile affinée et lisse, prête à cuire en un creuset qui tient une vraie chaleur.",
		"Comment : boule d'argile + poudre d'os, sans forme. L'argile vient du Tonneau de tension."
	]
	quest.42000000000A01D6.title: "Argile de porcelaine (tamis)"
	quest.42000000000A01D7.quest_desc: [
		"Argile de porcelaine formée en creuset. Cuis-le dans un fourneau.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01D7.title: "Creuset non cuit"
	quest.42000000000A01D8.quest_desc: [
		"Tient la chaleur de fusion sans se fendre. Fais fondre ce que le tamis a sorti.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01D8.title: "Porcelain Crucible"
	quest.42000000000A01D9.quest_desc: [
		"Éclabousse les cultures d'eau sans piétiner les rangs.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01D9.title: "Arrosoir en bois"
	quest.42000000000A01DA.quest_desc: [
		"Un jet plus large et un réservoir plus profond. Tu arroses plus de la plateforme à chaque trajet.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01DA.title: "Arrosoir en fer"
	quest.42000000000A01DB.quest_desc: [
		"Lâché sur les feuilles, il file de la soie en mangeant.",
		"Comment : casse des feuilles avec une crosse ; les vers à soie tombent de temps en temps."
	]
	quest.42000000000A01DB.title: "Silkworm"
	quest.42000000000A01DC.quest_desc: [
		"Eau étrange qui oriente les jeunes plants et les graines vers des cultures plus étranges.",
		"Comment : un tonneau d'eau sur du mycélium devient de l'eau de sorcière ; remplis-en un seau. Les spores de mycélium se tamisent à partir de la terre."
	]
	quest.42000000000A01DC.title: "Witch Water Bucket"
	quest.42000000000A01DD.quest_desc: [
		"Répands-les, et le mycélium rampe vers l'extérieur, bloc après bloc patient.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01DD.title: "Mycelium Spores"
	quest.42000000000A01DE.quest_desc: [
		"Jette-les sur la terre, et l'herbe s'étend sans attendre la pluie.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01DE.title: "Grass Seeds"
	quest.42000000000A01DF.quest_desc: [
		"Le gravillon qui remplace la roche. Renvoie-le au marteau pour en avoir plus.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01DF.title: "Stone Pebble"
	quest.42000000000A01E0.quest_desc: [
		"Neuf roches serrées en pierre de stockage, pour une plateforme qui grandit.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01E0.title: "Roche compressée"
	quest.42000000000A01E1.quest_desc: [
		"Brise la roche en gravier plus vite que n'importe quel marteau d'avant.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01E1.title: "Netherite Hammer"
	quest.42000000000A01E2.quest_desc: [
		"Pierre du Nether, broyée fin. Le basalte et la pierre noire commencent tous deux ici.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01E2.title: "Blackstone Pebble"
	quest.42000000000A01E3.quest_desc: [
		"Ardoise des abîmes réduite en gravillon, prête à nouveau pour le tamis.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01E3.title: "Deepslate Pebble"
	quest.42000000000A01E4.quest_desc: [
		"Pierre pâle tirée d'un tamisage profond, surtout bonne à bâtir.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01E4.title: "Calcite"
	quest.42000000000A01E5.quest_desc: [
		"Pierre grise des profondeurs, simple et facile à tailler.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000000A01E5.title: "Tuf"
	quest.42000000000A01E6.quest_desc: [
		"Il pousse lentement sous terre ; empile-le et laisse-le goutter de nouveau en stalactites.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000A01E6.title: "Spéléothème"
	quest.42000000000A01E7.quest_desc: [
		"Absorbe vite l'eau stagnante, pratique après une ferme inondée.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000A01E7.title: "Éponge"
	quest.42000000000B01E8.quest_desc: [
		"Relie le stockage autour en un seul réseau consultable.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : un tonneau en bois ou un coffre, deux comparateurs, des planches et de la pierre. Relie les tonneaux Sophisticated proches."
	]
	quest.42000000000B01E8.title: "Contrôleur de stockage"
	quest.42000000000B01E9.quest_desc: [
		"Un tonneau qui s'améliore : filtres, entonnoirs, aimants, vide.",
		"Comment : améliore un tonneau avec du cuivre. JEI nomme la fabrication."
	]
	quest.42000000000B01E9.title: "Tonneau en cuivre"
	quest.42000000000B01EA.quest_desc: [
		"Plus d'emplacements, plus de rangées d'améliorations.",
		"Comment : tonneaux et améliorations dans JEI. Le contrôleur relie un mur de tonneaux."
	]
	quest.42000000000B01EA.title: "Tonneau en fer"
	quest.42000000000B01EB.quest_desc: [
		"Aspire les objets lâchés droit dans le tonneau, de l'autre bout de la plateforme.",
		"Comment : tonneaux et améliorations dans JEI. Le contrôleur relie un mur de tonneaux."
	]
	quest.42000000000B01EB.title: "Amélioration magnétique avancée"
	quest.42000000000B01EC.quest_desc: [
		"Entre d'un côté, sort de l'autre, sans bloc entonnoir.",
		"Comment : tonneaux et améliorations dans JEI. Le contrôleur relie un mur de tonneaux."
	]
	quest.42000000000B01EC.title: "Amélioration d'entonnoir"
	quest.42000000000B01ED.quest_desc: [
		"Efface tout ce qui dépasse la capacité, pour que le tiroir ne se bloque jamais.",
		"Comment : tonneaux et améliorations dans JEI. Le contrôleur relie un mur de tonneaux."
	]
	quest.42000000000B01ED.title: "Amélioration du vide"
	quest.42000000000B01EE.quest_desc: [
		"Aspire les objets proches droit dans le stockage où elle est montée.",
		"Comment : tonneaux et améliorations dans JEI. Le contrôleur relie un mur de tonneaux."
	]
	quest.42000000000B01EE.title: "Amélioration de ramassage"
	quest.42000000000B01EF.quest_desc: [
		"Un emplacement, trié et visible. Le moyen le plus simple de stocker en vrac.",
		"Comment : bûches de chêne + coffre. Premier tiroir."
	]
	quest.42000000000B01EF.title: "Tiroir en chêne 1x1"
	quest.42000000000B01F0.quest_desc: [
		"Deux emplacements côte à côte, pour garder à part les objets semblables.",
		"Comment : tiroirs en chêne 1x1 / 1x2 / 2x2, puis tiroir compacteur et contrôleur. JEI nomme le craft."
	]
	quest.42000000000B01F0.title: "Tiroir en chêne 1x2"
	quest.42000000000B01F1.quest_desc: [
		"Quatre emplacements dans un cadre. Un stockage dense pour un faible encombrement.",
		"Comment : tiroirs en chêne 1x1 / 1x2 / 2x2, puis tiroir compacteur et contrôleur. JEI nomme le craft."
	]
	quest.42000000000B01F1.title: "Tiroir en chêne 2x2"
	quest.42000000000B01F2.quest_desc: [
		"Compacte tout seul son contenu en blocs, au fur et à mesure qu'il se remplit.",
		"Comment : tiroirs en chêne 1x1 / 1x2 / 2x2, puis tiroir compacteur et contrôleur. JEI nomme le craft."
	]
	quest.42000000000B01F2.title: "Compacting Drawer"
	quest.42000000000B01F3.quest_desc: [
		"Relie le stockage autour en un seul réseau consultable.",
		"Comment : tiroirs en chêne 1x1 / 1x2 / 2x2, puis tiroir compacteur et contrôleur. JEI nomme le craft."
	]
	quest.42000000000B01F3.title: "Contrôleur de stockage (Stockage)"
	quest.42000000000B01F4.quest_desc: [
		"Aspire les objets proches droit dans le tiroir.",
		"Comment : tiroirs en chêne 1x1 / 1x2 / 2x2, puis tiroir compacteur et contrôleur. JEI nomme le craft."
	]
	quest.42000000000B01F4.title: "Collector Upgrade"
	quest.42000000000B01F5.quest_desc: [
		"Tire les objets du coffre ou de la machine posée à côté.",
		"Comment : tiroirs en chêne 1x1 / 1x2 / 2x2, puis tiroir compacteur et contrôleur. JEI nomme le craft."
	]
	quest.42000000000B01F5.title: "Puller Upgrade"
	quest.42000000000B01F6.quest_desc: [
		"Pousse les objets stockés dans l'inventaire posé à côté.",
		"Comment : tiroirs en chêne 1x1 / 1x2 / 2x2, puis tiroir compacteur et contrôleur. JEI nomme le craft."
	]
	quest.42000000000B01F6.title: "Pusher Upgrade"
	quest.42000000000B01F7.quest_desc: [
		"Efface tout ce qui dépasse la capacité, pour que le tiroir ne se bloque jamais.",
		"Comment : tiroirs en chêne 1x1 / 1x2 / 2x2, puis tiroir compacteur et contrôleur. JEI nomme le craft."
	]
	quest.42000000000B01F7.title: "Amélioration du vide (Stockage)"
	quest.42000000000B01F8.quest_desc: [
		"Un inventaire portable qui libère la barre rapide et la place des poches.",
		"Comment : cuir + coffre. Puis améliorations fer/or/diamant."
	]
	quest.42000000000B01F8.title: "Sac à dos"
	quest.42000000000B01F9.quest_desc: [
		"Plus d'emplacements que le sac simple, et un emplacement pour l'améliorer.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B01F9.title: "Sac à dos en fer"
	quest.42000000000B01FA.quest_desc: [
		"Encore plus de place, avec des emplacements en rab pour des améliorations utiles.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B01FA.title: "Sac à dos en or"
	quest.42000000000B01FB.quest_desc: [
		"Les poches les plus profondes, avant que l'enchantement pousse le stockage encore plus loin.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B01FB.title: "Sac à dos en diamant"
	quest.42000000000B01FC.quest_desc: [
		"Aspire les objets proches droit dans le stockage où elle est montée.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B01FC.title: "Amélioration de ramassage (Stockage)"
	quest.42000000000B01FD.quest_desc: [
		"Filtre ce qui entre dans les sacs.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B01FD.title: "Module de filtre"
	quest.42000000000B01FE.quest_desc: [
		"Laisse le sac fabriquer à partir de ce qu'il a déjà en stock.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B01FE.title: "Module de l'établi"
	quest.42000000000B01FF.quest_desc: [
		"Te nourrit automatiquement avec ses réserves quand la faim baisse.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B01FF.title: "Module de nourriture"
	quest.42000000000B0200.quest_desc: [
		"Échange un outil cassé contre un neuf tiré du sac.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B0200.title: "Module de restock"
	quest.42000000000B0201.quest_desc: [
		"Vide le sac dans les coffres proches quand tu t'approches.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B0201.title: "Module de dépose"
	quest.42000000000B0202.quest_desc: [
		"Ajoute un réservoir de fluide dans le sac, pour transporter des liquides.",
		"Comment : sac en cuir, puis améliorations fer/or/diamant dans JEI."
	]
	quest.42000000000B0202.title: "Module de réservoir"
	quest.42000000000C0203.quest_desc: [
		"Le métal de base de la plupart des machines et des carcasses de cette ligne.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0203.title: "Lingot d'acier"
	quest.42000000000C0204.quest_desc: [
		"Le métal central de la plupart des câbles, des réservoirs et des premières machines.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0204.title: "Lingot d'osmium"
	quest.42000000000C0205.quest_desc: [
		"Un alliage dur, pressé à partir de poussière d'obsidienne, pour un équipement plus solide.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0205.title: "Obsidienne raffinée"
	quest.42000000000C0206.quest_desc: [
		"La carte logique la plus simple. La plupart des premières machines en demandent quelques-unes.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0206.title: "Circuit de contrôle de base"
	quest.42000000000C0207.quest_desc: [
		"Une carte logique plus affûtée, pour les machines un cran plus haut sur la ligne.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0207.title: "Circuit de contrôle avancé"
	quest.42000000000C0208.quest_desc: [
		"La carte logique la plus affûtée, réservée aux machines du haut de la ligne.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0208.title: "Circuit de contrôle d'élite"
	quest.42000000000C0209.quest_desc: [
		"Infuse les métaux de carbone, de redstone ou de poussière de diamant avant de les fondre.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0209.title: "Infuseur métallurgique"
	quest.42000000000C020A.quest_desc: [
		"Double la plupart des minerais bruts en deux poussières au lieu d'une.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C020A.title: "Chambre d'enrichissement"
	quest.42000000000C020B.quest_desc: [
		"Mouds ou broie des matériaux en vrac.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C020B.title: "Broyeur"
	quest.42000000000C020C.quest_desc: [
		"Fond les minerais à l'énergie plutôt qu'au combustible, et un peu plus vite.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C020C.title: "Fonderie électrique"
	quest.42000000000C020D.quest_desc: [
		"Purifie le minerai enrichi à l'oxygène pour un troisième produit, parfois plus.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C020D.title: "Chambre de purification"
	quest.42000000000C020E.quest_desc: [
		"Injecte du gaz dans le minerai, pour le rendement le plus riche de la ligne.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C020E.title: "Injection chimique"
	quest.42000000000C020F.quest_desc: [
		"Compresse la poussière d'osmium en lingots, plus vite qu'un fourneau seul.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C020F.title: "Compresseur d'osmium"
	quest.42000000000C0210.quest_desc: [
		"Un seul emplacement de pile, qui tient bien plus qu'un coffre.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0210.title: "Conteneur basique"
	quest.42000000000C0211.quest_desc: [
		"Stocke un bassin profond d'un seul fluide dans un seul bloc.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0211.title: "Réservoir de fluide de base"
	quest.42000000000C0212.quest_desc: [
		"Tamponne l'énergie entre les machines, pour que les à-coups n'arrêtent pas la ligne.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0212.title: "Cube énergétique de base"
	quest.42000000000C0213.quest_desc: [
		"Porte l'énergie aux machines. Le câble le plus courant de la plateforme.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0213.title: "Câble universel de base"
	quest.42000000000C0214.quest_desc: [
		"Déplace les fluides entre réservoirs et machines, le long de la plateforme.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0214.title: "Tuyau mécanique de base"
	quest.42000000000C0215.quest_desc: [
		"Déplace automatiquement les objets entre les inventaires reliés.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0215.title: "Transporteur logistique de base"
	quest.42000000000C0216.quest_desc: [
		"Tourne, sert de clé et reconfigure les faces des machines avec un seul outil.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0216.title: "Configurateur"
	quest.42000000000C0217.quest_desc: [
		"Sac à réaction Mek — poussée en option.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0217.title: "Jetpack"
	quest.42000000000C0218.quest_desc: [
		"Adoucit les dégâts de chute et t'achète une seconde avant que le vide te prenne.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0218.title: "Coureuses"
	quest.42000000000C0219.quest_desc: [
		"Un seul outil qui mine, coupe et se bat, plus affûté à chaque amélioration.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C0219.title: "Désassembleur atomique"
	quest.42000000000C021A.quest_desc: [
		"Le cadre structurel autour duquel se bâtissent la plupart des machines multiblocs.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C021A.title: "Boîtier en acier"
	quest.42000000000C021B.quest_desc: [
		"Relie deux points pour qu'en passant tu sautes le trajet entre les deux.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C021B.title: "Téléporteur"
	quest.42000000000C021C.quest_desc: [
		"Mine un large rayon tout seul et trie la récolte pour toi.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000000C021C.title: "Mineur digital"
	quest.42000000000D021D.quest_desc: [
		"Un ingrédient de base collant, à la source de la plupart des machines du réseau.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D021D.title: "Pâte diélectrique"
	quest.42000000000D021E.quest_desc: [
		"Stocke une mesure d'énergie.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D021E.title: "Condensateur basique"
	quest.42000000000D021F.quest_desc: [
		"Garde une réserve profonde d'énergie pour les machines alentour.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D021F.title: "Cellule d'énergie basique"
	quest.42000000000D0220.quest_desc: [
		"Brûle le combustible en énergie, mieux qu'un simple fourneau.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0220.title: "Brûleur basique"
	quest.42000000000D0221.quest_desc: [
		"Change la lave en énergie stable, tant qu'il reste de la lave.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0221.title: "Brûleur de magma basique"
	quest.42000000000D0222.quest_desc: [
		"Produit de l'énergie à la lumière du jour, davantage qu'une seule cellule toute seule.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0222.title: "Panneau solaire basique"
	quest.42000000000D0223.quest_desc: [
		"Produit de l'énergie à partir de l'écart de chaleur entre les blocs chauds et froids d'à côté.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0223.title: "Générateur thermique basique"
	quest.42000000000D0224.quest_desc: [
		"Brûle du combustible solide en continu, pour un filet d'énergie fort et fiable.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0224.title: "Réacteur basique"
	quest.42000000000D0225.quest_desc: [
		"Déplace plus d'énergie par tick que le câble de départ.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0225.title: "Câble d'énergie basique"
	quest.42000000000D0226.quest_desc: [
		"Te charge directement, sans câbles ni emplacements.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0226.title: "Transmetteur de joueur basique"
	quest.42000000000D0227.quest_desc: [
		"Envoie l'énergie dans les machines proches comme un entonnoir envoie les objets.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0227.title: "Entonnoir d'énergie basique"
	quest.42000000000D0228.quest_desc: [
		"Charge les cellules d'énergie plus vite lorsqu'il est posé à côté du montage de cristal.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0228.title: "Bâton d'énergie basique"
	quest.42000000000D0229.quest_desc: [
		"Une réserve d'énergie de poche, à porter à la main d'une machine à l'autre.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D0229.title: "Batterie basique"
	quest.42000000000D022A.quest_desc: [
		"Le premier palier de cristal pour la chambre à cellules du bâton d'énergie.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D022A.title: "Cristal niotique"
	quest.42000000000D022B.quest_desc: [
		"Un palier de cristal plus fort, plus loin dans la construction de la chambre d'énergie.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D022B.title: "Cristal fougueux"
	quest.42000000000D022C.quest_desc: [
		"Le plus fort palier de cristal que la chambre d'énergie peut contenir.",
		"Comment : chapitre Réseau Powah — orbe d'énergie et câbles, une fois le Pouls d'Étincelle là."
	]
	quest.42000000000D022C.title: "Cristal nitro"
	quest.42000000000E022D.quest_desc: [
		"Filée de la fleur de mage, puis tissée en robes et en attirail de sorts.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E022D.title: "Fibre de mage"
	quest.42000000000E022E.quest_desc: [
		"Une fleur qui, après la récolte, refait sa fibre sur la tige.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E022E.title: "Magefleur"
	quest.42000000000E022F.quest_desc: [
		"Stocke un bassin dense de Source, le combustible derrière chaque sort.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E022F.title: "Bloc de gemme source"
	quest.42000000000E0230.quest_desc: [
		"Contient plus de glyphes que le livre de départ n'en permet.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0230.title: "Livre de sorts d'apprenti"
	quest.42000000000E0231.quest_desc: [
		"Le plus grand livre de sorts, assez de place pour un arsenal entier de glyphes.",
		"Comment : Livre de sorts du mage, trois perles de l'Ender, deux émeraudes, un Totem d'immortalité, une Étoile du Nether et un Tribut wilden, sans forme. Totem : recette du pack, quatre blocs d'or et quatre émeraudes autour d'une pomme dorée."
	]
	quest.42000000000E0231.title: "Livre de sorts d'archimage"
	quest.42000000000E0232.quest_desc: [
		"Lance un sort lié automatiquement dès qu'il sent une cible.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0232.title: "Tourelle de sorts"
	quest.42000000000E0233.quest_desc: [
		"Lance son sort lié sur un minuteur régulier, pas à vue.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0233.title: "Tourelle de sorts de minuterie"
	quest.42000000000E0234.quest_desc: [
		"La pièce maîtresse pour fabriquer livres de sorts, baguettes et autre attirail arcanique.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0234.title: "Appareil enchanteur"
	quest.42000000000E0235.quest_desc: [
		"Se loge dans l'appareil d'enchantement et fait tourner ses recettes.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0235.title: "Noyau arcanique"
	quest.42000000000E0236.quest_desc: [
		"Porte la Source entre un point arcanique et un bocal ou un sort liés.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0236.title: "Relais"
	quest.42000000000E0237.quest_desc: [
		"Coupe une ligne de Source pour nourrir plusieurs endroits à la fois.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0237.title: "Séparateur de relais"
	quest.42000000000E0238.quest_desc: [
		"Convertit la croissance des cultures proches en un mince filet de Source.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0238.title: "Lien de Source agronomique"
	quest.42000000000E0239.quest_desc: [
		"Convertit la chaleur de la lave proche en un filet régulier de Source.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0239.title: "Lien source volcanique"
	quest.42000000000E023A.quest_desc: [
		"Invoque une wixie qui fabrique des recettes pour toi pendant que tu travailles ailleurs.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E023A.title: "Charm Wixie"
	quest.42000000000E023B.quest_desc: [
		"Invoque un starbuncle qui, sur ordre, va chercher des objets dans le stockage.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E023B.title: "Charme Starbuncle"
	quest.42000000000E023C.quest_desc: [
		"Invoque un drygmy qui génère lentement, à proximité, une ressource choisie.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E023C.title: "Charme Drygmée"
	quest.42000000000E023D.quest_desc: [
		"Invoque un whirlisprig qui soigne et fait pousser les cultures tout seul.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E023D.title: "Charme Tourbillon"
	quest.42000000000E023E.quest_desc: [
		"Invoque un golem qui récolte les bourgeons d'améthyste sans lever de pioche.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E023E.title: "Charm Golem d'améthyste"
	quest.42000000000E023F.quest_desc: [
		"Ramasse et pose des blocs à distance, et relie les machines entre elles de loin.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E023F.title: "Baguette du Dominion"
	quest.42000000000E0240.quest_desc: [
		"Marque un objet comme autorisé une fois mis dans un filtre.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0240.title: "Parchemin d'autorisation"
	quest.42000000000E0241.quest_desc: [
		"Marque un objet comme refusé une fois mis dans un filtre.",
		"Comment : Côté arcanique — bois arcanique et baie de source depuis la mousse, puis la cascade."
	]
	quest.42000000000E0241.title: "Parchemin de refus"
	quest.42000000000F0242.quest_desc: [
		"Des bûches autour d'un Nœud liant, du Fil par-dessus. Pose-le sur la plateforme.",
		"Reste près : la plateforme commence à te soigner une fois un Brin assis.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : des bûches autour d'un Nœud liant, du Fil par-dessus. Pose-le sur la plateforme. Regarde-le pour terminer."
	]
	quest.42000000000F0242.title: "Dresse le Poteau"
	quest.42000000000F0243.quest_desc: [
		"Clé du nexus en main, ou /clowder hub. Chaque Clowder du serveur se retrouve ici.",
		"/clowder return te ramène chez toi.",
		"Comment : Clé du nexus ou `/clowder hub`. `/clowder return` rentre à la maison."
	]
	quest.42000000000F0243.title: "Entre dans la Salle"
	quest.42000000000F0244.quest_desc: [
		"Au-dessus du Quai se dresse une lente colonne sombre : la coupe elle-même.",
		"Elle s'amincit à mesure que les Clowders asseyent des Brins. Reviens la vérifier de temps en temps.",
		"Comment : /clowder hub, lève les yeux vers la colonne sombre au-dessus du Quai, puis clique sur la coche."
	]
	quest.42000000000F0244.title: "Regarde l'Effilochure"
	quest.42000000000F0245.quest_desc: [
		"Mets une plateforme à ton nom.",
		"Comment : K ouvre le panneau de l'île. Tiens la Charte ; utilise-la accroupi sur le sol d'une plateforme de l'Overworld pour sceller l'apparition. Commence ici détaille les étapes."
	]
	quest.42000000000F0245.title: "Charte de l'île"
	quest.42000000000F0246.quest_desc: [
		"Ouvre le retour vers la Salle Clowder, de n'importe où sur le Brin.",
		"Comment : kit de départ / Salle. `/clowder hub` et la Clé du nexus vont à la Salle Clowder ; `/clowder return` rentre à la maison."
	]
	quest.42000000000F0246.title: "Clé du nexus"
	quest.42000000000F0247.quest_desc: [
		"Un motif de bannière qui marque jusqu'où est allé ton Brin.",
		"Comment : fabrique-le à la Salle ou dans JEI. Une marque de bannière, pas un jeton de Brin."
	]
	quest.42000000000F0247.title: "Bannière de Brin"
	quest.42000000000F0248.quest_desc: [
		"L'accent grave (`) ouvre la liste des tâches. Clic droit sur le Codex des Moustaches pour Commence ici. Même campagne ; pas de clic Maj sur le livre.",
		"Comment : un livre et n'importe quelle pierre, sans forme. L'accent grave (`) ouvre la même liste sans lui."
	]
	quest.42000000000F0248.title: "Liste des tâches"
	quest.42000000000F0249.quest_desc: [
		"Reste nourri pendant les sorties de revendication.",
		"Comment : huit pépites d'or autour d'une carotte. Les carottes sont un butin rare de zombies ; l'en-cas est optionnel."
	]
	quest.42000000000F0249.title: "En-cas de revendication"
	quest.42000000000F024A.quest_desc: [
		"Trace les plateformes autour de toi à mesure que ton Clowder s'étend vers l'extérieur.",
		"Comment : une boussole entourée de papier."
	]
	quest.42000000000F024A.title: "Carte"
	quest.42000000000F024B.quest_desc: [
		"Pointe vers le point d'apparition du monde ; utile quand les plateformes se multiplient.",
		"Comment : du fer autour de la redstone."
	]
	quest.42000000000F024B.title: "Boussole"
	quest.42000000000F024C.quest_desc: [
		"Ancre une boussole sur un point précis, au lieu du point d'apparition.",
		"Comment : un lingot de netherite dans des briques de pierre ciselées. Luxe tardif du Clowder."
	]
	quest.42000000000F024C.title: "Magnétite"
	quest.42000000000F024D.quest_desc: [
		"Pointe vers ta dernière mort, pour que rien ne reste perdu dans le vide.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000F024D.title: "Boussole de récupération"
	quest.42000000000F024E.quest_desc: [
		"Sonne assez fort pour rassembler tout le Clowder sur une plateforme.",
		"Comment : aucune recette. Le rituel Contacter l'esprit sauvage d'Occultism en fabrique un, mais il faut une chèvre, et les chèvres n'atteignent jamais la plateforme. Optionnel."
	]
	quest.42000000000F024E.title: "Cloche"
	quest.42000000000F024F.quest_desc: [
		"Tient un livre ouvert, pour que tout le Clowder le lise.",
		"Comment : des dalles de bois autour d'une bibliothèque."
	]
	quest.42000000000F024F.title: "Pupitre"
	quest.42000000000F0250.quest_desc: [
		"Étiquette un quartier pour que les nouveaux sachent quelle plateforme est laquelle.",
		"Comment : des planches sur un bâton."
	]
	quest.42000000000F0250.title: "Pancarte en chêne"
	quest.42000000000F0251.quest_desc: [
		"Une bannière vierge, prête à prendre les couleurs du Clowder.",
		"Comment : six laines sur un bâton."
	]
	quest.42000000000F0251.title: "Bannière blanche"
	quest.42000000000F0252.quest_desc: [
		"Bouclier prêt pour les bannières.",
		"Comment : six planches autour du fer. Blocage en main secondaire."
	]
	quest.42000000000F0252.title: "Bouclier prêt pour bannière"
	quest.42000000000F0253.quest_desc: [
		"Fais-les partir quand un Brin finit par se rassembler.",
		"Comment : du papier plus de la poudre à canon. Éclat optionnel."
	]
	quest.42000000000F0253.title: "Feu d'artifice"
	quest.42000000000F0254.quest_desc: [
		"Partage-le avec la Salle.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000F0254.title: "Tribut de cookies"
	quest.42000000000F0255.quest_desc: [
		"Nourriture à partager pour fêter un Brin bel et bien retissé.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000F0255.title: "Gâteau"
	quest.42000000000F0256.quest_desc: [
		"Disque de chat — humeur du paquet.",
		"Facultatif — le vide peut ne jamais t'en offrir un.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000F0256.title: "Disque de musique"
	quest.42000000000F0257.quest_desc: [
		"Ramène à la plateforme un animal apprivoisé ou acheté, sans le courir après.",
		"Comment : quatre ficelles autour d'une boule de slime. Le slime est le compost de la plateforme (terre, graines, poudre d'os)."
	]
	quest.42000000000F0257.title: "Laisse"
	quest.42000000000F0258.quest_desc: [
		"Monte quand tu trouves une selle.",
		"Facultatif — les Gardiens de la plateforme dans la Salle Clowder en vendent une.",
		"Comment : échange un bloc de diamant auprès des Gardiens de la plateforme, à leur boutique dans la Salle Clowder (/clowder hub). La Selle Chocobo est un objet différent."
	]
	quest.42000000000F0258.title: "Selle"
	quest.42000000000F0259.quest_desc: [
		"Pour le jour où quelqu'un construira une mer. Facultatif.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000000F0259.title: "Bateau"
	quest.4200000000110278.quest_desc: [
		"Montre où l'aura s'accumule, épaisse ou mince, à travers les terres.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : Feuille d'or + œil d'araignée. Montre l'aura locale."
	]
	quest.4200000000110278.title: "Œil (Aura)"
	quest.4200000000110279.quest_desc: [
		"Tissée d'or, elle sert à infuser les plantes d'une aura concentrée.",
		"Comment : quatre feuilles et quatre pépites d'or autour d'herbe courte font quatre Fibres brillantes. Place-la dans la couronne d'un arbre ; ses feuilles deviennent dorées avec le temps."
	]
	quest.4200000000110279.title: "Fibre brillante (Aura)"
	quest.420000000011027A.quest_desc: [
		"Un matériau raffiné pour les recettes de plus haut niveau de l'autel.",
		"Comment : casse les feuilles dorées issues de la Fibre brillante."
	]
	quest.420000000011027A.title: "Feuille d'or (Aura)"
	quest.420000000011027B.quest_desc: [
		"Des feuilles qui gardent une douce lueur dorée toute l'année.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011027B.title: "Feuille d'Or"
	quest.420000000011027C.quest_desc: [
		"Tient un ingrédient pour le Rituel de la forêt, posé autour d'une pousse d'arbre.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011027C.title: "Support en bois"
	quest.420000000011027D.quest_desc: [
		"L'autel où l'aura alimente des recettes de fabrication plus fortes.",
		"Comment : Rituel de la forêt (JEI) : trois pierres, une Feuille d'or, un lingot d'or et un Jeton de joie. Ligne du Cœur de l'aura."
	]
	quest.420000000011027D.title: "Autel naturel (Aura)"
	quest.420000000011027E.quest_desc: [
		"Fer chargé d'aura, un pas vers le Lingot des profondeurs.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011027E.title: "Fer imprégné (Aura)"
	quest.420000000011027F.quest_desc: [
		"Écorce ôtée d'arbres anciens, utile dans les recettes d'aura.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011027F.title: "Ecorce Ancienne"
	quest.4200000000110280.quest_desc: [
		"Un jeton de joie. L'Autel naturel et l'Absorbeur herbivore se bâtissent dessus.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110280.title: "Jeton de joie (Aura)"
	quest.4200000000110281.quest_desc: [
		"Un jeton de peur. Le Réducteur de canopée et l'Absorbeur persistant se fabriquent sur un.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110281.title: "Insigne de Peur"
	quest.4200000000110282.quest_desc: [
		"Un jeton de colère. Le Catalyseur d'effritement et la Marque de tir ont besoin d'un.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110282.title: "Insigne de Colère"
	quest.4200000000110283.quest_desc: [
		"Un jeton de chagrin. La Table d'offrande et le Démêleur des mortels ont besoin d'un.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110283.title: "Insigne de Chagrin"
	quest.4200000000110284.quest_desc: [
		"Esprit d'aura pour les rituels.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110284.title: "Esprit d'Appel"
	quest.4200000000110285.quest_desc: [
		"Esprit de naissance pour les rites d'aura.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110285.title: "Esprit de Naissance"
	quest.4200000000110286.quest_desc: [
		"Garde une réserve d'aura pour quand la terre s'appauvrit.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110286.title: "Trove d'Aura"
	quest.4200000000110287.quest_desc: [
		"Tard. Seulement si l'Aura le veut.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110287.title: "Catalyseur de création"
	quest.4200000000110288.quest_desc: [
		"Révèle l'aura et les conditions d'apparition sur une plus large étendue de terre.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110288.title: "Oculaire Environemental"
	quest.4200000000110289.quest_desc: [
		"Posé à côté de l'Autel naturel, il ouvre les recettes de broyage de l'autel.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110289.title: "Catalyseur en ruine"
	quest.420000000011028A.quest_desc: [
		"Posé à côté de l'Autel naturel, il ouvre les recettes de transmutation de l'autel.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011028A.title: "Catalyseur de transmutation"
	quest.420000000011028B.quest_desc: [
		"Lingots du ciel, or entaché et débris de netherite, pressés en Lingot des profondeurs.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011028B.title: "Ingot of the Depths"
	quest.420000000011028C.quest_desc: [
		"Marque un plan de ferme qui attire l'aura pour faire croître les cultures plus vite.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011028C.title: "Pochoir Agricole"
	quest.420000000011028D.quest_desc: [
		"Génère de l'aura chaque fois qu'un projectile atterrit à proximité.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011028D.title: "Marque de tir"
	quest.420000000011028E.quest_desc: [
		"Génère lentement de l'aura grâce aux fleurs qui éclosent à proximité.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011028E.title: "Absorbeur herbivore"
	quest.420000000011028F.quest_desc: [
		"Génère lentement de l'aura grâce aux chênes qui poussent à proximité.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.420000000011028F.title: "Réducteur de canopée"
	quest.4200000000110290.quest_desc: [
		"Une fleur de l'End, curieusement à l'aise sur une plateforme.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110290.title: "Rose de l'oubli"
	quest.4200000000110291.quest_desc: [
		"Éclaire une zone pour que les créatures hostiles n'y apparaissent pas.",
		"Comment : Fibre brillante sur les arbres → Feuille d'or → Autel naturel. Le chapitre Aura nomme les jetons et les générateurs."
	]
	quest.4200000000110291.title: "Lampe de sanctuaire"
	quest.4200000000120292.quest_desc: [
		"Cuit des plats façon ragoût qui remplissent plus d'une assiette à la fois.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000120292.title: "Marmite de cuisine (Cuisine)"
	quest.4200000000120293.quest_desc: [
		"La poêle fait sauter les plats.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000120293.title: "Poêle à frire"
	quest.4200000000120294.quest_desc: [
		"Cuisinière pour Farmer's Delight.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000120294.title: "Four"
	quest.4200000000120295.quest_desc: [
		"Découpe la viande et les légumes en ingrédients que d'autres recettes réclament.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000120295.title: "Planche à découper (Cuisine)"
	quest.4200000000120296.quest_desc: [
		"Panier pour porter la récolte.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000120296.title: "Panier"
	quest.4200000000120297.quest_desc: [
		"Tu peux y grimper comme à une liane, et plusieurs recettes de cuisine en ont besoin.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000120297.title: "Corde"
	quest.4200000000120298.quest_desc: [
		"Arrête une longue chute et te fait rebondir vers le haut sans une égratignure.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.4200000000120298.title: "Filet"
	quest.4200000000120299.quest_desc: [
		"Une fois labourée et plantée, elle accélère la pousse des cultures voisines.",
		"Comment : pose du Compost organique et attends ; il mûrit lentement en Terre riche."
	]
	quest.4200000000120299.title: "Terre riche (Cuisine)"
	quest.420000000012029A.quest_desc: [
		"Transforme les restes de nourriture en compost pour enrichir la terre.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000012029A.title: "Compost organique (Cuisine)"
	quest.420000000012029B.quest_desc: [
		"Un repas consistant enveloppé de chou, qui restaure un bon bout de faim.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000012029B.title: "Rouleaux de chou"
	quest.420000000012029C.quest_desc: [
		"Vite à cuire, vite à manger, une faim correcte pour l'effort.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000012029C.title: "Sandwich au bacon"
	quest.420000000012029D.quest_desc: [
		"Un repas en couches qui restaure plus de faim que les parts seules.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000012029D.title: "Hamburger"
	quest.420000000012029E.quest_desc: [
		"Un bol réchauffant qui restaure faim et saturation ensemble.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000012029E.title: "Soupe de poulet"
	quest.420000000012029F.quest_desc: [
		"Le ragoût de bœuf cale bien.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.420000000012029F.title: "Ragoût de boeuf"
	quest.42000000001202A0.quest_desc: [
		"Nouilles et bouillon, assez consistant pour une journée de travail.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A0.title: "Soupe de nouilles"
	quest.42000000001202A1.quest_desc: [
		"Un dessert au four qui vaut l'attente, et restaure un bon bout de faim.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A1.title: "Tarte aux pommes"
	quest.42000000001202A2.quest_desc: [
		"Acidulé et sucré, l'un des desserts les plus riches sur la plateforme.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A2.title: "Cheesecake aux fruits rouges"
	quest.42000000001202A3.quest_desc: [
		"Riz pour la ligne de cuisine.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A3.title: "Riz"
	quest.42000000001202A4.quest_desc: [
		"Plat réconfort de la ligne de cuisine.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A4.title: "Riz sauté"
	quest.42000000001202A5.quest_desc: [
		"Petits paquets farcis, vite à cuire par fournées.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A5.title: "Raviolis"
	quest.42000000001202A6.quest_desc: [
		"Une boisson chaude préparée avec des fèves de cacao et du lait.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A6.title: "Chocolat chaud"
	quest.42000000001202A7.quest_desc: [
		"Une boisson fraîche pressée de la pastèque, restaure un peu de faim très vite.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A7.title: "Jus de melon"
	quest.42000000001202A8.quest_desc: [
		"Tissu tissé utilisé dans plusieurs recettes de cuisine et de décoration.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A8.title: "Toile"
	quest.42000000001202A9.quest_desc: [
		"Un sol tissé et souple, une autre texture que le bois nu.",
		"Comment : fabrication Farmer's Delight dans JEI (établi, planche à découper ou marmite). Les graines de culture viennent en tamisant de la terre."
	]
	quest.42000000001202A9.title: "Tatami"
	quest.42000000001302AA.quest_desc: [
		"Le premier livre qui te laisse lancer des sorts dans un vrai combat.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : trois chaînes, quatre cuirs et deux papiers. Le chapitre Sorts nomme l'encre."
	]
	quest.42000000001302AA.title: "Livre de sorts en fer"
	quest.42000000001302AB.quest_desc: [
		"A plus d'emplacements de sorts que le livre de fer d'avant.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302AB.title: "Livre de sorts en or"
	quest.42000000001302AC.quest_desc: [
		"Un livre plus solide, avec encore plus de place pour les sorts.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302AC.title: "Livre de sorts en diamant"
	quest.42000000001302AD.quest_desc: [
		"Alimente l'incantation et sert de base à la plupart des recettes de sorts.",
		"Comment : tue des lanceurs ou fabrique ce que liste JEI. Carburant pour l'encre et les livres."
	]
	quest.42000000001302AD.title: "Essence arcanique (Sorts)"
	quest.42000000001302AE.quest_desc: [
		"Écris sorts et pages.",
		"Comment : fiole + essence + teinture. La première encre d'inscription."
	]
	quest.42000000001302AE.title: "Encre commune"
	quest.42000000001302AF.quest_desc: [
		"Inscrit dans un livre des sorts et des parchemins de rang peu commun.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302AF.title: "Encre peu commune"
	quest.42000000001302B0.quest_desc: [
		"Inscrit dans un livre des sorts et des parchemins de rang rare.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B0.title: "Encre rare"
	quest.42000000001302B1.quest_desc: [
		"Inscrit dans un livre des sorts et des parchemins de rang épique.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B1.title: "Encre épique"
	quest.42000000001302B2.quest_desc: [
		"Inscrit les sorts les plus rares et les plus puissants qu'un livre puisse tenir.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B2.title: "Encre légendaire"
	quest.42000000001302B3.quest_desc: [
		"Lance un sort une fois, sans qu'il faille l'apprendre dans un livre.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B3.title: "Parchemin"
	quest.42000000001302B4.quest_desc: [
		"Tissu magique pour des robes.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B4.title: "Tissu magique"
	quest.42000000001302B5.quest_desc: [
		"Armure légère qui privilégie l'incantation plutôt que la défense brute.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B5.title: "Casque du magicien errant"
	quest.42000000001302B6.quest_desc: [
		"Armure de torse faite pour la vitesse d'incantation, pas pour les dégâts encaissés.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B6.title: "Plastron du magicien errant"
	quest.42000000001302B7.quest_desc: [
		"Un bâton qui canalise les sorts de feu avec plus de force.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B7.title: "Bâton de Pyrium"
	quest.42000000001302B8.quest_desc: [
		"Un bâton modeste pour un lanceur qui débute.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302B8.title: "Bâton de Barbe-Grise"
	quest.42000000001302B9.quest_desc: [
		"Une lame qui punit les lanceurs de sorts et tranche leurs défenses.",
		"Comment : recette du pack, deux Lingots arcaniques sur la diagonale, une chaîne de chaque côté et un diamant à la poignée. Son seul porteur sauvage vit dans les forts d'évocateurs, et la plateforme n'en a jamais."
	]
	quest.42000000001302B9.title: "Chasseur de Mages"
	quest.42000000001302BA.quest_desc: [
		"Le tout premier livre de sorts : peu d'emplacements, mais facile à atteindre.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302BA.title: "Livre de sorts en cuivre"
	quest.42000000001302BB.quest_desc: [
		"Le livre de sorts le plus fort, celui qui tient le plus d'emplacements de sorts.",
		"Comment : quatre Tissus arcaniques, deux Fioles de sang, un lingot de netherite, une Bouteille d'éclair et un Livre en ruine (recette du pack). JEI le nomme Codex ancien."
	]
	quest.42000000001302BB.title: "Livre de sorts en netherite"
	quest.42000000001302BC.quest_desc: [
		"Métal raffiné, pour le haut de l'équipement d'incantation.",
		"Comment : Essence arcanique et encre, puis un livre de sorts. Le chapitre Sorts nomme l'échelle."
	]
	quest.42000000001302BC.title: "Lingot arcanique"
	quest.42000000001302BD.quest_desc: [
		"Un livre abîmé qu'on peut rassembler de nouveau en savoir.",
		"Comment : recette du pack, un livre enchanté entouré de quatre Essences arcaniques et de quatre sables des âmes. JEI le nomme Livre en ruine."
	]
	quest.42000000001302BD.title: "Codex en ruine"
	quest.42000000001402BE.quest_desc: [
		"La première pièce de Solar Flux. Les cellules, les revêtements et l'Amélioration vierge se fabriquent à partir d'elle.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : trois verres sur un lingot de fer font trois Miroirs."
	]
	quest.42000000001402BE.title: "Miroir"
	quest.42000000001402BF.quest_desc: [
		"Le premier palier de cellule solaire, faible mais peu coûteuse à empiler.",
		"Comment : trois verres, trois lapis-lazulis et trois Miroirs, une rangée de chaque."
	]
	quest.42000000001402BF.title: "Cellule photovoltaïque 1"
	quest.42000000001402C0.quest_desc: [
		"Une cellule solaire plus forte, un cran au-dessus du palier d'avant.",
		"Comment : trois boules d'argile, trois lapis-lazulis, deux Miroirs et une Cellule photovoltaïque I."
	]
	quest.42000000001402C0.title: "Cellule photovoltaïque 2"
	quest.42000000001402C1.quest_desc: [
		"Cellule solaire de milieu de palier, nettement plus de rendement par panneau.",
		"Comment : trois verres, trois poudres de pierre lumineuse, deux obsidiennes et une Cellule photovoltaïque II."
	]
	quest.42000000001402C1.title: "Cellule photovoltaïque 3"
	quest.42000000001402C2.quest_desc: [
		"Une cellule solaire de haut palier, pour un panneau fait pour monter en puissance.",
		"Comment : trois Revêtements flamboyants, deux poudres de pierre lumineuse, un diamant, deux blocs de quartz et une Cellule photovoltaïque III."
	]
	quest.42000000001402C2.title: "Cellule photovoltaïque 4"
	quest.42000000001402C3.quest_desc: [
		"Presque au sommet, cette cellule tire une vraie puissance du jour.",
		"Comment : trois Verres d'émeraude, deux blocs de pierre lumineuse, un bloc de diamant, un bloc de quartz et deux Cellules photovoltaïques IV. En fait deux."
	]
	quest.42000000001402C3.title: "Cellule photovoltaïque 5"
	quest.42000000001402C4.quest_desc: [
		"La plus forte cellule solaire fabriquée, le plafond d'un seul panneau.",
		"Comment : trois Verres d'ender, deux blocs de pierre lumineuse, un bloc d'émeraude, un bloc de quartz et deux Cellules photovoltaïques V. En fait deux."
	]
	quest.42000000001402C4.title: "Cellule photovoltaïque 6"
	quest.42000000001402C5.quest_desc: [
		"Permet à un panneau solaire de garder une plus grande réserve d'énergie.",
		"Comment : cinq blocs de redstone, un bloc de diamant et une Amélioration vierge."
	]
	quest.42000000001402C5.title: "Amélioration de capacité"
	quest.42000000001402C6.quest_desc: [
		"Tire plus de puissance du même soleil.",
		"Comment : trois Miroirs, une Amélioration vierge et une Cellule photovoltaïque I."
	]
	quest.42000000001402C6.title: "Amélioration d'efficacité"
	quest.42000000001402C7.quest_desc: [
		"Permet à un panneau solaire d'envoyer l'énergie plus vite.",
		"Comment : six redstone et deux lingots d'or autour d'une Amélioration vierge."
	]
	quest.42000000001402C7.title: "Amélioration de transfert"
	quest.42000000001402C8.quest_desc: [
		"Passe l'énergie aux machines reliées au panneau, à quelques blocs.",
		"Comment : quatre lingots de fer, deux pistons et deux redstone autour d'une Amélioration vierge."
	]
	quest.42000000001402C8.title: "Amélioration de traversée"
	quest.42000000001402C9.quest_desc: [
		"Envoie de l'énergie aux joueurs debout près du panneau.",
		"Comment : quatre poudres de pierre lumineuse et quatre Yeux de l'Ender autour d'une Amélioration vierge."
	]
	quest.42000000001402C9.title: "Amélioration dispersive"
	quest.42000000001402CA.quest_desc: [
		"Envoie de l'énergie à un bloc lié à portée, sans câble.",
		"Comment : quatre perles de l'Ender et quatre blocs de redstone autour d'une Amélioration dispersive."
	]
	quest.42000000001402CA.title: "Amélioration de charge de bloc"
	quest.42000000001402CB.quest_desc: [
		"Permet au panneau de fondre des objets avec la lumière du soleil stockée, au lieu du combustible.",
		"Comment : cinq charbons, un fourneau et deux Revêtements flamboyants autour d'une Amélioration vierge."
	]
	quest.42000000001402CB.title: "Amélioration de fourneau"
	quest.42000000001402CC.quest_desc: [
		"Verre miroir serti d'une émeraude. Le Verre de l'Ender et la Cellule photovoltaïque V se fabriquent dessus.",
		"Comment : une émeraude entre deux Miroirs en colonne en fait deux."
	]
	quest.42000000001402CC.title: "Verre d'émeraude"
	quest.42000000001402CD.quest_desc: [
		"Verre d'émeraude chargé de perles et d'un œil. La Cellule photovoltaïque VI se fabrique dessus.",
		"Comment : trois Verres d'émeraude au-dessus d'un Œil de l'Ender entre deux perles de l'Ender en font trois."
	]
	quest.42000000001402CD.title: "Verre de l'Ender"
	quest.42000000001402CE.quest_desc: [
		"Une finition de Miroir poudrée de Blaze. La Cellule photovoltaïque IV et l'Amélioration de fourneau s'en servent.",
		"Comment : de la poudre de Blaze entre deux Miroirs en colonne en fait deux."
	]
	quest.42000000001402CE.title: "Revêtement flamboyant"
	quest.42000000001402CF.quest_desc: [
		"Une amélioration non choisie, façonnée en n'importe quel type d'amélioration.",
		"Comment : quatre roches autour d'un Miroir."
	]
	quest.42000000001402CF.title: "Amélioration vierge"
	quest.42000000001502D0.quest_desc: [
		"Pierre simple et fiable pour les murs et les sols.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : quatre pierres en carré, ou le tailleur de pierre."
	]
	quest.42000000001502D0.title: "Briques de pierre"
	quest.42000000001502D1.quest_desc: [
		"Finition de brique moussue pour la plateforme.",
		"Comment : briques de pierre plus des lianes ou de la mousse. Le tailleur de pierre ensuite."
	]
	quest.42000000001502D1.title: "Briques de pierre moussue"
	quest.42000000001502D2.quest_desc: [
		"Briques de pierre patinées, à l'air usé et fendu.",
		"Comment : fais fondre des briques de pierre."
	]
	quest.42000000001502D2.title: "Briques de pierre craquelées"
	quest.42000000001502D3.quest_desc: [
		"Briques de pierre sculptées pour les finitions et les lignes d'accent.",
		"Comment : deux dalles de briques de pierre, ou le tailleur de pierre."
	]
	quest.42000000001502D3.title: "Briques de pierre sculptées"
	quest.42000000001502D4.quest_desc: [
		"Une finition de pierre plate et régulière pour les sols.",
		"Comment : fais fondre de la pierre. Les dalles viennent du tailleur de pierre."
	]
	quest.42000000001502D4.title: "Pierre lisse"
	quest.42000000001502D5.quest_desc: [
		"Pierre grise polie jusqu'à un fini lisse.",
		"Comment : quatre andésites, ou le tailleur de pierre."
	]
	quest.42000000001502D5.title: "Andésite polie"
	quest.42000000001502D6.quest_desc: [
		"Pierre d'un blanc vif, polie et lisse.",
		"Comment : quatre diorites, ou le tailleur de pierre."
	]
	quest.42000000001502D6.title: "Diorite polie"
	quest.42000000001502D7.quest_desc: [
		"Pierre rose et chaude, polie pour les détails.",
		"Comment : quatre granites, ou le tailleur de pierre."
	]
	quest.42000000001502D7.title: "Granite poli"
	quest.42000000001502D8.quest_desc: [
		"Blocs d'argile cuite, un rouge chaud contre la pierre grise.",
		"Comment : quatre objets brique. Les boules d'argile fondent en briques."
	]
	quest.42000000001502D8.title: "Briques"
	quest.42000000001502D9.quest_desc: [
		"Boue pâle et tassée, façonnée en finition de bâtiment.",
		"Comment : quatre terres crues. La boue, c'est de la terre plus une bouteille d'eau ; boue et blé font de la terre crue."
	]
	quest.42000000001502D9.title: "Briques de terre crue"
	quest.42000000001502DA.quest_desc: [
		"Briques de pierre sombre tirées des profondeurs.",
		"Comment : ardoise des abîmes polie en carré, ou le tailleur de pierre. Quatre galets d'ardoise des abîmes (tamise de la terre) font de l'ardoise des abîmes cobblée."
	]
	quest.42000000001502DA.title: "Briques d'ardoise des abîmes"
	quest.42000000001502DB.quest_desc: [
		"Tuiles sombres et lisses pour un sol plus net.",
		"Comment : briques d'ardoise des abîmes en carré, ou le tailleur de pierre."
	]
	quest.42000000001502DB.title: "Tuiles d'ardoise des abîmes"
	quest.42000000001502DC.quest_desc: [
		"Pierre sombre du Nether, solide et simple.",
		"Comment : de l'eau de sorcière versée dans un tonneau de lave, ou quatre galets de pierre noire. Les Forts en sont bâtis."
	]
	quest.42000000001502DC.title: "Pierre noire"
	quest.42000000001502DD.quest_desc: [
		"Pierre noire polie jusqu'à un éclat sombre et brillant.",
		"Comment : quatre pierre noire, ou le tailleur de pierre. Le Nether, après Griffe."
	]
	quest.42000000001502DD.title: "Pierre noire polie"
	quest.42000000001502DE.quest_desc: [
		"Pierre noire mouchetée d'or, rare et décorative.",
		"Comment : bastion du Nether après l'obsidienne de Griffe. Une branche finale du décor, pas une porte suivante."
	]
	quest.42000000001502DE.title: "Pierre noire dorée"
	quest.42000000001502DF.quest_desc: [
		"Bloc d'un blanc vif, un incontournable du décor de la plateforme.",
		"Comment : quatre quartz du Nether. Le Nether, après Griffe."
	]
	quest.42000000001502DF.title: "Bloc de quartz"
	quest.42000000001502E0.quest_desc: [
		"Quartz lissé à plat, pour des finitions nettes.",
		"Comment : fais fondre un bloc de quartz."
	]
	quest.42000000001502E0.title: "Quartz lisse"
	quest.42000000001502E1.quest_desc: [
		"Pierre violette de l'End, un accent un peu étrange.",
		"Comment : quatre chorus éclatés. Le fruit de chorus, c'est l'étal des Marche-lisières."
	]
	quest.42000000001502E1.title: "Bloc de purpur"
	quest.42000000001502E2.quest_desc: [
		"Pierre née de la mer, avec un faible chatoiement bleu.",
		"Comment : il faut des éclats de prismarine. Rien que l'océan. Facultatif."
	]
	quest.42000000001502E2.title: "Prismarine"
	quest.42000000001502E3.quest_desc: [
		"Une prismarine plus sombre, bonne pour les accents profonds.",
		"Comment : il faut des éclats de prismarine. Rien que l'océan. Facultatif."
	]
	quest.42000000001502E3.title: "Prismarine sombre"
	quest.42000000001502E4.quest_desc: [
		"Une lumière stable, tirée du fond de l'océan.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502E4.title: "Lanterne aquatique"
	quest.42000000001502E5.quest_desc: [
		"Une lumière orange chaude, poussée depuis un champignon du Nether.",
		"Comment : pousse sur d'énormes champignons. Plante un champignon sur du nylium et mets-y de la poudre d'os."
	]
	quest.42000000001502E5.title: "Champilampe"
	quest.42000000001502E6.quest_desc: [
		"Une lumière jaune et douce, sans la moindre flamme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502E6.title: "Grelampe ocre"
	quest.42000000001502E7.quest_desc: [
		"Une lumière pâle et luisante, à l'éclat nacré.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502E7.title: "Grelampe nacrée"
	quest.42000000001502E8.quest_desc: [
		"Une lumière verte et fraîche, sans flamme, sûre à l'intérieur.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502E8.title: "Grelampe verdoyante"
	quest.42000000001502E9.quest_desc: [
		"Verre qui bloque la lumière, mais garde la vue.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502E9.title: "Verre teinté"
	quest.42000000001502EA.quest_desc: [
		"Verre blanc doux, pour une lumière de fenêtre tendre.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502EA.title: "Verre blanc"
	quest.42000000001502EB.quest_desc: [
		"Verre bleu pâle, proche du ciel ouvert.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502EB.title: "Verre bleu clair"
	quest.42000000001502EC.quest_desc: [
		"Verre cyan frais, pour une pièce plus calme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502EC.title: "Verre cyan"
	quest.42000000001502ED.quest_desc: [
		"Verre violet profond, un clin d'œil au vide en dessous.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502ED.title: "Verre violet"
	quest.42000000001502EE.quest_desc: [
		"Une petite flamme stable, pour la lumière d'ambiance.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502EE.title: "Bougie"
	quest.42000000001502EF.quest_desc: [
		"Une bougie pâle, discrète sur les murs clairs.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502EF.title: "Bougie blanche"
	quest.42000000001502F0.quest_desc: [
		"Grimpe le bord de la plateforme sans risque.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F0.title: "Tour d'échafaudage"
	quest.42000000001502F1.quest_desc: [
		"Des échelles pour les plateformes à la verticale.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F1.title: "Stock d'échelles"
	quest.42000000001502F2.quest_desc: [
		"Des rails à travers le vide.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F2.title: "Rail de réserve"
	quest.42000000001502F3.quest_desc: [
		"Te garde à flot si la plateforme rencontre un jour l'eau.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F3.title: "Bateau en chêne"
	quest.42000000001502F4.quest_desc: [
		"Du décor pour les murs de la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F4.title: "Tableau de réserve"
	quest.42000000001502F5.quest_desc: [
		"Montre un set d'armure complet sur la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F5.title: "Porte-armure"
	quest.42000000001502F6.quest_desc: [
		"Tient un objet exposé qui ne s'éteint jamais.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F6.title: "Cadre luisant"
	quest.42000000001502F7.quest_desc: [
		"Pots de fleurs pour le vert.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F7.title: "Pot de fleurs de rechange"
	quest.42000000001502F8.quest_desc: [
		"Pancartes suspendues pour les pièces.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F8.title: "Pancarte suspendue en chêne"
	quest.42000000001502F9.quest_desc: [
		"Métier à tisser pour le travail des bannières.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502F9.title: "Métier"
	quest.42000000001502FA.quest_desc: [
		"Taille la pierre en formes précises, sans gaspillage.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502FA.title: "Tailleur de pierre"
	quest.42000000001502FB.quest_desc: [
		"Répare les outils et retire les enchantements dont tu ne veux pas.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502FB.title: "Meule"
	quest.42000000001502FC.quest_desc: [
		"Améliore l'équipement avec des modèles de forge et de la netherite.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502FC.title: "Table de forge"
	quest.42000000001502FD.quest_desc: [
		"Trace la grille de l'île.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502FD.title: "Table de cartographie"
	quest.42000000001502FE.quest_desc: [
		"Un poste de villageois, surtout décoratif sur la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502FE.title: "Table d'archerie"
	quest.42000000001502FF.quest_desc: [
		"Fond les minerais deux fois plus vite qu'un simple fourneau.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.42000000001502FF.title: "Haut fourneau de rechange"
	quest.4200000000150300.quest_desc: [
		"Cuit la nourriture deux fois plus vite qu'un simple fourneau.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000150300.title: "Fumoir de rechange"
	quest.4200000000150301.quest_desc: [
		"Tient un peu d'eau, de teinture ou de potion.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000150301.title: "Chaudron"
	quest.4200000000150302.quest_desc: [
		"Déplace automatiquement les objets entre les conteneurs en dessous et au-dessus.",
		"Comment : cinq fers autour d'un coffre. Pose-le sous un Cadre de métier ou un Tonneau de tension (extraction vers le BAS)."
	]
	quest.4200000000150302.title: "Entonnoir de rechange"
	quest.4200000000150303.quest_desc: [
		"Tire ou utilise l'objet que tu y charges.",
		"Comment : roche, arc et redstone."
	]
	quest.4200000000150303.title: "Distributeur de rechange"
	quest.4200000000150304.quest_desc: [
		"Envoie une impulsion de redstone dès que le bloc devant change.",
		"Comment : roche, redstone et quartz du Nether."
	]
	quest.4200000000150304.title: "Observateur de rechange"
	quest.4200000000150305.quest_desc: [
		"Un signal de redstone constant et fort, sous forme de bloc.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000150305.title: "Bloc de redstone"
	quest.4200000000150306.quest_desc: [
		"Envoie une puissance de signal selon la justesse du coup.",
		"Comment : redstone autour du foin. Le foin, c'est trois blés."
	]
	quest.4200000000150306.title: "Cible de rechange"
	quest.4200000000150307.quest_desc: [
		"Joue une note quand on le frappe ou qu'on l'alimente. Accorde-le à la main.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000150307.title: "Bloc musical de rechange"
	quest.4200000000150308.quest_desc: [
		"Joue des disques de musique sur toute la plateforme.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000150308.title: "Jukebox de rechange"
	quest.4200000000150309.quest_desc: [
		"La cloche marque le Clowder.",
		"Comment : aucune recette. Le rituel Contacter l'esprit sauvage d'Occultism en fabrique un, mais il faut une chèvre, et les chèvres n'atteignent jamais la plateforme. Optionnel."
	]
	quest.4200000000150309.title: "Cloche de rechange"
	quest.420000000015030A.quest_desc: [
		"Fixe ton point de réapparition dans le Nether et se charge à la pierre lumineuse.",
		"Comment : obsidienne pleureuse plus pierre lumineuse. Réapparition seulement dans le Nether."
	]
	quest.420000000015030A.title: "Ancre de réapparition"
	quest.420000000015030B.quest_desc: [
		"Verrouille une boussole sur ce bloc précis, au lieu du point d'apparition.",
		"Comment : un lingot de netherite dans des briques de pierre ciselées. Luxe tardif du Clowder."
	]
	quest.420000000015030B.title: "Magnétite de rechange"
	quest.420000000015030C.quest_desc: [
		"Détourne les éclairs loin de la plateforme, sans danger.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000015030C.title: "Paratonnerre de rechange"
	quest.420000000015030D.quest_desc: [
		"Un espace de stockage personnel qui te suit partout où tu vas.",
		"Comment : huit obsidiennes autour d'un Œil de l'Ender. L'œil est une perle de l'Ender plus de la poudre de Blaze."
	]
	quest.420000000015030D.title: "Coffre de l'Ender"
	quest.420000000015030E.quest_desc: [
		"Se fabrique en boîte de shulker, pour un stockage empilable et sûr.",
		"Comment : recette du pack, six blocs de purpur, deux perles de l'Ender et un Nœud liant. Les shulkers n'apparaissent jamais ici. Facultatif."
	]
	quest.420000000015030E.title: "Carapace de shulker"
	quest.420000000016030F.quest_desc: [
		"Le sol et les murs, partout où tu bâtis au-dessus de la lave.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : le Nether ici est le vide, pas un terrain. Verse de la lave dans un tonneau d'Ex Deorum d'eau de sorcière (un tonneau d'eau posé sur du mycélium ; les spores de mycélium se tamisent depuis la terre)."
	]
	quest.420000000016030F.title: "Stock de Netherrack"
	quest.4200000000160310.quest_desc: [
		"Pierre de boue cuite, renforcée de quartz. Garde sa forme près du feu.",
		"Comment : fais fondre du Netherrack, puis quatre objets brique du Nether."
	]
	quest.4200000000160310.title: "Briques du Nether"
	quest.4200000000160311.quest_desc: [
		"Verrue du Nether cuite en brique. Couleur plus chaude, même solidité.",
		"Comment : briques du Nether plus verrues du Nether. Le Nether après Griffe."
	]
	quest.4200000000160311.title: "Briques rouges du Nether"
	quest.4200000000160312.quest_desc: [
		"Colonne de magma refroidie, taillée en blocs pour une prise de pied.",
		"Comment : de la lave qui coule sur de la terre des âmes à côté de glace bleue, ou quatre galets de basalte en tamisant de la pierre noire broyée."
	]
	quest.4200000000160312.title: "Basalte"
	quest.4200000000160313.quest_desc: [
		"Basalte poncé lisse. Il se lit comme de la pierre, pas comme un échafaudage.",
		"Comment : tailleur de pierre, ou quatre basaltes."
	]
	quest.4200000000160313.title: "Basalte poli"
	quest.4200000000160314.quest_desc: [
		"Basalte sans les crêtes. Bon pour les sols plats et les bordures.",
		"Comment : fais fondre du basalte."
	]
	quest.4200000000160314.title: "Basalte lisse"
	quest.4200000000160315.quest_desc: [
		"La roche du Nether. Fabrique-la vers des outils et des briques.",
		"Comment : de l'eau de sorcière versée dans un tonneau de lave, ou quatre galets de pierre noire. Les Forts en sont bâtis."
	]
	quest.4200000000160315.title: "Réserve de pierre noire"
	quest.4200000000160316.quest_desc: [
		"Réchauffe l'eau proche jusqu'à ébullition et blesse les pieds nus.",
		"Comment : quatre crèmes de magma. Une boule de slime dans un tonneau de lave fait de la crème."
	]
	quest.4200000000160316.title: "Bloc de magma"
	quest.4200000000160317.quest_desc: [
		"Réserve de sable des âmes pour prendre pied.",
		"Comment : du sable dans un tonneau d'Ex Deorum d'eau de sorcière. Les salles à verrues de la forteresse en gardent un peu. Trois crânes sur du sable des âmes font un Wither."
	]
	quest.4200000000160317.title: "Réserve de sable des âmes"
	quest.4200000000160318.quest_desc: [
		"Laisse le feu des âmes et les torches des âmes brûler à la place de la flamme ordinaire.",
		"Comment : du sable des âmes lâché dans un tonneau de lave d'Ex Deorum."
	]
	quest.4200000000160318.title: "Terre des âmes"
	quest.4200000000160319.quest_desc: [
		"Se broie en quatre poussières, ou éclaire une pièce sans fumée.",
		"Comment : quatre poudres de pierre lumineuse. La poussière se tamise depuis le sable des âmes."
	]
	quest.4200000000160319.title: "Pierre lumineuse"
	quest.420000000016031A.quest_desc: [
		"Un champignon qui luit tout seul. Pas besoin de câbles.",
		"Comment : pousse sur d'énormes champignons. Plante un champignon sur du nylium et mets-y de la poudre d'os."
	]
	quest.420000000016031A.title: "Réserve de champilampe"
	quest.420000000016031B.quest_desc: [
		"Neuf verrues du Nether réunies en un bloc. Surtout décoration et teinture.",
		"Comment : neuf verrues du Nether. La verrue se tamise depuis le sable des âmes, ou pousse dans les jardins de la forteresse."
	]
	quest.420000000016031B.title: "Bloc de verrues du Nether"
	quest.420000000016031C.quest_desc: [
		"Le cousin bleu du bloc carmin. Même recette, couleur plus froide.",
		"Comment : pousse sur d'énormes champignons biscornus. Mets de la poudre d'os sur un champignon biscornu, sur du nylium biscornu."
	]
	quest.420000000016031C.title: "Bloc de verrues biscornues"
	quest.420000000016031D.quest_desc: [
		"Du bois qui n'est pas du bois. S'écorce et fait des planches comme n'importe quelle bûche.",
		"Comment : spores de nylium carmin (tamise du netherrack broyé) sur du netherrack, poudre d'os sur le nylium pour un champignon, puis poudre d'os sur le champignon."
	]
	quest.420000000016031D.title: "Tige carmin"
	quest.420000000016031E.quest_desc: [
		"L'autre tronc de champignon. Les planches sortent bleues, pas rouges.",
		"Comment : spores de nylium biscornu (tamise du netherrack broyé) sur du netherrack, poudre d'os sur le nylium pour un champignon, puis poudre d'os sur le champignon."
	]
	quest.420000000016031E.title: "Tige biscornue"
	quest.420000000016031F.quest_desc: [
		"Chaîne pour un style suspendu.",
		"Comment : forêts carmin après Griffe. Elles pendent du plafond."
	]
	quest.420000000016031F.title: "Lianes pleureuses"
	quest.4200000000160320.quest_desc: [
		"Grimpe une forêt biscornue et marque un appui dans la brume.",
		"Comment : forêts biscornues après Griffe. Poussent vers le haut depuis le nylium."
	]
	quest.4200000000160320.title: "Lianes tortueuses"
	quest.4200000000160321.quest_desc: [
		"Pleure une lumière violette et fixe un point de réapparition dans le Nether.",
		"Comment : coffres de bastion, troc avec les piglins, ou abeilles Draconic qui travaillent l'obsidienne. Les portails en ruine ne se génèrent pas ici."
	]
	quest.4200000000160321.title: "Obsidienne pleureuse"
	quest.4200000000160322.quest_desc: [
		"Enfoui sous les minerais ordinaires. Fais-le fondre vers la netherite.",
		"Comment : martèle la pierre noire en pierre noire broyée, puis tamise-la. Les coffres de bastion en gardent un peu."
	]
	quest.4200000000160322.title: "Débris antiques"
	quest.4200000000160323.quest_desc: [
		"Quatre fragments et quatre lingots d'or font un lingot de netherite.",
		"Comment : fais fondre des débris antiques. Quatre fragments plus de l'or font un lingot."
	]
	quest.4200000000160323.title: "Fragment de netherite"
	quest.4200000000160324.quest_desc: [
		"Le métal le plus dur qu'une main Skybound tiendra jamais.",
		"Comment : quatre fragments plus quatre d'or. Les débris sont un Nether rare, après Griffe."
	]
	quest.4200000000160324.title: "Lingot de netherite"
	quest.4200000000160325.quest_desc: [
		"Alimente les alambics et les hauts fourneaux, les deux. Garde une pile de côté.",
		"Comment : forteresse du Nether après l'obsidienne de Griffe. Les potions veulent un bâton ; Ars et Occultism n'attendent pas."
	]
	quest.4200000000160325.title: "Réserve de bâtons de blaze"
	quest.4200000000160326.quest_desc: [
		"La potion de régénération en veut une, plus de la patience près d'un ghast.",
		"Comment : des ghasts du Nether après l'obsidienne de Griffe."
	]
	quest.4200000000160326.title: "Larme de ghast"
	quest.4200000000160327.quest_desc: [
		"Se brasse en résistance au feu, ou se refabrique en bloc de magma.",
		"Comment : une boule de slime lâchée dans un tonneau de lave, du slime plus de la poudre de blaze, ou des cubes de magma."
	]
	quest.4200000000160327.title: "Crème de magma"
	quest.4200000000160328.quest_desc: [
		"Trois invoquent un Wither. Un seul fait aussi bel effet sur une étagère.",
		"Comment : forteresse du Nether après l'obsidienne de Griffe. Trois crânes lancent un Wither."
	]
	quest.4200000000160328.title: "Crâne de wither squelette"
	quest.4200000000160329.quest_desc: [
		"Les Piglins échangent contre de l'or. Les pépites marchent aussi bien que les lingots.",
		"Comment : un lingot en fait neuf, ou du minerai d'or du Nether."
	]
	quest.4200000000160329.title: "Tas de pépites d'or"
	quest.420000000016032A.quest_desc: [
		"Fond en or et se mine plus vite que le minerai dont il porte le nom.",
		"Comment : combineur Mekanism, huit or brut plus du netherrack. Le Nether du vide n'a pas de minerai."
	]
	quest.420000000016032A.title: "Minerai d'or du Nether"
	quest.420000000016032B.quest_desc: [
		"Pierre d'un blanc éclatant, qui bâtit et conduit aussi les signaux de comparateur.",
		"Comment : tamise du sable des âmes, ou troc avec les Piglins."
	]
	quest.420000000016032B.title: "Quartz"
	quest.420000000016032C.quest_desc: [
		"Lancée, elle allume un feu. Chargée dans un distributeur, aussi.",
		"Comment : poudre de Blaze, charbon et poudre à canon."
	]
	quest.420000000016032C.title: "Boule de feu"
	quest.4200000000178001.quest_desc: [
		"Douze cadres de portail ne se fabriquent pas sur la plateforme, alors l'End n'est qu'une bouchée plus loin.",
		"Mange-le pour te poser sur la plateforme d'obsidienne de l'End ; mange la moitié qui reste pour rentrer à l'endroit d'où tu as mangé.",
		"Comment : cinq perles de l'Ender, deux os et deux poudres de Blaze à l'établi."
	]
	quest.4200000000178001.title: "Pomme de l'End"
	quest.420000000017032D.quest_desc: [
		"Pierre pâle de l'autre rive. Lourde, simple, sans fin.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : fruit de chorus et perles de l'Ender (étal des Marche-lisières) autour d'un Nœud liant. Donne huit. L'île de l'End a disparu."
	]
	quest.420000000017032D.title: "Pierre de l'End"
	quest.420000000017032E.quest_desc: [
		"Pierre de l'End taillée en carré, pour des lignes plus nettes sur une plateforme de l'End.",
		"Comment : quatre Pierre de l'End en carré, ou le tailleur de pierre. La Pierre de l'End est la fabrication du Nœud."
	]
	quest.420000000017032E.title: "Briques de pierre de l'End"
	quest.420000000017032F.quest_desc: [
		"Poussé du fruit de chorus, puis cuit en pierre de construction.",
		"Comment : quatre chorus éclatés. Le fruit de chorus, c'est l'étal des Marche-lisières."
	]
	quest.420000000017032F.title: "Stock de bloc de purpur"
	quest.4200000000170330.quest_desc: [
		"Du purpur au motif de colonne, orienté comme tu le poses.",
		"Comment : deux dalles de purpur, ou le tailleur de pierre. D'abord le fruit de chorus éclaté."
	]
	quest.4200000000170330.title: "Pilier de purpur"
	quest.4200000000170331.quest_desc: [
		"Une lumière froide qui ne vacille jamais et sert aussi de poteau de rail.",
		"Comment : bâton de Blaze plus fruit de chorus éclaté. Le Nether après Griffe ; le chorus est l'étal des Marche-lisières."
	]
	quest.4200000000170331.title: "Barre de l'End"
	quest.4200000000170332.quest_desc: [
		"Mange-le et tu te téléportes d'un court saut imprévisible.",
		"Comment : étal des Marche-lisières à /clowder hub. Les îles extérieures de l'End ont disparu."
	]
	quest.4200000000170332.title: "Fruit de chorus"
	quest.4200000000170333.quest_desc: [
		"Fruit de chorus cuit. Se fabrique en purpur et en teintures, sans te téléporter.",
		"Comment : fais fondre du fruit de chorus de l'étal des Marche-lisières."
	]
	quest.4200000000170333.title: "Chorus éclaté"
	quest.4200000000170334.quest_desc: [
		"Lance-la et tu arrives là où elle tombe, moins un peu de santé.",
		"Comment : endermen, ou l'étal des Marche-lisières à /clowder hub."
	]
	quest.4200000000170334.title: "Stock de perles de l'Ender"
	quest.4200000000170335.quest_desc: [
		"Stock d'yeux de l'Ender.",
		"Comment : perle de l'Ender (étal des Marche-lisières / endermen) plus poudre de Blaze d'une forteresse du Nether, après l'obsidienne de Griffe. Le stock de huit yeux est facultatif ; les cristaux de l'End utilisent la même fabrication."
	]
	quest.4200000000170335.title: "Stock d'œil de l'Ender"
	quest.4200000000170336.quest_desc: [
		"Souffle de dragon pour les potions.",
		"Comment : fiole de verre sur le dragon. L'île de l'End a disparu. Facultatif."
	]
	quest.4200000000170336.title: "Stock de souffle de dragon"
	quest.4200000000170337.quest_desc: [
		"Le seul trophée du dragon. Il ne tient jamais en place quand on clique.",
		"Récompense rare : une vie partagée de Clowder, une seule fois pour toute l'équipe. Seulement six récompenses de ce genre existent dans la campagne.",
		"Comment : le dragon est parti avec l'île de l'End. Trophée facultatif — il ne bloque pas les coffres de l'Ender."
	]
	quest.4200000000170337.title: "Vitrine de l'œuf de dragon"
	quest.4200000000170338.quest_desc: [
		"Élytres pour voyager dans le ciel.",
		"Facultatif — le vide peut ne jamais t'en offrir un.",
		"Comment : les cités de l'End ont disparu. Facultatif."
	]
	quest.4200000000170338.title: "Vitrine des élytres"
	quest.4200000000170339.quest_desc: [
		"Carapaces de shulker pour les boîtes.",
		"Facultatif — pas de shulkers ici, alors le pack fabrique les carapaces.",
		"Comment : recette du pack, six blocs de purpur, deux perles de l'Ender et un Nœud liant. Les shulkers n'apparaissent jamais ici. Facultatif."
	]
	quest.4200000000170339.title: "Stock de carapace de shulker"
	quest.420000000017033A.quest_desc: [
		"Un coffre portable qui garde son contenu quand tu le casses.",
		"Facultatif — les Marche-lisières dans la Salle Clowder en vendent une.",
		"Comment : deux Carapaces de shulker autour d'un coffre (les carapaces sont une recette du pack), ou l'étal des Marche-lisières à /clowder hub pour 22 Écheveaux de Fil (198 Fil). Facultatif."
	]
	quest.420000000017033A.title: "Vitrine de boîte de shulker"
	quest.420000000017033B.quest_desc: [
		"Cristaux de l'End — tout en douceur.",
		"Comment : verre, œil de l'Ender, larme de Ghast. Nether après l'obsidienne de Griffe ; l'œuf est facultatif."
	]
	quest.420000000017033B.title: "Vitrine du cristal de l'End"
	quest.420000000017033C.quest_desc: [
		"Chaque coffre de l'Ender, sur chaque plateforme, partage un seul stockage caché.",
		"Comment : huit obsidiennes autour d'un Œil de l'Ender. L'œil est une perle de l'Ender plus de la poudre de Blaze."
	]
	quest.420000000017033C.title: "Présentation du coffre de l'Ender"
	quest.420000000017033D.quest_desc: [
		"Plante-la sur de la pierre de l'End, et le fruit de chorus pousse vers le haut.",
		"Comment : les îles extérieures de l'End ont disparu. Le fruit de chorus est à l'étal des Marche-lisières. Facultatif."
	]
	quest.420000000017033D.title: "Fleur de chorus"
	quest.420000000017033E.quest_desc: [
		"Douze d'entre eux, remplis d'yeux, ouvrent la voie vers l'End.",
		"Comment : pas une fabrication de la plateforme. Facultatif."
	]
	quest.420000000017033E.title: "Cadre du portail de l'End"
	quest.420000000017033F.quest_desc: [
		"Poudre de béton prise en masse. Sombre comme le vide, et permanente une fois durcie.",
		"Comment : poudre de béton plus eau. La poudre, c'est du sable, du gravier et de la teinture."
	]
	quest.420000000017033F.title: "Béton noir"
	quest.4200000000170340.quest_desc: [
		"Une couleur d'accent criarde pour un biome calme et pâle.",
		"Comment : poudre de béton plus eau. La poudre, c'est du sable, du gravier et de la teinture."
	]
	quest.4200000000170340.title: "Béton violet"
	quest.4200000000170341.quest_desc: [
		"Lave refroidie au contact de l'eau. Résiste aux explosions, et elle est lente à miner.",
		"Comment : de l'eau sur une source de lave (ou de la lave sur l'eau). Garde la source de lave."
	]
	quest.4200000000170341.title: "Stock d'obsidienne"
	quest.4200000000170342.quest_desc: [
		"Luit faiblement et, chargée, te propulse depuis une ancre de réapparition.",
		"Comment : coffres de bastion, troc avec les piglins, ou abeilles Draconic qui travaillent l'obsidienne. Les portails en ruine ne se génèrent pas ici."
	]
	quest.4200000000170342.title: "Stock d'obsidienne pleureuse"
	quest.4200000000170343.quest_desc: [
		"Charge-la de pierre lumineuse pour fixer un point de réapparition dans le Nether.",
		"Comment : obsidienne pleureuse plus pierre lumineuse. Réapparition seulement dans le Nether."
	]
	quest.4200000000170343.title: "Présentation de l'ancre de réapparition"
	quest.4200000000170344.quest_desc: [
		"Tenu en main secondaire, il annule un coup autrement mortel.",
		"Comment : récompenses de quêtes seulement. Assieds Horloge et Assieds Sceau en donnent un chacun, et les cadeaux des Nœuds de Brin tardifs en offrent davantage. Les raids et les évocateurs n'arrivent jamais sur la plateforme. Facultatif."
	]
	quest.4200000000170344.title: "Présentation du totem"
	quest.4200000000170345.quest_desc: [
		"Le seul butin du Wither. Une balise en a besoin d'une pour s'allumer.",
		"Comment : Wither (trois crânes sur du sable des âmes), ou l'étal des Cœurs-tambours à /clowder hub une fois, pour 12 Rouleaux de Fil (972 Fil). Trophée facultatif — il ne bloque ni l'End ni la Ferme de monstres à 100%."
	]
	quest.4200000000170345.title: "Présentation de l'étoile du Nether"
	quest.4200000000170346.quest_desc: [
		"Alimentée par une pyramide de blocs minéraux, elle accorde des bonus tant que tu restes dans sa zone.",
		"Comment : étoile du Nether, verre et obsidienne. Trophée facultatif — les branches de l'océan pendent du Stock d'obsidienne."
	]
	quest.4200000000170346.title: "Présentation de la balise"
	quest.4200000000170347.quest_desc: [
		"Entouré de prismarine, il accorde l'apnée et la célérité sous l'eau.",
		"Facultatif — le vide peut ne jamais t'en offrir un.",
		"Comment : il faut un Cœur de la mer et du nautile. Océan seulement. Facultatif."
	]
	quest.4200000000170347.title: "Présentation du conduit"
	quest.4200000000170348.quest_desc: [
		"Huit encerclent un conduit, et une se fabrique en boussole de la mer.",
		"Facultatif — le vide peut ne jamais t'en offrir un.",
		"Comment : océan seulement. Facultatif."
	]
	quest.4200000000170348.title: "Coquille de nautile"
	quest.4200000000170349.quest_desc: [
		"Butin rare d'un noyé. Lance-le, ou canalise la foudre dans une tempête.",
		"Comment : noyés seulement. Facultatif."
	]
	quest.4200000000170349.title: "Présentation du trident"
	quest.420000000018034A.quest_desc: [
		"Essence de base. Nourrit aussi bien les accélérateurs de croissance que les reprocesseurs.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018034A.title: "Stock d'Inferium"
	quest.420000000018034B.quest_desc: [
		"Une graine inachevée. Il lui faut de l'essence avant qu'elle ne fasse pousser quoi que ce soit.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018034B.title: "Base de Prosperity"
	quest.420000000018034C.quest_desc: [
		"Consommé une fois, il monte l'essence d'un palier.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018034C.title: "Crystal d'infusion"
	quest.420000000018034D.quest_desc: [
		"Essence de deuxième palier, raffinée depuis des piles d'Inferium.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018034D.title: "Stock de Prudentium"
	quest.420000000018034E.quest_desc: [
		"Essence de troisième palier, un échelon au-dessus de Prudentium.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018034E.title: "Stock de Tertium"
	quest.420000000018034F.quest_desc: [
		"Essence de quatrième palier, près du haut de la chaîne.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018034F.title: "Stock d'Imperium"
	quest.4200000000180350.quest_desc: [
		"Essence de cinquième palier, presque aussi raffinée qu'elle peut l'être.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180350.title: "Stock de Supremium"
	quest.4200000000180351.quest_desc: [
		"Le sommet raffiné. Indispensable pour le meilleur équipement et les meilleures graines.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180351.title: "Essence éveillée"
	quest.4200000000180352.quest_desc: [
		"La pièce centrale pour éveiller l'essence jusqu'à sa forme finale.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180352.title: "Autel d'éveil"
	quest.4200000000180353.quest_desc: [
		"Entoure l'autel de ceux-ci pour achever l'éveil.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180353.title: "Piédestal d'éveil"
	quest.4200000000180354.quest_desc: [
		"Un cristal d'infusion qui ne tombe jamais à court de charges.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180354.title: "Cristal maître"
	quest.4200000000180355.quest_desc: [
		"Stocke l'essence en masse, pour que les machines ne tombent jamais à sec.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180355.title: "Récipient d'essence"
	quest.4200000000180356.quest_desc: [
		"Le composant de base de chaque machine à essence.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180356.title: "Châssis de machine"
	quest.4200000000180357.quest_desc: [
		"Surveille les cultures proches et les casse à l'instant où elles mûrissent.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180357.title: "Récolteur"
	quest.4200000000180358.quest_desc: [
		"Transforme les graines en trop en essence, plutôt qu'en bazar.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180358.title: "Retransformateur de graines"
	quest.4200000000180359.quest_desc: [
		"Accélère les cultures proches avec de l'essence d'Inferium.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180359.title: "Accélérateur Inferium"
	quest.420000000018035A.quest_desc: [
		"Un accélérateur plus puissant, un palier au-dessus d'Inferium.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018035A.title: "Accélérateur Prudentium"
	quest.420000000018035B.quest_desc: [
		"Accélération de palier moyen, pour un champ plus affairé.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018035B.title: "Accélérateur Tertium"
	quest.420000000018035C.quest_desc: [
		"Presque au sommet de la plage de vitesse de pousse.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018035C.title: "Accélérateur Imperium"
	quest.420000000018035D.quest_desc: [
		"L'accélérateur le plus rapide que l'essence puisse bâtir.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018035D.title: "Accélérateur Supremium"
	quest.420000000018035E.quest_desc: [
		"Une éclaboussure d'eau toute simple, pour les cultures assoiffées.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018035E.title: "Arrosoir"
	quest.420000000018035F.quest_desc: [
		"Un arrosoir infusé d'Inferium, qui porte plus loin.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.420000000018035F.title: "Arrosoir d'Inferium"
	quest.4200000000180360.quest_desc: [
		"Arrose plus de cultures à chaque usage que l'arrosoir de base.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180360.title: "Arrosoir de Prudentium"
	quest.4200000000180361.quest_desc: [
		"Un arrosoir de palier moyen, à l'éclaboussure nettement plus large.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180361.title: "Arrosoir de Tertium"
	quest.4200000000180362.quest_desc: [
		"Arrose un large pan de champ en un seul passage.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180362.title: "Arrosoir d'Imperium"
	quest.4200000000180363.quest_desc: [
		"L'éclaboussure la plus large qu'un arrosoir puisse donner.",
		"Comment : fabrication Mystical Agriculture dans JEI. Inferium et Prosperity viennent du tamis ; les graines s'infusent sur l'Autel d'infusion."
	]
	quest.4200000000180363.title: "Arrosoir de Supremium"
	quest.4200000000180364.quest_desc: [
		"Accélère la pousse si tu la jettes sur des cultures déjà plantées.",
