		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0482.title: "Accès aux motifs"
	quest.42000000001D0483.quest_desc: [
		"Fournit des motifs aux machines qui fabriquent toutes seules.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0483.title: "Fournisseur de motifs (Réseau)"
	quest.42000000001D0484.quest_desc: [
		"Assemble les objets fabriqués en suivant un motif stocké.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0484.title: "Assembleur moléculaire (Réseau)"
	quest.42000000001D0485.quest_desc: [
		"Un bloc de mémoire que le réseau utilise pendant qu'il fabrique.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0485.title: "Unité de fabrication (Réseau)"
	quest.42000000001D0486.quest_desc: [
		"Accélère une seule tâche de fabrication qui passe par le réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0486.title: "Accélérateur de fabrication"
	quest.42000000001D0487.quest_desc: [
		"Ajoute de la mémoire de fabrication à une unité de fabrication.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0487.title: "Stockage de fabrication 1k"
	quest.42000000001D0488.quest_desc: [
		"Plus de mémoire de fabrication pour de plus gros travaux.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0488.title: "Stockage de fabrication 4k"
	quest.42000000001D0489.quest_desc: [
		"Un sérieux bloc de mémoire de fabrication.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0489.title: "Stockage de fabrication 16k"
	quest.42000000001D048A.quest_desc: [
		"Assez de mémoire de fabrication pour les plus gros travaux du réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D048A.title: "Stockage de fabrication 64k"
	quest.42000000001D048B.quest_desc: [
		"Mémoire de fabrication d'archive, rarement nécessaire, mais là quand il le faut.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D048B.title: "Stockage de fabrication 256k"
	quest.42000000001D048C.quest_desc: [
		"Émet de la redstone dès qu'un objet suivi franchit un nombre.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D048C.title: "Émetteur de niveau (Réseau)"
	quest.42000000001D048D.quest_desc: [
		"Pose des blocs du réseau dans le monde.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D048D.title: "Plan de formation (Réseau)"
	quest.42000000001D048E.quest_desc: [
		"Casse les blocs et tire ce qui tombe dans le réseau.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D048E.title: "Plan d'annihilation (Réseau)"
	quest.42000000001D048F.quest_desc: [
		"Porte un canal du réseau par-dessus une coupure dans la ligne de câble.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D048F.title: "Tunnel P2P"
	quest.42000000001D0490.quest_desc: [
		"Plie un petit morceau d'espace dans une cellule portable.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0490.title: "Spatial 2"
	quest.42000000001D0491.quest_desc: [
		"Parcours le stockage du réseau de n'importe où, avec un amplificateur à côté.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0491.title: "Terminal sans fil (Réseau)"
	quest.42000000001D0492.quest_desc: [
		"Fabrique depuis le réseau sans revenir à pied jusqu'à un terminal.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0492.title: "Fabrication sans fil"
	quest.42000000001D0493.quest_desc: [
		"Tire des billes de matière ; charge-le avant d'en avoir besoin.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0493.title: "Cannon à matière"
	quest.42000000001D0494.quest_desc: [
		"Un bloc clair pour les coques de contrôleur et les lignes de câble.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0494.title: "Verre de quartz"
	quest.42000000001D0495.quest_desc: [
		"Du verre qui luit tout seul, sans torche.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0495.title: "Quartz vibrant"
	quest.42000000001D0496.quest_desc: [
		"Un bloc de stockage solide, quatre cristaux condensés en un.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0496.title: "Bloc de Fluix"
	quest.42000000001D0497.quest_desc: [
		"Répartit une cellule de stockage en plusieurs réserves plus petites.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001D0497.title: "Etabli de cellules"
	quest.42000000001E0498.quest_desc: [
		"Argile et poudre d'os, un pas vers les outils de porcelaine.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : boule d'argile + poudre d'os, sans forme. L'argile vient du Tonneau de tension."
	]
	quest.42000000001E0498.title: "Argile de porcelaine (Artisanat du vide)"
	quest.42000000001E0499.quest_desc: [
		"Un seau plus léger, plus doux pour un budget de gravier du début.",
		"Comment : forme l'argile de porcelaine en un seau non cuit, puis fais-le fondre."
	]
	quest.42000000001E0499.title: "Porcelain Bucket"
	quest.42000000001E049A.quest_desc: [
		"Fond des blocs en liquide au-dessus d'un feu.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E049A.title: "Creuset de porcelaine (Artisanat du vide)"
	quest.42000000001E049B.quest_desc: [
		"La première maille de tamis ; lente, mais elle marche.",
		"Comment : neuf ficelles en 3x3. L'étal des Chanteurs de gravier vend la maille de Fil (ficelle) du Métier du vide, qui tamise pareil."
	]
	quest.42000000001E049B.title: "Maille de ficelle (Artisanat du vide)"
	quest.42000000001E049C.quest_desc: [
		"Tamise plus vite que la ficelle, l'amélioration en vaut la peine.",
		"Comment : quatre silex et cinq ficelles en damier. Le silex vient du gravier, ou de Fil + gravier."
	]
	quest.42000000001E049C.title: "Maille de silex (Artisanat du vide)"
	quest.42000000001E049D.quest_desc: [
		"Une maille du milieu, solide, pour tamiser sans à-coups.",
		"Comment : quatre lingots de fer et cinq ficelles en damier. Aucun étal ne le vend."
	]
	quest.42000000001E049D.title: "Maille de fer (Voidcraft)"
	quest.42000000001E049E.quest_desc: [
		"Fait sortir des prises plus rares que le fer.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E049E.title: "Maille d'or (Voidcraft)"
	quest.42000000001E049F.quest_desc: [
		"Tamise assez vite pour nourrir une file d'entonnoirs.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E049F.title: "Maille de diamant (Voidcraft)"
	quest.42000000001E04A0.quest_desc: [
		"La meilleure maille qu'un tamis pourra jamais porter.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04A0.title: "Maille de netherite (Voidcraft)"
	quest.42000000001E04A1.quest_desc: [
		"Filée à partir de ficelle, la fibre propre du Métier à tisser.",
		"Comment : quatre ficelles → deux filés. Tonneau de tension : ficelle + perle. Quatre Peluches du métier."
	]
	quest.42000000001E04A1.title: "Stock d'Écheveau du vide"
	quest.42000000001E04A2.quest_desc: [
		"La porte souple du Métier à tisser : les poteaux, les presses et les contrôleurs en veulent tous un.",
		"Comment : anneau d'Écheveau du vide autour d'une boule de slime."
	]
	quest.42000000001E04A2.title: "Stock de Nœud liant"
	quest.42000000001E04A3.quest_desc: [
		"La version du Métier du vide de la maille de tamis de base.",
		"Comment : ficelle autour du filé. L'étal des Chanteurs de gravier en vend une."
	]
	quest.42000000001E04A3.title: "Maille de Fil (ficelle)"
	quest.42000000001E04A4.quest_desc: [
		"Une maille du Métier du vide, un cran au-dessus de la simple ficelle.",
		"Comment : du silex autour d'une maille de Fil (ficelle)."
	]
	quest.42000000001E04A4.title: "Maille de Fil (silex)"
	quest.42000000001E04A5.quest_desc: [
		"Une maille du Métier du vide, faite pour un rendement régulier.",
		"Comment : du fer autour d'une maille de Fil (silex). Le Filament de Brin commence ici."
	]
	quest.42000000001E04A5.title: "Maille de Fil (fer)"
	quest.42000000001E04A6.quest_desc: [
		"Brise le gravillon d'un cran plus fin : roche en gravier, gravier en sable, sable en poussière.",
		"Comment : roche + bâtons. Brise le gravillon en gravier, sable et poussière."
	]
	quest.42000000001E04A6.title: "Marteau à fuseau (Voidcraft)"
	quest.42000000001E04A7.quest_desc: [
		"Dépouille les feuilles pour des jeunes plants et des vers à soie.",
		"Comment : quatre bâtons. L'étal des Chanteurs de gravier en vend une."
	]
	quest.42000000001E04A7.title: "Crosse à fuseau"
	quest.42000000001E04A8.quest_desc: [
		"Le cadre de tamis du Métier à tisser : tends-y une maille et nourris-le de gravillon.",
		"Comment : planches autour d'un Nœud liant. Tends une maille, verse le gravillon par un entonnoir, pose-le sur un entonnoir."
	]
	quest.42000000001E04A8.title: "Cadre de métier"
	quest.42000000001E04A9.quest_desc: [
		"L'eau et la terre deviennent de l'argile ; la ficelle et une perle deviennent du filé.",
		"Comment : planches, ficelle et Écheveau du vide. Verse de l'eau (le seau revient), ajoute de la terre → argile."
	]
	quest.42000000001E04A9.title: "Tonneau de tension (Voidcraft)"
	quest.42000000001E04AA.quest_desc: [
		"Neuf blocs de terre pliés en un seul, pour la montée.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04AA.title: "Compressed Dirt"
	quest.42000000001E04AB.quest_desc: [
		"Neuf roches serrées, bon marché et sans fin.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04AB.title: "Roche compressée (Voidcraft)"
	quest.42000000001E04AC.quest_desc: [
		"Neuf graviers compactés ; un tamis compressé les prend entiers.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04AC.title: "Compressed Gravel"
	quest.42000000001E04AD.quest_desc: [
		"Neuf blocs de sable pressés en un, pour le transport.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04AD.title: "Compressed Sand"
	quest.42000000001E04AE.quest_desc: [
		"Neuf blocs de poussière pressés, pour la même raison.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04AE.title: "Compressed Dust"
	quest.42000000001E04AF.quest_desc: [
		"Pierre du Nether compactée, pour un inventaire plus léger.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04AF.title: "Compressed Netherrack"
	quest.42000000001E04B0.quest_desc: [
		"Pierre de l'End compactée, utile dès que le vide demande à manger.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04B0.title: "Compressed End Stone"
	quest.42000000001E04B1.quest_desc: [
		"Ardoise des abîmes compactée, neuf pour un, et ce n'est toujours que de la pierre.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04B1.title: "Compressed Deepslate"
	quest.42000000001E04B2.quest_desc: [
		"Éclate d'un coup toute une pile de blocs compressés.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04B2.title: "Marteau compressé"
	quest.42000000001E04B3.quest_desc: [
		"Un marteau plus faible pour briser les blocs compressés.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04B3.title: "Compressed Iron Hammer"
	quest.42000000001E04B4.quest_desc: [
		"Un large tamis, plusieurs tas de gravier à la fois.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04B4.title: "Tamis compressé (Voidcraft)"
	quest.42000000001E04B5.quest_desc: [
		"Tamise comme celui en chêne, juste un autre grain.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04B5.title: "Birch Sieve"
	quest.42000000001E04B6.quest_desc: [
		"Fermente comme n'importe quel autre tonneau.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04B6.title: "Birch Barrel"
	quest.42000000001E04B7.quest_desc: [
		"Fond les blocs comme n'importe quel autre creuset.",
		"Comment : tamis, marteau, creuset ou tonneau d'Ex Deorum. Accorde la maille au gravillon."
	]
	quest.42000000001E04B7.title: "Birch Crucible"
	quest.42000000001E04B8.quest_desc: [
		"La monnaie du Brin : gagne-la, dépense-la, ne la gaspille jamais.",
		"Comment : récompenses de quêtes, terre à maille de silex sur un Cadre de métier, caches de l'intendant."
	]
	quest.42000000001E04B8.title: "Stock de Fil effiloché"
	quest.42000000001E04B9.quest_desc: [
		"Pages d'archive et notes.",
		"Comment : assieds un Brin au Poteau, ou à l'étal des Graveurs de sceaux à /clowder hub (8 Fil). Clic droit pour lire ; on les garde, on ne les dépense pas."
	]
	quest.42000000001E04B9.title: "Pages du codex"
	quest.42000000001E04BA.quest_desc: [
		"Clic droit et ouvre Commence ici. Accent grave (`): la liste des tâches. Le livre n'assigne pas de quêtes.",
		"Comment : kit de départ / coffre du quai. Clic droit sur le livre ; l'accent grave (`) est la liste des tâches."
	]
	quest.42000000001E04BA.title: "Codex des Moustaches"
	quest.42000000001F04BB.quest_desc: [
		"Le papier à l'intérieur d'un paquet, avant qu'il soit scellé.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : lingots d'or et planches autour d'un Œil de l'Ender. Premier craft de Packaged Auto."
	]
	quest.42000000001F04BB.title: "Composant de paquet"
	quest.42000000001F04BC.quest_desc: [
		"Une enveloppe de paquet bâtie, elle, autour d'un motif stocké.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04BC.title: "Composant de paquet ME"
	quest.42000000001F04BD.quest_desc: [
		"Scelle des objets dans un paquet, pour que la ligne les déplace.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04BD.title: "Emballeur (emballé)"
	quest.42000000001F04BE.quest_desc: [
		"Ajoute un autre emplacement d'emballage à un emballeur.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04BE.title: "Extension d'emballeur"
	quest.42000000001F04BF.quest_desc: [
		"Rouvre un paquet en objets en vrac.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04BF.title: "Unpackager"
	quest.42000000001F04C0.quest_desc: [
		"Écrit une recette de fabrication sur un motif de paquet.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04C0.title: "Encodeur"
	quest.42000000001F04C1.quest_desc: [
		"Assemble un paquet en suivant sa recette encodée.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04C1.title: "Fabricant"
	quest.42000000001F04C2.quest_desc: [
		"Achemine les paquets vers l'adresse qui correspond.",
		"Comment : Marqueur de distributeur, composant d'emballage, deux Carapaces de shulker, quatre perles de l'Ender et un bloc de fer. Carapaces : recette du pack, six blocs de purpur, deux perles de l'Ender et un Nœud liant."
	]
	quest.42000000001F04C2.title: "Distributeur"
	quest.42000000001F04C3.quest_desc: [
		"Marque une destination où un distributeur peut envoyer des paquets.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04C3.title: "Distributor Marker"
	quest.42000000001F04C4.quest_desc: [
		"Pousse les paquets finis sur la ligne, pour qu'on les prenne.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04C4.title: "Fournisseur d'emballage"
	quest.42000000001F04C5.quest_desc: [
		"Laisse un fabricant lointain demander par ce bloc, à la place.",
		"Comment : Marqueur de relais, composant d'emballage, deux Carapaces de shulker, deux perles de l'Ender, deux obsidiennes pleureuses et un bloc de fer. Carapaces : recette du pack, six blocs de purpur, deux perles de l'Ender et un Nœud liant."
	]
	quest.42000000001F04C5.title: "Relais de fabrication"
	quest.42000000001F04C6.quest_desc: [
		"Garde un lot de recettes de paquet pour les réutiliser.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04C6.title: "Porte-recettes"
	quest.42000000001F04C7.quest_desc: [
		"Copie les réglages d'un bloc sur un autre, et t'épargne beaucoup de clics.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04C7.title: "Cloneur de réglages"
	quest.42000000001F04C8.quest_desc: [
		"Remplit un paquet de fluide, pas d'objets.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04C8.title: "Fluid Package Filler"
	quest.42000000001F04C9.quest_desc: [
		"Un ballot scellé d'objets, prêt à bouger ou à ranger.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04C9.title: "Objet paquet"
	quest.42000000001F04CA.quest_desc: [
		"Entasse bien plus dans un seul paquet que le modèle de base.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04CA.title: "Volume Package"
	quest.42000000001F04CB.quest_desc: [
		"Marque l'endroit qu'un relais de fabrication doit atteindre.",
		"Comment : composant de paquet, puis Emballeur / Encodeur. Il faut un réseau AE2 pour la pièce ME."
	]
	quest.42000000001F04CB.title: "Proxy Marker"
	quest.42000000001F04CC.quest_desc: [
		"Relie la ligne d'emballage au métier numérique.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001F04CC.title: "Interface AE"
	quest.42000000001F04CD.quest_desc: [
		"Fournit des motifs de fabrication à la ligne d'emballage.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001F04CD.title: "Fournisseur de motifs (emballé)"
	quest.42000000001F04CE.quest_desc: [
		"Fabrique des objets pour les motifs du métier numérique lui-même.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001F04CE.title: "Assembleur moléculaire (emballé)"
	quest.42000000001F04CF.quest_desc: [
		"D'abord un réseau de métier numérique, sinon rien de cet emballage ne tourne.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001F04CF.title: "Contrôleur ME"
	quest.42000000001F04D0.quest_desc: [
		"Conduis l'énergie ou les signaux.",
		"Comment : Réseau du Fuseau — Certus depuis le sable, le contrôleur veut un Nœud liant."
	]
	quest.42000000001F04D0.title: "Câble de Fluix (emballé)"
	quest.42000000001F04D1.quest_desc: [
		"Emballe les objets du côté Create, à la mécanique.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.42000000001F04D1.title: "Emballeur Create"
	quest.42000000001F04D2.quest_desc: [
		"Rassemble les colis séparés en commandes entières.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.42000000001F04D2.title: "Réemballeur Create"
	quest.42000000001F04D3.quest_desc: [
		"Demande des objets emballés à un réseau de stocks relié.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.42000000001F04D3.title: "Ticker de stocks (emballé)"
	quest.42000000001F04D4.quest_desc: [
		"Un coffre tampon de gros volume pour les paquets qui attendent leur tour.",
		"Comment : fabrication Create dans JEI (établi, presse, mélangeur ou déployeur). L'alliage d'andésite et une roue à aubes lancent la ligne."
	]
	quest.42000000001F04D4.title: "Coffre-fort d'objets (emballé)"
	quest.42000000002004D5.quest_desc: [
		"Un disque de stockage quantique basique pour le réseau QIO.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004D5.title: "Base de disque QIO"
	quest.42000000002004D6.quest_desc: [
		"Met bien plus de stockage sur un seul disque quantique.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004D6.title: "QIO hyperdense"
	quest.42000000002004D7.quest_desc: [
		"Un disque quantique qui échange la taille contre de la densité brute.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004D7.title: "QIO dilatation temporelle"
	quest.42000000002004D8.quest_desc: [
		"Le plus grand disque quantique que fabrique Mekanism.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004D8.title: "QIO supermassif"
	quest.42000000002004D9.quest_desc: [
		"Tient plusieurs disques quantiques dans un seul boîtier.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004D9.title: "Serveur du OQO"
	quest.42000000002004DA.quest_desc: [
		"Parcours tout ce que stocke le réseau QIO.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004DA.title: "Tableau de bord du OQO"
	quest.42000000002004DB.quest_desc: [
		"Porte le tableau de bord QIO dans ta poche.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004DB.title: "QIO portable"
	quest.42000000002004DC.quest_desc: [
		"Le châssis de base de la plupart des machines Mekanism avancées.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004DC.title: "Châssis d'acier (QIO)"
	quest.42000000002004DD.quest_desc: [
		"Stocke une quantité énorme d'énergie dans un seul bloc.",
		"Récompense rare : une vie partagée de Clowder, une seule fois pour toute l'équipe. Seulement six récompenses de ce genre existent dans la campagne.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004DD.title: "Cube ultime"
	quest.42000000002004DE.quest_desc: [
		"Tient une pile énorme d'un seul objet.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004DE.title: "Conteneur ultime"
	quest.42000000002004DF.quest_desc: [
		"Fond plusieurs piles d'un coup, aussi vite que Mekanism peut aller.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004DF.title: "Usine de fonderie ultime"
	quest.42000000002004E0.quest_desc: [
		"Enrichit le minerai à la plus haute vitesse qu'offre Mekanism.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E0.title: "Usine d'enrichissement ultime"
	quest.42000000002004E1.quest_desc: [
		"Broie le minerai à la plus haute vitesse qu'offre Mekanism.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E1.title: "Usine de broyage ultime"
	quest.42000000002004E2.quest_desc: [
		"Mine un chunk entier tout seul, droit jusqu'au vide.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E2.title: "Mineur numérique (QIO)"
	quest.42000000002004E3.quest_desc: [
		"Un outil modulaire qui change tout seul sa tête de travail.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E3.title: "Désassembleur atomique (QIO)"
	quest.42000000002004E4.quest_desc: [
		"Tourne les faces et copie les réglages entre les machines Mekanism.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E4.title: "Configurateur (QIO)"
	quest.42000000002004E5.quest_desc: [
		"Te fait bondir d'un coup entre deux socles liés.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E5.title: "Téléporteur (QIO)"
	quest.42000000002004E6.quest_desc: [
		"Cadre le portail qu'ouvre un téléporteur.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E6.title: "Structure de téléporteur"
	quest.42000000002004E7.quest_desc: [
		"Châssis du réacteur qui produit de l'antimatière.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E7.title: "Structure du CPC"
	quest.42000000002004E8.quest_desc: [
		"Fait entrer les produits chimiques et sort l'antimatière du réacteur.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E8.title: "Port du CPC"
	quest.42000000002004E9.quest_desc: [
		"Accélère la production d'un réacteur à antimatière.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004E9.title: "Bobine surchargée"
	quest.42000000002004EA.quest_desc: [
		"Sépare les isotopes en tournant, pour la chimie tardive.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004EA.title: "Centrifuge à isotope"
	quest.42000000002004EB.quest_desc: [
		"Dissout le minerai en une boue chimique.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004EB.title: "Dissolution chimique"
	quest.42000000002004EC.quest_desc: [
		"Lave la boue à fond, avant de la cristalliser.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004EC.title: "Laveur chimique"
	quest.42000000002004ED.quest_desc: [
		"Ramène un produit chimique en cristal solide.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004ED.title: "Cristalliseur chimique"
	quest.42000000002004EE.quest_desc: [
		"Bombarde la matière de neutrons poussés par la lumière du soleil.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004EE.title: "Neutron solaire"
	quest.42000000002004EF.quest_desc: [
		"Change l'énergie directement en chaleur, pour une chaudière.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004EF.title: "Chauffeur électrique"
	quest.42000000002004F0.quest_desc: [
		"Brûle le bois pour la chaleur, pas pour l'énergie.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F0.title: "Chauffeur à combustion"
	quest.42000000002004F1.quest_desc: [
		"Synthèse tardive de matériaux impossibles autrement.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F1.title: "Antiprotonique"
	quest.42000000002004F2.quest_desc: [
		"Un seul outil modulaire pour miner, creuser et plus.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F2.title: "Outils Meka"
	quest.42000000002004F3.quest_desc: [
		"Armure de combinaison pour la tête, améliorée module par module.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F3.title: "Casque Meka"
	quest.42000000002004F4.quest_desc: [
		"Armure de combinaison pour le torse, améliorée module par module.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F4.title: "Plastron Meka"
	quest.42000000002004F5.quest_desc: [
		"Armure de combinaison pour les jambes, améliorée module par module.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F5.title: "Pantalon Meka"
	quest.42000000002004F6.quest_desc: [
		"Armure de combinaison pour les pieds, améliorée module par module.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F6.title: "Bottes Meka"
	quest.42000000002004F7.quest_desc: [
		"Coque pour une chaudière à vapeur.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F7.title: "Bloc de chaudière"
	quest.42000000002004F8.quest_desc: [
		"Stocke une grande quantité d'énergie.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F8.title: "Cube d'énergie d'élite"
	quest.42000000002004F9.quest_desc: [
		"Stocke une quantité modérée d'énergie.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004F9.title: "Cube d'énergie avancé"
	quest.42000000002004FA.quest_desc: [
		"Stocke peu d'énergie, bien pour débuter.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004FA.title: "Cube d'énergie basique (QIO)"
	quest.42000000002004FB.quest_desc: [
		"Infuse le métal d'un produit chimique pour de nouveaux alliages.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004FB.title: "Infuseur métallurgique (QIO)"
	quest.42000000002004FC.quest_desc: [
		"Double le rendement du minerai brut avant de le fondre.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004FC.title: "Chambre d'enrichissement (QIO)"
	quest.42000000002004FD.quest_desc: [
		"Mouds ou broie des matériaux en vrac.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004FD.title: "Broyeur (QIO)"
	quest.42000000002004FE.quest_desc: [
		"Fond plus vite qu'un fourneau, à l'énergie plutôt qu'au combustible.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004FE.title: "Fonderie énergisée (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Coupe le bois avec la lame de précision propre à Mekanism.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.42000000002004FF.title: "Scierie de précision"
	quest.4200000000200500.quest_desc: [
		"Sépare l'eau en ses deux gaz composants.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.4200000000200500.title: "Séparateur électrolytique"
	quest.4200000000200501.quest_desc: [
		"Combine deux produits chimiques en un nouveau.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.4200000000200501.title: "Infuseur chimique"
	quest.4200000000200502.quest_desc: [
		"Purifie des fluides ou des minerais.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.4200000000200502.title: "Purification"
	quest.4200000000200503.quest_desc: [
		"Injecte un produit chimique dans le minerai pour un surplus.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.4200000000200503.title: "Injection chimique"
	quest.4200000000200504.quest_desc: [
		"Compresse de l'osmium sur les objets, pour un équipement plus solide.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.4200000000200504.title: "Compresseur d'osmium (QIO)"
	quest.4200000000200505.quest_desc: [
		"Assemble plusieurs composants en une pièce finie.",
		"Comment : chapitre Ateliers Mekanism — fragments de minerai du tamis, puis la ligne d'usine."
	]
	quest.4200000000200505.title: "Combineur"
	quest.4200000000210506.quest_desc: [
		"Les zombies le lâchent, que tu le veuilles ou non.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : tue des zombies sur la plateforme la nuit, ou dans un trou sombre."
	]
	quest.4200000000210506.title: "Stock de chair putréfiée"
	quest.4200000000210507.quest_desc: [
		"Les squelettes les laissent ; broie-les plus tard en poudre d'os.",
		"Comment : des squelettes la nuit, ou /clowder hub Gardiens de la plateforme (16 Fil pour 8)."
	]
	quest.4200000000210507.title: "Stock d'os"
	quest.4200000000210508.quest_desc: [
		"Les creepers le versent, parfois en explosant.",
		"Comment : tamise de la poussière ou du sable des âmes, ou des creepers sur la plateforme la nuit. Garde les bords éclairés une fois que tu en as."
	]
	quest.4200000000210508.title: "Stock de poudre à canon"
	quest.4200000000210509.quest_desc: [
		"Les araignées le lâchent, et un tamis, jamais.",
		"Comment : détisse le Fil effiloché (1 → 3). Araignées. Peluche du métier sur un Lien d'écho. Dépense inverse du filé."
	]
	quest.4200000000210509.title: "Stock de ficelle"
	quest.420000000021050A.quest_desc: [
		"Brasse du poison et nourrit quelques recettes bizarres.",
		"Comment : des araignées sur la plateforme, la nuit."
	]
	quest.420000000021050A.title: "Stock d'yeux d'araignée"
	quest.420000000021050B.quest_desc: [
		"Les endermen les lâchent ; une ferme vaut mieux que de les mendier au vide.",
		"Comment : endermen, ou l'étal des Marche-lisières à /clowder hub."
	]
	quest.420000000021050B.title: "Ferme de perles de l'Ender"
	quest.420000000021050C.quest_desc: [
		"Combustible pour les alambics comme pour les brûleurs de Blaze.",
		"Comment : forteresse du Nether après l'obsidienne de Griffe. Les potions veulent un bâton ; Ars et Occultism n'attendent pas."
	]
	quest.420000000021050C.title: "Ferme de bâtons de Blaze"
	quest.420000000021050D.quest_desc: [
		"Un butin rare, clé pour les potions de régénération.",
		"Comment : des ghasts du Nether après l'obsidienne de Griffe."
	]
	quest.420000000021050D.title: "Ferme de larmes de Ghast"
	quest.420000000021050E.quest_desc: [
		"Se brasse en résistance au feu et nourrit quelques fabrications.",
		"Comment : une boule de slime lâchée dans un tonneau de lave, du slime plus de la poudre de blaze, ou des cubes de magma."
	]
	quest.420000000021050E.title: "Ferme de crème de magma"
	quest.420000000021050F.quest_desc: [
		"Assez collant pour les pistons, les blocs de slime et les laisses.",
		"Comment : deux terres + graines de blé + poudre d'os (compost de plateforme), ou /clowder hub Gardiens de la plateforme."
	]
	quest.420000000021050F.title: "Ferme de boules de slime"
	quest.4200000000210510.quest_desc: [
		"Trois de celles-ci invoquent un boss qui vaut le combat.",
		"Comment : forteresse du Nether après l'obsidienne de Griffe. Trois crânes lancent un Wither."
	]
	quest.4200000000210510.title: "Crâne de wither squelette"
	quest.4200000000210511.quest_desc: [
		"L'impôt du wither lui-même, rare et lourd de puissance.",
		"Comment : Wither (trois crânes sur du sable des âmes), ou l'étal des Cœurs-tambours à /clowder hub une fois, pour 12 Rouleaux de Fil (972 Fil). Trophée facultatif — il ne bloque ni l'End ni la Ferme de monstres à 100%."
	]
	quest.4200000000210511.title: "Étoile du Nether"
	quest.4200000000210512.quest_desc: [
		"Se fabrique en boîte de shulker, un stockage qui survit à la mort.",
		"Facultatif — pas de shulkers ici, alors le pack fabrique les carapaces.",
		"Comment : recette du pack, six blocs de purpur, deux perles de l'Ender et un Nœud liant. Les shulkers n'apparaissent jamais ici. Facultatif."
	]
	quest.4200000000210512.title: "Ferme de carapaces de shulker"
	quest.4200000000210513.quest_desc: [
		"Répare les élytres quand rien d'autre ne le peut.",
		"Comment : saute le sommeil trois nuits, puis tue des phantoms. Facultatif."
	]
	quest.4200000000210513.title: "Membrane de phantom"
	quest.4200000000210514.quest_desc: [
		"Encre de calmar, utile pour la teinture et l'écriture à l'ancienne.",
		"Comment : charbon de bois plus une bouteille en verre. Les poulpes n'apparaissent jamais ici."
	]
	quest.4200000000210514.title: "Ferme de poches d'encre"
	quest.4200000000210515.quest_desc: [
		"Fait luire pancartes et cadres dans le noir.",
		"Comment : les poulpes luisants n'apparaissent jamais sur la plateforme. Facultatif."
	]
	quest.4200000000210515.title: "Encre luisante"
	quest.4200000000210516.quest_desc: [
		"Les gardiens le lâchent, pour des blocs de prismarine et des lanternes.",
		"Comment : les monuments océaniques ont disparu. Facultatif, sauf si tu cultives une graine de prismarine."
	]
	quest.4200000000210516.title: "Éclat de prismarine"
	quest.4200000000210517.quest_desc: [
		"Butin de gardien qui éclaire la mer et nourrit quelques fabrications.",
		"Comment : les monuments océaniques ont disparu. Facultatif."
	]
	quest.4200000000210517.title: "Cristal de prismarine"
	quest.4200000000210518.quest_desc: [
		"Entoure un conduit ; rassemble-en huit pour finir le cadre.",
		"Facultatif — le vide peut ne jamais t'en offrir un.",
		"Comment : océan seulement. Facultatif."
	]
	quest.4200000000210518.title: "Coquille de nautile (Chasse)"
	quest.4200000000210519.quest_desc: [
		"Trompe la mort une fois, puis il disparaît.",
		"Comment : récompenses de quêtes seulement. Assieds Horloge et Assieds Sceau en donnent un chacun, et les cadeaux des Nœuds de Brin tardifs en offrent davantage. Les raids et les évocateurs n'arrivent jamais sur la plateforme. Facultatif."
	]
	quest.4200000000210519.title: "Totem (Chasse)"
	quest.420000000021051A.quest_desc: [
		"Les golems perdent du fer pendant qu'ils montent la garde.",
		"Comment : fais fondre du fer brut / du gravillon de fer (fourneau ou Four à braises). Tamise le gravier pour des morceaux."
	]
	quest.420000000021051A.title: "Cadeau du golem de fer"
	quest.420000000021051B.quest_desc: [
		"Lance des boules de neige ; des munitions utiles, pas un vrai combattant.",
		"Comment : une glace (kit / générateur de glace), sans forme, en quatre boules de neige."
	]
	quest.420000000021051B.title: "Golem de neige"
	quest.420000000021051C.quest_desc: [
		"Les squelettes gardent la plateforme approvisionnée en munitions.",
		"Comment : silex, bâton, plume. Les squelettes en lâchent en plus."
	]
	quest.420000000021051C.title: "Ferme de flèches"
	quest.420000000021051D.quest_desc: [
		"Marque ce qu'elle touche d'une lueur passagère.",
		"Comment : poudre de pierre lumineuse autour d'une flèche."
	]
	quest.420000000021051D.title: "Flèche spectrale"
	quest.420000000021051E.quest_desc: [
		"Monte quand tu trouves une selle.",
		"Facultatif — les Gardiens de la plateforme dans la Salle Clowder en vendent une.",
		"Comment : échange un bloc de diamant auprès des Gardiens de la plateforme, à leur boutique dans la Salle Clowder (/clowder hub). La Selle Chocobo est un objet différent."
	]
	quest.420000000021051E.title: "Selle (Chasse)"
	quest.420000000021051F.quest_desc: [
		"Nomme une créature pour qu'elle ne disparaisse jamais.",
		"Facultatif — les Graveurs de sceaux dans la Salle Clowder en vendent une.",
		"Comment : pêche / coffres rares, ou l'étal des Graveurs de sceaux à /clowder hub (24 Fil). Facultatif."
	]
	quest.420000000021051F.title: "Ferme d'étiquettes"
	quest.4200000000210520.quest_desc: [
		"Amarre un lien ou un câble.",
		"Comment : quatre ficelles autour d'une boule de slime. Le slime est le compost de la plateforme (terre, graines, poudre d'os)."
	]
	quest.4200000000210520.title: "Laisse (Chasse)"
	quest.4200000000210521.quest_desc: [
		"Les poules les pondent plus vite que tu ne peux les ramasser.",
		"Comment : graines de blé aux poules sur la plateforme, ou le poulailler du chapitre Ferme de monstres."
	]
	quest.4200000000210521.title: "Stock d'œufs"
	quest.4200000000210522.quest_desc: [
		"Stock de cuir et de bœuf.",
		"Comment : fais fondre de la chair putréfiée ou cuis-la au feu de camp. Tamise de la terre avec une maille de silex. /clowder hub Les Gardiens de la plateforme en vendent deux pour 18 Fil."
	]
	quest.4200000000210522.title: "Stock de cuir"
	quest.4200000000210523.quest_desc: [
		"Les moutons la refont pousser après une tonte.",
		"Comment : tonds les moutons après leur avoir donné de l'herbe, ou quatre ficelles."
	]
	quest.4200000000210523.title: "Stock de laine"
	quest.4200000000210524.quest_desc: [
		"Stock de nourriture pour la cuisine.",
		"Comment : du blé aux vaches sur la plateforme."
	]
	quest.4200000000210524.title: "Stock de bœuf"
	quest.4200000000210525.quest_desc: [
		"Les cochons le fournissent ; cuis-le avant de le manger.",
		"Comment : pommes de terre ou carottes aux cochons sur la plateforme."
	]
	quest.4200000000210525.title: "Stock de porc"
	quest.4200000000210526.quest_desc: [
		"Poulet pour les repas et les plumes.",
		"Comment : des graines aux poules sur la plateforme."
	]
	quest.4200000000210526.title: "Stock de poulet"
	quest.4200000000210527.quest_desc: [
		"Viande de mouton, meilleure rôtie que crue.",
		"Comment : du blé aux moutons sur la plateforme."
	]
	quest.4200000000210527.title: "Stock de mouton"
	quest.4200000000210528.quest_desc: [
		"Brasse une potion de chance, si tu peux en céder une.",
		"Facultatif — le vide peut ne jamais t'en offrir un.",
		"Comment : les lapins n'apparaissent pas sur la plateforme. Facultatif."
	]
	quest.4200000000210528.title: "Patte de lapin"
	quest.4200000000210529.quest_desc: [
		"Une pièce d'apparat qui mérite sa place près d'un œuf de dragon.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000210529.title: "Tête de zombie"
	quest.420000000021052A.quest_desc: [
		"Va bien avec un œuf de dragon sur une étagère.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000021052A.title: "Crâne de squelette"
	quest.420000000021052B.quest_desc: [
		"Une tête de plus pour l'étagère à trophées, près de l'œuf.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000021052B.title: "Tête de creeper"
	quest.420000000021052C.quest_desc: [
		"Une tête de plus, à sa place près d'un œuf de dragon.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000021052C.title: "Tête de piglin"
	quest.420000000021052D.quest_desc: [
		"La tête la plus rare, gagnée seulement une fois le combat fini.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000021052D.title: "Tête de dragon"
	quest.420000000021052E.quest_desc: [
		"Seulement si un joueur en laisse tomber une.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.420000000021052E.title: "Tête de joueur"
	quest.420000000022052F.quest_desc: [
		"La première fabrication en donne 2 — garde-en un pour le Codex plus tard.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : un os, de la ficelle, de l'améthyste. /clowder hub Les Gardiens de la plateforme vendent des os. Porte Étincelle / Bourdon."
	]
	quest.420000000022052F.title: "Carillon d'os"
	quest.4200000000220530.quest_desc: [
		"Éclat d'un vieux chant de tribu — il faut un Carillon.",
		"Comment : Carillon d'os, améthyste et redstone, sans forme. En donne deux."
	]
	quest.4200000000220530.title: "Éclat d'esprit"
	quest.4200000000220531.quest_desc: [
		"Accorde le métal à l'esprit — du cuivre autour d'un Carillon.",
		"Comment : du cuivre autour d'un Carillon d'os. En donne deux."
	]
	quest.4200000000220531.title: "Résonateur en cuivre"
	quest.4200000000220532.quest_desc: [
		"Marque les lignes du treillis — la craie veut un Éclat.",
		"Comment : deux poudres d'os, du lapis-lazuli et un Éclat d'esprit, sans forme. Donne quatre."
	]
	quest.4200000000220532.title: "Craie rituelle (tribale)"
	quest.4200000000220533.quest_desc: [
		"Pose le cœur — deux Carillons d'os, un Éclat d'esprit, deux cuirs et quatre planches (les Gardiens de la plateforme vendent le cuir).",
		"Comment : deux Carillons d'os, un Éclat d'esprit, deux cuirs et quatre planches. Frappe à mains vides en rythme (17–23 ticks) pour 24 de Pouls."
	]
	quest.4200000000220533.title: "Battement du Cœur-tambour"
	quest.4200000000220534.quest_desc: [
		"Neuf tribus ont fredonné une fois — il faut un Carillon et un Éclat de rechange.",
		"Comment : fabrique-le, ou prends-le en récompense d'Étincelle/Tissage tribal. Clic droit : comment marche le treillis."
	]
	quest.4200000000220534.title: "Codex spirituel"
	quest.4200000000220535.quest_desc: [
		"Tire la ley dans les battements.",
		"Comment : place-le sous le ciel, près d'eau/vert. Pouls lent. Échelle d'Étincelle."
	]
	quest.4200000000220535.title: "Collecteur de ley"
	quest.4200000000220536.quest_desc: [
		"Porte de la Pulsation pour les outils, les sorts et le voyage. Remplis-la à un Cœur-tambour.",
		"Comment : fabrique-la, puis remplis-la depuis un Cœur-tambour (clic avec la cellule). Outils, sorts et voyage puisent dans la cellule."
	]
	quest.4200000000220536.title: "Cellule de pulsation"
	quest.4200000000220537.quest_desc: [
		"Assieds un catalyseur d'Écho, qui s'use en travaillant ; ajoute deux voix de totem différentes dans les huit blocs. Plus de voix renforcent le chant. La redstone le met en pause.",
		"Comment : pose un catalyseur d'écho et deux totems différents dans un rayon de 8. La redstone le met en pause."
	]
	quest.4200000000220537.title: "Résonateur de pulsation"
	quest.4200000000220538.quest_desc: [
		"La tribu de la pierre répond.",
		"Comment : un Carillon d'os, deux bûches, de la terre et un Résonateur de cuivre."
	]
	quest.4200000000220538.title: "Totem de Terre"
	quest.4200000000220539.quest_desc: [
		"La tribu de la flamme répond.",
		"Comment : un Carillon d'os, deux bûches, du charbon de bois et un Résonateur de cuivre."
	]
	quest.4200000000220539.title: "Totem de Feu"
	quest.420000000022053A.quest_desc: [
		"La tribu de la marée répond.",
		"Comment : un Carillon d'os, deux bûches, un seau d'eau (ou un seau d'eau en porcelaine) et un Résonateur de cuivre."
	]
	quest.420000000022053A.title: "Totem d'Eau"
	quest.420000000022053B.quest_desc: [
		"La tribu du vent répond.",
		"Comment : un Carillon d'os, deux bûches, une plume et un Résonateur de cuivre."
	]
	quest.420000000022053B.title: "Totem d'Air"
	quest.420000000022053C.quest_desc: [
		"Cinquième tribu — cœur d'intendant.",
		"Comment : un Carillon d'os, deux bûches, un Éclat d'esprit et un Résonateur de cuivre."
	]
	quest.420000000022053C.title: "Totem d'Esprit"
	quest.420000000022053D.quest_desc: [
		"Lance le chant du treillis. Il attend de la pierre ou un objet de stade Écho ; le métal brut est du gravillon au Bris d'écho.",
		"Comment : Codex des Esprits + Tissage tribal. Assieds de la pierre ou un objet de stade Écho. Le métal brut va sur le Bris d'écho."
	]
	quest.420000000022053D.title: "Établi du chant"
	quest.420000000022053E.quest_desc: [
		"Achemine les harmoniques entre les totems.",
		"Comment : quatre Résonateurs de cuivre autour de redstone. En fait quatre."
	]
	quest.420000000022053E.title: "Conducteur de treillis"
	quest.420000000022053F.quest_desc: [
		"Fredonne le stade un — brise le minerai. La pierre devient des éclats ; la roche, du gravier ; le métal brut, du gravillon. Le bris de gravillon dure 4 secondes à 40 de Pulsation/s.",
		"Comment : pierre + Carillon d'os + Résonateur de cuivre. Totem de Terre dans les 8. Pierre → éclats ; roche → gravier ; métal brut → gravillon. Quatre secondes à 40 de Pulsation/s."
	]
	quest.420000000022053F.title: "Broyeur d'écho"
	quest.4200000000220540.quest_desc: [
		"Éclat qui a entendu le bris.",
		"Comment : pierre au Bris d'écho (pas de la roche). Pierre du rang de la Source, ou pierre au toucher de soie."
	]
	quest.4200000000220540.title: "Éclat d'écho (tribal)"
	quest.4200000000220541.quest_desc: [
		"Fredonne le stade deux — accorde.",
		"Comment : sept pierres, un Éclat d'esprit et un Résonateur de cuivre."
	]
	quest.4200000000220541.title: "Accordeur d'écho"
	quest.4200000000220542.quest_desc: [
		"Écho qui a trouvé une clé.",
		"Comment : Codex des Esprits + Tissage tribal. La station, le totem et le coût en Pulsation sont sur la page du Codex."
	]
	quest.4200000000220542.title: "Écho accordé"
	quest.4200000000220543.quest_desc: [
		"Stade de lien — noue l'esprit au métal.",
		"Comment : sept pierres, un éclat d'améthyste et un Résonateur de cuivre."
	]
	quest.4200000000220543.title: "Lieur d'écho"
	quest.4200000000220544.quest_desc: [
		"Écho qui ne glissera pas.",
		"Comment : Codex des Esprits + Tissage tribal. La station, le totem et le coût en Pulsation sont sur la page du Codex."
	]
	quest.4200000000220544.title: "Écho lié"
	quest.4200000000220545.quest_desc: [
		"Stade de retissage — appelle le lingot.",
		"Comment : cinq pierres, un lingot d'or, deux Résonateurs de cuivre et un Éclat d'esprit."
	]
	quest.4200000000220545.title: "Manifesteur d'écho"
	quest.4200000000220546.quest_desc: [
		"Métal voulu à l'existence par le Pouls spirituel, pas par un fourneau.",
		"Comment : Codex des Esprits + Tissage tribal. La station, le totem et le coût en Pulsation sont sur la page du Codex."
	]
	quest.4200000000220546.title: "Lingot manifesté"
	quest.4200000000220547.quest_desc: [
		"Garde ce que les tribus ont laissé.",
		"Comment : sept planches, un coffre et un Carillon d'os."
	]
	quest.4200000000220547.title: "Cache ancestrale"
	quest.4200000000220548.quest_desc: [
		"Caveau lié vers la Marche.",
		"Comment : une Cache ancestrale, quatre lingots de fer, un Éclat d'esprit, deux Résonateurs de cuivre et une Cellule de pulsation."
	]
	quest.4200000000220548.title: "Cache profonde"
	quest.4200000000220549.quest_desc: [
		"Un sceau non écrit, qui attend un rite pour le remplir.",
		"Comment : sept papiers, un Éclat d'esprit et un Carillon d'os. En fait deux."
	]
	quest.4200000000220549.title: "Sceau vierge"
	quest.420000000022054A.quest_desc: [
		"Sceau de la tribu de la pierre.",
		"Comment : un Sceau vierge et de la terre, sans forme."
	]
	quest.420000000022054A.title: "Sceau de Terre"
	quest.420000000022054B.quest_desc: [
		"Sceau de la tribu de la flamme.",
		"Comment : un Sceau vierge et du charbon de bois, sans forme."
	]
	quest.420000000022054B.title: "Sceau de Feu"
	quest.420000000022054C.quest_desc: [
		"Sceau de la tribu de la marée.",
		"Comment : un Sceau vierge et un seau d'eau (ou un seau d'eau en porcelaine), sans forme."
	]
	quest.420000000022054C.title: "Sceau d'Eau"
	quest.420000000022054D.quest_desc: [
		"Sceau de la tribu du vent.",
		"Comment : un Sceau vierge et une plume, sans forme."
	]
	quest.420000000022054D.title: "Sceau d'Air"
	quest.420000000022054E.quest_desc: [
		"Sceau de la tribu de l'intendant.",
		"Comment : un Sceau vierge et un Éclat d'esprit, sans forme."
	]
	quest.420000000022054E.title: "Sceau d'Esprit"
	quest.420000000022054F.quest_desc: [
		"Offre des sceaux. Demande au Métier à tisser.",
		"Comment : cinq pierres, un éclat d'améthyste et un Carillon d'os."
	]
	quest.420000000022054F.title: "Piédestal du rite"
	quest.4200000000220550.quest_desc: [
		"Utilise-le à mains vides et joue le Rite de la porte : frappe les temps qui tombent sur A, S, D, F. Atteins 60% et il s'ouvre ; pas besoin de Pouls.",
		"Comment : utilise le Tambour de porte à mains vides et joue le Rite de la porte : frappe les temps qui tombent sur A, S, D, F. Atteins 60% et il s'ouvre ; pas besoin de Pouls. Lie d'abord une boussole de retour."
	]
	quest.4200000000220550.title: "Tambour de porte (tribal)"
	quest.4200000000220551.quest_desc: [
		"Pare le seuil de ton camp d'un cadre d'esprit sculpté. Les boussoles et le Tambour de porte assurent le voyage.",
		"Comment : quatre lingots de fer, deux Éclats d'esprit, deux Résonateurs de cuivre et un éclat d'améthyste."
	]
	quest.4200000000220551.title: "Porte spirituelle"
	quest.4200000000220552.quest_desc: [
		"Outil qui dépense de la Pulsation.",
		"Comment : trois Lingots manifestés, un Carillon d'os et un bâton."
	]
	quest.4200000000220552.title: "Pioche de l'équipement spirituel"
	quest.4200000000220553.quest_desc: [
		"Tranchant qui dépense de la Pulsation.",
		"Comment : deux Lingots manifestés, un Carillon d'os et un bâton."
	]
	quest.4200000000220553.title: "Lame d'Espritoutillage"
	quest.4200000000220554.quest_desc: [
		"Pierre de la Marche, sous les pieds, dans un lieu qui ne devrait pas exister.",
		"Comment : fais fondre la Roche de la Marche. Mine-la dans la Marche, par un Tambour de porte."
	]
	quest.4200000000220554.title: "Pierre de la Marche (tribal)"
	quest.4200000000220555.quest_desc: [
		"Gravats de la Marche, simples mais abondants.",
		"Comment : mine de la pierre de la Marche dans la Marche, par un Tambour de porte."
	]
	quest.4200000000220555.title: "Pierres de la Marche"
	quest.4200000000220556.quest_desc: [
		"Bois poussé là où le soleil n'arrive pas.",
		"Comment : coupe les arbres de la Marche, par un Tambour de porte."
	]
	quest.4200000000220556.title: "Bûche de la Marche"
	quest.4200000000220557.quest_desc: [
		"Bois scié de la Marche, solide malgré son origine.",
		"Comment : une Bûche de la Marche fait quatre planches."
	]
	quest.4200000000220557.title: "Planches de la Marche"
	quest.4200000000220558.quest_desc: [
		"Feuilles qui murmurent même sans le moindre vent.",
		"Comment : arbres de la Marche, par un Tambour de porte. Les cisailles ou le toucher de soie gardent les feuilles."
	]
	quest.4200000000220558.title: "Feuille de la Marche"
	quest.4200000000220559.quest_desc: [
		"Un roseau qui bourdonne du Pouls spirituel qui reste.",
		"Comment : pousse à l'état sauvage dans la Marche, attend dans les coffres du barrage de roseaux, et un Ancien des Lie-racines l'échange."
	]
	quest.4200000000220559.title: "Roseau d'esprit (tribal)"
	quest.420000000022055A.quest_desc: [
		"Verse du fer brut dans le Bris d'écho, à côté d'un Totem de Terre. Deux gravillons sortent ; fonds-les au fourneau ou au haut fourneau pour en faire des lingots. D'autres Mods peuvent fournir des métaux bruts étiquetés.",
		"Comment : Codex des Esprits + Tissage tribal. La station, le totem et le coût en Pulsation sont sur la page du Codex."
	]
	quest.420000000022055A.title: "Le minerai se souvient deux fois"
	quest.420000000022055B.quest_desc: [
		"L'eau lie la laine en Tissage spirituel. Alimente la station par le dessus ou par les côtés, et tire le travail fini par le bas.",
		"Comment : Codex des Esprits + Tissage tribal. La station, le totem et le coût en Pulsation sont sur la page du Codex."
	]
	quest.420000000022055B.title: "Étoffe à voix"
	quest.420000000022055C.quest_desc: [
		"Manifeste encore un Lingot manifesté sous Esprit. Le Noyau résonnant ouvre un équipement plus fort et des chemins lointains.",
		"Comment : Codex des Esprits + Tissage tribal. La station, le totem et le coût en Pulsation sont sur la page du Codex."
	]
	quest.420000000022055C.title: "Le cœur vivant"
	quest.420000000022055D.quest_desc: [
		"Porte 4,800 de Pouls dans une Cellule majeure, ou 19,200 dans une Cellule grandiose. Charge-la sur un Cœur-tambour ou un Résonateur avant de partir.",
		"Comment : une Cellule de Pouls, deux Noyaux résonnants et deux Lingots manifestés."
	]
	quest.420000000022055D.title: "Un chant plus long"
	quest.420000000022055E.quest_desc: [
		"Seize seaux dans une citerne. Les seaux et les tuyaux à fluide marchent tous les deux. Un comparateur lit le remplissage ; la redstone verrouille le remplissage et la vidange. Casse-la et le fluide reste sur le bloc qui tombe. Les réservoirs de pierre céleste se vident.",
		"Comment : fabrique, remplis au seau ou au tuyau, ramasse — le fluide reste. Les réservoirs de pierre céleste d'AE2 se vident si on les casse."
	]
	quest.420000000022055E.title: "Pluie tenue dans le cuivre"
	quest.420000000022055F.quest_desc: [
		"Marque une face de machine avec l'accordeur, puis utilise-le sur une plaque de relais. Utilise-le sur une autre machine pour remplacer la marque. Ne marque pas la plaque.",
		"Comment : un Éclat d'esprit sur deux Résonateurs de cuivre."
	]
	quest.420000000022055F.title: "Nomme l'extrémité lointaine"
	quest.4200000000220560.quest_desc: [
		"Emboîte la plaque sur la face d'un coffre ou d'une machine. Apparie deux plaques avec le même objet unique de Lien, ou lie une destination avec l'accordeur. Le fret local atteint 32 blocs, 16 objets par seconde pour 8 de Pulsation. La redstone le met en pause. Depuis la 5.0, la plaque veut un Totem de résonance d'Air éveillé dans les huit blocs, sinon elle reste au repos et dit quelle voix lui manque.",
		"Comment : un entonnoir, un Résonateur de cuivre, deux Craies rituelles et un Lingot manifesté."
	]
	quest.4200000000220560.title: "Un chemin pour les vivres"
	quest.4200000000220561.quest_desc: [
		"Emboîte la plaque sur la face d'un réservoir. Apparie deux plaques, ou lie une destination avec l'accordeur. Le fluide local atteint 32 blocs : 250 mB par seconde pour 8 de Pulsation. Les deux extrémités doivent être chargées. Depuis la 5.0, la plaque veut un Totem de résonance d'Air éveillé dans les huit blocs, sinon elle reste au repos et dit quelle voix lui manque.",
		"Comment : une Citerne des esprits, un Résonateur de cuivre, deux Craies rituelles et un Lingot manifesté."
	]
	quest.4200000000220561.title: "Un chemin pour la pluie"
	quest.4200000000220562.quest_desc: [
		"La Longue-portée transporte les objets jusqu'à 128 blocs pour 16 de Pulsation par battement réussi. Utilise les inventaires ordinaires de n'importe quel mod compatible. Depuis la 5.0, la plaque veut un Totem de résonance d'Air éveillé dans les huit blocs, sinon elle reste au repos et dit quelle voix lui manque.",
		"Comment : un Relais d'objets, deux Noyaux résonnants et deux perles de l'Ender."
	]
	quest.4200000000220562.title: "À travers l'atelier"
	quest.4200000000220563.quest_desc: [
		"La Longue-portée transporte les fluides jusqu'à 128 blocs pour 16 de Pulsation par battement. Les récepteurs pleins se mettent en pause sans risque ; la redstone peut verrouiller la citerne réceptrice. Depuis la 5.0, la plaque veut un Totem de résonance d'Air éveillé dans les huit blocs, sinon elle reste au repos et dit quelle voix lui manque.",
		"Comment : un Relais de fluides, deux Noyaux résonnants et deux perles de l'Ender."
	]
	quest.4200000000220563.title: "À travers les eaux"
	quest.4200000000220564.quest_desc: [
		"Relie Tribal Power aux accepteurs d'énergie de Mekanism, Powah ou AE2. Chaque Pulsation devient 100 FE. La conversion sans rang est de 60 de Pulsation par seconde (6,000 FE/s) ; monte l'adaptateur en rang aux stations d'Écho, et le statut à main vide nomme le débit en cours. Il ne peut toujours pas recevoir de FE. La redstone arrête la conversion et l'exportation.",
		"Comment : cinq lingots de cuivre, trois redstone et un Noyau résonnant."
	]
	quest.4200000000220564.title: "La mesure devient courant"
	quest.4200000000220565.quest_desc: [
		"Le Bâton sextuple. Utilise-le accroupi pour faire défiler Terre, Feu, Eau, Air, Esprit et Métier à tisser. Utilise-le pour lancer ; la voix du Métier à tisser est Amarre, qui tire une cible de huit blocs vers toi, et un lancer accroupi sans cible est Point, un clignement de six blocs. Porte des cellules chargées ; le Codex des Esprits explique chaque sort et son coût.",
		"Comment : un Sceau d'esprit, un Noyau résonnant, un Lingot manifesté et deux bûches."
	]
	quest.4200000000220565.title: "Six voix dans une main"
	quest.4200000000220566.quest_desc: [
		"En main principale, utilise accroupi une face de pierre : une coupe voulue de trois par trois à 8 de Pulsation par bloc. La protection normale à la casse et les exigences d'outil s'appliquent encore.",
		"Comment : deux Lingots manifestés, un Noyau résonnant et deux Résonateurs de cuivre."
	]
	quest.4200000000220566.title: "La pierre cède un seuil"
	quest.4200000000220567.quest_desc: [
		"Le capuchon prête la vue de nuit tant que des cellules chargées le soutiennent. Les pièces non liées tirent 2 de Pulsation toutes les quatre secondes ; une voix liée coûte 3.",
		"Comment : cinq Tissages spirituels, en forme de casque. Une Lentille de ley dessus, plus tard, lui laisse voir la ley."
	]
	quest.4200000000220567.title: "Des yeux dans le calme"
	quest.4200000000220568.quest_desc: [
		"La robe accorde la résistance. Porte-la dans le travail et garde tes cellules chargées.",
		"Comment : sept Tissages spirituels et un Noyau résonnant."
	]
	quest.4200000000220568.title: "Un abri tissé"
	quest.4200000000220569.quest_desc: [
		"Les jambières tissées prêtent la vitesse. Leur coût en Pulsation est à part des autres pièces.",
		"Comment : six Tissages spirituels et un Noyau résonnant."
	]
	quest.4200000000220569.title: "Le camp tient le pas"
	quest.420000000022056A.quest_desc: [
		"Les bottes peuvent prêter la chute lente pendant la descente tant qu'il reste de la Pulsation. Un chemin de retour lié vaut encore d'être porté.",
		"Comment : quatre Tissages spirituels, en forme de botte."
	]
	quest.420000000022056A.title: "Une descente plus douce"
	quest.420000000022056B.quest_desc: [
		"Assieds un sceau réutilisable à côté de son totem correspondant. Une bénédiction de six blocs coûte 8 de Pulsation toutes les deux secondes. Une redstone haute le met en pause ; accroupis-toi à mains vides pour récupérer le sceau.",
		"Comment : deux Lingots manifestés, deux lingots de cuivre, un Noyau résonnant et trois pierres."
	]
	quest.420000000022056B.title: "Une bénédiction qui reste"
	quest.420000000022056C.quest_desc: [
		"Utilise accroupi le dessus d'un sol solide pour le lier. Reviens à moins de 128 blocs, dans le même monde, pour 20 de Pulsation. Alimente le sol d'arrivée pour verrouiller les arrivées.",
		"Comment : une boussole au milieu de quatre Lingots manifestés."
	]
	quest.420000000022056C.title: "Le premier chemin de retour"
	quest.420000000022056D.quest_desc: [
		"Reviens sur n'importe quelle distance dans une dimension pour 40 de Pulsation. Laisse un atterrissage sec avec deux blocs libres au-dessus.",
		"Comment : une Boussole de pierre de route au milieu de quatre Noyaux résonnants."
	]
	quest.420000000022056D.title: "Au-delà de l'horizon"
	quest.420000000022056E.quest_desc: [
		"Cherche le Cristal de la Marche au-delà du Tambour de porte. Les chemins astraux pour les gens, les objets et les fluides puisent tous dans le même matériau de fin de partie.",
		"Comment : mine du cristal dans les grottes de la Marche, ou trouve-le dans les coffres de la Marche. Tambour de porte d'abord."
	]
	quest.420000000022056E.title: "Une voix au-delà du voile"
	quest.420000000022056F.quest_desc: [
		"La boussole finale traverse les dimensions pour 100 de Pulsation. Lie un retour sûr avant d'explorer. Le voyage attend cinq secondes entre deux usages.",
		"Comment : une Boussole de l'horizon, deux Sceaux d'esprit et deux Cristaux de la Marche."
	]
	quest.420000000022056F.title: "Un chemin entre les mondes"
	quest.4200000000220570.quest_desc: [
		"La cargaison astrale traverse les dimensions sans limite de distance. Chaque temps réussi coûte 32 de Pulsation. Le récepteur doit déjà être chargé ; pas de chargement de chunks caché. Depuis 5.0, la plaque veut un Totem de résonance (Métier) éveillé dans les huit blocs, sinon elle reste au repos et dit quelle voix lui manque.",
		"Comment : un Relais d'objets longue portée, deux Sceaux d'Esprit et deux Cristaux de la Marche."
	]
	quest.4200000000220570.title: "Les fournitures traversent le voile"
	quest.4200000000220571.quest_desc: [
		"Le fluide astral suit le même palier dimensionnel que les joueurs et les objets. Garde le réservoir de destination chargé. Un réservoir plein ou un monde non chargé met en pause sans consommer la cargaison. Depuis 5.0, la plaque veut un Totem de résonance (Métier) éveillé dans les huit blocs, sinon elle reste au repos et dit quelle voix lui manque.",
		"Comment : un Relais de fluides longue portée, deux Sceaux d'Esprit et deux Cristaux de la Marche."
	]
	quest.4200000000220571.title: "La pluie traverse le voile"
	quest.4200000000220572.quest_desc: [
		"Ouvre depuis la route ta Cache profonde personnelle de 54 cases. C'est le même coffre, partagé entre tes caches et ta sacoche. L'accord avec la Marche ôte son coût d'ouverture.",
		"Comment : six Tissages spirituels, deux Noyaux résonnants et une Cache profonde."
	]
	quest.4200000000220572.title: "Le camp à ta garde"
	quest.4200000000220573.quest_desc: [
		"La Porte s'ouvre sur un pays vivant. Certaines créatures portent encore le vieux chant ; d'autres en gardent les morceaux brisés. Brosse les douces. Affronte les gardiens avec des cellules de pulsation chargées et un chemin de retour.",
		"Comment : fabrique-le, ou prends-le en récompense d'Étincelle/Tissage tribal. Clic droit : comment marche le treillis."
	]
	quest.4200000000220573.title: "Le chant du retour"
	quest.4200000000220574.quest_desc: [
		"Un brouteur de l'aube qui porte le vieux chant de la forêt dans ses bois. Fais-les se reproduire avec du blé ; brosse les adultes pour obtenir du Velours de l'aube.",
		"Cherche-le dans les forêts de l'Overworld et dans la Marche. Rends son réactif au Lien d'écho, sous la voix Eau, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : brosse un Cerf de l'aube adulte. Fais-les se reproduire avec du blé."
	]
	quest.4200000000220574.title: "Cerf de l'aube : un chant rendu"
	quest.4200000000220575.quest_desc: [
		"Un cueilleur timide du crépuscule, dont la queue marque les chemins sûrs. Fais-les se reproduire avec des baies sucrées ; brosse les adultes pour du Duvet-lanterne.",
		"Cherche-le dans les forêts de l'Overworld et dans la Marche. Rends son réactif au Lien d'écho, sous la voix Eau, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : brosse un Renard-lanterne adulte. Fais-les se reproduire avec des baies sucrées."
	]
	quest.4200000000220575.title: "Renard-lanterne : un chant rendu"
	quest.4200000000220576.quest_desc: [
		"Un jardinier patient des zones humides, à la coquille vivante. Fais-les se reproduire avec de l'herbe aquatique ; brosse les adultes pour une Écaille de Dos-mousse tombée d'elle-même.",
		"Cherche-le dans les marécages de l'Overworld et dans la Marche. Rends son réactif au Lien d'écho, sous la voix Eau, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : brosse un Dos-mousse adulte. Fais-les se reproduire avec de l'herbe aquatique."
	]
	quest.4200000000220576.title: "Dos-mousse : un chant rendu"
	quest.4200000000220577.quest_desc: [
		"Les restes d'un rite de feu brisé. Ses coups au corps à corps enflamment un instant ; garde de l'eau près de toi.",
		"Cherche-le dans les forêts de l'Overworld et dans la Marche. Rends son réactif à l'Accord d'écho, sous la voix Esprit, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe du Cendrélié. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.4200000000220577.title: "Cendrélié : un chant rendu"
	quest.4200000000220578.quest_desc: [
		"Un gardien de bosquet, tordu par une ligne de ley coupée. Lent, mais solide ; ses coups enracinent un instant les voyageurs.",
		"Cherche-le dans les forêts de l'Overworld et dans la Marche. Rends son réactif à l'Accord d'écho, sous la voix Esprit, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe du Racine-lié. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.4200000000220578.title: "Racine-lié : un chant rendu"
	quest.4200000000220579.quest_desc: [
		"Un chasseur des marais, caché parmi les roseaux d'esprit. Les coups rapides portent un poison court.",
		"Cherche-le dans les marécages de l'Overworld et dans la Marche. Rends son réactif à l'Accord d'écho, sous la voix Esprit, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe du Rôdeur des roseaux. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.4200000000220579.title: "Rôdeur des roseaux : un chant rendu"
	quest.420000000022057A.quest_desc: [
		"Un charognard des champs de cristal, cuirassé de pierre chantante. Garde tes distances face à sa poussée lourde.",
		"Cherche-le dans la Marche. Rends son réactif à l'Accord d'écho, sous la voix Esprit, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe du Dos-éclat. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.420000000022057A.title: "Dos-éclat : un chant rendu"
	quest.420000000022057B.quest_desc: [
		"Un veilleur vide qui garde encore les routes anciennes. Son toucher affaiblit la prise des attaquants.",
		"Cherche-le dans la Marche. Rends son réactif à l'Accord d'écho, sous la voix Esprit, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe de la Sentinelle creuse. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.420000000022057B.title: "Sentinelle creuse : un chant rendu"
	quest.420000000022057C.quest_desc: [
		"Un esprit nourri par l'orage, aux vastes ailes de voile. Un rassemblement brillant de poussières prévient de sa rafale ; un abri brise l'attaque.",
		"Cherche-la dans la Marche. Rends son réactif au Lien d'écho, sous la voix Eau, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe de la Phalène de tempête. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.420000000022057C.title: "Phalène de tempête : un chant rendu"
	quest.420000000022057D.quest_desc: [
		"Un esprit agile de braise. Il rassemble des étincelles avant un trait brûlant ; le sort n'embrase jamais le terrain.",
		"Cherche-le dans la Marche. Rends son réactif à l'Accord d'écho, sous la voix Esprit, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe du Diablotin de braise. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.420000000022057D.title: "Diablotin de braise : un chant rendu"
	quest.420000000022057E.quest_desc: [
		"Une relique flottante qui se souvient des tribus perdues. Son carillon annoncé ralentit ; un abri interrompt le chant.",
		"Cherche-le dans la Marche. Rends son réactif à l'Accord d'écho, sous la voix Esprit, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe de la Cloche du deuil. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.420000000022057E.title: "Cloche du deuil : un chant rendu"
	quest.420000000022057F.quest_desc: [
		"Un chasseur attiré par les déchirures du treillis. Il réduit vite la distance, mais ne peut pas franchir les mondes seul.",
		"Cherche-le dans la Marche. Rends son réactif à l'Accord d'écho, sous la voix Esprit, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe du Limier de la faille. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.420000000022057F.title: "Limier de la faille : un chant rendu"
	quest.4200000000220580.quest_desc: [
		"Un gardien à huit pattes des chants brisés. Sa morsure ralentit la proie sans poser de toiles ni abîmer le camp.",
		"Cherche-la dans la Marche. Rends son réactif au Lien d'écho, sous la voix Eau, pour obtenir un matériau utile. Construis des chemins éclairés ; les esprits hostiles exigent l'obscurité.",
		"Comment : tombe du Tisseur d'écho. Les esprits hostiles ont besoin d'obscurité."
	]
	quest.4200000000220580.title: "Tisseur d'écho : un chant rendu"
	quest.4200000000220581.quest_desc: [
		"Les notes de terrain sont complètes. Les récoltes douces et les reliques retrouvées sont redevenues tissu et Échos. Sous le voile de la nuit, le camp répond d'un chant plus plein.",
		"Récompense rare : une vie partagée de Clowder, une seule fois pour toute l'équipe. Seulement six récompenses de ce genre existent dans la campagne.",
		"Comment : Codex des Esprits + Tissage tribal. La station, le totem et le coût en Pulsation sont sur la page du Codex."
	]
	quest.4200000000220581.title: "Treize voix, un ciel"
	quest.4200000000220582.quest_desc: [
		"Suspends le chant du camp dans le cuivre. Une Lanterne d'esprit donne pleine lumière sans combustible ; la redstone la tamise. Marque des chemins sûrs pour revenir du noir.",
		"Comment : trois lingots de cuivre, un Éclat d'esprit et une planche."
	]
	quest.4200000000220582.title: "Une lumière pour ceux qui reviennent"
	quest.4200000000220583.quest_desc: [
		"Le carillon est à la fois ornement et instrument. Son comparateur donne 0 par ciel clair, 8 sous la pluie et 15 sous l'orage. La redstone le fait taire.",
		"Comment : trois planches, trois lingots de cuivre et un Carillon d'os."
	]
	quest.4200000000220583.title: "Écoute le temps"
	quest.4200000000220584.quest_desc: [
		"Une table sculptée tient 27 piles. Les tuyaux d'objets et les relais ordinaires peuvent partager ses offrandes ; les comparateurs lisent le remplissage et la redstone verrouille l'accès.",
		"Comment : un coffre, un Écho lié, deux planches et deux pierres."
	]
	quest.4200000000220584.title: "Une place au foyer"
	quest.4200000000220585.quest_desc: [
		"Place le Gardien du bosquet à hauteur des cultures, dans un lit de 9 sur 9. Mets les graines sur la première rangée ; les récoltes remplissent les deux rangées du bas. Planter coûte 4 de Pulsation, récolter et replanter coûte 12. Fournis l'énergie dans les huit blocs. Une sortie pleine préserve la culture ; la redstone met le travail en pause. Depuis la 5.0, il veut un Totem de résonance de Terre éveillé dans les huit blocs, ou il reste au repos et dit quelle voix lui manque. Garde aussi un totem d'Eau près de lui, et il arrose chaque sillon du lit.",
		"Comment : une houe en fer, un Sceau de Terre, un Écho lié, deux lingots de cuivre et deux planches."
	]
	quest.4200000000220585.title: "Le jardin chante encore"
	quest.4200000000220586.quest_desc: [
		"Huit de Pulsation par seconde empêchent l'apparition d'hostiles dans les 24 blocs. Les créatures déjà présentes restent. La garde empêche aussi les invocations hostiles du Berceau, alors garde ton sol d'invocation en dehors. La redstone fait taire la garde tout de suite. Depuis la 5.0, il veut un Totem de résonance d'Esprit éveillé dans les huit blocs, ou il reste au repos et dit quelle voix lui manque.",
		"Comment : un Sceau d'Esprit, deux Échos liés, un Éclat d'écho et trois Planches de la Marche."
	]
	quest.4200000000220586.title: "Calme au bord du camp"
	quest.4200000000220587.quest_desc: [
		"L'Ancre de voie tient son propre chunk éveillé pour 16 de Pulsation chaque seconde. Place-en une sur un récepteur de relais lointain et maintiens son alimentation locale. Au plus 32 ancres peuvent tourner dans une dimension. La redstone ou un tampon vide relâche le chunk. Depuis la 5.0, elle veut un Totem de résonance de Terre éveillé dans les huit blocs, ou elle reste au repos et dit quelle voix lui manque.",
		"Comment : deux Cristaux de la Marche, un Œil de l'Ender, deux Lingots manifestés, un Noyau résonnant et trois Pierres de la Marche."
	]
	quest.4200000000220587.title: "Un camp qui se souvient"
	quest.4200000000220588.quest_desc: [
		"Utilise accroupi une effigie non chargée sur une créature prise en charge, pour prendre une empreinte sans mal. L'effigie retient l'espèce. Les boss ne peuvent pas être liés ; le Codex explique les esprits compatibles et le renouvellement.",
		"Comment : un Carillon d'os, deux Tissages spirituels, un Noyau résonnant et un Écho lié."
	]
	quest.4200000000220588.title: "Emprunte une voix vivante"
	quest.4200000000220589.quest_desc: [
		"Assieds une effigie éveillée dans le premier emplacement et du Tissage spirituel dans le second. Chaque invocation réussie dépense 80 de Pulsation, un Tissage spirituel et un fil de lien. Laisse un sol sûr dans les trois blocs. Huit créatures proches mettent le Berceau d'invocation en pause ; la redstone met en pause tout le travail et l'automatisation. Depuis la 5.0, il veut un Totem de résonance d'Esprit maintenu à huit blocs, sinon il reste inactif et dit quelle voix lui manque.",
		"Comment : deux Lingots manifestés, un Cristal de la Marche, deux Échos liés, un Noyau résonnant et trois Planches de la Marche."
	]
	quest.4200000000220589.title: "Un foyer pour vie empruntée"
	quest.420000000022058A.quest_desc: [
		"Pose un Sceau d'Esprit dans un Brasero rituel. Amène des totems de Terre, d'Air et d'Esprit à moins de huit blocs, 200 de Pulsation à proximité et trois Tissages spirituels dans ton inventaire. Utilise l'effigie empreinte sur le brasero pour éveiller 512 fils d'invocation. Quand ils sont tous dépensés, répète ce rite pour renouveler le lien.",
		"Comment : Sceau d'Esprit dans un Brasero rituel ; totems de Terre, d'Air et d'Esprit à 8 ; 200 de Pulsation ; trois Tissages spirituels ; utilise l'effigie empreinte."
	]
	quest.420000000022058A.title: "Trois voix éveillent le fil"
	quest.420000000022058B.quest_desc: [
		"Achève une invocation réussie. Les essais ratés ou bloqués ne consomment ni fils ni offrandes. Chaque lien dure 512 invocations réussies ; casser et reposer le Berceau d'invocation ne renouvelle jamais le lien. L'infobulle de l'effigie montre les utilisations restantes, et un comparateur lit la force de lien qu'il reste au berceau.",
		"Comment : achève une invocation réussie depuis le Berceau d'invocation. Les essais ratés ne dépensent rien."
	]
	quest.420000000022058B.title: "Une réponse du berceau"
	quest.4200000000228001.quest_desc: [
		"Au-delà du Tambour de porte, la steppe et les hautes terres de la Marche cachent des Salles des ancêtres enfoncées. Y entrer à pied coche ceci. Quatre Tablettes de récit bordent chaque salle ; lis-les toutes. Les coffres gardent du Fil du métier, des Échos, du Tissage spirituel et des sceaux. Les Sentinelles creuses montent encore la garde.",
		"Comment : Tambour de porte vers la Marche, puis entre à pied dans une Salle des ancêtres ; ensuite lis ses quatre Tablettes de récit."
	]
	quest.4200000000228001.title: "Les salles qui gardaient le temps"
	quest.4200000000228002.quest_desc: [
		"Le Fil du métier est le Métier, en main : les coffres des Salles des ancêtres en tiennent de deux à quatre, le Non-chanté en arrache seize ou plus, et un Ancien des Couseurs du métier en échange un au rang Ami. C'est le réactif de la sixième voix.",
		"Comment : coffres des Salles des ancêtres, le Non-chanté, ou un Ancien des Couseurs du métier à Ami."
	]
	quest.4200000000228002.title: "Un Brin du fil lui-même"
	quest.4200000000228003.quest_desc: [
		"Huit Pierres de la Marche autour d'un Éclat d'écho font deux Tablettes de récit. Posée, une tablette montre un fragment des neuf tribus ; une utilisation accroupie en créatif fait défiler laquelle. Borde ta propre salle avec elles.",
		"Comment : huit Pierres de la Marche autour d'un Éclat d'écho. En fait deux."
	]
	quest.4200000000228003.title: "Grave ce que tu lis"
	quest.4200000000228004.quest_desc: [
		"Du cuir sur des Planches de la Marche, autour d'un Noyau résonnant. Le Cercle des tambours, dans les hautes terres de la Marche, en tient déjà un ; celui-ci est à toi, à asseoir chez toi. Frappe-le quatre fois, un souffle entre chaque, et quelque chose d'ancien se lève.",
		"Comment : trois cuirs, cinq Planches de la Marche et un Noyau résonnant."
	]
	quest.4200000000228004.title: "Un tambour qui ne sonnera pas"
	quest.4200000000228005.quest_desc: [
		"Le Non-chanté est un esprit-tambour en trois phases. Battement : cale-toi en t'accroupissant contre son onde de choc. Chœur : abats les Tisseurs d'écho qu'il appelle. Silence : on ne peut pas le blesser tant que tu n'as pas frappé le Tambour silencieux du même rythme à quatre battements, qui l'étourdit et double tes dégâts. Emporte des cellules de pulsation chargées et un chemin de retour.",
		"Comment : bats-toi contre le Non-chanté au Tambour silencieux. Accroupis-toi au Battement ; quatre battements au Silence."
	]
	quest.4200000000228005.title: "Le tambour se souvient"
	quest.4200000000228006.quest_desc: [
		"Un Cœur du Non-chanté par mise à mort, avec du Fil du métier et des Noyaux résonnants. Il fabrique le totem du Métier et rien d'autre, alors dépense-le avec soin.",
		"Comment : le Non-chanté au Tambour silencieux en lâche un par mise à mort."
	]
	quest.4200000000228006.title: "Le tambour apaisé"
	quest.4200000000228007.quest_desc: [
		"Un Cœur du Non-chanté entre Fil du métier et Cristal de la Marche, sur des Planches de la Marche. Le Métier à tisser rejoint Terre, Feu, Eau, Air et Esprit : une voix distincte pour le Résonateur de pulsation et l'accord que demandent le Détissage d'écho et le Lien de ley.",
		"Comment : un Cœur du Non-chanté, quatre Cristaux de la Marche, deux Fil du métier et deux Planches de la Marche."
	]
	quest.4200000000228007.title: "La sixième voix"
	quest.4200000000228008.quest_desc: [
		"Un Sceau vierge et du Fil du métier. Assis dans un Brasero rituel, le Sceau du métier bénit la tension : toutes les deux secondes, il recharge deux de Pulsation dans les cellules portées de chacun à portée, et prête Chance.",
		"Comment : un Sceau vierge et du Fil du métier, sans forme."
	]
	quest.4200000000228008.title: "Un sceau de tension"
	quest.4200000000228009.quest_desc: [
		"Fil du métier et Résonateurs de cuivre sur de la Pierre de la Marche. Sous une voix du Métier à tisser, le Détissage d'écho fait tourner le treillis à l'envers : un Lingot manifesté en deux Échos liés, le Lié en deux Accordés, l'Accordé en deux Éclats, le Tissage spirituel en deux laines, un Noyau résonnant en trois Lingots manifestés, et n'importe quel outil usé d'équipement spirituel en un Lingot manifesté.",
		"Comment : cinq Pierres de la Marche, du Fil du métier, deux Résonateurs de cuivre et un Éclat d'esprit."
	]
	quest.4200000000228009.title: "Le treillis, à l'envers"
	quest.420000000022800A.quest_desc: [
		"Tourne le Bâton sextuple jusqu'à sa voix du Métier à tisser. L'Amarre tire une cible de huit blocs vers toi pour six de Pulsation ; un lancer accroupi sans cible est Point, un clignement de six blocs dans l'air pour dix. Coche ceci quand tu as utilisé les deux.",
		"Comment : Bâton sextuple sur la voix du Métier à tisser. Amarre une cible, puis Point en accroupi. Coche quand les deux sont partis."
	]
	quest.420000000022800A.title: "Amarre et Point"
	quest.420000000022800B.quest_desc: [
		"Neuf camps de tribu se dressent dans la Marche, un par Brin : huttes, un feu, un Foyer de tribu, un totem, une bannière et quatre Parents de tribu. Fais un clic droit sur un foyer avec ce que cette tribu préfère, ou avec une Cellule de pulsation chargée, et ta réputation auprès d'eux monte. Blesser un Parent coûte 25. Briser la bannière d'une tribu coûte 5, le foyer 40. Les blocs génériques du camp ne coûtent rien.",
		"Comment : clic droit sur un Foyer de tribu de la Marche avec ce que cette tribu favorise, ou avec une Cellule de pulsation chargée."
	]
	quest.420000000022800B.title: "Gardé au chaud"
	quest.420000000022800C.quest_desc: [
		"Invité à 50, Ami à 150, Parent à 400, Voix à 800. Les morts près d'un foyer et les échanges conclus comptent aussi. Les Anciens échangent deux offres par rang : les Chanteurs de gravier vendent des Échos contre du minerai brut, les Graveurs de sceaux vendent des sceaux et des tablettes de rite, les Couseurs du métier vendent du Fil du métier et une Boussole de pierre de route, et au rang Parent une Ancre du métier et un Sceau du métier. `/tribalpower standing` affiche les neuf.",
		"Comment : atteins Ami (150) avec une tribu. /tribalpower standing."
	]
	quest.420000000022800C.title: "En bons termes"
	quest.420000000022800D.quest_desc: [
		"Au rang Voix, un Ancien te presse une Marque de tribu dans la main, une seule fois. Elle ouvre la page du Codex de cette tribu, et c'est le seul ingrédient dont un Totem de parenté ne peut se passer.",
		"Comment : Voix (800) avec une tribu ; l'Ancien donne une Marque de tribu une fois."
	]
	quest.420000000022800D.title: "Neuf d'accord"
	quest.420000000022800E.quest_desc: [
		"Tiens une Marque de tribu. Celle de chaque tribu est différente ; neuf sont possibles.",
		"Comment : atteins Voix (800) avec une tribu ; son Ancien donne la Marque une fois."
	]
	quest.420000000022800E.title: "Marque de la tribu"
	quest.420000000022800F.quest_desc: [
		"Une Marque de tribu, le Totem de résonance de l'accord de cette tribu et deux Tissages spirituels. Un Totem de parenté compte comme une voix distincte de plus pour le Résonateur de pulsation et prête l'accord de sa tribu aux stations, si bien que neuf tribus peuvent porter le chant du camp jusqu'à quinze voix.",
		"Comment : une Marque de tribu, le Totem de résonance de cette tribu et deux Tissages spirituels dans la grille."
	]
	quest.420000000022800F.title: "Une voix qui n'est pas une voix"
	quest.4200000000228010.quest_desc: [
		"Le Tambourinaire d'un camp joue toutes les quelques secondes ; pose un Cœur-tambour à huit blocs de l'un d'eux et chaque battement lui donne deux de Pulsation. Coche ceci quand un Tambourinaire nourrit ton treillis.",
		"Comment : pose un Cœur-tambour à 8 d'un Tambourinaire de camp ; coche quand il donne de la Pulsation."
	]
	quest.4200000000228010.title: "Le camp tient la mesure"
	quest.4200000000228011.quest_desc: [
		"Deux pierres et le réactif autour du sceau ; le sceau est rendu. Racine nouée à côté d'un Sceau de Terre ; 600 de Pulsation. Pendant vingt minutes, les cultures, les pousses et les tiges poussent plus vite dans les neuf chunks autour du brasero. Utilise la tablette accroupi sur un Brasero rituel avec ce sceau assis, dans son Cercle de rite (quatre piédestaux sur les diagonales, la craie les relie) ; la Pulsation est puisée dans le treillis dans un rayon de huit blocs.",
		"Comment : deux pierres, une Racine nouée et un Sceau de Terre, sans forme ; le sceau revient."
	]
	quest.4200000000228011.title: "Tablette de rite : Bénédiction verte"
	quest.4200000000228012.quest_desc: [
		"Deux pierres et le réactif autour du sceau ; le sceau est rendu. Croc de roseau à côté d'un Sceau d'Eau ; 400 de Pulsation. Vingt minutes de pluie, pour les citernes et les cultures. Utilise la tablette accroupi sur un Brasero rituel avec ce sceau assis, dans son Cercle de rite (quatre piédestaux sur les diagonales, la craie les relie) ; la Pulsation est puisée dans le treillis dans un rayon de huit blocs.",
		"Comment : deux pierres, un Croc de roseau et un Sceau d'Eau, sans forme ; le sceau revient."
	]
	quest.4200000000228012.title: "Tablette de rite : Appel de la pluie"
	quest.4200000000228013.quest_desc: [
		"Deux pierres et le réactif autour du sceau ; on te rend le sceau. Aile de tempête à côté d'un Sceau d'air ; 400 de Pouls. Quarante minutes de ciel clair. Utilise accroupi la tablette sur un Brasero rituel avec ce sceau assis, dans son Cercle de rite (quatre piédestaux sur les diagonales, la craie les relie) ; le Pouls est tiré du treillis dans un rayon de huit blocs.",
		"Comment : deux pierres, une Aile de tempête et un Sceau d'air, sans forme ; le sceau revient."
	]
	quest.4200000000228013.title: "Tablette de rite : Dégagement du ciel"
	quest.4200000000228014.quest_desc: [
		"Deux pierres et le réactif autour du sceau ; on te rend le sceau. Cœur de braise à côté d'un Sceau de feu ; 800 de Pouls. Hâte la nuit jusqu'au prochain lever du soleil, pour le monde entier. Utilise accroupi la tablette sur un Brasero rituel avec ce sceau assis, dans son Cercle de rite (quatre piédestaux sur les diagonales, la craie les relie) ; le Pouls est tiré du treillis dans un rayon de huit blocs.",
		"Comment : deux pierres, un Cœur de braise et un Sceau de feu, sans forme ; le sceau revient."
	]
	quest.4200000000228014.title: "Tablette de rite : appel de l'aube"
	quest.4200000000228015.quest_desc: [
		"Deux pierres et le réactif autour du sceau ; on te rend le sceau. Sceau sentinelle à côté d'un Sceau d'esprit ; 600 de Pouls. Quinze minutes sans apparitions hostiles dans les soixante-quatre blocs. Utilise accroupi la tablette sur un Brasero rituel avec ce sceau assis, dans son Cercle de rite (quatre piédestaux sur les diagonales, la craie les relie) ; le Pouls est tiré du treillis dans un rayon de huit blocs.",
		"Comment : deux pierres, un Sceau sentinelle et un Sceau d'esprit, sans forme ; le sceau revient."
	]
	quest.4200000000228015.title: "Tablette de rite : nuit calme"
	quest.4200000000228016.quest_desc: [
		"Deux pierres et le réactif autour du sceau ; on te rend le sceau. Fil du métier à côté d'un Sceau du métier ; 1 200 de Pouls. Relie le totem le plus proche à un autre dans les soixante-quatre blocs par une ligne de ley de trente minutes qui fait passer le Pouls de l'un à l'autre. Utilise accroupi la tablette sur un Brasero rituel avec ce sceau assis, dans son Cercle de rite (quatre piédestaux sur les diagonales, la craie les relie) ; le Pouls est tiré du treillis dans un rayon de huit blocs.",
		"Comment : deux pierres, du Fil du métier et un Sceau du métier, sans forme ; le sceau revient."
	]
	quest.4200000000228016.title: "Tablette de rite : lien de ley"
	quest.4200000000228017.quest_desc: [
		"Accomplis n'importe quel rite. Si le treillis autour du brasero contient trop peu de Pouls, rien n'est consommé et le brasero le dit.",
		"Comment : utilise accroupi n'importe quelle Tablette de rite sur un Brasero rituel dans son Cercle de rite, avec le sceau et le Pouls qui correspondent."
	]
	quest.4200000000228017.title: "Premier rite"
	quest.4200000000228018.quest_desc: [
		"Deux Tissages spirituels, un Éclat d'esprit et le réactif de l'espèce. Utilise-le sur un familier adulte. Animaux : soixante pour cent, le charme est gardé en cas d'échec. Les restes veulent Voix avec leur tribu, quarante pour cent, le charme est dépensé en cas d'échec.",
		"Comment : deux Tissages spirituels, un Éclat d'esprit et un réactif de familier (Velours de l'aube, Duvet de lanterne, Aile de tempête et d'autres du même genre)."
	]
	quest.4200000000228018.title: "Un charme pour une bête sauvage"
	quest.4200000000228019.quest_desc: [
		"Un familier lié te suit, se téléporte derrière toi, ne disparaît jamais, tu ne peux pas le blesser, et il rend le double quand tu le brosses. Le Renard-lanterne, le Dos-mousse et le Cerf de l'aube te mettent en route. Les restes ont besoin de Voix. Un combattant et deux aides peuvent suivre ; ceux qui sont assis ne comptent pas.",
		"Comment : utilise un Charme de lien sur un familier adulte. Le progrès se déclenche au premier lien."
	]
	quest.4200000000228019.title: "Un ami dans le noir"
	quest.420000000022801A.quest_desc: [
		"Papier, Tissage spirituel et un Éclat d'esprit. Utilise la charte sur un joueur pour l'inviter dans ton camp, ou dans l'air pour le voir. `/tribalpower camp` crée, invite, rejoint, quitte, expulse et renomme.",
		"Comment : papier, Tissage spirituel et un Éclat d'esprit, sans forme."
	]
	quest.420000000022801A.title: "Un camp aux nombreuses voix"
	quest.420000000022801B.quest_desc: [
		"Les membres du camp partagent un coffre de camp de cinquante-quatre cases derrière chaque Cache profonde et chaque Sacoche du voyageur, comptent comme propriétaires des appareils les uns des autres, mettent en commun douze Ancres de voie et reflètent au camp un quart de leur estime de tribu. Un Clowder n'est pas ce camp — /tribalpower camp create <name> l'est.",
		"Comment : /tribalpower camp create <name> (pas un Clowder). Le progrès se déclenche au premier camp."
	]
	quest.420000000022801B.title: "Un coffre, un budget"
	quest.420000000022801C.quest_desc: [
		"Une vitre sur un Résonateur de cuivre et un Éclat d'esprit. En main, la lentille montre la force de la ley là où tu te tiens et la peint au sol autour de toi ; utilise-la accroupi sur un Collecteur de ley, ou un familier, pour ses chiffres.",
		"Comment : une vitre, un Résonateur de cuivre et un Éclat d'esprit, en colonne."
	]
	quest.420000000022801C.title: "Voir la ley"
	quest.420000000022801D.quest_desc: [
		"Du quartz sur de la redstone et un Résonateur de cuivre, sur de la Pierre de la Marche. Tourné vers n'importe quel réservoir de Pouls, il sort de la redstone de 0 à 15 selon ce qui est stocké.",
		"Comment : quartz, deux redstone, un Résonateur de cuivre et de la Pierre de la Marche."
	]
	quest.420000000022801D.title: "Une aiguille pour le Pouls"
	quest.420000000022801E.quest_desc: [
		"Une torche de redstone sur de la redstone et un Résonateur de cuivre, sur de la Pierre de la Marche. Il émet quand le réservoir visé est à son seuil ou au-dessus ; un clic droit fait défiler 25, 50, 75 et 100 pour cent. Les pièces d'une automatisation menée par le Pouls.",
		"Comment : une torche de redstone, deux redstone, un Résonateur de cuivre et de la Pierre de la Marche."
	]
	quest.420000000022801E.title: "Une ligne dans le chant"
	quest.420000000022801F.quest_desc: [
		"Utilise accroupi le Codex des Esprits sur n'importe quel bloc tribal pour un rapport simple : la Pulsation stockée, les générateurs qui l'alimentent, les accords dans les huit blocs, ce qui manque à la recette en cours, une sortie pleine, une pause de redstone, une extrémité de relais non chargée. Coche ceci quand il t'a dit quelque chose que tu ne savais pas.",
		"Comment : utilise accroupi le Codex des Esprits sur un bloc tribal ; coche quand le rapport nomme un vrai défaut."
	]
	quest.420000000022801F.title: "Demande au Codex pourquoi"
	quest.4200000000228020.quest_desc: [
		"Demande de la roche à une Source de Pierre. La Pierre ne se fabrique pas ; on demande à la pierre de rester. La roche n'a besoin que de la forme et de Pulsation ; un Totem de Terre dans les huit blocs lui permet de demander de la pierre.",
		"Comment : cinq roches, un Éclat d'écho et un Cœur-tambour."
	]
	quest.4200000000228020.title: "Une source de pierre"
	quest.4200000000228021.quest_desc: [
		"Complète n'importe quel motif. Le placement est le rituel : des appareils épars ne sont pas un rite.",
		"Comment : place un motif de rite du Codex des Esprits ; le progrès se déclenche au premier cercle complet."
	]
	quest.4200000000228021.title: "Trace le cercle"
	quest.4200000000228022.quest_desc: [
		"Demande à une Source de Pierre sa première roche. La Pierre ne se fabrique pas ; on demande à la pierre de rester.",
		"Comment : fais tourner la Source de Pierre jusqu'à ce que la roche apparaisse. Le progrès, à la première fois qu'elle reste."
	]
	quest.4200000000228022.title: "La Pierre reste"
	quest.4200000000228023.quest_desc: [
		"Utilise accroupi le Codex des Esprits sur la source quand elle travaille. Coche ceci quand le rapport nomme de la Pulsation stockée ou un totem manquant.",
		"Comment : utilise accroupi le Codex des Esprits sur la Source de Pierre ; coche quand le rapport nomme un vrai défaut ou un tampon plein."
	]
	quest.4200000000228023.title: "La source répond"
	quest.4200000000228024.quest_desc: [
		"Garde une cellule chargée à la source pour que la demande ne cale pas.",
		"Comment : remplis une Cellule de pulsation à un Cœur-tambour, puis coche ceci quand la source est alimentée."
	]
	quest.4200000000228024.title: "Une cellule à la source"
	quest.4200000000228025.quest_desc: [
		"La maille ne trouve pas le minerai ; la maille donne au minerai un endroit où se poser. Assieds-la sur une Fosse d'écoute.",
		"Comment : quatre Pierres de la Marche, deux Échos accordés, deux Tissages spirituels et un Résonateur de cuivre."
	]
	quest.4200000000228025.title: "Une maille qui écoute"
	quest.4200000000228026.quest_desc: [
		"Quatre Pierres d'ancre tiennent les coins de la fosse. Sans elles, la maille n'a nulle part où se tenir.",
		"Comment : quatre Pierres de la Marche sur un Éclat d'écho. En fait quatre."
	]
	quest.4200000000228026.title: "Quatre ancres"
	quest.4200000000228027.quest_desc: [
		"Appelle le premier minerai à travers une Fosse d'écoute.",
		"Comment : Maille de résonance sur une fosse avec des Pierres d'ancre ; le progrès se déclenche au premier minerai."
	]
	quest.4200000000228027.title: "Demande au sol"
	quest.4200000000228028.quest_desc: [
		"Le gravillon d'or de la fosse est la voix suivante après le fer.",
		"Comment : continue de demander au sol ; coche quand tu as du gravillon d'or en main."
	]
	quest.4200000000228028.title: "Or de la fosse"
	quest.4200000000228029.quest_desc: [
		"La fosse dépense de la Pulsation. Garde une cellule sur la maille pour que la demande ne cale pas.",
		"Comment : remplis une Cellule de pulsation à un Cœur-tambour et assieds-la où le Codex le montre."
	]
	quest.4200000000228029.title: "La fosse tient le tempo"
	quest.420000000022802A.quest_desc: [
		"Onze Cadres de porte et la clé de voûte cernent le chemin. Un cadre manquant est un pas manquant.",
		"Comment : six Pierres de la Marche, deux lingots de cuivre et un Éclat d'écho. En fait quatre."
	]
	quest.420000000022802A.title: "Un cadre pour le chemin"
	quest.420000000022802B.quest_desc: [
		"La clé de voûte est la douzième pierre. Sans elle, l'anneau n'est qu'un motif.",
		"Comment : quatre Cadres de porte, un Noyau résonnant, un Éclat d'esprit et une Cellule de pulsation."
	]
	quest.420000000022802B.title: "La clé de voûte"
	quest.420000000022802C.quest_desc: [
		"Allume une Porte du chemin. Onze cadres, une clé de voûte, et un endroit où être.",
		"Comment : finis l'anneau et allume-le ; le progrès se déclenche quand le chemin s'ouvre."
	]
	quest.420000000022802C.title: "Ouvre le chemin"
	quest.420000000022802D.quest_desc: [
		"Utilise le sceau accroupi sur une clé de voûte pour l'inscrire. Utilise-le sur une seconde clé de voûte pour lier les deux.",
		"Comment : un Sceau vierge, du Fil du métier et un Éclat d'esprit, sans forme."
	]
	quest.420000000022802D.title: "Écris la destination"
	quest.420000000022802E.quest_desc: [
		"Voyage par une Porte lointaine d'une dimension à une autre. Le Métier à tisser n'a jamais été un seul fil.",
		"Comment : lie deux clés de voûte avec un Sceau de porte, puis marche la porte lointaine."
	]
	quest.420000000022802E.title: "Le long fil"
	quest.420000000022802F.quest_desc: [
		"Le générateur du feu. Assieds-le près de son totem ; un Cœur-tambour en main ne peut pas porter cette voix.",
		"Comment : trois lingots de cuivre, un Nœud de braise, un Sceau de feu et deux Planches de la Marche."
	]
	quest.420000000022802F.title: "La voix du feu"
	quest.4200000000228030.quest_desc: [
		"Le générateur du vent. Assieds-le près de son totem pour que les six s'entendent.",
		"Comment : quatre Tissages spirituels, une Aile de tempête, un Sceau d'air et deux Planches de la Marche."
	]
	quest.4200000000228030.title: "La voix du vent"
	quest.4200000000228031.quest_desc: [
		"Le générateur de l'eau. Assieds-le près de son totem ; les citernes et les sources écoutent cette voix.",
		"Comment : deux cuirs, trois Planches de la Marche, une Racine nouée et un Sceau d'Eau."
	]
	quest.4200000000228031.title: "La voix de l'eau"
	quest.4200000000228032.quest_desc: [
		"La cloche de réveil est la longue note de l'esprit. Assieds-la près de son totem, avec les cinq autres.",
		"Comment : un Fragment de cloche, quatre lingots de cuivre, un Sceau d'Esprit et un Éclat d'esprit."
	]
	quest.4200000000228032.title: "Le réveil de la terre"
	quest.4200000000228033.quest_desc: [
		"Le sixième générateur. La voix du Métier à tisser a besoin de Fil du métier ; le Non-chanté et les Anciens des Couseurs du métier le gardent.",
		"Comment : quatre Cristaux de la Marche, deux Fils du métier, deux Tissages spirituels et un Noyau résonnant."
	]
	quest.4200000000228033.title: "Le sixième générateur"
	quest.4200000000228034.quest_desc: [
		"Un cairn garde le Pouls dans le champ, pour que six voix partagent une réserve.",
		"Comment : six Pierres de la Marche, deux Échos liés et une Cellule de pulsation."
	]
	quest.4200000000228034.title: "Un cairn de Pouls"
	quest.4200000000228035.quest_desc: [
		"Mets les six générateurs en production à 32 blocs les uns des autres, un par voix.",
		"Comment : Cor de braise, Harpe du vent, Tambour de vague, Cloche de l'éveil, Ancre du métier et Cœur-tambour dans les 32. Progrès sur six voix."
	]
	quest.4200000000228035.title: "Six voix qui chantent"
	quest.4200000000228036.quest_desc: [
		"La tablette demande à une citerne de continuer à donner. Dix minutes d'eau, et le sceau est gardé.",
		"Comment : utilise accroupi la tablette sur un Brasero rituel dans son Cercle de rite, avec le sceau et le Pouls qui correspondent."
	]
	quest.4200000000228036.title: "Une source qui continue de donner"
	quest.4200000000228037.quest_desc: [
		"Le cercle des tambours dont le Non-chanté se souvient encore. Souvenir facultatif.",
		"Comment : le Non-chanté au Tambour silencieux peut le lâcher. Facultatif."
	]
	quest.4200000000228037.title: "Le cercle des tambours"
	quest.4200000000228038.quest_desc: [
		"Un sceau vierge après le premier rite, prêt pour le cercle suivant.",
		"Comment : Premier rite au brasero ; coche quand un sceau vierge de rechange est en main."
	]
	quest.4200000000228038.title: "Un sceau de rechange"
	quest.4200000000228039.quest_desc: [
		"L'atelier du feu. Un Totem de Feu dans les huit et du Pouls font tourner chaque recette de fourneau, gravillon minéral compris. Un Cœur-tambour en main ne peut pas tenir ce four.",
		"Comment : fourneau + résonateurs + carillon. Totem de Feu. Fond le gravillon pour du Pouls — un Cœur-tambour en main ne peut pas le faire tourner."
	]
	quest.4200000000228039.title: "Gravillon dans le four"
	quest.420000000022803A.quest_desc: [
		"Tisse un Sceau de recette pour un atelier. Les bouteilles vides reviennent à l'emplacement qui les tenait. L'E/S latérale refuse les spectateurs et les autres camps. Depuis la 5.0, il veut un Totem de résonance (Métier) éveillé dans les huit blocs, sinon il reste au repos et dit quelle voix lui manque.",
		"Comment : le Codex des Esprits nomme la fabrication du Métier à sceaux. Assieds les bouteilles ; elles reviennent à cet emplacement."
	]
	quest.420000000022803A.title: "Un métier pour les sceaux"
	quest.420000000022803B.quest_desc: [
		"Quatre lampes de Pulsation bon marché (Roseau lumineux, Lampe d'éclat, Applique d'écho, Bol de braise) tirent 1–2 de Pulsation par seconde du treillis. La redstone les assombrit.",
		"Comment : fabrique une Lampe d'éclat, place-la à huit blocs de la Pulsation, puis assombris-la avec de la redstone si tu veux la nuit."
	]
	quest.420000000022803B.title: "Une lampe qui boit la Pulsation"
	quest.420000000022803C.quest_desc: [
		"Dix Charmes d'esprit se portent dans trois emplacements tribaux, pas de Curios. Ciel avec Air, c'est le vol créatif. Utilise accroupi un Totem de résonance pour lier une voix ; Chœur lie chaque voix proche à un Brasero.",
		"Comment : fabrique le Charme du ciel, puis utilise-le accroupi sur un totem d'Air. Codex des Esprits : Charmes d'esprit."
	]
	quest.420000000022803C.title: "Un charme avec une voix"
	quest.420000000022803D.quest_desc: [
		"L'atelier de l'eau. Monte-la en rang aux stations d'écho, comme l'équipement spirituel ; un rang plus haut dépense plus de Pulsation en accélérant. Le rang survit quand tu la ramasses. Depuis la 5.0, elle veut un Totem de résonance d'Eau éveillé dans les huit blocs, sinon elle reste au repos et dit quelle voix lui manque.",
		"Comment : pages d'atelier du Codex des Esprits. Place la Pompe de marée sur une face de citerne, puis utilise accroupi le Codex si elle reste silencieuse."
	]
	quest.420000000022803D.title: "Une pompe pour la citerne"
	quest.420000000022803E.quest_desc: [
		"Chaque Pulsation devient toujours 100 FE. La conversion sans rang est de 60 de Pulsation par seconde. Monte l'adaptateur en rang à l'Accord d'écho, puis au Lien d'écho, puis au Manifeste d'écho, et le statut à main vide nomme le débit en cours. Il ne peut toujours pas recevoir de FE.",
		"Comment : utilise accroupi un Énergiseur harmonique sur l'Accord d'écho, puis sur le Lien d'écho, puis sur le Manifeste d'écho. Coche quand le diagnostic nomme un débit au-dessus de 60."
	]
	quest.420000000022803E.title: "Rang du courant"
	quest.420000000022803F.quest_desc: [
		"Utilise accroupi n'importe quelle pièce d'équipement spirituel ou un charme sur un Totem de résonance posé (40 de Pulsation) pour lier cette voix. Les ensembles mixtes sont prévus. Le totem n'est pas consommé. Le Métier à tisser a besoin d'un totem du Métier.",
		"Comment : utilise accroupi un outil, une pièce d'armure ou un charme sur un totem avec 40 de Pulsation à proximité. Coche quand l'infobulle nomme la voix liée."
	]
	quest.420000000022803F.title: "Lie une voix"
	quest.4200000000228040.quest_desc: [
		"Une lampe de roseau. Lumière de Pulsation bon marché pour un sentier de camp. Facultatif.",
		"Comment : fabrique le Roseau lumineux. Place-le près de la Pulsation. Facultatif."
	]
	quest.4200000000228040.title: "Lumière de roseau"
	quest.4200000000228041.quest_desc: [
		"Une applique murale qui boit la Pulsation. Facultatif.",
		"Comment : fabrique l'Applique d'écho et accroche-la. Facultatif."
	]
	quest.4200000000228041.title: "Applique d'écho"
	quest.4200000000228042.quest_desc: [
		"Un bol de lumière de feu de camp, sur Pulsation. Facultatif.",
		"Comment : fabrique le Bol de braise. Facultatif."
	]
	quest.4200000000228042.title: "Bol de braise"
	quest.4200000000228043.quest_desc: [
		"Accroche un charme de vent au plafond. Meubles du camp de la Marche : tabouret, table, urne, natte, étagère, et celui-ci. Facultatif.",
		"Comment : fabrique le Charme de vent et accroche-le. Souvenir facultatif."
	]
	quest.4200000000228043.title: "Un charme au vent"
	quest.4200000000228044.quest_desc: [
		"Chœur lie chaque voix de totem proche à un Brasero rituel. Facultatif une fois Ciel en main.",
		"Comment : fabrique le Charme de chœur, puis utilise-le accroupi à un Brasero avec des voix à portée. Facultatif."
	]
	quest.4200000000228044.title: "Chaque voix proche"
	quest.4200000000228045.quest_desc: [
		"La hache dépense de la Pulsation comme la pioche. Monte-la en rang aux stations d'écho ; utilise accroupi un totem pour lier une voix. Facultatif.",
		"Comment : fabrique la Hache de l'équipement spirituel. Facultatif une fois la pioche en place."
	]
	quest.4200000000228045.title: "Un tranchant pour le bois"
	quest.4200000000228046.quest_desc: [
		"Des briques et un bol sur trois de cuivre. Pose-le sur un feu de camp allumé, du feu, du magma, de la lave ou un Bol de braise ; il ne demande aucun Pouls. Jusqu'à quatre ingrédients et un bol, dans n'importe quel ordre, environ douze secondes par repas. Les entonnoirs l'alimentent par le dessus et par les côtés, et prennent le repas par en dessous.",
		"Comment : briques et un bol sur trois de cuivre. Pose-le sur un feu de camp, du feu, du magma, de la lave ou un Bol de braise ; pas de Pouls."
	]
	quest.4200000000228046.title: "Un pot pour le camp"
	quest.4200000000228047.quest_desc: [
		"Un tubercule rouge et chaud de la Désolation des braises. Ce que tu cueilles est la graine ; plante-le sur de la terre labourée comme une pomme de terre. La Houe de l'équipement spirituel moissonne et replante d'un seul coup.",
		"Comment : pousse à l'état sauvage dans la Désolation des braises, par un Tambour de porte. Ce que tu cueilles est la graine ; plante-le sur de la terre labourée."
	]
	quest.4200000000228047.title: "Racine de braise"
	quest.4200000000228048.quest_desc: [
		"Pousse à l'état sauvage dans le Marais aux roseaux. Cueille une touffe et plante ce que tu as cueilli ; quatre stades sur sol labouré, et les abeilles le pollinisent.",
		"Comment : pousse à l'état sauvage dans le Marais aux roseaux, par un Tambour de porte. Plante ce que tu as cueilli sur de la terre labourée."
	]
	quest.4200000000228048.title: "Riz de tourbière"
	quest.4200000000228049.quest_desc: [
		"Des Champs de neige. Ça compte aussi comme herbe pour la Bouilloire spirituelle.",
		"Comment : pousse à l'état sauvage dans les Champs de neige, par un Tambour de porte. Plante ce que tu as cueilli sur de la terre labourée."
	]
	quest.4200000000228049.title: "Baie de givre"
	quest.420000000022804A.quest_desc: [
		"De la Crête du chatoiement. Une herbe pour la bouilloire, et aussi une culture.",
		"Comment : pousse à l'état sauvage sur la Crête du chatoiement, par un Tambour de porte. Plante ce que tu as cueilli sur de la terre labourée."
	]
	quest.420000000022804A.title: "Haricot de lueur"
	quest.420000000022804B.quest_desc: [
		"De la Steppe, et c'est le grain de base de la plupart des plats des tribus. Fais-en une planche avant le reste.",
		"Comment : pousse à l'état sauvage sur la Steppe, par un Tambour de porte. Plante ce que tu as cueilli sur de la terre labourée."
	]
	quest.420000000022804B.title: "Grain de steppe"
	quest.420000000022804C.quest_desc: [
		"Deux Grains de steppe et un Gravillon de fer dans le Pot du foyer. Manger le plat d'une tribu porte sa faveur pendant cinq minutes ; celle des Chanteurs de gravier tire plus du minerai. Dès qu'une tribu t'appelle Ami, ses Proches vendent le plat pour quatre de sa culture, et offrir à une tribu son propre plat à son foyer rapporte six d'estime.",
		"Comment : deux Grains de steppe et un Gravillon de fer dans un Pot du foyer sur la chaleur. Les Proches des Chanteurs de gravier le vendent au rang Ami."
	]
	quest.420000000022804C.title: "La miche des Chanteurs de gravier"
	quest.420000000022804D.quest_desc: [
		"Deux de Gibier cru et une Racine de braise. Le Gibier cru tombe des animaux-gibier de la Marche. La faveur des Marche-lisières : tu ne tombes jamais tant que tu t'accroupis. Chaque tribu a un plat ; JEI liste les neuf sous le pot.",
		"Comment : deux de Gibier cru et une Racine de braise dans un Pot du foyer. Le Gibier cru tombe du gibier de la Marche."
	]
	quest.420000000022804D.title: "La viande séchée des Marche-lisières"
	quest.420000000022804E.quest_desc: [
		"Purée de racine du gardien, Pain cuit au gravillon, une Racine de braise et du Grain de steppe dans le pot. Pose le festin sur un bloc solide : il tient six parts ; chacune te rassasie et accorde la bénédiction de Terre pendant huit minutes — tu creuses plus vite, tu tiens bon. Chaque voix a un festin de ses propres plats.",
		"Comment : Purée de racine du gardien, Pain cuit au gravillon, Racine de braise et Grain de steppe dans un Pot du foyer. Pose-le ; six parts."
	]
	quest.420000000022804E.title: "Une table pour le camp"
	quest.420000000022804F.quest_desc: [
		"Des os et du fer autour d'un chaudron, un Carillon d'os dessous. Pose-le sur la chaleur. Trois sièges : un réactif brut tiré de ta sacoche, une herbe de la Marche et une base — une bouteille en verre fait deux teintures, un rayon de miel deux onguents, du charbon de bois quatre encens. Une fournée, c'est dix secondes et 24 de Pulsation du treillis. Le totem le plus proche, dans les huit blocs, chante dans la décoction.",
		"Comment : des os et du fer autour d'un chaudron, un Carillon d'os dessous. Pose-le sur la chaleur ; un totem dans les 8 façonne la décoction."
	]
	quest.420000000022804F.title: "Une bouilloire sur le feu"
	quest.4200000000228050.quest_desc: [
		"La famille du réactif choisit le remède : Petit-bois est Force, Refroidissement est Résistance au feu, Antidote enlève le poison, Raccommodage est Régénération, et ainsi de suite. Une teinture dure trois minutes et te rend la bouteille. Chaque remède enlève le Mal d'esprit, le Silence non-chanté, l'Effiloché et le Mal de ley.",
		"Comment : Bouilloire spirituelle — un réactif brut, une herbe de la Marche et une bouteille en verre. Dix secondes, 24 de Pulsation, deux teintures."
	]
	quest.4200000000228050.title: "Bois-le"
	quest.4200000000228051.quest_desc: [
		"Le rayon de miel comme base. Utilise un onguent sur toi, ou sur un ami, un villageois ou ton familier : trois cœurs d'un coup, tout effet néfaste parti, et le remède pendant la moitié du temps d'une teinture. Une pile de ces onguents fait la différence entre une nuit dure dans la Marche et un retour à pied.",
		"Comment : Bouilloire spirituelle — un réactif brut, une herbe de la Marche et un rayon de miel. Deux onguents par fournée."
	]
	quest.4200000000228051.title: "Pose-le"
	quest.4200000000228052.quest_desc: [
		"Le charbon de bois comme base. Assieds l'encens dans un Brasero rituel — jusqu'à seize bâtons, sans sceau et sans Pulsation — et toutes les deux secondes tous ceux dans les huit blocs reçoivent le remède, et les familiers sont raccommodés d'un cœur. Chaque bâton brûle trente secondes. La redstone l'éteint ; accroupis-toi les mains vides pour le reprendre.",
		"Comment : Bouilloire spirituelle — un réactif brut, une herbe de la Marche et du charbon de bois. Quatre encens par fournée ; brûle-les dans un Brasero rituel."
	]
	quest.4200000000228052.title: "Brûle-le pour tous"
	quest.4200000000228053.quest_desc: [
		"Deux Carillons d'os autour d'un Lingot manifesté sur un bâton. Maintiens Utiliser et, chaque demi-seconde, il raccommode celui que tu regardes dans les six blocs, ou toi : trois quarts de cœur pour 2 de Pulsation. Il se classe aux stations d'Écho comme le reste de l'équipement spirituel ; à partir de Lié, chaque secousse allège le Mal d'esprit d'un niveau.",
		"Comment : deux Carillons d'os autour d'un Lingot manifesté sur un bâton. Maintiens Utiliser pour raccommoder celui que tu regardes."
	]
	quest.4200000000228053.title: "Secoue-le"
	quest.4200000000228054.quest_desc: [
		"De la roche sur un bloc de magma en fait quatre. Au-dessus de la chaleur, elles fument. Dors toute la nuit dans un lit, avec des pierres chaudes à cinq blocs et un toit au-dessus de toi : tu te réveilles entièrement soigné, purifié, avec dix minutes de Bénédiction spirituelle, pour que le mal ne prenne pas.",
		"Comment : de la roche sur un bloc de magma en fait quatre. Pose-les au-dessus de la chaleur, à cinq blocs d'un lit sous un toit."
	]
	quest.4200000000228054.title: "Une nuit au logis"
	quest.4200000000228055.quest_desc: [
		"Deux pierres, une Écaille de Dos-mousse et du Roseau d'esprit autour d'un Sceau d'esprit ; le sceau te est rendu. Lance-le sur un brasero où siège un Sceau d'esprit, dans son Cercle de rite, pour 500 de Pouls : tous dans les douze blocs regagnent dix cœurs, sont purifiés et bénis, et le cercle reste ouvert dix minutes. Pose d'abord le Vestige spirituel d'un familier tombé sur un piédestal, et il revient entier.",
		"Comment : deux pierres, une Écaille de Dos-mousse, du Roseau d'esprit et un Sceau d'esprit, sans forme ; le sceau revient. Lance-le sur un brasero scellé, dans son Cercle de rite."
	]
	quest.4200000000228055.title: "Tablette de rite : Cercle de soin"
	quest.4200000000228056.quest_desc: [
		"Un Lingot manifesté, un Carillon d'os et un bâton en diagonale. Sept de dégâts, portée plus un et demi, et une poussée en sprint frappe 35 pour cent plus fort. En dessous, c'est une Lame : elle se classe aux stations d'Écho, dépense du Pouls en frappes d'écho et prend une voix de totem. Elle tient un Limier de la faille à bout de bras.",
		"Comment : Lingot manifesté, Carillon d'os et un bâton en diagonale. Se classe aux stations d'Écho comme la Lame."
	]
	quest.4200000000228056.title: "D'abord la portée"
	quest.4200000000228057.quest_desc: [
		"Quatre Lingots manifestés en T au-dessus d'un Carillon d'os. Dix de dégâts, portée plus un demi, lourd — il ralentit ta marche tant qu'il est en main — et le balayage le plus large et le plus fort de la famille. La hallebarde, la hache de bataille, le marteau de guerre, la dague, la faux et le trident se fabriquent de la même façon ; chacun échange portée, vitesse et poids contre les autres.",
		"Comment : quatre Lingots manifestés en T au-dessus d'un Carillon d'os. Lourd ; le plus large balayage."
	]
	quest.4200000000228057.title: "Le plus large balayage"
	quest.4200000000228058.quest_desc: [
		"De la ficelle et des Résonateurs de cuivre autour d'un Carillon d'os. Il tire des traits soniques avec le Pouls des cellules que tu portes, et prend des flèches de vers. Vite à relâcher encore, et à mi-traction si tu es pressé.",
		"Comment : ficelle et Résonateurs de cuivre autour d'un Carillon d'os. Tire des traits soniques avec le Pouls porté."
	]
	quest.4200000000228058.title: "Un arc qui chante"
	quest.4200000000228059.quest_desc: [
		"Des Lingots manifestés de chaque côté d'un Arc de pulsation, un crochet de fil-piège et des bâtons en dessous. Maintiens Utiliser pour charger — 10 de Pulsation d'avance, un peu plus longtemps qu'une tension à fond — puis utilise encore pour tirer. Il frappe environ moitié plus fort, vole presque droit et garde son tir aussi longtemps que tu veux.",
		"Comment : Lingots manifestés de chaque côté d'un Arc de pulsation, crochet de fil-piège et bâtons en dessous. Maintiens Utiliser pour charger, utilise pour tirer."
	]
	quest.4200000000228059.title: "La sœur plus lourde de l'arc"
	quest.420000000022805A.quest_desc: [
		"L'Établi du chant a un siège d'arme à côté de la sortie. Dresse un totem à portée avec de la Pulsation dans le treillis, garde ta Sacoche de réactifs dans la barre rapide avec quatre réactifs renforcés d'une même sorte, assieds une arme d'équipement spirituel, choisis le réactif et appuie sur Onction : quatre réactifs et 32 de Pulsation. Brûlure brûle, Appel d'orage lance l'éclair en arc, Soif de sang vole la vie, Raccommodage répare l'arme — onze en tout, une à la fois ; un autre réactif la remplace. Seul l'équipement spirituel reçoit le travail de l'établi, sauf si un pack ouvre tribalpower:anointable. Coche ceci quand une arme en porte une.",
		"Comment : arme d'équipement spirituel dans le siège d'arme de l'Établi du chant, quatre réactifs renforcés dans la sacoche, 32 de Pulsation ; appuie sur Onction. Coche quand elle est ointe."
	]
	quest.420000000022805A.title: "Un réactif dans la lame"
	quest.420000000022805B.quest_desc: [
		"Des lianes autour d'un Roseau d'esprit et une perle de l'Ender en font deux. Pose-en un sur chaque étage de la même colonne ; ils se trouvent, sans lien et sans énergie. Saute pour monter au prochain ascenseur au-dessus, accroupis-toi pour descendre à celui d'en dessous, jusqu'à 48 blocs dans chaque sens. Un ascenseur qui a un plafond dessus est sauté.",
		"Comment : des lianes autour d'un Roseau d'esprit et une perle de l'Ender en font deux. Empile-les dans une colonne ; saute pour monter, accroupis-toi pour descendre."
	]
	quest.420000000022805B.title: "En montant la colonne"
	quest.420000000022805C.quest_desc: [
		"Roseau d'esprit sous une ficelle. Utilise-le sur une créature pour la prendre et sur un bloc pour la poser, saine et entière. Jamais un joueur, un boss ou une élite de la Marche. Le tissé fait deux usages — un trajet ; les urnes de cuivre, manifestées et résonnantes en portent davantage, et la résonnante ne s'use jamais. Il ne prend pas de créature lorsqu'il ne lui reste qu'un usage.",
		"Comment : Roseau d'esprit sous une ficelle. Utilise sur une créature pour la prendre, sur un bloc pour la poser. Deux usages."
	]
	quest.420000000022805C.title: "Ramène une créature chez toi"
	quest.420000000022805D.quest_desc: [
		"Du cuir sur des planches autour d'un bloc musical. Le Rite de la porte comme un jeu sans portail à la fin : chaque piste qu'il contient, jouée sur A, S, D, F quand les temps atteignent la ligne. Il garde ton meilleur score par piste et un classement des cinq meilleurs du serveur. Entraîne-toi ici avant un vrai Tambour de porte.",
		"Comment : cuir sur des planches autour d'un bloc musical. Utilise-le pour choisir une piste et jouer A, S, D, F."
	]
	quest.420000000022805D.title: "Tambour pour le plaisir"
	quest.420000000022805E.quest_desc: [
		"Quatre pierres lumineuses autour d'un Sceau d'Esprit, deux Lingots manifestés, une carotte dorée et du Tissage spirituel. Utilise-le pour le porter ; l'utilisation accroupie ouvre les trois emplacements de charmes. Le charme-lanterne porte la voix d'Esprit : vision nocturne, et toute bénédiction de voix sur toi dure moitié plus longtemps. Les charmes portés coûtent 2 de Pouls par voix toutes les deux secondes, pris sur une Cellule de Pouls que tu portes.",
		"Comment : quatre pierres lumineuses autour d'un Sceau d'Esprit, deux Lingots manifestés, une carotte dorée et du Tissage spirituel. Utilise-le pour le porter ; l'utilisation accroupie ouvre les emplacements."
	]
	quest.420000000022805E.title: "Une lumière à porter"
	quest.420000000022805F.quest_desc: [
		"Dès qu'une tribu te nomme Invité, fais un clic droit sur son Ancien et parle. Demande du travail et ils te remettent une requête — trois ouvertes par jour, une tenue par tribu, chacune paie de la réputation et chaque troisième une Marque de tribu. Demande leur récit et une route de sept pas commence : Ami, la chose qu'ils prisent, chasser près de leurs feux, un rite dans leur camp, leur plat cuisiné, et là où ils t'envoient. Le dernier pas est une épreuve contre un gardien. Finis un récit et tiens sa relique.",
		"Comment : fais un clic droit sur l'Ancien d'une tribu au rang Invité ou mieux, et demande leur récit ; sept pas finissent contre un gardien. Le progrès se déclenche à la première relique."
	]
	quest.420000000022805F.title: "Un récit conté"
	quest.4200000000228060.quest_desc: [
		"La relique des Gardiens de la plateforme. Leur récit s'achève contre l'Esprit de la ruée, à l'Anneau piétiné sur la Steppe ; gagne l'épreuve et l'Ancien te la remet. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ta réputation : tu ne piétines jamais un champ.",
		"Comment : finis le récit des Gardiens de la plateforme avec leur Ancien ; l'épreuve est l'Esprit de la ruée sur la Steppe."
	]
	quest.4200000000228060.title: "Braise gardée"
	quest.4200000000228061.quest_desc: [
		"La relique des Chanteurs de gravier. Leur récit s'achève au Serpent-prisme, à la Faille chantante dans les Champs de cristal ; gagne l'épreuve et l'Ancien te remet la relique. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ton estime : tu tires plus du minerai.",
		"Comment : finis le récit des Chanteurs de gravier avec leur Ancien ; l'épreuve est le Serpent-prisme dans les Champs de cristal."
	]
	quest.4200000000228061.title: "Pierre sonnante"
	quest.4200000000228062.quest_desc: [
		"La relique des Lie-racines. Leur récit s'achève à la Matriarche du marais, à la Racine noyée dans le Marais aux roseaux ; gagne l'épreuve et l'Ancien te remet la relique. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ton estime : les cultures se dépêchent autour de toi.",
		"Comment : finis le récit des Lie-racines avec leur Ancien ; l'épreuve est la Matriarche du marais dans le Marais aux roseaux."
	]
	quest.4200000000228062.title: "Première racine"
	quest.4200000000228063.quest_desc: [
		"La relique des Marche-lisières. Leur récit s'achève au Roc de la tempête, au Perchoir sur les Hautes Terres ; gagne l'épreuve et l'Ancien te remet la relique. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ton estime : tu ne tombes jamais tant que tu t'accroupis.",
		"Comment : finis le récit des Marche-lisières avec leur Ancien ; l'épreuve est le Roc de la tempête sur les Hautes Terres."
	]
	quest.4200000000228063.title: "Clou de pont"
	quest.4200000000228064.quest_desc: [
		"La relique des Cœurs-tambours. Leur récit s'achève au Titan de scories, au Trône de scories dans la Désolation des braises ; gagne l'épreuve et l'Ancien te remet la relique. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ton estime : tu frappes plus vite.",
		"Comment : finis le récit des Cœurs-tambours avec leur Ancien ; l'épreuve est le Titan de scories dans la Désolation des braises."
	]
	quest.4200000000228064.title: "Tambour stable"
	quest.4200000000228065.quest_desc: [
		"La relique des Tisserands de motifs. Leur récit s'achève au Batteur des marées, à la Pierre de la marée, dans les Bas-fonds ; gagne l'épreuve et l'Ancien te la remet. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ton estime : les stations d'Écho près de toi travaillent au double.",
		"Comment : finis l'histoire des Tisserands de motifs avec leur Ancien ; l'épreuve est le Batteur des marées dans les Bas-fonds."
	]
	quest.4200000000228065.title: "Engrenage silencieux"
	quest.4200000000228066.quest_desc: [
		"La relique des Gardiens de la colonie. Leur récit s'achève au Spectre du cairn, à l'Anneau du cairn, sur les Champs de neige ; gagne l'épreuve et l'Ancien te la remet. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ton estime : tu n'es jamais piqué.",
		"Comment : finis l'histoire des Gardiens de la colonie avec leur Ancien ; l'épreuve est le Spectre du cairn sur les Champs de neige."
	]
	quest.4200000000228066.title: "Sceau de la ruche"
	quest.4200000000228067.quest_desc: [
		"La relique des Graveurs de sceaux. Leur récit s'achève à la Sentinelle de la voûte, à la Porte scellée, sur la Crête du chatoiement ; gagne l'épreuve et l'Ancien te la remet. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ton estime : tes charmes demandent la moitié du Pouls.",
		"Comment : finis l'histoire des Graveurs de sceaux avec leur Ancien ; l'épreuve est la Sentinelle de la voûte sur la Crête du chatoiement."
	]
	quest.4200000000228067.title: "Sceau poli"
	quest.4200000000228068.quest_desc: [
		"La relique des Couseurs du métier. Leur récit s'achève au Non-chanté, au Tambour silencieux ; gagne l'épreuve et l'Ancien te la remet. Portée n'importe où dans ton inventaire, elle garde leur bienfait sur toi, quelle que soit ton estime : tu chantes moins cher.",
		"Comment : finis l'histoire des Couseurs du métier avec leur Ancien ; l'épreuve est le Non-chanté au Tambour silencieux."
	]
	quest.4200000000228068.title: "Neuvième Fil"
	quest.4200000000228069.quest_desc: [
		"Chaque histoire de tribu est finie : huit gardiens affrontés, et le Non-chanté. Avec les neuf reliques dans ton inventaire, le Neuvième Accord est à portée. `/tribalpower standing` montre l'estime de chaque tribu envers toi.",
		"Comment : finis les neuf récits. Le progrès se déclenche quand la neuvième relique est en main."
	]
	quest.4200000000228069.title: "Neuf reliques"
	quest.420000000022806A.quest_desc: [
		"Le Trône de scories dans la Désolation des braises : un anneau de pierre avec un Autel du gardien en son centre, sur de l'ardoise des abîmes polie, entre quatre bougies allumées, à ciel ouvert. Utilise l'autel accroupi, main vide, et il te dit ce qu'il veut — huit Écailles de magma — puis pose-les dessus et recule. Accroupis-toi pour tenir sous ses coups ; déchaîné, les anneaux s'embrasent et des Diablotins de braise surgissent des scories. À mi-vie, il se déchaîne et appelle les créatures de son pays, qui ne lâchent rien. Laisse-le une demi-minute et il se rendort ; l'autel se repose vingt minutes entre les appels. Il lâche le Noyau de scories, et sa chute met fin au récit des Cœurs-tambours.",
		"Comment : utilise accroupi, main vide, l'Autel du gardien du pays, pose dessus huit du réactif qu'il nomme, et gagne. Le progrès se déclenche quand tu l'abats."
	]
	quest.420000000022806A.title: "Titan de scories apaisé"
	quest.420000000022806B.quest_desc: [
		"La Racine noyée dans le Marais aux roseaux : un anneau de pierre avec un Autel du gardien en son centre, sur de l'ardoise des abîmes polie, entre quatre bougies allumées, à ciel ouvert. Utilise l'autel accroupi, main vide, et il te dit ce qu'il veut — huit Crocs de roseau — puis pose-les dessus et recule. Son piège t'attire et te ralentit ; reste sur du sol solide et abats les Rôdeurs des roseaux qu'elle appelle. À mi-vie, elle se déchaîne et appelle les créatures de son pays, qui ne lâchent rien. Laisse-la une demi-minute et elle se rendort ; l'autel se repose vingt minutes entre les appels. Elle lâche le Cœur du marais, et sa chute met fin au récit des Lie-racines.",
		"Comment : utilise accroupi, main vide, l'Autel du gardien du pays, pose dessus huit du réactif qu'il nomme, et gagne. Le progrès se déclenche quand tu l'abats."
	]
	quest.420000000022806B.title: "Matriarche du marais apaisée"
	quest.420000000022806C.quest_desc: [
		"L'Anneau du cairn sur les Champs de neige : un anneau de pierre avec un Autel du gardien en son centre, sur de l'ardoise des abîmes polie, entre quatre bougies allumées, à ciel ouvert. Utilise l'autel accroupi, main vide, et il te dit ce qu'il veut — huit Mandibules de givre — puis pose-les dessus et recule. Son souffle gèle tout devant lui. Passe derrière lui ; les Rampants du givre qu'il appelle sont lents. À mi-vie, il se déchaîne et appelle les créatures de son pays, qui ne lâchent rien. Laisse-le une demi-minute et il se rendort ; l'autel se repose vingt minutes entre les appels. Il lâche la Pierre du cairn, et sa chute met fin au récit des Gardiens de la colonie.",
		"Comment : utilise accroupi, main vide, l'Autel du gardien du pays, pose dessus huit du réactif qu'il nomme, et gagne. Le progrès se déclenche quand tu l'abats."
	]
	quest.420000000022806C.title: "Spectre du cairn apaisé"
	quest.420000000022806D.quest_desc: [
		"La Faille chantante dans les Champs de cristal : un anneau de pierre avec un Autel du gardien en son centre, sur de l'ardoise des abîmes polie, entre quatre bougies allumées, à ciel ouvert. Utilise l'autel accroupi, main vide, et il te dit ce qu'il veut — huit Carapaces de prisme — puis pose-les dessus et recule. Il tire des traits de lumière qui te marquent d'une lueur. Décale-toi, rapproche-toi, et guette le second trait qu'il ajoute une fois déchaîné. À mi-vie, il se déchaîne et appelle les créatures de son pays, qui ne lâchent rien. Laisse-le une demi-minute et il se rendort ; l'autel se repose vingt minutes entre les appels. Il lâche le Noyau de prisme, et sa chute met fin au récit des Chanteurs de gravier.",
		"Comment : utilise accroupi, main vide, l'Autel du gardien du pays, pose dessus huit du réactif qu'il nomme, et gagne. Le progrès se déclenche quand tu l'abats."
	]
	quest.420000000022806D.title: "Serpent-prisme apaisé"
	quest.420000000022806E.quest_desc: [
		"La Porte scellée sur la Crête du chatoiement : un anneau de pierre avec un Autel du gardien en son centre, sur de l'ardoise des abîmes polie, entre quatre bougies allumées, à ciel ouvert. Utilise l'autel accroupi, main vide, et il te dit ce qu'il veut — huit Sceaux sentinelles — puis pose-les dessus et recule. L'armure la plus lourde de la Marche et un balayage qui te jette hors de la crête. Déchaînée, elle se garde trois secondes à la fois : attends que ça passe. À mi-vie, elle se déchaîne et appelle les créatures de son pays, qui ne lâchent rien. Laisse-la une demi-minute et elle se rendort ; l'autel se repose vingt minutes entre les appels. Elle lâche le Sceau de la voûte, et sa chute met fin au récit des Graveurs de sceaux.",
		"Comment : utilise accroupi, main vide, l'Autel du gardien du pays, pose dessus huit du réactif qu'il nomme, et gagne. Le progrès se déclenche quand tu l'abats."
	]
	quest.420000000022806E.title: "Sentinelle de la voûte apaisée"
	quest.420000000022806F.quest_desc: [
		"La Pierre de la marée, dans les Bas-fonds : un anneau de pierre avec un Autel du gardien en son centre, sur de l'ardoise des abîmes polie, entre quatre bougies allumées, à ciel ouvert. Utilise l'autel accroupi, main vide, et il nomme ce qu'il veut — huit Crocs de saumure — puis pose-les dessus et recule. Chaque battement attire tout le monde vers lui et blesse. Combats-le depuis le rivage, le dos à quelque chose de solide. À mi-vie, il s'éveille et appelle les créatures de son pays, qui ne lâchent rien. Laisse-le une demi-minute et il se rendort ; l'autel se repose vingt minutes entre les appels. Il lâche la Coquille de marée, et sa chute achève le récit des Tisserands de motifs.",
		"Comment : utilise accroupi, main vide, l'Autel du gardien du pays, pose dessus huit du réactif qu'il nomme, et gagne. Le progrès se déclenche quand tu l'abats."
	]
	quest.420000000022806F.title: "Batteur des marées apaisé"
	quest.4200000000228070.quest_desc: [
		"L'Anneau piétiné sur la Steppe : un anneau de pierre avec un Autel du gardien en son centre, sur de l'ardoise des abîmes polie, entre quatre bougies allumées, à ciel ouvert. Utilise l'autel accroupi, main vide, et il nomme ce qu'il veut — huit Tendons de jarret — puis pose-les dessus et recule. Il charge. Esquive de côté et frappe-le au passage ; quand les Grinceurs de terrier sortent, tiens-toi sur un bloc. À mi-vie, il s'éveille et appelle les créatures de son pays, qui ne lâchent rien. Laisse-le une demi-minute et il se rendort ; l'autel se repose vingt minutes entre les appels. Il lâche la Corne du troupeau, et sa chute achève le récit des Gardiens de la plateforme.",
		"Comment : utilise accroupi, main vide, l'Autel du gardien du pays, pose dessus huit du réactif qu'il nomme, et gagne. Le progrès se déclenche quand tu l'abats."
	]
	quest.4200000000228070.title: "Esprit de la ruée apaisé"
	quest.4200000000228071.quest_desc: [
		"Le Perchoir sur les Hautes Terres : un anneau de pierre avec un Autel du gardien en son centre, sur de l'ardoise des abîmes polie, entre quatre bougies allumées, à ciel ouvert. Utilise l'autel accroupi, main vide, et il nomme ce qu'il veut — huit Ailes de tempête — puis pose-les dessus et recule. Il pique et te jette en l'air ; éveillé, la foudre suit chaque piqué. Un arc et un toit aident plus qu'un bouclier. À mi-vie, il s'éveille et appelle les créatures de son pays, qui ne lâchent rien. Laisse-le une demi-minute et il se rendort ; l'autel se repose vingt minutes entre les appels. Il lâche la Plume de tempête, et sa chute achève le récit des Marche-lisières.",
		"Comment : utilise accroupi, main vide, l'Autel du gardien du pays, pose dessus huit du réactif qu'il nomme, et gagne. Le progrès se déclenche quand tu l'abats."
	]
	quest.4200000000228071.title: "Roc de la tempête apaisé"
	quest.4200000000228072.quest_desc: [
		"Les huit noyaux de gardien et un Cœur du Non-chanté, sans forme. Un noyau avec un Fil du métier ferait à la place six Noyaux résonnants ; prends donc un second lot de butin si tu veux les deux. La barre de boss de chaque gardien porte la couleur de sa tribu.",
		"Comment : les huit noyaux de gardien et un Cœur du Non-chanté, sans forme. Lance-la dans un cercle du Métier avec les neuf reliques sur toi."
	]
	quest.4200000000228072.title: "La tablette des neuf"
	quest.4200000000228073.quest_desc: [
		"Trace un cercle du Métier — un Sceau du métier assis dans le brasero, à l'intérieur de son Cercle de rite — et lance la tablette avec les neuf reliques sur toi ; le rite puise son Pouls avant de prendre. Neuf lumières s'élèvent, une de la couleur de chaque tribu. Dès lors, chaque tribu te traite au moins comme Parent, les neuf faveurs se posent sur toi un moment, et l'aurore brûle pleine chaque nuit où tu te tiens sous elle. Une fois par joueur ; un second lancer n'allume que le cercle.",
		"Comment : Sceau du métier dans un brasero, à l'intérieur de son Cercle de rite, neuf reliques dans ton inventaire ; utilise accroupi la tablette sur le brasero."
	]
	quest.4200000000228073.title: "Le Métier est d'accord"
	quest.4200000000228074.quest_desc: [
		"Seize fragments de l'histoire du Métier à tisser sont gravés dans la Marche : huit Pierres gravées dans les murs de ses ruines, huit Murales de deux sur deux sur les terres des gardiens. Fais un clic droit sur l'un pour le lire ; le Codex des Esprits le garde, et sa section Chronique le met en ordre. Lis les seize et l'histoire est entière.",
		"Comment : clic droit sur les huit Pierres gravées des ruines de la Marche et sur les huit Murales des terres des gardiens."
	]
	quest.4200000000228074.title: "La chronique entière"
	quest.4200000000228075.quest_desc: [
		"Sertie dans les murs des ruines de la Marche — les vieux ouvrages, le sanctuaire englouti, les tertres, les tombes, les voûtes. Lis-la où tu la trouves, puis ramasse-la et pose-la sur un mur à toi ; ce que tu lis reste lu.",
		"Comment : sertie dans les murs des ruines de la Marche. Lis-la, puis casse-la et pose-la sur ton propre mur."
	]
	quest.4200000000228075.title: "Une pierre qui se souvient"
	quest.4200000000228076.quest_desc: [
		"Deux blocs de large et deux de haut sur la terre de chaque gardien ; chacune peint le pays où elle se tient. En lire une part, c'est la lire en entier. Posée d'un seul tenant, elle redescend d'un seul ; une murale coupée en créatif change de chapitre d'un clic accroupi.",
		"Comment : elle se tient deux sur deux sur la terre de chaque gardien. Lis-la, puis retire-la entière et pose-la chez toi."
	]
	quest.4200000000228076.title: "Un mur qui peint son pays"
	quest.4200000000228077.quest_desc: [
		"La Marche agit d'elle-même. Chute de cendre, une Tempête de lueur, un Blanc total et Brume des roseaux referment un pays et lèvent les esprits de jour ; chacun nourrit les générateurs d'une voix et gêne ceux d'une autre. De temps en temps, les fils de ley d'une voix montent en poussée : les collecteurs qui les portent rendent le double, mais tiens-toi sur un croisement nu sans collecteur, et le Mal de ley fait tanguer le sol et vide ta Pulsation. Chaque tribu garde un jour de fête à tour de rôle — joins-toi au festin pour un cadeau. Une lumière chaude qui dérive près de toi est un esprit errant ; atteins-la pour une ligne de l'histoire de son pays et un petit cadeau. Tempêtes et poussées sont annoncées deux minutes à l'avance, dans le chat et au-dessus de la barre rapide. Coche ceci quand tu en as essuyé un.",
		"Comment : sois dans la Marche pendant un temps, une poussée ou un jour de fête ; coche quand tu l'as fait."
	]
	quest.4200000000228077.title: "La Marche respire"
	quest.420000000023058C.quest_desc: [
		"Les Chanteurs de gravier ne taillent jamais une pierre deux fois de la même façon. Cet établi se souvient de chaque coupe.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : pierre + pièces de la table dans JEI. Insère un bloc et choisis une variante."
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"Le même tour pour le bois — cent planches à partir d'une.",
		"Comment : table de charpentier Chipped dans JEI. La même idée que la table de maçon, pour le bois."
	]
	quest.420000000023058D.title: "Table de charpentier"
	quest.420000000023058E.quest_desc: [
		"Du sable en verre, puis le verre en chaque forme que la lumière voudra.",
		"Comment : établi Chipped dans JEI (maçon, charpentier, souffleur de verre…). Mets le bloc dans la table et choisis une coupe."
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"Laine et tissu, retissés — ça tombe bien, pour une plateforme qui raccommode un Métier à tisser.",
		"Comment : établi Chipped dans JEI (maçon, charpentier, souffleur de verre…). Mets le bloc dans la table et choisis une coupe."
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"Feuilles, jeunes arbres et choses qui poussent, rangés dans leurs variations.",
		"Comment : établi Chipped dans JEI (maçon, charpentier, souffleur de verre…). Mets le bloc dans la table et choisis une coupe."
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"Des blocs colorés et de la pierre plus étrange. Choisis une variante ; l'établi garde le reste.",
		"Comment : établi Chipped dans JEI (maçon, charpentier, souffleur de verre…). Mets le bloc dans la table et choisis une coupe."
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"Métal et blocs à face de machine, coupés à ton goût.",
		"Comment : établi Chipped dans JEI (maçon, charpentier, souffleur de verre…). Mets le bloc dans la table et choisis une coupe."
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"Donne un bloc à la Table de maçon et choisis dans le mur de variantes.",
		"Comment : quatre pierres en carré, ou le tailleur de pierre."
	]
	quest.4200000000230593.title: "Une coupe de pierre"
	quest.4200000000230594.quest_desc: [
		"La Table de charpentier fait de même pour le bois.",
		"Comment : une bûche dans la grille de fabrication en fait quatre."
	]
	quest.4200000000230594.title: "Une coupe de planches"
	quest.4200000000230595.quest_desc: [
		"Chaque vitre que connaît le Souffleur de verre commence ici.",
		"Comment : fais fondre du sable. Martèle la roche en gravier, le gravier en sable, puis au fourneau."
	]
	quest.4200000000230595.title: "Une coupe de verre"
	quest.4200000000230596.quest_desc: [
		"La pierre préférée des Chanteurs de gravier, celle dont ils disputent.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000230596.title: "Variété d'ardoise des abîmes"
	quest.4200000000230597.quest_desc: [
		"Argile cuite, de cent façons.",
		"Comment : quatre objets brique. Les boules d'argile fondent en briques."
	]
	quest.4200000000230597.title: "Variété de briques"
	quest.4200000000230598.quest_desc: [
		"Gravier de la plateforme, taillé fin.",
		"Comment : fabrique, fais fondre, tamise, ou prends-le sur un monstre. JEI liste chaque source sur la plateforme."
	]
	quest.4200000000230598.title: "Variété de grès"
	quest.4200000000240599.quest_desc: [
		"La première chose qui fait d'une plateforme un endroit où quelqu'un vit.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : planches de chêne dans JEI. Première pièce Handcrafted."
	]
	quest.4200000000240599.title: "Une chaise"
	quest.420000000024059A.quest_desc: [
		"Un endroit où poser le Codex pendant que tu réfléchis.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.420000000024059A.title: "Une table"
	quest.420000000024059B.quest_desc: [
		"De la place pour qu'un Clowder s'assoie pendant que le tonneau travaille.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.420000000024059B.title: "Un banc"
	quest.420000000024059C.quest_desc: [
		"Pour les Pages du codex que tu te promets toujours de relire.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.420000000024059C.title: "Une étagère"
	quest.420000000024059D.quest_desc: [
		"Un rangement Handcrafted qui a l'air à sa place.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.420000000024059D.title: "Un placard"
	quest.420000000024059E.quest_desc: [
		"Les Gardiens de la plateforme dormaient bien. Toi aussi, tu devrais.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.420000000024059E.title: "Un lit élégant"
	quest.420000000024059F.quest_desc: [
		"Une lanterne, une page, une place pour les deux.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.420000000024059F.title: "Une table de chevet"
	quest.42000000002405A0.quest_desc: [
		"Coupe un cadre, puis habille-le de n'importe quel bloc. Une forme, toutes les peaux.",
		"Comment : un lingot de fer au-dessus de trois cubes encadrés. Coupe les blocs encadrés."
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"Un cube vierge, qui attend un bloc de camouflage.",
		"Comment : Scie à cadres, puis cube/dalle/escaliers encadrés. Le camouflage, c'est un clic droit avec un bloc."
	]
	quest.42000000002405A1.title: "Framed Cube"
	quest.42000000002405A2.quest_desc: [
		"Un demi-cadre ; deux fois plus d'options.",
		"Comment : Scie à cadres, puis cube/dalle/escaliers encadrés. Le camouflage, c'est un clic droit avec un bloc."
	]
	quest.42000000002405A2.title: "Framed Slab"
	quest.42000000002405A3.quest_desc: [
		"Des marches qui s'habillent du mur où elles se posent.",
		"Comment : Scie à cadres, puis cube/dalle/escaliers encadrés. Le camouflage, c'est un clic droit avec un bloc."
	]
	quest.42000000002405A3.title: "Framed Stairs"
	quest.42000000002405A4.quest_desc: [
		"Pour les toits et les lignes de toit que le vide ne t'a jamais donnés.",
		"Comment : Scie à cadres, puis cube/dalle/escaliers encadrés. Le camouflage, c'est un clic droit avec un bloc."
	]
	quest.42000000002405A4.title: "Framed Slope"
	quest.42000000002405A5.quest_desc: [
		"Les Marche-lisières ont enjambé le vide avec moins. Atteins la prochaine plateforme avec style.",
		"Comment : ponts Macaw à partir de la pierre/bois correspondant, dans JEI."
	]
	quest.42000000002405A5.title: "Pont de corde"
	quest.42000000002405A6.quest_desc: [
		"Un toit au-dessus de la plateforme. La pluie, là-haut, n'est jamais qu'ambition.",
		"Comment : toits Macaw à partir du bois correspondant, dans JEI."
	]
	quest.42000000002405A6.title: "Toit de grenier"
	quest.42000000002405A7.quest_desc: [
		"Le confort, c'est de l'infrastructure aussi.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.42000000002405A7.title: "Canapé"
	quest.42000000002405A8.quest_desc: [
		"Un bord de cuisine pour la gamme Farmer's Delight.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.42000000002405A8.title: "Comptoir"
	quest.42000000002405A9.quest_desc: [
		"Là où le Codex des Moustaches prend ses marges.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.42000000002405A9.title: "Bureau"
	quest.42000000002405AA.quest_desc: [
		"Un petit rangement assorti à la table.",
		"Comment : meubles Handcrafted en planches dans JEI. La première chaise est en chêne."
	]
	quest.42000000002405AA.title: "Tiroir"
	quest.42000000002405AB.quest_desc: [
		"Un seuil qui se cache dans le mur.",
		"Comment : Scie à cadres, puis cube/dalle/escaliers encadrés. Le camouflage, c'est un clic droit avec un bloc."
	]
	quest.42000000002405AB.title: "Framed Door"
	quest.42000000002405AC.quest_desc: [
		"Couverture fine ; déguisement complet.",
		"Comment : Scie à cadres, puis cube/dalle/escaliers encadrés. Le camouflage, c'est un clic droit avec un bloc."
	]
	quest.42000000002405AC.title: "Framed Panel"
	quest.42000000002405AD.quest_desc: [
		"Une rambarde de bord à habiller selon ton goût.",
		"Comment : Scie à cadres, puis cube/dalle/escaliers encadrés. Le camouflage, c'est un clic droit avec un bloc."
	]
	quest.42000000002405AD.title: "Framed Fence"
	quest.42000000002405AE.quest_desc: [
		"Gris et franc, comme le gravier dont il est sorti.",
		"Comment : ponts Macaw à partir de la pierre/bois correspondant, dans JEI."
	]
	quest.42000000002405AE.title: "Pont d'andésite"
	quest.42000000002505AF.quest_desc: [
		"Une lumière murale, pas une torche plantée par honte. Les intendants avaient des exigences.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : torche + pépites de fer. Première fabrication des intendances."
	]
	quest.42000000002505AF.title: "Applique"
	quest.42000000002505B0.quest_desc: [
		"Du sable qui tombe. La seule horloge honnête avant le Brin d'Horloge.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B0.title: "Sablier"
	quest.42000000002505B1.quest_desc: [
		"Fais goutter un fluide hors d'un bloc. Petit ; étrangement satisfaisant.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B1.title: "Robinet"
	quest.42000000002505B2.quest_desc: [
		"Tourne-la à la main. Les Cœurs-tambours ont commencé quelque part, eux aussi.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B2.title: "Manivelle"
	quest.42000000002505B3.quest_desc: [
		"Montre un objet. Un jeton, une page, un trophée.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B3.title: "Étagère"
	quest.42000000002505B4.quest_desc: [
		"Un sac qui tient des sacs. Le fouillis de Récupération, rangé.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B4.title: "Sac"
	quest.42000000002505B5.quest_desc: [
		"Enferme le Fil effiloché, loin de tes pires idées.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B5.title: "Coffre-fort"
	quest.42000000002505B6.quest_desc: [
		"Épingle une page là où tout le Clowder la lit.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B6.title: "Tableau d'affichage"
	quest.42000000002505B7.quest_desc: [
		"Un pot avec des ambitions. Fais pousser un peu là où la plateforme est mince.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B7.title: "Jardinière"
	quest.42000000002505B8.quest_desc: [
		"Élève le Fragment du métier de Fuseau là où on peut l'admirer.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B8.title: "Piédestal"
	quest.42000000002505B9.quest_desc: [
		"Range des cookies, des abeilles, ou la petite dignité de l'ordre.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505B9.title: "Bocal (37)"
	quest.42000000002505BA.quest_desc: [
		"Pose une apparition sans hisser un lit entier à l'échelle.",
		"Comment : laine dans JEI. Sac de couchage blanc ; il existe des variantes teintes. Pose l'apparition sans un lit complet."
	]
	quest.42000000002505BA.title: "Sac de couchage"
	quest.42000000002505BB.quest_desc: [
		"Dors pendant le jour, pour que les créatures rencontrent un Skybound reposé.",
		"Comment : laine + ficelle dans JEI. Accroche-le à la Corde et au Clou."
	]
	quest.42000000002505BB.title: "Hamac"
	quest.42000000002505BC.quest_desc: [
		"Accroche le hamac entre deux poteaux, au-dessus du précipice, et ose.",
		"Comment : de la ficelle et un lingot de fer. Places-en deux, puis accroche le hamac."
	]
	quest.42000000002505BC.title: "Corde et clou"
	quest.42000000002505BD.quest_desc: [
		"Une flamme plus stable pour les longues nuits de la plateforme.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505BD.title: "Bougeoir"
	quest.42000000002505BE.quest_desc: [
		"Grimpe, suspends-toi ou jette un pont. Les Marche-lisières ne juraient que par elle.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505BE.title: "Corde (37)"
	quest.42000000002505BF.quest_desc: [
		"Monte et descends la corde au gré de la redstone.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505BF.title: "Poulie"
	quest.42000000002505C0.quest_desc: [
		"Tombe dessus, et le vide oublie de te punir.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505C0.title: "Bloc de plume"
	quest.42000000002505C1.quest_desc: [
		"Trace à la craie un plan sur lequel tout le Clowder pourra se disputer.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505C1.title: "Tableau noir"
	quest.42000000002505C2.quest_desc: [
		"Porte une petite chose qui préférerait que tu ne le fasses pas.",
		"Comment : fabrication Supplementaries dans JEI (applique, sac, coffre-fort, corde…). Les intendances nomment la station."
	]
	quest.42000000002505C2.title: "Cage"
	quest.42000000002605C3.quest_desc: [
		"Le premier fil. La pulsation que les Cœurs-tambours gardaient a enfin où aller.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : lamine des plaques de cuivre dans un laminoir. Le chapitre en cours commence ici."
	]
	quest.42000000002605C3.title: "Fil en cuivre"
	quest.42000000002605C4.quest_desc: [
		"Rotation d'un côté, énergie de Forge de l'autre. Deux Brins se serrent la main.",
		"Comment : Create Crafts & Additions — fil de cuivre du laminoir, puis connecteurs et moteur."
	]
	quest.42000000002605C4.title: "Connecteur"
	quest.42000000002605C5.quest_desc: [
		"L'énergie redevient rotation. Le Brin Horloge tourne maintenant sur le Brin Étincelle.",
		"Comment : Create Crafts & Additions — fil de cuivre du laminoir, puis connecteurs et moteur."
	]
	quest.42000000002605C5.title: "Moteur électrique"
	quest.42000000002605C6.quest_desc: [
		"Retiens une charge entre le fil et l'ouvrage.",
		"Comment : Create Crafts & Additions — fil de cuivre du laminoir, puis connecteurs et moteur."
	]
	quest.42000000002605C6.title: "Condensateur"
	quest.42000000002605C7.quest_desc: [
		"Un mur de courant stocké, aussi grand que la plateforme le permet.",
		"Comment : Create Crafts & Additions — fil de cuivre du laminoir, puis connecteurs et moteur."
	]
	quest.42000000002605C7.title: "Accumulateur modulaire"
	quest.42000000002605C8.quest_desc: [
		"Tiges et fil à partir de lingots — la réponse de Create à la presse.",
		"Comment : Create Crafts & Additions — fil de cuivre du laminoir, puis connecteurs et moteur."
	]
	quest.42000000002605C8.title: "Laminoir"
	quest.42000000002605C9.quest_desc: [
		"Enchante sans la superstition de la table. Nourris-le d'expérience, obtiens une intention.",
		"Comment : Create Enchantment Industry après un brûleur de Blaze. JEI nomme l'imprimante et le seau d'expérience."
	]
	quest.42000000002605C9.title: "Blaze Enchanteur"
	quest.42000000002605CA.quest_desc: [
		"Pratique liquide, emportée. Les intendants y auraient vu du vulgaire et de l'utile.",
		"Comment : Create Enchantment Industry après un brûleur de Blaze. JEI nomme l'imprimante et le seau d'expérience."
	]
	quest.42000000002605CA.title: "Seau d'expérience"
	quest.42000000002605CB.quest_desc: [
		"Copie un livre, un plan, une page. Le Codex des Moustaches approuve, tout bas.",
		"Comment : Create Enchantment Industry après un brûleur de Blaze. JEI nomme l'imprimante et le seau d'expérience."
	]
	quest.42000000002605CB.title: "Imprimante"
	quest.42000000002605CC.quest_desc: [
		"Lave et chaleur en énergie. Un pont, pas le Bourdon lui-même.",
		"Comment : osmium + fourneau + cuivre. Le premier générateur Mekanism."
	]
	quest.42000000002605CC.title: "Générateur thermique"
	quest.42000000002605CD.quest_desc: [
		"Sur une plateforme qui n'est que ciel, le soleil est la seule ressource que personne ne rationne.",
		"Comment : générateurs Mekanism, après la ligne Ateliers Mekanism. Le générateur de chaleur est la première fabrication."
	]
	quest.42000000002605CD.title: "Panneau solaire"
	quest.42000000002605CE.quest_desc: [
		"Plus la plateforme est haute, plus il tourne fort. Construis en hauteur.",
		"Comment : générateurs Mekanism, après la ligne Ateliers Mekanism. Le générateur de chaleur est la première fabrication."
	]
	quest.42000000002605CE.title: "Éolienne"
	quest.42000000002605CF.quest_desc: [
		"Brûle le surplus du Brin Pousse. Sur une plateforme, rien n'est un déchet.",
		"Comment : générateurs Mekanism, après la ligne Ateliers Mekanism. Le générateur de chaleur est la première fabrication."
	]
	quest.42000000002605CF.title: "Bio-Générateur"
	quest.42000000002605D0.quest_desc: [
		"Puissance tardive pour un Clowder qui est allé loin dans Mekanism.",
		"Comment : générateurs Mekanism, après la ligne Ateliers Mekanism. Le générateur de chaleur est la première fabrication."
	]
	quest.42000000002605D0.title: "Générateur à combustion de gaz"
	quest.42000000002605D1.quest_desc: [
		"Le métier numérique, dans ta poche. Retisse depuis n'importe où sur la plateforme.",
		"Comment : Terminal sans fil après un réseau AE2 et un kit sans fil chargé. JEI nomme la fabrication."
	]
	quest.42000000002605D1.title: "Terminal sans fil (38)"
	quest.42000000002605D2.quest_desc: [
		"Les produits chimiques de Mekanism, stockés dans le réseau AE2. Deux piliers tardifs, tressés.",
		"Comment : cellules chimiques d'Applied Mekanistics après le boîtier AE2 + produits chimiques de Mekanism."
	]
	quest.42000000002605D2.title: "Cellule chimique"
	quest.42000000002605D3.quest_desc: [
		"Pour quand le fil de cuivre ne peut pas porter toute la pulsation.",
		"Comment : Create Crafts & Additions — fil de cuivre du laminoir, puis connecteurs et moteur."
	]
	quest.42000000002605D3.title: "Grand connecteur"
	quest.42000000002605D4.quest_desc: [
		"Un gâteau qui te fait monter de niveau. Ne le dis pas à la ligne de cuisine.",
		"Comment : Create Enchantment Industry après un brûleur de Blaze. JEI nomme l'imprimante et le seau d'expérience."
	]
	quest.42000000002605D4.title: "Gâteau d'expérience"
	quest.42000000002605D5.quest_desc: [
		"Une bouchée plus grosse du même ciel gratuit.",
		"Comment : générateurs Mekanism, après la ligne Ateliers Mekanism. Le générateur de chaleur est la première fabrication."
	]
	quest.42000000002605D5.title: "Solaire avancé"
	quest.42000000002605D6.quest_desc: [
		"La coque dont chaque cellule chimique a besoin.",
		"Comment : cellules chimiques d'Applied Mekanistics après le boîtier AE2 + produits chimiques de Mekanism."
	]
	quest.42000000002605D6.title: "Boîtier chimique"
	quest.42000000002605D7.quest_desc: [
		"Emporte une mesure de gaz hors du réseau.",
		"Comment : cellules chimiques d'Applied Mekanistics après le boîtier AE2 + produits chimiques de Mekanism."
	]
	quest.42000000002605D7.title: "Cellule chimique portable"
	quest.42000000002705D8.quest_desc: [
		"Chaque Brin a un gardien que la Coupe a rompu : une construction du Métier devenue sauvage. Tu n'assassines pas un monstre ; tu rends sa tension au Brin en le battant. Fabrique son Totem effiloché une fois le Brin assis, utilise-le n'importe où hors d'une arène, et toi et chaque compagnon de Clowder dans un rayon de 32 blocs êtes tirés sur sa scène. Gagne, et chacun de vous ramène chez soi la Relique tissée de ce gardien. Perds, et vous êtes recrachés, le totem consumé.",
		"Les reliques agissent depuis l'emplacement de relique Curios, la main secondaire ou la barre rapide : un passif tant qu'elles sont portées, et un pouvoir au clic droit avec un délai. `/guardians leave` abandonne un combat ; `/guardians status` montre le palmarès du Clowder.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : coche. Fabrique chaque Totem effiloché une fois ce Brin assis ; utilise-le hors d'une arène."
	]
	quest.42000000002705D8.title: "Réponse pour la Coupe"
	quest.42000000002705D9.quest_desc: [
		"La Coupe du terrier : une coupe enfoncée de quatre gradins de terre descendant vers une fosse de boue, sous six arches de racines de chêne noir, avec sept coutures de racines bleu-vert qui luisent sur le sol de la fosse.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705D9.title: "Totem : Le Gîte"
	quest.42000000002705DA.quest_desc: [
		"À chaque quart de sa vie, Le Gîte frappe et noie la fosse sous une couche de terre, invulnérable dedans. L'une des sept coutures s'allume : creuse un canal jusqu'à elle, mets le noyau à nu et frappe-le pour briser l'ensevelissement. La première porte, et une clémente.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705DA.title: "Rendre la tension : Le Gîte"
	quest.42000000002705DB.quest_desc: [
		"Cœur-racine : le recul subi baisse de soixante pour cent et rien ne peut t'attirer. Prise de racine te plante cinq secondes, à l'abri de huit cœurs d'Absorption.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705DB.title: "Relique : Cœur-racine"
	quest.42000000002705DC.quest_desc: [
		"La Fosse-meule : une carrière d'ardoise des abîmes, avec un anneau de meule tournant dans le sol et quatre goulottes de tamis en pierre qui versent du gravier dans la fosse centrale de gravier.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705DC.title: "Totem : La Mâchoire"
	quest.42000000002705DD.quest_desc: [
		"La Mâchoire est immunisée tant que sa gueule est fermée. Chaque goulotte lâche un bloc de gravier toutes les quinze secondes ; portes-en un sur l'anneau et laisse-le filer dans la bouche de la fosse pour coincer la gueule ouverte pendant douze secondes. L'anneau s'inverse à chaque phase et pousse l'imprudent dans la fosse.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705DD.title: "Rendre la tension : La Mâchoire"
	quest.42000000002705DE.quest_desc: [
		"Noyau-meule : immunisé à Fatigue, et tes tamis en main ont un jet de Fortune en plus. Déchiquète retire deux d'armure à la prochaine chose que tu frappes.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705DE.title: "Relique : Noyau-meule"
	quest.42000000002705DF.quest_desc: [
		"La Terrasse de la surcroissance : quatre terrasses de jardin sous une canopée de feuilles, huit poteaux de treillage et quatre postes de taille au deuxième étage.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705DF.title: "Totem : La Mère-épine"
	quest.42000000002705E0.quest_desc: [
		"La Mère-épine ne frappe jamais ; elle sème une haie d'épines qui s'étend et brûle au toucher, et elle se soigne dès qu'un poste de taille est envahi. Cisailles et haches la dégagent. Composte huit de haie à un poste pour lancer une vague de taille qui dégage le sol et l'étourdit — la seule fenêtre de dégâts nette.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705E0.title: "Rendre la tension : La Mère-épine"
	quest.42000000002705E1.quest_desc: [
		"Graine-épine : Épines, et aucun dégât de baies ni de cactus. Floraison lève un anneau de haie et donne Régénération II à toi et à ton Clowder dedans.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705E1.title: "Relique : Graine-épine"
	quest.42000000002705E2.quest_desc: [
		"Les Éclats du ciel : dix éclats d'ardoise des abîmes flottant au-dessus du vide, des ponts qui s'effritent entre eux, des marques de griffe dorées sur l'éclat principal, là où le boss atterrit.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705E2.title: "Totem : Le Marche-lisière"
	quest.42000000002705E3.quest_desc: [
		"Un duel pur. Le Marche-lisière bondit d'éclat en éclat et fond sur quiconque se tient le plus loin d'un mur ; une marque de griffe dorée montre où, un souffle avant qu'il atterrisse — écarte-toi. Les ponts s'effritent derrière toi et reviennent plus tard. Tomber coûte six cœurs et un retour à ta plateforme.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705E3.title: "Rendre la tension : Le Marche-lisière"
	quest.42000000002705E4.quest_desc: [
		"Pas-lisière : aucun dégât de chute pour moins de douze blocs et aucune glissade hors des bords. Pas-lisière fonce de six blocs, deux fois, avec un coup plus fort à la fin.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705E4.title: "Relique : Pas-lisière"
	quest.42000000002705E5.quest_desc: [
		"Le Tambour de forge : un plateau-tambour en laiton au-dessus d'un cratère de lave, huit marteaux-pistons en cuivre avec des plaques de battue devant eux, quatre canaux de lave à travers le sol.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705E5.title: "Totem : Le Cœur-tambour"
	quest.42000000002705E6.quest_desc: [
		"Le Cœur-tambour ne peut être blessé qu'un instant après chaque quatrième temps. Mets-toi sur une dalle de mesure au temps fort pour charger une étincelle qui compte triple ; au quatrième temps, les canaux de lave montent, alors reste sur les dalles, pas dans les canaux. Le tempo monte à chaque phase.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705E6.title: "Rendre la tension : Le Cœur-tambour"
	quest.42000000002705E7.quest_desc: [
		"Pulsation de tambour : chaque quatrième coup porte deux cœurs de plus. Le temps fort étourdit et repousse tout dans un rayon de sept blocs.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705E7.title: "Relique : Pulsation de tambour"
	quest.42000000002705E8.quest_desc: [
		"L'Échappement : quatre anneaux de cuivre tournants portant des tuiles de séquence en chêne noir autour d'un moyeu de fer, six tours d'engrenages et un pendule de seize blocs qui garde le temps.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705E8.title: "Totem : L'Horloger"
	quest.42000000002705E9.quest_desc: [
		"À chaque phase, L'Horloger remonte : les tuiles s'allument en séquence sur les anneaux tournants et tu as douze secondes pour les fouler dans l'ordre. La réussite ouvre son châssis pendant huit secondes ; l'échec fait tirer chaque tour d'engrenages. Le pendule est le métronome ; les anneaux s'inversent quand il s'écarte loin.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705E9.title: "Rendre la tension : L'Horloger"
	quest.42000000002705EA.quest_desc: [
		"Boucle d'engrenage : Célérité I, et les outils s'usent un cinquième plus lentement. Rembobine remet à zéro chaque autre relique que tu portes et te ramène d'un coup là où tu étais il y a trois secondes.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705EA.title: "Relique : Boucle d'engrenage"
	quest.42000000002705EB.quest_desc: [
		"Le Rayon : une arène de cire hexagonale, aux alvéoles qui montent et descendent, des flaques de miel, et six alvéoles de faux-bourdon dans le mur.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705EB.title: "Totem : L'Esprit-ruche"
	quest.42000000002705EC.quest_desc: [
		"L'Esprit-ruche est fragile, mais à chaque vague ses six alvéoles déversent des faux-bourdons. Un feu de camp posé sur une alvéole de faux-bourdon la scelle pendant trente secondes ; scelle les six et la chambre royale s'ouvre pendant dix secondes. Tes propres Productive Bees attaquent les faux-bourdons à vue.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705EC.title: "Retendre : L'Esprit-ruche"
	quest.42000000002705ED.quest_desc: [
		"Appel de ruche : les abeilles ne se retournent jamais contre toi, et les ruches dans les seize blocs travaillent un dixième plus vite. Appelle l'Essaim : envoie quatre abeilles-reliques après ce que tu frappes.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705ED.title: "Relique : Appel de ruche"
	quest.42000000002705EE.quest_desc: [
		"Le Cercle de garde : un sanctuaire de pierre aux cercles d'or et neuf piliers de glyphes aux flèches d'améthyste, une estrade à neuf côtés de chevilles d'or au centre.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705EE.title: "Totem : Le Brise-sceaux"
	quest.42000000002705EF.quest_desc: [
		"Le Brise-sceaux se cache derrière trois gardes actives. Les chevilles de l'estrade allument l'ordre une fois par phase — regarde d'abord. Dissipe les piliers dans cet ordre avec une dissipation d'Ars ou n'importe quel objet du Brin Sceau ; un mauvais réarme les trois et le verre de garde mord. Trois justes, et il est ouvert pendant douze secondes. Les phases suivantes mélangent les runes et ajoutent un leurre.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705EF.title: "Retendre : Le Brise-sceaux"
	quest.42000000002705F0.quest_desc: [
		"Marque de sceau : les dégâts magiques subis baissent d'un cinquième. Marque de sceau te protège, ou un compagnon de Clowder que tu regardes, contre un coup lourd.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705F0.title: "Relique : Marque de sceau"
	quest.42000000002705F1.quest_desc: [
		"Le Métier qui s'effondre : un métier à tisser large de soixante-six blocs, dont le sol est la chaîne — des bandes de planches qui se défont en ponts de fil quand les barres de lisses tombent.",
		"Quatre Fil effiloché et quatre du bloc du Brin autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705F1.title: "Totem : Le Détissé"
	quest.42000000002705F2.quest_desc: [
		"Cinq phases. Chacune cite deux des huit autres mécaniques pendant trente secondes, puis une barre de lisses tombe et trois bandes de plus se défont. Dans sa vraie forme, les quatre dernières bandes restent, et les fils de chaîne sont le seul chemin jusqu'à la poutre où il se tient. Tue-le là : le Retissage.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705F2.title: "Retendre : Le Détissé"
	quest.42000000002705F3.quest_desc: [
		"Fil du métier : deux de tension du Métier en plus pour ton Clowder, et une usure plus lente. Le Fil du métier attache ton Clowder à ton côté. C'est la clé de voûte du vrai Retissage et la clé des deux arènes scellées.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705F3.title: "Relique : Fil du métier"
	quest.42000000002705F4.quest_desc: [
		"La Poubelle du Quai : un coin du Quai lui-même — une cour de planches, une corde à linge de draps, des paniers de laine, un tapis rouge.",
		"Quatre Fils effilochés et quatre laines autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705F4.title: "Totem : Le golem de peluche"
	quest.42000000002705F5.quest_desc: [
		"Le seul combat sans risque. Le golem jette des boules de peluche qui n'aveuglent qu'un instant et se cache derrière le linge ; bats le tapis, il éternue et titube. Il enseigne le totem, l'arène et le portail.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705F5.title: "Retendre : Le golem de peluche"
	quest.42000000002705F6.quest_desc: [
		"Mèche de peluche : immunisé aux dégâts de cactus, de baies et de haies, et à être poussé. Bouffée aveugle les créatures proches, le temps de fuir.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705F6.title: "Relique : Mèche de peluche"
	quest.42000000002705F7.quest_desc: [
		"Le Jardin de nœuds : une île d'herbe sous quatre anneaux de labyrinthe de haies, avec des brèches et des éperons, des chemins de roche, des anneaux de nœuds de corde pendus au-dessus.",
		"Quatre Fil effiloché et quatre feuilles autour d'un Écheveau du vide.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705F7.title: "Totem : L'Emmêlement"
	quest.42000000002705F8.quest_desc: [
		"L'araignée ferme les chemins derrière toi avec des nœuds de corde qui prennent trois coups à couper, et mord qui est seul dans une impasse. Reste groupé dans le labyrinthe. Optionnel, en milieu de partie, un prix cosmétique.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705F8.title: "Retendre : L'Emmêlement"
	quest.42000000002705F9.quest_desc: [
		"Charme de nœud : pas de ralentissement sur toile d'araignée, sable des âmes, miel ou neige poudreuse, et moitié moins de glisse sur la glace. L'Emmêlement enracine le premier monstre qu'il touche.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705F9.title: "Relique : Charme de nœud"
	quest.42000000002705FA.quest_desc: [
		"Les deux arènes folles attendent derrière une porte que seul le Retissage ouvre. Leurs totems ont besoin de la relique Fil du métier dans la grille de fabrication, et ne répondent qu'à un Clowder qui a refermé son ciel. Les boss font dix à vingt fois ta taille. Amène tout le monde.",
		"Comment : assieds les neuf Brins, puis retisse. Le progrès se déclenche quand le ciel se referme."
	]
	quest.42000000002705FA.title: "La porte scellée"
	quest.42000000002705FB.quest_desc: [
		"La Scission : un grand éclat d'obsidienne traversé par la Coupe lumineuse, vingt éclats du monde à la dérive autour, des larmes du vide bleu-vert dans l'air.",
		"Fil effiloché et obsidienne autour de la relique Fil du métier ; la relique est rendue.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705FB.title: "Totem : La Première coupe"
	quest.42000000002705FC.quest_desc: [
		"Une forme que la Coupe a laissée sur l'éclat, pas l'aveu de qui a porté le coup. Toutes les vingt secondes elle tranche une ligne à travers l'éclat et les blocs tombent pendant quinze secondes ; la couture donne Vitesse, mais son rayon suit la couture. Les éclats à la dérive écrasent, les larmes du vide attirent, et à un cinquième de sa vie l'éclat se fend en deux le long de la Coupe. Seulement après le Retissage.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705FC.title: "Rendre la tension : La Première coupe"
	quest.42000000002705FD.quest_desc: [
		"Éclat de la Première coupe : tranche les phases de garde. Le meilleur du paquet, réservé à ceux qui ont réussi.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705FD.title: "Relique : Éclat de la Première coupe"
	quest.42000000002705FE.quest_desc: [
		"Le Métier d'en haut : un tissage de purpur, neuf ponts de Brin vers neuf plateformes à piliers, vingt-sept fils de cathédrale jusqu'à une clé de voûte à soixante-quatre blocs de haut.",
		"Fil effiloché et purpur autour de la relique Fil du métier ; la relique te est rendue.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.42000000002705FE.title: "Totem : Le Surtisseur"
	quest.42000000002705FF.quest_desc: [
		"Ton propre Métier restauré s'est retourné contre toi. Le Surtisseur jette les ombres des neuf gardiens sur leurs Brins ; tue une ombre et son fil se tend vingt-cinq secondes, et alors seulement le Métier lui-même peut être blessé. Plus tard il en jette trois, puis les neuf.",
		"Comment : utilise le Totem effiloché correspondant, puis gagne l'arène. Le progrès complète ceci."
	]
	quest.42000000002705FF.title: "Rendre la tension : Le Surtisseur"
	quest.4200000000270600.quest_desc: [
		"Navette du Surtisseur : un écho de chaque relique de Brin en une seule, et elle retisse un compagnon de Clowder tombé.",
		"Un par membre de Clowder présent à la victoire, droit dans l'inventaire.",
		"Comment : Codex des Moustaches, Gardiens rompus — totem, arène, relique. Le totem répond sur la plateforme."
	]
	quest.4200000000270600.title: "Relique : Navette du Surtisseur"
	quest.42000000002805E3.quest_desc: [
		"Les coureurs de plateforme sauvages n'apparaissent pas sur une plateforme du vide. Joue le Rite de la porte sur un Tambour de porte (utilise-le à mains vides, frappe les temps sur A, S, D, F) et marche la Marche. Les jaunes paissent dans la Steppe et le Marais aux roseaux. Les Hautes Terres penchent vers le grade Excellent. Les Champs de neige cachent des grades Merveilleux. La Désolation de braise garde les oiseaux Flamme.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : utilise le Tambour de porte à mains vides et joue le Rite de la porte : frappe les temps qui tombent sur A, S, D, F. Atteins 60% et il s'ouvre ; pas besoin de Pouls. Lie d'abord une boussole de retour."
	]
	quest.42000000002805E3.title: "Porte vers la Marche"
	quest.42000000002805E4.quest_desc: [
		"Le Gysahl sauvage pousse dans le Marais aux roseaux, la Steppe et les Hautes Terres, le plus dense dans le Marais. La cueillette lâche aussi des graines, et une Feuille de la Marche ou de l'herbe cassées à la houe en donnent davantage. Plante les graines chez toi sur de la terre labourée.",
		"Comment : cueille du Gysahl sauvage dans la Marche (le Marais aux roseaux est le plus dense). La cueillette lâche aussi des graines ; plante-les chez toi sur de la terre labourée."
	]
	quest.42000000002805E4.title: "Gysahl Green"
	quest.42000000002805E5.quest_desc: [
		"Un livre et une feuille de Gysahl. Utilise-le n'importe où : ses pages listent la couleur, le grade, la classe, les victoires en course et la dernière noix de chacun de tes oiseaux.",
		"Comment : un livre et un Gysahl. Utilise-le n'importe où ; ses pages listent tes propres oiseaux."
	]
	quest.42000000002805E5.title: "Chocobo Almanac"
	quest.42000000002805E6.quest_desc: [
		"Donne du Gysahl pour apprivoiser un jaune sauvage. Fabrique une selle en cuir, ficelle et fer, puis monte. Le sprint lance une ruée ; relâche pour reprendre l'endurance.",
		"Comment : cuir, ficelle et fer. Apprivoise un jaune sauvage avec du Gysahl, puis selle-le."
	]
	quest.42000000002805E6.title: "Chocobo Saddle"
	quest.42000000002805E7.quest_desc: [
		"Des pépites d'or autour d'une horloge, avec un Gysahl. En la remontant, elle t'emmène au Vent des Moustaches et au retour. Après avoir marché la Marche, Esther se tient aussi dans la Salle Clowder : monte un oiseau sellé jusqu'à elle, ou demande au Guide du Vent des Moustaches.",
		"Comment : des pépites d'or autour d'une horloge, avec un Gysahl. Utilise-la pour te remonter jusqu'au Vent des Moustaches et au retour ; un oiseau sellé vient avec toi."
	]
	quest.42000000002805E7.title: "Chocobo Pocketwatch"
	quest.42000000002805E8.quest_desc: [
		"Un leurre en main attire les oiseaux sauvages et trace leur contour à travers un champ.",
		"Comment : fabrique le leurre. Tiens-le pour trouver les jaunes de la Marche."
	]
	quest.42000000002805E8.title: "Chocobo Lure"
	quest.42000000002805E9.quest_desc: [
		"Plante des graines de Gysahl sur de la terre labourée. Une parcelle à la maison, c'est ainsi que commence la ligne de la ferme.",
		"Comment : cueillir du Gysahl sauvage lâche des graines, et l'herbe et la Feuille de la Marche cassées à la houe aussi. Plante sur de la terre labourée."
	]
	quest.42000000002805E9.title: "Gysahl Seeds"
	quest.42000000002805EA.quest_desc: [
		"Nourris deux adultes de sexe opposé avec une noix Carob. Deux Jaunes de grade Bon ou mieux plus Carob peuvent éclore en Vert ou en Bleu. Chaque parent a besoin de 5 premières places gagnées en Classe C ; 16 combinées rendent la couleur sûre. Un Vert de grade Excellent et un Bleu de grade Excellent, chacun avec 8 premières places de Classe B, éclosent en Noir (un raté donne Blanc ; 24 combinées pour un tirage sûr).",
		"Comment : Bilo le gardien des noix, au Vent des Moustaches, vend Carob. Les courses de Classe A le versent aussi."
	]
	quest.42000000002805EA.title: "Carob Nut"
	quest.42000000002805EB.quest_desc: [
		"Un vert à mi-échelle. Entraîne vitesse, endurance, intelligence ou coopération ; l'oiseau se rassasie de chaque sorte.",
		"Comment : le sage Wynn, au Vent des Moustaches."
	]
	quest.42000000002805EB.title: "Vert Curiel"
	quest.42000000002805EC.quest_desc: [
		"Le vert d'entraînement du sommet. Monte l'échelle une fois l'oiseau rassasié des feuilles moins chères.",
		"Comment : le sage Wynn au Vent des Moustaches, ou un prix de course de Classe S."
	]
	quest.42000000002805EC.title: "Vert Sylkis"
	quest.42000000002805ED.quest_desc: [
		"L'Or n'éclôt jamais sans Zeio. Un Noir de grade Merveilleux plus un Jaune de grade Merveilleux, chacun avec 10 premières places gagnées en Classe A (32 combinées pour un tirage sûr).",
		"Comment : Bilo le gardien des noix, au Vent des Moustaches, vend Zeio. Les courses de Classe S le versent rarement."
	]
	quest.42000000002805ED.title: "Zeio Nut"
	quest.42000000002805EE.quest_desc: [
		"Des GP gagnés sur la piste. Les étals de la Place affichent tout en GP.",
		"Comment : place-toi dans les trois premiers d'une manche au Vent des Moustaches. Monte un oiseau sellé jusqu'à Esther pour t'inscrire."
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"La première noix d'accouplement. Le talent suit la noix ; la couleur suit les parents, sauf si Carob ou Zeio entre en jeu.",
		"Comment : Bilo le gardien des noix, au Vent des Moustaches, vend Pepio. Une victoire en Classe C peut aussi le verser."
	]
	quest.42000000002805EF.title: "Pepio Nut"
	quest.42000000002805F0.quest_desc: [
		"Deux Gysahl et de la poudre d'os. Le premier pas au-dessus des verts ordinaires.",
		"Comment : sans forme — deux Gysahl et de la poudre d'os."
	]
	quest.42000000002805F0.title: "Vert Krakka"
	quest.42000000002805F1.quest_desc: [
		"Le vert d'entraînement suivant. Facultatif une fois la ferme en route.",
		"Comment : le sage Wynn, ou la recette listée dans JEI."
	]
	quest.42000000002805F1.title: "Vert Tantal"
	quest.42000000002805F2.quest_desc: [
		"Un autre vert d'entraînement. Facultatif.",
		"Comment : le sage Wynn à la Place."
	]
	quest.42000000002805F2.title: "Vert Pahsana"
	quest.42000000002805F3.quest_desc: [
		"Un autre vert d'entraînement. Facultatif.",
		"Comment : le sage Wynn à la Place."
	]
	quest.42000000002805F3.title: "Vert Mimett"
	quest.42000000002805F4.quest_desc: [
		"Un autre vert d'entraînement. Facultatif.",
		"Comment : le sage Wynn à la Place."
	]
	quest.42000000002805F4.title: "Vert Reagan"
	quest.42000000002805F5.quest_desc: [
		"Une noix intermédiaire. Facultative.",
		"Comment : Bilo le gardien des noix, au Vent des Moustaches, vend Luchile."
	]
	quest.42000000002805F5.title: "Luchile Nut"
	quest.42000000002805F6.quest_desc: [
		"Une noix intermédiaire. Facultative.",
		"Comment : Bilo le gardien des noix, au Vent des Moustaches, vend Saraha."
	]
	quest.42000000002805F6.title: "Saraha Nut"
	quest.42000000002805F7.quest_desc: [
		"Une noix intermédiaire. Facultative.",
		"Comment : Bilo le gardien des noix, au Vent des Moustaches, vend Lasan."
	]
	quest.42000000002805F7.title: "Lasan Nut"
	quest.42000000002805F8.quest_desc: [
		"Une noix d'accouplement de milieu-fin. Facultative. Bilo le gardien des noix la vend.",
		"Comment : Bilo le gardien des noix, au Vent des Moustaches, vend Pram."
	]
	quest.42000000002805F8.title: "Pram Nut"
	quest.42000000002805F9.quest_desc: [
		"L'étal de la Foire au Vent des Moustaches vend des feux d'artifice, des laisses, des montres de poche et l'Almanach Chocobo contre des GP.",
		"Comment : du papier plus de la poudre à canon. Éclat optionnel."
	]
	quest.42000000002805F9.title: "Feux d'artifice de la Foire"
	quest.42000000002805FA.quest_desc: [
		"Une noix d'accouplement tardive. Facultative.",
		"Comment : Bilo le gardien des noix, au Vent des Moustaches, vend Porov."
	]
	quest.42000000002805FA.title: "Porov Nut"
	quest.42000000002905FB.quest_desc: [
		"Le vide n'a jamais fait pousser les buissons de Pam's. Tamise de la terre avec une maille de ficelle. Casse le jardin pour des graines arides — piment, maïs, fruit de cactus.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : tamise de la terre avec une maille de ficelle ou mieux (Ex Deorum ou le Métier du vide)."
	]
	quest.42000000002905FB.title: "Arid Garden"
	quest.42000000002905FC.quest_desc: [
		"Cultures de froid, de la même terre. Casse le buisson ; plante ce qu'il te faut.",
		"Comment : tamise de la terre avec une maille de ficelle ou mieux."
	]
	quest.42000000002905FC.title: "Frost Garden"
	quest.42000000002905FD.quest_desc: [
		"Cultures sous les feuilles. Même tamis, autre buisson.",
		"Comment : tamise de la terre avec une maille de ficelle ou mieux."
	]
	quest.42000000002905FD.title: "Shaded Garden"
	quest.42000000002905FE.quest_desc: [
		"Cultures humides. Le riz et le reste des graines à l'esprit de marais vivent ici.",
		"Comment : tamise de la terre avec une maille de ficelle ou mieux."
	]
	quest.42000000002905FE.title: "Soggy Garden"
	quest.42000000002905FF.quest_desc: [
		"Cultures chaudes. Garde un buisson dans un coffre ; ils s'étendent quand même si tu les plantes.",
		"Comment : tamise de la terre avec une maille de ficelle ou mieux."
	]
	quest.42000000002905FF.title: "Tropical Garden"
	quest.4200000000290600.quest_desc: [
		"Le dernier des six. Chaque graine HarvestCraft sur la plateforme commence comme l'un de ces buissons.",
		"Comment : tamise de la terre avec une maille de ficelle ou mieux."
	]
	quest.4200000000290600.title: "Windy Garden"
	quest.4200000000290601.quest_desc: [
		"Pas la planche à découper de Farmer's Delight. Du cuivre, un bâton et une planche. Prépare fruits et légumes avant qu'ils n'aillent dans la marmite.",
		"Comment : du cuivre, un bâton et une planche. Pas la planche à découper de Farmer's Delight."
	]
	quest.4200000000290601.title: "Tableau de récolte"
	quest.4200000000290602.quest_desc: [
		"Soupes, ragoûts et bouillon. Du cuivre et un bâton. Le pot revient après chaque fabrication.",
		"Comment : du cuivre et un bâton. Le pot revient après chaque cuisson sans forme."
	]
	quest.4200000000290602.title: "Pot de récolte"
	quest.4200000000290603.quest_desc: [
		"Plats à la poêle. Du cuivre et des bâtons. Une fabrication différente de la poêle Delight ; JEI les distingue.",
		"Comment : du cuivre et des bâtons. Différente de la poêle Delight."
	]
	quest.4200000000290603.title: "Poêle de récolte"
	quest.4200000000290604.quest_desc: [
		"Sauces et réductions. Du cuivre et un bâton. Garde-le près du pot.",
		"Comment : du cuivre et un bâton."
	]
	quest.4200000000290604.title: "Saucepan"
	quest.4200000000290605.quest_desc: [
		"Anneau de terre cuite. Tartes, pains, et tout ce qui veut une forme de four.",
		"Comment : huit terres cuites autour d'un centre vide."
	]
	quest.4200000000290605.title: "Bakeware"
	quest.4200000000290606.quest_desc: [
		"Planches et un bâton. Appareils, pâtes et salades. Le poste calme.",
		"Comment : des planches et un bâton."
	]
	quest.4200000000290606.title: "Mixing Bowl"
	quest.4200000000290607.quest_desc: [
		"Terre cuite. Fruit dedans, jus dehors. Associe-le à un arbre, pas à un potager.",
		"Comment : terre cuite. Quatre en T."
	]
	quest.4200000000290607.title: "Juicer"
	quest.4200000000290608.quest_desc: [
		"Des bâtons et une bûche. Aplatis la pâte. Le moule attend.",
		"Comment : des bâtons de chaque côté d'une bûche."
	]
	quest.4200000000290608.title: "Rouleau"
	quest.4200000000290609.quest_desc: [
		"Cailloux d'andésite d'un tamis de silex, puis un bâton. Farine, épices, pâtes.",
		"Comment : andésite (cailloux de terre ou de gravier au tamis de silex) et un bâton."
	]
	quest.4200000000290609.title: "Grinder"
	quest.420000000029060A.quest_desc: [
		"Un seau d'eau divisé en huit. La plupart des recettes veulent ceci, pas un seau vanilla.",
		"Comment : un seau d'eau → huit eaux douces."
	]
	quest.420000000029060A.title: "Fresh Water"
	quest.420000000029060B.quest_desc: [
		"Pas de vaches sur la plateforme. Noix de coco (terre à maille de fer) plus eau douce, ou divise un seau de lait plus tard.",
		"Comment : noix de coco (terre à maille de fer) plus eau douce, ou divise un seau de lait."
	]
	quest.420000000029060B.title: "Fresh Milk"
	quest.420000000029060C.quest_desc: [
		"De l'eau dans un pot, ou un passage au broyeur. Presque chaque recette salée le demande.",
		"Comment : pot plus eau ou eau douce. Le pot revient."
	]
	quest.420000000029060C.title: "Salt"
	quest.420000000029060D.quest_desc: [
		"Du blé dans le broyeur. La pâte commence ici.",
		"Comment : broyeur plus blé (ou une autre plante à farine). Le broyeur revient."
	]
	quest.420000000029060D.title: "Flour"
	quest.420000000029060E.quest_desc: [
		"Farine, sel et eau douce. Tartes et pains partagent cette boule.",
		"Comment : bol à mélanger, farine, eau, sel."
	]
	quest.420000000029060E.title: "Dough"
	quest.420000000029060F.quest_desc: [
		"Des os ou des légumes dans le pot. Les soupes veulent une bouteille de ceci, pas un bouillon au jugé.",
		"Comment : pot plus un os (les Gardiens de la plateforme vendent des os) ou des légumes de reste."
	]
	quest.420000000029060F.title: "Stock"
	quest.4200000000290610.quest_desc: [
		"Terre à maille de fer. Fais-le pousser sur la plateforme ; le chêne vanilla ne lâche pas les pommes de Pam's.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.4200000000290610.title: "Pommier"
	quest.4200000000290611.quest_desc: [
		"De l'acide pour les vinaigrettes et le poisson. Le même tamis de fer.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.4200000000290611.title: "Citronnier"
	quest.4200000000290612.quest_desc: [
		"Épice d'écorce. Pâtisseries et thés.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.4200000000290612.title: "Cannelier"
	quest.4200000000290613.quest_desc: [
		"Lait, huile et cuisine tropicale.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.4200000000290613.title: "Cocotier"
	quest.4200000000290614.quest_desc: [
		"Des gousses pour les douceurs. Plante-la comme les autres.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.4200000000290614.title: "Liane de vanille"
	quest.4200000000290615.quest_desc: [
		"Le pommier de Pam's donne des pommes ordinaires, bien plus que les feuilles de chêne n'en lâchent. Le presse-fruits et le moule les veulent tous les deux.",
		"Comment : les feuilles de chêne en lâchent quelques-unes ; un pommier Pam's (plant issu de terre à maille de fer) en porte beaucoup."
	]
	quest.4200000000290615.title: "Pomme de Pam's"
	quest.4200000000290616.quest_desc: [
		"Moule, pâte, sucre, pommes. La première cuisson finie de HarvestCraft.",
		"Comment : moule, pâte, sucre, pommes de Pam's du pommier."
	]
	quest.4200000000290616.title: "Tarte aux pommes (Récolte)"
	quest.4200000000290617.quest_desc: [
		"Presse-fruits plus fruits mélangés. Une boisson de la plateforme qui n'est pas du jus de pastèque.",
		"Comment : presse-fruits et fruits mélangés."
	]
	quest.4200000000290617.title: "Fruit Punch"
	quest.4200000000290618.quest_desc: [
		"Poêle, pain, fromage. Un déjeuner vite fait pendant que les arbres poussent.",
		"Comment : poêle, pain, beurre et fromage — le tout vient d'eau douce, de lait de coco et de farine."
	]
	quest.4200000000290618.title: "Grilled Cheese"
	quest.4200000000290619.quest_desc: [
		"Piments arides, tomate, oignon, haricot, feuille d'épice, et viande ou tofu soyeux. Food Extended commence à se rendre utile.",
		"Comment : marmite, piment aride, tomate, oignon, haricot, feuille d'épice, et viande ou tofu soyeux."
	]
	quest.4200000000290619.title: "Bol de chili"
	quest.420000000029061A.quest_desc: [
		"Épices du moulin, légumes des jardins, travail à la marmite.",
		"Comment : casserole, riz, noix de coco, piment, poivre noir, poudre de curry (feuille d'épice + moutarde + cannelle)."
	]
	quest.420000000029061A.title: "Assiette de curry"
	quest.420000000029061B.quest_desc: [
		"Pâte, sauce, viande. Moule. Un vrai repas HarvestCraft.",
		"Comment : moule, pâte, tomate, fromage, pepperoni (bacon de porc, ou bacon de tofu à partir d'érable + soja)."
	]
	quest.420000000029061B.title: "Pepperoni Pizza"
	quest.420000000029061C.quest_desc: [
		"Riz du jardin détrempé, carotte, oignon, petits pois et un œuf — le tofu soyeux prend sa place tant qu'il n'y a pas de poules.",
		"Comment : poêle, riz du jardin détrempé, carotte, oignon, petits pois et un œuf — le tofu soyeux compte comme œuf."
	]
	quest.420000000029061C.title: "Riz frit du jardin"
	quest.420000000029061D.quest_desc: [
		"Feuille de thé et feuille d'épice dans la marmite. Le jardin ombragé et le détrempé couvrent les deux.",
		"Comment : marmite, feuille de thé et feuille d'épice. Le jardin ombragé lâche le thé et l'épice."
	]
	quest.420000000029061D.title: "Green Tea"
	quest.420000000029061E.quest_desc: [
		"Huile et fruit salé. Prise facultative de la maille de fer.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.420000000029061E.title: "Olivier"
	quest.420000000029061F.quest_desc: [
		"Jus et zeste. Facultatif.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.420000000029061F.title: "Oranger"
	quest.4200000000290620.quest_desc: [
		"Fruit d'été. Facultatif.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.4200000000290620.title: "Pêcher"
	quest.4200000000290621.quest_desc: [
		"Poivre pour le moulin. Facultatif.",
		"Comment : tamise de la terre avec une maille de fer pour des pousses de cuisine, puis fais pousser le fruit."
	]
	quest.4200000000290621.title: "Poivrier"
	quest.4200000000290622.quest_desc: [
		"Graisse de friture. Base facultative.",
		"Comment : presse des graines ou des olives dans JEI. Base facultative."
	]
	quest.4200000000290622.title: "Cooking Oil"
	quest.4200000000290623.quest_desc: [
		"Lait et sel. Base facultative.",
		"Comment : marmite et lait (le lait de coco à l'eau douce convient)."
	]
	quest.4200000000290623.title: "Butter"
	quest.4200000000290624.quest_desc: [
		"Un œuf dans le presse-fruits. Facultatif.",
		"Comment : presse-fruits et un œuf (le tofu soyeux compte). Facultatif."
	]
	quest.4200000000290624.title: "Mayonnaise"
	quest.4200000000290625.quest_desc: [
		"Planche à découper, fruits mélangés. Facultatif.",
		"Comment : planche à découper et fruits mélangés. Facultatif."
	]
	quest.4200000000290625.title: "Fruit Salad"
	quest.4200000000290626.quest_desc: [
		"Soirée pâtes. Facultatif.",
		"Comment : les jardins et les arbres fruitiers fournissent les ingrédients. Le tofu de soja remplace la viande et l'œuf. JEI nomme le poste."
	]
	quest.4200000000290626.title: "Dîner spaghetti"
	quest.4200000000290627.quest_desc: [
		"Petit-déjeuner pour frimer. Facultatif.",
		"Comment : les jardins et les arbres fruitiers fournissent les ingrédients. Le tofu de soja remplace la viande et l'œuf. JEI nomme le poste."
	]
	quest.4200000000290627.title: "Bacon Pancakes"
	quest.4200000000290628.quest_desc: [
		"Terre à maille de fer pour un jeune avocatier, puis poêle, toast, sel, ail, feuille d'épice.",
		"Comment : jeune avocatier de la maille de fer, puis poêle avec toast, sel, ail, feuille d'épice."
	]
	quest.4200000000290628.title: "Avocado Toast"
	quest.4200000000290629.quest_desc: [
		"Pas le hamburger de Delight. Facultatif.",
		"Comment : les jardins et les arbres fruitiers fournissent les ingrédients. Le tofu de soja remplace la viande et l'œuf. JEI nomme le poste."
	]
	quest.4200000000290629.title: "Burger à l'oignon"
	quest.420000000029062A.quest_desc: [
		"Presse-fruits, pommes. Facultatif.",
		"Comment : presse-fruits et pommes de Pam's. Facultatif."
	]
	quest.420000000029062A.title: "Apple Juice"
	quest.420000000029062B.quest_desc: [
		"Poêle, pain et beurre. Facultatif.",
		"Comment : poêle, pain et beurre. Facultatif."
	]
	quest.420000000029062B.title: "Tranche de toast"
	quest.42000000002A062C.quest_desc: [
		"Quatre bâtons en carré. Pose-les sur de la terre labourée. Les graines du jeu de base se convertissent quand tu les plantes — celles de Mystical Agriculture, non.",
		"Pose un second jeu de bâtons dans le même bloc pour faire une culture croisée — une paire vide qui tient de ce qui est mûr à côté. Entoure-la de parents sur les quatre côtés et elle se sème seule en quelques minutes ; de la poudre d'os sur le croisement force une tentative tout de suite.",
		"Les Neuf Tribus ont laissé des provisions pour le prochain Clowder. Utilise une cache de l'intendant pour déballer des fournitures au hasard, ou fabrique quatre petites caches en une moyenne et trois moyennes en une grande. Les sceaux plus grands ont plus de tirages et une réserve plus large ; les ouvrir séparément donne plus de fournitures de base. Aucune machine ni aucun jeton de progression ne s'y cache, mais chaque sceau a une petite chance d'un Éclat de Fil et une très petite chance d'un Fil de retour entier ; les plus grands sceaux ont de meilleures chances.",
		"Comment : quatre bâtons en carré. Pose-les sur de la terre labourée, puis plante une graine."
	]
	quest.42000000002A062C.title: "Bâtons de culture en bois"
	quest.42000000002A062D.quest_desc: [
		"Un livre et plume (livre, poche d'encre, plume) plus des graines de blé. Garde-le dans l'analyseur.",
		"Comment : livre et plume (livre, poche d'encre, plume) plus des graines de blé. Du charbon de bois plus une fiole font l'encre."
	]
	quest.42000000002A062D.title: "Journal de culture"
	quest.42000000002A062E.quest_desc: [
		"Vitre et bâtons. Regarde une culture pour lire croissance, rendement et force sans la cueillir.",
		"Comment : une vitre entre des bâtons, puis un manche en bâton. Regarde une culture plantée."
	]
	quest.42000000002A062E.title: "Magnifying Glass"
	quest.42000000002A062F.quest_desc: [
		"Verre, dalle de pierre, planches, bâtons. Mets une graine avec le journal. La reproduction devient visible.",
		"La fertilité est la statistique qui pousse le croisement : une graine neuve est à 1 sur 10, et chaque point augmente la chance qu'une plante soit choisie comme parent. Analyse, replante les meilleures, et les croisements viennent plus vite.",
		"Comment : vitres, dalle de pierre, planches et bâtons. Pose le journal, puis une graine."
	]
	quest.42000000002A062F.title: "Seed Analyzer"
	quest.42000000002A0630.quest_desc: [
		"Les mauvaises herbes sont coupées dans ce paquet, mais le râteau retire encore un bâton. Emporte-en un quand même.",
		"Comment : une barrière en bois sur un bâton. Les mauvaises herbes sont coupées ; il retire quand même un bâton."
	]
	quest.42000000002A0630.title: "Râteau en bois"
	quest.42000000002A0631.quest_desc: [
		"Ramasse une plante et repose-la avec ses statistiques intactes. Déplace un 10-10 sans le casser.",
		"Comment : deux lingots de fer et un bâton. Ramasse une plante avec ses statistiques intactes."
	]
	quest.42000000002A0631.title: "Transplantoir"
	quest.42000000002A0632.quest_desc: [
		"Taille une plante mûre pour son produit de coupe et réinitialise-la. Fleurs et certaines cultures HarvestCraft.",
		"Comment : cisailles, fer et un bâton. Taille une plante mûre et réinitialise-la."
	]
	quest.42000000002A0632.title: "Cisaille à cultures"
	quest.42000000002A0633.quest_desc: [
		"Porte une lignée de reproduction. Remplis-la depuis l'analyseur, vide-la sur les bâtons.",
		"Comment : cuir et ficelle. Remplis depuis l'analyseur."
	]
	quest.42000000002A0633.title: "Sac de graines"
	quest.42000000002A0634.quest_desc: [
		"Des bâtons plus solides. Mêmes règles de plantation, moins de souci si tu les bouscules.",
		"Comment : deux pépites de fer en colonne en font huit."
	]
	quest.42000000002A0634.title: "Iron Crop Sticks"
	quest.42000000002A0635.quest_desc: [
		"Le râteau amélioré. Encore une habitude, même sans mauvaises herbes.",
		"Comment : des barreaux de fer sur un bâton."
	]
	quest.42000000002A0635.title: "Râteau en fer"
	quest.42000000002A0636.quest_desc: [
		"Garde de l'eau pour les canaux. Une ferme sur la plateforme qui ne porte pas de seaux chaque matin.",
		"Comment : des planches. Garde de l'eau pour les canaux."
	]
	quest.42000000002A0636.title: "Irrigation Tank"
	quest.42000000002A0637.quest_desc: [
		"Fais courir l'eau du réservoir le long du rang. Les cultures boivent au canal, pas à toi.",
		"Comment : sans forme, à partir d'un réservoir — un réservoir devient huit canaux."
	]
	quest.42000000002A0637.title: "Irrigation Channel"
	quest.42000000002A0638.quest_desc: [
		"Arrête et relance une ligne sans casser le réservoir.",
		"Comment : barreaux de fer, teinture rouge et un lingot de fer. Arrête et relance une ligne sans casser le réservoir."
	]
	quest.42000000002A0638.title: "Channel Valve"
	quest.42000000002A0639.quest_desc: [
		"De la pluie dans un carré. Pose-le sur un canal, au-dessus des bâtons.",
		"Comment : pose-le sur un canal, au-dessus des bâtons. JEI nomme la fabrication."
	]
	quest.42000000002A0639.title: "Sprinkler"
	quest.42000000002A063A.quest_desc: [
		"Couvre un canal pour pouvoir marcher le long du rang.",
		"Comment : couvre un canal pour pouvoir marcher le long du rang."
	]
	quest.42000000002A063A.title: "Grille de canal"
	quest.42000000002A063B.quest_desc: [
		"Lis la pièce. Lumière, humidité, la raison pour laquelle une culture a calé.",
		"Comment : fabrique-le, puis place-le dans la pièce pour lire lumière et humidité."
	]
	quest.42000000002A063B.title: "Greenhouse Monitor"
	quest.42000000002A063C.quest_desc: [
		"Bâtons tardifs. Ignifuges, têtus, pour les plantes qui demandent trop au bois. Deux cultures mûres voisines peuvent se croiser.",
		"Comment : deux obsidiennes en colonne en font huit. Deux cultures mûres voisines peuvent se croiser."
	]
	quest.42000000002A063C.title: "Obsidian Crop Sticks"
	quest.42000000002A063D.quest_desc: [
		"Un canal sur lequel tu peux marcher. Facultatif.",
		"Comment : un canal sur lequel tu peux marcher. Facultatif."
	]
	quest.42000000002A063D.title: "Canal creux"
	quest.42000000002A063E.quest_desc: [
		"Les cultures de minerai lâchent ceci. Lignée de reproduction facultative.",
		"Comment : bâtons de culture en bois à partir de bâtons ; le journal est un livre et plume plus des graines ; l'analyseur est verre et bois. Plante sur de la terre labourée."
	]
	quest.42000000002A063E.title: "Culture de pépite de cuivre"
	quest.42000000002A063F.quest_desc: [
		"Du quartz depuis un bâton. Facultatif.",
		"Comment : bâtons de culture en bois à partir de bâtons ; le journal est un livre et plume plus des graines ; l'analyseur est verre et bois. Plante sur de la terre labourée."
	]
	quest.42000000002A063F.title: "Culture d'éclat de quartz"
	quest.42000000002A0640.quest_desc: [
		"Du combustible d'une culture. Facultatif.",
		"Comment : bâtons de culture en bois à partir de bâtons ; le journal est un livre et plume plus des graines ; l'analyseur est verre et bois. Plante sur de la terre labourée."
	]
	quest.42000000002A0640.title: "Coal Pebble"
	quest.42000000002A0641.quest_desc: [
		"Culture de minerai tardive. Facultatif.",
		"Comment : bâtons de culture en bois à partir de bâtons ; le journal est un livre et plume plus des graines ; l'analyseur est verre et bois. Plante sur de la terre labourée."
	]
	quest.42000000002A0641.title: "Culture d'éclat d'émeraude"
