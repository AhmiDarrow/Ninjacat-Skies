	chapter.310000000000002B.chapter_subtitle: [
		"Des morceaux de l'ancien monde remontent en dérive jusqu'à ta plateforme. Atteins-les avant qu'ils se détissent."
	]
	chapter.310000000000002B.title: "Épaves à la dérive"
	quest.42000000002B0801.quest_desc: [
		"Une fois Terre en tension, des morceaux de l'ancien monde remontent de temps en temps jusqu'à ta plateforme et se prennent dans ta trame. L'intendant prévient tout le Clowder quand l'un arrive.",
		"Ils ne restent pas : une épave tient un moment du temps en ligne de ton Clowder, puis se détisse pour retourner dans le vide. Personne ne tombe, et rien de ce que tu as gagné n'est perdu."
	]
	quest.42000000002B0801.title: "Quelque chose à la dérive"
	quest.42000000002B0802.quest_desc: [
		"Tiens-toi au bord de ta plateforme, fais face à l'épave et utilise une Bobine d'amarre : un pont de fil se pose tout seul, en grimpant par demi-pas.",
		"Tombe et le fil te rattrape, pour trois cœurs. Le vide est le décor, pas la punition."
	]
	quest.42000000002B0802.title: "Traverse le vide"
	quest.42000000002B0803.quest_desc: [
		"Chaque épave demande une chose : ouvre son coffre du cœur, brise ses générateurs, renfile ses piliers, raccompagne un écho chez toi, ou tiens la couture.",
		"Finis-le et tous ceux qui y mettent le pied reçoivent de la Trame récupérée et un Sceau. Le Cadre du récupérateur transforme la trame en bobines, leurres, clés et décors."
	]
	quest.42000000002B0803.title: "Récupération"
	quest.42000000002B0804.quest_desc: [
		"L'Atlas des épaves garde les lieux de chaque tribu que tu as achevés : neuf Brins sur six sortes de lieu. Une colonne pleine, une rangée pleine, tous les tampons : chacun paie un petit atout permanent.",
		"Les pages viennent avec leur récit dans le Codex. Les pages d'indice trouvées dans les coffres ouvrent des salles cachées. Ouvre l'Atlas des épaves pour cocher ceci."
	]
	quest.42000000002B0804.title: "L'Atlas"
	quest.42000000002B0805.quest_desc: [
		"Apporte cinq Sceaux de l'épave : cinq épaves achevées, par n'importe qui de ton Clowder.",
		"Répétable : rends-les aussi souvent que tu veux.",
		"Comment : termine la tâche d'une épave à la dérive. Tous ceux qui y mettent le pied reçoivent un Sceau."
	]
	quest.42000000002B0805.title: "Cinq sceaux"
	quest.42000000002B0806.quest_desc: [
		"Brise trois générateurs effilochés et rends leurs noyaux.",
		"Répétable : rends-les aussi souvent que tu veux.",
		"Comment : brise un générateur effiloché sur une épave à la dérive ; chacun lâche son noyau."
	]
	quest.42000000002B0806.title: "Noyaux effilochés"
	quest.42000000002B0807.quest_desc: [
		"Un éclat d'un Vestige raccommodé. Rends-le.",
		"Répétable : rends-les aussi souvent que tu veux.",
		"Comment : ouvre la faille scellée d'un Fort avec une Clé de trame et raccommode le Vestige à l'intérieur."
	]
	quest.42000000002B0807.title: "Éclat de faille"
	quest.42000000002B0808.quest_desc: [
		"Tous les noyaux d'un Brin. Les leurres de cette tribu coûtent moitié moins, ses épaves arrivent un peu plus souvent, et sa bannière est à toi."
	]
	quest.42000000002B0808.title: "Une colonne entière"
	quest.42000000002B0809.quest_desc: [
		"Une sorte de lieu dans les neuf tribus. Ses salles cachées restent toujours ouvertes."
	]
	quest.42000000002B0809.title: "Une rangée entière"
	quest.42000000002B080A.quest_desc: [
		"Termine une épave de chaque modificateur. Tes épaves tiennent un quart de plus."
	]
	quest.42000000002B080A.title: "Six tampons"
	quest.42000000002B080B.quest_desc: [
		"Vingt-cinq pages remplies."
	]
	quest.42000000002B080B.title: "Moitié de l'Atlas"
	quest.42000000002B080C.quest_desc: [
		"Une Clé de trame taillée pour le Brin de cette épave ouvre la faille scellée d'un Fort. Quelque chose de petit et d'effiloché revêt la forme d'un Gardien à l'intérieur."
	]
	quest.42000000002B080C.title: "Dans la faille"
	quest.42000000002B080D.quest_desc: [
		"Raccommode les neuf Vestiges. Les Clés de trame coûtent la moitié."
	]
	quest.42000000002B080D.title: "Tous les Vestiges"
	quest.42000000002B080E.quest_desc: [
		"Toutes les cinquante-quatre pages. Quelque part sous les Skies, le cœur du vieux monde se met à dériver vers toi."
	]
	quest.42000000002B080E.title: "Chaque page"
	quest.42000000002B080F.quest_desc: [
		"Tiens-toi au cœur du vieux monde et réenfile-le. Il ne vient pas deux fois."
	]
	quest.42000000002B080F.title: "Cœur de la toile"
}
