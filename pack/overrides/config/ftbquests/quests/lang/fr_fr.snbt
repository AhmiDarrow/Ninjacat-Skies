	]
	quest.42000000001C0427.title: "Sifflet à vapeur"
	quest.42000000001C0428.quest_desc: [
		"Chauffe les bassins assez fort pour le haut fourneau et les potions.",
		"Comment : fabrique un brûleur de blaze vide, puis utilise-le sur un blaze d'une forteresse du Nether, après l'obsidienne de Griffe."
	]
