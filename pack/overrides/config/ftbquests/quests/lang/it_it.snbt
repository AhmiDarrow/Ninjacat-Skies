	quest.42000000001903AA.quest_desc: [
		"Accoppia due api e produce prole con tratti misti.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903AA.title: "Camera di allevamento (Apiario)"
	quest.42000000001903AB.quest_desc: [
		"Legge i tratti di un'ape e li annota per l'allevamento.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903AB.title: "Indicizzatore di geni (Apiario)"
	quest.42000000001903AC.quest_desc: [
		"Brucia miele per un filo lento e costante di energia.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903AC.title: "Generatore di miele (Apiario)"
	quest.42000000001903AD.quest_desc: [
		"Uno spuntino che tiene un'ape in gabbia calma e in salute.",
		"Come: favo di miele più una bottiglia di miele, senza forma."
	]
	quest.42000000001903AD.title: "Dolcetto al miele (Apiario)"
	quest.42000000001903AE.quest_desc: [
		"Un secchio pieno di miele, pronto da versare o da bruciare.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903AE.title: "Secchio d'Ape"
	quest.42000000001903AF.quest_desc: [
		"Si fonde per candele, oppure sigilla il telaio di un alveare.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903AF.title: "Scorta di cera"
	quest.42000000001903B0.quest_desc: [
		"Un favo di miele che si può regolare per qualsiasi ape.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903B0.title: "Favo configurabile"
	quest.42000000001903B1.quest_desc: [
		"I tratti di un'ape, estratti e pronti da imbottigliare.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903B1.title: "Campione Genetico"
	quest.42000000001903B2.quest_desc: [
		"La genetica di un'ape, conservata per un allevamento più tardi.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903B2.title: "Bottiglia di geni"
	quest.42000000001903B3.quest_desc: [
		"Quattro favi pressati fino a diventare solidi, soprattutto per costruire.",
		"Come: quattro favi di miele."
	]
	quest.42000000001903B3.title: "Blocco di favo di miele"
	quest.42000000001903B4.quest_desc: [
		"Rallenta le cadute e il movimento. Appiccicoso sotto i piedi, dolce in una tramoggia.",
		"Come: quattro bottiglie di miele. Le bottiglie tornano."
	]
	quest.42000000001903B4.title: "Blocco di miele (apiario)"
	quest.42000000001903B5.quest_desc: [
		"Un alveare selvatico. Affumicalo fino a calmarlo prima di prendere il favo.",
		"Come: tre favi di miele e sei assi. Un falò sotto le calma."
	]
	quest.42000000001903B5.title: "Alveare di base"
	quest.42000000001903B6.quest_desc: [
		"Il fumo dal basso tiene le api calme durante il raccolto.",
		"Come: tronchi, bastoni e carbone o carbone di legna."
	]
	quest.42000000001903B6.title: "Falò sotto"
	quest.42000000001903B7.quest_desc: [
		"Fiori per il lavoro delle api.",
		"Come: farina d'ossa sull'erba, o un fiore piccolo per il nido di quercia."
	]
	quest.42000000001903B7.title: "Tappeto di fiori"
	quest.42000000001903B8.quest_desc: [
		"Più fiori vicini significa più polline per l'alveare.",
		"Come: farina d'ossa sull'erba. Le api vogliono un qualsiasi fiore piccolo."
	]
	quest.42000000001903B8.title: "Campo di denti di leone"
	quest.42000000001903B9.quest_desc: [
		"Un fiore più vistoso, che alcune api preferiscono ai denti di leone.",
		"Come: muschio più quercia, oppure farina d'ossa sul muschio. Le api accettano il fiore."
	]
	quest.42000000001903B9.title: "Fioritura d'azalea"
	quest.42000000001903BA.quest_desc: [
		"Un frutto dell'End da cui alcune api raccolgono volentieri.",
		"Come: bancarella dei Camminabordi a /clowder hub. Le isole esterne dell'End non ci sono più."
	]
	quest.42000000001903BA.title: "Spuntino chorus"
	quest.42000000001903BB.quest_desc: [
		"Uno strano favorito per poche delle api più toste.",
		"Come: acqua su una sorgente di lava (o lava sull'acqua). Tieni la sorgente di lava."
	]
	quest.42000000001903BB.title: "Dolcetto di ossidiana"
	quest.42000000001903BC.quest_desc: [
		"Più stanze per l'alveare, stavolta tagliate dalla betulla.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903BC.title: "Espansione in betulla"
	quest.42000000001903BD.quest_desc: [
		"Stanze rivestite d'abete, imbullonate all'alveare.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903BD.title: "Espansione in abete"
	quest.42000000001903BE.quest_desc: [
		"Rivestimento di quercia scura, stesso scopo: più stanze per le api.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903BE.title: "Espansione in quercia scura"
	quest.42000000001903BF.quest_desc: [
		"Stanze di acacia per un alveare cresciuto oltre se stesso.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903BF.title: "Espansione in acacia"
	quest.42000000001903C0.quest_desc: [
		"Stanze di legno della giungla, spaziose quanto le altre.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903C0.title: "Espansione della giungla"
	quest.42000000001903C1.quest_desc: [
		"Stanze rivestite di ciliegio, solo una questione di stile.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903C1.title: "Espansione in ciliegio"
	quest.42000000001903C2.quest_desc: [
		"Stanze rivestite di cremisi per un alveare finito nel Nether.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903C2.title: "Espansione cremisi"
	quest.42000000001903C3.quest_desc: [
		"Stanze rivestite di legno distorto, la metà blu della coppia.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903C3.title: "Espansione distorta"
	quest.42000000001903C4.quest_desc: [
		"Stanze di bambù, più leggere e altrettanto pratiche.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903C4.title: "Espansione in bambù"
	quest.42000000001903C5.quest_desc: [
		"Stanze di mangrovia, il legno più nuovo dell'elenco.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.42000000001903C5.title: "Espansione di mangrovia"
	quest.42000000001903C6.quest_desc: [
		"Miele che bevi dritto dalla bottiglia.",
		"Come: bottiglia di vetro su un alveare pieno. Falò sotto."
	]
	quest.42000000001903C6.title: "Scorta di bottiglie di miele"
	quest.42000000001903C7.quest_desc: [
		"Diventa dolcetti e torte per un Clowder affamato.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001903C7.title: "Scorta di zucchero"
	quest.42000000001903C8.quest_desc: [
		"Vuote e in attesa di miele, pozioni o esperienza.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001903C8.title: "Scorta di bottiglie"
	quest.42000000001903C9.quest_desc: [
		"Un paio di riserva per tagliare il favo senza ferire le api.",
		"Come: due lingotti di ferro in diagonale. Tosa le pecore e i nidi d'api."
	]
	quest.42000000001903C9.title: "Cesoie di riserva"
	quest.42000000001A03CA.quest_desc: [
		"Un blocco che sposta gli oggetti dove glielo dici — il sistema nervoso della piattaforma.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: lingotti di ferro e sbarre di ferro intorno a un modulo vuoto; ne escono quattro. I moduli vanno nel router."
	]
	quest.42000000001A03CA.title: "Modular Router"
	quest.42000000001A03CB.quest_desc: [
		"La scheda su cui si scrive ogni comportamento del router.",
		"Come: Router modulare più moduli vuoti in JEI. Estrattore/inviatore/demolitore stanno nel router."
	]
	quest.42000000001A03CB.title: "Blank Module"
	quest.42000000001A03CC.quest_desc: [
		"Tira gli oggetti da un vicino e li mette nel router.",
		"Come: Router modulare più moduli vuoti in JEI. Estrattore/inviatore/demolitore stanno nel router."
	]
	quest.42000000001A03CC.title: "Modulo tiratore"
	quest.42000000001A03CD.quest_desc: [
		"Spingi gli oggetti in un punto segnato, dall'altra parte della piattaforma.",
		"Come: Router modulare più moduli vuoti in JEI. Estrattore/inviatore/demolitore stanno nel router."
	]
	quest.42000000001A03CD.title: "Modulo mittente"
	quest.42000000001A03CE.quest_desc: [
		"Rompi un blocco davanti al router e tieni ciò che cade.",
		"Come: Router modulare più moduli vuoti in JEI. Estrattore/inviatore/demolitore stanno nel router."
	]
	quest.42000000001A03CE.title: "Breaker Module"
	quest.42000000001A03CF.quest_desc: [
		"Piazza un blocco dove punta il router.",
		"Come: Router modulare più moduli vuoti in JEI. Estrattore/inviatore/demolitore stanno nel router."
	]
	quest.42000000001A03CF.title: "Placer Module"
	quest.42000000001A03D0.quest_desc: [
		"Emetti redstone quando il contenuto del router supera una soglia.",
		"Come: Router modulare più moduli vuoti in JEI. Estrattore/inviatore/demolitore stanno nel router."
	]
	quest.42000000001A03D0.title: "Detector Module"
	quest.42000000001A03D1.quest_desc: [
		"Porta gli oggetti tra casse, macchine e piattaforme.",
		"Come: ferro + redstone. Sistema le facce con la chiave inglese Pipez."
	]
	quest.42000000001A03D1.title: "Tubo per oggetti"
	quest.42000000001A03D2.quest_desc: [
		"Porta i liquidi tra serbatoi e macchine, senza correre col secchio.",
		"Come: ferro + secchi + redstone. Uso accovacciato della chiave inglese su un lato per estrarre; clic destro su quel lato per i filtri."
	]
	quest.42000000001A03D2.title: "Tubo per fluidi"
	quest.42000000001A03D3.quest_desc: [
		"Porta l'energia tra le macchine che la fanno e quelle che ne hanno bisogno.",
		"Come: ferro + redstone. Porta FE tra le macchine."
	]
	quest.42000000001A03D3.title: "Cavo per energia"
	quest.42000000001A03D4.quest_desc: [
		"Porta le sostanze chimiche tra le macchine che le trattano.",
		"Come: tubi di ferro + redstone in JEI. Uso accovacciato della chiave inglese per impostare i lati che estraggono; clic destro su uno per i filtri. Il capitolo dei tubi è tutta la scala."
	]
	quest.42000000001A03D4.title: "Tubo per gas"
	quest.42000000001A03D5.quest_desc: [
		"Un tubo, tanti lavori.",
		"Come: tubi di ferro + redstone in JEI. Uso accovacciato della chiave inglese per impostare i lati che estraggono; clic destro su uno per i filtri. Il capitolo dei tubi è tutta la scala."
	]
	quest.42000000001A03D5.title: "Cavo universale"
	quest.42000000001A03D6.quest_desc: [
		"Usa accovacciato un lato del tubo perché estragga da una macchina, o per staccarlo.",
		"Come: due selci e due bastoni. Uso accovacciato su un lato del tubo a una macchina per farlo estrarre, di nuovo per tagliarlo; clic destro su un lato che estrae per i filtri."
	]
	quest.42000000001A03D6.title: "Chiave inlgese dei cavi"
	quest.42000000001A03D7.quest_desc: [
		"Miglioria di velocità per un tubo.",
		"Come: tubi di ferro + redstone in JEI. Uso accovacciato della chiave inglese per impostare i lati che estraggono; clic destro su uno per i filtri. Il capitolo dei tubi è tutta la scala."
	]
	quest.42000000001A03D7.title: "Miglioria di base"
	quest.42000000001A03D8.quest_desc: [
		"Inseriscila in un tubo per muoverne di più per tick.",
		"Come: tubi di ferro + redstone in JEI. Uso accovacciato della chiave inglese per impostare i lati che estraggono; clic destro su uno per i filtri. Il capitolo dei tubi è tutta la scala."
	]
	quest.42000000001A03D8.title: "Miglioria migliorata"
	quest.42000000001A03D9.quest_desc: [
		"Una miglioria più robusta, per una linea sotto forte carico.",
		"Come: tubi di ferro + redstone in JEI. Uso accovacciato della chiave inglese per impostare i lati che estraggono; clic destro su uno per i filtri. Il capitolo dei tubi è tutta la scala."
	]
	quest.42000000001A03D9.title: "Miglioria avanzata"
	quest.42000000001A03DA.quest_desc: [
		"Il gradino più alto di portata di Pipez.",
		"Come: tubi di ferro + redstone in JEI. Uso accovacciato della chiave inglese per impostare i lati che estraggono; clic destro su uno per i filtri. Il capitolo dei tubi è tutta la scala."
	]
	quest.42000000001A03DA.title: "Miglioria definitiva"
	quest.42000000001A03DB.quest_desc: [
		"Togli i tetti di portata di Pipez.",
		"Come: solo in creativa; Pipez non ha una ricetta di sopravvivenza. Facoltativo."
	]
	quest.42000000001A03DB.title: "Miglioria infinita"
	quest.42000000001A03DC.quest_desc: [
		"Imposta quali oggetti un'estremità del tubo accetta o ignora.",
		"Come: tubi di ferro + redstone in JEI. Uso accovacciato della chiave inglese per impostare i lati che estraggono; clic destro su uno per i filtri. Il capitolo dei tubi è tutta la scala."
	]
	quest.42000000001A03DC.title: "Strumento filtro"
	quest.42000000001A03DD.quest_desc: [
		"Il traslocatore di sempre. Lento, economico e sempre utile.",
		"Come: cinque ferri intorno a un baule. Mettila sotto una Cornice del telaio o un Barile di tensione (estrae verso il BASSO)."
	]
	quest.42000000001A03DD.title: "Tramoggia di scorta (Tubi)"
	quest.42000000001A03DE.quest_desc: [
		"Linea di rilasciatori per la logistica.",
		"Come: ciottoli intorno alla redstone."
	]
	quest.42000000001A03DE.title: "Linea di rilasciatori"
	quest.42000000001A03DF.quest_desc: [
		"Spara o piazza ciò che ha caricato quando riceve un segnale.",
		"Come: ciottoli, arco e redstone."
	]
	quest.42000000001A03DF.title: "Linea di erogatori"
	quest.42000000001A03E0.quest_desc: [
		"Legge quanto è pieno un contenitore e manda un segnale.",
		"Come: quarzo del Nether, torcia di redstone, pietra. Il quarzo si setaccia dalla sabbia delle anime; niente viaggio nel Nether."
	]
	quest.42000000001A03E0.title: "Comparatore (Tubi)"
	quest.42000000001A03E1.quest_desc: [
		"L'osservatore legge il ritmo.",
		"Come: ciottoli, redstone e quarzo del Nether."
	]
	quest.42000000001A03E1.title: "Linea di osservatori"
	quest.42000000001A03E2.quest_desc: [
		"Una fonte di segnale sempre accesa, o un invertitore accanto a una leva.",
		"Come: redstone sopra un bastone."
	]
	quest.42000000001A03E2.title: "Torcia di redstone"
	quest.42000000001A03E3.quest_desc: [
		"Il ripetitore temporizza il circuito.",
		"Come: torcia di redstone, redstone, pietra. Il capitolo dei tubi lo usa per gli orologi."
	]
	quest.42000000001A03E3.title: "Ripetitore (Tubi)"
	quest.42000000001A03E4.quest_desc: [
		"Colpito da un proiettile, manda un segnale secondo la forza.",
		"Come: redstone intorno al fieno. Il fieno è tre grani."
	]
	quest.42000000001A03E4.title: "Bersaglio"
	quest.42000000001A03E5.quest_desc: [
		"Legge il cielo e segnala in base alla luce o all'ora.",
		"Come: vetro, quarzo del Nether, lastre di legno."
	]
	quest.42000000001A03E5.title: "Sensore di luce diurna (Tubi)"
	quest.42000000001A03E6.quest_desc: [
		"Regge un libro e segnala quando si volta una pagina.",
		"Come: lastre di legno intorno a una libreria."
	]
	quest.42000000001A03E6.title: "Leggio (Tubi)"
	quest.42000000001A03E7.quest_desc: [
		"Segnala finché è aperto, come una cassa con un filo teso.",
		"Come: un gancio da inciampo più una cassa."
	]
	quest.42000000001A03E7.title: "Baule trappola"
	quest.42000000001A03E8.quest_desc: [
		"Carica un nastro o ne tira via gli oggetti, secondo il verso.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001A03E8.title: "Imbuto Create"
	quest.42000000001A03E9.quest_desc: [
		"Un imbuto che può filtrare ciò che muove.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001A03E9.title: "Imbuto di ottone"
	quest.42000000001A03EA.quest_desc: [
		"Fa cadere gli oggetti dritti in basso, tra un piano e l'altro.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001A03EA.title: "Scivolo (Tubi)"
	quest.42000000001A03EB.quest_desc: [
		"Uno scivolo che può filtrare gli oggetti e trattenerli.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001A03EB.title: "Scivolo intelligente"
	quest.42000000001A03EC.quest_desc: [
		"Smista e sposta gli oggetti, con priorità regolabile per lato.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000001A03EC.title: "Logistico Mek"
	quest.42000000001A03ED.quest_desc: [
		"Muove i fluidi con la pressione, così sale tanto facilmente quanto scende.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000001A03ED.title: "Tubo Mek"
	quest.42000000001A03EE.quest_desc: [
		"Porta l'energia tra le macchine, con diversi gradini di portata.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000001A03EE.title: "Cavo Mek"
	quest.42000000001A03EF.quest_desc: [
		"Muove sostanze chimiche e gas in una linea sigillata.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000001A03EF.title: "Condotto Mek"
	quest.42000000001A03F0.quest_desc: [
		"Una linea più veloce per spostare oggetti su una piattaforma indaffarata.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000001A03F0.title: "Trasportatore avanzato"
	quest.42000000001A03F1.quest_desc: [
		"Ancora più veloce, per una rete che ha superato le basi.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000001A03F1.title: "Trasportatore d'élite"
	quest.42000000001A03F2.quest_desc: [
		"La linea di oggetti più veloce che c'è, per una piattaforma al massimo.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000001A03F2.title: "Trasportatore definitivo"
	quest.42000000001A03F3.quest_desc: [
		"La linea di energia dalla portata più alta, per sale macchine pesanti.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000001A03F3.title: "Cavo definitivo"
	quest.42000000001B03F4.quest_desc: [
		"Elenca ogni spirito che puoi legare e ciò che gli serve.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: un libro e Semi del sogno del demone, senza forma. Leggilo; il Fuoco spirituale è il passo dopo."
	]
	quest.42000000001B03F4.title: "Dizionario degli spiriti"
	quest.42000000001B03F5.quest_desc: [
		"Brucia di viola e non si propaga mai. Serve ad accendere i rituali.",
		"Come: accendi il Fuoco spirituale come mostra il Dizionario degli spiriti (Brucia!), poi lascia cadere andesite dentro."
	]
	quest.42000000001B03F5.title: "Fuoco degli spiriti (Oltremondo)"
	quest.42000000001B03F6.quest_desc: [
		"Punta al minerale sepolto o alle strutture nascoste vicine.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03F6.title: "Divination Rod"
	quest.42000000001B03F7.quest_desc: [
		"Toglie il gesso rituale da terra quando hai finito.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03F7.title: "Spazzola"
	quest.42000000001B03F8.quest_desc: [
		"Cresce in un albero che non appartiene a questo mondo.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03F8.title: "Arboscello di legno dell'altro mondo"
	quest.42000000001B03F9.quest_desc: [
		"Legno di un albero estraneo, per i rituali di legame.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03F9.title: "Otherworld Log"
	quest.42000000001B03FA.quest_desc: [
		"Tiene un'offerta mentre si svolge un rituale di legame.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03FA.title: "Ciotola sacrificale"
	quest.42000000001B03FB.quest_desc: [
		"Una ciotola dorata che accelera il rituale in cui si usa.",
		"Come: oro intorno a una ciotola sacrificale. Il dizionario nomina il rito."
	]
	quest.42000000001B03FB.title: "Ciotola d'oro"
	quest.42000000001B03FC.quest_desc: [
		"Un contratto non firmato, in attesa del nome di uno spirito.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03FC.title: "Libro di legame vuoto"
	quest.42000000001B03FD.quest_desc: [
		"Lega la classe di spirito più debole, un buon primo tentativo.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03FD.title: "Libro di Foliot"
	quest.42000000001B03FE.quest_desc: [
		"Lega uno spirito di media forza, un lavoro più forte di un foliot.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03FE.title: "Libro di Djinni"
	quest.42000000001B03FF.quest_desc: [
		"Lega uno spirito feroce. Il rituale chiede più preparazione.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B03FF.title: "Libro di Afrit"
	quest.42000000001B0400.quest_desc: [
		"Lega lo spirito più forte del dizionario.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0400.title: "Libro di Marid"
	quest.42000000001B0401.quest_desc: [
		"Un focus che aiuta un rituale a tenere la sua forma.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0401.title: "Gemmma in sintonia con lo Spirito"
	quest.42000000001B0402.quest_desc: [
		"Minerale da oltre questo mondo, fuso in Iesnium.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0402.title: "Iesnium grezzo"
	quest.42000000001B0403.quest_desc: [
		"Un metallo che esiste solo dall'altra parte.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0403.title: "Lingotto di Iesnium"
	quest.42000000001B0404.quest_desc: [
		"Manda minatori spirituali legati nell'Oltremondo a scavare.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0404.title: "Mineshaft dimensionale"
	quest.42000000001B0405.quest_desc: [
		"Lo spirito più debole, messo a scavare sottoterra.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0405.title: "Minatore Foliot"
	quest.42000000001B0406.quest_desc: [
		"Collega i barattoli di deposito degli spiriti in un'unica rete ricercabile.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0406.title: "Controllore di deposito (Oltremondo)"
	quest.42000000001B0407.quest_desc: [
		"Attira certi spiriti verso un cerchio rituale.",
		"Come: setaccio, o ametista gemmante se coltivi una fila di geodi. Occultism vuole schegge."
	]
	quest.42000000001B0407.title: "Focalizzatore di ametista"
	quest.42000000001B0408.quest_desc: [
		"Si fonde per ciotole d'oro e altra attrezzatura rituale.",
		"Come: fondi oro grezzo / graniglia d'oro. Presa da setaccio più rara."
	]
	quest.42000000001B0408.title: "Scorta di lingotto d'oro"
	quest.42000000001B0409.quest_desc: [
		"Pagine bianche, pronte a diventare un libro di vincolo.",
		"Come: tre carte più cuoio. La carta è canna da zucchero."
	]
	quest.42000000001B0409.title: "Scorta di libri"
	quest.42000000001B040A.quest_desc: [
		"Colora il gesso rituale per segnare un cerchio di evocazione.",
		"Come: blu più rosso, o un fiore viola. Occultism lo vuole."
	]
	quest.42000000001B040A.title: "Tintura viola"
	quest.42000000001B040B.quest_desc: [
		"Colora il gesso rituale, un segno più semplice del viola.",
		"Come: polvere d'ossa in una griglia, o un fiore bianco."
	]
	quest.42000000001B040B.title: "Tintura bianca"
	quest.42000000001B040C.quest_desc: [
		"Colora il gesso rituale per un cerchio più scuro.",
		"Come: carbone di legna o una sacca d'inchiostro (carbone di legna più una bottiglia di vetro)."
	]
	quest.42000000001B040C.title: "Tintura nera"
	quest.42000000001B040D.quest_desc: [
		"Terreno rituale, con una superficie che i rituali sembrano gradire.",
		"Come: sabbia in un barile di Ex Deorum di acqua della strega. Le stanze di verruche della fortezza ne tengono un po'. Tre teschi sulla sabbia delle anime fanno un Wither."
	]
	quest.42000000001B040D.title: "Scorta di sabbia delle anime (Altro mondo)"
	quest.42000000001B040E.quest_desc: [
		"Uno strato di base per i rituali che tendono al fuoco.",
		"Come: il Nether qui è vuoto, non terreno. Versa lava in un barile di Ex Deorum di acqua della strega (un barile d'acqua sul micelio; le spore di micelio si setacciano dalla terra)."
	]
	quest.42000000001B040E.title: "Scorta di Netherrack (Altro mondo)"
	quest.42000000001B040F.quest_desc: [
		"Una cornice scura e stabile per un cerchio rituale.",
		"Come: acqua su una sorgente di lava (o lava sull'acqua). Tieni la sorgente di lava."
	]
	quest.42000000001B040F.title: "Scorta di ossidiana (Altro mondo)"
	quest.42000000001B0410.quest_desc: [
		"Un'offerta verso cui certi spiriti sono attratti.",
		"Come: endermen, o la bancarella dei Camminabordi a /clowder hub."
	]
	quest.42000000001B0410.title: "Scorta di perle di ender (Altro mondo)"
	quest.42000000001B0411.quest_desc: [
		"Un'offerta di grande valore per un rituale esigente.",
		"Come: setaccia la ghiaia con una maglia di ferro o meglio, oppure minerale di diamante nel Frantumatore d'eco."
	]
	quest.42000000001B0411.title: "Scorta di diamanti"
	quest.42000000001B0412.quest_desc: [
		"Un libro di vincolo con un foliot già sigillato dentro.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0412.title: "Libro vincolato di Foliot"
	quest.42000000001B0413.quest_desc: [
		"Un libro di vincolo con un djinni già sigillato dentro.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0413.title: "Libro vincolato di Djinni"
	quest.42000000001B0414.quest_desc: [
		"Un libro di vincolo con un afrit già sigillato dentro.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0414.title: "Libro vincolato di Afrit"
	quest.42000000001B0415.quest_desc: [
		"Un libro di vincolo con un marid già sigillato dentro.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0415.title: "Libro vincolato di Marid"
	quest.42000000001B0416.quest_desc: [
		"Un campione di vena, che vale la pena fondere quando ne trovi altri.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0416.title: "Minerale di Iesnium"
	quest.42000000001B0417.quest_desc: [
		"Un afrit mandato in profondità a scavare dove gli spiriti minori non andranno.",
		"Come: Dizionario degli spiriti, poi Fuoco degli spiriti e ciotole. Il capitolo Oltremondo nomina i riti."
	]
	quest.42000000001B0417.title: "Afrit minatore delle profondità"
	quest.42000000001C0418.quest_desc: [
		"Girala a mano finché nient'altro gira ancora.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0418.title: "Manovella (Orologeria)"
	quest.42000000001C0419.quest_desc: [
		"Porta la rotazione da una macchina alla successiva.",
		"Come: lega di andesite in una ricetta di taglio / fabbricazione, elencata in JEI."
	]
	quest.42000000001C0419.title: "Scorta di Alberi"
	quest.42000000001C041A.quest_desc: [
		"La ruota dentata morde l'Albero.",
		"Come: Albero + tavole."
	]
	quest.42000000001C041A.title: "Scorta di ruote dentate"
	quest.42000000001C041B.quest_desc: [
		"Ingrana di sbieco e cambia la velocità di rotazione.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C041B.title: "Grande ruota dentata (Orologeria)"
	quest.42000000001C041C.quest_desc: [
		"Porta la rotazione dietro l'angolo senza perdere velocità.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C041C.title: "Scatola degli ingranaggi (Orologeria)"
	quest.42000000001C041D.quest_desc: [
		"Inserisci una modalità della macchina.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C041D.title: "Frizione (Orologeria)"
	quest.42000000001C041E.quest_desc: [
		"Inverte il senso di rotazione con un impulso di redstone.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C041E.title: "Cambio (Orologeria)"
	quest.42000000001C041F.quest_desc: [
		"Manda la rotazione lontano, senza un muro di Alberi.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C041F.title: "Trasmissione a catena"
	quest.42000000001C0420.quest_desc: [
		"Una trasmissione a catena che può invertirsi o fermarsi a comando.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0420.title: "Catena regolabile"
	quest.42000000001C0421.quest_desc: [
		"Gira con l'acqua che cade, lenta ma costante.",
		"Come: otto tavole intorno a un Albero. Serve un flusso d'acqua accanto."
	]
	quest.42000000001C0421.title: "Ruota ad acqua (Orologeria)"
	quest.42000000001C0422.quest_desc: [
		"Ruota più grande, più coppia dalla stessa corrente.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0422.title: "Ruota grande"
	quest.42000000001C0423.quest_desc: [
		"Trasforma le vele in rotazione, vento della piattaforma incluso.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0423.title: "Supporto del mulino a vento (Orologeria)"
	quest.42000000001C0424.quest_desc: [
		"Ruota intere strutture costruite sopra.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0424.title: "Supporto meccanico (Orologeria)"
	quest.42000000001C0425.quest_desc: [
		"Ruota una struttura a orari fissi, come una lancetta.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0425.title: "Supporto per orologi"
	quest.42000000001C0426.quest_desc: [
		"Converte il vapore della caldaia in rotazione costante.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0426.title: "Motore a vapore"
	quest.42000000001C0427.quest_desc: [
		"Sfoga la pressione in eccesso con un suono che senti su tutta la piattaforma.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0427.title: "Fischio a vapore"
	quest.42000000001C0428.quest_desc: [
		"Scalda le vasche abbastanza per l'altoforno e le pozioni.",
		"Come: fabbrica un bruciatore di blaze vuoto, poi usalo su un blaze di una fortezza del Nether, dopo l'ossidiana di Artiglio."
	]
	quest.42000000001C0428.title: "Inceneritore a blaze"
	quest.42000000001C0429.quest_desc: [
		"Raccoglie ciò che ci cade dentro, per mescolare o pressare.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0429.title: "Vasca (Orologeria)"
	quest.42000000001C042A.quest_desc: [
		"Mescola ricette in grande, in fretta.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C042A.title: "Miscelatore meccanico (Orologeria)"
	quest.42000000001C042B.quest_desc: [
		"Pressa i lingotti in lastre e compatta bene ciò che c'è in una vasca.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C042B.title: "Pressa meccanica (Orologeria)"
	quest.42000000001C042C.quest_desc: [
		"Lavoro da mola o da mulino.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C042C.title: "Macina (Orologeria)"
	quest.42000000001C042D.quest_desc: [
		"Due ruote che girano una contro l'altra, il minerale in mezzo.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C042D.title: "Ruota frantumatrice"
	quest.42000000001C042E.quest_desc: [
		"Ventola per lavare e asciugare.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C042E.title: "Ventola rivestita (Orologeria)"
	quest.42000000001C042F.quest_desc: [
		"Rimesta una vasca dall'alto, senza mani.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C042F.title: "Frusta (Orologeria)"
	quest.42000000001C0430.quest_desc: [
		"Soffia via oggetti e creature quando gira abbastanza forte.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0430.title: "Elica (Orologeria)"
	quest.42000000001C0431.quest_desc: [
		"Tiene un solo oggetto, così le macchine ci lavorano.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0431.title: "Deposito (Orologeria)"
	quest.42000000001C0432.quest_desc: [
		"Muove gli oggetti alla velocità che l'Albero gli dà.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0432.title: "Nastro"
	quest.42000000001C0433.quest_desc: [
		"Carica o scarica un nastro, in un solo verso per volta.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0433.title: "Imbuto di andesite"
	quest.42000000001C0434.quest_desc: [
		"Filtra ciò che muove, per oggetto e per quantità.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0434.title: "Imbuto d'ottone (Orologeria)"
	quest.42000000001C0435.quest_desc: [
		"Fa cadere gli oggetti dritti in basso, tra un piano e l'altro.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0435.title: "Linea di scivoli"
	quest.42000000001C0436.quest_desc: [
		"Filtra ciò che ci cade attraverso.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0436.title: "Scivolo intelligente (Orologeria)"
	quest.42000000001C0437.quest_desc: [
		"Porta il liquido dove la pompa lo spinge.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0437.title: "Tubo per fluidi (Orologeria)"
	quest.42000000001C0438.quest_desc: [
		"Filtra quale fluido passa.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001C0438.title: "Tubo per fluidi intelligente"
