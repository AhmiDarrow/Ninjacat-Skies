	chapter.310000000000002B.chapter_subtitle: [
		"Pezzi del vecchio mondo risalgono alla deriva fino alla tua piattaforma. Raggiungili prima che si disfino."
	]
	chapter.310000000000002B.title: "Relitti alla deriva"
	quest.42000000002B0801.quest_desc: [
		"Quando Terra è in tensione, pezzi del vecchio mondo risalgono ogni tanto fino alla tua piattaforma e si impigliano nella tua trama. Il custode avvisa tutto il Clowder quando uno arriva.",
		"Non restano: un relitto regge per un po' del tempo online del tuo Clowder, poi si disfa tornando nel vuoto. Nessuno cade, e niente di ciò che hai guadagnato va perso."
	]
	quest.42000000002B0801.title: "Qualcosa alla deriva"
	quest.42000000002B0802.quest_desc: [
		"Mettiti sul bordo della tua piattaforma, guarda il relitto e usa un Rocchetto di ormeggio: un ponte di filo si stende da solo, salendo a mezzi passi.",
		"Cadi e il filo ti prende, per tre cuori. Il vuoto è lo scenario, non la punizione."
	]
	quest.42000000002B0802.title: "Attraversa il vuoto"
	quest.42000000002B0803.quest_desc: [
		"Ogni relitto chiede una cosa: apri la cassa del cuore, rompi i generatori, reinfila i pilastri, accompagna un'eco a casa, o tieni la cucitura.",
		"Finiscilo e chiunque ci metta piede riceve Trama recuperata e un Sigillo. Il Telaio del recuperatore trasforma la trama in rocchetti, esche, chiavi e decorazioni."
	]
	quest.42000000002B0803.title: "Recupero"
	quest.42000000002B0804.quest_desc: [
		"L'Atlante dei relitti tiene i luoghi di ogni tribù che hai finito: nove Fili per sei tipi di luogo. Una colonna piena, una riga piena, tutti i timbri: ognuno dà un piccolo vantaggio permanente.",
		"Le pagine arrivano con il racconto nel Codice. Le pagine di indizio trovate nei bauli aprono stanze nascoste. Apri l'Atlante dei relitti per spuntare questo."
	]
	quest.42000000002B0804.title: "L'Atlante"
	quest.42000000002B0805.quest_desc: [
		"Porta cinque Sigilli del relitto: cinque relitti finiti, da chiunque nel tuo Clowder.",
		"Ripetibile: consegnali tutte le volte che vuoi.",
		"Come: finisci il compito di un relitto alla deriva. Chiunque ci metta piede riceve un Sigillo."
	]
	quest.42000000002B0805.title: "Cinque sigilli"
	quest.42000000002B0806.quest_desc: [
		"Rompi tre generatori sfilacciati e consegna i loro nuclei.",
		"Ripetibile: consegnali tutte le volte che vuoi.",
		"Come: rompi un generatore sfilacciato su un relitto alla deriva; ognuno lascia cadere il suo nucleo."
	]
	quest.42000000002B0806.title: "Nuclei sfilacciati"
	quest.42000000002B0807.quest_desc: [
		"Una scheggia di un Residuo rammendato. Consegnala.",
		"Ripetibile: consegnali tutte le volte che vuoi.",
		"Come: apri la fenditura sigillata di una Rocca con una Chiave di trama e rammenda il Residuo dentro."
	]
	quest.42000000002B0807.title: "Scheggia di frattura"
	quest.42000000002B0808.quest_desc: [
		"Ogni nucleo di un Filo. Le esche di quella tribù costano la metà, i suoi relitti arrivano un po' più spesso, e il suo stendardo è tuo."
	]
	quest.42000000002B0808.title: "Una colonna intera"
	quest.42000000002B0809.quest_desc: [
		"Un tipo di luogo in tutte e nove le tribù. Le sue stanze nascoste restano sempre aperte."
	]
	quest.42000000002B0809.title: "Una riga intera"
	quest.42000000002B080A.quest_desc: [
		"Completa un relitto di ogni modificatore. I tuoi relitti resistono un quarto in più."
	]
	quest.42000000002B080A.title: "Sei timbri"
	quest.42000000002B080B.quest_desc: [
		"Venticinque pagine riempite."
	]
	quest.42000000002B080B.title: "Metà dell'Atlante"
	quest.42000000002B080C.quest_desc: [
		"Una Chiave di trama tagliata per il Filo di quel relitto apre la fenditura sigillata di una Rocca. Dentro, qualcosa di piccolo e sfilacciato veste la forma di un Guardiano."
	]
	quest.42000000002B080C.title: "Nella fenditura"
	quest.42000000002B080D.quest_desc: [
		"Rammenda tutti e nove i Residui. Le Chiavi di trama costano la metà."
	]
	quest.42000000002B080D.title: "Tutti i Residui"
	quest.42000000002B080E.quest_desc: [
		"Tutte le cinquantaquattro pagine. Da qualche parte sotto gli Skies, il cuore del vecchio mondo inizia a derivare verso di te."
	]
	quest.42000000002B080E.title: "Ogni pagina"
	quest.42000000002B080F.quest_desc: [
		"Stai nel cuore del vecchio mondo e reinfilalo. Non viene due volte."
	]
	quest.42000000002B080F.title: "Cuore del tessuto"
}
