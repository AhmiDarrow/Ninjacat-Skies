{
	chapter.3100000000000001.chapter_subtitle: [
		"Svegliati — sopravvivi, reclama la piattaforma, lascia che il Codice si svegli."
	]
	chapter.3100000000000001.title: "Filo: Terra"
	chapter.3100000000000002.chapter_subtitle: [
		"Recupera — riporta il mondo caduto nella materia."
	]
	chapter.3100000000000002.title: "Filo: Pietra"
	chapter.3100000000000003.chapter_subtitle: [
		"Radica — fai crescere ancore, così la piattaforma smette di sfilacciarsi."
	]
	chapter.3100000000000003.title: "Filo: Germoglio"
	chapter.3100000000000004.chapter_subtitle: [
		"Orlo — equipaggiati e lascia la piattaforma di proposito."
	]
	chapter.3100000000000004.title: "Filo: Artiglio"
	chapter.3100000000000005.chapter_subtitle: [
		"Ronza — ritmo e pulso prima dei fili."
	]
	chapter.3100000000000005.title: "Filo: Scintilla"
	chapter.3100000000000006.chapter_subtitle: [
		"Motivo — una fabbrica come un canto che si porta da solo."
	]
	chapter.3100000000000006.title: "Filo: Orologio"
	chapter.3100000000000007.chapter_subtitle: [
		"Colonia — tieni in vita qualcosa che tiene in vita qualcos'altro."
	]
	chapter.3100000000000007.title: "Filo: Sciame"
	chapter.3100000000000008.chapter_subtitle: [
		"Lega — sigilli, riti e due sentieri di treccia in un cordone."
	]
	chapter.3100000000000008.title: "Filo: Sigillo"
	chapter.3100000000000009.chapter_subtitle: [
		"Ritessi — il telaio digitale, la Marca, il Frammento."
	]
	chapter.3100000000000009.title: "Filo: Fuso"
	chapter.310000000000000A.title: "Setaccio profondo"
	chapter.310000000000000B.title: "Stoccaggio e zaini"
	chapter.310000000000000C.title: "Officine Mekanism"
	chapter.310000000000000D.title: "Rete Powah"
	chapter.310000000000000E.title: "Lato arcano"
	chapter.310000000000000F.chapter_subtitle: [
		"Squadre, la Sala, il Palo e lo Sfilaccio."
	]
	chapter.310000000000000F.title: "Sala Clowder"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Linea di cucina"
	chapter.3100000000000013.title: "Incantesimi da battaglia"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Decorazione della piattaforma"
	chapter.3100000000000016.title: "Appoggio nel Nether"
	chapter.3100000000000017.title: "Appoggio nell'End"
	chapter.3100000000000018.title: "Campi di essenza"
	chapter.3100000000000019.chapter_subtitle: [
		"Ogni nido è un anello di qualcosa intorno a un fiore."
	]
	chapter.3100000000000019.title: "Apiario dello Sciame"
	chapter.310000000000001A.title: "Tubature"
	chapter.310000000000001B.title: "Altro mondo"
	chapter.310000000000001C.title: "Orologeria profonda"
	chapter.310000000000001D.title: "Rete del Fuso"
	chapter.310000000000001E.title: "Arte del vuoto"
	chapter.310000000000001F.title: "Linee confezionate"
	chapter.3100000000000020.title: "QIO e la cima Mek"
	chapter.3100000000000021.title: "Caccia e fattoria"
	chapter.3100000000000022.title: "Tessitura tribale"
	chapter.3100000000000023.chapter_subtitle: [
		"I Cantori di ghiaia tagliano una pietra in cento modi."
	]
	chapter.3100000000000023.title: "Scalpellino"
	chapter.3100000000000024.chapter_subtitle: [
		"Una piattaforma è un cornicione finché qualcuno non ci mette una sedia."
	]
	chapter.3100000000000024.title: "Arredi"
	chapter.3100000000000025.chapter_subtitle: [
		"Le piccole macchine che i custodi hanno lasciato."
	]
	chapter.3100000000000025.title: "Piccole custodie"
	chapter.3100000000000026.chapter_subtitle: [
		"Il pulso dei Cuori di tamburo impara a correre nel rame."
	]
	chapter.3100000000000026.title: "La corrente"
	chapter.3100000000000027.chapter_subtitle: [
		"Il Taglio ha spezzato tredici guardiani. Rimetti in tensione ogni Filo battendo il suo guardiano."
	]
	chapter.3100000000000027.title: "Guardiani spezzati"
	chapter.3100000000000028.chapter_subtitle: [
		"Cammina la Marca. Doma un giallo. Esther aspetta nella Sala dopo che ci sei stato."
	]
	chapter.3100000000000028.title: "Corridori di piattaforma"
	chapter.3100000000000029.chapter_subtitle: [
		"Orti dal setaccio. Cucina ciò che una piattaforma del vuoto non ha mai fatto crescere."
	]
	chapter.3100000000000029.title: "Tavola del raccolto"
	chapter.310000000000002A.chapter_subtitle: [
		"Bastoni da coltura, statistiche, irrigazione. Su una cengia le erbacce non attecchiscono."
	]
	chapter.310000000000002A.title: "Bastoni da coltura"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Fabbricare e tensione"
	chapter_group.2100000000000003.title: "Ritessere"
	chapter_group.2100000000000004.title: "Sentieri laterali"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"Ti sei svegliato su una cengia. Guarda il vuoto, poi clicca qui.",
		"L'accento grave (`) è la lista degli incarichi. Il Codice dei Baffi è Inizia qui.",
		"Come: clicca la missione. Poi colpisci la quercia."
	]
	quest.4200000000018001.title: "Guarda il vuoto"
	quest.4200000000010001.quest_desc: [
		"Sei Skybound. Questo è ciò che non è caduto.",
		"Otto tronchi. Inizia dall'albero; è lui che ha iniziato con te.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: colpisci la quercia sulla tua piattaforma. Otto tronchi avviano Risveglio."
	]
	quest.4200000000010001.title: "Risveglio su una piattaforma"
	quest.4200000000010002.quest_desc: [
		"La terra è una promessa che la piattaforma fa ai tuoi stivali.",
		"Sedici blocchi. Allarga la promessa.",
		"Come: cassa iniziale, scarico ciottoli+filo, avanzi del setaccio, o /clowder hub (Custodi della piattaforma)."
	]
	quest.4200000000010002.title: "Qualcosa su cui stare"
	quest.4200000000010003.quest_desc: [
		"Le mani hanno bisogno di una superficie. Tutto quello che viene dopo è una superficie.",
		"Come: quattro assi in un quadrato."
	]
	quest.4200000000010003.title: "Fai un banco da lavoro"
	quest.4200000000010004.quest_desc: [
		"Artiglio arriva dopo. Per ora, legno che morde.",
		"Come: tre assi sopra due bastoni."
	]
	quest.4200000000010004.title: "Piccone di legno"
	quest.4200000000010005.quest_desc: [
		"Verde contro il vuoto.",
		"Piantalo prima di avere fame.",
		"Come: rompi foglie di quercia, o /clowder hub Legaradici (8 Filo per quattro)."
	]
	quest.4200000000010005.title: "Prima piantina"
	quest.4200000000010006.quest_desc: [
		"Sessantaquattro assi sono una piattaforma che smette di sembrare una cengia.",
		"Come: un tronco nella griglia di fabbricazione ne fa quattro."
	]
	quest.4200000000010006.title: "Scorta di assi"
	quest.4200000000010007.quest_desc: [
		"Manici, telai, le ossa degli attrezzi.",
		"Come: due assi in una colonna."
	]
	quest.4200000000010007.title: "Fascio di bastoni"
	quest.4200000000010008.quest_desc: [
		"Metti le cose dove restano. Un Clowder condivide una cassa prima di condividere qualsiasi altra cosa.",
		"Come: otto assi intorno a un centro vuoto."
	]
	quest.4200000000010008.title: "Cassa per il Clowder"
	quest.4200000000010009.quest_desc: [
		"Vedi il bordo prima che il bordo veda te.",
		"Come: carbone o carbone di legna sopra un bastone. I Parenti a /clowder hub vendono un pacco."
	]
	quest.4200000000010009.title: "Linea di torce"
	quest.420000000001000A.quest_desc: [
		"Ghiaccio e lava fanno pietra dove non ce n'era.",
		"Le piattaforme Normale e Difficile portano entrambi. I Custodi della piattaforma a /clowder hub vendono un secchio.",
		"Come: lava accanto all'acqua (o ghiaccio fuso). Martella la pietra. La bancarella dei Cantori di ghiaia a /clowder hub vende un fascio."
	]
	quest.420000000001000A.title: "Scorta di ciottoli"
	quest.420000000001000B.quest_desc: [
		"Calore che non è ancora Scintilla.",
		"I Custodi della piattaforma avrebbero chiamato questo un focolare.",
		"Come: otto ciottoli intorno a un centro vuoto."
	]
	quest.420000000001000B.title: "Calore della fornace"
	quest.420000000001000C.quest_desc: [
		"La fame è un vuoto morbido. Otto pagnotte lo chiudono per un po'.",
		"Come: tre grani in fila, o /clowder hub Custode del focolare."
	]
	quest.420000000001000C.title: "Cuoci un pasto"
	quest.420000000001000D.quest_desc: [
		"Piazza la lava, fondi il ghiaccio in una sorgente, riempi il secchio.",
		"Facile porta l'acqua; Normale e Difficile portano i pezzi.",
		"Come: secchio vuoto su una sorgente d'acqua. Normale/Difficile: piazza la lava, fondi il ghiaccio, riempi."
	]
	quest.420000000001000D.title: "Prendi la pioggia"
	quest.420000000001000E.quest_desc: [
		"Scarti del Telaio che tengono ancora. Ogni missione ne rende un po'.",
		"Sfilane uno per lo spago, o spendili alle bancarelle dei Parenti in /clowder hub.",
		"Come: ricompense delle missioni, terra con maglia di selce su una Cornice del telaio, scorte del custode."
	]
	quest.420000000001000E.title: "Valuta sfilacciata"
	quest.420000000001000F.quest_desc: [
		"Danneggiato, ma insegna ancora. Apri Inizia qui.",
		"Clic destro sul libro e apri Inizia qui. Accento grave (`): la lista degli incarichi.",
		"Come: kit iniziale / cassa del molo. Clic destro sul libro; l'accento grave (`) è la lista degli incarichi."
	]
	quest.420000000001000F.title: "Codice in mano"
	quest.4200000000010010.quest_desc: [
		"Imposta un punto di rinascita.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010010.title: "Letto rivendicato"
	quest.4200000000010011.quest_desc: [
		"Scendi nelle profondità senza una fune. Abbastanza economica da lasciarne una in ogni pozzo.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010011.title: "Scala in giù"
	quest.4200000000010012.quest_desc: [
		"Seta di ragno messa da parte per maglie future. Ogni fibra prima o poi serve.",
		"Come: sfilaccia il Filo sfilacciato (1 → 3). Ragni. Lanugine del telaio su una Legatura d'eco. Scarico inverso del filato."
	]
	quest.4200000000010012.title: "Scorta di spago"
	quest.4200000000010013.quest_desc: [
		"Accelera il verde.",
		"Come: ossa in una griglia, oppure scarico di Filo + carne marcia, o /clowder hub Custodi della piattaforma."
	]
	quest.4200000000010013.title: "Scorta di farina d'ossa"
	quest.4200000000010014.quest_desc: [
		"Allarga la piattaforma.",
		"Come: cassa iniziale, scarico ciottoli+filo, avanzi del setaccio, o /clowder hub (Custodi della piattaforma)."
	]
	quest.4200000000010014.title: "Piattaforma di terra"
	quest.4200000000010015.quest_desc: [
		"Potale ora, compostale dopo. Su una piattaforma non si spreca nulla.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010015.title: "Foglie di quercia"
	quest.4200000000010016.quest_desc: [
		"Un angolo quieto.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010016.title: "Vaso da fiori"
	quest.4200000000010017.quest_desc: [
		"Il barile di Ex Deorum: compost, e acqua in argilla per la via lenta.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010017.title: "Barile"
	quest.4200000000010018.quest_desc: [
		"Scarto in farina.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010018.title: "Compostiera"
	quest.4200000000010019.quest_desc: [
		"Traccia un solco.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010019.title: "Zappa di legno"
	quest.420000000001001A.quest_desc: [
		"Abbatte i tronchi più in fretta delle mani nude. Il primo vero attrezzo che uno Skybound possiede.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001001A.title: "Ascia di legno"
	quest.420000000001001B.quest_desc: [
		"Trasforma terra e ghiaia in terreno libero. Lenta, ma funziona.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001001B.title: "Pala di legno"
	quest.420000000001001C.quest_desc: [
		"Ferma a malapena uno zombie, ma ne ferma uno. Meglio che menare un pugno.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001001C.title: "Spada di legno"
	quest.420000000001001D.quest_desc: [
		"Tiene zuppa, stufato e poco altro. Vasellame semplice per una piattaforma semplice.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001001D.title: "Ciotola"
	quest.420000000001001E.quest_desc: [
		"Etichetta la piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001001E.title: "Cornice"
	quest.420000000001001F.quest_desc: [
		"Fanne una casa.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001001F.title: "Dipinto"
	quest.4200000000010020.quest_desc: [
		"Tiene il vento e i mostri dal lato giusto del muro.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010020.title: "Porta di quercia"
	quest.4200000000010021.quest_desc: [
		"Segna un bordo senza chiudere la vista. Comoda dove la caduta è vera.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010021.title: "Staccionata di quercia"
	quest.4200000000010022.quest_desc: [
		"Trasforma un muro a picco in qualcosa che puoi davvero scalare.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010022.title: "Scalini di quercia"
	quest.4200000000010023.quest_desc: [
		"Mezzo blocco, il doppio di pavimenti possibili. Utile negli spazi stretti.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010023.title: "Lastra di quercia"
	quest.4200000000010024.quest_desc: [
		"Botole d'accesso.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010024.title: "Botola di quercia"
	quest.4200000000010025.quest_desc: [
		"Manda un segnale quando qualcosa ci sale. Le porte si aprono da sole.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010025.title: "Pedana a pressione di quercia"
	quest.4200000000010026.quest_desc: [
		"Pulsante per tocchi di redstone.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010026.title: "Pulsante di quercia"
	quest.4200000000010027.quest_desc: [
		"Recinta il bordo della piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010027.title: "Cancelletto di bastoni"
	quest.4200000000010028.quest_desc: [
		"Cucina piano e tiene il fumo visibile per miglia.",
		"Come: tronchi, bastoni e carbone o carbone di legna."
	]
	quest.4200000000010028.title: "Falò"
	quest.4200000000010029.quest_desc: [
		"Appende luce dove una torcia stonerebbe. Bagliore più caldo, stesso lavoro.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010029.title: "Lanterna"
	quest.420000000001002A.quest_desc: [
		"Brucia di un azzurro pallido e tiene lontana la maggior parte delle cose.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001002A.title: "Lanterna delle anime"
	quest.420000000001002B.quest_desc: [
		"Sale con te e svanisce quando lo tiri. Costruire in alto smette di fare paura.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001002B.title: "Impalcatura"
	quest.420000000001002C.quest_desc: [
		"Catena per un tocco appeso.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001002C.title: "Catena"
	quest.420000000001002D.quest_desc: [
		"Metti il bordo in gabbia.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001002D.title: "Sbarre di ferro"
	quest.420000000001002E.quest_desc: [
		"Vetro per le finestre della piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001002E.title: "Lastra di vetro"
	quest.420000000001002F.quest_desc: [
		"Morbida, infiammabile e facile da tingere. Ogni piattaforma prima o poi ha bisogno di un letto.",
		"Come: tosa le pecore dopo aver dato l'erba, oppure quattro spaghi."
	]
	quest.420000000001002F.title: "Lana bianca"
	quest.4200000000010030.quest_desc: [
		"Uno strato sottile di lana per i pavimenti che non hanno bisogno di un blocco intero.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010030.title: "Tappeto bianco"
	quest.4200000000010031.quest_desc: [
		"Porta un po' di verde e di rosa su una piattaforma di ghiaia.",
		"Come: muschio più quercia, oppure farina d'ossa sul muschio. Le api accettano il fiore."
	]
	quest.4200000000010031.title: "Azalea in fiore"
	quest.4200000000010032.quest_desc: [
		"Si allarga piano e addolcisce l'aspetto delle piattaforme di pietra grezza.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010032.title: "Blocco di muschio"
	quest.4200000000010033.quest_desc: [
		"Radici pendenti sotto la piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010033.title: "Radici pendenti"
	quest.4200000000010034.quest_desc: [
		"Si aggrappa ai muri e li illumina senza una sola torcia.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010034.title: "Lichene luminoso"
	quest.4200000000010035.quest_desc: [
		"Speleotema per un tocco appuntito.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010035.title: "Speleotema appuntito"
	quest.4200000000010036.quest_desc: [
		"Ametista in un blocco. Sigillo vorrà schegge più avanti.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010036.title: "Blocco di ametista"
	quest.4200000000010037.quest_desc: [
		"Nove lingotti pressati insieme. Diventa verde se lo lasci fuori.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010037.title: "Blocco di rame"
	quest.4200000000010038.quest_desc: [
		"Nove pezzi di ferro grezzo impilati stretti, in attesa di una fornace.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010038.title: "Blocco di ferro grezzo"
	quest.4200000000010039.quest_desc: [
		"Brucia molto più a lungo del carbone sfuso. Alimenta la fornace e vattene.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000010039.title: "Blocco di carbone"
	quest.420000000001003A.quest_desc: [
		"Nutre gli animali e rallenta una caduta. I contadini lo tengono vicino per entrambe le cose.",
		"Come: nove frumenti. Tre frumenti fanno anche il pane."
	]
	quest.420000000001003A.title: "Balla di fieno"
	quest.420000000001003B.quest_desc: [
		"Nove alghe pressate in combustibile. Fonde più di quanto sembri.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001003B.title: "Blocco di alghe essiccate"
	quest.420000000001003C.quest_desc: [
		"Carta e cuoio, in attesa di diventare qualcosa con una ricetta.",
		"Come: tre carte più cuoio. La carta è canna da zucchero."
	]
	quest.420000000001003C.title: "Libro"
	quest.420000000001003D.quest_desc: [
		"Carta per libri e mappe.",
		"Come: tre canne da zucchero in fila. La canna viene setacciando terra con una maglia di selce o meglio."
	]
	quest.420000000001003D.title: "Carta"
	quest.420000000001003E.quest_desc: [
		"La tintura e i libri hanno bisogno di inchiostro.",
		"Come: carbone di legna più una bottiglia di vetro. I calamari non compaiono mai qui."
	]
	quest.420000000001003E.title: "Sacca d'inchiostro"
	quest.420000000001003F.quest_desc: [
		"Piume per frecce e libri.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000001003F.title: "Piuma"
	quest.4200000000010040.quest_desc: [
		"Cuoio per libri e kit.",
		"Come: fondi la carne marcia o cuocila al falò. Setaccia la terra con una maglia di selce. /clowder hub I Custodi della piattaforma ne vendono due per 18 Filo."
	]
	quest.4200000000010040.title: "Cuoio"
	quest.4200000000010041.quest_desc: [
		"Banco, alberello, focolare, acqua, Codice. La piattaforma regge.",
		"Tendi il Filo: i Custodi della piattaforma rispondono, e il gettone è tuo da incastonare.",
		"Reclamalo e scegli un dono della tribù: un Filo del Ritorno per una vita condivisa in più, oppure scorte.",
		"Come: finisci le missioni collegate a questa, poi reclamala per il gettone di Filo. Incastona il gettone al tuo Palo di tensione."
	]
	quest.4200000000010041.quest_subtitle: "Risveglio"
	quest.4200000000010041.title: "Nodo di Terra"
	quest.4200000000010042.quest_desc: [
		"Clic destro sul Palo di tensione del tuo Clowder con il gettone.",
		"La tacca si accende, la tribù rintocca, la piattaforma cambia.",
		"Come: clic destro sul tuo Palo di tensione con il gettone di Filo in mano."
	]
	quest.4200000000010042.title: "Incastona Terra"
	quest.4200000000010043.quest_desc: [
		"Uno zombie su una piattaforma senza grotte. Il vuoto porge i suoi saluti.",
		"Illumina i bordi.",
		"Come: uccidi uno zombie sulla piattaforma di notte. Illumina i bordi."
	]
	quest.4200000000010043.title: "È saltato fuori qualcosa"
	quest.4200000000020044.quest_desc: [
		"Filo che ricorda da dove è venuto.",
		"Sfila il Filo in spago; quattro spaghi filano due filati.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: quattro spaghi → due filati. Barile di tensione: spago + perla. Quattro Lanugini del telaio."
	]
	quest.4200000000020044.title: "Tira il Filato del vuoto"
	quest.4200000000020045.quest_desc: [
		"Ciottoli e bastoni. Rompi la graniglia caduta in ghiaia, sabbia e polvere.",
		"Come: ciottoli + bastoni. Rompi la graniglia in ghiaia, sabbia e polvere."
	]
	quest.4200000000020045.title: "Martello a fuso"
	quest.4200000000020046.quest_desc: [
		"Spago intorno al filato. Prende ciò che il Telaio ha lasciato cadere — e pettina la Lanugine del telaio fuori dalla terra.",
		"Come: spago intorno al filato. La bancarella dei Cantori di ghiaia ne vende una."
	]
	quest.4200000000020046.title: "Infila la maglia"
	quest.4200000000020047.quest_desc: [
		"Versa l'acqua; il secchio torna subito. Aggiungi terra. Aspetta l'argilla.",
		"Spago e una perla nello stesso barile fanno filato.",
		"Come: assi, spago e Filato del vuoto. Versa l'acqua (il secchio torna), aggiungi terra → argilla."
	]
	quest.4200000000020047.title: "Barile di tensione"
	quest.4200000000020048.quest_desc: [
		"Sedici argille dal barile. Carica otto terre alla volta.",
		"Come: Barile di tensione — acqua + terra. Il Frantumatore d'eco martella la sabbia in argilla."
	]
	quest.4200000000020048.title: "Tasca d'argilla"
	quest.4200000000020049.quest_desc: [
		"Argilla e farina d'ossa. Forma il secchio non cotto.",
		"Come: palla d'argilla + farina d'ossa, senza forma. L'argilla viene dal Barile di tensione."
	]
	quest.4200000000020049.title: "Argilla di porcellana"
	quest.420000000002004A.quest_desc: [
		"Fondilo. La porcellana porta la lava dove il ferro è ancora una voce.",
		"Come: forma l'argilla di porcellana in un secchio non cotto, poi fondilo."
	]
	quest.420000000002004A.title: "Attrezzo di porcellana"
	quest.420000000002004B.quest_desc: [
		"I Cantori di ghiaia chiamavano ogni scheggia dal suo eco.",
		"Setaccia finché non senti il ferro.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.420000000002004B.title: "Setaccia la graniglia caduta"
	quest.420000000002004C.quest_desc: [
		"Una scorta di colpi.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.420000000002004C.title: "Wooden Hammer"
	quest.420000000002004D.quest_desc: [
		"Materia dalla graniglia. Sessantaquattro pietre che un'ora fa erano polvere.",
		"Come: lava accanto all'acqua (o ghiaccio fuso). Martella la pietra. La bancarella dei Cantori di ghiaia a /clowder hub vende un fascio."
	]
	quest.420000000002004D.title: "Sassolini"
	quest.420000000002004E.quest_desc: [
		"La polvere del Telaio aspetta nella ghiaia. Anche la selce.",
		"Come: martella i ciottoli (Martello a fuso o Frantumatore d'eco)."
	]
	quest.420000000002004E.title: "Via di ghiaia"
	quest.420000000002004F.quest_desc: [
		"Graniglia fine. Il vetro più tardi, e la presa migliore della maglia di ferro.",
		"Come: martella la ghiaia."
	]
	quest.420000000002004F.title: "Scorta di sabbia"
	quest.4200000000020050.quest_desc: [
		"Cenere del mondo caduto. Redstone e polvere da sparo vi si nascondono.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.4200000000020050.title: "Mucchio di polvere"
	quest.4200000000020051.quest_desc: [
		"Filato intorno allo slime. Il compost della piattaforma fa lo slime.",
		"Il Nodo è la soglia morbida del Telaio; tienine due.",
		"Come: anello di Filato del vuoto intorno a una palla di slime."
	]
	quest.4200000000020051.title: "Lega un Nodo legante"
	quest.4200000000020052.quest_desc: [
		"Assi intorno a un Nodo. Tendi una maglia, carica la graniglia e lasciala lavorare.",
		"Le tramogge la alimentano. È la prima macchina della piattaforma.",
		"Come: assi intorno a un Nodo legante. Tendi una maglia, versa la graniglia con una tramoggia, posala su una tramoggia."
	]
	quest.4200000000020052.title: "Alza la Cornice del telaio"
	quest.4200000000020053.quest_desc: [
		"Il ferro è basso e paziente. Otto frammenti dalla maglia.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.4200000000020053.title: "Iron Ore Chunk"
	quest.4200000000020054.quest_desc: [
		"Setacciato dalla ghiaia, poco a poco. La maglia trova il rame prima dei tuoi occhi.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.4200000000020054.title: "Copper Ore Chunk"
	quest.4200000000020055.quest_desc: [
		"L'oro si disturba appena a rispondere. Quattro bastano.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.4200000000020055.title: "Gold Ore Chunk"
	quest.4200000000020056.quest_desc: [
		"Alimenta la linea.",
		"Come: setaccia la ghiaia, oppure fondi minerale di carbone."
	]
	quest.4200000000020056.title: "Carbone"
	quest.4200000000020057.quest_desc: [
		"Dai frammenti al grezzo. Continua a fondere.",
		"Come: setaccia la ghiaia per frammenti di minerale di ferro; quattro fanno un blocco di minerale di ferro, e minarlo lascia ferro grezzo."
	]
	quest.4200000000020057.title: "Ferro grezzo"
	quest.4200000000020058.quest_desc: [
		"Recupero paga. Sedici lingotti che il vuoto non voleva farti avere.",
		"Come: fondi ferro grezzo / graniglia di ferro (fornace o Forno di braci). Setaccia la ghiaia per i pezzi."
	]
	quest.4200000000020058.title: "Lingotto di ferro"
	quest.4200000000020059.quest_desc: [
		"Cavo e lampadine, e più avanti i risonatori tribali.",
		"Come: fondi rame grezzo / graniglia di rame. Setaccia la ghiaia."
	]
	quest.4200000000020059.title: "Lingotto di rame"
	quest.420000000002005A.quest_desc: [
		"Attrezzi dorati, e lastre d'oro per i Tessitori di motivi.",
		"Come: fondi oro grezzo / graniglia d'oro. Presa da setaccio più rara."
	]
	quest.420000000002005A.title: "Lingotto d'oro"
	quest.420000000002005B.quest_desc: [
		"Presa più fine. Le maglie di selce scuotono il Filo sfilacciato fuori dalla graniglia.",
		"Come: selce intorno a una maglia di Filo (spago)."
	]
	quest.420000000002005B.title: "Maglia di selce"
	quest.420000000002005C.quest_desc: [
		"Filo metallico per la polvere più pesante. Le maglie di ferro sono dove cade il Filamento di Filo.",
		"Come: ferro intorno a una maglia di Filo (selce). Qui inizia il Filamento di Filo."
	]
	quest.420000000002005C.title: "Maglia di ferro"
	quest.420000000002005D.quest_desc: [
		"Fonde e gocciola. Dai ciottoli alla lava, col tempo.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.420000000002005D.title: "Crogiolo"
	quest.420000000002005E.quest_desc: [
		"Il barile di Ex Deorum: compost, e acqua in argilla per la via lenta.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.420000000002005E.title: "Barile (pietra)"
	quest.420000000002005F.quest_desc: [
		"Colpi più duri, vita più lunga.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.420000000002005F.title: "Stone Hammer"
	quest.4200000000020060.quest_desc: [
		"Frantuma il minerale in ghiaia e graniglia, il trucco rumoroso dietro il setaccio.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.4200000000020060.title: "Iron Hammer"
	quest.4200000000020061.quest_desc: [
		"Maglia più larga, nove alla volta.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.4200000000020061.title: "Setaccio compresso"
	quest.4200000000020062.quest_desc: [
		"Si vede attraverso. Dalla sabbia al vetro.",
		"Come: fondi la sabbia. Martella i ciottoli in ghiaia, la ghiaia in sabbia, poi in fornace."
	]
	quest.4200000000020062.title: "Vetro"
	quest.4200000000020063.quest_desc: [
		"Ora porta la pioggia nel ferro.",
		"Come: tre lingotti di ferro, oppure /clowder hub Custodi della piattaforma (8 Filo). Riempilo dal ghiaccio fuso."
	]
	quest.4200000000020063.title: "Secchio"
	quest.4200000000020064.quest_desc: [
		"Calore dal vuoto, in mano.",
		"Come: crogiolo di lava di Ex Deorum, o una pozza di lava del Nether dopo l'ossidiana di Artiglio."
	]
	quest.4200000000020064.title: "Secchio di lava"
	quest.4200000000020065.quest_desc: [
		"Pensieri da portale. Acqua su una sorgente di lava.",
		"Come: acqua su una sorgente di lava (o lava sull'acqua). Tieni la sorgente di lava."
	]
	quest.4200000000020065.title: "Ossidiana"
	quest.4200000000020066.quest_desc: [
		"Rara fortuna della graniglia. Due sono un inizio.",
		"Come: setaccia la ghiaia con una maglia di ferro o meglio, oppure minerale di diamante nel Frantumatore d'eco."
	]
	quest.4200000000020066.title: "Diamante"
	quest.4200000000020067.quest_desc: [
		"Carburante per migliorare la maglia.",
		"Come: ghiaia, oppure scarico di Filo + ghiaia."
	]
	quest.4200000000020067.title: "Selce"
	quest.4200000000020068.quest_desc: [
		"Fatta di graniglia e polvere, non predata da un creeper. Maneggiala con cura.",
		"Come: setaccia polvere o sabbia delle anime, oppure creeper sulla piattaforma di notte. Tieni i bordi illuminati dopo che ne hai un po'."
	]
	quest.4200000000020068.title: "Polvere da sparo"
	quest.4200000000020069.quest_desc: [
		"Scintilla lo vorrà. Tienilo asciutto.",
		"Come: setaccia la ghiaia, oppure minerale di redstone nel Frantumatore d'eco dopo Recupero."
	]
	quest.4200000000020069.title: "Redstone"
	quest.420000000002006A.quest_desc: [
		"Nutre il tavolo per incantesimi. Polvere blu che fa ascoltare meglio l'equipaggiamento.",
		"Come: setaccia la ghiaia, oppure minerale di lapislazzuli nel Frantumatore d'eco."
	]
	quest.420000000002006A.title: "Lapislazzuli"
	quest.420000000002006B.quest_desc: [
		"Una miscela di pietra comune, utile soprattutto per costruire e per mescolare ricette più avanti.",
		"Come: setaccia sassolini di terra/ghiaia, oppure ciottoli più diorite in JEI."
	]
	quest.420000000002006B.title: "Andesite"
	quest.420000000002006C.quest_desc: [
		"Pietra macchiata, più decorativa che strutturale. I Cantori di ghiaia la chiamavano la rumorosa.",
		"Come: setaccia sassolini, oppure ciottoli più quarzo del Nether."
	]
	quest.420000000002006C.title: "Diorite"
	quest.420000000002006D.quest_desc: [
		"Densa e picchiettata di rosa, buona per un pavimento che vuole spiccare.",
		"Come: setaccia sassolini, oppure diorite più quarzo del Nether."
	]
	quest.420000000002006D.title: "Granito"
	quest.420000000002006E.quest_desc: [
		"Roccia porosa dell'altro luogo. Brucia per sempre appena prende.",
		"Come: il Nether qui è vuoto, non terreno. Versa lava in un barile di Ex Deorum di acqua della strega (un barile d'acqua sul micelio; le spore di micelio si setacciano dalla terra)."
	]
	quest.420000000002006E.title: "Netherrack"
	quest.420000000002006F.quest_desc: [
		"Rallenta ogni passo che lo attraversa e nutre il fuoco delle anime di un blu più freddo.",
		"Come: sabbia in un barile di Ex Deorum di acqua della strega. Le stanze di verruche della fortezza ne tengono un po'. Tre teschi sulla sabbia delle anime fanno un Wither."
	]
	quest.420000000002006F.title: "Sabbia delle anime"
	quest.4200000000020070.quest_desc: [
		"Macinata dalla pietra luminosa del Nether, utile per le pozioni e per luci più morbide.",
		"Come: setaccia sabbia delle anime, oppure streghe sulla piattaforma."
	]
	quest.4200000000020070.title: "Polvere di pietra luminosa"
	quest.4200000000020071.quest_desc: [
		"Strappa le foglie da un albero senza calare l'ascia sul tronco.",
		"Come: quattro bastoni. Il banco dei Cantori di ghiaia ne vende uno."
	]
	quest.4200000000020071.title: "Vincastro"
	quest.4200000000020072.quest_desc: [
		"Esce dal setaccio in mucchi che crescono. Non basta mai del tutto per ogni maglia.",
		"Come: sfilaccia il Filo sfilacciato (1 → 3). Ragni. Lanugine del telaio su una Legatura d'eco. Scarico inverso del filato."
	]
	quest.4200000000020072.title: "Spago"
	quest.4200000000020073.quest_desc: [
		"Legante per nodi — o ricetta di compost della piattaforma.",
		"Come: due terre + semi di grano + farina d'ossa (compost della piattaforma), o /clowder hub Custodi della piattaforma."
	]
	quest.4200000000020073.title: "Palla di slime"
	quest.4200000000020074.quest_desc: [
		"Macinato in farina d'ossa, o tenuto intero per far nascere il prossimo lupo del branco.",
		"Come: scheletri di notte, o /clowder hub Custodi della piattaforma (16 Filo per 8)."
	]
	quest.4200000000020074.title: "Osso"
	quest.4200000000020075.quest_desc: [
		"Amaro e appena tossico. Serve per le pozioni; nessuno lo mangia così.",
		"Come: ragni sulla piattaforma di notte."
	]
	quest.4200000000020075.title: "Occhio di ragno"
	quest.4200000000020076.quest_desc: [
		"Filato, porcellana, una Cornice del telaio che funziona, ferro nella cassa.",
		"Tendi il Filo: rispondono i Cantori di ghiaia.",
		"Reclamalo e scegli un dono della tribù: un Filo del Ritorno per una vita condivisa in più, oppure scorte.",
		"Come: finisci le missioni collegate a questa, poi reclamala per il gettone di Filo. Incastona il gettone al tuo Palo di tensione."
	]
	quest.4200000000020076.quest_subtitle: "Recupero"
	quest.4200000000020076.title: "Nodo di Pietra"
	quest.4200000000020077.quest_desc: [
		"Clic destro sul Palo di tensione del tuo Clowder con il gettone.",
		"La tacca si accende, la tribù rintocca, la piattaforma cambia.",
		"Come: clic destro sul tuo Palo di tensione con il gettone di Filo in mano."
	]
	quest.4200000000020077.title: "Sistema Pietra"
	quest.4200000000020078.quest_desc: [
		"Un creeper, sistemato. La polvere da sparo vale più dello spavento.",
		"Come: uccidi tre creeper. La polvere da sparo è la ricompensa."
	]
	quest.4200000000020078.title: "Bum, dopo"
	quest.4200000000030079.quest_desc: [
		"Incidi filari nella piattaforma.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: due lingotti di ferro sopra un bastone."
	]
	quest.4200000000030079.title: "Zappa di ferro"
	quest.420000000003007A.quest_desc: [
		"Il pane è infrastruttura. Trentadue grani sono un campo, non un'aiuola.",
		"Come: semi di grano sulla terra zappata, poi farina d'ossa. I semi vengono rompendo l'erba, o dalla cassa iniziale."
	]
	quest.420000000003007A.title: "Campo di grano"
	quest.420000000003007B.quest_desc: [
		"Pianta ciò che mangi.",
		"Come: rompi l'erba, o setaccia terra con una maglia di selce. Pianta sulla terra zappata; la farina d'ossa accelera il primo campo."
	]
	quest.420000000003007B.title: "Borsa dei semi"
	quest.420000000003007C.quest_desc: [
		"La velocità è gentilezza. Compost e ossa.",
		"Come: ossa in una griglia, oppure scarico di Filo + carne marcia, o /clowder hub Custodi della piattaforma."
	]
	quest.420000000003007C.title: "Motore a farina d'ossa"
	quest.420000000003007D.quest_desc: [
		"Prepara il raccolto.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000003007D.title: "Coltello del contadino"
	quest.420000000003007E.quest_desc: [
		"Una cucina comincia qui.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000003007E.title: "Tagliere"
	quest.420000000003007F.quest_desc: [
		"I pasti caldi nutrono più della fame.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000003007F.title: "Pentola"
	quest.4200000000030080.quest_desc: [
		"Cresce in teste ordinate, meglio cotta in qualcosa che mangiata cruda.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000030080.title: "Cavolo"
	quest.4200000000030081.quest_desc: [
		"Sale sul suo graticcio e matura rosso. La salsa comincia qui.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000030081.title: "Pomodoro"
	quest.4200000000030082.quest_desc: [
		"Lacrime di gioia.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000030082.title: "Cipolle"
	quest.4200000000030083.quest_desc: [
		"Inizia la coltura dell'essenza. Sedici dalla prima fila.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"La spina dorsale dei semi. Setacciala o coltivala.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Innalza semi dall'essenza.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030085.title: "Infusion Altar"
	quest.4200000000030086.quest_desc: [
		"Quattro intorno all'altare.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030086.title: "Infusion Pedestal"
	quest.4200000000030087.quest_desc: [
		"Fai crescere più piattaforma.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030087.title: "Semi di terra"
	quest.4200000000030088.quest_desc: [
		"Fai crescere la chioma senza l'ascia.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030088.title: "Semi di legno"
	quest.4200000000030089.quest_desc: [
		"Coltivato, non scavato. Raccogli essenza invece di brandire un piccone.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030089.title: "Semi di pietra"
	quest.420000000003008A.quest_desc: [
		"Metallo da una coltura. Il secondo motore di Recupero.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000003008A.title: "Semi di ferro"
	quest.420000000003008B.quest_desc: [
		"Una coltura che dà essenza di rame invece di minerale di rame.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000003008B.title: "Semi di rame"
	quest.420000000003008C.quest_desc: [
		"Una coltura dorata che fa crescere essenza d'oro proprio sulla piattaforma.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000003008C.title: "Semi d'oro"
	quest.420000000003008D.quest_desc: [
		"Trasforma un appezzamento in una fonte di combustibile, senza dover scavare.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000003008D.title: "Semi di carbone"
	quest.420000000003008E.quest_desc: [
		"Pioggia imbottigliata, da una coltura.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000003008E.title: "Semi d'acqua"
	quest.420000000003008F.quest_desc: [
		"Crescita compatta per una piattaforma piccola.",
		"Come: Botany Pot di terracotta in JEI. Terra + un seme nel vaso; la farina d'ossa aiuta ancora."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"Il vaso che si raccoglie da solo.",
		"Come: Botany Pot con tramoggia in JEI. Sta su una cassa/tramoggia e si raccoglie da solo."
	]
	quest.4200000000030090.title: "Vaso tramoggia"
	quest.4200000000030091.quest_desc: [
		"Sali di grado. I semi diventano più avidi e migliori.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"Un grado più profondo di essenza di coltura, più forte dei semi con cui hai cominciato.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Nove farine d'ossa per un blocco. Deposito per il motore.",
		"Come: nove farine d'ossa. Ossa dagli scheletri o dai Custodi della piattaforma."
	]
	quest.4200000000030093.title: "Blocco d'osso"
	quest.4200000000030094.quest_desc: [
		"Eccedenza di Germoglio, impilata.",
		"Come: nove frumenti. Tre frumenti fanno anche il pane."
	]
	quest.4200000000030094.title: "Silo di fieno"
	quest.4200000000030095.quest_desc: [
		"Miglior terreno da coltura. I Legaradici approverebbero.",
		"Come: piazza Compost organico e aspetta; matura piano in Terra ricca."
	]
	quest.4200000000030095.title: "Terra fertile"
	quest.4200000000030096.quest_desc: [
		"Nutri la terra che ti nutre.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000030096.title: "Composto organico"
	quest.4200000000030097.quest_desc: [
		"Pianta una fila, nutri un cavallo, oppure mangiala cruda.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000030097.title: "Carota"
	quest.4200000000030098.quest_desc: [
		"Coltura base di patata.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000030098.title: "Patata"
	quest.4200000000030099.quest_desc: [
		"Cresce in fretta e tinge di rosso. Zuppa, stufato, o dritta dal terreno.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000030099.title: "Barbabietola"
	quest.420000000003009A.quest_desc: [
		"Anguria per cibo e scambi.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000003009A.title: "Anguria"
	quest.420000000003009B.quest_desc: [
		"Zucca per cibo e decoro.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000003009B.title: "Zucca"
	quest.420000000003009C.quest_desc: [
		"Carta e zucchero.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000003009C.title: "Canna da zucchero"
	quest.420000000003009D.quest_desc: [
		"Cresce senza acqua e ferisce qualunque cosa ci si appoggi.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000003009D.title: "Cactus"
	quest.420000000003009E.quest_desc: [
		"Sale in fretta e brucia forte. Combustibile comodo per una piattaforma povera di alberi.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000003009E.title: "Bambù"
	quest.420000000003009F.quest_desc: [
		"Bacche mentre costruisci.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000003009F.title: "Bacche dolci"
	quest.42000000000300A0.quest_desc: [
		"Coltivato su tronchi di giungla, macinato nel bruno che dà sapore a ogni dolce.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000300A0.title: "Cacao"
	quest.42000000000300A1.quest_desc: [
		"Cade dalle foglie di quercia a tempo suo. Cibo gratis, prima o poi.",
		"Come: le foglie di quercia ne fanno cadere poche; un melo Pam's (arboscello da terra a maglia di ferro) ne porta molte."
	]
	quest.42000000000300A1.title: "Mela"
	quest.42000000000300A2.quest_desc: [
		"Una ciotola, niente banco da lavoro. La cena del contadino pigro.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000300A2.title: "Stufato di funghi"
	quest.42000000000300A3.quest_desc: [
		"Un assaggio dell'alveare prima che cominci il lavoro più fondo con le api.",
		"Come: bottiglia di vetro su un alveare pieno. Falò sotto."
	]
	quest.42000000000300A3.title: "Bottiglia di miele"
	quest.42000000000300A4.quest_desc: [
		"Crescono sui rampicanti delle caverne e illuminano il tunnel mentre le mangi.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000300A4.title: "Bacche luminose"
	quest.42000000000300A5.quest_desc: [
		"La base di ogni pozione che valga la pena di imbottigliare. Cresce solo sulla sabbia delle anime.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000300A5.title: "Verruca del Nether"
	quest.42000000000300A6.quest_desc: [
		"Un campo, una cucina, essenza che sale.",
		"Metti in tensione il Filo: i Legaradici rispondono.",
		"Reclamalo e scegli un dono della tribù: un Filo del Ritorno per una vita condivisa in più, oppure scorte.",
		"Come: finisci le missioni collegate a questa, poi reclamala per il gettone di Filo. Incastona il gettone al tuo Palo di tensione."
	]
	quest.42000000000300A6.quest_subtitle: "Radice"
	quest.42000000000300A6.title: "Nodo di Germoglio"
	quest.42000000000300A7.quest_desc: [
		"Clic destro sul Palo di tensione del tuo Clowder con il gettone.",
		"La tacca si accende, la tribù rintocca, la piattaforma cambia.",
		"Come: clic destro sul tuo Palo di tensione con il gettone di Filo in mano."
	]
	quest.42000000000300A7.title: "Innesta Germoglio"
	quest.42000000000300A8.quest_desc: [
		"I Legaradici ne tirano una a testa, prima o poi.",
		"Non mangiarla. Non buttarla via.",
		"Come: un raro raccolto di patate. Segreto opzionale di Germoglio."
	]
	quest.42000000000300A8.title: "Patata sbagliata"
	quest.42000000000400A9.quest_desc: [
		"Taglia il vuoto a modo tuo. Otto fogli di progetti.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: quattro carte e un colorante blu, senza forma. Rende quattro fogli."
	]
	quest.42000000000400A9.title: "Blueprint Paper"
	quest.42000000000400AA.quest_desc: [
		"Progetti in una scatola.",
		"Quattro Carta dei progetti, senza forma — rivendicare una piattaforma cancella il dono d'ingresso di Silent Gear. Clic destro per scartare i progetti iniziali.",
		"Come: quattro Carta dei progetti, senza forma. Clic destro per scartare i progetti iniziali. Rivendicare una piattaforma cancella il dono d'ingresso di Silent Gear."
	]
	quest.42000000000400AA.title: "Blueprint Package"
	quest.42000000000400AB.quest_desc: [
		"Lo schema da cui parte un attrezzo modulare, prima che tu aggiunga i pezzi.",
		"Come: scarta il Pacchetto dei progetti, oppure JEI. Artiglio dà il nome alla linea di attrezzi."
	]
	quest.42000000000400AB.title: "Progetto dell'asta"
	quest.42000000000400AC.quest_desc: [
		"Forma un piccone che dura più del suo metallo.",
		"Come: scarta il Pacchetto dei progetti, oppure JEI. Artiglio dà il nome alla linea di attrezzi."
	]
	quest.42000000000400AC.title: "Progetto del piccone"
	quest.42000000000400AD.quest_desc: [
		"Forma un'ascia.",
		"Come: scarta il Pacchetto dei progetti, oppure JEI. Artiglio dà il nome alla linea di attrezzi."
	]
	quest.42000000000400AD.title: "Progetto dell'ascia"
	quest.42000000000400AE.quest_desc: [
		"Forma una pala.",
		"Come: scarta il Pacchetto dei progetti, oppure JEI. Artiglio dà il nome alla linea di attrezzi."
	]
	quest.42000000000400AE.title: "Progetto della pala"
	quest.42000000000400AF.quest_desc: [
		"Forma una lama.",
		"Come: scarta il Pacchetto dei progetti, oppure JEI. Artiglio dà il nome alla linea di attrezzi."
	]
	quest.42000000000400AF.title: "Progetto della spada"
	quest.42000000000400B0.quest_desc: [
		"Spazio per crescere.",
		"Come: JEI dopo la Carta dei progetti. Artiglio dà il nome alla linea di miglioramenti."
	]
	quest.42000000000400B0.title: "Upgrade Base"
	quest.42000000000400B1.quest_desc: [
		"Trentadue barre di materiale per i pezzi.",
		"Come: fondi ferro grezzo / graniglia di ferro (fornace o Forno di braci). Setaccia la ghiaia per i pezzi."
	]
	quest.42000000000400B1.title: "Massa di ferro"
	quest.42000000000400B2.quest_desc: [
		"Affila il taglio oltre ciò che il ferro da solo riesce a fare.",
		"Come: setaccia la ghiaia con una maglia di ferro o meglio, oppure minerale di diamante nel Frantumatore d'eco."
	]
	quest.42000000000400B2.title: "Punta di diamante"
	quest.42000000000400B3.quest_desc: [
		"Foglie e lana, e favi più tardi.",
		"Come: due lingotti di ferro in diagonale. Tosa le pecore e i nidi d'api."
	]
	quest.42000000000400B3.title: "Cesoie"
	quest.42000000000400B4.quest_desc: [
		"Le piattaforme hanno i bordi. Anche i mostri.",
		"Come: sei assi intorno al ferro. Parata in mano secondaria."
	]
	quest.42000000000400B4.title: "Scudo"
	quest.42000000000400B5.quest_desc: [
		"Sopravvivi alla notte apposta.",
		"Come: otto lingotti di ferro. Fondi ghiaia di setaccio."
	]
	quest.42000000000400B5.title: "Corazza di ferro"
	quest.42000000000400B6.quest_desc: [
		"Bada alla caduta.",
		"Come: cinque lingotti di ferro."
	]
	quest.42000000000400B6.title: "Elmo di ferro"
	quest.42000000000400B7.quest_desc: [
		"Copre prima le gambe. La maggior parte del danno arriva comunque dal basso.",
		"Come: sette lingotti di ferro."
	]
	quest.42000000000400B7.title: "Gambali di ferro"
	quest.42000000000400B8.quest_desc: [
		"Rende saldo il passo sui cornicioni dove un passo falso è il vuoto.",
		"Come: quattro lingotti di ferro."
	]
	quest.42000000000400B8.title: "Stivali di ferro"
	quest.42000000000400B9.quest_desc: [
		"Tieni a distanza i mostri del vuoto.",
		"Come: tre spaghi e tre bastoni."
	]
	quest.42000000000400B9.title: "Arco"
	quest.42000000000400BA.quest_desc: [
		"Sessantaquattro ragioni per tenere le distanze.",
		"Come: selce, bastone, piuma. Gli scheletri ne lasciano in più."
	]
	quest.42000000000400BA.title: "Fascio di frecce"
	quest.42000000000400BB.quest_desc: [
		"Illumina il passaggio.",
		"Come: lingotto di ferro più selce."
	]
	quest.42000000000400BB.title: "Acciarino"
	quest.42000000000400BC.quest_desc: [
		"Dieci blocchi. Una porta che i Camminabordi riconoscerebbero.",
		"Come: acqua su una sorgente di lava (o lava sull'acqua). Tieni la sorgente di lava."
	]
	quest.42000000000400BC.title: "Cornice di ossidiana"
	quest.42000000000400BD.quest_desc: [
		"Preparazione di un appiglio. Un altro posto esiste.",
		"Come: perla di ender (bancarella dei Camminabordi / endermen) più polvere di blaze da una fortezza del Nether, dopo l'ossidiana di Artiglio. La scorta di otto occhi è facoltativa; i cristalli dell'End usano la stessa fabbricazione."
	]
	quest.42000000000400BD.title: "Occhio di ender"
	quest.42000000000400BE.quest_desc: [
		"Potere morbido per attrezzi duri.",
		"Come: due diamanti, quattro ossidiana, libro. I diamanti dalla ghiaia con maglia di ferro."
	]
	quest.42000000000400BE.title: "Tavolo per incantesimi"
	quest.42000000000400BF.quest_desc: [
		"Ripara e dai un nome a ciò che porti.",
		"Come: tre blocchi di ferro sopra quattro lingotti."
	]
	quest.42000000000400BF.title: "Incudine"
	quest.42000000000400C0.quest_desc: [
		"Chiamalo tuo.",
		"Come: pesca / casse rare, o la bancarella degli Intagliatori di sigilli a /clowder hub (24 Filo). Facoltativo."
	]
	quest.42000000000400C0.title: "Targhetta"
	quest.42000000000400C1.quest_desc: [
		"Il modello iniziale di una zappa modulare, costruita pezzo per pezzo.",
		"Come: scarta il Pacchetto dei progetti, o JEI."
	]
	quest.42000000000400C1.title: "Progetto della zappa"
	quest.42000000000400C2.quest_desc: [
		"Libera un'ampia striscia di colture in un colpo, invece di una pianta.",
		"Come: scarta il Pacchetto dei progetti, o JEI."
	]
	quest.42000000000400C2.title: "Progetto della falce"
	quest.42000000000400C3.quest_desc: [
		"Un attrezzo che mina, taglia e scava. Niente più cambi in mano.",
		"Come: scarta il Pacchetto dei progetti, o JEI."
	]
	quest.42000000000400C3.title: "Progetto del Paxel"
	quest.42000000000400C4.quest_desc: [
		"Rompe la pietra tre per tre in un solo colpo.",
		"Come: scarta il Pacchetto dei progetti, o JEI."
	]
	quest.42000000000400C4.title: "Progetto del martello"
	quest.42000000000400C5.quest_desc: [
		"Apre buche larghe nella terra e nella sabbia, più in fretta di qualsiasi pala.",
		"Come: scarta il Pacchetto dei progetti, o JEI."
	]
	quest.42000000000400C5.title: "Progetto dell'escavatore"
	quest.42000000000400C6.quest_desc: [
		"Piccolo, veloce e preciso. Fatto per il lavoro da vicino, non per la guerra.",
		"Come: scarta il Pacchetto dei progetti, o JEI."
	]
	quest.42000000000400C6.title: "Progetto del coltello"
	quest.42000000000400C7.quest_desc: [
		"Placcatura morbida, facile da incantare, che vale più per la magia che per la difesa.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000400C7.title: "Pezzi d'armatura d'oro"
	quest.42000000000400C8.quest_desc: [
		"Artiglio di mare.",
		"Facoltativo — il vuoto potrebbe non offrirtelo mai.",
		"Come: solo annegati. Facoltativo."
	]
	quest.42000000000400C8.title: "Tridente"
	quest.42000000000400C9.quest_desc: [
		"Si carica piano, colpisce forte e tiene la carica finché ti serve.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000400C9.title: "Balestra"
	quest.42000000000400CA.quest_desc: [
		"Scruta il vuoto.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000400CA.title: "Cannocchiale"
	quest.42000000000400CB.quest_desc: [
		"Progetti, ferro sulla schiena, una porta per uscire.",
		"Tendi il Filo: i Camminabordi rispondono. La treccia si apre.",
		"Reclamalo e scegli un dono della tribù: un Filo del Ritorno per una vita condivisa in più, oppure scorte.",
		"Come: finisci le missioni collegate a questa, poi reclamala per il gettone di Filo. Incastona il gettone al tuo Palo di tensione."
	]
	quest.42000000000400CB.quest_subtitle: "Bordo"
	quest.42000000000400CB.title: "Nodo di Artiglio"
	quest.42000000000400CC.quest_desc: [
		"Clic destro sul Palo di tensione del tuo Clowder con il gettone.",
		"La tacca si accende, la tribù rintocca, la piattaforma cambia.",
		"Come: clic destro sul tuo Palo di tensione con il gettone di Filo in mano."
	]
	quest.42000000000400CC.title: "Innesta Artiglio"
	quest.42000000000400CD.quest_desc: [
		"Qualcosa di alto ha ricambiato lo sguardo. I Camminabordi li chiamavano sentinelle delle porte.",
		"Come: uccidi un enderman. Le perle di ender arrivano anche dalla bancarella dei Camminabordi."
	]
	quest.42000000000400CD.title: "Bordo del Bordo"
	quest.42000000000500CE.quest_desc: [
		"Un breve segnale prima del Ronzio. Sessantaquattro di polvere.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: setaccia la ghiaia, oppure minerale di redstone nel Frantumatore d'eco dopo Recupero."
	]
	quest.42000000000500CE.title: "Polvere di redstone"
	quest.42000000000500CF.quest_desc: [
		"Calore in parallelo. Otto è una fila, non una fornace.",
		"Come: otto ciottoli intorno a un centro vuoto."
	]
	quest.42000000000500CF.title: "Fila di fornaci"
	quest.42000000000500D0.quest_desc: [
		"Sposta la graniglia senza mani.",
		"Come: cinque ferri intorno a un baule. Mettila sotto una Cornice del telaio o un Barile di tensione (estrae verso il BASSO)."
	]
	quest.42000000000500D0.title: "Linea di tramogge"
	quest.42000000000500D1.quest_desc: [
		"Misura il battito.",
		"Come: quarzo del Nether, torcia di redstone, pietra. Il quarzo si setaccia dalla sabbia delle anime; niente viaggio nel Nether."
	]
	quest.42000000000500D1.title: "Comparatore"
	quest.42000000000500D2.quest_desc: [
		"Osso, spago, ametista. Il primo battito.",
		"Ne rende due — tienne uno per il Codice degli Spiriti.",
		"Come: un osso, spago, ametista. /clowder hub I Custodi della piattaforma vendono ossa. Cancello Scintilla / Ronzio."
	]
	quest.42000000000500D2.title: "Ronzio: Campanello d'osso"
	quest.42000000000500D3.quest_desc: [
		"Una scheggia di un vecchio canto di tribù. Vuole un campanello.",
		"Come: Campanello d'osso, ametista e redstone, senza forma. Ne rende due."
	]
	quest.42000000000500D3.title: "Ronzio: Scheggia spirituale"
	quest.42000000000500D4.quest_desc: [
		"Rame intorno a un campanello: metallo accordato allo spirito.",
		"Come: rame intorno a un Campanello d'osso. Ne rende due."
	]
	quest.42000000000500D4.title: "Ronzio: Risonatore di rame"
	quest.42000000000500D5.quest_desc: [
		"Colpiscilo. Tieni un Pulso. Ascolta prima di cablare qualsiasi cosa.",
		"Due campanelli, una scheggia, due cuoi, quattro assi — i Custodi della piattaforma a /clowder hub vendono cuoio.",
		"Come: due Campanelli d'osso, una Scheggia spirituale, due cuoi e quattro assi. Colpisci a mani vuote a tempo (17–23 tick) per 24 di Pulso."
	]
	quest.42000000000500D5.title: "Ronzio: Cuore di tamburo"
	quest.42000000000500D6.quest_desc: [
		"Porta Pulso per attrezzi, incantesimi e viaggi — serve Risonatore + Scheggia.",
		"Come: creala, poi riempila da un Cuore di tamburo (clic con la cella). Attrezzi, incantesimi e viaggi attingono dalla cella."
	]
	quest.42000000000500D6.title: "Ronzio: Cella di Pulso"
	quest.42000000000500D7.quest_desc: [
		"Attira la ley ambientale in battiti sotto cielo aperto. Le voci dei totem si aggiungono; un Cuore di tamburo non serve.",
		"Come: mettilo sotto il cielo, vicino ad acqua/verde. Pulso lento. Scala di Scintilla."
	]
	quest.42000000000500D7.title: "Ronzio: Collettore di ley"
	quest.42000000000500D8.quest_desc: [
		"Innesta un catalizzatore d'eco (si consuma mentre lavora) e due totem elementali diversi. L'accampamento canta il suo potere; la redstone mette in pausa l'armonia.",
		"Come: innesta un catalizzatore d'eco e due totem diversi entro 8. La redstone lo mette in pausa."
	]
	quest.42000000000500D8.title: "Ronzio: Risonatore di Pulso"
	quest.42000000000500D9.quest_desc: [
		"Un accumulo di Energia di Forge — il ponte dal Pulso al filo, se ne vuoi uno.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500D9.title: "Cella iniziale Powah"
	quest.42000000000500DA.quest_desc: [
		"Brucia combustibile per Energia di Forge.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500DA.title: "Bruciatore Powah"
	quest.42000000000500DB.quest_desc: [
		"Porta avanti l'energia.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500DB.title: "Cavo Powah"
	quest.42000000000500DC.quest_desc: [
		"Potenza del cielo, su una piattaforma che è tutto cielo.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500DC.title: "Pannello solare iniziale"
	quest.42000000000500DD.quest_desc: [
		"Brucia uno scarto di calore in potenza. Nutrilo caldo da un lato, freddo dall'altro.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500DD.title: "Generatore termico"
	quest.42000000000500DE.quest_desc: [
		"Carica oggetti in un anello di verghe.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500DE.title: "Energizing Orb"
	quest.42000000000500DF.quest_desc: [
		"Alimenta il globo.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500DF.title: "Verga energizzante"
	quest.42000000000500E0.quest_desc: [
		"Una tasca di energia accumulata.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500E0.title: "Batteria"
	quest.42000000000500E1.quest_desc: [
		"Ruota le macchine sul posto invece di romperle e riposizionarle.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000500E1.title: "Wrench"
	quest.42000000000500E2.quest_desc: [
		"Fonde il minerale due volte più in fretta di una fornace normale, solo minerale.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500E2.title: "Altoforno"
	quest.42000000000500E3.quest_desc: [
		"Cuoce la carne due volte più in fretta di un falò, solo cibo.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500E3.title: "Affumicatore"
	quest.42000000000500E4.quest_desc: [
		"Nove carboni pressati, densi. Un blocco dura più di un'intera pila di pezzi.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500E4.title: "Blocco di carbone (Scintilla)"
	quest.42000000000500E5.quest_desc: [
		"Spinge un oggetto alla volta in ciò che sta davanti.",
		"Come: ciottoli intorno alla redstone."
	]
	quest.42000000000500E5.title: "Rilasciatore"
	quest.42000000000500E6.quest_desc: [
		"Spingi con intenzione.",
		"Come: ciottoli, arco e redstone."
	]
	quest.42000000000500E6.title: "Erogatore"
	quest.42000000000500E7.quest_desc: [
		"Spinge un blocco in avanti a un segnale, poi aspetta il successivo.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500E7.title: "Pistone"
	quest.42000000000500E8.quest_desc: [
		"Spinge fuori un blocco e lo tira indietro quando il segnale cade.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500E8.title: "Pistone appiccicoso"
	quest.42000000000500E9.quest_desc: [
		"L'osservatore legge il ritmo.",
		"Come: ciottoli, redstone e quarzo del Nether."
	]
	quest.42000000000500E9.title: "Osservatore"
	quest.42000000000500EA.quest_desc: [
		"Il ripetitore temporizza il circuito.",
		"Come: torcia di redstone, redstone, pietra. Il capitolo dei tubi lo usa per gli orologi."
	]
	quest.42000000000500EA.title: "Ripetitore"
	quest.42000000000500EB.quest_desc: [
		"Registra un colpo con una forza del segnale in base a quanto è vicino al centro.",
		"Come: redstone intorno al fieno. Il fieno è tre grani."
	]
	quest.42000000000500EB.title: "Bersaglio"
	quest.42000000000500EC.quest_desc: [
		"Devia un fulmine dal tuo tetto e mette a terra la carica.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500EC.title: "Parafulmine"
	quest.42000000000500ED.quest_desc: [
		"Tempo di energia.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500ED.title: "Orologio"
	quest.42000000000500EE.quest_desc: [
		"Luce senza torce.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500EE.title: "Lampadina di rame"
	quest.42000000000500EF.quest_desc: [
		"Si accende a un segnale e si spegne nell'istante in cui quello smette.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500EF.title: "Lampada di redstone"
	quest.42000000000500F0.quest_desc: [
		"Legge il cielo e manda un segnale che sale e scende con il sole.",
		"Come: vetro, quarzo del Nether, lastre di legno."
	]
	quest.42000000000500F0.title: "Sensore di luce diurna"
	quest.42000000000500F1.quest_desc: [
		"Accende o spegne un segnale a mano. L'interruttore più vecchio che ci sia.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F1.title: "Leva"
	quest.42000000000500F2.quest_desc: [
		"Il pulsante dà un impulso di redstone.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F2.title: "Pulsante"
	quest.42000000000500F3.quest_desc: [
		"Manda un segnale quando qualcosa più pesante dell'aria ci sta sopra.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F3.title: "Pedana a pressione"
	quest.42000000000500F4.quest_desc: [
		"Tesa con lo spago attraverso un sentiero, prende tutto ciò che la attraversa.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F4.title: "Gancio"
	quest.42000000000500F5.quest_desc: [
		"Suona una nota per tipo di blocco sotto di sé. I Cuori di tamburo sentono una canzone in una fila.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F5.title: "Blocco sonoro"
	quest.42000000000500F6.quest_desc: [
		"Jukebox per il morale della piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F6.title: "Jukebox"
	quest.42000000000500F7.quest_desc: [
		"Rotola per gravità o per una spinta. Senza binari, niente corsa.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F7.title: "Carrello da miniera"
	quest.42000000000500F8.quest_desc: [
		"Binari attraverso il varco del vuoto.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F8.title: "Binario"
	quest.42000000000500F9.quest_desc: [
		"Binario alimentato per carrelli.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500F9.title: "Binario alimentato"
	quest.42000000000500FA.quest_desc: [
		"Legge un carrello di passaggio e manda un segnale quando ci rotola sopra.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000500FA.title: "Binario rilevatore"
	quest.42000000000500FB.quest_desc: [
		"Fabbricazione solare alternativa.",
		"Come: tre vetri, tre lapislazzuli e tre Specchi, una riga per ciascuno."
	]
	quest.42000000000500FB.title: "Cella Solar Flux"
	quest.42000000000500FC.quest_desc: [
		"Semplici tubi per oggetti.",
		"Come: ferro + redstone. Sistema le facce con la chiave inglese Pipez."
	]
	quest.42000000000500FC.title: "Pipez oggetti"
	quest.42000000000500FD.quest_desc: [
		"Semplici tubi per fluidi.",
		"Come: ferro + secchi + redstone. Uso accovacciato della chiave inglese su un lato per estrarre; clic destro su quel lato per i filtri."
	]
	quest.42000000000500FD.title: "Pipez fluidi"
	quest.42000000000500FE.quest_desc: [
		"Tubi di energia semplici tra le macchine.",
		"Come: ferro + redstone. Porta FE tra le macchine."
	]
	quest.42000000000500FE.title: "Pipez energia"
	quest.42000000000500FF.quest_desc: [
		"Sceglie quali lati del tubo estraggono da una macchina, o ne taglia uno, senza rompere il tubo.",
		"Come: due selci e due bastoni. Uso accovacciato su un lato del tubo a una macchina per farlo estrarre, di nuovo per tagliarlo; clic destro su un lato che estrae per i filtri."
	]
	quest.42000000000500FF.title: "Chiave inglese Pipez"
	quest.4200000000050100.quest_desc: [
		"Segna le linee del reticolo — serve una Scheggia spirituale.",
		"Come: due farine d'ossa, lapislazzuli e una Scheggia spirituale, senza forma. Rende quattro."
	]
	quest.4200000000050100.title: "Gesso rituale"
	quest.4200000000050101.quest_desc: [
		"Un tamburo colpito, un Pulso tenuto, un Risonatore innestato.",
		"Tendi il Filo: i Cuori di tamburo rispondono.",
		"Reclamalo e scegli un dono della tribù: un Filo del Ritorno per una vita condivisa in più, oppure scorte.",
		"Come: finisci le missioni collegate a questa, poi reclamala per il gettone di Filo. Incastona il gettone al tuo Palo di tensione."
	]
	quest.4200000000050101.quest_subtitle: "Ronzio"
	quest.4200000000050101.title: "Nodo di Scintilla"
	quest.4200000000050102.quest_desc: [
		"Clic destro sul Palo di tensione del tuo Clowder con il gettone.",
		"La tacca si accende, la tribù rintocca, la piattaforma cambia.",
		"Come: clic destro sul tuo Palo di tensione con il gettone di Filo in mano."
	]
	quest.4200000000050102.title: "Innesta Scintilla"
	quest.4200000000050103.quest_desc: [
		"Segui la Tessitura tribale attraverso la raffinazione dell'eco fino a un Nucleo risonante. L'Energizzatore armonico trasforma l'armonia dell'accampamento in FE per le macchine di questo capitolo. La conversione senza grado è 60 di Pulso al secondo; alza il grado alle stazioni d'eco per averne di più. Non può ricevere FE. La redstone mette in pausa sia la conversione sia l'esportazione.",
		"Come: cinque lingotti di rame, tre redstone e un Nucleo risonante."
	]
	quest.4200000000050103.title: "Il ronzio diventa corrente"
	quest.4200000000050104.quest_desc: [
		"Una strega, sulla tua piattaforma, di notte. I tamburi non ti hanno avvisato.",
		"Come: uccidi una strega sulla piattaforma di notte."
	]
	quest.4200000000050104.title: "Guai in bottiglia"
	quest.4200000000060105.quest_desc: [
		"Mani che lavorano mentre dormi. Trentadue.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: andesite + pepita di ferro in un banco da lavoro (o miscelatore)."
	]
	quest.4200000000060105.title: "Lega di andesite"
	quest.4200000000060106.quest_desc: [
		"La spina dorsale della rotazione.",
		"Come: lega di andesite in una ricetta di taglio / fabbricazione, elencata in JEI."
	]
	quest.4200000000060106.title: "Asta"
	quest.4200000000060107.quest_desc: [
		"Una ruota dentata. Poi la stessa ruota dentata, di nuovo.",
		"Come: Albero + tavole."
	]
	quest.4200000000060107.title: "Ingranaggio"
	quest.4200000000060108.quest_desc: [
		"Più denti, giro più lento.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.4200000000060108.title: "Grande ruota dentata"
	quest.4200000000060109.quest_desc: [
		"L'involucro di andesite è il telaio di Create.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.4200000000060109.title: "Rivestimento di andesite"
	quest.420000000006010A.quest_desc: [
		"Un fiume nel cielo, che gira.",
		"Come: otto tavole intorno a un Albero. Serve un flusso d'acqua accanto."
	]
	quest.420000000006010A.title: "Mulino ad acqua"
	quest.420000000006010B.quest_desc: [
		"Produce rotazione a mano quando nient'altro sta ancora girando.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.420000000006010B.title: "Manovella"
	quest.420000000006010C.quest_desc: [
		"Macina la ghiaia in polvere, senza martello.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.420000000006010C.title: "Macina"
	quest.420000000006010D.quest_desc: [
		"Il bacino tiene la miscelazione di Create.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.420000000006010D.title: "Vasca"
	quest.420000000006010E.quest_desc: [
		"Piastre e percorsi.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.420000000006010E.title: "Pressa meccanica"
	quest.420000000006010F.quest_desc: [
		"Ricette in massa, veloci.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.420000000006010F.title: "Miscelatore meccanico"
	quest.4200000000060110.quest_desc: [
		"Una superficie piatta che tiene fermo un oggetto per il nastro o la pressa.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.4200000000060110.title: "Deposito"
	quest.4200000000060111.quest_desc: [
		"I nastri spostano gli oggetti lungo gli Alberi.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.4200000000060111.title: "Connettore di nastro"
	quest.4200000000060112.quest_desc: [
		"Fa cadere gli oggetti dritti in basso tra le macchine, senza bisogno di nastro.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.4200000000060112.title: "Scivolo"
	quest.4200000000060113.quest_desc: [
		"Lavaggio, asciugatura e ghiaia in sabbia.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
