		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.420000000007014B.title: "Indicizatore Genetico"
	quest.420000000007014C.quest_desc: [
		"Una pila di dolcetti: la paga della colonia.",
		"Come: favo di miele più una bottiglia di miele, senza forma."
	]
	quest.420000000007014C.title: "Miglioria del mangime"
	quest.420000000007014D.quest_desc: [
		"Una delle colture di essenza più profonde, cresciuta ben oltre le basi.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000007014D.title: "Semi di diamante"
	quest.420000000007014E.quest_desc: [
		"Un appezzamento che dà polvere invece di scavarla.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000007014E.title: "Semi di redstone"
	quest.420000000007014F.quest_desc: [
		"Fa crescere l'essenza blu di cui i tavoli per incantesimi hanno sempre fame.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000007014F.title: "Semi di lapislazzuli"
	quest.4200000000070150.quest_desc: [
		"Quarzo cresciuto su una coltura, invece che scavato dalle grotte del Nether.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000070150.title: "Semi di quarzo del Nether"
	quest.4200000000070151.quest_desc: [
		"Un modo più morbido di coltivare luce che scavare il soffitto del Nether.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000070151.title: "Semi di pietra luminosa"
	quest.4200000000070152.quest_desc: [
		"Una coltura indurita che dà essenza di ossidiana, senza un secchio di lava in vista.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000070152.title: "Semi di ossidiana"
	quest.4200000000070153.quest_desc: [
		"Essenza alta. I campi ormai sono industria.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000070153.title: "Imperium"
	quest.4200000000070154.quest_desc: [
		"L'ultimo grado di essenza. Qualunque cosa tu stia costruendo, questa è la versione buona.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"Avanzo di Sciame, impilato.",
		"Come: quattro bottiglie di miele. Le bottiglie tornano."
	]
	quest.4200000000070155.title: "Blocco di miele"
	quest.4200000000070156.quest_desc: [
		"Un'ape che non esisteva prima che tu costruissi il nido.",
		"Minatrice, muratrice, scavatrice, carpentiere — guardane una.",
		"Come: guarda una Productive Bee dopo che un nido si sveglia. Prime ali è il nido di quercia."
	]
	quest.4200000000070156.quest_subtitle: "Colonia"
	quest.4200000000070156.title: "Qualcosa di nuovo ronza"
	quest.4200000000070157.quest_desc: [
		"Sabbia intorno a un fiore. Minatrici cinerine e al cioccolato.",
		"Come: anello del materiale del nido intorno a un fiore piccolo. Piazzalo, poi clic destro con un fiore piccolo per svegliarlo; le api escono dopo un po'."
	]
	quest.4200000000070157.title: "Anello di sabbia"
	quest.4200000000070158.quest_desc: [
		"Canna da zucchero intorno a un fiore. Api dei canneti e muratrici.",
		"Come: anello del materiale del nido intorno a un fiore piccolo. Piazzalo, poi clic destro con un fiore piccolo per svegliarlo; le api escono dopo un po'."
	]
	quest.4200000000070158.title: "Anello di canna"
	quest.4200000000070159.quest_desc: [
		"Blocchi di slime intorno a un fiore. Indovina.",
		"Come: anello del materiale del nido intorno a un fiore piccolo. Piazzalo, poi clic destro con un fiore piccolo per svegliarlo; le api escono dopo un po'."
	]
	quest.4200000000070159.title: "Anello di slime"
	quest.420000000007015A.quest_desc: [
		"Fieno intorno a un fiore. Bombi, e anche api comuni.",
		"Come: anello del materiale del nido intorno a un fiore piccolo. Piazzalo, poi clic destro con un fiore piccolo per svegliarlo; le api escono dopo un po'."
	]
	quest.420000000007015A.title: "Anello di fieno"
	quest.420000000007015B.quest_desc: [
		"Neve intorno a un fiore. Api del sudore, stranamente.",
		"Come: anello del materiale del nido intorno a un fiore piccolo. Piazzalo, poi clic destro con un fiore piccolo per svegliarlo; le api escono dopo un po'."
	]
	quest.420000000007015B.title: "Anello di neve"
	quest.420000000007015C.quest_desc: [
		"Brucia miele per energia. Un alveare che fa doppio servizio.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.420000000007015C.title: "Generatore di miele"
	quest.420000000007015D.quest_desc: [
		"Mette in mostra un'ape, ali comprese, senza un alveare attaccato.",
		"Come: le ricette di Productive Bees sono in JEI. Sciame nomina l'alveare, la centrifuga e i passi di allevamento."
	]
	quest.420000000007015D.title: "Barattolo"
	quest.420000000007015E.quest_desc: [
		"Calma un alveare pieno di api prima che tu vada a scavare il favo di miele.",
		"Come: tronchi, bastoni e carbone o carbone di legna."
	]
	quest.420000000007015E.title: "Falò (Sciame)"
	quest.420000000007015F.quest_desc: [
		"Nutre le api e fiorisce due volte l'anno, sempreverde per il resto del tempo.",
		"Come: muschio più quercia, oppure farina d'ossa sul muschio. Le api accettano il fiore."
	]
	quest.420000000007015F.title: "Azalea in fiore (Sciame)"
	quest.4200000000070160.quest_desc: [
		"Alto, giallo e sempre rivolto al sole. Le api lo trovano facilmente.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000070160.title: "Girasole"
	quest.4200000000070161.quest_desc: [
		"Due blocchi di fioritura viola, per cui le api attraverseranno una piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000070161.title: "Lillà"
	quest.4200000000070162.quest_desc: [
		"Un fiore alto che le api prediligono, e un colore in più per il giardino.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000070162.title: "Cespuglio di rose"
	quest.4200000000070163.quest_desc: [
		"Rosa e piena, piantata ovunque un alveare abbia bisogno di più foraggio vicino.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000070163.title: "Peonia"
	quest.4200000000070164.quest_desc: [
		"Un fiore basso e singolo, ma alle api non importa l'altezza.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000070164.title: "Tulipano arancione"
	quest.4200000000070165.quest_desc: [
		"Un nido che hai costruito, un alveare che hai spostato, una centrifuga, un'incubatrice, campi di essenza.",
		"Dai tensione al Filo: rispondono i Custodi della colonia.",
		"Reclamalo e scegli un dono della tribù: un Filo del Ritorno per una vita condivisa in più, oppure scorte.",
		"Come: finisci le missioni collegate a questa, poi reclamala per il gettone di Filo. Incastona il gettone al tuo Palo di tensione."
	]
	quest.4200000000070165.quest_subtitle: "Colonia"
	quest.4200000000070165.title: "Nodo dello Sciame"
	quest.4200000000070166.quest_desc: [
		"Clic destro sul Palo di tensione del tuo Clowder con il gettone.",
		"La tacca si accende, la tribù rintocca, la piattaforma cambia.",
		"Come: clic destro sul tuo Palo di tensione con il gettone di Filo in mano."
	]
	quest.4200000000070166.title: "Sistema Sciame"
	quest.4200000000070167.quest_desc: [
		"Hai ucciso un'ape.",
		"I Custodi della colonia vorrebbero dirti una parola. Ecco una bottiglia; pensaci.",
		"Come: uccidi un'ape (nascosto). La bottiglia è la lezione."
	]
	quest.4200000000070167.title: "Rimpianto"
	quest.4200000000080168.quest_desc: [
		"I custodi hanno lasciato trucchi nel cristallo. Trentadue schegge.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: setaccio, o ametista gemmante se coltivi una fila di geodi. Occultism vuole schegge."
	]
	quest.4200000000080168.title: "Ametista"
	quest.4200000000080169.quest_desc: [
		"Clic destro sul Palo di tensione tenendo 16 Filamenti di Filo. Nessun Filo deve essere sistemato.",
		"Legare inizia qui.",
		"Come: clic destro sul Palo di tensione tenendo 16 Filamenti di Filo. Setaccia ghiaia o sabbia con una maglia di Filo di ferro per trovarli."
	]
	quest.4200000000080169.title: "Cordone di treccia"
	quest.420000000008016A.quest_desc: [
		"Scrivi il rito prima di intagliarlo.",
		"Come: libro, sacca d'inchiostro, piuma. Carbone di legna più una bottiglia di vetro fanno l'inchiostro."
	]
	quest.420000000008016A.title: "Libro e penna"
	quest.420000000008016B.quest_desc: [
		"Potere morbido per attrezzi duri.",
		"Come: due diamanti, quattro ossidiana, libro. I diamanti dalla ghiaia con maglia di ferro."
	]
	quest.420000000008016B.title: "Tavolo per incantesimi (Sigillo)"
	quest.420000000008016C.quest_desc: [
		"Alimenta il tavolo.",
		"Come: nove lapislazzuli. Setaccia la ghiaia, oppure minerale di lapislazzuli nel Frantumatore d'eco."
	]
	quest.420000000008016C.title: "Blocco di lapislazzuli"
	quest.420000000008016D.quest_desc: [
		"Circonda un tavolo per incantesimi per sbloccare i suoi incantesimi più forti.",
		"Come: sei assi e tre libri. I libri sono carta più cuoio."
	]
	quest.420000000008016D.title: "Libreria"
	quest.420000000008016E.quest_desc: [
		"Cura a fondo e dà un bagliore che svanisce dopo un minuto.",
		"Come: otto d'oro intorno a una mela. Non quella incantata."
	]
	quest.420000000008016E.title: "Mela d'oro"
	quest.420000000008016F.quest_desc: [
		"Salta la caduta.",
		"Come: endermen, o la bancarella dei Camminabordi a /clowder hub."
	]
	quest.420000000008016F.title: "Perla di ender"
	quest.4200000000080170.quest_desc: [
		"Trasforma bottiglie d'acqua in qualcosa con un effetto vero.",
		"Come: verga di blaze sopra tre ciottoli. La verga viene da una fortezza del Nether, dopo l'ossidiana di Artiglio."
	]
	quest.4200000000080170.title: "Alambicco"
	quest.4200000000080171.quest_desc: [
		"Calore per le pozioni.",
		"Come: creala da una verga di blaze, oppure in una fortezza dopo l'ossidiana di Artiglio."
	]
	quest.4200000000080171.title: "Polvere di blaze"
	quest.4200000000080172.quest_desc: [
		"Alimenta l'alambicco e prova che hai già affrontato il Nether.",
		"Come: fortezza del Nether dopo l'ossidiana di Artiglio. Le pozioni vogliono una verga; Ars e Occultism non la aspettano."
	]
	quest.4200000000080172.title: "Verga di blaze"
	quest.4200000000080173.quest_desc: [
		"Piega l'effetto di una pozione in qualcosa di peggio, apposta.",
		"Come: occhio di ragno, fungo marrone, zucchero."
	]
	quest.4200000000080173.title: "Occhio fermentato"
	quest.4200000000080174.quest_desc: [
		"Polvere di pietra luminosa per le ricette.",
		"Come: setaccia sabbia delle anime, oppure streghe sulla piattaforma."
	]
	quest.4200000000080174.title: "Polvere di pietra luminosa (Sigillo)"
	quest.4200000000080175.quest_desc: [
		"Soffio di ciò che custodisce l'End.",
		"Come: bottiglia di vetro sul drago. L'isola dell'End non c'è più. Facoltativo."
	]
	quest.4200000000080175.title: "Soffio di drago"
	quest.4200000000080176.quest_desc: [
		"Un'altra possibilità.",
		"Facoltativo — nessun raid raggiunge la piattaforma, e il pack non ne fabbrica uno.",
		"Come: solo ricompense delle missioni. Sistema Orologio e Sistema Sigillo ne danno uno ciascuno, e i doni dei Nodi di Filo tardivi ne offrono altri. I raid e gli evocatori non arrivano mai sulla piattaforma. Facoltativo."
	]
	quest.4200000000080176.title: "Totem"
	quest.4200000000080177.quest_desc: [
		"Conserva la Fonte, il combustibile che gli incantesimi bruciano.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.4200000000080177.title: "Fonte gemma"
	quest.4200000000080178.quest_desc: [
		"Coltivato, non trovato. Legno per strumenti di lancio e piedistalli degli incantesimi.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.4200000000080178.title: "Legno arcano"
	quest.4200000000080179.quest_desc: [
		"I primi incantesimi. Magia alla pari, se la vuoi accanto ai riti.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.4200000000080179.title: "Libro degli incantesimi per principianti"
	quest.420000000008017A.quest_desc: [
		"Una coltura arcana, cresciuta tanto per la stoffa quanto per la magia.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008017A.title: "Magebloom"
	quest.420000000008017B.quest_desc: [
		"Braciere per il lavoro rituale.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008017B.title: "Braciere rituale"
	quest.420000000008017C.quest_desc: [
		"Espone un reagente e lo passa al rito che ne ha bisogno.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008017C.title: "Piedistallo arcano"
	quest.420000000008017D.quest_desc: [
		"Scrivi incantesimi e pagine.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008017D.title: "Tavolo degli scribi"
	quest.420000000008017E.quest_desc: [
		"Infondi i reagenti di fonte.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008017E.title: "Camera di impregnazione"
	quest.420000000008017F.quest_desc: [
		"Conserva Fonte in più, così un incantesimo non resta a secco a metà lancio.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008017F.title: "Fonte Vaso"
	quest.4200000000080180.quest_desc: [
		"Chiama gli spiriti per nome.",
		"Come: un libro e Semi del sogno del demone, senza forma. Leggilo; il Fuoco spirituale è il passo dopo."
	]
	quest.4200000000080180.title: "Dizionario di Occultism"
	quest.4200000000080181.quest_desc: [
		"Una fiamma fredda per i riti che il fuoco normale non conclude.",
		"Come: accendi il Fuoco spirituale come mostra il Dizionario degli spiriti (Brucia!), poi lascia cadere andesite dentro."
	]
	quest.4200000000080181.title: "Fuoco spirituale"
	quest.4200000000080182.quest_desc: [
		"Un focus per evocare. I riti sono pazienti.",
		"Come: oro intorno a una ciotola sacrificale. Il dizionario nomina il rito."
	]
	quest.4200000000080182.title: "Ciotola sacrificale dorata"
	quest.4200000000080183.quest_desc: [
		"Il cuore della fabbricazione basata sull'aura, accordato alla terra intorno.",
		"Come: Rituale della foresta (JEI): tre pietre, una Foglia d'oro, un lingotto d'oro e un Gettone della gioia. Linea del Cuore dell'aura."
	]
	quest.4200000000080183.title: "Natural Altar"
	quest.4200000000080184.quest_desc: [
		"Una pianta infusa da un'aura alta, filata in qualcosa di più raro.",
		"Come: quattro foglie e quattro pepite d'oro intorno all'erba corta fanno quattro Fibre brillanti. Mettila nella chioma di un albero; le sue foglie diventano dorate col tempo."
	]
	quest.4200000000080184.title: "Brilliant Fiber"
	quest.4200000000080185.quest_desc: [
		"Materiale toccato dall'aura, più prezioso di come sembra a terra.",
		"Come: rompi le foglie dorate cresciute dalla Fibra brillante."
	]
	quest.4200000000080185.title: "Gold Leaf"
	quest.4200000000080186.quest_desc: [
		"Ferro che ha assorbito l'aura ambiente, fino a valere più del minerale.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000080186.title: "Ferro infuso"
	quest.4200000000080187.quest_desc: [
		"Ti lascia vedere il livello di aura della terra intorno a te.",
		"Come: Foglia d'oro + occhio di ragno. Mostra l'aura locale."
	]
	quest.4200000000080187.title: "Occhio"
	quest.4200000000080188.quest_desc: [
		"Un gettone di gioia. L'Altare naturale e l'Assorbitore erbivoro si costruiscono su uno.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000080188.title: "Token of Joy"
	quest.4200000000080189.quest_desc: [
		"Scorta di pergamena per incantesimi.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.4200000000080189.title: "Incantesimo Pergamena"
	quest.420000000008018A.quest_desc: [
		"Segna un punto a cui tornare con una parola, non a piedi.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008018A.title: "Pergamena deformante"
	quest.420000000008018B.quest_desc: [
		"Piantala, curala e raccogli stoffa intrisa di magia bassa.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008018B.title: "Coltura di fiore del mago"
	quest.420000000008018C.quest_desc: [
		"La pagina vuota su cui si scrive un incantesimo.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.420000000008018C.title: "Glifo vuoto"
	quest.420000000008018D.quest_desc: [
		"Lancia incantesimi da combattimento senza mai toccare una bacchetta.",
		"Come: tre catene, quattro cuoio e due carte. Il capitolo degli incantesimi nomina l'inchiostro."
	]
	quest.420000000008018D.title: "Libro degli incantesimi di Iron"
	quest.420000000008018E.quest_desc: [
		"Il combustibile che i lanciatori bruciano, incantesimo dopo incantesimo.",
		"Come: uccidi i lanciatori o fabbrica ciò che elenca JEI. Combustibile per inchiostro e libri."
	]
	quest.420000000008018E.title: "Essenza arcana"
	quest.420000000008018F.quest_desc: [
		"Inscrive un incantesimo su un libro, un grado alla volta.",
		"Come: bottiglia + essenza + tintura. Il primo inchiostro d'iscrizione."
	]
	quest.420000000008018F.title: "Inchiostro comune"
	quest.4200000000080190.quest_desc: [
		"Colore per i riti.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000080190.title: "Fiore mistico"
	quest.4200000000080191.quest_desc: [
		"Eco dell'oscurità profonda.",
		"Facoltativo — il vuoto potrebbe non offrirtelo mai.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000080191.title: "Scheggia d'eco"
	quest.4200000000080192.quest_desc: [
		"Una treccia filata, pozioni imbottigliate, incantesimi e spiriti chiamati.",
		"Metti tensione al Filo: gli Intagliatori di sigilli rispondono.",
		"Reclamalo e scegli un dono della tribù: un Filo del Ritorno per una vita condivisa in più, oppure scorte.",
		"Come: finisci le missioni collegate a questa, poi reclamala per il gettone di Filo. Incastona il gettone al tuo Palo di tensione."
	]
	quest.4200000000080192.quest_subtitle: "Legare"
	quest.4200000000080192.title: "Nodo di Sigillo"
	quest.4200000000080193.quest_desc: [
		"Clic destro sul Palo di tensione del tuo Clowder con il gettone.",
		"La tacca si accende, la tribù rintocca, la piattaforma cambia.",
		"Ricompensa rara: una vita condivisa del Clowder, una volta sola per tutta la squadra. Nella campagna ne esistono solo sei.",
		"Come: clic destro sul tuo Palo di tensione con il gettone di Filo in mano."
	]
	quest.4200000000080193.title: "Siedi il Sigillo"
	quest.4200000000080194.quest_desc: [
		"Una mela che i custodi non mangiarono mai. Nemmeno tu dovresti, probabilmente.",
		"Come: non è una fabbricazione della piattaforma. Segreto facoltativo — non sbarra il Nodo di Sigillo."
	]
	quest.4200000000080194.title: "Oro vecchio"
	quest.4200000000090195.quest_desc: [
		"Una maglia di ferro, ghiaia o sabbia, pazienza.",
		"Il Filamento di Filo è il filo proprio del Telaio. La treccia si fila da quello.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: maglia di Filo (ferro) su ghiaia, sabbia o polvere (Cornice del telaio o setaccio)."
	]
	quest.4200000000090195.title: "Fila il Filamento"
	quest.4200000000090196.quest_desc: [
		"Sedici Filamenti, un clic destro sul Palo di tensione.",
		"Il legame è cominciato; si comincia qui a ritessere.",
		"Come: clic destro sul Palo di tensione tenendo 16 Filamenti di Filo. Setaccia ghiaia o sabbia con una maglia di Filo di ferro per trovarli."
	]
	quest.4200000000090196.title: "Congiungi una treccia"
	quest.4200000000090197.quest_desc: [
		"Quarzo Certus — il filo freddo di un telaio digitale.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.4200000000090197.title: "Trama fredda"
	quest.4200000000090198.quest_desc: [
		"Quarzo macinato, il materiale di base da cui si costruisce il telaio digitale.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.4200000000090198.title: "Polvere di Certus"
	quest.4200000000090199.quest_desc: [
		"Il blocco involucro di ogni macchina della rete, estratto dai giacimenti di Certus.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.4200000000090199.title: "Roccia del cielo"
	quest.420000000009019A.quest_desc: [
		"Fluix — certus, quarzo e redstone caricati in acqua.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.420000000009019A.title: "Ordito carico"
	quest.420000000009019B.quest_desc: [
		"Un miscuglio di quarzo, redstone e vetro, macinato fine per fabbricare in rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.420000000009019B.title: "Polvere di Fluix"
	quest.420000000009019C.quest_desc: [
		"Silicio per i processori di AE2.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.420000000009019C.title: "Silicone"
	quest.420000000009019D.quest_desc: [
		"L'incisore pressa i circuiti come il Telaio pressa la stoffa.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.420000000009019D.title: "Premi il motivo"
	quest.420000000009019E.quest_desc: [
		"Stampa una piastra di silicio come il Telaio pressa la stoffa.",
		"Come: blocco di ferro, Nodo legante, ferro e quarzo. AE2 duplica solo una pressa che hai già."
	]
	quest.420000000009019E.title: "Stampo di silicone per incisore"
	quest.420000000009019F.quest_desc: [
		"Stampa la matrice di un processore logico, una pressata alla volta.",
		"Come: blocco di ferro, Nodo legante, ferro e oro. La prima copia è il mestiere del Nodo."
	]
	quest.420000000009019F.title: "Pressa logica"
	quest.42000000000901A0.quest_desc: [
		"Stampa la matrice di un processore di calcolo.",
		"Come: blocco di ferro, Nodo legante, ferro e certus (setaccio, sabbia). La prima copia è il mestiere del Nodo."
	]
	quest.42000000000901A0.title: "Pressa di calcolo"
	quest.42000000000901A1.quest_desc: [
		"Fabbricazione della matrice d'ingegneria.",
		"Come: blocco di ferro, Nodo legante, ferro e diamante. La prima copia è il mestiere del Nodo."
	]
	quest.42000000000901A1.title: "Pressa d'ingegneria"
	quest.42000000000901A2.quest_desc: [
		"Processore logico per AE2.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901A2.title: "Processore logico"
	quest.42000000000901A3.quest_desc: [
		"Un componente dei modelli di autofabbricazione, fatto di silicio e quarzo certus.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901A3.title: "Processore di calcolo"
	quest.42000000000901A4.quest_desc: [
		"Un processore più denso, necessario per le parti più esigenti della rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901A4.title: "Processore di ingegneria"
	quest.42000000000901A5.quest_desc: [
		"Ospita le celle che tengono tutto ciò che la rete ricorda.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901A5.title: "Drive ME"
	quest.42000000000901A6.quest_desc: [
		"Il guscio dentro cui si costruisce una cella di stoccaggio.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901A6.title: "Alloggiamento di cella di oggetti"
	quest.42000000000901A7.quest_desc: [
		"Il primo baule digitale.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901A7.title: "Cella di oggetti da 1k"
	quest.42000000000901A8.quest_desc: [
		"Vedi la rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901A8.title: "Terminale ME"
	quest.42000000000901A9.quest_desc: [
		"Ti lascia fabbricare direttamente da ciò che la rete già tiene.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901A9.title: "Terminale di fabbricazione"
	quest.42000000000901AA.quest_desc: [
		"Il controller. Vuole un Nodo legante al suo centro.",
		"Nucleo di Fuso.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901AA.title: "Telaio digitale"
	quest.42000000000901AB.quest_desc: [
		"Usalo a mani vuote e suona il Rito del cancello: colpisci i battiti che cadono su A, S, D, F. Raggiungi il 60% e si apre; non serve il Polso.",
		"Come: usa il Tamburo del cancello a mani vuote e suona il Rito del cancello: colpisci i battiti che cadono su A, S, D, F. Raggiungi il 60% e si apre; non serve il Polso. Lega prima una bussola del ritorno."
	]
	quest.42000000000901AB.title: "Tamburo della porta"
	quest.42000000000901AC.quest_desc: [
		"Un appoggio da oltre il cancello. Portane uno a casa.",
		"Come: fondi i Ciottoli della Marca. Estraili nella Marca, attraverso un Tamburo del cancello."
	]
	quest.42000000000901AC.title: "Pietra della Marcia"
	quest.42000000000901AD.quest_desc: [
		"Porta i canali della rete da una macchina alla successiva.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901AD.title: "Cavo di Fluix"
	quest.42000000000901AE.quest_desc: [
		"Tira gli oggetti nel deposito.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901AE.title: "Bus di importazione"
	quest.42000000000901AF.quest_desc: [
		"Spinge gli oggetti fuori dalla rete, in un baule o in una macchina.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901AF.title: "Bus di esportazione"
	quest.42000000000901B0.quest_desc: [
		"Legge un inventario esterno nella rete, come se fosse una cella.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B0.title: "Bus di stoccaggio"
	quest.42000000000901B1.quest_desc: [
		"Aggiunge capacità di fabbricazione in massa all'autofabbricazione della rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B1.title: "Unità di fabbricazione"
	quest.42000000000901B2.quest_desc: [
		"Fa correre più lavori di fabbricazione insieme.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B2.title: "Unità co-processore per fabbricazione"
	quest.42000000000901B3.quest_desc: [
		"Tiene modelli a cui la rete attinge mentre fabbrica.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B3.title: "Memoria di fabbricazione da 1k"
	quest.42000000000901B4.quest_desc: [
		"Alimenta le macchine di modelli, come un telaio alimenta la navetta di filo.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B4.title: "Fornitore di modelli"
	quest.42000000000901B5.quest_desc: [
		"Costruisce dai modelli. Vuole un Cordone di treccia nel cuore.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B5.title: "Assemblatore moleculare"
	quest.42000000000901B6.quest_desc: [
		"Un modello vuoto, in attesa di essere codificato con una ricetta.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B6.title: "Modello vuoto"
	quest.42000000000901B7.quest_desc: [
		"Alimenta il telaio digitale di energia.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B7.title: "Accettatore di energia"
	quest.42000000000901B8.quest_desc: [
		"Brucia per AE — ramo di energia facoltativo.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B8.title: "Camera vibrante"
	quest.42000000000901B9.quest_desc: [
		"Una cella di stoccaggio con più spazio della taglia precedente.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901B9.title: "Cella oggetti 4k"
	quest.42000000000901BA.quest_desc: [
		"Tiene molto più di qualsiasi cassa, la cella più densa prima che l'unità si riempia.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901BA.title: "Cella oggetti 16k"
	quest.42000000000901BB.quest_desc: [
		"Il guscio dentro cui si costruisce una cella per fluidi.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901BB.title: "Alloggiamento per cella fluidi"
	quest.42000000000901BC.quest_desc: [
		"Un serbatoio digitale, che tiene liquido che la rete può prelevare da ovunque.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901BC.title: "Cella fluidi 1k"
	quest.42000000000901BD.quest_desc: [
		"Posa blocchi dalla rete come farebbe una mano, senza averne una.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901BD.title: "Piano di formazione"
	quest.42000000000901BE.quest_desc: [
		"Rompe i blocchi davanti a sé e li manda nella rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901BE.title: "Piano di annientamento"
	quest.42000000000901BF.quest_desc: [
		"Redstone dalla rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901BF.title: "Emettitore di livello"
	quest.42000000000901C0.quest_desc: [
		"Collega la rete al mondo, scambiando oggetti oltre il bordo.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901C0.title: "Interfaccia"
	quest.42000000000901C1.quest_desc: [
		"Collega due reti a una distanza che il cavo normale non raggiunge.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901C1.title: "Anello quantico"
	quest.42000000000901C2.quest_desc: [
		"La metà accoppiata di un anello quantico, che lega due reti insieme.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901C2.title: "Collegamento quantico"
	quest.42000000000901C3.quest_desc: [
		"Raggiunge la rete da ovunque nel raggio, senza cavo sotto i piedi.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901C3.title: "Terminale wireless"
	quest.42000000000901C4.quest_desc: [
		"Copia le impostazioni di una macchina su un'altra senza riscriverle.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901C4.title: "Scheda per la memoria"
	quest.42000000000901C5.quest_desc: [
		"Strumento di rete per AE2.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901C5.title: "Attrezzo per sistema"
	quest.42000000000901C6.quest_desc: [
		"Carica il quarzo certus finché non è pronto per un lavoro più fine.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901C6.title: "Caricatore"
	quest.42000000000901C7.quest_desc: [
		"Accelera un bocciolo di cristallo in crescita verso un grappolo a grandezza piena.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000000901C7.title: "Acceleratore di crescita dei cristalli"
	quest.42000000000901C8.quest_desc: [
		"Prova della chioma della Marca — souvenir facoltativo del ritessere.",
		"Come: cresce selvatica nella Marca, sta nei forzieri dello sbarramento di canne, e un Anziano dei Legaradici lo scambia."
	]
	quest.42000000000901C8.title: "Canna di Spirito"
	quest.42000000000901C9.quest_desc: [
		"Una treccia, un telaio digitale, un varco, una pietra della Marca.",
		"Tendi il nono Filo. Poi il Frammento, poi il Palo.",
		"Reclamalo e scegli un dono della tribù: un Filo del Ritorno per una vita condivisa in più, oppure scorte.",
		"Come: finisci le missioni collegate a questa, poi reclamala per il gettone di Filo. Incastona il gettone al tuo Palo di tensione."
	]
	quest.42000000000901C9.quest_subtitle: "Ritessere"
	quest.42000000000901C9.title: "Nodo di Fuso"
	quest.42000000000901CA.quest_desc: [
		"Clic destro sul Palo di tensione del tuo Clowder con il gettone.",
		"La tacca si accende, la tribù rintocca, la piattaforma cambia.",
		"Come: clic destro sul tuo Palo di tensione con il gettone di Filo in mano."
	]
	quest.42000000000901CA.title: "Sistema Fuso"
	quest.42000000000901CB.quest_desc: [
		"Nove sistemati, una pietra della Marca, un clic destro sul Palo: il Frammento.",
		"Sistemalo. Il taglio si chiude sopra la tua piattaforma.",
		"Come: nove gettoni sistemati, poi clic destro sul Palo con la Pietra della Marca."
	]
	quest.42000000000901CB.quest_subtitle: "Ritessere"
	quest.42000000000901CB.title: "Frammento del telaio"
	quest.42000000000901CC.quest_desc: [
		"Sistema il Frammento sul Palo di tensione.",
		"Nove tribù, un filo. Va' a vedere che cosa la Marca ha tenuto per te.",
		"Ricompensa rara: una vita condivisa del Clowder, una volta sola per tutta la squadra. Nella campagna ne esistono solo sei.",
		"Come: sistema il Frammento del telaio di Fuso sul Palo di tensione. Il progresso scatta quando il cielo si chiude."
	]
	quest.42000000000901CC.quest_subtitle: "Il taglio, chiuso"
	quest.42000000000901CC.title: "Ritessere"
	quest.42000000000901CD.quest_desc: [
		"Un Wither, su una piattaforma, nel cielo. I Cucitori del telaio sarebbero rimasti colpiti, e poi furiosi.",
		"Come: Wither (tre teschi sulla sabbia delle anime), o il banco dei Cuori di tamburo a /clowder hub una volta, per 12 Rotoli di Filo (972 Filo). Trofeo facoltativo — non sbarra l'End né la Fattoria di mostri al 100%."
	]
	quest.42000000000901CD.title: "Una stella, in qualche modo"
	quest.42000000000A01CE.quest_desc: [
		"Le foglie lasciano più arboscelli.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01CE.title: "Basi del vincastro"
	quest.42000000000A01CF.quest_desc: [
		"Setaccia più in fretta del vincastro di legno, e dura molto di più.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01CF.title: "Bone Crook"
	quest.42000000000A01D0.quest_desc: [
		"La maglia più semplice. Tutto ciò che setacci inizia passando di qui.",
		"Come: nove spaghi in un 3x3. La bancarella dei Cantori di ghiaia vende la maglia di Filo (spago) del Telaio del vuoto, che setaccia uguale."
	]
	quest.42000000000A01D0.title: "String Mesh"
	quest.42000000000A01D1.quest_desc: [
		"Cattura schegge più fini dello spago. Meno scarti scivolano attraverso la tessitura.",
		"Come: quattro selci e cinque spaghi a scacchiera. La selce viene dalla ghiaia, o da Filo + ghiaia."
	]
	quest.42000000000A01D1.title: "Maglia di selce (setaccio)"
	quest.42000000000A01D2.quest_desc: [
		"I fili di ferro catturano graniglia più pesante e tirano scarti più rari dal mucchio.",
		"Come: quattro lingotti di ferro e cinque spaghi a scacchiera. Nessuna bancarella lo vende."
	]
	quest.42000000000A01D2.title: "Maglia di ferro (setaccio)"
	quest.42000000000A01D3.quest_desc: [
		"Maglia di livello oro. Le probabilità piegano verso i minerali che contano.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01D3.title: "Golden Mesh"
	quest.42000000000A01D4.quest_desc: [
		"Setaccia la ghiaia con questo e i diamanti saltano fuori molto più spesso.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01D4.title: "Diamond Mesh"
	quest.42000000000A01D5.quest_desc: [
		"La maglia più fine che esista. Niente setaccia meglio del filo di netherite.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01D5.title: "Netherite Mesh"
	quest.42000000000A01D6.quest_desc: [
		"Argilla rifinita liscia, pronta da cuocere in un crogiolo che regge un vero calore.",
		"Come: palla d'argilla + farina d'ossa, senza forma. L'argilla viene dal Barile di tensione."
	]
	quest.42000000000A01D6.title: "Argilla di porcellana (setaccio)"
	quest.42000000000A01D7.quest_desc: [
		"Argilla di porcellana modellata a crogiolo. Cuocilo in una fornace.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01D7.title: "Crogiolo crudo"
	quest.42000000000A01D8.quest_desc: [
		"Regge il calore della fusione senza creparsi. Fondi ciò che il setaccio ha tirato fuori.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01D8.title: "Porcelain Crucible"
	quest.42000000000A01D9.quest_desc: [
		"Spruzza acqua sulle colture senza calpestare i filari.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01D9.title: "Annaffiatoio di legno"
	quest.42000000000A01DA.quest_desc: [
		"Uno spruzzo più largo e un serbatoio più fondo. Annaffi più della piattaforma a ogni giro.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01DA.title: "Annaffiatoio di ferro"
	quest.42000000000A01DB.quest_desc: [
		"Lasciato sulle foglie, fila seta mentre mangia.",
		"Come: rompi le foglie con un vincastro; i bachi da seta cadono ogni tanto."
	]
	quest.42000000000A01DB.title: "Silkworm"
	quest.42000000000A01DC.quest_desc: [
		"Acqua strana che sospinge arboscelli e semi verso colture più strane.",
		"Come: una botte d'acqua sul micelio diventa acqua della strega; riempine un secchio. Le spore di micelio si setacciano dalla terra."
	]
	quest.42000000000A01DC.title: "Witch Water Bucket"
	quest.42000000000A01DD.quest_desc: [
		"Spargile e il micelio striscia verso fuori, blocco dopo paziente blocco.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01DD.title: "Mycelium Spores"
	quest.42000000000A01DE.quest_desc: [
		"Gettale sulla terra e l'erba si allarga senza aspettare la pioggia.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01DE.title: "Grass Seeds"
	quest.42000000000A01DF.quest_desc: [
		"La graniglia che sostituisce i ciottoli. Rimettila nel martello per averne altra.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01DF.title: "Stone Pebble"
	quest.42000000000A01E0.quest_desc: [
		"Nove ciottoli pressati in pietra da deposito, per una piattaforma che cresce.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01E0.title: "Ciottoli compressi"
	quest.42000000000A01E1.quest_desc: [
		"Rompe i ciottoli in ghiaia più in fretta di ogni martello prima di lui.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01E1.title: "Netherite Hammer"
	quest.42000000000A01E2.quest_desc: [
		"Pietra del Nether, frantumata fine. Basalto e pietra nera partono entrambi da qui.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01E2.title: "Blackstone Pebble"
	quest.42000000000A01E3.quest_desc: [
		"Ardesia profonda ridotta in graniglia, pronta di nuovo per il setaccio.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01E3.title: "Deepslate Pebble"
	quest.42000000000A01E4.quest_desc: [
		"Pietra pallida tirata da un setaccio profondo, soprattutto buona da costruire.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01E4.title: "Calcite"
	quest.42000000000A01E5.quest_desc: [
		"Pietra grigia dalle profondità, semplice e facile da sagomare.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000000A01E5.title: "Tufo"
	quest.42000000000A01E6.quest_desc: [
		"Cresce lento sottoterra; impilalo e lascialo gocciolare di nuovo in stalattiti.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000A01E6.title: "Speleotema"
	quest.42000000000A01E7.quest_desc: [
		"Assorbe in fretta l'acqua ferma, utile dopo una fattoria allagata.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000A01E7.title: "Spugna"
	quest.42000000000B01E8.quest_desc: [
		"Collega il deposito intorno in un'unica rete consultabile.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: una botte di legno o un baule, due comparatori, assi e pietra. Collega le botti Sophisticated vicine."
	]
	quest.42000000000B01E8.title: "Storage Controller"
	quest.42000000000B01E9.quest_desc: [
		"Una botte che si potenzia: filtri, tramogge, magneti, vuoto.",
		"Come: potenzia una botte con il rame. JEI indica la fabbricazione."
	]
	quest.42000000000B01E9.title: "Botte di rame"
	quest.42000000000B01EA.quest_desc: [
		"Più scomparti, più file di migliorie.",
		"Come: barili e migliorie in JEI. Il controller lega insieme un muro di barili."
	]
	quest.42000000000B01EA.title: "Barile di ferro"
	quest.42000000000B01EB.quest_desc: [
		"Tira gli oggetti caduti dritti nel barile, dall'altra parte della piattaforma.",
		"Come: barili e migliorie in JEI. Il controller lega insieme un muro di barili."
	]
	quest.42000000000B01EB.title: "Advanced Magnet Upgrade"
	quest.42000000000B01EC.quest_desc: [
		"Entra da un lato, esce dall'altro, senza un blocco tramoggia.",
		"Come: barili e migliorie in JEI. Il controller lega insieme un muro di barili."
	]
	quest.42000000000B01EC.title: "Hopper Upgrade"
	quest.42000000000B01ED.quest_desc: [
		"Cancella tutto ciò che supera la capacità, così il cassetto non si inceppa mai.",
		"Come: barili e migliorie in JEI. Il controller lega insieme un muro di barili."
	]
	quest.42000000000B01ED.title: "Miglioria del vuoto"
	quest.42000000000B01EE.quest_desc: [
		"Tira gli oggetti vicini dritti nello stoccaggio su cui è montata.",
		"Come: barili e migliorie in JEI. Il controller lega insieme un muro di barili."
	]
	quest.42000000000B01EE.title: "Miglioria di raccolta"
	quest.42000000000B01EF.quest_desc: [
		"Uno scomparto, ordinato e visibile. Il modo più semplice di tenere oggetti in massa.",
		"Come: tronchi di quercia + cassa. Primo cassetto."
	]
	quest.42000000000B01EF.title: "Cassetto di quercia 1x1"
	quest.42000000000B01F0.quest_desc: [
		"Due scomparti affiancati, per tenere separati gli oggetti simili.",
		"Come: cassetti di quercia 1x1 / 1x2 / 2x2, poi cassetto compattatore e controller. JEI nomina la ricetta."
	]
	quest.42000000000B01F0.title: "Cassetto di quercia 1x2"
	quest.42000000000B01F1.quest_desc: [
		"Quattro scomparti in una cornice. Stoccaggio denso, poco ingombro.",
		"Come: cassetti di quercia 1x1 / 1x2 / 2x2, poi cassetto compattatore e controller. JEI nomina la ricetta."
	]
	quest.42000000000B01F1.title: "Cassetto di quercia 2x2"
	quest.42000000000B01F2.quest_desc: [
		"Compatta da solo ciò che contiene in blocchi, man mano che si riempie.",
		"Come: cassetti di quercia 1x1 / 1x2 / 2x2, poi cassetto compattatore e controller. JEI nomina la ricetta."
	]
	quest.42000000000B01F2.title: "Cassettiera compattante"
	quest.42000000000B01F3.quest_desc: [
		"Collega il deposito intorno in un'unica rete consultabile.",
		"Come: cassetti di quercia 1x1 / 1x2 / 2x2, poi cassetto compattatore e controller. JEI nomina la ricetta."
	]
	quest.42000000000B01F3.title: "Controller di stoccaggio (Stoccaggio)"
	quest.42000000000B01F4.quest_desc: [
		"Tira gli oggetti vicini dritti nel cassetto.",
		"Come: cassetti di quercia 1x1 / 1x2 / 2x2, poi cassetto compattatore e controller. JEI nomina la ricetta."
	]
	quest.42000000000B01F4.title: "Miglioramento del raccoglitore"
	quest.42000000000B01F5.quest_desc: [
		"Tira gli oggetti dalla cassa o dalla macchina messa accanto.",
		"Come: cassetti di quercia 1x1 / 1x2 / 2x2, poi cassetto compattatore e controller. JEI nomina la ricetta."
	]
	quest.42000000000B01F5.title: "Miglioramento di inserimento"
	quest.42000000000B01F6.quest_desc: [
		"Spinge gli oggetti tenuti nell'inventario che sta accanto.",
		"Come: cassetti di quercia 1x1 / 1x2 / 2x2, poi cassetto compattatore e controller. JEI nomina la ricetta."
	]
	quest.42000000000B01F6.title: "Miglioramento di espulsione"
	quest.42000000000B01F7.quest_desc: [
		"Cancella tutto ciò che supera la capacità, così il cassetto non si inceppa mai.",
		"Come: cassetti di quercia 1x1 / 1x2 / 2x2, poi cassetto compattatore e controller. JEI nomina la ricetta."
	]
	quest.42000000000B01F7.title: "Miglioria del vuoto (Stoccaggio)"
	quest.42000000000B01F8.quest_desc: [
		"Un inventario portatile che libera la barra rapida e lo spazio delle tasche.",
		"Come: cuoio + cassa. Poi migliorie di ferro/oro/diamante."
	]
	quest.42000000000B01F8.title: "Backpack"
	quest.42000000000B01F9.quest_desc: [
		"Più scomparti rispetto allo zaino semplice, e uno scomparto per migliorarlo.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B01F9.title: "Iron Backpack"
	quest.42000000000B01FA.quest_desc: [
		"Ancora più capiente, con scomparti liberi per migliorie utili.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B01FA.title: "Gold Backpack"
	quest.42000000000B01FB.quest_desc: [
		"Le tasche più profonde, prima che l'incantesimo spinga lo stoccaggio ancora oltre.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B01FB.title: "Diamond Backpack"
	quest.42000000000B01FC.quest_desc: [
		"Tira gli oggetti vicini dritti nello stoccaggio su cui è montata.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B01FC.title: "Miglioria di raccolta (Stoccaggio)"
	quest.42000000000B01FD.quest_desc: [
		"Filtra ciò che entra negli zaini.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B01FD.title: "Filter Upgrade"
	quest.42000000000B01FE.quest_desc: [
		"Lascia che lo zaino fabbrichi con ciò che ha già dentro.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B01FE.title: "Crafting Upgrade"
	quest.42000000000B01FF.quest_desc: [
		"Ti nutre in automatico con le sue scorte quando la fame scende.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B01FF.title: "Feeding Upgrade"
	quest.42000000000B0200.quest_desc: [
		"Scambia un attrezzo rotto con uno nuovo dallo zaino.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B0200.title: "Restock Upgrade"
	quest.42000000000B0201.quest_desc: [
		"Svuota lo zaino nelle casse vicine quando ti avvicini.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B0201.title: "Deposit Upgrade"
	quest.42000000000B0202.quest_desc: [
		"Aggiunge un serbatoio di fluidi nello zaino, per portare liquidi.",
		"Come: zaino di cuoio, poi migliorie di ferro/oro/diamante in JEI."
	]
	quest.42000000000B0202.title: "Tank Upgrade"
	quest.42000000000C0203.quest_desc: [
		"Il metallo di base della maggior parte delle macchine e degli involucri di questa linea.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0203.title: "Lingotto d'acciaio"
	quest.42000000000C0204.quest_desc: [
		"Il metallo centrale della maggior parte dei cavi, dei serbatoi e delle prime macchine.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0204.title: "Lingotto di osmio"
	quest.42000000000C0205.quest_desc: [
		"Una lega dura, pressata da polvere di ossidiana, per un equipaggiamento più robusto.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0205.title: "Ossidiana raffinata"
	quest.42000000000C0206.quest_desc: [
		"La scheda logica più semplice. La maggior parte delle prime macchine ne vuole qualcuna.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0206.title: "Circuito di Controllo Base"
	quest.42000000000C0207.quest_desc: [
		"Una scheda logica più affilata, per le macchine un gradino più su nella linea.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0207.title: "Circuito di controllo avanzato"
	quest.42000000000C0208.quest_desc: [
		"La scheda logica più affilata, riservata alle macchine in cima alla linea.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0208.title: "Circuito di Controllo Élite"
	quest.42000000000C0209.quest_desc: [
		"Infonde i metalli di carbonio, redstone o polvere di diamante prima di fonderli.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0209.title: "Infusore metallurgico"
	quest.42000000000C020A.quest_desc: [
		"Raddoppia la maggior parte dei minerali grezzi in due polveri invece di una.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C020A.title: "Camera di arricchimento"
	quest.42000000000C020B.quest_desc: [
		"Macina o frantuma materiali in blocco.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C020B.title: "Polverizzatore"
	quest.42000000000C020C.quest_desc: [
		"Fonde i minerali a energia invece che a combustibile, e un po' più in fretta.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C020C.title: "Fonderia elettrica"
	quest.42000000000C020D.quest_desc: [
		"Purifica il minerale arricchito con l'ossigeno per un terzo prodotto, a volte di più.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C020D.title: "Camera di purificazione"
	quest.42000000000C020E.quest_desc: [
		"Inietta gas nel minerale per il prodotto più ricco che offre la linea.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C020E.title: "Iniezione chimica"
	quest.42000000000C020F.quest_desc: [
		"Comprime la polvere di osmio in lingotti, più in fretta di una fornace da sola.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C020F.title: "Compressore di osmio"
	quest.42000000000C0210.quest_desc: [
		"Un solo scomparto per pila, che tiene molto più di quanto possa una cassa.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0210.title: "Contenitore base"
	quest.42000000000C0211.quest_desc: [
		"Conserva una pozza profonda di un solo fluido in un solo blocco.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0211.title: "Tanica base"
	quest.42000000000C0212.quest_desc: [
		"Ammortizza l'energia tra le macchine, così i picchi non fermano la linea.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0212.title: "Cubo di energia base"
	quest.42000000000C0213.quest_desc: [
		"Porta l'energia alle macchine. Il cavo più comune della piattaforma.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0213.title: "Cavo universale base"
	quest.42000000000C0214.quest_desc: [
		"Sposta i fluidi tra serbatoi e macchine lungo la piattaforma.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0214.title: "Tubo meccanico base"
	quest.42000000000C0215.quest_desc: [
		"Sposta automaticamente gli oggetti tra gli inventari collegati.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0215.title: "Trasportatore logistico base"
	quest.42000000000C0216.quest_desc: [
		"Ruota, fa da chiave e riconfigura le facce delle macchine con un solo attrezzo.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0216.title: "Configuratore"
	quest.42000000000C0217.quest_desc: [
		"Zaino a reazione Mek — spinta facoltativa.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0217.title: "Jetpack"
	quest.42000000000C0218.quest_desc: [
		"Ammorbidisce i danni da caduta e ti compra un secondo prima che il vuoto ti prenda.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0218.title: "Protesi Performanti"
	quest.42000000000C0219.quest_desc: [
		"Un solo attrezzo che scava, taglia e combatte, più affilato a ogni potenziamento.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C0219.title: "Disassemblatore atomico"
	quest.42000000000C021A.quest_desc: [
		"Il telaio strutturale attorno a cui si costruisce la maggior parte delle macchine multiblocco.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C021A.title: "Telaio in acciaio"
	quest.42000000000C021B.quest_desc: [
		"Collega due punti: attraversandoli salti la camminata in mezzo.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C021B.title: "Teletrasportatore"
	quest.42000000000C021C.quest_desc: [
		"Scava da solo un ampio raggio e smista il raccolto per te.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000000C021C.title: "Scavatrice digitale"
	quest.42000000000D021D.quest_desc: [
		"Un ingrediente di base appiccicoso, all'origine di quasi tutte le macchine della rete.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D021D.title: "Dielectric Paste"
	quest.42000000000D021E.quest_desc: [
		"Accumula una misura di energia.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D021E.title: "Condensatore di base"
	quest.42000000000D021F.quest_desc: [
		"Tiene una riserva profonda di energia per le macchine intorno.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D021F.title: "Cella di energia di base"
	quest.42000000000D0220.quest_desc: [
		"Brucia il combustibile in energia, meglio di una semplice fornace.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0220.title: "Bruciatore di base"
	quest.42000000000D0221.quest_desc: [
		"Trasforma la lava in energia costante finché la lava dura.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0221.title: "Bruciatore di magma di base"
	quest.42000000000D0222.quest_desc: [
		"Genera energia dalla luce del giorno, più di quanto una sola cella faccia da sola.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0222.title: "Pannello solare di base"
	quest.42000000000D0223.quest_desc: [
		"Genera energia dallo scarto di calore tra i blocchi caldi e freddi vicini.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0223.title: "Generatore termico di base"
	quest.42000000000D0224.quest_desc: [
		"Brucia combustibile solido in modo costante, per un rivolo di energia forte e affidabile.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0224.title: "Reattore base"
	quest.42000000000D0225.quest_desc: [
		"Muove più energia per tick del cavo iniziale.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0225.title: "Cavo di energia base"
	quest.42000000000D0226.quest_desc: [
		"Ti carica direttamente, senza cavi né scomparti.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0226.title: "Trasmettitore del giocatore base"
	quest.42000000000D0227.quest_desc: [
		"Alimenta di energia le macchine vicine, come una tramoggia alimenta di oggetti.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0227.title: "Tramoggia di energia base"
	quest.42000000000D0228.quest_desc: [
		"Carica le celle energizzanti più in fretta se posto accanto al complesso di cristallo.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0228.title: "Verga energizzante base"
	quest.42000000000D0229.quest_desc: [
		"Una riserva di energia da tasca, da portare a mano da una macchina all'altra.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D0229.title: "Batteria base"
	quest.42000000000D022A.quest_desc: [
		"Il primo grado di cristallo per la camera delle celle della verga energizzante.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D022A.title: "Niotic Crystal"
	quest.42000000000D022B.quest_desc: [
		"Un grado di cristallo più forte, più avanti nella costruzione della camera energizzante.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D022B.title: "Spirited Crystal"
	quest.42000000000D022C.quest_desc: [
		"Il grado di cristallo più forte che la camera energizzante può contenere.",
		"Come: capitolo Rete Powah — globo energizzante e cavi, dopo che esiste il Pulso di Scintilla."
	]
	quest.42000000000D022C.title: "Nitro Crystal"
	quest.42000000000E022D.quest_desc: [
		"Filata dal fior di mago e tessuta in vesti e attrezzatura da incantesimo.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E022D.title: "Fibra di mago"
	quest.42000000000E022E.quest_desc: [
		"Un fiore che, dopo il raccolto, rifà la fibra sullo stelo.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E022E.title: "Magebloom"
	quest.42000000000E022F.quest_desc: [
		"Conserva una vasca densa di fonte, il combustibile dietro ogni incantesimo.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E022F.title: "Blocco gemma di origine"
	quest.42000000000E0230.quest_desc: [
		"Tiene più glifi di quanti ne permetta il libro iniziale.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0230.title: "Libro degli incantesimi dell'apprendista"
	quest.42000000000E0231.quest_desc: [
		"Il libro degli incantesimi più grande, con spazio per un arsenale intero di glifi.",
		"Come: Libro degli incantesimi del mago, tre perle di ender, due smeraldi, un Totem dell'immortalità, una Stella del Nether e un Tributo wilden, senza forma. Totem: ricetta del pack, quattro blocchi d'oro e quattro smeraldi intorno a una mela d'oro."
	]
	quest.42000000000E0231.title: "Libro degli incantesimi dell'arcimago"
	quest.42000000000E0232.quest_desc: [
		"Lancia un incantesimo vincolato in automatico appena avverte un bersaglio.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0232.title: "Torretta di incantesimi"
	quest.42000000000E0233.quest_desc: [
		"Lancia il suo incantesimo vincolato a un timer costante, non a vista.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0233.title: "Torretta degli incantesimi del timer"
	quest.42000000000E0234.quest_desc: [
		"Il pezzo centrale per fabbricare libri degli incantesimi, bacchette e altra attrezzatura arcana.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0234.title: "Apparato Incantevole"
	quest.42000000000E0235.quest_desc: [
		"Sta dentro l'apparato d'incantamento e fa girare le sue ricette.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0235.title: "Nucleo arcano"
	quest.42000000000E0236.quest_desc: [
		"Porta fonte tra un punto arcano e un vaso o un incantesimo collegato.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0236.title: "Relè"
	quest.42000000000E0237.quest_desc: [
		"Divide una linea di fonte, così da nutrire più posti insieme.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0237.title: "Divisore di relè"
	quest.42000000000E0238.quest_desc: [
		"Converte la crescita delle colture vicine in un lento filo di fonte.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0238.title: "Agronomic Sourcelink"
	quest.42000000000E0239.quest_desc: [
		"Converte il calore della lava vicina in un filo costante di fonte.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0239.title: "Fonte vulcanica"
	quest.42000000000E023A.quest_desc: [
		"Evoca una wixie che fabbrica ricette per te mentre lavori altrove.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E023A.title: "Fascino Wixie"
	quest.42000000000E023B.quest_desc: [
		"Evoca uno starbuncle che, a comando, prende oggetti dal deposito.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E023B.title: "Fascino Starbuncle"
	quest.42000000000E023C.quest_desc: [
		"Evoca un drygmy che genera piano, lì vicino, una risorsa scelta.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E023C.title: "Fascino secco"
	quest.42000000000E023D.quest_desc: [
		"Evoca un whirlisprig che cura le colture e le fa crescere da solo.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E023D.title: "Fascino Whirlisprig"
	quest.42000000000E023E.quest_desc: [
		"Evoca un golem che raccoglie i boccioli di ametista senza alzare un piccone.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E023E.title: "Fascino del golem di ametista"
	quest.42000000000E023F.quest_desc: [
		"Raccoglie e piazza blocchi a distanza, collegando le macchine fra loro da lontano.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E023F.title: "Bacchetta del dominio"
	quest.42000000000E0240.quest_desc: [
		"Segna un oggetto come permesso quando lo metti in un filtro.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0240.title: "Pergamena di permesso"
	quest.42000000000E0241.quest_desc: [
		"Segna un oggetto come negato quando lo metti in un filtro.",
		"Come: Lato arcano — legno arcano e bacca di fonte dal muschio, poi la cascata."
	]
	quest.42000000000E0241.title: "Pergamena di divieto"
	quest.42000000000F0242.quest_desc: [
		"Tronchi intorno a un Nodo legante, Filo sopra. Piazzalo sulla piattaforma.",
		"Stai vicino: la piattaforma inizia a curarti quando un Filo è sistemato.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: tronchi intorno a un Nodo legante, Filo sopra. Piazzalo sulla piattaforma. Guardalo per completare."
	]
	quest.42000000000F0242.title: "Alza il Palo"
	quest.42000000000F0243.quest_desc: [
		"Chiave del nodo in mano, oppure /clowder hub. Ogni Clowder del server si riunisce qui.",
		"/clowder return ti riporta a casa.",
		"Come: Chiave del nodo oppure `/clowder hub`. `/clowder return` torna a casa."
	]
	quest.42000000000F0243.title: "Entra nella Sala"
	quest.42000000000F0244.quest_desc: [
		"Sopra il Molo si alza una lenta colonna scura: il taglio stesso.",
		"Si assottiglia man mano che i Clowders sistemano i Fili. Torna ogni tanto a controllarla.",
		"Come: /clowder hub, guarda in alto la colonna scura sopra il Molo, poi clicca la spunta."
	]
	quest.42000000000F0244.title: "Guarda lo Sfilaccio"
	quest.42000000000F0245.quest_desc: [
		"Metti una piattaforma a tuo nome.",
		"Come: K apre il pannello dell'isola. Tieni la Carta; usala accovacciato sul suolo di una piattaforma dell'Overworld per sigillare l'apparizione. Inizia qui elenca i passi."
	]
	quest.42000000000F0245.title: "Carta dell'isola"
	quest.42000000000F0246.quest_desc: [
		"Apre la via del ritorno alla Sala Clowder, da qualunque punto del Filo.",
		"Come: kit iniziale / Sala. `/clowder hub` e la Chiave del nodo vanno alla Sala Clowder; `/clowder return` torna a casa."
	]
	quest.42000000000F0246.title: "Chiave del nodo"
	quest.42000000000F0247.quest_desc: [
		"Un modello di stendardo che segna quanto è arrivato il tuo Filo.",
		"Come: fabbricalo nella Sala o in JEI. Un marchio di stendardo, non un gettone di Filo."
	]
	quest.42000000000F0247.title: "Stendardo di Filo"
	quest.42000000000F0248.quest_desc: [
		"L'accento grave (`) apre la lista degli incarichi. Clic destro sul Codice dei Baffi per Inizia qui. Stessa campagna; niente clic con Maiusc sul libro.",
		"Come: un libro e una pietra qualsiasi, senza forma. L'accento grave (`) apre la stessa lista senza di esso."
	]
	quest.42000000000F0248.title: "Lista degli incarichi"
	quest.42000000000F0249.quest_desc: [
		"Resta sazio nelle uscite di rivendicazione.",
		"Come: otto pepite d'oro intorno a una carota. Le carote sono un raro bottino degli zombie; lo spuntino è facoltativo."
	]
	quest.42000000000F0249.title: "Spuntino di rivendicazione"
	quest.42000000000F024A.quest_desc: [
		"Traccia le piattaforme intorno a te mentre il tuo Clowder si allarga verso l'esterno.",
		"Come: una bussola circondata da carta."
	]
	quest.42000000000F024A.title: "Mappa"
	quest.42000000000F024B.quest_desc: [
		"Punta verso il punto di apparizione del mondo; utile quando le piattaforme si moltiplicano.",
		"Come: ferro intorno alla redstone."
	]
	quest.42000000000F024B.title: "Bussola"
	quest.42000000000F024C.quest_desc: [
		"Ancora una bussola a un punto esatto, invece del punto di apparizione.",
		"Come: un lingotto di netherite in mattoni di pietra cesellati. Lusso tardo del Clowder."
	]
	quest.42000000000F024C.title: "Magnetite"
	quest.42000000000F024D.quest_desc: [
		"Punta verso la tua ultima morte, così niente resta perso nel vuoto.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000F024D.title: "Bussola di recupero"
	quest.42000000000F024E.quest_desc: [
		"Suona forte abbastanza da radunare tutto il Clowder su una piattaforma.",
		"Come: nessuna ricetta. Il rituale Contatta lo spirito selvaggio di Occultism ne crea uno, ma serve una capra, e le capre non raggiungono mai la piattaforma. Facoltativo."
	]
	quest.42000000000F024E.title: "Campana"
	quest.42000000000F024F.quest_desc: [
		"Tiene un libro aperto perché tutto il Clowder lo legga.",
		"Come: lastre di legno intorno a una libreria."
	]
	quest.42000000000F024F.title: "Leggio"
	quest.42000000000F0250.quest_desc: [
		"Etichetta un distretto, così i nuovi arrivati sanno quale piattaforma è quale.",
		"Come: assi sopra un bastone."
	]
	quest.42000000000F0250.title: "Cartello di quercia"
	quest.42000000000F0251.quest_desc: [
		"Uno stendardo vuoto, pronto a prendere i colori del Clowder.",
		"Come: sei lane sopra un bastone."
	]
	quest.42000000000F0251.title: "Stendardo bianco"
	quest.42000000000F0252.quest_desc: [
		"Scudo pronto per gli stendardi.",
		"Come: sei assi intorno al ferro. Parata in mano secondaria."
	]
	quest.42000000000F0252.title: "Scudo pronto per stendardo"
	quest.42000000000F0253.quest_desc: [
		"Falli scoppiare quando un Filo finalmente torna a unirsi.",
		"Come: carta più polvere da sparo. Scoppio facoltativo."
	]
	quest.42000000000F0253.title: "Fuoco d'artificio"
	quest.42000000000F0254.quest_desc: [
		"Condividilo con la Sala.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000F0254.title: "Tributo di biscotti"
	quest.42000000000F0255.quest_desc: [
		"Cibo condiviso per festeggiare un Filo davvero e pienamente ritessuto.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000F0255.title: "Torta"
	quest.42000000000F0256.quest_desc: [
		"Disco del gatto — l'umore del pacchetto.",
		"Facoltativo — il vuoto potrebbe non offrirtelo mai.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000F0256.title: "Disco musicale"
	quest.42000000000F0257.quest_desc: [
		"Riporta alla piattaforma un animale addomesticato o comprato, senza inseguirlo.",
		"Come: quattro spaghi intorno a una palla di slime. Lo slime è il compost della piattaforma (terra, semi, farina d'ossa)."
	]
	quest.42000000000F0257.title: "Guinzaglio"
	quest.42000000000F0258.quest_desc: [
		"Monta quando trovi una sella.",
		"Facoltativo — i Custodi della piattaforma nella Sala Clowder ne vendono una.",
		"Come: scambia un blocco di diamante con i Custodi della piattaforma nel loro negozio nella Sala Clowder (/clowder hub). La Sella Chocobo è un oggetto diverso."
	]
	quest.42000000000F0258.title: "Sella"
	quest.42000000000F0259.quest_desc: [
		"Per il giorno in cui qualcuno costruirà un mare. Facoltativo.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000000F0259.title: "Barca"
	quest.4200000000110278.quest_desc: [
		"Mostra dove l'aura si raccoglie, fitta o rada, sulla terra.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: Foglia d'oro + occhio di ragno. Mostra l'aura locale."
	]
	quest.4200000000110278.title: "Occhio (Aura)"
	quest.4200000000110279.quest_desc: [
		"Tessuta d'oro, serve a infondere le piante di aura concentrata.",
		"Come: quattro foglie e quattro pepite d'oro intorno all'erba corta fanno quattro Fibre brillanti. Mettila nella chioma di un albero; le sue foglie diventano dorate col tempo."
	]
	quest.4200000000110279.title: "Fibra brillante (Aura)"
	quest.420000000011027A.quest_desc: [
		"Un materiale raffinato per le ricette di livello superiore dell'altare.",
		"Come: rompi le foglie dorate cresciute dalla Fibra brillante."
	]
	quest.420000000011027A.title: "Foglia d'oro (Aura)"
	quest.420000000011027B.quest_desc: [
		"Foglie che tengono un morbido bagliore dorato tutto l'anno.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011027B.title: "Golden Leaves"
	quest.420000000011027C.quest_desc: [
		"Regge un ingrediente per il Rituale della foresta, messo intorno a un alberello.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011027C.title: "Wooden Stand"
	quest.420000000011027D.quest_desc: [
		"L'altare dove l'aura alimenta ricette di fabbricazione più forti.",
		"Come: Rituale della foresta (JEI): tre pietre, una Foglia d'oro, un lingotto d'oro e un Gettone della gioia. Linea del Cuore dell'aura."
	]
	quest.420000000011027D.title: "Altare naturale (Aura)"
	quest.420000000011027E.quest_desc: [
		"Ferro carico d'aura, un passo verso il Lingotto delle profondità.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011027E.title: "Ferro infuso (Aura)"
	quest.420000000011027F.quest_desc: [
		"Corteccia tolta da alberi antichi, utile nelle ricette d'aura.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011027F.title: "Ancient Bark"
	quest.4200000000110280.quest_desc: [
		"Un gettone di gioia. L'Altare naturale e l'Assorbitore erbivoro si costruiscono su uno.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110280.title: "Gettone di gioia (Aura)"
	quest.4200000000110281.quest_desc: [
		"Un gettone di paura. Il Riduttore della chioma e l'Assorbitore persistente si costruiscono su uno.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110281.title: "Token of Fear"
	quest.4200000000110282.quest_desc: [
		"Un gettone d'ira. Il Catalizzatore sgretolante e il Segno di tiro ne richiedono uno.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110282.title: "Token of Anger"
	quest.4200000000110283.quest_desc: [
		"Un gettone di dolore. Il Tavolo delle offerte e il Districatore dei mortali ne richiedono uno.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110283.title: "Token of Sorrow"
	quest.4200000000110284.quest_desc: [
		"Spirito d'aura per i rituali.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110284.title: "Spirit of Calling"
	quest.4200000000110285.quest_desc: [
		"Spirito di nascita per i riti d'aura.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110285.title: "Spirit of Birthing"
	quest.4200000000110286.quest_desc: [
		"Conserva una riserva d'aura per quando la terra si fa scarsa.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110286.title: "Aura Trove"
	quest.4200000000110287.quest_desc: [
		"Tardi. Solo se l'Aura lo vuole.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110287.title: "Creational Catalyst"
	quest.4200000000110288.quest_desc: [
		"Rivela l'aura e le condizioni di comparsa su un tratto di terra più ampio.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110288.title: "Environmental Ocular"
	quest.4200000000110289.quest_desc: [
		"Messo accanto all'Altare naturale, apre le ricette di frantumazione dell'altare.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110289.title: "Crumbling Catalyst"
	quest.420000000011028A.quest_desc: [
		"Messo accanto all'Altare naturale, apre le ricette di trasmutazione dell'altare.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011028A.title: "Transmutation Catalyst"
	quest.420000000011028B.quest_desc: [
		"Lingotti del cielo, oro contaminato e frammento di netherite, pressati nel Lingotto delle profondità.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011028B.title: "Ingot of the Depths"
	quest.420000000011028C.quest_desc: [
		"Segna una disposizione di fattoria che attira l'aura per far crescere i raccolti più in fretta.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011028C.title: "Farming Stencil"
	quest.420000000011028D.quest_desc: [
		"Genera aura ogni volta che un proiettile atterra vicino.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011028D.title: "Shooting Mark"
	quest.420000000011028E.quest_desc: [
		"Genera aura lentamente dai fiori che sbocciano vicino.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011028E.title: "Herbivorous Absorber"
	quest.420000000011028F.quest_desc: [
		"Genera aura lentamente dalle querce che crescono vicino.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.420000000011028F.title: "Canopy Diminisher"
	quest.4200000000110290.quest_desc: [
		"Un fiore dell'End, stranamente a suo agio su una piattaforma.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110290.title: "Rose of Oblivion"
	quest.4200000000110291.quest_desc: [
		"Illumina un'area perché le creature ostili non compaiano lì.",
		"Come: Fibra brillante sugli alberi → Foglia d'oro → Altare naturale. Il capitolo dell'aura nomina gettoni e generatori."
	]
	quest.4200000000110291.title: "Lamp of Sanctuary"
	quest.4200000000120292.quest_desc: [
		"Cucina pasti tipo stufato che sfamano più di un piatto alla volta.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000120292.title: "Pentola da cucina (Cucina)"
	quest.4200000000120293.quest_desc: [
		"La padella salta i piatti.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000120293.title: "Padella"
	quest.4200000000120294.quest_desc: [
		"Fornello per Farmer's Delight.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000120294.title: "Fornello"
	quest.4200000000120295.quest_desc: [
		"Taglia carne e verdure negli ingredienti che altre ricette chiedono.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000120295.title: "Tagliere (Cucina)"
	quest.4200000000120296.quest_desc: [
		"Cesto per portare il raccolto.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000120296.title: "Cesto"
	quest.4200000000120297.quest_desc: [
		"Ci sali come su un rampicante, e serve in diverse ricette di cucina.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000120297.title: "Corda"
	quest.4200000000120298.quest_desc: [
		"Ferma una lunga caduta e ti rilancia su senza un graffio.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.4200000000120298.title: "Rete di sicurezza"
	quest.4200000000120299.quest_desc: [
		"Una volta dissodata e seminata, accelera la crescita delle colture vicine.",
		"Come: piazza Compost organico e aspetta; matura piano in Terra ricca."
	]
	quest.4200000000120299.title: "Terra ricca (Cucina)"
	quest.420000000012029A.quest_desc: [
		"Trasforma gli avanzi di cibo in compost per arricchire la terra.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000012029A.title: "Compost organico (Cucina)"
	quest.420000000012029B.quest_desc: [
		"Un pasto sostanzioso avvolto nel cavolo, recupera un bel pezzo di fame.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000012029B.title: "Involtini di cavolo"
	quest.420000000012029C.quest_desc: [
		"Veloce da cuocere, veloce da mangiare, una fame discreta per lo sforzo.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000012029C.title: "Sandwich con bacon"
	quest.420000000012029D.quest_desc: [
		"Un pasto a strati che recupera più fame delle parti da sole.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000012029D.title: "Panino con hamburger"
	quest.420000000012029E.quest_desc: [
		"Una ciotola calda che recupera fame e saturazione insieme.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000012029E.title: "Stufato di pollo"
	quest.420000000012029F.quest_desc: [
		"Lo stufato di manzo sazia sul serio.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.420000000012029F.title: "Stufato di manzo"
	quest.42000000001202A0.quest_desc: [
		"Tagliatelle e brodo, abbastanza sostanzioso per una giornata intera di lavoro.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A0.title: "Zuppa di noodles"
	quest.42000000001202A1.quest_desc: [
		"Un dolce al forno che vale l'attesa e recupera un bel pezzo di fame.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A1.title: "Torta di mele"
	quest.42000000001202A2.quest_desc: [
		"Aspro e dolce, uno dei dolci più ricchi sulla piattaforma.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A2.title: "Cheesecake di bacche dolci"
	quest.42000000001202A3.quest_desc: [
		"Riso per la linea di cucina.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A3.title: "Riso"
	quest.42000000001202A4.quest_desc: [
		"Cibo di conforto della linea di cucina.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A4.title: "Riso fritto"
	quest.42000000001202A5.quest_desc: [
		"Piccoli involtini ripieni, veloci da cuocere a gruppi.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A5.title: "Ravioli cinesi"
	quest.42000000001202A6.quest_desc: [
		"Una bevanda calda preparata con semi di cacao e latte.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A6.title: "Cioccolata calda"
	quest.42000000001202A7.quest_desc: [
		"Una bevanda fresca spremuta dall'anguria, recupera un po' di fame in fretta.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A7.title: "Succo di Melone"
	quest.42000000001202A8.quest_desc: [
		"Tessuto intrecciato usato in diverse ricette di cucina e decorazione.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A8.title: "Tela"
	quest.42000000001202A9.quest_desc: [
		"Un pavimento intrecciato e morbido, una trama diversa dal legno liscio.",
		"Come: creazione di Farmer's Delight in JEI (banco da lavoro, tagliere o pentola). I semi delle colture vengono setacciando la terra."
	]
	quest.42000000001202A9.title: "Tatami"
	quest.42000000001302AA.quest_desc: [
		"Il primo libro che ti lascia lanciare incantesimi in un vero combattimento.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: tre catene, quattro cuoio e due carte. Il capitolo degli incantesimi nomina l'inchiostro."
	]
	quest.42000000001302AA.title: "Libro di incantesimi di ferro"
	quest.42000000001302AB.quest_desc: [
		"Ha più scomparti per incantesimi del libro di ferro che lo precede.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302AB.title: "Libro di incantesimi d'oro"
	quest.42000000001302AC.quest_desc: [
		"Un libro più robusto, con ancora più spazio per gli incantesimi.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302AC.title: "Libro di incantesimi di diamante"
	quest.42000000001302AD.quest_desc: [
		"Alimenta il lancio di incantesimi ed è alla base della maggior parte delle ricette di incantesimi.",
		"Come: uccidi i lanciatori o fabbrica ciò che elenca JEI. Combustibile per inchiostro e libri."
	]
	quest.42000000001302AD.title: "Essenza arcana (Incantesimi)"
	quest.42000000001302AE.quest_desc: [
		"Scrivi incantesimi e pagine.",
		"Come: bottiglia + essenza + tintura. Il primo inchiostro d'iscrizione."
	]
	quest.42000000001302AE.title: "Inchiostro comune"
	quest.42000000001302AF.quest_desc: [
		"Scrive in un libro incantesimi e pergamene di livello non comune.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302AF.title: "Inchiostro non comune"
	quest.42000000001302B0.quest_desc: [
		"Scrive in un libro incantesimi e pergamene di livello raro.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B0.title: "Inchiostro raro"
	quest.42000000001302B1.quest_desc: [
		"Scrive in un libro incantesimi e pergamene di livello epico.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B1.title: "Inchiostro epico"
	quest.42000000001302B2.quest_desc: [
		"Scrive gli incantesimi più rari e più forti che un libro può contenere.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B2.title: "Inchiostro leggendario"
	quest.42000000001302B3.quest_desc: [
		"Lancia un incantesimo una volta, senza doverlo aver imparato in un libro.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B3.title: "Pergamena"
	quest.42000000001302B4.quest_desc: [
		"Stoffa magica per vesti.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B4.title: "Stoffa magica"
	quest.42000000001302B5.quest_desc: [
		"Armatura leggera che privilegia il lancio di incantesimi rispetto alla difesa pura.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B5.title: "Elmo del mago errante"
	quest.42000000001302B6.quest_desc: [
		"Armatura del torace fatta per la velocità di lancio, non per i danni incassati.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B6.title: "Corazza del mago errante"
	quest.42000000001302B7.quest_desc: [
		"Un bastone che incanala gli incantesimi di fuoco con forza extra.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B7.title: "Pyrium Staff"
	quest.42000000001302B8.quest_desc: [
		"Un bastone modesto per chi inizia a lanciare incantesimi.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302B8.title: "Bastone di Barbagrigia"
	quest.42000000001302B9.quest_desc: [
		"Una lama che punisce chi lancia incantesimi e taglia le loro difese.",
		"Come: ricetta del pack, due Lingotti arcani sulla diagonale, una catena per lato e un diamante all'elsa. L'unico portatore selvatico vive nei forti degli evocatori, che la piattaforma non ha mai."
	]
	quest.42000000001302B9.title: "Cacciatore di maghi"
	quest.42000000001302BA.quest_desc: [
		"Il primo libro di incantesimi: pochi scomparti, ma facile da raggiungere.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302BA.title: "Libro di incantesimi di rame"
	quest.42000000001302BB.quest_desc: [
		"Il libro di incantesimi più forte, con più scomparti di tutti.",
		"Come: quattro Stoffe arcane, due Fiale di sangue, un lingotto di netherite, una Bottiglia di fulmine e un Libro in rovina (ricetta del pack). JEI lo chiama Codice antico."
	]
	quest.42000000001302BB.title: "Libro di incantesimi di netherite"
	quest.42000000001302BC.quest_desc: [
		"Metallo raffinato, per la fascia alta dell'equipaggiamento da incantesimi.",
		"Come: Essenza arcana e inchiostro, poi un libro di incantesimi. Il capitolo Incantesimi nomina la scala."
	]
	quest.42000000001302BC.title: "Lingotto arcano"
	quest.42000000001302BD.quest_desc: [
		"Un libro danneggiato che si può ricomporre in conoscenza.",
		"Come: ricetta del pack, un libro incantato circondato da quattro Essenze arcane e quattro sabbie delle anime. JEI lo chiama Libro in rovina."
	]
	quest.42000000001302BD.title: "Codice in rovina"
	quest.42000000001402BE.quest_desc: [
		"Il primo pezzo di Solar Flux. Celle, rivestimenti e la Miglioria in bianco si costruiscono da esso.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: tre vetri sopra un lingotto di ferro fanno tre Specchi."
	]
	quest.42000000001402BE.title: "Specchio"
	quest.42000000001402BF.quest_desc: [
		"Il primo livello di cella solare, debole ma economica da impilare.",
		"Come: tre vetri, tre lapislazzuli e tre Specchi, una riga per ciascuno."
	]
	quest.42000000001402BF.title: "Cella fotovoltaica 1"
	quest.42000000001402C0.quest_desc: [
		"Una cella solare più forte, un gradino sopra il livello di prima.",
		"Come: tre palle d'argilla, tre lapislazzuli, due Specchi e una Cella fotovoltaica I."
	]
	quest.42000000001402C0.title: "Cella fotovoltaica 2"
	quest.42000000001402C1.quest_desc: [
		"Cella solare di livello medio, con molta più uscita per pannello.",
		"Come: tre vetri, tre polveri di pietra luminosa, due ossidiane e una Cella fotovoltaica II."
	]
	quest.42000000001402C1.title: "Cella fotovoltaica 3"
	quest.42000000001402C2.quest_desc: [
		"Una cella solare di livello alto, per un pannello fatto per crescere.",
		"Come: tre Rivestimenti fiammeggianti, due polveri di pietra luminosa, un diamante, due blocchi di quarzo e una Cella fotovoltaica III."
	]
	quest.42000000001402C2.title: "Cella fotovoltaica 4"
	quest.42000000001402C3.quest_desc: [
		"Quasi in cima, questa cella tira energia seria dalla luce del giorno.",
		"Come: tre Vetri di smeraldo, due blocchi di pietra luminosa, un blocco di diamante, un blocco di quarzo e due Celle fotovoltaiche IV. Ne fa due."
	]
	quest.42000000001402C3.title: "Cella fotovoltaica 5"
	quest.42000000001402C4.quest_desc: [
		"La cella solare più forte che si fabbrica, il tetto di un singolo pannello.",
		"Come: tre Vetri di ender, due blocchi di pietra luminosa, un blocco di smeraldo, un blocco di quarzo e due Celle fotovoltaiche V. Ne fa due."
	]
	quest.42000000001402C4.title: "Cella fotovoltaica 6"
	quest.42000000001402C5.quest_desc: [
		"Permette a un pannello solare di tenere una riserva più grande di energia.",
		"Come: cinque blocchi di redstone, un blocco di diamante e una Miglioria in bianco."
	]
	quest.42000000001402C5.title: "Miglioria di capacità"
	quest.42000000001402C6.quest_desc: [
		"Spreme più energia dalla stessa luce del sole.",
		"Come: tre Specchi, una Miglioria in bianco e una Cella fotovoltaica I."
	]
	quest.42000000001402C6.title: "Miglioria di efficienza"
	quest.42000000001402C7.quest_desc: [
		"Permette a un pannello solare di mandare energia più in fretta.",
		"Come: sei redstone e due lingotti d'oro intorno a una Miglioria in bianco."
	]
	quest.42000000001402C7.title: "Miglioria di trasferimento"
	quest.42000000001402C8.quest_desc: [
		"Passa l'energia alle macchine collegate al pannello, entro pochi blocchi.",
		"Come: quattro lingotti di ferro, due pistoni e due redstone intorno a una Miglioria in bianco."
	]
	quest.42000000001402C8.title: "Miglioria di attraversamento"
	quest.42000000001402C9.quest_desc: [
		"Manda energia ai giocatori in piedi vicino al pannello.",
		"Come: quattro polveri di pietra luminosa e quattro Occhi di ender intorno a una Miglioria vuota."
	]
	quest.42000000001402C9.title: "Miglioria dispersiva"
	quest.42000000001402CA.quest_desc: [
		"Manda energia a un blocco collegato a portata, senza cavi.",
		"Come: quattro perle di ender e quattro blocchi di redstone intorno a una Miglioria dispersiva."
	]
	quest.42000000001402CA.title: "Miglioria di carica blocco"
	quest.42000000001402CB.quest_desc: [
		"Fa fondere al pannello gli oggetti con la luce del sole accumulata, invece del combustibile.",
		"Come: cinque carboni, una fornace e due Rivestimenti fiammeggianti intorno a una Miglioria vuota."
	]
	quest.42000000001402CB.title: "Miglioria fornace"
	quest.42000000001402CC.quest_desc: [
		"Vetro a specchio incastonato con uno smeraldo. Il Vetro di ender e la Cella fotovoltaica V si costruiscono su di esso.",
		"Come: uno smeraldo tra due Specchi in colonna ne fa due."
	]
	quest.42000000001402CC.title: "Vetro di smeraldo"
	quest.42000000001402CD.quest_desc: [
		"Vetro di smeraldo caricato con perle e un occhio. La Cella fotovoltaica VI si costruisce su di esso.",
		"Come: tre Vetri di smeraldo sopra un Occhio di ender tra due perle di ender ne fanno tre."
	]
	quest.42000000001402CD.title: "Vetro di ender"
	quest.42000000001402CE.quest_desc: [
		"Una finitura di Specchio spolverata di polvere di blaze. La Cella fotovoltaica IV e la Miglioria fornace la usano.",
		"Come: polvere di blaze tra due Specchi in colonna ne fa due."
	]
	quest.42000000001402CE.title: "Rivestimento fiammeggiante"
	quest.42000000001402CF.quest_desc: [
		"Una miglioria ancora non scelta, fabbricata in qualsiasi tipo di miglioria.",
		"Come: quattro ciottoli intorno a uno Specchio."
	]
	quest.42000000001402CF.title: "Miglioria vuota"
	quest.42000000001502D0.quest_desc: [
		"Pietra semplice e affidabile per muri e pavimenti.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: quattro pietre in un quadrato, o il tagliapietre."
	]
	quest.42000000001502D0.title: "Mattoni di pietra"
	quest.42000000001502D1.quest_desc: [
		"Finitura di mattoni muschiosi per la piattaforma.",
		"Come: mattoni di pietra più rampicanti o muschio. Poi il tagliapietre."
	]
	quest.42000000001502D1.title: "Mattoni di pietra muschiosi"
	quest.42000000001502D2.quest_desc: [
		"Mattoni di pietra consumati, dall'aspetto logoro e crepato.",
		"Come: fondi mattoni di pietra."
	]
	quest.42000000001502D2.title: "Mattoni di pietra crepati"
	quest.42000000001502D3.quest_desc: [
		"Mattoni di pietra intagliati per finiture e linee d'accento.",
		"Come: due lastre di mattoni di pietra, o il tagliapietre."
	]
	quest.42000000001502D3.title: "Mattoni di pietra cesellati"
	quest.42000000001502D4.quest_desc: [
		"Una finitura di pietra piatta e uniforme per i pavimenti.",
		"Come: fondi la pietra. Le lastre vengono dal tagliapietre."
	]
	quest.42000000001502D4.title: "Pietra liscia"
	quest.42000000001502D5.quest_desc: [
		"Pietra grigia levigata fino a una finitura liscia.",
		"Come: quattro andesiti, o il tagliapietre."
	]
	quest.42000000001502D5.title: "Andesite levigata"
	quest.42000000001502D6.quest_desc: [
		"Pietra di un bianco vivo, levigata e liscia.",
		"Come: quattro dioriti, o il tagliapietre."
	]
	quest.42000000001502D6.title: "Diorite levigata"
	quest.42000000001502D7.quest_desc: [
		"Pietra rosa calda, levigata per i dettagli.",
		"Come: quattro graniti, o il tagliapietre."
	]
	quest.42000000001502D7.title: "Granito levigato"
	quest.42000000001502D8.quest_desc: [
		"Blocchi d'argilla cotta, rosso caldo contro la pietra grigia.",
		"Come: quattro oggetti mattone. Le palle d'argilla si fondono in mattoni."
	]
	quest.42000000001502D8.title: "Mattoni"
	quest.42000000001502D9.quest_desc: [
		"Fango pallido e compatto, formato in finitura da costruzione.",
		"Come: quattro fanghi compatti. Il fango è terra più una bottiglia d'acqua; fango e grano fanno fango compatto."
	]
	quest.42000000001502D9.title: "Mattoni di fango"
	quest.42000000001502DA.quest_desc: [
		"Mattoni di pietra scura tirati dal profondo.",
		"Come: ardesia profonda levigata in un quadrato, o il tagliapietre. Quattro sassolini di ardesia profonda (setaccia la terra) fanno ardesia profonda ciottolata."
	]
	quest.42000000001502DA.title: "Mattoni di ardesia profonda"
	quest.42000000001502DB.quest_desc: [
		"Piastrelle scure e lisce per un pavimento più slanciato.",
		"Come: mattoni di ardesia profonda in un quadrato, o il tagliapietre."
	]
	quest.42000000001502DB.title: "Piastrelle di ardesia profonda"
	quest.42000000001502DC.quest_desc: [
		"Pietra scura del Nether, solida e semplice.",
		"Come: acqua della strega versata in un barile di lava, oppure quattro sassolini di pietra nera. Le Rocche sono costruite con essa."
	]
	quest.42000000001502DC.title: "Pietranera"
	quest.42000000001502DD.quest_desc: [
		"Pietranera levigata fino a un lucido scuro e brillante.",
		"Come: quattro pietranera, o il tagliapietre. Il Nether, dopo Artiglio."
	]
	quest.42000000001502DD.title: "Pietranera levigata"
	quest.42000000001502DE.quest_desc: [
		"Pietranera screziata d'oro, rara e decorativa.",
		"Come: bastione del Nether dopo l'ossidiana di Artiglio. Un ramo finale della decorazione, non un cancello successivo."
	]
	quest.42000000001502DE.title: "Pietranera dorata"
	quest.42000000001502DF.quest_desc: [
		"Blocco di un bianco vivo, un punto fermo della decorazione della piattaforma.",
		"Come: quattro quarzo del Nether. Il Nether, dopo Artiglio."
	]
	quest.42000000001502DF.title: "Blocco di quarzo"
	quest.42000000001502E0.quest_desc: [
		"Quarzo spianato, per finiture pulite.",
		"Come: fondi un blocco di quarzo."
	]
	quest.42000000001502E0.title: "Quarzo liscio"
	quest.42000000001502E1.quest_desc: [
		"Pietra viola dell'End, un pezzo d'accento un po' strano.",
		"Come: quattro frutti di chorus scoppiati. Il frutto di chorus è la bancarella dei Camminabordi."
	]
	quest.42000000001502E1.title: "Blocco di purpur"
	quest.42000000001502E2.quest_desc: [
		"Pietra nata dal mare, con un lieve luccichio blu.",
		"Come: servono schegge di prismarino. Solo l'oceano. Facoltativo."
	]
	quest.42000000001502E2.title: "Prismarino"
	quest.42000000001502E3.quest_desc: [
		"Un prismarino più scuro, buono per accenti profondi.",
		"Come: servono schegge di prismarino. Solo l'oceano. Facoltativo."
	]
	quest.42000000001502E3.title: "Prismarino scuro"
	quest.42000000001502E4.quest_desc: [
		"Una luce costante, presa dal fondo dell'oceano.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502E4.title: "Lanterna marina"
	quest.42000000001502E5.quest_desc: [
		"Una luce arancione calda, cresciuta da un fungo del Nether.",
		"Come: cresce sui funghi enormi. Pianta un fungo sul nylium e dagli farina d'ossa."
	]
	quest.42000000001502E5.title: "Fungo luminoso"
	quest.42000000001502E6.quest_desc: [
		"Una luce gialla e soffusa, senza alcuna fiamma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502E6.title: "Lume di rana ocra"
	quest.42000000001502E7.quest_desc: [
		"Una luce pallida e luminosa, dal luccichio perlescente.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502E7.title: "Lume di rana perlescente"
	quest.42000000001502E8.quest_desc: [
		"Una luce verde fresca, senza fiamma e sicura al chiuso.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502E8.title: "Lume di rana verdeggiante"
	quest.42000000001502E9.quest_desc: [
		"Vetro che blocca la luce, ma lascia la vista.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502E9.title: "Vetro oscurato"
	quest.42000000001502EA.quest_desc: [
		"Vetro bianco morbido, per una luce di finestra gentile.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502EA.title: "Vetro bianco"
	quest.42000000001502EB.quest_desc: [
		"Vetro azzurro pallido, vicino al cielo aperto.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502EB.title: "Vetro azzurro"
	quest.42000000001502EC.quest_desc: [
		"Vetro ciano fresco, per una stanza più calma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502EC.title: "Vetro ciano"
	quest.42000000001502ED.quest_desc: [
		"Vetro viola profondo, un cenno al vuoto sotto.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502ED.title: "Vetro viola"
	quest.42000000001502EE.quest_desc: [
		"Una piccola fiamma costante, per la luce d'atmosfera.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502EE.title: "Candela"
	quest.42000000001502EF.quest_desc: [
		"Una candela pallida, discreta sulle pareti chiare.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502EF.title: "Candela bianca"
	quest.42000000001502F0.quest_desc: [
		"Scala il bordo della piattaforma in sicurezza.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F0.title: "Torre di impalcatura"
	quest.42000000001502F1.quest_desc: [
		"Scale per piattaforme in verticale.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F1.title: "Scorta di scale"
	quest.42000000001502F2.quest_desc: [
		"Binari attraverso il vuoto.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F2.title: "Binario di scorta"
	quest.42000000001502F3.quest_desc: [
		"Ti tiene a galla, se la piattaforma incontra mai l'acqua.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F3.title: "Barca di quercia"
	quest.42000000001502F4.quest_desc: [
		"Decorazione per i muri della piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F4.title: "Dipinto di scorta"
	quest.42000000001502F5.quest_desc: [
		"Mostra un set completo di armatura sulla piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F5.title: "Espositore per armature"
	quest.42000000001502F6.quest_desc: [
		"Regge un oggetto esposto che non si spegne mai.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F6.title: "Cornice luminosa"
	quest.42000000001502F7.quest_desc: [
		"Vasi da fiori per il verde.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F7.title: "Vaso da fiori di scorta"
	quest.42000000001502F8.quest_desc: [
		"Cartelli appesi per le stanze.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F8.title: "Cartello appeso di quercia"
	quest.42000000001502F9.quest_desc: [
		"Telaio per lavorare gli stendardi.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502F9.title: "Telaio"
	quest.42000000001502FA.quest_desc: [
		"Taglia la pietra in forme precise, senza spreco.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502FA.title: "Tagliapietre"
	quest.42000000001502FB.quest_desc: [
		"Ripara gli attrezzi e toglie gli incantesimi che non vuoi.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502FB.title: "Mola"
	quest.42000000001502FC.quest_desc: [
		"Potenzia l'equipaggiamento con modelli di forgia e netherite.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502FC.title: "Tavolo da forgia"
	quest.42000000001502FD.quest_desc: [
		"Traccia la griglia dell'isola.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502FD.title: "Tavolo da cartografia"
	quest.42000000001502FE.quest_desc: [
		"Una postazione da villico, per lo più decorativa sulla piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502FE.title: "Tavolo da frecce"
	quest.42000000001502FF.quest_desc: [
		"Fonde i minerali due volte più in fretta di una fornace semplice.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.42000000001502FF.title: "Altoforno di scorta"
	quest.4200000000150300.quest_desc: [
		"Cucina il cibo due volte più in fretta di una fornace semplice.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000150300.title: "Affumicatore di scorta"
	quest.4200000000150301.quest_desc: [
		"Tiene un poco d'acqua, colorante o pozione.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000150301.title: "Calderone"
	quest.4200000000150302.quest_desc: [
		"Sposta automaticamente gli oggetti tra i contenitori sotto e sopra.",
		"Come: cinque ferri intorno a un baule. Mettila sotto una Cornice del telaio o un Barile di tensione (estrae verso il BASSO)."
	]
	quest.4200000000150302.title: "Tramoggia di scorta"
	quest.4200000000150303.quest_desc: [
		"Spara o usa qualunque oggetto ci carichi.",
		"Come: ciottoli, arco e redstone."
	]
	quest.4200000000150303.title: "Dispenser di scorta"
	quest.4200000000150304.quest_desc: [
		"Manda un impulso di redstone ogni volta che il blocco davanti cambia.",
		"Come: ciottoli, redstone e quarzo del Nether."
	]
	quest.4200000000150304.title: "Osservatore di scorta"
	quest.4200000000150305.quest_desc: [
		"Un segnale di redstone costante e forte, in forma di blocco.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000150305.title: "Blocco di redstone"
	quest.4200000000150306.quest_desc: [
		"Manda una forza di segnale in base a quanto bene lo colpisci.",
		"Come: redstone intorno al fieno. Il fieno è tre grani."
	]
	quest.4200000000150306.title: "Bersaglio di scorta"
	quest.4200000000150307.quest_desc: [
		"Suona una nota quando lo colpisci o riceve energia. Accordalo a mano.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000150307.title: "Blocco sonoro di scorta"
	quest.4200000000150308.quest_desc: [
		"Suona i dischi musicali su tutta la piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000150308.title: "Jukebox di scorta"
	quest.4200000000150309.quest_desc: [
		"La campana segna il Clowder.",
		"Come: nessuna ricetta. Il rituale Contatta lo spirito selvaggio di Occultism ne crea uno, ma serve una capra, e le capre non raggiungono mai la piattaforma. Facoltativo."
	]
	quest.4200000000150309.title: "Campana di scorta"
	quest.420000000015030A.quest_desc: [
		"Imposta il tuo punto di rinascita nel Nether e si carica con pietra luminosa.",
		"Come: ossidiana piangente più pietra luminosa. Rinascita solo nel Nether."
	]
	quest.420000000015030A.title: "Ancora della rinascita"
	quest.420000000015030B.quest_desc: [
		"Blocca una bussola su questo blocco preciso, invece del punto di comparsa.",
		"Come: un lingotto di netherite in mattoni di pietra cesellati. Lusso tardo del Clowder."
	]
	quest.420000000015030B.title: "Magnetite di scorta"
	quest.420000000015030C.quest_desc: [
		"Attira i fulmini al sicuro, lontano dalla piattaforma.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000015030C.title: "Parafulmine di scorta"
	quest.420000000015030D.quest_desc: [
		"Uno spazio di deposito personale che ti segue ovunque tu vada.",
		"Come: otto ossidiane intorno a un Occhio di ender. L'occhio è perla di ender più polvere di blaze."
	]
	quest.420000000015030D.title: "Baule di ender"
	quest.420000000015030E.quest_desc: [
		"Si fabbrica in una scatola di shulker, per un deposito impilabile e sicuro.",
		"Come: ricetta del pack, sei blocchi di purpur, due perle di ender e un Nodo legante. Gli shulker non compaiono mai qui. Facoltativo."
	]
	quest.420000000015030E.title: "Guscio di shulker"
	quest.420000000016030F.quest_desc: [
		"Pavimento e pareti, ovunque tu costruisca sopra la lava.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: il Nether qui è vuoto, non terreno. Versa lava in un barile di Ex Deorum di acqua della strega (un barile d'acqua sul micelio; le spore di micelio si setacciano dalla terra)."
	]
	quest.420000000016030F.title: "Scorta di Netherrack"
	quest.4200000000160310.quest_desc: [
		"Pietra di fango cotta, rinforzata con quarzo. Tiene la forma vicino al fuoco.",
		"Come: fondi il Netherrack, poi quattro oggetti mattone del Nether."
	]
	quest.4200000000160310.title: "Mattoni del Nether"
	quest.4200000000160311.quest_desc: [
		"Verruca del Nether cotta in mattone. Colore più caldo, la stessa resistenza.",
		"Come: mattoni del Nether più verruca del Nether. Nether dopo Artiglio."
	]
	quest.4200000000160311.title: "Mattoni rossi del Nether"
	quest.4200000000160312.quest_desc: [
		"Colonna di magma raffreddata, tagliata in blocchi per un appoggio.",
		"Come: lava che scorre sulla terra delle anime accanto al ghiaccio blu, o quattro sassolini di basalto setacciando pietra nera frantumata."
	]
	quest.4200000000160312.title: "Basalto"
	quest.4200000000160313.quest_desc: [
		"Basalto carteggiato fino a diventare liscio. Si legge come pietra, non come impalcatura.",
		"Come: tagliapietre, o quattro basalti."
	]
	quest.4200000000160313.title: "Basalto levigato"
	quest.4200000000160314.quest_desc: [
		"Basalto senza le creste. Buono per pavimenti piatti e finiture.",
		"Come: fondi il basalto."
	]
	quest.4200000000160314.title: "Basalto liscio"
	quest.4200000000160315.quest_desc: [
		"I ciottoli del Nether. Fabbricali verso attrezzi e mattoni.",
		"Come: acqua della strega versata in un barile di lava, oppure quattro sassolini di pietra nera. Le Rocche sono costruite con essa."
	]
	quest.4200000000160315.title: "Scorta di pietra nera"
	quest.4200000000160316.quest_desc: [
		"Scalda l'acqua vicina fino a farla bollire e fa male ai piedi nudi.",
		"Come: quattro creme di magma. Una palla di slime in un barile di lava fa la crema."
	]
	quest.4200000000160316.title: "Blocco di magma"
	quest.4200000000160317.quest_desc: [
		"Scorta di sabbia delle anime come appoggio.",
		"Come: sabbia in un barile di Ex Deorum di acqua della strega. Le stanze di verruche della fortezza ne tengono un po'. Tre teschi sulla sabbia delle anime fanno un Wither."
	]
	quest.4200000000160317.title: "Scorta di sabbia delle anime"
	quest.4200000000160318.quest_desc: [
		"Fa bruciare il fuoco delle anime e le torce delle anime al posto della fiamma normale.",
		"Come: sabbia delle anime lasciata cadere in un barile di lava di Ex Deorum."
	]
	quest.4200000000160318.title: "Terra delle anime"
	quest.4200000000160319.quest_desc: [
		"Si frantuma in quattro polveri, oppure illumina una stanza senza fumo.",
		"Come: quattro polveri di pietra luminosa. La polvere si setaccia dalla sabbia delle anime."
	]
	quest.4200000000160319.title: "Pietra luminosa"
	quest.420000000016031A.quest_desc: [
		"Un fungo che brilla da solo. Non serve cablaggio.",
		"Come: cresce sui funghi enormi. Pianta un fungo sul nylium e dagli farina d'ossa."
	]
	quest.420000000016031A.title: "Scorta di fungolume"
	quest.420000000016031B.quest_desc: [
		"Nove verruche del Nether riunite in un blocco. Soprattutto decoro e tintura.",
		"Come: nove verruche del Nether. La verruca si setaccia dalla sabbia delle anime, o cresce nei giardini della fortezza."
	]
	quest.420000000016031B.title: "Blocco di verruche del Nether"
	quest.420000000016031C.quest_desc: [
		"Il cugino blu del blocco cremisi. Stessa ricetta, colore più freddo.",
		"Come: cresce su enormi funghi distorti. Metti farina d'ossa su un fungo distorto sopra nylium distorto."
	]
	quest.420000000016031C.title: "Blocco di verruche distorte"
	quest.420000000016031D.quest_desc: [
		"Legno che non è legno. Si scorteccia e fa assi come qualsiasi tronco.",
		"Come: spore di nylium cremisi (setaccia netherrack frantumato) su netherrack, farina d'ossa sul nylium per un fungo, poi farina d'ossa sul fungo."
	]
	quest.420000000016031D.title: "Gambo cremisi"
	quest.420000000016031E.quest_desc: [
		"L'altro tronco di fungo. Le assi escono blu, non rosse.",
		"Come: spore di nylium distorto (setaccia netherrack frantumato) su netherrack, farina d'ossa sul nylium per un fungo, poi farina d'ossa sul fungo."
	]
	quest.420000000016031E.title: "Gambo distorto"
	quest.420000000016031F.quest_desc: [
		"Catena per un tocco appeso.",
		"Come: foreste cremisi dopo Artiglio. Pendono dal soffitto."
	]
	quest.420000000016031F.title: "Rampicanti piangenti"
	quest.4200000000160320.quest_desc: [
		"Risale una foresta distorta e segna un appoggio nella foschia.",
		"Come: foreste distorte dopo Artiglio. Crescono in su dal nylium."
	]
	quest.4200000000160320.title: "Rampicanti contorti"
	quest.4200000000160321.quest_desc: [
		"Piange luce viola e ancora un punto di rinascita nel Nether.",
		"Come: casse dei bastioni, baratto con i piglin o api Draconic che lavorano l'ossidiana. I portali in rovina non si generano qui."
	]
	quest.4200000000160321.title: "Ossidiana piangente"
	quest.4200000000160322.quest_desc: [
		"Sepolto sotto i minerali comuni. Fondilo verso la netherite.",
		"Come: martella la pietra nera in pietra nera frantumata e setacciala. Le casse del bastione ne tengono un po'."
	]
	quest.4200000000160322.title: "Detriti antichi"
	quest.4200000000160323.quest_desc: [
		"Quattro frammenti e quattro lingotti d'oro fanno un lingotto di netherite.",
		"Come: fondi detriti antichi. Quattro frammenti più oro fanno un lingotto."
	]
	quest.4200000000160323.title: "Frammento di netherite"
	quest.4200000000160324.quest_desc: [
		"Il metallo più duro che una mano Skybound stringerà mai.",
		"Come: quattro frammenti più quattro d'oro. I detriti sono Nether raro, dopo Artiglio."
	]
	quest.4200000000160324.title: "Lingotto di netherite"
	quest.4200000000160325.quest_desc: [
		"Alimenta alambicchi e altoforni, entrambi. Tieni una pila di scorta.",
		"Come: fortezza del Nether dopo l'ossidiana di Artiglio. Le pozioni vogliono una verga; Ars e Occultism non la aspettano."
	]
	quest.4200000000160325.title: "Scorta di verghe di blaze"
	quest.4200000000160326.quest_desc: [
		"La pozione di rigenerazione ne chiede una, più pazienza vicino a un ghast.",
		"Come: ghast del Nether dopo l'ossidiana di Artiglio."
	]
	quest.4200000000160326.title: "Lacrima di ghast"
	quest.4200000000160327.quest_desc: [
		"Si distilla in resistenza al fuoco, o si fabbrica di nuovo in un blocco di magma.",
		"Come: una palla di slime lasciata in un barile di lava, slime più polvere di blaze, o cubi di magma."
	]
	quest.4200000000160327.title: "Crema di magma"
	quest.4200000000160328.quest_desc: [
		"Tre evocano un Wither. Uno sta bene anche su una mensola.",
		"Come: fortezza del Nether dopo l'ossidiana di Artiglio. Tre teschi avviano un Wither."
	]
	quest.4200000000160328.title: "Teschio di scheletro wither"
	quest.4200000000160329.quest_desc: [
		"I piglin scambiano per oro. Le pepite valgono quanto i lingotti.",
		"Come: un lingotto ne fa nove, oppure minerale d'oro del Nether."
	]
	quest.4200000000160329.title: "Mucchio di pepite d'oro"
	quest.420000000016032A.quest_desc: [
		"Si fonde in oro e si scava più in fretta del minerale da cui prende il nome.",
		"Come: combinatore di Mekanism, otto ori grezzi più netherrack. Il Nether vuoto non ha minerale."
	]
	quest.420000000016032A.title: "Minerale d'oro del Nether"
	quest.420000000016032B.quest_desc: [
		"Pietra bianca e lucente, che costruisce e porta anche i segnali del comparatore.",
		"Come: setaccia sabbia delle anime, oppure baratto coi piglin."
	]
	quest.420000000016032B.title: "Quarzo"
	quest.420000000016032C.quest_desc: [
		"Lanciata, appicca un fuoco. Caricata in un dispenser, pure.",
		"Come: polvere di blaze, carbone e polvere da sparo."
	]
	quest.420000000016032C.title: "Carica di fuoco"
	quest.4200000000178001.quest_desc: [
		"Dodici cornici del portale non sono una fabbricazione della piattaforma, così l'End è a un morso.",
		"Mangialo per stare sulla piattaforma di ossidiana dell'End; mangia la metà che resta per tornare a casa, nel punto da cui hai mangiato.",
		"Come: cinque perle di ender, due ossa e due polveri di blaze al banco da lavoro."
	]
	quest.4200000000178001.title: "Mela dell'End"
	quest.420000000017032D.quest_desc: [
		"Pietra pallida dal lato lontano. Pesante, semplice e senza fine.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: frutto chorus e perle di ender (bancarella dei Camminabordi) intorno a un Nodo legante. Ne rende otto. L'isola dell'End non c'è più."
	]
	quest.420000000017032D.title: "Pietra dell'End"
	quest.420000000017032E.quest_desc: [
		"Pietra dell'End tagliata a quadrato, per linee più pulite su una piattaforma dell'End.",
		"Come: quattro Pietra dell'End in quadrato, o il tagliapietre. La Pietra dell'End è la fabbricazione del Nodo."
	]
	quest.420000000017032E.title: "Mattoni di pietra dell'End"
	quest.420000000017032F.quest_desc: [
		"Cresciuto dal frutto chorus, poi cotto in pietra da costruzione.",
		"Come: quattro frutti di chorus scoppiati. Il frutto di chorus è la bancarella dei Camminabordi."
	]
	quest.420000000017032F.title: "Scorta di blocco di purpur"
	quest.4200000000170330.quest_desc: [
		"Purpur con un motivo a colonna, orientato come lo piazzi.",
		"Come: due lastre di purpur, o il tagliapietre. Prima il frutto chorus scoppiato."
	]
	quest.4200000000170330.title: "Pilastro di purpur"
	quest.4200000000170331.quest_desc: [
		"Una luce fredda che non tremola mai e fa anche da palo per i binari.",
		"Come: verga di blaze più frutto chorus scoppiato. Il Nether dopo Artiglio; il chorus è la bancarella dei Camminabordi."
	]
	quest.4200000000170331.title: "Barra dell'End"
	quest.4200000000170332.quest_desc: [
		"Mangialo e ti teletrasporti di un balzo corto e imprevedibile.",
		"Come: bancarella dei Camminabordi a /clowder hub. Le isole esterne dell'End non ci sono più."
	]
	quest.4200000000170332.title: "Frutto chorus"
	quest.4200000000170333.quest_desc: [
		"Frutto chorus cotto. Diventa purpur e tinture, senza teletrasportarti.",
		"Come: fondi il frutto chorus della bancarella dei Camminabordi."
	]
	quest.4200000000170333.title: "Chorus scoppiato"
	quest.4200000000170334.quest_desc: [
		"Lanciala e arrivi dove atterra, meno un po' di salute.",
		"Come: endermen, o la bancarella dei Camminabordi a /clowder hub."
	]
	quest.4200000000170334.title: "Scorta di perle di ender"
	quest.4200000000170335.quest_desc: [
		"Scorta di occhi di ender.",
		"Come: perla di ender (bancarella dei Camminabordi / endermen) più polvere di blaze da una fortezza del Nether, dopo l'ossidiana di Artiglio. La scorta di otto occhi è facoltativa; i cristalli dell'End usano la stessa fabbricazione."
	]
	quest.4200000000170335.title: "Scorta di occhio di ender"
	quest.4200000000170336.quest_desc: [
		"Soffio del drago per le pozioni.",
		"Come: bottiglia di vetro sul drago. L'isola dell'End non c'è più. Facoltativo."
	]
	quest.4200000000170336.title: "Scorta di soffio del drago"
	quest.4200000000170337.quest_desc: [
		"L'unico trofeo del drago. Non sta mai fermo quando ci clicchi.",
		"Ricompensa rara: una vita condivisa del Clowder, una volta sola per tutta la squadra. Nella campagna ne esistono solo sei.",
		"Come: il drago se n'è andato con l'isola dell'End. Trofeo facoltativo — non sbarra i bauli di ender."
	]
	quest.4200000000170337.title: "Mostra dell'uovo di drago"
	quest.4200000000170338.quest_desc: [
		"Elitre per viaggiare nel cielo.",
		"Facoltativo — il vuoto potrebbe non offrirtelo mai.",
		"Come: le città dell'End non ci sono più. Facoltativo."
	]
	quest.4200000000170338.title: "Mostra delle elitre"
	quest.4200000000170339.quest_desc: [
		"Gusci di shulker per le scatole.",
		"Facoltativo — qui non ci sono shulker, quindi il pack fabbrica i gusci.",
		"Come: ricetta del pack, sei blocchi di purpur, due perle di ender e un Nodo legante. Gli shulker non compaiono mai qui. Facoltativo."
	]
	quest.4200000000170339.title: "Scorta di guscio di shulker"
	quest.420000000017033A.quest_desc: [
		"Un baule portatile che tiene il contenuto quando lo rompi.",
		"Facoltativo — i Camminabordi nella Sala Clowder ne vendono una.",
		"Come: due Gusci di shulker intorno a un baule (i gusci sono una ricetta del pack), o la bancarella dei Camminabordi a /clowder hub per 22 Matasse di Filo (198 Filo). Facoltativo."
	]
	quest.420000000017033A.title: "Mostra della scatola di shulker"
	quest.420000000017033B.quest_desc: [
		"Cristalli dell'End — con delicatezza.",
		"Come: vetro, occhio di ender, lacrima di ghast. Nether dopo l'ossidiana di Artiglio; l'uovo è facoltativo."
	]
	quest.420000000017033B.title: "Mostra del cristallo dell'End"
	quest.420000000017033C.quest_desc: [
		"Ogni cassa di ender, su ogni piattaforma, condivide un unico deposito nascosto.",
		"Come: otto ossidiane intorno a un Occhio di ender. L'occhio è perla di ender più polvere di blaze."
	]
	quest.420000000017033C.title: "Mostra della cassa di ender"
	quest.420000000017033D.quest_desc: [
		"Piantalo sulla pietra dell'End e il frutto chorus cresce verso l'alto.",
		"Come: le isole esterne dell'End non ci sono più. Il frutto chorus è alla bancarella dei Camminabordi. Facoltativo."
	]
	quest.420000000017033D.title: "Fiore di chorus"
	quest.420000000017033E.quest_desc: [
		"Dodici di queste, piene di occhi, aprono la via verso l'End.",
		"Come: non è una creazione della piattaforma. Facoltativo."
	]
	quest.420000000017033E.title: "Cornice del portale dell'End"
	quest.420000000017033F.quest_desc: [
		"Polvere di calcestruzzo resa solida. Scura come il vuoto, e permanente una volta indurita.",
		"Come: polvere di calcestruzzo più acqua. La polvere è sabbia, ghiaia e colorante."
	]
	quest.420000000017033F.title: "Calcestruzzo nero"
	quest.4200000000170340.quest_desc: [
		"Un colore d'accento chiassoso per un bioma quieto e pallido.",
		"Come: polvere di calcestruzzo più acqua. La polvere è sabbia, ghiaia e colorante."
	]
	quest.4200000000170340.title: "Calcestruzzo viola"
	quest.4200000000170341.quest_desc: [
		"Lava raffreddata a contatto con l'acqua. Resiste alle esplosioni e si scava lenta.",
		"Come: acqua su una sorgente di lava (o lava sull'acqua). Tieni la sorgente di lava."
	]
	quest.4200000000170341.title: "Scorta di ossidiana"
	quest.4200000000170342.quest_desc: [
		"Brilla fioca e, carica, ti scaglia da un'ancora di rinascita.",
		"Come: casse dei bastioni, baratto con i piglin o api Draconic che lavorano l'ossidiana. I portali in rovina non si generano qui."
	]
	quest.4200000000170342.title: "Scorta di ossidiana piangente"
	quest.4200000000170343.quest_desc: [
		"Caricala con pietra luminosa per fissare un punto di rinascita nel Nether.",
		"Come: ossidiana piangente più pietra luminosa. Rinascita solo nel Nether."
	]
	quest.4200000000170343.title: "Mostra dell'ancora della rinascita"
	quest.4200000000170344.quest_desc: [
		"Tenuto nella mano secondaria, annulla un colpo altrimenti fatale.",
		"Come: solo ricompense delle missioni. Sistema Orologio e Sistema Sigillo ne danno uno ciascuno, e i doni dei Nodi di Filo tardivi ne offrono altri. I raid e gli evocatori non arrivano mai sulla piattaforma. Facoltativo."
	]
	quest.4200000000170344.title: "Mostra del totem"
	quest.4200000000170345.quest_desc: [
		"L'unico drop del Wither. Un faro ne serve una per accendersi.",
		"Come: Wither (tre teschi sulla sabbia delle anime), o il banco dei Cuori di tamburo a /clowder hub una volta, per 12 Rotoli di Filo (972 Filo). Trofeo facoltativo — non sbarra l'End né la Fattoria di mostri al 100%."
	]
	quest.4200000000170345.title: "Mostra della stella del Nether"
	quest.4200000000170346.quest_desc: [
		"Alimentato da una piramide di blocchi minerali, concede bonus finché resti nella sua zona.",
		"Come: stella del Nether, vetro e ossidiana. Trofeo facoltativo — i rami dell'oceano pendono dalla Scorta di ossidiana."
	]
	quest.4200000000170346.title: "Mostra del faro"
	quest.4200000000170347.quest_desc: [
		"Circondato da prismarina, concede respirazione acquatica e fretta sott'acqua.",
		"Facoltativo — il vuoto potrebbe non offrirtelo mai.",
		"Come: servono Cuore del mare e nautilo. Solo oceano. Facoltativo."
	]
	quest.4200000000170347.title: "Mostra del condotto"
	quest.4200000000170348.quest_desc: [
		"Otto circondano un condotto e una si fabbrica nella bussola del mare.",
		"Facoltativo — il vuoto potrebbe non offrirtelo mai.",
		"Come: solo oceano. Facoltativo."
	]
	quest.4200000000170348.title: "Conchiglia di nautilo"
	quest.4200000000170349.quest_desc: [
		"Raro drop di un annegato. Lancialo, oppure incanala un fulmine in un temporale.",
		"Come: solo annegati. Facoltativo."
	]
	quest.4200000000170349.title: "Mostra del tridente"
	quest.420000000018034A.quest_desc: [
		"Essenza base. Nutre tanto gli acceleratori di crescita quanto i riprocessatori.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018034A.title: "Scorta di Inferium"
	quest.420000000018034B.quest_desc: [
		"Un seme incompiuto. Vuole essenza prima di far crescere qualcosa.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018034B.title: "Base di Prosperity"
	quest.420000000018034C.quest_desc: [
		"Consumato una volta, porta l'essenza al grado successivo.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018034C.title: "Infusion Crystal"
	quest.420000000018034D.quest_desc: [
		"Essenza di secondo grado, raffinata da pile di Inferium.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018034D.title: "Scorta di Prudentium"
	quest.420000000018034E.quest_desc: [
		"Essenza di terzo grado, un piolo sopra Prudentium.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018034E.title: "Scorta di Tertium"
	quest.420000000018034F.quest_desc: [
		"Essenza di quarto grado, vicina alla cima della catena.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018034F.title: "Scorta di Imperium"
	quest.4200000000180350.quest_desc: [
		"Essenza di quinto grado, raffinata quasi al limite.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180350.title: "Scorta di Supremium"
	quest.4200000000180351.quest_desc: [
		"Il vertice raffinato. Serve per l'equipaggiamento e i semi più forti.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180351.title: "Essenza risvegliata"
	quest.4200000000180352.quest_desc: [
		"Il pezzo centrale per risvegliare l'essenza nella forma finale.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180352.title: "Awakening Altar"
	quest.4200000000180353.quest_desc: [
		"Cingi l'altare con questi per completare il risveglio.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180353.title: "Awakening Pedestal"
	quest.4200000000180354.quest_desc: [
		"Un cristallo d'infusione a cui non finiscono mai le cariche.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180354.title: "Cristallo maestro"
	quest.4200000000180355.quest_desc: [
		"Tiene essenza in quantità, così le macchine non restano mai a secco.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180355.title: "Essence Vessel"
	quest.4200000000180356.quest_desc: [
		"Il componente di base di ogni macchina alimentata a essenza.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180356.title: "Machine Frame"
	quest.4200000000180357.quest_desc: [
		"Tiene d'occhio le colture vicine e le rompe nel momento in cui maturano.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180357.title: "Harvester"
	quest.4200000000180358.quest_desc: [
		"Ritrasforma i semi di troppo in essenza, invece che in ciarpame.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180358.title: "Seed Reprocessor"
	quest.4200000000180359.quest_desc: [
		"Accelera le colture vicine con essenza di Inferium.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180359.title: "Acceleratore Inferium"
	quest.420000000018035A.quest_desc: [
		"Un acceleratore più forte, un grado sopra l'Inferium.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018035A.title: "Acceleratore Prudentium"
	quest.420000000018035B.quest_desc: [
		"Accelerazione di grado medio, per un campo più indaffarato.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018035B.title: "Acceleratore Tertium"
	quest.420000000018035C.quest_desc: [
		"Quasi in cima all'intervallo di velocità di crescita.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018035C.title: "Acceleratore Imperium"
	quest.420000000018035D.quest_desc: [
		"L'acceleratore più veloce che l'essenza possa costruire.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018035D.title: "Acceleratore Supremium"
	quest.420000000018035E.quest_desc: [
		"Uno spruzzo d'acqua semplice, per colture assetate.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018035E.title: "Watering Can"
	quest.420000000018035F.quest_desc: [
		"Un annaffiatoio infuso di Inferium, con più portata.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.420000000018035F.title: "Annaffiatoio di Inferium"
	quest.4200000000180360.quest_desc: [
		"Annaffia più colture a ogni uso dell'annaffiatoio base.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180360.title: "Annaffiatoio di Prudentium"
	quest.4200000000180361.quest_desc: [
		"Un annaffiatoio di grado medio, con uno spruzzo parecchio più largo.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180361.title: "Annaffiatoio di Tertium"
	quest.4200000000180362.quest_desc: [
		"Annaffia un bel tratto di campo in un solo passaggio.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180362.title: "Annaffiatoio di Imperium"
	quest.4200000000180363.quest_desc: [
		"Lo spruzzo più largo che un annaffiatoio riesca a fare.",
		"Come: creazione di Mystical Agriculture in JEI. Inferium e Prosperity vengono dal setaccio; i semi si infondono sull'Altare di infusione."
	]
	quest.4200000000180363.title: "Annaffiatoio di Supremium"
	quest.4200000000180364.quest_desc: [
		"Accelera la crescita se la lanci sulle colture già piantate.",
