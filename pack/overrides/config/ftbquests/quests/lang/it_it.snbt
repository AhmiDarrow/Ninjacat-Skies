	quest.42000000001D0483.title: "Fornitore di modelli (Rete)"
	quest.42000000001D0484.quest_desc: [
		"Assembla gli oggetti fabbricati seguendo un modello salvato.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0484.title: "Assemblatore molecolare (Rete)"
	quest.42000000001D0485.quest_desc: [
		"Un blocco di memoria che la rete usa mentre fabbrica.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0485.title: "Unità di fabbricazione (Rete)"
	quest.42000000001D0486.quest_desc: [
		"Accelera un solo lavoro di fabbricazione che corre nella rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0486.title: "Acceleratore di fabbricazione"
	quest.42000000001D0487.quest_desc: [
		"Aggiunge memoria di fabbricazione a un'unità di fabbricazione.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0487.title: "Memoria di fabbricazione da 1k"
	quest.42000000001D0488.quest_desc: [
		"Più memoria di fabbricazione per lavori più grandi.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0488.title: "Memoria di fabbricazione da 4k"
	quest.42000000001D0489.quest_desc: [
		"Un blocco serio di memoria di fabbricazione.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0489.title: "Memoria di fabbricazione da 16k"
	quest.42000000001D048A.quest_desc: [
		"Memoria di fabbricazione sufficiente per i lavori più grandi della rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D048A.title: "Memoria di fabbricazione da 64k"
	quest.42000000001D048B.quest_desc: [
		"Memoria di fabbricazione da archivio, raramente serve, ma c'è quando serve.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D048B.title: "Memoria di fabbricazione da 256k"
	quest.42000000001D048C.quest_desc: [
		"Emette redstone quando un oggetto seguito supera un conteggio.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D048C.title: "Emettitore di livello (Rete)"
	quest.42000000001D048D.quest_desc: [
		"Posa blocchi dalla rete nel mondo.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D048D.title: "Piano di formazione (Rete)"
	quest.42000000001D048E.quest_desc: [
		"Rompe i blocchi e tira ciò che cade nella rete.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D048E.title: "Piano di annientamento (Rete)"
	quest.42000000001D048F.quest_desc: [
		"Porta un canale della rete attraverso un'interruzione nel percorso del cavo.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D048F.title: "Tunnel P2P"
	quest.42000000001D0490.quest_desc: [
		"Piega un pezzetto di spazio in una cella portatile.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0490.title: "Spaziale 2"
	quest.42000000001D0491.quest_desc: [
		"Sfoglia il deposito della rete da ovunque, con un potenziatore vicino.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0491.title: "Terminale senza fili (Rete)"
	quest.42000000001D0492.quest_desc: [
		"Fabbrica dalla rete senza tornare a piedi a un terminale.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0492.title: "Fabbricazione senza fili"
	quest.42000000001D0493.quest_desc: [
		"Spara sfere di materia; caricalo prima di averne bisogno.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0493.title: "Cannone di materia"
	quest.42000000001D0494.quest_desc: [
		"Un blocco trasparente per gusci del controller e percorsi dei cavi.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0494.title: "Vetro di quarzo"
	quest.42000000001D0495.quest_desc: [
		"Vetro che brilla da solo, senza bisogno di torcia.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0495.title: "Quarzo vibrante"
	quest.42000000001D0496.quest_desc: [
		"Un blocco di stoccaggio solido, quattro cristalli condensati in uno.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0496.title: "Blocco di Fluix"
	quest.42000000001D0497.quest_desc: [
		"Suddivide una cella di stoccaggio in diverse riserve più piccole.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001D0497.title: "Banco da lavoro per celle"
	quest.42000000001E0498.quest_desc: [
		"Argilla e farina d'ossa, un passo verso gli attrezzi di porcellana.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: palla d'argilla + farina d'ossa, senza forma. L'argilla viene dal Barile di tensione."
	]
	quest.42000000001E0498.title: "Argilla di porcellana (Arte del vuoto)"
	quest.42000000001E0499.quest_desc: [
		"Un secchio più leggero, più gentile con il bilancio di ghiaia iniziale.",
		"Come: forma l'argilla di porcellana in un secchio non cotto, poi fondilo."
	]
	quest.42000000001E0499.title: "Porcelain Bucket"
	quest.42000000001E049A.quest_desc: [
		"Fonde i blocchi in liquido sopra un fuoco.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E049A.title: "Crogiolo di porcellana (Arte del vuoto)"
	quest.42000000001E049B.quest_desc: [
		"La prima maglia del setaccio; lenta, ma funziona.",
		"Come: nove spaghi in un 3x3. La bancarella dei Cantori di ghiaia vende la maglia di Filo (spago) del Telaio del vuoto, che setaccia uguale."
	]
	quest.42000000001E049B.title: "Maglia di spago (Arte del vuoto)"
	quest.42000000001E049C.quest_desc: [
		"Setaccia più in fretta dello spago, vale il miglioramento.",
		"Come: quattro selci e cinque spaghi a scacchiera. La selce viene dalla ghiaia, o da Filo + ghiaia."
	]
	quest.42000000001E049C.title: "Maglia di selce (Arte del vuoto)"
	quest.42000000001E049D.quest_desc: [
		"Una maglia intermedia solida, per setacciare con costanza.",
		"Come: quattro lingotti di ferro e cinque spaghi a scacchiera. Nessuna bancarella lo vende."
	]
	quest.42000000001E049D.title: "Maglia di ferro (Voidcraft)"
	quest.42000000001E049E.quest_desc: [
		"Tira fuori bottini più rari del ferro.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E049E.title: "Maglia d'oro (Voidcraft)"
	quest.42000000001E049F.quest_desc: [
		"Setaccia abbastanza in fretta da tenere nutrita una fila di tramogge.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E049F.title: "Maglia di diamante (Voidcraft)"
	quest.42000000001E04A0.quest_desc: [
		"La migliore maglia che un setaccio potrà mai tenere.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04A0.title: "Maglia di netherite (Voidcraft)"
	quest.42000000001E04A1.quest_desc: [
		"Filata dallo spago, la fibra propria del Telaio.",
		"Come: quattro spaghi → due filati. Barile di tensione: spago + perla. Quattro Lanugini del telaio."
	]
	quest.42000000001E04A1.title: "Scorta di Filato del vuoto"
	quest.42000000001E04A2.quest_desc: [
		"La soglia morbida del Telaio: pali, presse e controller ne vogliono tutti uno.",
		"Come: anello di Filato del vuoto intorno a una palla di slime."
	]
	quest.42000000001E04A2.title: "Scorta di Nodo legante"
	quest.42000000001E04A3.quest_desc: [
		"La versione del Telaio del vuoto della maglia base da setaccio.",
		"Come: spago intorno al filato. La bancarella dei Cantori di ghiaia ne vende una."
	]
	quest.42000000001E04A3.title: "Maglia di Filo (spago)"
	quest.42000000001E04A4.quest_desc: [
		"Una maglia del Telaio del vuoto, un gradino sopra lo spago semplice.",
		"Come: selce intorno a una maglia di Filo (spago)."
	]
	quest.42000000001E04A4.title: "Maglia di Filo (selce)"
	quest.42000000001E04A5.quest_desc: [
		"Una maglia del Telaio del vuoto, fatta per una resa costante.",
		"Come: ferro intorno a una maglia di Filo (selce). Qui inizia il Filamento di Filo."
	]
	quest.42000000001E04A5.title: "Maglia di Filo (ferro)"
	quest.42000000001E04A6.quest_desc: [
		"Spezza la graniglia di un gradino più fine: ciottoli in ghiaia, ghiaia in sabbia, sabbia in polvere.",
		"Come: ciottoli + bastoni. Rompi la graniglia in ghiaia, sabbia e polvere."
	]
	quest.42000000001E04A6.title: "Martello a fuso (Voidcraft)"
	quest.42000000001E04A7.quest_desc: [
		"Spoglia le foglie per arboscelli e bachi da seta.",
		"Come: quattro bastoni. Il banco dei Cantori di ghiaia ne vende uno."
	]
	quest.42000000001E04A7.title: "Vincastro a fuso"
	quest.42000000001E04A8.quest_desc: [
		"La cornice da setaccio del Telaio: tendici una maglia e dalle graniglia.",
		"Come: assi intorno a un Nodo legante. Tendi una maglia, versa la graniglia con una tramoggia, posala su una tramoggia."
	]
	quest.42000000001E04A8.title: "Cornice del telaio"
	quest.42000000001E04A9.quest_desc: [
		"Acqua e terra diventano argilla; spago e una perla diventano filato.",
		"Come: assi, spago e Filato del vuoto. Versa l'acqua (il secchio torna), aggiungi terra → argilla."
	]
	quest.42000000001E04A9.title: "Barile di tensione (Voidcraft)"
	quest.42000000001E04AA.quest_desc: [
		"Nove blocchi di terra piegati in uno, per la salita.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04AA.title: "Compressed Dirt"
	quest.42000000001E04AB.quest_desc: [
		"Nove ciottoli pressati stretti, economici e senza fine.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04AB.title: "Ciottoli compressi (Voidcraft)"
	quest.42000000001E04AC.quest_desc: [
		"Nove ghiaie compattate; un setaccio compresso le prende intere.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04AC.title: "Compressed Gravel"
	quest.42000000001E04AD.quest_desc: [
		"Nove blocchi di sabbia pressati in uno, per il trasporto.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04AD.title: "Compressed Sand"
	quest.42000000001E04AE.quest_desc: [
		"Nove blocchi di polvere pressati, per lo stesso motivo.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04AE.title: "Compressed Dust"
	quest.42000000001E04AF.quest_desc: [
		"Pietra del Nether compattata, per un inventario più leggero.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04AF.title: "Compressed Netherrack"
	quest.42000000001E04B0.quest_desc: [
		"Pietra dell'End compattata, utile quando il vuoto va nutrito.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04B0.title: "Compressed End Stone"
	quest.42000000001E04B1.quest_desc: [
		"Ardesia profonda compattata, nove a uno, ed è ancora solo pietra.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04B1.title: "Compressed Deepslate"
	quest.42000000001E04B2.quest_desc: [
		"Frantuma in un colpo un'intera pila di blocchi compressi.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04B2.title: "Martello compresso"
	quest.42000000001E04B3.quest_desc: [
		"Un martello più debole per rompere i blocchi compressi.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04B3.title: "Compressed Iron Hammer"
	quest.42000000001E04B4.quest_desc: [
		"Un setaccio largo, diversi mucchi di ghiaia per volta.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04B4.title: "Setaccio compresso (Voidcraft)"
	quest.42000000001E04B5.quest_desc: [
		"Setaccia come quella di quercia, cambia solo la vena.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04B5.title: "Birch Sieve"
	quest.42000000001E04B6.quest_desc: [
		"Fermenta come qualunque altra botte.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04B6.title: "Birch Barrel"
	quest.42000000001E04B7.quest_desc: [
		"Fonde i blocchi come qualunque altro crogiolo.",
		"Come: setaccio, martello, crogiolo o barile di Ex Deorum. Abbina la maglia alla graniglia."
	]
	quest.42000000001E04B7.title: "Birch Crucible"
	quest.42000000001E04B8.quest_desc: [
		"La moneta del Filo: guadagnala, spendila, non sprecarla mai.",
		"Come: ricompense delle missioni, terra con maglia di selce su una Cornice del telaio, scorte del custode."
	]
	quest.42000000001E04B8.title: "Scorta di Filo sfilacciato"
	quest.42000000001E04B9.quest_desc: [
		"Pagine d'archivio e note.",
		"Come: insedia un Filo al Palo, oppure alla bancarella degli Intagliatori di sigilli a /clowder hub (8 Filo). Clic destro per leggere; si tengono, non si spendono."
	]
	quest.42000000001E04B9.title: "Pagine del codice"
	quest.42000000001E04BA.quest_desc: [
		"Clic destro e apri Inizia qui. Accento grave (`): la lista degli incarichi. Il libro non assegna missioni.",
		"Come: kit iniziale / cassa del molo. Clic destro sul libro; l'accento grave (`) è la lista degli incarichi."
	]
	quest.42000000001E04BA.title: "Codice dei Baffi"
	quest.42000000001F04BB.quest_desc: [
		"La carta dentro di un pacco, prima che venga sigillato.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: lingotti d'oro e assi intorno a un Occhio di ender. Prima ricetta di Packaged Auto."
	]
	quest.42000000001F04BB.title: "Componente del pacco"
	quest.42000000001F04BC.quest_desc: [
		"Un involucro di pacco costruito, invece, intorno a un modello salvato.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04BC.title: "Componente di pacco ME"
	quest.42000000001F04BD.quest_desc: [
		"Sigilla gli oggetti in un pacco, così la linea li sposta.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04BD.title: "Confezionatore (confezionato)"
	quest.42000000001F04BE.quest_desc: [
		"Aggiunge un altro scomparto di confezionamento a un confezionatore.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04BE.title: "Estensione del confezionatore"
	quest.42000000001F04BF.quest_desc: [
		"Riapre un pacco in oggetti sfusi.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04BF.title: "Unpackager"
	quest.42000000001F04C0.quest_desc: [
		"Scrive una ricetta di fabbricazione su un modello di pacco.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04C0.title: "Codificatore"
	quest.42000000001F04C1.quest_desc: [
		"Assembla un pacco seguendo la sua ricetta codificata.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04C1.title: "Fabbricatore"
	quest.42000000001F04C2.quest_desc: [
		"Instrada i pacchi verso l'indirizzo che combacia.",
		"Come: Marcatore del distributore, componente di confezionamento, due Gusci di shulker, quattro perle di ender e un blocco di ferro. Gusci: ricetta del pack, sei blocchi di purpur, due perle di ender e un Nodo legante."
	]
	quest.42000000001F04C2.title: "Distributore"
	quest.42000000001F04C3.quest_desc: [
		"Segna una meta a cui un distributore può mandare i pacchi.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04C3.title: "Distributor Marker"
	quest.42000000001F04C4.quest_desc: [
		"Mette i pacchi finiti sulla linea, pronti da ritirare.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04C4.title: "Fornitore di confezionamento"
	quest.42000000001F04C5.quest_desc: [
		"Lascia che un fabbricatore lontano richieda, invece, da questo blocco.",
		"Come: Marcatore dell'intermediario, componente di confezionamento, due Gusci di shulker, due perle di ender, due ossidiane piangenti e un blocco di ferro. Gusci: ricetta del pack, sei blocchi di purpur, due perle di ender e un Nodo legante."
	]
	quest.42000000001F04C5.title: "Intermediario di fabbricazione"
	quest.42000000001F04C6.quest_desc: [
		"Tiene un gruppo di ricette di pacco da riusare.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04C6.title: "Porta-ricette"
	quest.42000000001F04C7.quest_desc: [
		"Copia le impostazioni di un blocco su un altro e risparmia un sacco di clic.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04C7.title: "Clonatore di impostazioni"
	quest.42000000001F04C8.quest_desc: [
		"Riempie un pacco di fluido invece che di oggetti.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04C8.title: "Fluid Package Filler"
	quest.42000000001F04C9.quest_desc: [
		"Un involto sigillato di oggetti, pronto da spostare o da riporre.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04C9.title: "Oggetto pacco"
	quest.42000000001F04CA.quest_desc: [
		"Stiva molto di più in un solo pacco rispetto al tipo base.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04CA.title: "Volume Package"
	quest.42000000001F04CB.quest_desc: [
		"Segna dove deve arrivare un intermediario di fabbricazione.",
		"Come: componente di pacco, poi Confezionatore / Codificatore. Serve una rete AE2 per il pezzo ME."
	]
	quest.42000000001F04CB.title: "Proxy Marker"
	quest.42000000001F04CC.quest_desc: [
		"Collega la linea di confezionamento al telaio digitale.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001F04CC.title: "Interfaccia AE"
	quest.42000000001F04CD.quest_desc: [
		"Fornisce modelli di fabbricazione alla linea di confezionamento.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001F04CD.title: "Fornitore di modelli (confezionato)"
	quest.42000000001F04CE.quest_desc: [
		"Fabbrica oggetti per i modelli del telaio digitale stesso.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001F04CE.title: "Assemblatore molecolare (confezionato)"
	quest.42000000001F04CF.quest_desc: [
		"Prima una rete del telaio digitale, o niente di questo confezionamento gira.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001F04CF.title: "Controllore ME"
	quest.42000000001F04D0.quest_desc: [
		"Porta energia o segnali.",
		"Come: Rete del Fuso — Certus dalla sabbia, il controller vuole un Nodo legante."
	]
	quest.42000000001F04D0.title: "Cavo di Fluix (confezionato)"
	quest.42000000001F04D1.quest_desc: [
		"Confeziona gli oggetti dal lato Create, in modo meccanico.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001F04D1.title: "Confezionatore di Create"
	quest.42000000001F04D2.quest_desc: [
		"Raduna i pacchi divisi di nuovo in ordini interi.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001F04D2.title: "Riconfezionatore di Create"
	quest.42000000001F04D3.quest_desc: [
		"Chiede oggetti confezionati a una rete di scorte collegata.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001F04D3.title: "Ticker delle scorte (confezionato)"
	quest.42000000001F04D4.quest_desc: [
		"Una cassa tampone di massa per i pacchi che aspettano il loro turno.",
		"Come: fabbricazione Create in JEI (banco da lavoro, pressa, miscelatore o dispiegatore). La lega di andesite e una ruota ad acqua avviano la linea."
	]
	quest.42000000001F04D4.title: "Caveau degli oggetti (confezionato)"
	quest.42000000002004D5.quest_desc: [
		"Un disco base di stoccaggio quantistico per la rete QIO.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004D5.title: "Base del disco QIO"
	quest.42000000002004D6.quest_desc: [
		"Mette molto più spazio su un solo disco quantistico.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004D6.title: "QIO iperdenso"
	quest.42000000002004D7.quest_desc: [
		"Un disco quantistico che baratta la dimensione con densità grezza.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004D7.title: "QIO dilatazione temporale"
	quest.42000000002004D8.quest_desc: [
		"Il più grande disco quantistico che Mekanism produce.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004D8.title: "QIO supermassiccio"
	quest.42000000002004D9.quest_desc: [
		"Tiene diversi dischi quantistici in un solo alloggiamento.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004D9.title: "Gruppo di unità OQI"
	quest.42000000002004DA.quest_desc: [
		"Sfoglia tutto ciò che sta conservando la rete QIO.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004DA.title: "Pannello di controllo OQI"
	quest.42000000002004DB.quest_desc: [
		"Porta il pannello QIO nella tua tasca.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004DB.title: "QIO portatile"
	quest.42000000002004DC.quest_desc: [
		"L'involucro di base della maggior parte delle macchine Mekanism avanzate.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004DC.title: "Involucro d'acciaio (QIO)"
	quest.42000000002004DD.quest_desc: [
		"Conserva un'enorme quantità di energia in un solo blocco.",
		"Ricompensa rara: una vita condivisa del Clowder, una volta sola per tutta la squadra. Nella campagna ne esistono solo sei.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004DD.title: "Cubo supremo"
	quest.42000000002004DE.quest_desc: [
		"Tiene una pila enorme di un solo oggetto.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004DE.title: "Contenitore definitivo"
	quest.42000000002004DF.quest_desc: [
		"Fonde più pile in una volta, veloce quanto Mekanism sa essere.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004DF.title: "Fabbrica fusoria suprema"
	quest.42000000002004E0.quest_desc: [
		"Arricchisce il minerale alla massima velocità che offre Mekanism.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E0.title: "Fabbrica di arricchimento suprema"
	quest.42000000002004E1.quest_desc: [
		"Frantuma il minerale alla massima velocità che offre Mekanism.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E1.title: "Fabbrica di frantumazione suprema"
	quest.42000000002004E2.quest_desc: [
		"Scava un chunk intero da solo, dritto fino al vuoto.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E2.title: "Minatore digitale (QIO)"
	quest.42000000002004E3.quest_desc: [
		"Un attrezzo modulare che cambia da solo la propria testa di lavoro.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E3.title: "Disassemblatore atomico (QIO)"
	quest.42000000002004E4.quest_desc: [
		"Ruota le facce e copia le impostazioni tra le macchine Mekanism.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E4.title: "Configuratore (QIO)"
	quest.42000000002004E5.quest_desc: [
		"Ti porta in un balzo tra due basi collegate.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E5.title: "Teletrasportatore (QIO)"
	quest.42000000002004E6.quest_desc: [
		"Fa da cornice al portale che apre un teletrasportatore.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E6.title: "Struttura per seletrasportatore"
	quest.42000000002004E7.quest_desc: [
		"Involucro del reattore che produce antimateria.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E7.title: "Telaio ASS"
	quest.42000000002004E8.quest_desc: [
		"Immette i composti chimici e tira l'antimateria fuori dal reattore.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E8.title: "Portello ASS"
	quest.42000000002004E9.quest_desc: [
		"Accelera la produzione di un reattore ad antimateria.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004E9.title: "Bobina sovraccaricata"
	quest.42000000002004EA.quest_desc: [
		"Separa gli isotopi girando, per la chimica tarda.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004EA.title: "Centrifuga isotopica"
	quest.42000000002004EB.quest_desc: [
		"Scioglie il minerale in una fanghiglia chimica.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004EB.title: "Dissoluzione chimica"
	quest.42000000002004EC.quest_desc: [
		"Lava la fanghiglia fino a ripulirla, prima di cristallizzarla.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004EC.title: "Lavatore chimico"
	quest.42000000002004ED.quest_desc: [
		"Riporta un composto chimico a un cristallo solido.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004ED.title: "Cristallizzatore chimico"
	quest.42000000002004EE.quest_desc: [
		"Bombarda il materiale con neutroni spinti dalla luce del sole.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004EE.title: "Neutrone solare"
	quest.42000000002004EF.quest_desc: [
		"Converte l'energia direttamente in calore per una caldaia.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004EF.title: "Riscaldatore elettrico"
	quest.42000000002004F0.quest_desc: [
		"Brucia legno per calore, non per energia.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F0.title: "Riscaldatore a pellet"
	quest.42000000002004F1.quest_desc: [
		"Sintesi tarda di materiali altrimenti impossibili.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F1.title: "Antiprotonico"
	quest.42000000002004F2.quest_desc: [
		"Un solo attrezzo modulare per minare, scavare e altro.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F2.title: "Meka-Tool"
	quest.42000000002004F3.quest_desc: [
		"Armatura della tuta per la testa, potenziata modulo per modulo.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F3.title: "Elmo Meka"
	quest.42000000002004F4.quest_desc: [
		"Armatura della tuta per il petto, potenziata modulo per modulo.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F4.title: "Pettorale Meka"
	quest.42000000002004F5.quest_desc: [
		"Armatura della tuta per le gambe, potenziata modulo per modulo.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F5.title: "Pantaloni Meka"
	quest.42000000002004F6.quest_desc: [
		"Armatura della tuta per i piedi, potenziata modulo per modulo.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F6.title: "Stivali Meka"
	quest.42000000002004F7.quest_desc: [
		"Guscio per una caldaia a vapore.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F7.title: "Telaio della caldaia"
	quest.42000000002004F8.quest_desc: [
		"Accumula una grande quantità di energia.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F8.title: "Cubo di energia élite"
	quest.42000000002004F9.quest_desc: [
		"Accumula una quantità moderata di energia.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004F9.title: "Cubo di energia avanzato"
	quest.42000000002004FA.quest_desc: [
		"Accumula poca energia, utile per iniziare.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004FA.title: "Cubo di energia di base (QIO)"
	quest.42000000002004FB.quest_desc: [
		"Infonde il metallo di una sostanza chimica per nuove leghe.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004FB.title: "Infusore metallurgico (QIO)"
	quest.42000000002004FC.quest_desc: [
		"Raddoppia il prodotto del minerale grezzo prima di fonderlo.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004FC.title: "Camera di arricchimento (QIO)"
	quest.42000000002004FD.quest_desc: [
		"Macina o frantuma materiali in blocco.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004FD.title: "Frantumatore (QIO)"
	quest.42000000002004FE.quest_desc: [
		"Fonde più in fretta di una fornace, a energia invece che a combustibile.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004FE.title: "Fonderia energizzata (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Taglia il legno con la lama di precisione propria di Mekanism.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.42000000002004FF.title: "Segheria di precisione"
	quest.4200000000200500.quest_desc: [
		"Divide l'acqua nei suoi due gas componenti.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.4200000000200500.title: "Separatore elettrolitico"
	quest.4200000000200501.quest_desc: [
		"Unisce due sostanze chimiche in una nuova.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.4200000000200501.title: "Infusore chimico"
	quest.4200000000200502.quest_desc: [
		"Purifica fluidi o minerali.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.4200000000200502.title: "Purificazione"
	quest.4200000000200503.quest_desc: [
		"Inietta una sostanza chimica nel minerale per un prodotto in più.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.4200000000200503.title: "Iniezione chimica"
	quest.4200000000200504.quest_desc: [
		"Comprime osmio sugli oggetti, per un equipaggiamento più duro.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.4200000000200504.title: "Compressore di osmio (QIO)"
	quest.4200000000200505.quest_desc: [
		"Unisce più componenti in un pezzo finito.",
		"Come: capitolo Officine Mekanism — frammenti di minerale dal setaccio, poi la linea di fabbrica."
	]
	quest.4200000000200505.title: "Combinatore"
	quest.4200000000210506.quest_desc: [
		"Gli zombie lo lasciano, che tu lo voglia o no.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: uccidi zombie sulla piattaforma di notte, o in un buco buio."
	]
	quest.4200000000210506.title: "Scorta di carne marcia"
	quest.4200000000210507.quest_desc: [
		"Gli scheletri li lasciano; macinali più tardi in farina d'ossa.",
		"Come: scheletri di notte, o /clowder hub Custodi della piattaforma (16 Filo per 8)."
	]
	quest.4200000000210507.title: "Scorta di ossa"
	quest.4200000000210508.quest_desc: [
		"I creeper lo pagano, a volte esplodendo.",
		"Come: setaccia polvere o sabbia delle anime, oppure creeper sulla piattaforma di notte. Tieni i bordi illuminati dopo che ne hai un po'."
	]
	quest.4200000000210508.title: "Scorta di polvere da sparo"
	quest.4200000000210509.quest_desc: [
		"I ragni lo lasciano, e un setaccio mai.",
		"Come: sfilaccia il Filo sfilacciato (1 → 3). Ragni. Lanugine del telaio su una Legatura d'eco. Scarico inverso del filato."
	]
	quest.4200000000210509.title: "Scorta di spago"
	quest.420000000021050A.quest_desc: [
		"Si distilla in veleno e nutre qualche ricetta strana.",
		"Come: ragni sulla piattaforma di notte."
	]
	quest.420000000021050A.title: "Scorta di occhi di ragno"
	quest.420000000021050B.quest_desc: [
		"Gli endermen le lasciano; una fattoria batte il chiederle in elemosina al vuoto.",
		"Come: endermen, o la bancarella dei Camminabordi a /clowder hub."
	]
	quest.420000000021050B.title: "Fattoria di perle di ender"
	quest.420000000021050C.quest_desc: [
		"Combustibile sia per gli alambicchi sia per i bruciatori di blaze.",
		"Come: fortezza del Nether dopo l'ossidiana di Artiglio. Le pozioni vogliono una verga; Ars e Occultism non la aspettano."
	]
	quest.420000000021050C.title: "Fattoria di verghe di blaze"
	quest.420000000021050D.quest_desc: [
		"Un bottino raro, chiave per le pozioni di rigenerazione.",
		"Come: ghast del Nether dopo l'ossidiana di Artiglio."
	]
	quest.420000000021050D.title: "Fattoria di lacrime di ghast"
	quest.420000000021050E.quest_desc: [
		"Si distilla in resistenza al fuoco e nutre qualche creazione.",
		"Come: una palla di slime lasciata in un barile di lava, slime più polvere di blaze, o cubi di magma."
	]
	quest.420000000021050E.title: "Fattoria di crema di magma"
	quest.420000000021050F.quest_desc: [
		"Abbastanza appiccicoso per pistoni, blocchi di slime e guinzagli.",
		"Come: due terre + semi di grano + farina d'ossa (compost della piattaforma), o /clowder hub Custodi della piattaforma."
	]
	quest.420000000021050F.title: "Fattoria di palle di slime"
	quest.4200000000210510.quest_desc: [
		"Tre di queste evocano un boss per cui vale la pena combattere.",
		"Come: fortezza del Nether dopo l'ossidiana di Artiglio. Tre teschi avviano un Wither."
	]
	quest.4200000000210510.title: "Teschio di scheletro wither"
	quest.4200000000210511.quest_desc: [
		"Il tributo stesso del wither, raro e greve di potere.",
		"Come: Wither (tre teschi sulla sabbia delle anime), o il banco dei Cuori di tamburo a /clowder hub una volta, per 12 Rotoli di Filo (972 Filo). Trofeo facoltativo — non sbarra l'End né la Fattoria di mostri al 100%."
	]
	quest.4200000000210511.title: "Stella del Nether"
	quest.4200000000210512.quest_desc: [
		"Diventa una scatola di shulker, un deposito che sopravvive alla morte.",
		"Facoltativo — qui non ci sono shulker, quindi il pack fabbrica i gusci.",
		"Come: ricetta del pack, sei blocchi di purpur, due perle di ender e un Nodo legante. Gli shulker non compaiono mai qui. Facoltativo."
	]
	quest.4200000000210512.title: "Fattoria di gusci di shulker"
	quest.4200000000210513.quest_desc: [
		"Ripara le elitre quando nient'altro ci riesce.",
		"Come: salta il sonno per tre notti, poi uccidi i phantom. Facoltativo."
	]
	quest.4200000000210513.title: "Membrana di phantom"
	quest.4200000000210514.quest_desc: [
		"Inchiostro di calamaro, utile per tingere e per la scrittura all'antica.",
		"Come: carbone di legna più una bottiglia di vetro. I calamari non compaiono mai qui."
	]
	quest.4200000000210514.title: "Fattoria di sacche d'inchiostro"
	quest.4200000000210515.quest_desc: [
		"Fa brillare cartelli e cornici al buio.",
		"Come: i calamari luminescenti non compaiono mai sulla piattaforma. Facoltativo."
	]
	quest.4200000000210515.title: "Inchiostro luminescente"
	quest.4200000000210516.quest_desc: [
		"I guardiani lo lasciano, per blocchi di prismarina e lanterne.",
		"Come: i monumenti oceanici non ci sono più. Facoltativo, a meno che tu non coltivi un seme di prismarina."
	]
	quest.4200000000210516.title: "Frammento di prismarina"
	quest.4200000000210517.quest_desc: [
		"Bottino di guardiano che illumina il mare e alimenta qualche creazione.",
		"Come: i monumenti oceanici non ci sono più. Facoltativo."
	]
	quest.4200000000210517.title: "Cristallo di prismarina"
	quest.4200000000210518.quest_desc: [
		"Cinge un condotto; raccogline otto per chiudere la cornice.",
		"Facoltativo — il vuoto potrebbe non offrirtelo mai.",
		"Come: solo oceano. Facoltativo."
	]
	quest.4200000000210518.title: "Conchiglia di nautilo (Caccia)"
	quest.4200000000210519.quest_desc: [
		"Inganna la morte una volta, poi sparisce.",
		"Come: solo ricompense delle missioni. Sistema Orologio e Sistema Sigillo ne danno uno ciascuno, e i doni dei Nodi di Filo tardivi ne offrono altri. I raid e gli evocatori non arrivano mai sulla piattaforma. Facoltativo."
	]
	quest.4200000000210519.title: "Totem (Caccia)"
	quest.420000000021051A.quest_desc: [
		"I golem lasciano ferro mentre stanno di guardia.",
		"Come: fondi ferro grezzo / graniglia di ferro (fornace o Forno di braci). Setaccia la ghiaia per i pezzi."
	]
	quest.420000000021051A.title: "Dono del golem di ferro"
	quest.420000000021051B.quest_desc: [
		"Lancia palle di neve; munizioni utili, poco come combattente.",
		"Come: un ghiaccio (kit / generatore di ghiaccio), senza forma, in quattro palle di neve."
	]
	quest.420000000021051B.title: "Golem di neve"
	quest.420000000021051C.quest_desc: [
		"Gli scheletri tengono la piattaforma rifornita di munizioni.",
		"Come: selce, bastone, piuma. Gli scheletri ne lasciano in più."
	]
	quest.420000000021051C.title: "Fattoria di frecce"
	quest.420000000021051D.quest_desc: [
		"Segna ciò che colpisce con un bagliore temporaneo.",
		"Come: polvere di pietra luminosa intorno a una freccia."
	]
	quest.420000000021051D.title: "Freccia spettrale"
	quest.420000000021051E.quest_desc: [
		"Monta quando trovi una sella.",
		"Facoltativo — i Custodi della piattaforma nella Sala Clowder ne vendono una.",
		"Come: scambia un blocco di diamante con i Custodi della piattaforma nel loro negozio nella Sala Clowder (/clowder hub). La Sella Chocobo è un oggetto diverso."
	]
	quest.420000000021051E.title: "Sella (Caccia)"
	quest.420000000021051F.quest_desc: [
		"Dà un nome a una creatura, così non sparisce mai.",
		"Facoltativo — gli Intagliatori di sigilli nella Sala Clowder ne vendono una.",
		"Come: pesca / casse rare, o la bancarella degli Intagliatori di sigilli a /clowder hub (24 Filo). Facoltativo."
	]
	quest.420000000021051F.title: "Fattoria di targhette"
	quest.4200000000210520.quest_desc: [
		"Lega un collegamento o un cavo.",
		"Come: quattro spaghi intorno a una palla di slime. Lo slime è il compost della piattaforma (terra, semi, farina d'ossa)."
	]
	quest.4200000000210520.title: "Guinzaglio (Caccia)"
	quest.4200000000210521.quest_desc: [
		"Le galline le depongono più in fretta di quanto tu riesca a raccoglierle.",
		"Come: semi di grano alle galline sulla piattaforma, o il pollaio del capitolo Fattoria di mostri."
	]
	quest.4200000000210521.title: "Scorta di uova"
	quest.4200000000210522.quest_desc: [
		"Scorta di cuoio e di manzo.",
		"Come: fondi la carne marcia o cuocila al falò. Setaccia la terra con una maglia di selce. /clowder hub I Custodi della piattaforma ne vendono due per 18 Filo."
	]
	quest.4200000000210522.title: "Scorta di cuoio"
	quest.4200000000210523.quest_desc: [
		"Le pecore la fanno ricrescere dopo una tosatura.",
		"Come: tosa le pecore dopo aver dato l'erba, oppure quattro spaghi."
	]
	quest.4200000000210523.title: "Scorta di lana"
	quest.4200000000210524.quest_desc: [
		"Scorta di cibo per la cucina.",
		"Come: grano alle mucche sulla piattaforma."
	]
	quest.4200000000210524.title: "Scorta di manzo"
	quest.4200000000210525.quest_desc: [
		"I maiali lo danno; cuocilo prima di mangiarlo.",
		"Come: patate o carote ai maiali sulla piattaforma."
	]
	quest.4200000000210525.title: "Scorta di maiale"
	quest.4200000000210526.quest_desc: [
		"Pollo per i pasti e le piume.",
		"Come: semi alle galline sulla piattaforma."
	]
	quest.4200000000210526.title: "Scorta di pollo"
	quest.4200000000210527.quest_desc: [
		"Carne di pecora, meglio arrostita che cruda.",
		"Come: grano alle pecore sulla piattaforma."
	]
	quest.4200000000210527.title: "Scorta di montone"
	quest.4200000000210528.quest_desc: [
		"Distilla una pozione della fortuna, se puoi farne a meno.",
		"Facoltativo — il vuoto potrebbe non offrirtelo mai.",
		"Come: i conigli non compaiono sulla piattaforma. Facoltativo."
	]
	quest.4200000000210528.title: "Zampa di coniglio"
	quest.4200000000210529.quest_desc: [
		"Un pezzo da esposizione che merita di stare accanto a un uovo di drago.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000210529.title: "Testa di zombie"
	quest.420000000021052A.quest_desc: [
		"Sta bene con un uovo di drago su una mensola.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000021052A.title: "Teschio di scheletro"
	quest.420000000021052B.quest_desc: [
		"Un'altra testa per la mensola dei trofei, accanto all'uovo.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000021052B.title: "Testa di creeper"
	quest.420000000021052C.quest_desc: [
		"Un'altra testa, a casa sua vicino a un uovo di drago.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000021052C.title: "Testa di piglin"
	quest.420000000021052D.quest_desc: [
		"La testa più rara, guadagnata solo a combattimento finito.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000021052D.title: "Testa di drago"
	quest.420000000021052E.quest_desc: [
		"Solo se a un giocatore ne capita di farne cadere una.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.420000000021052E.title: "Testa di giocatore"
	quest.420000000022052F.quest_desc: [
		"La prima creazione ne dà 2 — tienine uno per il Codice, più tardi.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: un osso, spago, ametista. /clowder hub I Custodi della piattaforma vendono ossa. Cancello Scintilla / Ronzio."
	]
	quest.420000000022052F.title: "Campanello d'osso"
	quest.4200000000220530.quest_desc: [
		"Scheggia di un vecchio canto di tribù — serve un Campanello.",
		"Come: Campanello d'osso, ametista e redstone, senza forma. Ne rende due."
	]
	quest.4200000000220530.title: "Scheggia di Spirito"
	quest.4200000000220531.quest_desc: [
		"Accorda il metallo allo spirito — rame intorno a un Campanello.",
		"Come: rame intorno a un Campanello d'osso. Ne rende due."
	]
	quest.4200000000220531.title: "Risonatore di rame"
	quest.4200000000220532.quest_desc: [
		"Segna le linee del reticolo — il gesso vuole una Scheggia.",
		"Come: due farine d'ossa, lapislazzuli e una Scheggia spirituale, senza forma. Rende quattro."
	]
	quest.4200000000220532.title: "Gesso rituale (tribale)"
	quest.4200000000220533.quest_desc: [
		"Piazza il cuore — due Campanelli d'osso, una Scheggia spirituale, due cuoio e quattro assi (i Custodi della piattaforma vendono cuoio).",
		"Come: due Campanelli d'osso, una Scheggia spirituale, due cuoi e quattro assi. Colpisci a mani vuote a tempo (17–23 tick) per 24 di Pulso."
	]
	quest.4200000000220533.title: "Battito del Cuore di tamburo"
	quest.4200000000220534.quest_desc: [
		"Nove tribù hanno mormorato una volta — servono un Campanello e una Scheggia di scorta.",
		"Come: crealo, oppure prendilo come ricompensa di Scintilla/Tessitura tribale. Clic destro: come funziona il reticolo."
	]
	quest.4200000000220534.title: "Codice spirituale"
	quest.4200000000220535.quest_desc: [
		"Tira la ley nei battiti.",
		"Come: mettilo sotto il cielo, vicino ad acqua/verde. Pulso lento. Scala di Scintilla."
	]
	quest.4200000000220535.title: "Collettore di ley"
	quest.4200000000220536.quest_desc: [
		"Porta Pulso per attrezzi, incantesimi e viaggi. Riempila a un Cuore di tamburo.",
		"Come: creala, poi riempila da un Cuore di tamburo (clic con la cella). Attrezzi, incantesimi e viaggi attingono dalla cella."
	]
	quest.4200000000220536.title: "Cella di Pulso"
	quest.4200000000220537.quest_desc: [
		"Siedi un catalizzatore d'Eco, che si consuma mentre lavora; aggiungi due voci di totem diverse entro otto blocchi. Più voci rafforzano il canto. La redstone lo mette in pausa.",
		"Come: innesta un catalizzatore d'eco e due totem diversi entro 8. La redstone lo mette in pausa."
	]
	quest.4200000000220537.title: "Risonatore di Pulso"
	quest.4200000000220538.quest_desc: [
		"La tribù della pietra risponde.",
		"Come: un Campanello d'osso, due tronchi, terra e un Risonatore di rame."
	]
	quest.4200000000220538.title: "Totem di Terra"
	quest.4200000000220539.quest_desc: [
		"La tribù della fiamma risponde.",
		"Come: un Campanello d'osso, due tronchi, carbonella e un Risonatore di rame."
	]
	quest.4200000000220539.title: "Totem di Fuoco"
	quest.420000000022053A.quest_desc: [
		"La tribù della marea risponde.",
		"Come: un Campanello d'osso, due tronchi, un secchio d'acqua (o un secchio d'acqua di porcellana) e un Risonatore di rame."
	]
	quest.420000000022053A.title: "Totem d'Acqua"
	quest.420000000022053B.quest_desc: [
		"La tribù del vento risponde.",
		"Come: un Campanello d'osso, due tronchi, una piuma e un Risonatore di rame."
	]
	quest.420000000022053B.title: "Totem d'Aria"
	quest.420000000022053C.quest_desc: [
		"Quinta tribù — nucleo del custode.",
		"Come: un Campanello d'osso, due tronchi, una Scheggia spirituale e un Risonatore di rame."
	]
	quest.420000000022053C.title: "Totem dello Spirito"
	quest.420000000022053D.quest_desc: [
		"Avvia il canto del reticolo. Aspetta pietra o un oggetto di stadio Eco; il metallo grezzo è graniglia nel Frantumatore d'eco.",
		"Come: Codice degli Spiriti + Tessitura tribale. Siedi pietra o un oggetto di stadio Eco. Il metallo grezzo sta nel Frantumatore d'eco."
	]
	quest.420000000022053D.title: "Banco del canto"
	quest.420000000022053E.quest_desc: [
		"Instrada le armoniche fra i totem.",
		"Come: quattro Risonatori di rame intorno alla redstone. Ne fa quattro."
	]
	quest.420000000022053E.title: "Conduttore di reticolo"
	quest.420000000022053F.quest_desc: [
		"Canticchia lo stadio uno — spezza il minerale. La pietra diventa schegge; i ciottoli, ghiaia; il metallo grezzo, graniglia. La frantumazione della graniglia dura 4 secondi a 40 di Pulso/s.",
		"Come: pietra + Campanello d'osso + Risonatore di rame. Totem di Terra entro 8. Pietra → schegge; ciottoli → ghiaia; metallo grezzo → graniglia. Quattro secondi a 40 di Pulso/s."
	]
	quest.420000000022053F.title: "Frantumatore di eco"
	quest.4200000000220540.quest_desc: [
		"Scheggia che ha sentito la frantumazione.",
		"Come: pietra nel Frantumatore d'eco (non ciottoli). Pietra del grado della Fonte, o pietra toccata con Tocco di velluto."
	]
	quest.4200000000220540.title: "Scheggia d'eco (tribale)"
	quest.4200000000220541.quest_desc: [
		"Canticchia lo stadio due — sintonizza.",
		"Come: sette pietre, una Scheggia spirituale e un Risonatore di rame."
	]
	quest.4200000000220541.title: "Sintonizzatore di eco"
	quest.4200000000220542.quest_desc: [
		"Eco che ha trovato una chiave.",
		"Come: Codice degli Spiriti + Tessitura tribale. Stazione, totem e costo in Pulso sono sulla pagina del Codice."
	]
	quest.4200000000220542.title: "Eco sintonizzato"
	quest.4200000000220543.quest_desc: [
		"Stadio del legame — annoda lo spirito al metallo.",
		"Come: sette pietre, una scheggia di ametista e un Risonatore di rame."
	]
	quest.4200000000220543.title: "Vincolatore di eco"
	quest.4200000000220544.quest_desc: [
		"Eco che non scivolerà.",
		"Come: Codice degli Spiriti + Tessitura tribale. Stazione, totem e costo in Pulso sono sulla pagina del Codice."
	]
	quest.4200000000220544.title: "Eco vincolato"
	quest.4200000000220545.quest_desc: [
		"Stadio del ritessere — chiama il lingotto.",
		"Come: cinque pietre, un lingotto d'oro, due Risonatori di rame e una Scheggia spirituale."
	]
	quest.4200000000220545.title: "Manifestatore di eco"
	quest.4200000000220546.quest_desc: [
		"Metallo voluto all'essere dal Polso spirituale, invece di una fornace.",
		"Come: Codice degli Spiriti + Tessitura tribale. Stazione, totem e costo in Pulso sono sulla pagina del Codice."
	]
	quest.4200000000220546.title: "Lingotto manifestato"
	quest.4200000000220547.quest_desc: [
		"Tieni ciò che le tribù hanno lasciato.",
		"Come: sette assi, una cassa e un Campanello d'osso."
	]
	quest.4200000000220547.title: "Deposito ancestrale"
	quest.4200000000220548.quest_desc: [
		"Caveau collegato verso la Marca.",
		"Come: un Nascondiglio ancestrale, quattro lingotti di ferro, una Scheggia spirituale, due Risonatori di rame e una Cella di Pulso."
	]
	quest.4200000000220548.title: "Deposito profondo"
	quest.4200000000220549.quest_desc: [
		"Un sigillo non scritto, in attesa di un rito che lo riempia.",
		"Come: sette carte, una Scheggia spirituale e un Campanello d'osso. Ne fa due."
	]
	quest.4200000000220549.title: "Sigillo vergine"
	quest.420000000022054A.quest_desc: [
		"Sigillo della tribù della pietra.",
		"Come: un Sigillo in bianco e terra, senza forma."
	]
	quest.420000000022054A.title: "Sigillo di Terra"
	quest.420000000022054B.quest_desc: [
		"Sigillo della tribù della fiamma.",
		"Come: un Sigillo in bianco e carbonella, senza forma."
	]
	quest.420000000022054B.title: "Sigillo di Fuoco"
	quest.420000000022054C.quest_desc: [
		"Sigillo della tribù della marea.",
		"Come: un Sigillo in bianco e un secchio d'acqua (o un secchio d'acqua di porcellana), senza forma."
	]
	quest.420000000022054C.title: "Sigillo d'Acqua"
	quest.420000000022054D.quest_desc: [
		"Sigillo della tribù del vento.",
		"Come: un Sigillo in bianco e una piuma, senza forma."
	]
	quest.420000000022054D.title: "Sigillo d'Aria"
	quest.420000000022054E.quest_desc: [
		"Sigillo della tribù del custode.",
		"Come: un Sigillo in bianco e una Scheggia spirituale, senza forma."
	]
	quest.420000000022054E.title: "Sigillo di Spirito"
	quest.420000000022054F.quest_desc: [
		"Offri sigilli. Chiedi al Telaio.",
		"Come: cinque pietre, una scheggia di ametista e un Campanello d'osso."
	]
	quest.420000000022054F.title: "Piedistallo del rito"
	quest.4200000000220550.quest_desc: [
		"Usalo a mani vuote e suona il Rito del cancello: colpisci i battiti che cadono su A, S, D, F. Raggiungi il 60% e si apre; non serve il Polso.",
		"Come: usa il Tamburo del cancello a mani vuote e suona il Rito del cancello: colpisci i battiti che cadono su A, S, D, F. Raggiungi il 60% e si apre; non serve il Polso. Lega prima una bussola del ritorno."
	]
	quest.4200000000220550.title: "Tamburo del cancello (tribale)"
	quest.4200000000220551.quest_desc: [
		"Vesti la soglia del tuo campo con una cornice spirituale intagliata. Bussole e il Tamburo del cancello compiono il viaggio.",
		"Come: quattro lingotti di ferro, due Schegge spirituali, due Risonatori di rame e una scheggia di ametista."
	]
	quest.4200000000220551.title: "Porta spirituale"
	quest.4200000000220552.quest_desc: [
		"Attrezzo che consuma Pulso.",
		"Come: tre Lingotti manifestati, un Campanello d'osso e un bastone."
	]
	quest.4200000000220552.title: "Piccone dell'equipaggiamento spirituale"
	quest.4200000000220553.quest_desc: [
		"Tagliente che consuma Pulso.",
		"Come: due Lingotti manifestati, un Campanello d'osso e un bastone."
	]
	quest.4200000000220553.title: "Lama di Dotazione spirituale"
	quest.4200000000220554.quest_desc: [
		"Pietra della Marca, sotto i piedi, in un luogo che non dovrebbe esistere.",
		"Come: fondi i Ciottoli della Marca. Estraili nella Marca, attraverso un Tamburo del cancello."
	]
	quest.4200000000220554.title: "Pietra della Marca (tribale)"
	quest.4200000000220555.quest_desc: [
		"Macerie della Marca, semplici ma abbondanti.",
		"Come: scava pietra della Marca nella Marca, attraverso un Tamburo del cancello."
	]
	quest.4200000000220555.title: "Ciottoli della Marcia"
	quest.4200000000220556.quest_desc: [
		"Legno cresciuto dove il sole non arriva.",
		"Come: taglia alberi della Marca, attraverso un Tamburo del cancello."
	]
	quest.4200000000220556.title: "Tronco della Marcia"
	quest.4200000000220557.quest_desc: [
		"Legname segato della Marca, robusto nonostante da dove viene.",
		"Come: un Tronco della Marca fa quattro assi."
	]
	quest.4200000000220557.title: "Assi della Marcia"
	quest.4200000000220558.quest_desc: [
		"Foglie che mormorano anche senza alcun vento.",
		"Come: alberi della Marca, attraverso un Tamburo del cancello. Cesoie o Tocco di velluto tengono le foglie."
	]
	quest.4200000000220558.title: "Foglia della Marcia"
	quest.4200000000220559.quest_desc: [
		"Una canna che ronza di Polso spirituale rimasto.",
		"Come: cresce selvatica nella Marca, sta nei forzieri dello sbarramento di canne, e un Anziano dei Legaradici lo scambia."
	]
	quest.4200000000220559.title: "Canna dello spirito (tribale)"
	quest.420000000022055A.quest_desc: [
		"Metti ferro grezzo nel Frantumatore d'eco, accanto a un Totem di Terra. Escono due graniglie; fondile nella fornace o nell'altoforno fino a farne lingotti. Altri Mods possono fornire metalli grezzi con tag.",
		"Come: Codice degli Spiriti + Tessitura tribale. Stazione, totem e costo in Pulso sono sulla pagina del Codice."
	]
	quest.420000000022055A.title: "Il minerale ricorda due volte"
	quest.420000000022055B.quest_desc: [
		"L'acqua lega la lana in Tessuto spirituale. Alimenta la stazione da sopra o dai lati e tira fuori il lavoro finito da sotto.",
		"Come: Codice degli Spiriti + Tessitura tribale. Stazione, totem e costo in Pulso sono sulla pagina del Codice."
	]
	quest.420000000022055B.title: "Stoffa con voce"
	quest.420000000022055C.quest_desc: [
		"Manifesta di nuovo un Lingotto manifestato sotto Spirito. Il Nucleo risonante apre equipaggiamento più forte e vie lontane.",
		"Come: Codice degli Spiriti + Tessitura tribale. Stazione, totem e costo in Pulso sono sulla pagina del Codice."
	]
	quest.420000000022055C.title: "Il cuore vivo"
	quest.420000000022055D.quest_desc: [
		"Porta 4,800 di Pulso in una Cella maggiore, o 19,200 in una Cella grandiosa. Caricala su un Cuore di tamburo o un Risonatore prima di partire.",
		"Come: una Cella di Pulso, due Nuclei risonanti e due Lingotti manifestati."
	]
	quest.420000000022055D.title: "Un canto più lungo"
	quest.420000000022055E.quest_desc: [
		"Sedici secchi in una cisterna. Secchi e tubi per fluidi funzionano entrambi. Un comparatore legge quanto è piena; la redstone blocca riempimento e svuotamento. Rompila e il fluido resta sul blocco che cade. I serbatoi di pietra celeste si svuotano.",
		"Come: crea, riempi con un secchio o un tubo, raccogli — il fluido resta. I serbatoi di pietra celeste di AE2 si svuotano se li rompi."
	]
	quest.420000000022055E.title: "Pioggia tenuta nel rame"
	quest.420000000022055F.quest_desc: [
		"Segna una faccia della macchina con l'accordatore, poi usalo su una piastra relè. Usalo su un'altra macchina per sostituire il segno. Non segnare la piastra.",
		"Come: una Scheggia spirituale sopra due Risonatori di rame."
	]
	quest.420000000022055F.title: "Nomina l'estremo lontano"
	quest.4200000000220560.quest_desc: [
		"Incastra la piastra sulla faccia di una cassa o di una macchina. Accoppia due piastre con lo stesso oggetto unico di Legame, oppure lega una destinazione con l'accordatore. Il carico locale arriva a 32 blocchi, 16 oggetti al secondo per 8 di Pulso. La redstone lo mette in pausa. Dalla 5.0 la piastra vuole un Totem sveglio di risonanza dell'Aria entro otto blocchi, oppure resta ferma e dice quale voce le manca.",
		"Come: una tramoggia, un Risonatore di rame, due Gessi rituali e un Lingotto manifestato."
	]
	quest.4200000000220560.title: "Una via per le scorte"
	quest.4200000000220561.quest_desc: [
		"Incastra la piastra sulla faccia di un serbatoio. Accoppia due piastre, oppure lega una destinazione con l'accordatore. Il fluido locale arriva a 32 blocchi: 250 mB al secondo per 8 di Pulso. Entrambe le estremità devono essere caricate. Dalla 5.0 la piastra vuole un Totem sveglio di risonanza dell'Aria entro otto blocchi, oppure resta ferma e dice quale voce le manca.",
		"Come: una Cisterna degli spiriti, un Risonatore di rame, due Gessi rituali e un Lingotto manifestato."
	]
	quest.4200000000220561.title: "Una via per la pioggia"
	quest.4200000000220562.quest_desc: [
		"Il Lungoraggio porta oggetti fino a 128 blocchi per 16 di Pulso a ogni battito riuscito. Usa inventari normali di qualunque mod compatibile. Dalla 5.0 la piastra vuole un Totem sveglio di risonanza dell'Aria entro otto blocchi, oppure resta ferma e dice quale voce le manca.",
		"Come: un Relè di oggetti, due Nuclei risonanti e due perle di ender."
	]
	quest.4200000000220562.title: "Attraverso l'officina"
	quest.4200000000220563.quest_desc: [
		"Il Lungoraggio porta fluidi fino a 128 blocchi per 16 di Pulso a ogni battito. I ricevitori pieni si fermano senza rischio; la redstone può bloccare la cisterna ricevente. Dalla 5.0 la piastra vuole un Totem sveglio di risonanza dell'Aria entro otto blocchi, oppure resta ferma e dice quale voce le manca.",
		"Come: un Relè di fluidi, due Nuclei risonanti e due perle di ender."
	]
	quest.4200000000220563.title: "Attraverso le acque"
	quest.4200000000220564.quest_desc: [
		"Fai da ponte tra Tribal Power e gli accettatori di energia di Mekanism, Powah o AE2. Ogni Pulso diventa 100 FE. La conversione senza rango è di 60 di Pulso al secondo (6,000 FE/s); dai rango all'adattatore alle stazioni Eco, e lo stato a mano vuota nomina il ritmo attuale. Non può ancora ricevere FE. La redstone ferma conversione ed esportazione.",
		"Come: cinque lingotti di rame, tre redstone e un Nucleo risonante."
	]
	quest.4200000000220564.title: "Il battito diventa corrente"
	quest.4200000000220565.quest_desc: [
		"Il Bastone sestuplo. Usalo accovacciato per scorrere Terra, Fuoco, Acqua, Aria, Spirito e Telaio. Usalo per lanciare; la voce del Telaio è Laccio, che tira un bersaglio di otto blocchi verso di te, e un lancio accovacciato senza bersaglio è Punto, un balzo di sei blocchi. Porta celle cariche; il Codice degli Spiriti spiega ogni incantesimo e il suo costo.",
		"Come: un Sigillo spirituale, un Nucleo risonante, un Lingotto manifestato e due tronchi."
	]
	quest.4200000000220565.title: "Sei voci in una mano"
	quest.4200000000220566.quest_desc: [
		"Nella mano principale, usa accovacciato una faccia di pietra: un taglio voluto tre per tre a 8 di Pulso per blocco. Valgono ancora la protezione normale alla rottura e i requisiti degli attrezzi.",
		"Come: due Lingotti manifestati, un Nucleo risonante e due Risonatori di rame."
	]
	quest.4200000000220566.title: "La pietra cede un varco"
	quest.4200000000220567.quest_desc: [
		"Il cappuccio presta vista notturna finché celle cariche la sostengono. I pezzi non legati attingono 2 di Pulso ogni quattro secondi; una voce legata costa 3.",
		"Come: cinque Tessuti spirituali, a forma di elmo. Una Lente di ley sopra, più tardi, gli lascia vedere la ley."
	]
	quest.4200000000220567.title: "Occhi nel quieto"
	quest.4200000000220568.quest_desc: [
		"La veste concede resistenza. Indossala nel lavoro e tieni le celle cariche.",
		"Come: sette Tessuti spirituali e un Nucleo risonante."
	]
	quest.4200000000220568.title: "Un riparo tessuto"
	quest.4200000000220569.quest_desc: [
		"I gambali tessuti prestano velocità. Il loro costo in Pulso è separato dagli altri pezzi.",
		"Come: sei Tessuti spirituali e un Nucleo risonante."
	]
	quest.4200000000220569.title: "L'accampamento tiene il passo"
	quest.420000000022056A.quest_desc: [
		"Gli stivali possono prestare caduta lenta durante la discesa finché resta Pulso. Un sentiero di ritorno legato vale ancora portarlo.",
		"Come: quattro Tessuti spirituali, a forma di stivale."
	]
	quest.420000000022056A.title: "Una discesa più dolce"
	quest.420000000022056B.quest_desc: [
		"Siedi un sigillo riutilizzabile accanto al totem corrispondente. Una benedizione di sei blocchi costa 8 di Pulso ogni due secondi. La redstone alta lo mette in pausa; accovacciati a mani vuote per recuperare il sigillo.",
		"Come: due Lingotti manifestati, due lingotti di rame, un Nucleo risonante e tre pietre."
	]
	quest.420000000022056B.title: "Una benedizione che resta"
	quest.420000000022056C.quest_desc: [
		"Usalo accovacciato sulla cima di un pavimento solido per legarlo. Torna entro 128 blocchi, nello stesso mondo, per 20 di Pulso. Alimenta il pavimento d'arrivo per bloccare gli arrivi.",
		"Come: una bussola dentro quattro Lingotti manifestati."
	]
	quest.420000000022056C.title: "Il primo sentiero di ritorno"
	quest.420000000022056D.quest_desc: [
		"Torna per qualsiasi distanza dentro una dimensione per 40 di Pulso. Lascia un atterraggio asciutto con due blocchi liberi sopra.",
		"Come: una Bussola di pietra di via dentro quattro Nuclei risonanti."
	]
	quest.420000000022056D.title: "Oltre l'orizzonte"
	quest.420000000022056E.quest_desc: [
		"Cerca il Cristallo della Marca oltre il Tamburo del cancello. I sentieri astrali per persone, oggetti e fluidi attingono tutti allo stesso materiale di fine partita.",
		"Come: estrai cristallo nelle grotte della Marca, o trovalo nei forzieri della Marca. Prima il Tamburo del cancello."
	]
	quest.420000000022056E.title: "Una voce oltre il velo"
	quest.420000000022056F.quest_desc: [
		"La bussola finale attraversa le dimensioni per 100 di Pulso. Lega un ritorno sicuro prima di esplorare. Il viaggio attende cinque secondi tra un uso e l'altro.",
		"Come: una Bussola dell'orizzonte, due Sigilli spirituali e due Cristalli della Marca."
	]
	quest.420000000022056F.title: "Un sentiero tra i mondi"
	quest.4200000000220570.quest_desc: [
		"Il carico astrale attraversa le dimensioni senza limite di distanza. Ogni battito riuscito costa 32 di Pulso. Il ricevitore deve essere già caricato; niente caricamento nascosto dei chunk. Da 5.0 la piastra vuole un Totem di risonanza (Telaio) sveglio entro otto blocchi, oppure resta ferma e dice quale voce le manca.",
		"Come: un Relè di oggetti a lunga gittata, due Sigilli dello Spirito e due Cristalli della Marca."
	]
	quest.4200000000220570.title: "Le scorte attraversano il velo"
	quest.4200000000220571.quest_desc: [
		"Il fluido astrale segue lo stesso livello dimensionale di giocatori e oggetti. Tieni carico il serbatoio di destinazione. Un serbatoio pieno o un mondo non caricato si mette in pausa senza consumare il carico. Da 5.0 la piastra vuole un Totem di risonanza (Telaio) sveglio entro otto blocchi, oppure resta ferma e dice quale voce le manca.",
		"Come: un Relè di fluidi a lunga gittata, due Sigilli dello Spirito e due Cristalli della Marca."
	]
	quest.4200000000220571.title: "La pioggia attraversa il velo"
	quest.4200000000220572.quest_desc: [
		"Apri dalla strada il tuo Nascondiglio profondo personale da 54 scomparti. È la stessa volta, condivisa fra i tuoi nascondigli e la bisaccia. La sintonia con la Marca toglie il costo per aprirlo.",
		"Come: sei Tessuti spirituali, due Nuclei risonanti e un Nascondiglio profondo."
	]
	quest.4200000000220572.title: "Il campo al tuo seguito"
	quest.4200000000220573.quest_desc: [
		"Il Cancello si apre su un paese vivo. Alcune creature portano ancora il vecchio canto; altre ne custodiscono i pezzi spezzati. Spazzola quelle miti. Affronta i guardiani con celle di Pulso cariche e una via di ritorno.",
		"Come: crealo, oppure prendilo come ricompensa di Scintilla/Tessitura tribale. Clic destro: come funziona il reticolo."
	]
	quest.4200000000220573.title: "Il canto del ritorno"
	quest.4200000000220574.quest_desc: [
		"Un brucatore dell'alba che porta il vecchio canto della foresta nei palchi. Falli riprodurre con il grano; spazzola gli adulti per il Velluto dell'alba.",
		"Cercalo nelle foreste dell'Overworld e nella Marca. Riporta il suo reagente al Legame d'eco, sotto la voce Acqua, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: spazzola un Cervo dell'alba adulto. Falli riprodurre con il grano."
	]
	quest.4200000000220574.title: "Cervo dell'alba: un canto restituito"
	quest.4200000000220575.quest_desc: [
		"Un raccoglitore timido del crepuscolo, la cui coda segna i sentieri sicuri. Falli riprodurre con le bacche dolci; spazzola gli adulti per il Piumino lanterna.",
		"Cercalo nelle foreste dell'Overworld e nella Marca. Riporta il suo reagente al Legame d'eco, sotto la voce Acqua, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: spazzola una Volpe lanterna adulta. Falle riprodurre con le bacche dolci."
	]
	quest.4200000000220575.title: "Volpe lanterna: un canto restituito"
	quest.4200000000220576.quest_desc: [
		"Un giardiniere paziente delle zone umide, con un guscio vivo. Falli riprodurre con l'erba marina; spazzola gli adulti per una Scaglia di Dorsomuschio persa da sola.",
		"Cercalo nelle paludi dell'Overworld e nella Marca. Riporta il suo reagente al Legame d'eco, sotto la voce Acqua, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: spazzola un Dorsomuschio adulto. Falli riprodurre con l'erba marina."
	]
	quest.4200000000220576.title: "Dorsomuschio: un canto restituito"
	quest.4200000000220577.quest_desc: [
		"I resti di un rito del fuoco spezzato. I suoi colpi in mischia incendiano per un attimo; tieni l'acqua vicina.",
		"Cercalo nelle foreste dell'Overworld e nella Marca. Riporta il suo reagente alla Sintonia d'eco, sotto la voce Spirito, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dal Cenerilegato. Gli spiriti ostili hanno bisogno di buio."
	]
	quest.4200000000220577.title: "Cenerilegato: un canto restituito"
	quest.4200000000220578.quest_desc: [
		"Un guardiano del boschetto, storto da una linea di ley recisa. Lento, ma saldo; i colpi radicano i viandanti per un attimo.",
		"Cercalo nelle foreste dell'Overworld e nella Marca. Riporta il suo reagente alla Sintonia d'eco, sotto la voce Spirito, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dal Radicelegato. Gli spiriti ostili hanno bisogno di buio."
	]
	quest.4200000000220578.title: "Radicelegato: un canto restituito"
	quest.4200000000220579.quest_desc: [
		"Un cacciatore di palude, nascosto fra le canne dello spirito. I colpi rapidi portano un veleno breve.",
		"Cercalo nelle paludi dell'Overworld e nella Marca. Riporta il suo reagente alla Sintonia d'eco, sotto la voce Spirito, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dall'Inseguitore dei canneti. Gli spiriti ostili hanno bisogno di buio."
	]
	quest.4200000000220579.title: "Inseguitore dei canneti: un canto restituito"
	quest.420000000022057A.quest_desc: [
		"Un saprofago dei campi di cristallo, corazzato di pietra che canta. Tieniti lontano dalla sua spinta pesante.",
		"Cercalo nella Marca. Riporta il suo reagente alla Sintonia d'eco, sotto la voce Spirito, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dal Dorsoscheggia. Gli spiriti ostili hanno bisogno di buio."
	]
	quest.420000000022057A.title: "Dorsoscheggia: un canto restituito"
	quest.420000000022057B.quest_desc: [
		"Una sentinella vuota che ancora custodisce le strade antiche. Il suo tocco indebolisce la presa di chi attacca.",
		"Cercalo nella Marca. Riporta il suo reagente alla Sintonia d'eco, sotto la voce Spirito, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dalla Sentinella cava. Gli spiriti ostili hanno bisogno di buio."
	]
	quest.420000000022057B.title: "Sentinella cava: un canto restituito"
	quest.420000000022057C.quest_desc: [
		"Uno spirito nutrito dalla tempesta, con vaste ali di velo. Un raduno luminoso di granelli avvisa della raffica; un riparo spezza l'attacco.",
		"Cercala nella Marca. Riporta il suo reagente al Legame d'eco, sotto la voce Acqua, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dalla Falena della tempesta. Gli spiriti ostili hanno bisogno di buio."
	]
	quest.420000000022057C.title: "Falena della tempesta: un canto restituito"
	quest.420000000022057D.quest_desc: [
		"Uno spirito agile di brace. Raccoglie scintille prima di un dardo ardente; l'incantesimo non incendia mai il terreno.",
		"Cercalo nella Marca. Riporta il suo reagente alla Sintonia d'eco, sotto la voce Spirito, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dal Folletto di brace. Gli spiriti ostili hanno bisogno di buio."
	]
	quest.420000000022057D.title: "Folletto di brace: un canto restituito"
	quest.420000000022057E.quest_desc: [
		"Una reliquia fluttuante che ricorda le tribù perdute. Il suo rintocco preannunciato rallenta; un riparo interrompe il canto.",
		"Cercalo nella Marca. Riporta il suo reagente alla Sintonia d'eco, sotto la voce Spirito, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dalla Campana del lutto. Gli spiriti ostili hanno bisogno di oscurità."
	]
	quest.420000000022057E.title: "Campana del lutto: un canto restituito"
	quest.420000000022057F.quest_desc: [
		"Un cacciatore attirato dagli strappi nel reticolo. Chiude in fretta la distanza, ma non può attraversare i mondi da solo.",
		"Cercalo nella Marca. Riporta il suo reagente alla Sintonia d'eco, sotto la voce Spirito, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dal Segugio della fenditura. Gli spiriti ostili hanno bisogno di oscurità."
	]
	quest.420000000022057F.title: "Segugio della fenditura: un canto restituito"
	quest.4200000000220580.quest_desc: [
		"Un guardiano a otto zampe dei canti spezzati. Il morso rallenta la preda senza posare ragnatele né danneggiare l'accampamento.",
		"Cercala nella Marca. Riporta il suo reagente al Legame d'eco, sotto la voce Acqua, per un materiale utile. Costruisci sentieri illuminati; gli spiriti ostili richiedono il buio.",
		"Come: cade dal Tessitore d'eco. Gli spiriti ostili hanno bisogno di oscurità."
	]
	quest.4200000000220580.title: "Tessitore d'eco: un canto restituito"
	quest.4200000000220581.quest_desc: [
		"Le note di campo sono complete. I raccolti miti e le reliquie recuperate sono tornati tessuto ed Echi. Sotto il velo della notte, l'accampamento risponde con un canto più pieno.",
		"Ricompensa rara: una vita condivisa del Clowder, una volta sola per tutta la squadra. Nella campagna ne esistono solo sei.",
		"Come: Codice degli Spiriti + Tessitura tribale. Stazione, totem e costo in Pulso sono sulla pagina del Codice."
	]
	quest.4200000000220581.title: "Tredici voci, un cielo"
	quest.4200000000220582.quest_desc: [
		"Appendi il canto dell'accampamento nel rame. Una Lanterna spirituale dà piena luce senza combustibile; la redstone l'attenua. Segna sentieri sicuri per tornare dal buio.",
		"Come: tre lingotti di rame, una Scheggia spirituale e un'asse."
	]
	quest.4200000000220582.title: "Una luce per chi torna"
	quest.4200000000220583.quest_desc: [
		"Il campanello è insieme ornamento e strumento. Il suo comparatore dà 0 a cielo sereno, 8 con la pioggia e 15 con il temporale. La redstone lo zittisce.",
		"Come: tre assi, tre lingotti di rame e un Campanello d'osso."
	]
	quest.4200000000220583.title: "Ascolta il tempo"
	quest.4200000000220584.quest_desc: [
		"Un tavolo intagliato tiene 27 pile. I tubi per oggetti e i relè comuni possono condividere le offerte; i comparatori leggono quanto è pieno e la redstone ne chiude l'accesso.",
		"Come: un baule, un Eco vincolato, due assi e due pietre."
	]
	quest.4200000000220584.title: "Un posto al focolare"
	quest.4200000000220585.quest_desc: [
		"Piazza il Custode del boschetto all'altezza della coltura, in un letto di 9 per 9. Metti i semi nella prima riga; i raccolti riempiono le due righe in basso. Piantare costa 4 di Pulso, raccogliere e ripiantare costa 12. Fornisci energia entro otto blocchi. Un'uscita piena preserva la coltura; la redstone mette in pausa il lavoro. Dalla 5.0 vuole un Totem di risonanza di Terra sveglio entro otto blocchi, oppure resta fermo e dice quale voce gli manca. Tieni anche un totem d'Acqua vicino, e innaffia ogni solco del letto.",
		"Come: una zappa di ferro, un Sigillo di Terra, un Eco legato, due lingotti di rame e due assi."
	]
	quest.4200000000220585.title: "Il giardino continua a cantare"
	quest.4200000000220586.quest_desc: [
		"Otto di Pulso al secondo impediscono la comparsa di ostili entro 24 blocchi. Le creature già presenti restano. La guardia impedisce anche le invocazioni ostili della Culla, quindi tieni il terreno di invocazione al di fuori. La redstone zittisce subito la guardia. Dalla 5.0 vuole un Totem di risonanza di Spirito sveglio entro otto blocchi, oppure resta fermo e dice quale voce gli manca.",
		"Come: un Sigillo di Spirito, due Echi legati, una Scheggia d'eco e tre Assi della Marca."
	]
	quest.4200000000220586.title: "Quiete al bordo del campo"
	quest.4200000000220587.quest_desc: [
		"L'Ancora della via tiene sveglio il proprio chunk per 16 di Pulso ogni secondo. Mettine una su un ricevitore di relè lontano e sostieni l'alimentazione locale. Al massimo 32 ancore possono funzionare in una dimensione. La redstone o un buffer vuoto rilascia il chunk. Dalla 5.0 l'ancora vuole un Totem di risonanza di Terra sveglio entro otto blocchi, oppure resta ferma e dice quale voce le manca.",
		"Come: due Cristalli della Marca, un Occhio di ender, due Lingotti manifestati, un Nucleo risonante e tre Pietre della Marca."
	]
	quest.4200000000220587.title: "Un campo che ricorda"
	quest.4200000000220588.quest_desc: [
		"Usa accovacciato un'effigie scarica su una creatura supportata, per prendere un'impronta innocua. L'effigie ricorda la specie. I boss non si possono legare; il Codice spiega gli spiriti compatibili e il rinnovo.",
		"Come: un Campanello d'osso, due Tessuti spirituali, un Nucleo risonante e un Eco legato."
	]
	quest.4200000000220588.title: "Prendi in prestito una voce viva"
	quest.4200000000220589.quest_desc: [
		"Siedi un'effigie risvegliata nel primo slot e Tessuto spirituale nel secondo. Ogni evocazione riuscita spende 80 di Pulso, un Tessuto spirituale e un filo di legame. Lascia un pavimento sicuro entro tre blocchi. Otto creature vicine mettono in pausa la Culla di invocazione; la redstone mette in pausa tutto il lavoro e l'automazione. Dalla 5.0 vuole un Totem di risonanza dello Spirito tenuto entro otto blocchi, altrimenti resta ferma e dice quale voce manca.",
		"Come: due Lingotti manifestati, un Cristallo della Marca, due Echi legati, un Nucleo risonante e tre Assi della Marca."
	]
	quest.4200000000220589.title: "Un focolare per vita in prestito"
	quest.420000000022058A.quest_desc: [
		"Metti un Sigillo dello Spirito in un Braciere rituale. Porta totem di Terra, d'Aria e di Spirito entro otto blocchi, 200 di Pulso vicino e tre Tessuti spirituali nel tuo inventario. Usa l'effigie impressa sul braciere per risvegliare 512 fili di invocazione. Quando sono tutti spesi, ripeti questo rito per rinnovare il legame.",
		"Come: Sigillo dello Spirito in un Braciere rituale; totem di Terra, Aria e Spirito entro 8; 200 di Pulso; tre Tessuti spirituali; usa l'effigie impressa."
	]
	quest.420000000022058A.title: "Tre voci risvegliano il filo"
	quest.420000000022058B.quest_desc: [
		"Completa un'evocazione riuscita. I tentativi falliti o bloccati non consumano fili né offerte. Ogni legame dura 512 evocazioni riuscite; rompere e riposizionare la Culla di invocazione non rinnova mai il legame. Il tooltip dell'effigie mostra gli usi rimasti, e un comparatore legge la forza di legame rimasta alla culla.",
		"Come: completa un'evocazione riuscita dalla Culla di invocazione. I tentativi falliti non spendono nulla."
	]
	quest.420000000022058B.title: "Una risposta dalla culla"
	quest.4200000000228001.quest_desc: [
		"Oltre il Tamburo del cancello, la steppa e gli altipiani della Marca nascondono Sale degli antenati sprofondate. Entrarci a piedi spunta questo. Quattro Tavolette del sapere fiancheggiano ogni sala; leggile tutte. I forzieri tengono Filo del telaio, Echi, Tessuto spirituale e sigilli. Le Sentinelle cave sono ancora di guardia.",
		"Come: Tamburo del cancello verso la Marca ed entra a piedi in una Sala degli antenati; poi leggi le sue quattro Tavolette del sapere."
	]
	quest.4200000000228001.title: "Le sale che tennero il tempo"
	quest.4200000000228002.quest_desc: [
		"Il Filo del telaio è il Telaio, in mano: i forzieri delle Sale degli antenati ne tengono da due a quattro, il Non cantato ne strappa sedici o più, e un Anziano dei Cucitori del telaio ne scambia uno al grado Amico. È il reagente della sesta voce.",
		"Come: forzieri delle Sale degli antenati, il Non cantato, o un Anziano dei Cucitori del telaio ad Amico."
	]
	quest.4200000000228002.title: "Un Filo del filo stesso"
	quest.4200000000228003.quest_desc: [
		"Otto Pietre della Marca intorno a una Scheggia d'eco fanno due Tavolette del sapere. Posata, una tavoletta mostra un frammento delle nove tribù; un uso accovacciato in creativa scorre quale. Fodera la tua sala con esse.",
		"Come: otto Pietre della Marca intorno a una Scheggia d'eco. Ne fa due."
	]
	quest.4200000000228003.title: "Intaglia ciò che leggi"
	quest.4200000000228004.quest_desc: [
		"Cuoio sopra Assi della Marca, intorno a un Nucleo risonante. Il Cerchio dei tamburi, sugli altipiani della Marca, ne tiene già uno; questo è tuo, da sistemare a casa. Colpiscilo quattro volte, un respiro tra l'uno e l'altro, e qualcosa di antico si leva.",
		"Come: tre cuoi, cinque Assi della Marca e un Nucleo risonante."
	]
	quest.4200000000228004.title: "Un tamburo che non suonerà"
	quest.4200000000228005.quest_desc: [
		"Il Non cantato è uno spirito di tamburo in tre fasi. Battito: puntellati accovacciandoti contro la sua onda d'urto. Coro: abbatti i Tessitori d'eco che chiama. Silenzio: non può essere ferito finché non colpisci il Tamburo silenzioso con lo stesso ritmo di quattro battiti, che lo stordisce e raddoppia i tuoi danni. Porta celle di Pulso cariche e una via di ritorno.",
		"Come: combatti il Non cantato al Tamburo silenzioso. Accovacciati nel Battito; quattro battiti nel Silenzio."
	]
	quest.4200000000228005.title: "Il tamburo ricorda"
	quest.4200000000228006.quest_desc: [
		"Un Cuore del Non cantato per uccisione, insieme a Filo del telaio e Nuclei risonanti. Fabbrica il totem del Telaio e nient'altro, quindi spendilo con cura.",
		"Come: il Non cantato al Tamburo silenzioso ne lascia uno per uccisione."
	]
	quest.4200000000228006.title: "Il tamburo acquietato"
	quest.4200000000228007.quest_desc: [
		"Un Cuore del Non cantato tra Filo del telaio e Cristallo della Marca, su Assi della Marca. Il Telaio si unisce a Terra, Fuoco, Acqua, Aria e Spirito: una voce distinta per il Risonatore di Pulso e la sintonia che chiedono la Distessitura d'eco e il Legame di ley.",
		"Come: un Cuore del Non cantato, quattro Cristalli della Marca, due Filo del telaio e due Assi della Marca."
	]
	quest.4200000000228007.title: "La sesta voce"
	quest.4200000000228008.quest_desc: [
		"Un Sigillo in bianco e Filo del telaio. Seduto in un Braciere rituale, il Sigillo del telaio benedice la tensione: ogni due secondi ricarica due di Pulso nelle celle portate da chiunque sia a portata, e presta Fortuna.",
		"Come: un Sigillo in bianco e Filo del telaio, senza forma."
	]
	quest.4200000000228008.title: "Un sigillo di tensione"
	quest.4200000000228009.quest_desc: [
		"Filo del telaio e Risonatori di rame su Pietra della Marca. Sotto una voce del Telaio, la Distessitura d'eco fa correre il reticolo all'indietro: un Lingotto manifestato in due Echi legati, il Legato in due Sintonizzati, il Sintonizzato in due Schegge, Tessuto spirituale in due lane, un Nucleo risonante in tre Lingotti manifestati, e qualunque attrezzo usurato di equipaggiamento spirituale in un Lingotto manifestato.",
		"Come: cinque Pietre della Marca, Filo del telaio, due Risonatori di rame e una Scheggia spirituale."
	]
	quest.4200000000228009.title: "Il reticolo, al contrario"
	quest.420000000022800A.quest_desc: [
		"Gira il Bastone sestuplo fino alla sua voce del Telaio. Ormeggio tira un bersaglio di otto blocchi verso di te per sei di Pulso; un lancio in furtività senza bersaglio è Punto, un balzo di sei blocchi nell'aria per dieci. Spunta questo quando hai usato entrambi.",
		"Come: Bastone sestuplo sulla voce del Telaio. Ormeggia un bersaglio, poi Punto in furtività. Spunta quando entrambi sono partiti."
	]
	quest.420000000022800A.title: "Ormeggio e Punto"
	quest.420000000022800B.quest_desc: [
		"Nove accampamenti di tribù stanno nella Marca, uno per Filo: capanne, un fuoco, un Focolare della tribù, un totem, uno stendardo e quattro Parenti della tribù. Fai clic destro su un focolare con ciò che quella tribù predilige, o con una Cella di Pulso carica, e la tua reputazione con loro sale. Ferire un Parente costa 25. Rompere lo stendardo di una tribù costa 5, il focolare 40. I blocchi generici dell'accampamento non costano.",
		"Come: clic destro su un Focolare di tribù della Marca con ciò che quella tribù predilige, o con una Cella di Pulso carica."
	]
	quest.420000000022800B.title: "Tenuto al caldo"
	quest.420000000022800C.quest_desc: [
		"Ospite a 50, Amico a 150, Parente a 400, Vòce a 800. Le uccisioni vicino a un focolare e gli scambi conclusi contano anch'essi. Gli Anziani scambiano due offerte per grado: i Cantori di ghiaia vendono Echi per minerale grezzo, gli Intagliatori di sigilli vendono sigilli e tavolette di rito, i Cucitori del telaio vendono Filo del telaio e una Bussola di pietra di via, e al grado Parente un'Ancora del telaio e un Sigillo del telaio. `/tribalpower standing` stampa tutte e nove.",
		"Come: raggiungi Amico (150) con una tribù. /tribalpower standing."
	]
	quest.420000000022800C.title: "In buoni rapporti"
	quest.420000000022800D.quest_desc: [
		"Al grado Voce, un Anziano ti preme un Marchio della tribù nella mano, una volta sola. Apre la pagina del Codice di quella tribù ed è l'unico ingrediente di cui un Totem di parentela non può fare a meno.",
		"Come: Voce (800) con una tribù; l'Anziano dà un Marchio della tribù una volta."
	]
	quest.420000000022800D.title: "Nove d'accordo"
	quest.420000000022800E.quest_desc: [
		"Tieni un Marchio della tribù. Quello di ogni tribù è diverso; nove sono possibili.",
		"Come: raggiungi Voce (800) con una tribù; il suo Anziano dà il Marchio una volta."
	]
	quest.420000000022800E.title: "Marchio della tribù"
	quest.420000000022800F.quest_desc: [
		"Un Marchio della tribù, il Totem di risonanza della sintonia di quella tribù e due Tessuti spirituali. Un Totem di parentela conta come un'ulteriore voce distinta per il Risonatore di Pulso e presta la sintonia della sua tribù alle stazioni, così nove tribù possono portare il canto dell'accampamento a quindici voci.",
		"Come: un Marchio della tribù, il Totem di risonanza di quella tribù e due Tessuti spirituali nella griglia."
	]
	quest.420000000022800F.title: "Una voce che non è una voce"
	quest.4200000000228010.quest_desc: [
		"Il Tamburino di un accampamento suona ogni pochi secondi; piazza un Cuore di tamburo entro otto blocchi da uno e ogni battito gli dà due di Pulso. Spunta questo quando un Tamburino sta alimentando il tuo reticolo.",
		"Come: piazza un Cuore di tamburo entro 8 da un Tamburino dell'accampamento; spunta quando sta dando Pulso."
	]
	quest.4200000000228010.title: "L'accampamento tiene il tempo"
	quest.4200000000228011.quest_desc: [
		"Due pietre e il reagente intorno al sigillo; il sigillo ti viene restituito. Radice annodata accanto a un Sigillo di Terra; 600 di Pulso. Per venti minuti colture, arboscelli e steli crescono più in fretta nei nove chunk intorno al braciere. Usa la tavoletta accovacciato su un Braciere rituale con quel sigillo incastonato, dentro il suo Cerchio del rito (quattro piedistalli sulle diagonali, il gesso li unisce); il Pulso è preso dal reticolo entro otto blocchi.",
		"Come: due pietre, una Radice annodata e un Sigillo di Terra, senza forma; il sigillo torna."
	]
	quest.4200000000228011.title: "Tavoletta del rito: Benedizione verde"
	quest.4200000000228012.quest_desc: [
		"Due pietre e il reagente intorno al sigillo; il sigillo ti viene restituito. Zanna di canna accanto a un Sigillo d'Acqua; 400 di Pulso. Venti minuti di pioggia, per le cisterne e le colture. Usa la tavoletta accovacciato su un Braciere rituale con quel sigillo incastonato, dentro il suo Cerchio del rito (quattro piedistalli sulle diagonali, il gesso li unisce); il Pulso è preso dal reticolo entro otto blocchi.",
		"Come: due pietre, una Zanna di canna e un Sigillo d'Acqua, senza forma; il sigillo torna."
	]
	quest.4200000000228012.title: "Tavoletta del rito: Chiamata della pioggia"
	quest.4200000000228013.quest_desc: [
		"Due pietre e il reagente intorno al sigillo; il sigillo ti viene restituito. Ala di tempesta accanto a un Sigillo d'aria; 400 di Pulso. Quaranta minuti di cielo sereno. Usa accovacciato la tavoletta su un Braciere rituale con quel sigillo incastonato, dentro il suo Cerchio del rito (quattro piedistalli sulle diagonali, il gesso li unisce); il Pulso è tratto dal reticolo entro otto blocchi.",
		"Come: due pietre, un'Ala di tempesta e un Sigillo d'aria, senza forma; il sigillo torna."
	]
	quest.4200000000228013.title: "Tavoletta del rito: Rischiaramento del cielo"
	quest.4200000000228014.quest_desc: [
		"Due pietre e il reagente intorno al sigillo; il sigillo ti viene restituito. Cuore di brace accanto a un Sigillo di fuoco; 800 di Pulso. Affretta la notte fino all'alba seguente, per tutto il mondo. Usa accovacciato la tavoletta su un Braciere rituale con quel sigillo incastonato, dentro il suo Cerchio del rito (quattro piedistalli sulle diagonali, il gesso li unisce); il Pulso è tratto dal reticolo entro otto blocchi.",
		"Come: due pietre, un Cuore di brace e un Sigillo di fuoco, senza forma; il sigillo torna."
	]
	quest.4200000000228014.title: "Tavoletta del rito: Chiamata dell'alba"
	quest.4200000000228015.quest_desc: [
		"Due pietre e il reagente intorno al sigillo; il sigillo ti viene restituito. Sigillo sentinella accanto a un Sigillo spirituale; 600 di Pulso. Quindici minuti senza comparse ostili entro sessantaquattro blocchi. Usa accovacciato la tavoletta su un Braciere rituale con quel sigillo incastonato, dentro il suo Cerchio del rito (quattro piedistalli sulle diagonali, il gesso li unisce); il Pulso è tratto dal reticolo entro otto blocchi.",
		"Come: due pietre, un Sigillo sentinella e un Sigillo spirituale, senza forma; il sigillo torna."
	]
	quest.4200000000228015.title: "Tavoletta del rito: Notte quieta"
	quest.4200000000228016.quest_desc: [
		"Due pietre e il reagente intorno al sigillo; il sigillo ti viene restituito. Filo del telaio accanto a un Sigillo del telaio; 1.200 di Pulso. Unisce il totem più vicino a un altro entro sessantaquattro blocchi con una linea di ley di trenta minuti che instrada il Pulso tra loro. Usa accovacciato la tavoletta su un Braciere rituale con quel sigillo incastonato, dentro il suo Cerchio del rito (quattro piedistalli sulle diagonali, il gesso li unisce); il Pulso è tratto dal reticolo entro otto blocchi.",
		"Come: due pietre, Filo del telaio e un Sigillo del telaio, senza forma; il sigillo torna."
	]
	quest.4200000000228016.title: "Tavoletta del rito: Vincolo ley"
	quest.4200000000228017.quest_desc: [
		"Compi un rito qualsiasi. Se il reticolo intorno al braciere tiene troppo poco Pulso, non si consuma nulla e il braciere lo dice.",
		"Come: usa accovacciato una qualsiasi Tavoletta del rito su un Braciere rituale nel suo Cerchio del rito, con sigillo e Pulso corrispondenti."
	]
	quest.4200000000228017.title: "Primo rito"
	quest.4200000000228018.quest_desc: [
		"Due Tessuti spirituali, una Scheggia spirituale e il reagente della specie. Usalo su un famiglio adulto. Animali: sessanta per cento, l'amuleto resta se fallisce. I resti vogliono Voce con la loro tribù, quaranta per cento, l'amuleto si spende se fallisce.",
		"Come: due Tessuti spirituali, una Scheggia spirituale e un reagente da famiglio (Velluto dell'alba, Piumino di lanterna, Ala di tempesta e simili)."
	]
	quest.4200000000228018.title: "Un amuleto per una creatura selvatica"
	quest.4200000000228019.quest_desc: [
		"Un famiglio legato ti segue, si teletrasporta dietro di te, non sparisce mai, non puoi ferirlo e rende il doppio se lo spazzoli. La Volpe lanterna, il Dorsomuschio e il Cervo dell'alba ti fanno partire. I resti hanno bisogno di Voce. Possono seguire un combattente e due aiutanti; chi siede non conta.",
		"Come: usa un Amuleto di legame su un famiglio adulto. Il progresso scatta al primo legame."
	]
	quest.4200000000228019.title: "Un amico nel buio"
	quest.420000000022801A.quest_desc: [
		"Carta, Tessuto spirituale e una Scheggia spirituale. Usa la Carta su un giocatore per invitarlo nel tuo accampamento, o in aria per vederlo. `/tribalpower camp` crea, invita, entra, esce, caccia e rinomina.",
		"Come: carta, Tessuto spirituale e una Scheggia spirituale, senza forma."
	]
	quest.420000000022801A.title: "Un accampamento di molte voci"
	quest.420000000022801B.quest_desc: [
		"I membri dell'accampamento condividono una volta d'accampamento da cinquantaquattro scomparti dietro ogni Nascondiglio profondo e ogni Bisaccia del viandante, contano come proprietari dei dispositivi gli uni degli altri, mettono in comune dodici Ancore della via e rispecchiano sull'accampamento un quarto della loro stima di tribù. Un Clowder non è quell'accampamento — /tribalpower camp create <name> lo è.",
		"Come: /tribalpower camp create <name> (non un Clowder). Il progresso scatta al primo accampamento."
	]
	quest.420000000022801B.title: "Una volta, un bilancio"
	quest.420000000022801C.quest_desc: [
		"Un pannello di vetro sopra un Risonatore di rame e una Scheggia spirituale. In mano, la lente mostra la forza della ley dove stai e la dipinge a terra intorno a te; usala accovacciato su un Collettore di ley, o su un famiglio, per i suoi numeri.",
		"Come: un pannello di vetro, un Risonatore di rame e una Scheggia spirituale, in colonna."
	]
	quest.420000000022801C.title: "Vedere la ley"
	quest.420000000022801D.quest_desc: [
		"Quarzo sopra la redstone e un Risonatore di rame, su Pietra della Marca. Rivolto a qualsiasi contenitore di Pulso, emette redstone da 0 a 15 in proporzione a ciò che è contenuto.",
		"Come: quarzo, due redstone, un Risonatore di rame e Pietra della Marca."
	]
	quest.420000000022801D.title: "Un ago per il Pulso"
	quest.420000000022801E.quest_desc: [
		"Una torcia di redstone sopra la redstone e un Risonatore di rame, su Pietra della Marca. Emette quando il contenitore rivolto è alla sua soglia o sopra; il clic destro scorre 25, 50, 75 e 100 per cento. I pezzi di un'automazione mossa dal Pulso.",
		"Come: una torcia di redstone, due redstone, un Risonatore di rame e Pietra della Marca."
	]
	quest.420000000022801E.title: "Una linea nel canto"
	quest.420000000022801F.quest_desc: [
		"Usa accovacciato il Codice degli Spiriti su un qualsiasi blocco tribale per un resoconto semplice: il Pulso immagazzinato, i generatori che lo alimentano, le sintonie entro otto blocchi, ciò che manca alla ricetta attuale, un'uscita piena, una pausa di redstone, un'estremità di relè non caricata. Spunta questo quando ti ha detto qualcosa che non sapevi.",
		"Come: usa accovacciato il Codice degli Spiriti su un blocco tribale; spunta quando il resoconto nomina un guasto vero."
	]
	quest.420000000022801F.title: "Chiedi al Codice perché"
	quest.4200000000228020.quest_desc: [
		"Chiedi ciottoli a una Fonte di Pietra. La Pietra non si fa; alla pietra si chiede di restare. I ciottoli vogliono solo la forma e Pulso; un Totem di Terra entro otto blocchi le lascia chiedere pietra.",
		"Come: cinque ciottoli, una Scheggia d'eco e un Cuore di tamburo."
	]
	quest.4200000000228020.title: "Una fonte di pietra"
	quest.4200000000228021.quest_desc: [
		"Completa un motivo qualsiasi. Il piazzamento è il rituale: dispositivi sparsi non sono un rito.",
		"Come: piazza un motivo di rito dal Codice degli Spiriti; il progresso scatta al primo cerchio completo."
	]
	quest.4200000000228021.title: "Traccia il cerchio"
	quest.4200000000228022.quest_desc: [
		"Chiedi a una Fonte di Pietra il suo primo ciottolo. La Pietra non si fa; alla pietra si chiede di restare.",
		"Come: fai andare la Fonte di Pietra finché non appare il ciottolo. Progresso alla prima volta che resta."
	]
	quest.4200000000228022.title: "La Pietra resta"
	quest.4200000000228023.quest_desc: [
		"Usa accovacciato il Codice degli Spiriti sulla fonte quando sta lavorando. Spunta questo quando il resoconto nomina Pulso immagazzinato o un totem mancante.",
		"Come: usa accovacciato il Codice degli Spiriti sulla Fonte di Pietra; spunta quando il resoconto nomina un guasto vero o un tampone pieno."
	]
	quest.4200000000228023.title: "La fonte risponde"
	quest.4200000000228024.quest_desc: [
		"Tieni una cella carica alla fonte, perché la richiesta non si fermi.",
		"Come: riempi una Cella di Pulso a un Cuore di tamburo, poi spunta questo quando la fonte è alimentata."
	]
	quest.4200000000228024.title: "Una cella alla fonte"
	quest.4200000000228025.quest_desc: [
		"La maglia non trova il minerale; la maglia dà al minerale un posto dove posarsi. Siedila sopra una Fossa d'ascolto.",
		"Come: quattro Pietre della Marca, due Echi sintonizzati, due Tessuti spirituali e un Risonatore di rame."
	]
	quest.4200000000228025.title: "Una maglia che ascolta"
	quest.4200000000228026.quest_desc: [
		"Quattro Pietre d'ancora tengono gli angoli della fossa. Senza di esse la maglia non ha dove stare.",
		"Come: quattro Pietre della Marca sopra una Scheggia d'eco. Ne fa quattro."
	]
	quest.4200000000228026.title: "Quattro ancore"
	quest.4200000000228027.quest_desc: [
		"Chiama il primo minerale su attraverso una Fossa d'ascolto.",
		"Come: Maglia di risonanza sopra una fossa con Pietre d'ancora; il progresso scatta al primo minerale."
	]
	quest.4200000000228027.title: "Chiedi al suolo"
	quest.4200000000228028.quest_desc: [
		"La graniglia d'oro dalla fossa è la voce successiva dopo il ferro.",
		"Come: continua a chiedere al suolo; spunta quando hai la graniglia d'oro in mano."
	]
	quest.4200000000228028.title: "Oro dalla fossa"
	quest.4200000000228029.quest_desc: [
		"La fossa spende Pulso. Tieni una cella sulla maglia, perché la richiesta non si fermi.",
		"Come: riempi una Cella di Pulso a un Cuore di tamburo e siedila dove mostra il Codice."
	]
	quest.4200000000228029.title: "La fossa tiene il tempo"
	quest.420000000022802A.quest_desc: [
		"Undici Cornici di cancello e la chiave di volta cingono la via. Una cornice mancante è un passo mancante.",
		"Come: sei Pietre della Marca, due lingotti di rame e una Scheggia d'eco. Ne fa quattro."
	]
	quest.420000000022802A.title: "Una cornice per la via"
	quest.420000000022802B.quest_desc: [
		"La chiave di volta è la dodicesima pietra. Senza di essa l'anello è solo un motivo.",
		"Come: quattro Cornici di cancello, un Nucleo risonante, una Scheggia spirituale e una Cella di Pulso."
	]
	quest.420000000022802B.title: "La chiave di volta"
	quest.420000000022802C.quest_desc: [
		"Accendi un Cancello della via. Undici cornici, una chiave di volta e un posto dove essere.",
		"Come: finisci l'anello e accendilo; il progresso scatta quando la via si apre."
	]
	quest.420000000022802C.title: "Apri la via"
	quest.420000000022802D.quest_desc: [
		"Usa accovacciato il sigillo su una chiave di volta per scriverla. Usalo su una seconda chiave di volta per legare le due.",
		"Come: un Sigillo in bianco, Filo del telaio e una Scheggia spirituale, senza forma."
	]
	quest.420000000022802D.title: "Scrivi la destinazione"
	quest.420000000022802E.quest_desc: [
		"Viaggia per un Cancello lontano da una dimensione a un'altra. Il Telaio non è mai stato un solo filo.",
		"Come: lega due chiavi di volta con un Sigillo di cancello, poi cammina il cancello lontano."
	]
	quest.420000000022802E.title: "Il filo lungo"
	quest.420000000022802F.quest_desc: [
		"Il generatore del fuoco. Siedilo vicino al suo totem; un Cuore di tamburo in mano non regge questa voce.",
		"Come: tre lingotti di rame, un Nodo di brace, un Sigillo di fuoco e due Assi della Marca."
	]
	quest.420000000022802F.title: "La voce del fuoco"
	quest.4200000000228030.quest_desc: [
		"Il generatore del vento. Siedilo vicino al suo totem perché i sei possano sentirsi.",
		"Come: quattro Tessuti spirituali, un'Ala di tempesta, un Sigillo d'aria e due Assi della Marca."
	]
	quest.4200000000228030.title: "La voce del vento"
	quest.4200000000228031.quest_desc: [
		"Il generatore dell'acqua. Siedilo vicino al suo totem; cisterne e sorgenti ascoltano questa voce.",
		"Come: due cuoi, tre Assi della Marca, una Radice annodata e un Sigillo d'Acqua."
	]
	quest.4200000000228031.title: "La voce dell'acqua"
	quest.4200000000228032.quest_desc: [
		"La campana del risveglio è il tono lungo dello spirito. Siedila vicino al suo totem, con le altre cinque.",
		"Come: un Frammento di campana, quattro lingotti di rame, un Sigillo di Spirito e una Scheggia spirituale."
	]
	quest.4200000000228032.title: "Il risveglio della terra"
	quest.4200000000228033.quest_desc: [
		"Il sesto generatore. La voce del Telaio ha bisogno di Filo del telaio; il Non cantato e gli Anziani dei Cucitori del telaio lo tengono.",
		"Come: quattro Cristalli della Marca, due Fili del telaio, due Tessuti spirituali e un Nucleo risonante."
	]
	quest.4200000000228033.title: "Il sesto generatore"
	quest.4200000000228034.quest_desc: [
		"Un cippo tiene il Pulso nel campo, così sei voci possono condividere una riserva.",
		"Come: sei Pietre della Marca, due Echi legati e una Cella di Pulso."
	]
	quest.4200000000228034.title: "Un cippo di Pulso"
	quest.4200000000228035.quest_desc: [
		"Tieni tutti e sei i generatori in produzione entro 32 blocchi l'uno dall'altro, uno per voce.",
		"Come: Corno di brace, Arpa del vento, Tamburo delle onde, Campana del risveglio, Ancora del telaio e Cuore di tamburo entro 32. Progresso con sei voci."
	]
	quest.4200000000228035.title: "Sei voci che cantano"
	quest.4200000000228036.quest_desc: [
		"Chiede a una cisterna di continuare a dare. Dieci minuti d'acqua, e il sigillo resta.",
		"Come: usa accovacciato la tavoletta su un Braciere rituale nel suo Cerchio del rito, con sigillo e Pulso corrispondenti."
	]
	quest.4200000000228036.title: "Una sorgente che continua a dare"
	quest.4200000000228037.quest_desc: [
		"Il cerchio dei tamburi che il Non cantato ricorda ancora. Ricordo facoltativo.",
		"Come: il Non cantato al Tamburo silenzioso può lasciarlo cadere. Facoltativo."
	]
	quest.4200000000228037.title: "Il cerchio dei tamburi"
	quest.4200000000228038.quest_desc: [
		"Un sigillo in bianco dopo il primo rito, pronto per il cerchio successivo.",
		"Come: Primo rito al braciere; spunta quando un sigillo in bianco di scorta è in mano."
	]
	quest.4200000000228038.title: "Un sigillo di scorta"
	quest.4200000000228039.quest_desc: [
		"L'officina del fuoco. Un Totem di Fuoco entro otto e il Pulso eseguono ogni ricetta di fornace, graniglia minerale compresa. Un Cuore di tamburo in mano non può tenere questo forno.",
		"Come: fornace + risonatori + campanello. Totem di Fuoco. Fonde la graniglia per Pulso — un Cuore di tamburo in mano non può farlo andare."
	]
	quest.4200000000228039.title: "Graniglia nel forno"
	quest.420000000022803A.quest_desc: [
		"Tessi un Sigillo di ricetta per un'officina. Le bottiglie vuote tornano nello slot che le teneva. L'I/O laterale rifiuta gli spettatori e gli altri accampamenti. Dalla 5.0 vuole un Totem di risonanza (Telaio) sveglio entro otto blocchi, oppure resta fermo e dice quale voce gli manca.",
		"Come: il Codice degli Spiriti nomina la fabbricazione del Telaio dei sigilli. Siedi le bottiglie; tornano in quello slot."
	]
	quest.420000000022803A.title: "Un telaio per i sigilli"
	quest.420000000022803B.quest_desc: [
		"Quattro lampade di Pulso economiche (Canna luminosa, Lampada di scheggia, Applique d'eco, Ciotola di brace) attingono 1–2 di Pulso al secondo dal reticolo. La redstone le abbassa.",
		"Come: fabbrica una Lampada di scheggia, posizionala entro otto blocchi dal Pulso, poi abbassala con la redstone se vuoi la notte."
	]
	quest.420000000022803B.title: "Una lampada che beve Pulso"
	quest.420000000022803C.quest_desc: [
		"Dieci Amuleti dello spirito si indossano in tre slot tribali, niente Curios. Cielo con Aria è volo creativo. Usa accovacciato un Totem di risonanza per legare una voce; Coro lega ogni voce vicina a un Braciere.",
		"Come: fabbrica l'Amuleto del cielo, poi usalo accovacciato su un totem d'Aria. Codice degli Spiriti: Amuleti dello spirito."
	]
	quest.420000000022803C.title: "Un amuleto con voce"
	quest.420000000022803D.quest_desc: [
		"L'officina dell'acqua. Dalle rango alle stazioni d'eco, come all'equipaggiamento spirituale; un rango più alto spende più Pulso mentre accelera. Il rango sopravvive quando la raccogli. Dalla 5.0 vuole un Totem di risonanza dell'Acqua sveglio entro otto blocchi, oppure resta ferma e dice quale voce le manca.",
		"Come: pagine d'officina del Codice degli Spiriti. Posa la Pompa di marea su una faccia della cisterna, poi usa accovacciato il Codice se resta silenziosa."
	]
	quest.420000000022803D.title: "Una pompa per la cisterna"
	quest.420000000022803E.quest_desc: [
		"Ogni Pulso diventa ancora 100 FE. La conversione senza rango è di 60 di Pulso al secondo. Dai rango all'adattatore alla Sintonia d'eco, poi al Legame d'eco, poi al Manifesto d'eco, e lo stato a mano vuota nomina il ritmo attuale. Non può ancora ricevere FE.",
		"Come: usa accovacciato un Energizzatore armonico sulla Sintonia d'eco, poi sul Legame d'eco, poi sul Manifesto d'eco. Spunta quando la diagnosi nomina un ritmo sopra 60."
	]
	quest.420000000022803E.title: "Rango alla corrente"
	quest.420000000022803F.quest_desc: [
		"Usa accovacciato qualunque pezzo di equipaggiamento spirituale o amuleto su un Totem di risonanza piazzato (40 di Pulso) per legare quella voce. I set misti sono previsti. Il totem non si consuma. Il Telaio ha bisogno di un totem del Telaio.",
		"Come: usa accovacciato un attrezzo, un pezzo d'armatura o un amuleto su un totem con 40 di Pulso vicino. Spunta quando il tooltip nomina la voce legata."
	]
	quest.420000000022803F.title: "Lega una voce"
	quest.4200000000228040.quest_desc: [
		"Una lampada di canna. Luce di Pulso economica per un sentiero dell'accampamento. Facoltativo.",
		"Come: fabbrica la Canna luminosa. Posizionala vicino al Pulso. Facoltativo."
	]
	quest.4200000000228040.title: "Luce di canna"
	quest.4200000000228041.quest_desc: [
		"Un'applique a muro che beve Pulso. Facoltativo.",
		"Come: fabbrica l'Applique d'eco e appendila. Facoltativo."
	]
	quest.4200000000228041.title: "Applique dell'eco"
	quest.4200000000228042.quest_desc: [
		"Una ciotola di luce di falò dell'accampamento, sul Pulso. Facoltativo.",
		"Come: fabbrica la Ciotola di brace. Facoltativo."
	]
	quest.4200000000228042.title: "Ciotola di brace"
	quest.4200000000228043.quest_desc: [
		"Appendi un amuleto del vento al soffitto. Mobilio dell'accampamento della Marca: sgabello, tavolo, urna, stuoia, scaffale e questo. Facoltativo.",
		"Come: fabbrica l'Amuleto del vento e appendilo. Ricordo facoltativo."
	]
	quest.4200000000228043.title: "Un amuleto al vento"
	quest.4200000000228044.quest_desc: [
		"Il Coro lega ogni voce di totem vicina a un Braciere rituale. Facoltativo una volta che Cielo è in mano.",
		"Come: fabbrica l'Amuleto del coro, poi usalo accovacciato a un Braciere con voci a portata. Facoltativo."
	]
	quest.4200000000228044.title: "Ogni voce vicina"
	quest.4200000000228045.quest_desc: [
		"L'ascia spende Pulso come il piccone. Dalle rango alle stazioni d'eco; usa accovacciato un totem per legare una voce. Facoltativo.",
		"Come: fabbrica l'Ascia dell'equipaggiamento spirituale. Facoltativo una volta che il piccone esiste."
	]
	quest.4200000000228045.title: "Filo per il legno"
	quest.4200000000228046.quest_desc: [
		"Mattoni e una ciotola sopra tre di rame. Mettila su un falò acceso, fuoco, magma, lava o una Ciotola di brace; non chiede Pulso per niente. Fino a quattro ingredienti e una ciotola, in qualsiasi ordine, circa dodici secondi a pasto. Le tramogge la alimentano dall'alto e dai lati e prendono il pasto da sotto.",
		"Come: mattoni e una ciotola sopra tre di rame. Mettila su un falò, fuoco, magma, lava o una Ciotola di brace; niente Pulso."
	]
	quest.4200000000228046.title: "Una pentola per il campo"
	quest.4200000000228047.quest_desc: [
		"Un tubero rosso e caldo dalle Distese di brace. Ciò che raccogli è il seme; piantalo sul terreno coltivato come una patata. La Zappa dell'equipaggiamento spirituale miete e ripianta in un colpo solo.",
		"Come: cresce selvatico nelle Distese di brace, attraverso un Tamburo del cancello. Ciò che raccogli è il seme; piantalo sul terreno coltivato."
	]
	quest.4200000000228047.title: "Radice di brace"
	quest.4200000000228048.quest_desc: [
		"Cresce selvatico nella Palude di canne. Raccogli un ciuffo e pianta ciò che hai raccolto; quattro stadi su terreno lavorato, e le api lo impollinano.",
		"Come: cresce selvatico nella Palude di canne, attraverso un Tamburo del cancello. Pianta ciò che hai raccolto sul terreno coltivato."
	]
	quest.4200000000228048.title: "Riso di torbiera"
	quest.4200000000228049.quest_desc: [
		"Dai Campi di neve. Conta anche come erba per il Bollitore spirituale.",
		"Come: cresce selvatico sui Campi di neve, attraverso un Tamburo del cancello. Pianta ciò che hai raccolto sul terreno coltivato."
	]
	quest.4200000000228049.title: "Bacca di brina"
	quest.420000000022804A.quest_desc: [
		"Dalla Cresta del bagliore. Un'erba per il bollitore, e anche una coltura.",
		"Come: cresce selvatico sulla Cresta del bagliore, attraverso un Tamburo del cancello. Pianta ciò che hai raccolto sul terreno coltivato."
	]
	quest.420000000022804A.title: "Fagiolo di bagliore"
	quest.420000000022804B.quest_desc: [
		"Dalla Steppa, ed è il grano su cui poggia la maggior parte dei piatti delle tribù. Fanne un'aiuola prima del resto.",
		"Come: cresce selvatico sulla Steppa, attraverso un Tamburo del cancello. Pianta ciò che hai raccolto sul terreno coltivato."
	]
	quest.420000000022804B.title: "Grano della steppa"
	quest.420000000022804C.quest_desc: [
		"Due Grani di steppa e una Graniglia di ferro nella Pentola del focolare. Mangiare il piatto di una tribù porta il suo dono per cinque minuti; quello dei Cantori di ghiaia cava di più dal minerale. Quando una tribù ti chiama Amico, i suoi Congiunti vendono il piatto per quattro della sua coltura, e offrire a una tribù il suo piatto al suo focolare dà sei di stima.",
		"Come: due Grani di steppa e una Graniglia di ferro in una Pentola del focolare sul calore. I Congiunti dei Cantori di ghiaia lo vendono al grado Amico."
	]
	quest.420000000022804C.title: "La pagnotta dei Cantori di ghiaia"
	quest.420000000022804D.quest_desc: [
		"Due di Selvaggina cruda e una Radice di brace. La Selvaggina cruda cade dagli animali da caccia della Marca. Il dono dei Camminabordi: non cadi mai mentre ti acquatti. Ogni tribù ha un piatto; JEI elenca tutti e nove sotto la pentola.",
		"Come: due di Selvaggina cruda e una Radice di brace in una Pentola del focolare. La Selvaggina cruda cade dagli animali da caccia della Marca."
	]
	quest.420000000022804D.title: "La carne secca dei Camminabordi"
	quest.420000000022804E.quest_desc: [
		"Purea di radice del guardiano, Pane cotto alla graniglia, una Radice di brace e Grano di steppa nella pentola. Posa il banchetto su un blocco solido e tiene sei porzioni; ognuna ti sazia e concede la benedizione di Terra per otto minuti — scavi più in fretta e stai saldo. Ogni voce ha un banchetto dei propri piatti.",
		"Come: Purea di radice del guardiano, Pane cotto alla graniglia, Radice di brace e Grano di steppa in una Pentola del focolare. Posalo; sei porzioni."
	]
	quest.420000000022804E.title: "Un tavolo per l'accampamento"
	quest.420000000022804F.quest_desc: [
		"Ossa e ferro intorno a un calderone, un Campanello d'osso sotto. Mettilo sul calore. Tre posti: un reagente grezzo dalla tua sacca, un'erba della Marca e una base — una bottiglia di vetro fa due tinture, un favo due unguenti, il carbone quattro incensi. Un lotto è dieci secondi e 24 di Pulso dal reticolo. Il totem più vicino, entro otto blocchi, canta nel decotto.",
		"Come: ossa e ferro intorno a un calderone, un Campanello d'osso sotto. Mettilo sul calore; un totem entro 8 dà forma al decotto."
	]
	quest.420000000022804F.title: "Un bollitore sul fuoco"
	quest.4200000000228050.quest_desc: [
		"La famiglia del reagente sceglie il rimedio: Esca è Forza, Raffreddamento è Resistenza al fuoco, Antidoto toglie il veleno, Rammendo è Rigenerazione, e così via. Una tintura dura tre minuti e ti rende la bottiglia. Ogni rimedio toglie il Mal di spirito, il Silenzio non cantato, lo Sfilacciato e il Mal di ley.",
		"Come: Bollitore spirituale — un reagente grezzo, un'erba della Marca e una bottiglia di vetro. Dieci secondi, 24 di Pulso, due tinture."
	]
	quest.4200000000228050.title: "Bevilo"
	quest.4200000000228051.quest_desc: [
		"Il favo come base. Usa un unguento su di te, o su un amico, un villico o il tuo famiglio: tre cuori in un colpo, ogni effetto dannoso sparito, e il rimedio per metà del tempo di una tintura. Una pila di questi è la differenza tra una notte dura nella Marca e una passeggiata verso casa.",
		"Come: Bollitore spirituale — un reagente grezzo, un'erba della Marca e un favo. Due unguenti a cotta."
	]
	quest.4200000000228051.title: "Stendilo"
	quest.4200000000228052.quest_desc: [
		"Il carbone come base. Sistema l'incenso in un Braciere rituale — fino a sedici bastoncini, senza sigillo e senza Pulso — e ogni due secondi tutti entro otto blocchi ricevono il rimedio, e i famigli sono rammendati di un cuore. Ogni bastoncino brucia trenta secondi. La redstone lo spegne; accovacciati a mani vuote per riprenderlo.",
		"Come: Bollitore spirituale — un reagente grezzo, un'erba della Marca e carbone. Quattro incensi a cotta; bruciali in un Braciere rituale."
	]
	quest.4200000000228052.title: "Brucialo per tutti"
	quest.4200000000228053.quest_desc: [
		"Due Campanelli d'osso intorno a un Lingotto manifestato su un bastone. Tieni premuto Usa e ogni mezzo secondo rammenda chi guardi entro sei blocchi, o te: tre quarti di cuore per 2 di Pulso. Prende grado alle stazioni dell'Eco come il resto dell'equipaggiamento spirituale; da Legato ogni scossa alleggerisce il Mal di spirito di un livello.",
		"Come: due Campanelli d'osso intorno a un Lingotto manifestato su un bastone. Tieni premuto Usa per rammendare chi guardi."
	]
	quest.4200000000228053.title: "Scuotilo"
	quest.4200000000228054.quest_desc: [
		"Ciottoli sopra un blocco di magma ne fanno quattro. Sul calore fumano. Dormi tutta la notte in un letto, con pietre calde entro cinque blocchi e un tetto sopra di te: ti svegli del tutto guarito, purificato, con dieci minuti di Benedizione spirituale, perché il male non attecchisca.",
		"Come: ciottoli sopra un blocco di magma ne fanno quattro. Mettili sul calore, entro cinque blocchi da un letto coperto."
	]
	quest.4200000000228054.title: "Una notte al rifugio"
	quest.4200000000228055.quest_desc: [
		"Due pietre, una Scaglia di Dorsomuschio e Canna dello spirito intorno a un Sigillo spirituale; il sigillo ti viene reso. Lancialo su un braciere con un Sigillo spirituale seduto, dentro il suo Cerchio del rito, per 500 di Pulso: tutti entro dodici blocchi recuperano dieci cuori, vengono purificati e benedetti, e il cerchio resta aperto dieci minuti. Posa prima il Residuo spirituale di un famiglio caduto su un piedistallo, e torna intero.",
		"Come: due pietre, una Scaglia di Dorsomuschio, Canna dello spirito e un Sigillo spirituale, senza forma; il sigillo torna. Lancialo su un braciere sigillato, nel suo Cerchio del rito."
	]
	quest.4200000000228055.title: "Tavoletta di rito: Cerchio di guarigione"
	quest.4200000000228056.quest_desc: [
		"Un Lingotto manifestato, un Campanello d'osso e un bastone in diagonale. Sette danni, portata più uno e mezzo, e un affondo in scatto colpisce il 35 per cento più forte. Sotto è una Lama: prende grado alle stazioni dell'Eco, spende Pulso nei colpi d'eco e prende una voce di totem. Tiene un Segugio della fenditura a distanza di un braccio.",
		"Come: Lingotto manifestato, Campanello d'osso e un bastone in diagonale. Prende grado alle stazioni dell'Eco come la Lama."
	]
	quest.4200000000228056.title: "Prima la portata"
	quest.4200000000228057.quest_desc: [
		"Quattro Lingotti manifestati a T sopra un Campanello d'osso. Dieci danni, portata più mezzo, pesante — rallenta il passo finché è in mano — e la falciata più ampia e più forte della famiglia. L'alabarda, l'ascia da battaglia, il martello da guerra, il pugnale, la falce e il tridente si fanno allo stesso modo; ognuno scambia portata, velocità e peso con gli altri.",
		"Come: quattro Lingotti manifestati a T sopra un Campanello d'osso. Pesante; la falciata più ampia."
	]
	quest.4200000000228057.title: "La falciata più ampia"
	quest.4200000000228058.quest_desc: [
		"Filo e Risonatori di rame intorno a un Campanello d'osso. Spara dardi sonici con il Pulso delle celle che porti, e prende frecce di verso. Svelto a rilasciare di nuovo, e una mezza trazione se hai fretta.",
		"Come: filo e Risonatori di rame intorno a un Campanello d'osso. Spara dardi sonici con il Pulso che porti."
	]
	quest.4200000000228058.title: "Un arco che canta"
	quest.4200000000228059.quest_desc: [
		"Lingotti manifestati ai due lati di un Arco di Pulso, un gancio da inciampo e bastoni sotto. Tieni premuto Usa per caricare — 10 di Pulso in anticipo, un po' più a lungo di una trazione piena — poi usa di nuovo per sparare. Colpisce circa la metà più forte, vola quasi dritto e tiene il colpo finché vuoi.",
		"Come: Lingotti manifestati ai due lati di un Arco di Pulso, gancio da inciampo e bastoni sotto. Tieni premuto Usa per caricare, usa per sparare."
	]
	quest.4200000000228059.title: "La sorella più pesante dell'arco"
	quest.420000000022805A.quest_desc: [
		"Il Banco del canto ha un posto per l'arma accanto all'uscita. Alza un totem a portata con Pulso nel reticolo, tieni la Borsa dei reagenti nella barra rapida con quattro reagenti potenziati di un solo tipo, sistema un'arma dell'equipaggiamento spirituale nel posto, scegli il reagente e premi Unzione: quattro reagenti e 32 di Pulso. Arsura brucia, Richiamo della tempesta lancia il fulmine ad arco, Sete di sangue ruba vita, Rammendo ripara l'arma — undici in tutto, una alla volta; un reagente diverso la sostituisce. Solo l'equipaggiamento spirituale accetta il lavoro del banco, a meno che un pack non apra tribalpower:anointable. Spunta questo quando un'arma ne porta una.",
		"Come: arma dell'equipaggiamento spirituale nel posto del Banco del canto, quattro reagenti potenziati nella borsa, 32 di Pulso; premi Unzione. Spunta quando è unta."
	]
	quest.420000000022805A.title: "Un reagente nella lama"
	quest.420000000022805B.quest_desc: [
		"Rampicanti intorno a una Canna dello spirito e una perla di ender ne fanno due. Mettine uno su ogni piano nella stessa colonna; si trovano da soli, senza collegamento e senza energia. Salta per salire al prossimo ascensore sopra, accovacciati per scendere a quello sotto, fino a 48 blocchi per lato. Un ascensore con un soffitto sopra viene saltato.",
		"Come: rampicanti intorno a una Canna dello spirito e una perla di ender ne fanno due. Impilali in una colonna; salta su, accovacciati per scendere."
	]
	quest.420000000022805B.title: "Su per la colonna"
	quest.420000000022805C.quest_desc: [
		"Canna dello spirito sotto uno spago. Usalo su una creatura per prenderla e su un blocco per posarla, salva e intera. Mai un giocatore, un boss o un'élite della Marca. Il tessuto ha due usi — un viaggio; le urne di rame, manifestate e risonanti ne portano di più, e la risonante non si consuma mai. Non prende una creatura quando gli resta un solo uso.",
		"Come: Canna dello spirito sotto uno spago. Usalo su una creatura per prenderla, su un blocco per posarla. Due usi."
	]
	quest.420000000022805C.title: "Porta una creatura a casa"
	quest.420000000022805D.quest_desc: [
		"Cuoio sopra le assi intorno a un blocco sonoro. Il Rito del cancello come un gioco senza portale alla fine: ogni traccia che contiene, suonata su A, S, D, F quando i battiti raggiungono la linea. Tiene il tuo miglior punteggio per traccia e una classifica dei cinque migliori del server. Esercitati qui prima di un vero Tamburo del cancello.",
		"Come: cuoio sopra le assi intorno a un blocco sonoro. Usalo per scegliere una traccia e suonare A, S, D, F."
	]
	quest.420000000022805D.title: "Tamburo per il gusto"
	quest.420000000022805E.quest_desc: [
		"Quattro pietre luminose intorno a un Sigillo dello Spirito, due Lingotti manifestati, una carota d'oro e Tessuto spirituale. Usalo per indossarlo; l'uso accovacciato apre i tre slot degli amuleti. L'amuleto lanterna porta la voce dello Spirito: visione notturna, e ogni benedizione di voce su di te dura la metà in più. Gli amuleti indossati costano 2 di Pulso per voce ogni due secondi, da una Cella di Pulso che porti.",
		"Come: quattro pietre luminose intorno a un Sigillo dello Spirito, due Lingotti manifestati, una carota d'oro e Tessuto spirituale. Usalo per indossarlo; l'uso accovacciato apre gli slot."
	]
	quest.420000000022805E.title: "Una luce da indossare"
	quest.420000000022805F.quest_desc: [
		"Quando una tribù ti chiama Ospite, fai clic destro sul suo Anziano e parla. Chiedi lavoro e ti consegnano una richiesta — tre aperte al giorno, una tenuta per tribù, ognuna paga reputazione e ogni terza un Marchio della tribù. Chiedi la loro storia e inizia una strada di sette passi: Amico, la cosa che apprezzano, cacciare vicino ai loro fuochi, un rito nel loro accampamento, il loro piatto cucinato e dove ti mandano. L'ultimo passo è una prova contro un guardiano. Finisci una storia e tieni la sua reliquia.",
		"Come: fai clic destro sull'Anziano di una tribù da Ospite in su e chiedi la loro storia; sette passi finiscono contro un guardiano. Il progresso scatta alla prima reliquia."
	]
	quest.420000000022805F.title: "Una storia raccontata"
	quest.4200000000228060.quest_desc: [
		"La reliquia dei Custodi della piattaforma. La loro storia finisce allo Spirito della carica, all'Anello calpestato sulla Steppa; vinci la prova e l'Anziano te la consegna. Portata ovunque nel tuo inventario, tiene il loro dono su di te, qualunque sia la tua reputazione: non calpesti mai un campo.",
		"Come: finisci la storia dei Custodi della piattaforma con il loro Anziano; la prova è lo Spirito della carica sulla Steppa."
	]
	quest.4200000000228060.title: "Brace custodita"
	quest.4200000000228061.quest_desc: [
		"La reliquia dei Cantori di ghiaia. La loro storia finisce al Serpente di prisma, alla Fenditura cantante nei Campi di cristallo; vinci la prova e l'Anziano ti consegna la reliquia. Portata ovunque nel tuo inventario, ti tiene addosso il loro dono, qualunque sia la tua stima: ricavi di più dal minerale.",
		"Come: finisci la storia dei Cantori di ghiaia con il loro Anziano; la prova è il Serpente di prisma nei Campi di cristallo."
	]
	quest.4200000000228061.title: "Pietra risonante"
	quest.4200000000228062.quest_desc: [
		"La reliquia dei Legaradici. La loro storia finisce alla Matriarca della palude, alla Radice annegata nella Palude di canne; vinci la prova e l'Anziano ti consegna la reliquia. Portata ovunque nel tuo inventario, ti tiene addosso il loro dono, qualunque sia la tua stima: le colture si affrettano intorno a te.",
		"Come: finisci la storia dei Legaradici con il loro Anziano; la prova è la Matriarca della palude nella Palude di canne."
	]
	quest.4200000000228062.title: "Prima radice"
	quest.4200000000228063.quest_desc: [
		"La reliquia dei Camminabordi. La loro storia finisce al Roc della tempesta, al Posatoio sugli Altipiani; vinci la prova e l'Anziano ti consegna la reliquia. Portata ovunque nel tuo inventario, ti tiene addosso il loro dono, qualunque sia la tua stima: non cadi mai mentre ti accovacci.",
		"Come: finisci la storia dei Camminabordi con il loro Anziano; la prova è il Roc della tempesta sugli Altipiani."
	]
	quest.4200000000228063.title: "Chiodo da ponte"
	quest.4200000000228064.quest_desc: [
		"La reliquia dei Cuori di tamburo. La loro storia finisce al Titano di scorie, al Trono di scorie nelle Distese di brace; vinci la prova e l'Anziano ti consegna la reliquia. Portata ovunque nel tuo inventario, ti tiene addosso il loro dono, qualunque sia la tua stima: colpisci più in fretta.",
		"Come: finisci la storia dei Cuori di tamburo con il loro Anziano; la prova è il Titano di scorie nelle Distese di brace."
	]
	quest.4200000000228064.title: "Tamburo fermo"
	quest.4200000000228065.quest_desc: [
		"La reliquia dei Tessitori di motivi. La loro storia finisce al Tamburino della marea, alla Pietra della marea, nei Bassifondi; vinci la prova e l'Anziano te la consegna. Portata ovunque nel tuo inventario, ti tiene addosso il loro dono, qualunque sia la tua stima: le stazioni dell'Eco vicino a te lavorano il doppio.",
		"Come: finisci la storia dei Tessitori di motivi con il loro Anziano; la prova è il Tamburino della marea nei Bassifondi."
	]
	quest.4200000000228065.title: "Ingranaggio silenzioso"
	quest.4200000000228066.quest_desc: [
		"La reliquia dei Custodi della colonia. La loro storia finisce allo Spettro del tumulo, all'Anello del tumulo, sui Campi di neve; vinci la prova e l'Anziano te la consegna. Portata ovunque nel tuo inventario, ti tiene addosso il loro dono, qualunque sia la tua stima: non vieni mai punto.",
		"Come: finisci la storia dei Custodi della colonia con il loro Anziano; la prova è lo Spettro del tumulo sui Campi di neve."
	]
	quest.4200000000228066.title: "Sigillo dell'alveare"
	quest.4200000000228067.quest_desc: [
		"La reliquia degli Intagliatori di sigilli. La loro storia finisce alla Sentinella della volta, alla Porta sigillata, sulla Cresta del bagliore; vinci la prova e l'Anziano te la consegna. Portata ovunque nel tuo inventario, ti tiene addosso il loro dono, qualunque sia la tua stima: i tuoi amuleti chiedono metà del Pulso.",
		"Come: finisci la storia degli Intagliatori di sigilli con il loro Anziano; la prova è la Sentinella della volta sulla Cresta del bagliore."
	]
	quest.4200000000228067.title: "Sigillo cortese"
	quest.4200000000228068.quest_desc: [
		"La reliquia dei Cucitori del telaio. La loro storia finisce al Non cantato, al Tamburo silenzioso; vinci la prova e l'Anziano te la consegna. Portata ovunque nel tuo inventario, ti tiene addosso il loro dono, qualunque sia la tua stima: canti a meno.",
		"Come: finisci la storia dei Cucitori del telaio con il loro Anziano; la prova è il Non cantato al Tamburo silenzioso."
	]
	quest.4200000000228068.title: "Nono Filo"
	quest.4200000000228069.quest_desc: [
		"Ogni storia di tribù è finita: otto guardiani affrontati e il Non cantato. Con tutte e nove le reliquie nell'inventario, il Nono Accordo è a portata. `/tribalpower standing` mostra la stima di ogni tribù con te.",
		"Come: finisci tutte e nove le storie. Il progresso scatta quando la nona reliquia è in mano."
	]
	quest.4200000000228069.title: "Nove reliquie"
	quest.420000000022806A.quest_desc: [
		"Il Trono di scorie nelle Distese di brace: un anello di pietra con un Altare del guardiano al centro, su ardesia profonda levigata, tra quattro candele accese, a cielo aperto. Usa l'altare accovacciato a mano vuota e ti dice cosa vuole — otto Scaglie di magma — poi posale sopra e fatti indietro. Accovacciati per puntellarti contro i suoi colpi; infuriato, gli anelli si accendono e i Folletti di brace sorgono dalle scorie. A metà salute si infuria e chiama le creature del suo paese, che non lasciano nulla. Lascialo mezzo minuto e torna a dormire; l'altare riposa venti minuti tra una chiamata e l'altra. Lascia il Nucleo di scorie, e la sua caduta chiude la storia dei Cuori di tamburo.",
		"Come: usa accovacciato a mano vuota l'Altare del guardiano del paese, posa sopra otto del reagente che nomina e vinci. Il progresso scatta all'uccisione."
	]
	quest.420000000022806A.title: "Titano di scorie placato"
	quest.420000000022806B.quest_desc: [
		"La Radice annegata nella Palude di canne: un anello di pietra con un Altare del guardiano al centro, su ardesia profonda levigata, tra quattro candele accese, a cielo aperto. Usa l'altare accovacciato a mano vuota e ti dice cosa vuole — otto Zanne di canna — poi posale sopra e fatti indietro. Il suo laccio ti trascina dentro e ti rallenta; resta sul terreno solido e abbatti gli Inseguitori dei canneti che chiama. A metà salute si infuria e chiama le creature del suo paese, che non lasciano nulla. Lasciala mezzo minuto e torna a dormire; l'altare riposa venti minuti tra una chiamata e l'altra. Lascia il Cuore della palude, e la sua caduta chiude la storia dei Legaradici.",
		"Come: usa accovacciato a mano vuota l'Altare del guardiano del paese, posa sopra otto del reagente che nomina e vinci. Il progresso scatta all'uccisione."
	]
	quest.420000000022806B.title: "Matriarca della palude placata"
	quest.420000000022806C.quest_desc: [
		"L'Anello del tumulo sui Campi di neve: un anello di pietra con un Altare del guardiano al centro, su ardesia profonda levigata, tra quattro candele accese, a cielo aperto. Usa l'altare accovacciato a mano vuota e ti dice cosa vuole — otto Mandibole di brina — poi posale sopra e fatti indietro. Il suo soffio gela tutto ciò che ha davanti. Giragli alle spalle; gli Striscianti di brina che chiama sono lenti. A metà salute si infuria e chiama le creature del suo paese, che non lasciano nulla. Lascialo mezzo minuto e torna a dormire; l'altare riposa venti minuti tra una chiamata e l'altra. Lascia la Pietra del tumulo, e la sua caduta chiude la storia dei Custodi della colonia.",
		"Come: usa accovacciato a mano vuota l'Altare del guardiano del paese, posa sopra otto del reagente che nomina e vinci. Il progresso scatta all'uccisione."
	]
	quest.420000000022806C.title: "Spettro del tumulo placato"
	quest.420000000022806D.quest_desc: [
		"La Fenditura cantante nei Campi di cristallo: un anello di pietra con un Altare del guardiano al centro, su ardesia profonda levigata, tra quattro candele accese, a cielo aperto. Usa l'altare accovacciato a mano vuota e ti dice cosa vuole — otto Carapaci di prisma — poi posali sopra e fatti indietro. Spara dardi di luce che ti segnano di bagliore. Spostati di lato, avvicinati e guarda il secondo dardo che aggiunge una volta infuriato. A metà salute si infuria e chiama le creature del suo paese, che non lasciano nulla. Lascialo mezzo minuto e torna a dormire; l'altare riposa venti minuti tra una chiamata e l'altra. Lascia il Nucleo di prisma, e la sua caduta chiude la storia dei Cantori di ghiaia.",
		"Come: usa accovacciato a mano vuota l'Altare del guardiano del paese, posa sopra otto del reagente che nomina e vinci. Il progresso scatta all'uccisione."
	]
	quest.420000000022806D.title: "Serpente di prisma placato"
	quest.420000000022806E.quest_desc: [
		"La Porta sigillata sulla Cresta del bagliore: un anello di pietra con un Altare del guardiano al centro, su ardesia profonda levigata, tra quattro candele accese, a cielo aperto. Usa l'altare accovacciato a mano vuota e ti dice cosa vuole — otto Sigilli sentinella — poi posali sopra e fatti indietro. L'armatura più pesante della Marca e una falciata che ti scaraventa giù dalla cresta. Infuriata, si scherma tre secondi alla volta: aspetta che passi. A metà salute si infuria e chiama le creature del suo paese, che non lasciano nulla. Lasciala mezzo minuto e torna a dormire; l'altare riposa venti minuti tra una chiamata e l'altra. Lascia il Sigillo della volta, e la sua caduta chiude la storia degli Intagliatori di sigilli.",
		"Come: usa accovacciato a mano vuota l'Altare del guardiano del paese, posa sopra otto del reagente che nomina e vinci. Il progresso scatta all'uccisione."
	]
	quest.420000000022806E.title: "Sentinella della volta placata"
	quest.420000000022806F.quest_desc: [
		"La Pietra della marea, nei Bassifondi: un anello di pietra con un Altare del guardiano al centro, su ardesia profonda levigata, tra quattro candele accese, a cielo aperto. Usa l'altare accovacciato a mano vuota e ti dice ciò che vuole — otto Zanne di salamoia — poi posale sopra e fatti indietro. Ogni battito attira tutti verso di lui e fa male. Combattilo dalla riva, con la schiena contro qualcosa di solido. A metà salute si ridesta e chiama le creature del suo paese, che non lasciano nulla. Lascialo mezzo minuto e torna a dormire; l'altare riposa venti minuti tra una chiamata e l'altra. Lascia la Conchiglia della marea, e la sua caduta chiude la storia dei Tessitori di motivi.",
		"Come: usa accovacciato a mano vuota l'Altare del guardiano del paese, posa sopra otto del reagente che nomina e vinci. Il progresso scatta all'uccisione."
	]
	quest.420000000022806F.title: "Tamburino della marea acquietato"
	quest.4200000000228070.quest_desc: [
		"L'Anello calpestato sulla Steppa: un anello di pietra con un Altare del guardiano al centro, su ardesia profonda levigata, tra quattro candele accese, a cielo aperto. Usa l'altare accovacciato a mano vuota e ti dice ciò che vuole — otto Tendini di stinco — poi posali sopra e fatti indietro. Parte alla carica. Schiva di lato e colpiscilo mentre passa; quando i Digrignatori di tana affiorano, sta' su un blocco. A metà salute si ridesta e chiama le creature del suo paese, che non lasciano nulla. Lascialo mezzo minuto e torna a dormire; l'altare riposa venti minuti tra una chiamata e l'altra. Lascia il Corno della mandria, e la sua caduta chiude la storia dei Custodi della piattaforma.",
		"Come: usa accovacciato a mano vuota l'Altare del guardiano del paese, posa sopra otto del reagente che nomina e vinci. Il progresso scatta all'uccisione."
	]
	quest.4200000000228070.title: "Spirito della carica acquietato"
	quest.4200000000228071.quest_desc: [
		"Il Posatoio sugli Altipiani: un anello di pietra con un Altare del guardiano al centro, su ardesia profonda levigata, tra quattro candele accese, a cielo aperto. Usa l'altare accovacciato a mano vuota e ti dice ciò che vuole — otto Ali di tempesta — poi posale sopra e fatti indietro. Piomba in picchiata e ti scaglia in aria; ridesto, un fulmine segue ogni picchiata. Un arco e un tetto aiutano più di uno scudo. A metà salute si ridesta e chiama le creature del suo paese, che non lasciano nulla. Lascialo mezzo minuto e torna a dormire; l'altare riposa venti minuti tra una chiamata e l'altra. Lascia la Piuma della tempesta, e la sua caduta chiude la storia dei Camminabordi.",
		"Come: usa accovacciato a mano vuota l'Altare del guardiano del paese, posa sopra otto del reagente che nomina e vinci. Il progresso scatta all'uccisione."
	]
	quest.4200000000228071.title: "Roc della tempesta acquietato"
	quest.4200000000228072.quest_desc: [
		"Tutti e otto i nuclei di guardiano e un Cuore del Non cantato, senza forma. Un nucleo con un Filo del telaio farebbe invece sei Nuclei risonanti; prendi quindi un secondo mucchio di bottino se vuoi entrambi. La barra del boss di ogni guardiano porta il colore della sua tribù.",
		"Come: tutti e otto i nuclei di guardiano e un Cuore del Non cantato, senza forma. Lanciala in un cerchio del Telaio con le nove reliquie addosso."
	]
	quest.4200000000228072.title: "La tavoletta dei nove"
	quest.4200000000228073.quest_desc: [
		"Traccia un cerchio del Telaio — un Sigillo del telaio seduto nel braciere, dentro il suo Cerchio del rito — e lancia la tavoletta con tutte e nove le reliquie addosso; il rito attinge il suo Pulso prima di attecchire. Nove luci si alzano, una nel colore di ogni tribù. Da allora ogni tribù ti tratta almeno come Congiunto, tutti e nove i doni si posano su di te per un po', e l'aurora arde piena ogni notte in cui resti sotto di essa. Una volta per giocatore; un secondo lancio accende soltanto il cerchio.",
		"Come: Sigillo del telaio in un braciere dentro il suo Cerchio del rito, nove reliquie nello zaino; usa accovacciato la tavoletta sul braciere."
	]
	quest.4200000000228073.title: "Il Telaio è d'accordo"
	quest.4200000000228074.quest_desc: [
		"Sedici frammenti della storia del Telaio sono intagliati nella Marca: otto Pietre intagliate nei muri delle sue rovine, otto Murali due per due sui terreni dei guardiani. Fai clic destro su uno per leggerlo; il Codice degli Spiriti lo tiene, e la sua sezione Cronaca lo mette in ordine. Leggi tutti e sedici e la storia è intera.",
		"Come: clic destro su tutte e otto le Pietre intagliate nelle rovine della Marca e su tutti e otto i Murali nei terreni dei guardiani."
	]
	quest.4200000000228074.title: "La cronaca intera"
	quest.4200000000228075.quest_desc: [
		"Incastonata nei muri delle rovine della Marca — le opere vecchie, il santuario sommerso, i tumuli, le tombe, le volte. Leggila dove la trovi, poi raccoglila e mettila su un muro tuo; ciò che leggi resta letto.",
		"Come: incastonata nei muri delle rovine della Marca. Leggila, poi rompila e mettila sul tuo muro."
	]
	quest.4200000000228075.title: "Una pietra che ricorda"
	quest.4200000000228076.quest_desc: [
		"Due blocchi di larghezza e due di altezza sul terreno di ogni guardiano; ciascuno dipinge il paese in cui sta. Leggerne una parte qualunque lo legge tutto. Piazzato come un pezzo solo, viene giù come uno solo; un murale tagliato in creativa cambia capitolo con un clic accovacciato.",
		"Come: sta due per due sul terreno di ogni guardiano. Leggilo, poi staccalo intero e mettilo a casa."
	]
	quest.4200000000228076.title: "Un muro che dipinge il suo paese"
	quest.4200000000228077.quest_desc: [
		"La Marca agisce da sola. Caduta di cenere, una Tempesta di bagliore, un Bianco totale e Nebbia dei canneti chiudono un paese e levano gli spiriti di giorno; ognuno nutre i generatori di una voce e intralcia quelli di un'altra. Ogni tanto i fili di ley di una voce salgono di colpo: i collettori che li portano rendono il doppio, ma stai su un incrocio nudo senza collettore e il Mal di ley fa ondeggiare il suolo e svuota il tuo Pulso. Ogni tribù tiene un giorno di festa a turno — unisciti al banchetto per un dono. Una luce calda che deriva vicino a te è uno spirito errante; raggiungila per una riga della storia del suo paese e un piccolo dono. Tempeste e ondate si annunciano due minuti prima, nella chat e sopra la barra rapida. Spunta questo quando ne hai superato uno.",
		"Come: sii nella Marca durante un meteo, un'ondata o un giorno di festa; spuntalo quando l'hai fatto."
	]
	quest.4200000000228077.title: "La Marca respira"
	quest.420000000023058C.quest_desc: [
		"I Cantori di ghiaia non tagliano mai una pietra due volte allo stesso modo. Questo banco ricorda ogni taglio.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: pietra + parti del tavolo in JEI. Inserisci un blocco e scegli una variante."
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"Lo stesso trucco per il legno — cento assi da una.",
		"Come: tavolo del falegname di Chipped in JEI. La stessa idea del tavolo del muratore, per il legno."
	]
	quest.420000000023058D.title: "Tavolo del falegname"
	quest.420000000023058E.quest_desc: [
		"Sabbia in vetro, poi il vetro in ogni forma che la luce prende.",
		"Come: banco di Chipped in JEI (muratore, falegname, soffiatore di vetro…). Metti il blocco nel tavolo e scegli un taglio."
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"Lana e stoffa, ritessute — calza, per una piattaforma che sta rammendando un Telaio.",
		"Come: banco di Chipped in JEI (muratore, falegname, soffiatore di vetro…). Metti il blocco nel tavolo e scegli un taglio."
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"Foglie, arboscelli e cose che crescono, ordinate nelle loro variazioni.",
		"Come: banco di Chipped in JEI (muratore, falegname, soffiatore di vetro…). Metti il blocco nel tavolo e scegli un taglio."
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"Blocchi colorati e pietra più strana. Scegli una variante; il banco tiene il resto.",
		"Come: banco di Chipped in JEI (muratore, falegname, soffiatore di vetro…). Metti il blocco nel tavolo e scegli un taglio."
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"Metallo e blocchi con faccia da macchina, tagliati a gusto.",
		"Come: banco di Chipped in JEI (muratore, falegname, soffiatore di vetro…). Metti il blocco nel tavolo e scegli un taglio."
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"Dai un blocco al Tavolo del muratore e scegli dal muro di varianti.",
		"Come: quattro pietre in un quadrato, o il tagliapietre."
	]
	quest.4200000000230593.title: "Un taglio di pietra"
	quest.4200000000230594.quest_desc: [
		"Il Tavolo del falegname fa lo stesso per il legno.",
		"Come: un tronco nella griglia di fabbricazione ne fa quattro."
	]
	quest.4200000000230594.title: "Un taglio di assi"
	quest.4200000000230595.quest_desc: [
		"Ogni pannello che il Soffiatore di vetro conosce inizia qui.",
		"Come: fondi la sabbia. Martella i ciottoli in ghiaia, la ghiaia in sabbia, poi in fornace."
	]
	quest.4200000000230595.title: "Un taglio di vetro"
	quest.4200000000230596.quest_desc: [
		"La pietra preferita dei Cantori di ghiaia, quella su cui discutono.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000230596.title: "Varietà di ardesia profonda"
	quest.4200000000230597.quest_desc: [
		"Argilla cotta, in cento modi.",
		"Come: quattro oggetti mattone. Le palle d'argilla si fondono in mattoni."
	]
	quest.4200000000230597.title: "Varietà di mattoni"
	quest.4200000000230598.quest_desc: [
		"Ghiaia della piattaforma, tagliata fine.",
		"Come: crea, fondi, setaccia, oppure prendilo da un mostro. JEI elenca ogni fonte sulla piattaforma."
	]
	quest.4200000000230598.title: "Varietà di arenaria"
	quest.4200000000240599.quest_desc: [
		"La prima cosa che fa di una piattaforma un posto dove qualcuno vive.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: assi di quercia in JEI. Primo pezzo Handcrafted."
	]
	quest.4200000000240599.title: "Una sedia"
	quest.420000000024059A.quest_desc: [
		"Un posto dove posare il Codice mentre pensi.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.420000000024059A.title: "Un tavolo"
	quest.420000000024059B.quest_desc: [
		"Posto perché un Clowder si sieda mentre la botte lavora.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.420000000024059B.title: "Una panca"
	quest.420000000024059C.quest_desc: [
		"Per le Pagine del codice che continui a dire di rileggere.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.420000000024059C.title: "Uno scaffale"
	quest.420000000024059D.quest_desc: [
		"Un deposito Handcrafted che sembra al suo posto.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.420000000024059D.title: "Una credenza"
	quest.420000000024059E.quest_desc: [
		"I Custodi della piattaforma dormivano bene. Dovresti farlo anche tu.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.420000000024059E.title: "Un letto elegante"
	quest.420000000024059F.quest_desc: [
		"Una lanterna, una pagina, un posto per entrambi.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.420000000024059F.title: "Un comodino"
	quest.42000000002405A0.quest_desc: [
		"Taglia una cornice, poi vestila di un blocco qualsiasi. Una forma, ogni pelle.",
		"Come: un lingotto di ferro sopra tre cubi incorniciati. Taglia i blocchi incorniciati."
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"Un cubo spoglio, in attesa di un blocco mimetico.",
		"Come: Sega da cornici, poi cubo/lastra/scale incorniciati. Il camuffamento è un clic destro con un blocco."
	]
	quest.42000000002405A1.title: "Framed Cube"
	quest.42000000002405A2.quest_desc: [
		"Mezzo telaio; il doppio delle opzioni.",
		"Come: Sega da cornici, poi cubo/lastra/scale incorniciati. Il camuffamento è un clic destro con un blocco."
	]
	quest.42000000002405A2.title: "Framed Slab"
	quest.42000000002405A3.quest_desc: [
		"Gradini che indossano il muro in cui posano, qualunque sia.",
		"Come: Sega da cornici, poi cubo/lastra/scale incorniciati. Il camuffamento è un clic destro con un blocco."
	]
	quest.42000000002405A3.title: "Framed Stairs"
	quest.42000000002405A4.quest_desc: [
		"Per tetti e linee di tetto che il vuoto non ti ha mai dato.",
		"Come: Sega da cornici, poi cubo/lastra/scale incorniciati. Il camuffamento è un clic destro con un blocco."
	]
	quest.42000000002405A4.title: "Framed Slope"
	quest.42000000002405A5.quest_desc: [
		"I Camminabordi hanno scavalcato il vuoto con meno. Raggiungi la prossima piattaforma con stile.",
		"Come: ponti Macaw dalla pietra/legno corrispondente in JEI."
	]
	quest.42000000002405A5.title: "Ponte di corda"
	quest.42000000002405A6.quest_desc: [
		"Un tetto sopra la piattaforma. La pioggia quassù non è mai che ambizione.",
		"Come: tetti Macaw dal legno corrispondente in JEI."
	]
	quest.42000000002405A6.title: "Tetto da soffitta"
	quest.42000000002405A7.quest_desc: [
		"Anche la comodità è infrastruttura.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.42000000002405A7.title: "Divano"
	quest.42000000002405A8.quest_desc: [
		"Un bordo di cucina per la linea di Farmer's Delight.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.42000000002405A8.title: "Bancone"
	quest.42000000002405A9.quest_desc: [
		"Dove il Codice dei Baffi prende i suoi margini.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.42000000002405A9.title: "Scrivania"
	quest.42000000002405AA.quest_desc: [
		"Un piccolo vano in tinta con il tavolo.",
		"Come: mobili Handcrafted da assi in JEI. La prima sedia è di quercia."
	]
	quest.42000000002405AA.title: "Cassetto"
	quest.42000000002405AB.quest_desc: [
		"Una soglia che si nasconde nel muro.",
		"Come: Sega da cornici, poi cubo/lastra/scale incorniciati. Il camuffamento è un clic destro con un blocco."
	]
	quest.42000000002405AB.title: "Framed Door"
	quest.42000000002405AC.quest_desc: [
		"Copertura sottile; travestimento completo.",
		"Come: Sega da cornici, poi cubo/lastra/scale incorniciati. Il camuffamento è un clic destro con un blocco."
	]
	quest.42000000002405AC.title: "Framed Panel"
	quest.42000000002405AD.quest_desc: [
		"Un parapetto di bordo che puoi vestire a gusto.",
		"Come: Sega da cornici, poi cubo/lastra/scale incorniciati. Il camuffamento è un clic destro con un blocco."
	]
	quest.42000000002405AD.title: "Framed Fence"
	quest.42000000002405AE.quest_desc: [
		"Grigio e schietto, come la ghiaia da cui è nato.",
		"Come: ponti Macaw dalla pietra/legno corrispondente in JEI."
	]
	quest.42000000002405AE.title: "Ponte di andesite"
	quest.42000000002505AF.quest_desc: [
		"Una luce da parete, non una torcia ficcata per vergogna. I custodi avevano dei criteri.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: torcia + pepite di ferro. Prima fabbricazione delle custodie."
	]
	quest.42000000002505AF.title: "Porta torcia"
	quest.42000000002505B0.quest_desc: [
		"Sabbia che cade. L'unico orologio onesto prima del Filo di Orologio.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B0.title: "Clessidra"
	quest.42000000002505B1.quest_desc: [
		"Fai gocciolare un fluido da un blocco. Piccolo; stranamente soddisfacente.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B1.title: "Rubinetto"
	quest.42000000002505B2.quest_desc: [
		"Girala a mano. Anche i Cuori di tamburo sono partiti da qualche parte.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B2.title: "Manovella"
	quest.42000000002505B3.quest_desc: [
		"Metti in mostra qualcosa. Un gettone, una pagina, un trofeo.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B3.title: "Scaffale per oggetti"
	quest.42000000002505B4.quest_desc: [
		"Un sacco che tiene sacchi. Il disordine di Recupero, messo in ordine.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B4.title: "Sacco"
	quest.42000000002505B5.quest_desc: [
		"Chiudi dentro il Filo sfilacciato, lontano dalle tue idee peggiori.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B5.title: "Cassaforte"
	quest.42000000002505B6.quest_desc: [
		"Appunta una pagina dove tutto il Clowder la legge.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B6.title: "Bacheca"
	quest.42000000002505B7.quest_desc: [
		"Un vaso con ambizioni. Coltiva un poco dove la piattaforma è sottile.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B7.title: "Vasiera"
	quest.42000000002505B8.quest_desc: [
		"Innalza il Frammento del telaio di Fuso dove si possa ammirare.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B8.title: "Piedistallo"
	quest.42000000002505B9.quest_desc: [
		"Riponi biscotti, api o la piccola dignità dell'ordine.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505B9.title: "Barattolo (37)"
	quest.42000000002505BA.quest_desc: [
		"Imposta un'apparizione senza trascinare un letto intero su per la scala.",
		"Come: lana in JEI. Sacco a pelo bianco; esistono varianti tinte. Imposta l'apparizione senza un letto intero."
	]
	quest.42000000002505BA.title: "Sacco a pelo"
	quest.42000000002505BB.quest_desc: [
		"Dormi il giorno, così le creature incontrano uno Skybound riposato.",
		"Come: lana + spago in JEI. Appendila a Corda e Chiodo."
	]
	quest.42000000002505BB.title: "Amaca"
	quest.42000000002505BC.quest_desc: [
		"Appendi l'amaca tra due pali, sopra il precipizio, e osala.",
		"Come: spago e un lingotto di ferro. Piazzane due, poi appendi l'amaca."
	]
	quest.42000000002505BC.title: "Rope and Nail"
	quest.42000000002505BD.quest_desc: [
		"Una fiamma più ferma per le lunghe notti della piattaforma.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505BD.title: "Portacandela"
	quest.42000000002505BE.quest_desc: [
		"Scala, appenditi o fai un ponte. I Camminabordi ci giuravano.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505BE.title: "Corda (37)"
	quest.42000000002505BF.quest_desc: [
		"Alza e abbassa la corda al capriccio della redstone.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505BF.title: "Puleggia"
	quest.42000000002505C0.quest_desc: [
		"Cadici sopra e il vuoto dimentica di punirti.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505C0.title: "Blocco di piume"
	quest.42000000002505C1.quest_desc: [
		"Disegna col gesso un piano su cui tutto il Clowder possa discutere.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505C1.title: "Lavagna"
	quest.42000000002505C2.quest_desc: [
		"Porta una cosetta che preferirebbe di no.",
		"Come: fabbricazione Supplementaries in JEI (applique, sacco, cassaforte, corda…). Le custodie nominano la stazione."
	]
	quest.42000000002505C2.title: "Gabbia"
	quest.42000000002605C3.quest_desc: [
		"Il primo filo. Il polso che i Cuori di tamburo tenevano ora ha dove andare.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: lamina lastre di rame in un laminatoio. Il capitolo attuale inizia qui."
	]
	quest.42000000002605C3.title: "Cavo di rame"
	quest.42000000002605C4.quest_desc: [
		"Rotazione da un lato, Energia di Forge dall'altro. Due Fili si stringono la mano.",
		"Come: Create Crafts & Additions — filo di rame dal laminatoio, poi connettori e motore."
	]
	quest.42000000002605C4.title: "Connettore"
	quest.42000000002605C5.quest_desc: [
		"L'energia torna rotazione. Il Filo Orologio ora gira sul Filo Scintilla.",
		"Come: Create Crafts & Additions — filo di rame dal laminatoio, poi connettori e motore."
	]
	quest.42000000002605C5.title: "Motore elettrico"
	quest.42000000002605C6.quest_desc: [
		"Tieni una carica tra il filo e il lavoro.",
		"Come: Create Crafts & Additions — filo di rame dal laminatoio, poi connettori e motore."
	]
	quest.42000000002605C6.title: "Condensatore"
	quest.42000000002605C7.quest_desc: [
		"Un muro di corrente accumulata, grande quanto la piattaforma consente.",
		"Come: Create Crafts & Additions — filo di rame dal laminatoio, poi connettori e motore."
	]
	quest.42000000002605C7.title: "Accumulatore modulare"
	quest.42000000002605C8.quest_desc: [
		"Aste e filo dai lingotti — la risposta di Create alla pressa.",
		"Come: Create Crafts & Additions — filo di rame dal laminatoio, poi connettori e motore."
	]
	quest.42000000002605C8.title: "Molino a Cilindri"
	quest.42000000002605C9.quest_desc: [
		"Incanta senza la superstizione del tavolo. Dagli esperienza, ottieni un intento.",
		"Come: Create Enchantment Industry dopo un bruciatore di blaze. JEI nomina la stampante e il secchio d'esperienza."
	]
	quest.42000000002605C9.title: "Blaze Enchanter"
	quest.42000000002605CA.quest_desc: [
		"Pratica liquida, portata. I custodi avrebbero trovato questo volgare e utile.",
		"Come: Create Enchantment Industry dopo un bruciatore di blaze. JEI nomina la stampante e il secchio d'esperienza."
	]
	quest.42000000002605CA.title: "Secchio d'esperienza"
	quest.42000000002605CB.quest_desc: [
		"Copia un libro, un progetto, una pagina. Il Codice dei Baffi approva, piano.",
		"Come: Create Enchantment Industry dopo un bruciatore di blaze. JEI nomina la stampante e il secchio d'esperienza."
	]
	quest.42000000002605CB.title: "Printer"
	quest.42000000002605CC.quest_desc: [
		"Lava e calore in energia. Un ponte, non il Ronzio in sé.",
		"Come: osmio + fornace + rame. Il primo generatore Mekanism."
	]
	quest.42000000002605CC.title: "Generatore Termico"
	quest.42000000002605CD.quest_desc: [
		"Su una piattaforma che è tutto cielo, il sole è l'unica risorsa che nessuno raziona.",
		"Come: generatori Mekanism, dopo la linea Officine Mekanism. Il generatore di calore è la prima creazione."
	]
	quest.42000000002605CD.title: "Pannello Solare"
	quest.42000000002605CE.quest_desc: [
		"Più alta è la piattaforma, più forte gira. Costruisci in alto.",
		"Come: generatori Mekanism, dopo la linea Officine Mekanism. Il generatore di calore è la prima creazione."
	]
	quest.42000000002605CE.title: "Turbina Eolica"
	quest.42000000002605CF.quest_desc: [
		"Brucia l'avanzo del Filo Germoglio. Su una piattaforma niente è spreco.",
		"Come: generatori Mekanism, dopo la linea Officine Mekanism. Il generatore di calore è la prima creazione."
	]
	quest.42000000002605CF.title: "Bio-Generatore"
	quest.42000000002605D0.quest_desc: [
		"Energia tarda per un Clowder che è andato a fondo su Mekanism.",
		"Come: generatori Mekanism, dopo la linea Officine Mekanism. Il generatore di calore è la prima creazione."
	]
	quest.42000000002605D0.title: "Generatore a gas"
	quest.42000000002605D1.quest_desc: [
		"Il telaio digitale, in tasca. Ritessi da qualunque punto della piattaforma.",
		"Come: Terminale senza fili dopo una rete AE2 e un kit senza fili carico. JEI nomina la creazione."
	]
	quest.42000000002605D1.title: "Terminale senza fili (38)"
	quest.42000000002605D2.quest_desc: [
		"Le sostanze chimiche di Mekanism, tenute nella rete AE2. Due pilastri tardivi, intrecciati.",
		"Come: celle chimiche di Applied Mekanistics dopo l'alloggiamento AE2 + sostanze chimiche di Mekanism."
	]
	quest.42000000002605D2.title: "Cella chimica"
	quest.42000000002605D3.quest_desc: [
		"Per quando il filo di rame non può portare tutto il polso.",
		"Come: Create Crafts & Additions — filo di rame dal laminatoio, poi connettori e motore."
	]
	quest.42000000002605D3.title: "Large Connector"
	quest.42000000002605D4.quest_desc: [
		"Una torta che ti fa salire di livello. Non dirlo alla linea di cucina.",
		"Come: Create Enchantment Industry dopo un bruciatore di blaze. JEI nomina la stampante e il secchio d'esperienza."
	]
	quest.42000000002605D4.title: "Torta d'esperienza"
	quest.42000000002605D5.quest_desc: [
		"Un morso più grande dello stesso cielo gratuito.",
		"Come: generatori Mekanism, dopo la linea Officine Mekanism. Il generatore di calore è la prima creazione."
	]
	quest.42000000002605D5.title: "Solare avanzato"
	quest.42000000002605D6.quest_desc: [
		"Il guscio di cui ogni cella chimica ha bisogno.",
		"Come: celle chimiche di Applied Mekanistics dopo l'alloggiamento AE2 + sostanze chimiche di Mekanism."
	]
	quest.42000000002605D6.title: "Alloggiamento chimico"
	quest.42000000002605D7.quest_desc: [
		"Porta una misura di gas fuori dalla rete.",
		"Come: celle chimiche di Applied Mekanistics dopo l'alloggiamento AE2 + sostanze chimiche di Mekanism."
	]
	quest.42000000002605D7.title: "Cella chimica portatile"
	quest.42000000002705D8.quest_desc: [
		"Ogni Filo ha un guardiano che il Taglio ha spezzato: un costrutto del Telaio diventato selvatico. Non assassini un mostro; ridai tensione al Filo battendolo. Crea il suo Totem sfilacciato una volta che il Filo è sistemato, usalo ovunque fuori da un'arena, e tu e ogni compagno di Clowder entro 32 blocchi venite tirati sulla sua scena. Vinci, e ognuno di voi porta a casa la Reliquia tessuta di quel guardiano. Perdi, e venite risputati fuori col totem consumato.",
		"Le reliquie funzionano dallo slot reliquia di Curios, dalla mano secondaria o dalla barra rapida: un passivo mentre le indossi e un potere al clic destro con recupero. `/guardians leave` abbandona uno scontro; `/guardians status` mostra il registro del Clowder.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: spunta. Crea ogni Totem sfilacciato dopo che quel Filo è sistemato; usalo fuori da un'arena."
	]
	quest.42000000002705D8.title: "Risposta per il Taglio"
	quest.42000000002705D9.quest_desc: [
		"La Ciotola della tana: una ciotola infossata di quattro gradini di terra che scendono a una fossa di fango, sotto sei archi di radici di quercia scura, con sette cuciture di radici verde acqua che brillano sul fondo della fossa.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705D9.title: "Totem: Il Giaciglio"
	quest.42000000002705DA.quest_desc: [
		"A ogni quarto della sua salute, Il Giaciglio sbatte e allaga la fossa con uno strato di terra, immune dentro. Una delle sette cuciture si accende: scava un canale fino a essa, esponi il nucleo e colpiscilo per spezzare la sepoltura. Il primo cancello, e uno clemente.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705DA.title: "Ridare la tensione: Il Giaciglio"
	quest.42000000002705DB.quest_desc: [
		"Cuore di radice: il contraccolpo subito cala del sessanta per cento e niente può trascinarti. Radici a terra ti pianta per cinque secondi dietro otto cuori di Assorbimento.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705DB.title: "Reliquia: Cuore di radice"
	quest.42000000002705DC.quest_desc: [
		"La Fossa di macina: una cava di ardesia profonda con un anello di mole rotante nel pavimento e quattro scivoli di setaccio di pietra che versano ghiaia nella fossa centrale di ghiaia.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705DC.title: "Totem: La Fauce"
	quest.42000000002705DD.quest_desc: [
		"La Fauce è immune finché la sua bocca è chiusa. Ogni scivolo lascia cadere un blocco di ghiaia ogni quindici secondi; portane uno sull'anello e lascialo scorrere nella bocca della fossa per inceppare le fauci aperte per dodici secondi. L'anello si inverte a ogni fase e spinge l'incauto nella fossa.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705DD.title: "Ridare la tensione: La Fauce"
	quest.42000000002705DE.quest_desc: [
		"Nucleo di macina: immune ad Affaticamento, e i tuoi setacci in mano hanno un tiro di Fortuna in più. Sbrana toglie due di armatura alla prossima cosa che colpisci.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705DE.title: "Reliquia: Nucleo di macina"
	quest.42000000002705DF.quest_desc: [
		"La Terrazza della sovraccrescita: quattro terrazze da giardino sotto una volta di foglie, otto pali di graticcio e quattro stazioni di potatura al secondo livello.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705DF.title: "Totem: La Madre di spine"
	quest.42000000002705E0.quest_desc: [
		"La Madre di spine non colpisce mai; semina una siepe di spine che si allarga e brucia al tocco, e guarisce ogni volta che una stazione di potatura è invasa. Cesoie e asce la sgombrano. Composta otto di siepe a una stazione per scatenare un'ondata di potatura che libera il suolo e la stordisce — l'unica finestra di danno pulita.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705E0.title: "Ridare la tensione: La Madre di spine"
	quest.42000000002705E1.quest_desc: [
		"Seme di spine: Spine, e niente danno da bacche o da cactus. Fioritura alza un anello di siepe e dà Rigenerazione II a te e al tuo Clowder dentro.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705E1.title: "Reliquia: Seme di spine"
	quest.42000000002705E2.quest_desc: [
		"Le Schegge del cielo: dieci schegge di ardesia profonda sospese sul vuoto, ponti che si sgretolano tra loro, segni d'artiglio d'oro sulla scheggia principale, dove atterra il boss.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705E2.title: "Totem: Il Camminaborde"
	quest.42000000002705E3.quest_desc: [
		"Un duello puro. Il Camminaborde salta da scheggia a scheggia e si avventa su chi sta più lontano da un muro; un segno d'artiglio d'oro mostra dove, un respiro prima che atterri — spostati. I ponti si sgretolano dietro di te e tornano dopo. Cadere costa sei cuori e un ritorno alla tua piattaforma.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705E3.title: "Ridare la tensione: Il Camminaborde"
	quest.42000000002705E4.quest_desc: [
		"Passo di bordo: niente danno da caduta sotto i dodici blocchi e niente scivolate dai bordi. Passo di bordo scatta di sei blocchi, due volte, con un colpo più forte alla fine.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705E4.title: "Reliquia: Passo di bordo"
	quest.42000000002705E5.quest_desc: [
		"Il Tamburo di forgia: una pedana-tamburo d'ottone sopra un cratere di lava, otto martelli a pistone di rame con cuscinetti di battuta davanti, quattro canali di lava attraverso il pavimento.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705E5.title: "Totem: Il Cuore di tamburo"
	quest.42000000002705E6.quest_desc: [
		"Il Cuore di tamburo si può ferire solo per un istante dopo ogni quarto battito. Stai su una piastra di battuta sul tempo forte per caricare una scintilla che conta tre volte; al quarto battito i canali di lava salgono, quindi resta sulle piastre, non nei canali. Il tempo sale a ogni fase.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705E6.title: "Ridare la tensione: Il Cuore di tamburo"
	quest.42000000002705E7.quest_desc: [
		"Impulso di tamburo: ogni quarto colpo mette a segno due cuori in più. Il tempo forte stordisce e respinge tutto entro sette blocchi.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705E7.title: "Reliquia: Impulso di tamburo"
	quest.42000000002705E8.quest_desc: [
		"Lo Scappamento: quattro anelli di rame rotanti che portano tessere di sequenza di quercia scura intorno a un mozzo di ferro, sei torri di ingranaggi e un pendolo di sedici blocchi che tiene il tempo.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705E8.title: "Totem: L'Ingranaggista"
	quest.42000000002705E9.quest_desc: [
		"A ogni fase L'Ingranaggista carica: le tessere si accendono in sequenza sugli anelli che girano e hai dodici secondi per calpestarle in ordine. Il successo apre il telaio per otto secondi; il fallimento fa sparare ogni torre di ingranaggi. Il pendolo è il metronomo; gli anelli si invertono quando oscilla lontano.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705E9.title: "Ridare la tensione: L'Ingranaggista"
	quest.42000000002705EA.quest_desc: [
		"Anello d'ingranaggio: Fretta I, e gli attrezzi si consumano di un quinto più lentamente. Riavvolgi azzera ogni altra reliquia che porti e ti riporta di scatto dove stavi tre secondi fa.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705EA.title: "Reliquia: Anello d'ingranaggio"
	quest.42000000002705EB.quest_desc: [
		"Il Favo: un'arena esagonale di cera, con celle del favo che salgono e scendono, pozze di miele e sei celle di fuco nel muro.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705EB.title: "Totem: La Mente alveare"
	quest.42000000002705EC.quest_desc: [
		"La Mente alveare è fragile, ma a ogni ondata le sue sei celle riversano fuchi. Un falò messo su una cella di fuco la sigilla per trenta secondi; sigillale tutte e sei e la camera reale si apre per dieci secondi. Le tue Productive Bees attaccano i fuchi a vista.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705EC.title: "Rimettere in tensione: La Mente alveare"
	quest.42000000002705ED.quest_desc: [
		"Richiamo dell'alveare: le api non si rivoltano mai contro di te, e gli alveari entro sedici blocchi lavorano un decimo più in fretta. Chiama lo Sciame: manda quattro api reliquia contro ciò che colpisci.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705ED.title: "Reliquia: Richiamo dell'alveare"
	quest.42000000002705EE.quest_desc: [
		"Il Cerchio di guardia: un santuario di pietra con cerchi d'oro e nove pilastri di glifi con guglie d'ametista, un palco a nove lati di pioli d'oro al centro.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705EE.title: "Totem: Lo Spezzasigilli"
	quest.42000000002705EF.quest_desc: [
		"Lo Spezzasigilli si nasconde dietro tre custodie attive. I pioli del palco accendono l'ordine una volta per fase — guarda prima. Dissipa i pilastri in quell'ordine con una dissipazione di Ars o un qualunque oggetto del Filo Sigillo; uno sbagliato riarma tutti e tre e il vetro di custodia morde. Tre giusti, e resta aperto per dodici secondi. Le fasi successive mescolano le rune e aggiungono un'esca.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705EF.title: "Rimettere in tensione: Lo Spezzasigilli"
	quest.42000000002705F0.quest_desc: [
		"Segno di sigillo: i danni magici subiti calano di un quinto. Segno di sigillo protegge te, o un compagno di Clowder che guardi, da un colpo pesante.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705F0.title: "Reliquia: Segno di sigillo"
	quest.42000000002705F1.quest_desc: [
		"Il Telaio che crolla: un telaio largo sessantasei blocchi, il cui pavimento è l'ordito — strisce di assi che si disfano in ponti di filo quando cadono le barre dei licci.",
		"Quattro Filo sfilacciato e quattro del blocco del Filo intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705F1.title: "Totem: Il Distessuto"
	quest.42000000002705F2.quest_desc: [
		"Cinque fasi. Ognuna cita due delle altre otto meccaniche per trenta secondi, poi cade una barra dei licci e altre tre strisce si disfano. Nella vera forma restano le ultime quattro strisce, e i fili dell'ordito sono l'unica via su fino alla trave dove sta. Uccidilo lì: il Ritessere.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705F2.title: "Rimettere in tensione: Il Distessuto"
	quest.42000000002705F3.quest_desc: [
		"Filo del telaio: due tensioni del Telaio in più per il tuo Clowder e un decadimento più lento. Il Filo del telaio lega il tuo Clowder al tuo fianco. È la chiave di volta del vero Ritessere e la chiave delle due arene sigillate.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705F3.title: "Reliquia: Filo del telaio"
	quest.42000000002705F4.quest_desc: [
		"Il Bidone del Molo: un angolo del Molo stesso — un cortile di assi, uno stendino di teli, ceste di lana, un tappeto rosso.",
		"Quattro Fili sfilacciati e quattro lane intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705F4.title: "Totem: Il golem di lanugine"
	quest.42000000002705F5.quest_desc: [
		"L'unico scontro senza rischio. Il golem lancia palle di lanugine che accecano solo per un attimo e si nasconde dietro il bucato; batti il tappeto e lui starnutisce e barcolla. Insegna totem, arena e cancello.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705F5.title: "Rimettere in tensione: Il golem di lanugine"
	quest.42000000002705F6.quest_desc: [
		"Ciuffo di lanugine: immune al danno di cactus, bacche e siepi, e a essere spinto. Sbuffo acceca le creature vicine, così puoi fuggire.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705F6.title: "Reliquia: Ciuffo di lanugine"
	quest.42000000002705F7.quest_desc: [
		"Il Giardino di nodi: un'isola d'erba sotto quattro anelli di labirinto di siepi, con varchi e speroni, sentieri di ciottoli e anelli di nodi di corda appesi sopra.",
		"Quattro Filo sfilacciato e quattro foglie intorno a un Filato del vuoto.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705F7.title: "Totem: Il Groviglio"
	quest.42000000002705F8.quest_desc: [
		"Il ragno chiude i sentieri dietro di te con nodi di corda che chiedono tre colpi per tagliarli, e morde chi è solo in un vicolo cieco. Resta insieme nel labirinto. Facoltativo, a metà partita, un premio cosmetico.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705F8.title: "Rimettere in tensione: Il Groviglio"
	quest.42000000002705F9.quest_desc: [
		"Amuleto di nodo: niente rallentamento su ragnatela, sabbia delle anime, miele o neve polverosa, e metà dello scivolamento sul ghiaccio. Groviglio radica la prima creatura che colpisce.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705F9.title: "Reliquia: Amuleto di nodo"
	quest.42000000002705FA.quest_desc: [
		"Le due arene pazze aspettano dietro una porta che solo il Ritessere apre. I loro totem hanno bisogno della reliquia Filo del telaio nella griglia di fabbricazione e rispondono solo a un Clowder che ha chiuso il proprio cielo. I boss sono da dieci a venti volte la tua taglia. Porta tutti.",
		"Come: sistema tutti e nove i Fili, poi ritessi. Il progresso scatta quando il cielo si chiude."
	]
	quest.42000000002705FA.title: "La porta sigillata"
	quest.42000000002705FB.quest_desc: [
		"La Recisione: una grande scheggia di ossidiana attraversata dal Taglio luminoso, venti schegge del mondo alla deriva intorno, lacrime del vuoto verde acqua nell'aria.",
		"Filo sfilacciato e ossidiana intorno alla reliquia Filo del telaio; la reliquia viene restituita.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705FB.title: "Totem: Il Primo taglio"
	quest.42000000002705FC.quest_desc: [
		"Una forma che il Taglio ha lasciato sulla scheggia, non una confessione di chi ha vibrato il colpo. Ogni venti secondi taglia una linea attraverso la scheggia e i blocchi cadono per quindici secondi; la cucitura dà Velocità, ma il suo raggio segue la cucitura. Le schegge alla deriva schiacciano, le lacrime del vuoto tirano, e a un quinto della sua salute la scheggia si spacca in due lungo il Taglio. Solo dopo il Ritessere.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705FC.title: "Ridare la tensione: Il Primo taglio"
	quest.42000000002705FD.quest_desc: [
		"Scheggia del Primo taglio: taglia le fasi di guardia. Il meglio del pacchetto, riservato a chi ha superato.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705FD.title: "Reliquia: Scheggia del Primo taglio"
	quest.42000000002705FE.quest_desc: [
		"Il Telaio di sopra: un intreccio di purpur, nove ponti di Filo verso nove piattaforme a pilastri, ventisette fili di cattedrale fino a una chiave di volta a sessantaquattro blocchi d'altezza.",
		"Filo sfilacciato e purpur intorno alla reliquia Filo del telaio; la reliquia ti viene restituita.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.42000000002705FE.title: "Totem: Il Sovratessitore"
	quest.42000000002705FF.quest_desc: [
		"Il tuo stesso Telaio restaurato si è rivoltato contro di te. Il Sovratessitore scaglia le ombre dei nove guardiani sui loro Fili; uccidi un'ombra e il suo filo resta teso per venticinque secondi, e solo allora il Telaio stesso può essere ferito. Poi ne scaglia tre, infine tutti e nove.",
		"Come: usa il Totem sfilacciato corrispondente, poi vinci l'arena. Il progresso completa questo."
	]
	quest.42000000002705FF.title: "Ridare la tensione: Il Sovratessitore"
	quest.4200000000270600.quest_desc: [
		"Spola del Sovratessitore: un'eco di ogni reliquia di Filo in una sola, e ritesse un compagno di Clowder caduto.",
		"Uno per ogni membro di Clowder presente alla vittoria, dritto nell'inventario.",
		"Come: Codice dei Baffi, Guardiani spezzati — totem, arena, reliquia. Il totem risponde sulla piattaforma."
	]
	quest.4200000000270600.title: "Reliquia: Spola del Sovratessitore"
	quest.42000000002805E3.quest_desc: [
		"I corridori di piattaforma selvatici non compaiono su una piattaforma del vuoto. Suona il Rito del cancello su un Tamburo del cancello (usalo a mani vuote, colpisci i battiti su A, S, D, F) e cammina la Marca. I gialli pascolano nella Steppa e nella Palude di canne. Gli Altipiani pendono verso il grado Eccellente. I Campi di neve nascondono gradi Meravigliosi. Le Distese di brace tengono gli uccelli Fiamma.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: usa il Tamburo del cancello a mani vuote e suona il Rito del cancello: colpisci i battiti che cadono su A, S, D, F. Raggiungi il 60% e si apre; non serve il Polso. Lega prima una bussola del ritorno."
	]
	quest.42000000002805E3.title: "Cancello per la Marca"
	quest.42000000002805E4.quest_desc: [
		"Il Gysahl selvatico cresce nella Palude di canne, nella Steppa e sugli Altipiani, più fitto nella Palude. Raccoglierlo lascia anche semi, e Foglia della Marca o erba spezzate con una zappa ne danno di più. Pianta i semi a casa sul terreno agricolo.",
		"Come: raccogli Gysahl selvatico nella Marca (la Palude di canne è la più fitta). Raccogliere lascia anche semi; piantali a casa sul terreno agricolo."
	]
	quest.42000000002805E4.title: "Gysahl Green"
	quest.42000000002805E5.quest_desc: [
		"Un libro e una foglia di Gysahl. Usalo ovunque: le pagine elencano colore, grado, classe, vittorie in corsa e l'ultima noce di ciascuno dei tuoi uccelli.",
		"Come: un libro e un Gysahl. Usalo ovunque; le pagine elencano i tuoi uccelli."
	]
	quest.42000000002805E5.title: "Chocobo Almanac"
	quest.42000000002805E6.quest_desc: [
		"Dai Gysahl per addomesticare un giallo selvatico. Crea una sella con cuoio, spago e ferro, poi cavalca. Lo sprint parte in carica; molla per riprendere la resistenza.",
		"Come: cuoio, spago e ferro. Addomestica un giallo selvatico con Gysahl, poi sellalo."
	]
	quest.42000000002805E6.title: "Chocobo Saddle"
	quest.42000000002805E7.quest_desc: [
		"Pepite d'oro intorno a un orologio, con un Gysahl. Dandogli la carica, ti porta al Vento dei Baffi e indietro. Dopo che hai camminato la Marca, Esther sta anche nella Sala Clowder: cavalca un uccello sellato fino da lei, oppure chiedi alla Guida del Vento dei Baffi.",
		"Come: pepite d'oro intorno a un orologio, con un Gysahl. Usalo per caricarti fino al Vento dei Baffi e indietro; un uccello sellato viene con te."
	]
	quest.42000000002805E7.title: "Chocobo Pocketwatch"
	quest.42000000002805E8.quest_desc: [
		"Un'esca in mano attira gli uccelli selvatici e ne traccia il contorno attraverso un campo.",
		"Come: crea l'esca. Tienila per trovare i gialli della Marca."
	]
	quest.42000000002805E8.title: "Chocobo Lure"
	quest.42000000002805E9.quest_desc: [
		"Pianta i semi di Gysahl sul terreno agricolo. Un appezzamento a casa è come inizia la linea della fattoria.",
		"Come: raccogliere Gysahl selvatico lascia semi, e così fanno erba e Foglia della Marca spezzate con una zappa. Pianta sul terreno agricolo."
	]
	quest.42000000002805E9.title: "Gysahl Seeds"
	quest.42000000002805EA.quest_desc: [
		"Nutri due adulti di sesso opposto con una noce Carob. Due Gialli di grado Buono o migliore più Carob possono schiudersi in Verde o Blu. Ogni genitore ha bisogno di 5 primi posti vinti in Classe C; 16 insieme rendono il colore certo. Un Verde di grado Eccellente e un Blu di grado Eccellente, ciascuno con 8 primi di Classe B, si schiudono in Nero (se fallisce, è Bianco; 24 insieme per un tiro sicuro).",
		"Come: Bilo il guardiano delle noci, al Vento dei Baffi, vende Carob. Anche le gare di Classe A lo pagano."
	]
	quest.42000000002805EA.title: "Carob Nut"
	quest.42000000002805EB.quest_desc: [
		"Un verde a metà scala. Allena velocità, resistenza, intelligenza o cooperazione; l'uccello si sazia di ogni tipo.",
		"Come: il saggio Wynn, al Vento dei Baffi."
	]
	quest.42000000002805EB.title: "Verde Curiel"
	quest.42000000002805EC.quest_desc: [
		"Il verde d'addestramento più alto. Sali la scala quando l'uccello è sazio delle foglie più economiche.",
		"Come: il saggio Wynn al Vento dei Baffi, oppure un premio di gara di Classe S."
	]
	quest.42000000002805EC.title: "Verde Sylkis"
	quest.42000000002805ED.quest_desc: [
		"L'Oro non si schiude mai senza Zeio. Un Nero di grado Meraviglioso più un Giallo di grado Meraviglioso, ciascuno con 10 primi posti vinti in Classe A (32 insieme per un tiro sicuro).",
		"Come: Bilo il guardiano delle noci, al Vento dei Baffi, vende Zeio. Le gare di Classe S lo pagano di rado."
	]
	quest.42000000002805ED.title: "Zeio Nut"
	quest.42000000002805EE.quest_desc: [
		"GP vinti in pista. I banchi della Piazza prezzano tutto in GP.",
		"Come: piazzati tra i primi tre di una batteria al Vento dei Baffi. Cavalca un uccello sellato fino da Esther per iscriverti."
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"La prima noce di accoppiamento. Il talento segue la noce; il colore segue i genitori, salvo che entrino Carob o Zeio.",
		"Come: Bilo il guardiano delle noci, al Vento dei Baffi, vende Pepio. Anche una vittoria in Classe C può pagarlo."
	]
	quest.42000000002805EF.title: "Pepio Nut"
	quest.42000000002805F0.quest_desc: [
		"Due Gysahl e farina d'ossa. Il primo passo sopra i verdi semplici.",
		"Come: senza forma — due Gysahl e farina d'ossa."
	]
	quest.42000000002805F0.title: "Verde Krakka"
	quest.42000000002805F1.quest_desc: [
		"Il verde d'addestramento successivo. Facoltativo, quando la fattoria gira.",
		"Come: il saggio Wynn, oppure la ricetta elencata in JEI."
	]
	quest.42000000002805F1.title: "Verde Tantal"
	quest.42000000002805F2.quest_desc: [
		"Un altro verde d'addestramento. Facoltativo.",
		"Come: il saggio Wynn alla Piazza."
	]
	quest.42000000002805F2.title: "Verde Pahsana"
	quest.42000000002805F3.quest_desc: [
		"Un altro verde d'addestramento. Facoltativo.",
		"Come: il saggio Wynn alla Piazza."
	]
	quest.42000000002805F3.title: "Verde Mimett"
	quest.42000000002805F4.quest_desc: [
		"Un altro verde d'addestramento. Facoltativo.",
		"Come: il saggio Wynn alla Piazza."
	]
	quest.42000000002805F4.title: "Verde Reagan"
	quest.42000000002805F5.quest_desc: [
		"Una noce intermedia. Facoltativa.",
		"Come: Bilo il guardiano delle noci, al Vento dei Baffi, vende Luchile."
	]
	quest.42000000002805F5.title: "Luchile Nut"
	quest.42000000002805F6.quest_desc: [
		"Una noce intermedia. Facoltativa.",
		"Come: Bilo il guardiano delle noci, al Vento dei Baffi, vende Saraha."
	]
	quest.42000000002805F6.title: "Saraha Nut"
	quest.42000000002805F7.quest_desc: [
		"Una noce intermedia. Facoltativa.",
		"Come: Bilo il guardiano delle noci, al Vento dei Baffi, vende Lasan."
	]
	quest.42000000002805F7.title: "Lasan Nut"
	quest.42000000002805F8.quest_desc: [
		"Una noce di accoppiamento di metà-fine. Facoltativa. La vende Bilo il guardiano delle noci.",
		"Come: Bilo il guardiano delle noci, al Vento dei Baffi, vende Pram."
	]
	quest.42000000002805F8.title: "Pram Nut"
	quest.42000000002805F9.quest_desc: [
		"Il banco della Fiera al Vento dei Baffi vende fuochi d'artificio, guinzagli, orologi da tasca e l'Almanacco Chocobo in cambio di GP.",
		"Come: carta più polvere da sparo. Scoppio facoltativo."
	]
	quest.42000000002805F9.title: "Fuochi della Fiera"
	quest.42000000002805FA.quest_desc: [
		"Una noce di accoppiamento tardiva. Facoltativa.",
		"Come: Bilo il guardiano delle noci, al Vento dei Baffi, vende Porov."
	]
	quest.42000000002805FA.title: "Porov Nut"
	quest.42000000002905FB.quest_desc: [
		"Il vuoto non ha mai fatto crescere i cespugli di Pam's. Setaccia la terra con una maglia di spago. Rompi il giardino per semi aridi — peperoncino, mais, frutto di cactus.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: setaccia la terra con una maglia di spago o meglio (Ex Deorum o il Telaio del vuoto)."
	]
	quest.42000000002905FB.title: "Arid Garden"
	quest.42000000002905FC.quest_desc: [
		"Colture da freddo, dalla stessa terra. Rompi il cespuglio; pianta ciò che ti serve.",
		"Come: setaccia la terra con una maglia di spago o meglio."
	]
	quest.42000000002905FC.title: "Frost Garden"
	quest.42000000002905FD.quest_desc: [
		"Colture sotto la foglia. Lo stesso setaccio, un altro cespuglio.",
		"Come: setaccia la terra con una maglia di spago o meglio."
	]
	quest.42000000002905FD.title: "Shaded Garden"
	quest.42000000002905FE.quest_desc: [
		"Colture umide. Il riso e il resto dei semi dall'animo di palude vivono qui.",
		"Come: setaccia la terra con una maglia di spago o meglio."
	]
	quest.42000000002905FE.title: "Soggy Garden"
	quest.42000000002905FF.quest_desc: [
		"Colture calde. Tieni un cespuglio in una cassa; si diffondono lo stesso, se li pianti.",
		"Come: setaccia la terra con una maglia di spago o meglio."
	]
	quest.42000000002905FF.title: "Tropical Garden"
	quest.4200000000290600.quest_desc: [
		"L'ultimo dei sei. Ogni seme di HarvestCraft sulla piattaforma inizia come uno di questi cespugli.",
		"Come: setaccia la terra con una maglia di spago o meglio."
	]
	quest.4200000000290600.title: "Windy Garden"
	quest.4200000000290601.quest_desc: [
		"Non è il tagliere di Farmer's Delight. Rame, un bastone e un'asse. Prepara frutta e verdura prima che finiscano in pentola.",
		"Come: rame, un bastone e un'asse. Non il tagliere di Farmer's Delight."
	]
	quest.4200000000290601.title: "Bacheca del raccolto"
	quest.4200000000290602.quest_desc: [
		"Zuppe, stufati e brodo. Rame e un bastone. La pentola torna dopo ogni fabbricazione.",
		"Come: rame e un bastone. La pentola torna dopo ogni cottura senza forma."
	]
	quest.4200000000290602.title: "Pentola del raccolto"
	quest.4200000000290603.quest_desc: [
		"Piatti in padella. Rame e bastoni. Fabbricazione diversa dalla padella Delight; JEI li distingue.",
		"Come: rame e bastoni. Diversa dalla padella Delight."
	]
	quest.4200000000290603.title: "Padella del raccolto"
	quest.4200000000290604.quest_desc: [
		"Salse e riduzioni. Rame e un bastone. Tienilo accanto alla pentola.",
		"Come: rame e un bastone."
	]
	quest.4200000000290604.title: "Saucepan"
	quest.4200000000290605.quest_desc: [
		"Anello di terracotta. Torte, pani e tutto ciò che vuole una forma da forno.",
		"Come: otto terracotta intorno a un centro vuoto."
	]
	quest.4200000000290605.title: "Bakeware"
	quest.4200000000290606.quest_desc: [
		"Assi e un bastone. Pastelle, impasti e insalate. La postazione quieta.",
		"Come: assi e un bastone."
	]
	quest.4200000000290606.title: "Mixing Bowl"
	quest.4200000000290607.quest_desc: [
		"Terracotta. Frutta dentro, succo fuori. Abbinalo a un albero, non a un orto.",
		"Come: terracotta. Quattro a T."
	]
	quest.4200000000290607.title: "Juicer"
	quest.4200000000290608.quest_desc: [
		"Bastoni e un tronco. Stendi l'impasto. Lo stampo aspetta.",
		"Come: bastoni ai due lati di un tronco."
	]
	quest.4200000000290608.title: "Rullo"
	quest.4200000000290609.quest_desc: [
		"Sassolini di andesite da un setaccio di selce, poi un bastone. Farina, spezie, paste.",
		"Come: andesite (sassolini di terra o ghiaia dal setaccio di selce) e un bastone."
	]
	quest.4200000000290609.title: "Grinder"
	quest.420000000029060A.quest_desc: [
		"Un secchio d'acqua diviso in otto. Quasi tutte le ricette vogliono questo, non un secchio vanilla.",
		"Come: un secchio d'acqua → otto acqua dolce."
	]
	quest.420000000029060A.title: "Fresh Water"
	quest.420000000029060B.quest_desc: [
		"Niente mucche sulla piattaforma. Cocco (terra con maglia di ferro) più acqua dolce, oppure dividi un secchio di latte più tardi.",
		"Come: cocco (terra con maglia di ferro) più acqua dolce, oppure dividi un secchio di latte."
	]
	quest.420000000029060B.title: "Fresh Milk"
	quest.420000000029060C.quest_desc: [
		"Acqua in una pentola, o una macinata. Quasi ogni ricetta salata lo chiede.",
		"Come: pentola più acqua o acqua dolce. La pentola torna."
	]
	quest.420000000029060C.title: "Salt"
	quest.420000000029060D.quest_desc: [
		"Grano nel macinatore. L'impasto inizia qui.",
		"Come: macinatore più grano (o un'altra pianta da farina). Il macinatore torna."
	]
	quest.420000000029060D.title: "Flour"
	quest.420000000029060E.quest_desc: [
		"Farina, sale e acqua dolce. Torte e pani condividono questo panetto.",
		"Come: ciotola, farina, acqua, sale."
	]
	quest.420000000029060E.title: "Dough"
	quest.420000000029060F.quest_desc: [
		"Ossa o verdure nella pentola. Le zuppe vogliono una bottiglia di questo, non un brodo vago.",
		"Come: pentola più un osso (i Custodi della piattaforma vendono ossa) o verdure avanzate."
	]
	quest.420000000029060F.title: "Stock"
	quest.4200000000290610.quest_desc: [
		"Terra con maglia di ferro. Fallo crescere sulla piattaforma; la quercia vanilla non lascia cadere le mele di Pam's.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.4200000000290610.title: "Melo"
	quest.4200000000290611.quest_desc: [
		"Acido per i condimenti e il pesce. Lo stesso setaccio di ferro.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.4200000000290611.title: "Albero di limone"
	quest.4200000000290612.quest_desc: [
		"Spezia di corteccia. Dolci al forno e tè.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.4200000000290612.title: "Albero di cannella"
	quest.4200000000290613.quest_desc: [
		"Latte, olio e cucina tropicale.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.4200000000290613.title: "Palma da cocco"
	quest.4200000000290614.quest_desc: [
		"Baccelli per i dolci. Piantala come le altre.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.4200000000290614.title: "Rampicante di vaniglia"
	quest.4200000000290615.quest_desc: [
		"Il melo di Pam's dà mele semplici, molte più di quante ne lasciano le foglie di quercia. Spremiagrumi e stampo le vogliono entrambi.",
		"Come: le foglie di quercia ne fanno cadere poche; un melo Pam's (arboscello da terra a maglia di ferro) ne porta molte."
	]
	quest.4200000000290615.title: "Mela di Pam's"
	quest.4200000000290616.quest_desc: [
		"Stampo, impasto, zucchero, mele. Il primo dolce finito di HarvestCraft.",
		"Come: stampo, impasto, zucchero, mele di Pam's dal melo."
	]
	quest.4200000000290616.title: "Torta di mele (Raccolto)"
	quest.4200000000290617.quest_desc: [
		"Spremiagrumi più frutta mista. Una bevanda della piattaforma che non è succo di anguria.",
		"Come: spremitore e frutta mista."
	]
	quest.4200000000290617.title: "Fruit Punch"
	quest.4200000000290618.quest_desc: [
		"Padella, pane, formaggio. Un pranzo veloce mentre gli alberi crescono.",
		"Come: padella, pane, burro e formaggio — tutto da acqua dolce, latte di cocco e farina."
	]
	quest.4200000000290618.title: "Grilled Cheese"
	quest.4200000000290619.quest_desc: [
		"Peperoncini aridi, pomodoro, cipolla, fagiolo, foglia di spezia e carne o tofu setoso. Food Extended comincia a rendersi utile.",
		"Come: pentola, peperoncino arido, pomodoro, cipolla, fagiolo, foglia di spezia e carne o tofu setoso."
	]
	quest.4200000000290619.title: "Ciotola di chili"
	quest.420000000029061A.quest_desc: [
		"Spezie dal macinino, verdura dai giardini, lavoro di pentola.",
		"Come: pentolino, riso, cocco, peperoncino, pepe nero, curry in polvere (foglia di spezia + senape + cannella)."
	]
	quest.420000000029061A.title: "Piatto di curry"
	quest.420000000029061B.quest_desc: [
		"Impasto, salsa, carne. Stampo. Un pasto HarvestCraft completo.",
		"Come: stampo, impasto, pomodoro, formaggio, pepperoni (bacon di maiale, o bacon di tofu da acero + soia)."
	]
	quest.420000000029061B.title: "Pepperoni Pizza"
	quest.420000000029061C.quest_desc: [
		"Riso del giardino fradicio, carota, cipolla, piselli e un uovo — il tofu setoso fa le veci dell'uovo finché non ci sono galline.",
		"Come: padella, riso del giardino fradicio, carota, cipolla, piselli e un uovo — il tofu setoso conta come uovo."
	]
	quest.420000000029061C.title: "Riso fritto dell'orto"
	quest.420000000029061D.quest_desc: [
		"Foglia di tè e foglia di spezia nella pentola. Il giardino ombroso e quello fradicio coprono entrambi.",
		"Come: pentola, foglia di tè e foglia di spezia. Il giardino ombroso lascia cadere tè e spezia."
	]
	quest.420000000029061D.title: "Green Tea"
	quest.420000000029061E.quest_desc: [
		"Olio e frutto sapido. Presa facoltativa della maglia di ferro.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.420000000029061E.title: "Ulivo"
	quest.420000000029061F.quest_desc: [
		"Succo e scorza. Facoltativo.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.420000000029061F.title: "Arancio"
	quest.4200000000290620.quest_desc: [
		"Frutto d'estate. Facoltativo.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.4200000000290620.title: "Pesco"
	quest.4200000000290621.quest_desc: [
		"Pepe per il macinino. Facoltativo.",
		"Come: setaccia la terra con una maglia di ferro per piantine da cucina, poi coltiva il frutto."
	]
	quest.4200000000290621.title: "Albero del pepe"
	quest.4200000000290622.quest_desc: [
		"Grasso per friggere. Base facoltativa.",
		"Come: pressa i semi o le olive in JEI. Base facoltativa."
	]
	quest.4200000000290622.title: "Cooking Oil"
	quest.4200000000290623.quest_desc: [
		"Latte e sale. Base facoltativa.",
		"Come: pentola e latte (va bene il latte di cocco con acqua dolce)."
	]
	quest.4200000000290623.title: "Butter"
	quest.4200000000290624.quest_desc: [
		"Un uovo nello spremitore. Facoltativo.",
		"Come: spremitore e un uovo (il tofu setoso conta). Facoltativo."
	]
	quest.4200000000290624.title: "Mayonnaise"
	quest.4200000000290625.quest_desc: [
		"Tagliere, frutta mista. Facoltativo.",
		"Come: tagliere e frutta mista. Facoltativo."
	]
	quest.4200000000290625.title: "Fruit Salad"
	quest.4200000000290626.quest_desc: [
		"Serata di pasta. Facoltativo.",
		"Come: i giardini e gli alberi da frutto danno gli ingredienti. Il tofu di soia sostituisce carne e uovo. JEI dice la stazione."
	]
	quest.4200000000290626.title: "Cena di spaghetti"
	quest.4200000000290627.quest_desc: [
		"Colazione per metterti in mostra. Facoltativo.",
		"Come: i giardini e gli alberi da frutto danno gli ingredienti. Il tofu di soia sostituisce carne e uovo. JEI dice la stazione."
	]
	quest.4200000000290627.title: "Bacon Pancakes"
	quest.4200000000290628.quest_desc: [
		"Terra con maglia di ferro per una piantina di avocado, poi padella, toast, sale, aglio, foglia di spezia.",
		"Come: piantina di avocado dalla maglia di ferro, poi padella con toast, sale, aglio, foglia di spezia."
	]
	quest.4200000000290628.title: "Avocado Toast"
	quest.4200000000290629.quest_desc: [
		"Non è l'hamburger di Delight. Facoltativo.",
		"Come: i giardini e gli alberi da frutto danno gli ingredienti. Il tofu di soia sostituisce carne e uovo. JEI dice la stazione."
	]
	quest.4200000000290629.title: "Burger alla cipolla"
	quest.420000000029062A.quest_desc: [
		"Spremitore, mele. Facoltativo.",
		"Come: spremitore e mele di Pam's. Facoltativo."
	]
	quest.420000000029062A.title: "Apple Juice"
	quest.420000000029062B.quest_desc: [
		"Padella, pane e burro. Facoltativo.",
		"Come: padella, pane e burro. Facoltativo."
	]
	quest.420000000029062B.title: "Fetta di toast"
	quest.42000000002A062C.quest_desc: [
		"Quattro bastoni in quadrato. Mettili sul terreno coltivato. I semi del gioco base si convertono quando li pianti — quelli di Mystical Agriculture, no.",
		"Metti un secondo gruppo di bastoni nello stesso blocco per fare una coltura incrociata — una coppia vuota che prende da ciò che è maturo accanto. Circondala di genitori sui quattro lati e si semina da sola in pochi minuti; la farina d'ossa sull'incrocio forza un tentativo subito.",
		"Le Nove Tribù hanno lasciato provviste per il prossimo Clowder. Usa una scorta del custode per aprire rifornimenti a caso, o fabbrica quattro scorte piccole in una media e tre medie in una grande. I sigilli più grandi hanno più tiri e una riserva più ampia; aprirli separatamente dà più rifornimenti di base. Dentro non si nascondono macchine né gettoni di progresso, ma ogni sigillo ha una piccola probabilità di una Scheggia di Filo e una molto piccola di un Filo del ritorno intero; i sigilli più grandi hanno probabilità migliori.",
		"Come: quattro bastoni in quadrato. Mettili sul terreno coltivato, poi pianta un seme."
	]
	quest.42000000002A062C.title: "Bastoni da coltura di legno"
	quest.42000000002A062D.quest_desc: [
		"Un libro e penna (libro, sacca d'inchiostro, piuma) più semi di grano. Tienilo nell'analizzatore.",
		"Come: libro e penna (libro, sacca d'inchiostro, piuma) più semi di grano. Carbone di legna più una bottiglia di vetro fanno l'inchiostro."
	]
	quest.42000000002A062D.title: "Diario delle colture"
	quest.42000000002A062E.quest_desc: [
		"Lastra di vetro e bastoni. Guarda una coltura per leggere crescita, resa e forza senza raccoglierla.",
		"Come: lastra di vetro tra i bastoni, poi un manico di bastone. Guarda una coltura piantata."
	]
	quest.42000000002A062E.title: "Magnifying Glass"
	quest.42000000002A062F.quest_desc: [
		"Vetro, lastra di pietra, assi, bastoni. Metti un seme con il diario. L'incrocio diventa visibile.",
		"La fertilità è la statistica che guida l'incrocio: un seme nuovo sta a 1 su 10, e ogni punto alza la probabilità che una pianta sia scelta come genitore. Analizza, ripianta le migliori, e gli incroci arrivano prima.",
		"Come: lastre di vetro, lastra di pietra, assi e bastoni. Inserisci il diario, poi un seme."
	]
	quest.42000000002A062F.title: "Seed Analyzer"
	quest.42000000002A0630.quest_desc: [
		"Le erbacce sono spente in questo pacchetto, ma il rastrello toglie comunque un bastone. Portane uno lo stesso.",
		"Come: staccionata di legno sopra un bastone. Le erbacce sono spente; toglie comunque un bastone."
	]
	quest.42000000002A0630.title: "Rastrello di legno"
	quest.42000000002A0631.quest_desc: [
		"Raccogli una pianta e rimettila giù con le statistiche intatte. Sposta un 10-10 senza romperlo.",
		"Come: due lingotti di ferro e un bastone. Raccogli una pianta con le statistiche intatte."
	]
	quest.42000000002A0631.title: "Paletta"
	quest.42000000002A0632.quest_desc: [
		"Pota una pianta matura per il prodotto del taglio e azzerala. Fiori e alcune colture di HarvestCraft.",
		"Come: cesoie, ferro e un bastone. Pota una pianta matura e azzerala."
	]
	quest.42000000002A0632.title: "Cimatrice"
	quest.42000000002A0633.quest_desc: [
		"Porta una linea di incrocio. Riempila dall'analizzatore, svuotala sui bastoni.",
		"Come: cuoio e spago. Riempi dall'analizzatore."
	]
	quest.42000000002A0633.title: "Borsa dei semi"
	quest.42000000002A0634.quest_desc: [
		"Bastoni più robusti. Stesse regole di piantagione, meno fastidio se li urti.",
		"Come: due pepite di ferro in colonna ne fanno otto."
	]
	quest.42000000002A0634.title: "Iron Crop Sticks"
	quest.42000000002A0635.quest_desc: [
		"Il rastrello migliorato. Resta un'abitudine, anche senza erbacce.",
		"Come: sbarre di ferro sopra un bastone."
	]
	quest.42000000002A0635.title: "Rastrello di ferro"
	quest.42000000002A0636.quest_desc: [
		"Tiene l'acqua per i canali. Una fattoria sulla piattaforma che non porta secchi ogni mattina.",
		"Come: assi. Tiene l'acqua per i canali."
	]
	quest.42000000002A0636.title: "Irrigation Tank"
	quest.42000000002A0637.quest_desc: [
		"Fai correre l'acqua dal serbatoio lungo la fila. Le colture bevono dal canale, non da te.",
		"Come: senza forma, da un serbatoio — un serbatoio diventa otto canali."
	]
	quest.42000000002A0637.title: "Irrigation Channel"
	quest.42000000002A0638.quest_desc: [
		"Ferma e avvia una linea senza rompere il serbatoio.",
		"Come: sbarre di ferro, tintura rossa e un lingotto di ferro. Ferma e avvia una linea senza rompere il serbatoio."
	]
	quest.42000000002A0638.title: "Channel Valve"
	quest.42000000002A0639.quest_desc: [
		"Pioggia in un quadrato. Mettilo su un canale, sopra i bastoni.",
		"Come: mettilo su un canale, sopra i bastoni. JEI indica la ricetta."
	]
	quest.42000000002A0639.title: "Sprinkler"
	quest.42000000002A063A.quest_desc: [
		"Copri un canale per poter camminare lungo la fila.",
		"Come: copri un canale per poter camminare lungo la fila."
	]
	quest.42000000002A063A.title: "Grata del canale"
	quest.42000000002A063B.quest_desc: [
		"Leggi la stanza. Luce, umidità, il motivo per cui una coltura si è fermata.",
		"Come: fabbricalo, poi mettilo nella stanza per leggere luce e umidità."
	]
	quest.42000000002A063B.title: "Greenhouse Monitor"
	quest.42000000002A063C.quest_desc: [
		"Bastoni tardivi. Ignifughi, testardi, per le piante che chiedono troppo al legno. Due colture mature vicine possono incrociarsi.",
		"Come: due ossidiane in colonna ne fanno otto. Due colture mature vicine possono incrociarsi."
	]
	quest.42000000002A063C.title: "Obsidian Crop Sticks"
	quest.42000000002A063D.quest_desc: [
		"Un canale su cui puoi camminare. Facoltativo.",
		"Come: un canale su cui puoi camminare. Facoltativo."
	]
	quest.42000000002A063D.title: "Canale cavo"
	quest.42000000002A063E.quest_desc: [
		"Le colture di minerale rilasciano questi. Linea di incrocio facoltativa.",
		"Come: bastoni da coltura di legno dai bastoni; il diario è un libro e penna più semi; l'analizzatore è vetro e legno. Pianta sul terreno coltivato."
	]
	quest.42000000002A063E.title: "Coltura di pepita di rame"
	quest.42000000002A063F.quest_desc: [
		"Quarzo da un bastone. Facoltativo.",
		"Come: bastoni da coltura di legno dai bastoni; il diario è un libro e penna più semi; l'analizzatore è vetro e legno. Pianta sul terreno coltivato."
	]
	quest.42000000002A063F.title: "Coltura di scheggia di quarzo"
	quest.42000000002A0640.quest_desc: [
		"Combustibile da una coltura. Facoltativo.",
		"Come: bastoni da coltura di legno dai bastoni; il diario è un libro e penna più semi; l'analizzatore è vetro e legno. Pianta sul terreno coltivato."
	]
	quest.42000000002A0640.title: "Coal Pebble"
	quest.42000000002A0641.quest_desc: [
		"Coltura di minerale tardiva. Facoltativa.",
