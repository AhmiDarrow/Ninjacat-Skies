{
	chapter.3100000000000001.chapter_subtitle: [
		"깨어남 — 살아남고, 공중섬을 차지하고, 코덱스가 깨어나게 하세요."
	]
	chapter.3100000000000001.title: "가닥: 토양"
	chapter.3100000000000002.chapter_subtitle: [
		"수복 — 무너진 세계를 다시 물질로 끌어들이세요."
	]
	chapter.3100000000000002.title: "가닥: 돌"
	chapter.3100000000000003.chapter_subtitle: [
		"뿌리 — 닻을 키워 공중섬이 더 해어지지 않게 하세요."
	]
	chapter.3100000000000003.title: "가닥: 싹"
	chapter.3100000000000004.chapter_subtitle: [
		"가장자리 — 장비를 챙기고 일부러 공중섬을 떠나세요."
	]
	chapter.3100000000000004.title: "가닥: 발톱"
	chapter.3100000000000005.chapter_subtitle: [
		"웅웅 — 전선보다 먼저, 리듬과 파동이에요."
	]
	chapter.3100000000000005.title: "가닥: 불꽃"
	chapter.3100000000000006.chapter_subtitle: [
		"무늬 — 스스로 이어 가는 노래 같은 공장이에요."
	]
	chapter.3100000000000006.title: "가닥: 시계"
	chapter.3100000000000007.chapter_subtitle: [
		"군락 — 다른 것을 살리는 것을 살리세요."
	]
	chapter.3100000000000007.title: "가닥: 무리"
	chapter.3100000000000008.chapter_subtitle: [
		"묶기 — 인장, 의식, 그리고 한 끈 속의 땋은 길 둘이에요."
	]
	chapter.3100000000000008.title: "가닥: 인장"
	chapter.3100000000000009.chapter_subtitle: [
		"다시 짜기 — 디지털 베틀, 변경, 파편이에요."
	]
	chapter.3100000000000009.title: "가닥: 물레"
	chapter.310000000000000A.title: "깊은 체"
	chapter.310000000000000B.title: "보관과 배낭"
	chapter.310000000000000C.title: "Mekanism 작업장"
	chapter.310000000000000D.title: "Powah 전력망"
	chapter.310000000000000E.title: "비전 쪽"
	chapter.310000000000000F.chapter_subtitle: [
		"팀, 회관, 기둥, 그리고 해어짐."
	]
	chapter.310000000000000F.title: "Clowder 회관"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "주방 라인"
	chapter.3100000000000013.title: "전투 마법"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "공중섬 장식"
	chapter.3100000000000016.title: "네더 발판"
	chapter.3100000000000017.title: "엔드 발판"
	chapter.3100000000000018.title: "정수 밭"
	chapter.3100000000000019.chapter_subtitle: [
		"모든 둥지는 꽃 둘레에 무언가가 고리로 놓인 거예요."
	]
	chapter.3100000000000019.title: "무리 양봉장"
	chapter.310000000000001A.title: "배관"
	chapter.310000000000001B.title: "이세계"
	chapter.310000000000001C.title: "깊은 시계장치"
	chapter.310000000000001D.title: "물레 망"
	chapter.310000000000001E.title: "공허 공예"
	chapter.310000000000001F.title: "포장 라인"
	chapter.3100000000000020.title: "QIO와 Mek 정상"
	chapter.3100000000000021.title: "사냥과 농사"
	chapter.3100000000000022.title: "부족 직조"
	chapter.3100000000000023.chapter_subtitle: [
		"자갈 가수는 돌 하나를 백 가지로 잘라요."
	]
	chapter.3100000000000023.title: "석공"
	chapter.3100000000000024.chapter_subtitle: [
		"공중섬은 누군가 의자를 놓기 전까지는 그저 턱이에요."
	]
	chapter.3100000000000024.title: "가구"
	chapter.3100000000000025.chapter_subtitle: [
		"청지기들이 두고 간 작은 기계예요."
	]
	chapter.3100000000000025.title: "작은 청지기실"
	chapter.3100000000000026.chapter_subtitle: [
		"북심장의 파동이 구리 속을 달리는 법을 배워요."
	]
	chapter.3100000000000026.title: "전류"
	chapter.3100000000000027.chapter_subtitle: [
		"절단이 수호자 열셋을 끊어 버렸어요. 각 가닥의 수호자를 이겨 장력을 다시 거세요."
	]
	chapter.3100000000000027.title: "끊긴 수호자"
	chapter.3100000000000028.chapter_subtitle: [
		"변경을 걸으세요. 노란 놈을 길들이세요. 그곳에 다녀오면 Esther가 회관에서 기다려요."
	]
	chapter.3100000000000028.title: "공중섬 주자"
	chapter.3100000000000029.chapter_subtitle: [
		"체에서 온 밭이에요. 공허의 공중섬이 한 번도 기르지 못한 것을 요리하세요."
	]
	chapter.3100000000000029.title: "수확 상"
	chapter.310000000000002A.chapter_subtitle: [
		"작물 막대, 능력치, 관개. 바위턱에서는 잡초가 자리 잡지 못해요."
	]
	chapter.310000000000002A.title: "작물 막대"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "제작과 장력"
	chapter_group.2100000000000003.title: "다시 짜다"
	chapter_group.2100000000000004.title: "곁길"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"바위턱에서 깨어났어요. 낭떠러지를 본 다음, 여기를 클릭하세요.",
		"그레이브(`)는 과제 목록이에요. 수염 코덱스는 여기서 시작이에요.",
		"방법: 퀘스트를 클릭하세요. 그다음 참나무를 치세요."
	]
	quest.4200000000018001.title: "낭떠러지 보기"
	quest.4200000000010001.quest_desc: [
		"당신은 Skybound예요. 이건 떨어지지 않은 것이에요.",
		"원목 여덟. 나무부터 시작하세요. 먼저 시작한 건 나무예요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 공중섬의 참나무를 치세요. 원목 여덟이 깨어남을 시작해요."
	]
	quest.4200000000010001.title: "공중섬에서 깨어나기"
	quest.4200000000010002.quest_desc: [
		"흙은 공중섬이 당신 부츠에게 하는 약속이에요.",
		"블록 열여섯. 약속을 넓히세요.",
		"방법: 시작 상자, 조약돌+실 소모 제작, 체의 남은 것, 또는 /clowder hub (공중섬 지킴이)."
	]
	quest.4200000000010002.title: "발을 디딜 곳"
	quest.4200000000010003.quest_desc: [
		"손에는 작업면이 필요해요. 이 다음의 모든 것도 작업면이에요.",
		"방법: 판자 넷을 정사각형으로."
	]
	quest.4200000000010003.title: "작업대 만들기"
	quest.4200000000010004.quest_desc: [
		"발톱은 나중이에요. 지금은 무는 나무.",
		"방법: 판자 셋을 막대 둘 위에."
	]
	quest.4200000000010004.title: "나무 곡괭이"
	quest.4200000000010005.quest_desc: [
		"낭떠러지를 향한 초록.",
		"배고파지기 전에 심으세요.",
		"방법: 참나무 잎을 부수거나 /clowder hub 뿌리묶이 (실 8로 넷)."
	]
	quest.4200000000010005.title: "첫 묘목"
	quest.4200000000010006.quest_desc: [
		"판자가 예순넷이면 공중섬이 더는 바위턱처럼 느껴지지 않아요.",
		"방법: 제작 칸에 원목 하나면 넷이 돼요."
	]
	quest.4200000000010006.title: "판자 비축"
	quest.4200000000010007.quest_desc: [
		"손잡이, 틀, 도구의 뼈.",
		"방법: 판자 둘을 세로로."
	]
	quest.4200000000010007.title: "막대 묶음"
	quest.4200000000010008.quest_desc: [
		"물건은 머무는 곳에 두세요. Clowder는 다른 무엇보다 먼저 상자를 나눠요.",
		"방법: 빈 가운데 둘레에 판자 여덟."
	]
	quest.4200000000010008.title: "Clowder를 위한 상자"
	quest.4200000000010009.quest_desc: [
		"가장자리가 당신을 보기 전에 가장자리를 보세요.",
		"방법: 석탄이나 숯을 막대 위에. /clowder hub 의 친족이 한 묶음을 팔아요."
	]
	quest.4200000000010009.title: "횃불 줄"
	quest.420000000001000A.quest_desc: [
		"얼음과 용암이 없던 곳에 돌을 만들어요.",
		"보통과 어려움 공중섬은 둘 다 실어 와요. /clowder hub 의 공중섬 지킴이가 양동이를 팔아요.",
		"방법: 물 옆에 용암(또는 얼음을 녹이기). 돌을 망치로 치세요. /clowder hub 의 자갈 가수 좌판이 묶음을 팔아요."
	]
	quest.420000000001000A.title: "조약돌 비축"
	quest.420000000001000B.quest_desc: [
		"아직 불꽃이 아닌 온기.",
		"공중섬 지킴이라면 이것을 화로라 불렀을 거예요.",
		"방법: 빈 가운데 둘레에 조약돌 여덟."
	]
	quest.420000000001000B.title: "화로의 열"
	quest.420000000001000C.quest_desc: [
		"허기는 부드러운 공허예요. 빵 여덟 개가 한동안 그것을 닫아요.",
		"방법: 밀 셋을 한 줄로. 또는 /clowder hub 화로 지킴이."
	]
	quest.420000000001000C.title: "식사 짓기"
	quest.420000000001000D.quest_desc: [
		"용암을 놓고, 얼음을 수원으로 녹이고, 양동이를 채우세요.",
		"쉬움은 물을 실어 오고, 보통과 어려움은 조각을 실어 와요.",
		"방법: 빈 양동이를 수원에. 보통/어려움: 용암을 놓고, 얼음을 녹이고, 채우세요."
	]
	quest.420000000001000D.title: "비를 받다"
	quest.420000000001000E.quest_desc: [
		"아직 버티는 베틀의 자투리. 모든 퀘스트가 조금 돌려줘요.",
		"하나를 풀어 끈으로 하거나, /clowder hub 의 친족 좌판에서 쓰세요.",
		"방법: 퀘스트 보상, 베틀 틀 위의 부싯돌 망 흙, 청지기 보관함."
	]
	quest.420000000001000E.title: "해진 화폐"
	quest.420000000001000F.quest_desc: [
		"손상됐지만 아직 가르쳐요. 여기서 시작을 여세요.",
		"책을 우클릭하고 여기서 시작을 여세요. 그레이브(`): 과제 목록.",
		"방법: 시작 키트 / 부두 상자. 책을 우클릭하면 그레이브(`)가 과제 목록이에요."
	]
	quest.420000000001000F.title: "손에 든 코덱스"
	quest.4200000000010010.quest_desc: [
		"스폰 지점을 정하세요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010010.title: "침대 확보"
	quest.4200000000010011.quest_desc: [
		"밧줄 없이 깊은 곳으로 내려가세요. 어느 갱도에든 두고 올 만큼 싸요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010011.title: "내려가는 사다리"
	quest.4200000000010012.quest_desc: [
		"나중 망을 위해 아껴 둔 거미줄. 어느 섬유든 결국 쓰여요.",
		"방법: 해진 실을 풀어요 (1 → 3). 거미. 메아리 결속에서 베틀 보풀. 털실 역소모."
	]
	quest.4200000000010012.title: "끈 비축"
	quest.4200000000010013.quest_desc: [
		"초록을 재촉하세요.",
		"방법: 뼈를 격자에 넣거나, 실 + 썩은 살점 소모, 또는 /clowder hub 공중섬 지킴이."
	]
	quest.4200000000010013.title: "뼛가루 비축"
	quest.4200000000010014.quest_desc: [
		"공중섬을 넓히세요.",
		"방법: 시작 상자, 조약돌+실 소모 제작, 체의 남은 것, 또는 /clowder hub (공중섬 지킴이)."
	]
	quest.4200000000010014.title: "흙 공중섬"
	quest.4200000000010015.quest_desc: [
		"지금은 다듬고, 나중엔 퇴비로 하세요. 공중섬에선 버리는 게 없어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010015.title: "참나무 잎"
	quest.4200000000010016.quest_desc: [
		"조용한 구석.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010016.title: "화분"
	quest.4200000000010017.quest_desc: [
		"Ex Deorum 의 통. 퇴비, 그리고 물은 천천히 점토로.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010017.title: "통"
	quest.4200000000010018.quest_desc: [
		"쓰레기를 가루로.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010018.title: "퇴비통"
	quest.4200000000010019.quest_desc: [
		"한 줄을 긁으세요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010019.title: "나무 괭이"
	quest.420000000001001A.quest_desc: [
		"맨손보다 빨리 원목을 베요. Skybound 가 갖는 첫 진짜 도구예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001001A.title: "나무 도끼"
	quest.420000000001001B.quest_desc: [
		"흙과 자갈을 다듬은 땅으로 바꿔요. 느리지만 통해요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001001B.title: "나무 삽"
	quest.420000000001001C.quest_desc: [
		"좀비를 겨우 막지만, 막기는 해요. 주먹을 휘두르는 것보다 나아요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001001C.title: "나무 검"
	quest.420000000001001D.quest_desc: [
		"수프와 스튜, 그 정도만 담겨요. 단순한 공중섬에 단순한 그릇이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001001D.title: "그릇"
	quest.420000000001001E.quest_desc: [
		"공중섬에 표식을 다세요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001001E.title: "아이템 액자"
	quest.420000000001001F.quest_desc: [
		"집으로 만드세요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001001F.title: "그림"
	quest.4200000000010020.quest_desc: [
		"바람과 몹을 벽의 올바른 쪽에 둬요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010020.title: "참나무 문"
	quest.4200000000010021.quest_desc: [
		"시야를 막지 않고 가장자리를 표시해요. 떨어지면 진짜인 곳에서 쓸모 있어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010021.title: "참나무 울타리"
	quest.4200000000010022.quest_desc: [
		"깎아지른 벽을 정말로 오를 수 있는 것으로 바꿔요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010022.title: "참나무 계단"
	quest.4200000000010023.quest_desc: [
		"반 블록, 바닥 선택은 두 배. 좁은 곳에서 쓸모 있어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010023.title: "참나무 반 블록"
	quest.4200000000010024.quest_desc: [
		"출입용 다락문.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010024.title: "참나무 다락문"
	quest.4200000000010025.quest_desc: [
		"무언가가 밟으면 신호가 나가요. 문은 저절로 열려요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010025.title: "참나무 압력판"
	quest.4200000000010026.quest_desc: [
		"레드스톤 짧은 신호용 버튼.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010026.title: "참나무 버튼"
	quest.4200000000010027.quest_desc: [
		"공중섬 가장자리에 울타리를 치세요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010027.title: "막대 울타리 문"
	quest.4200000000010028.quest_desc: [
		"음식을 천천히 익히고, 연기는 멀리까지 보여요.",
		"방법: 원목, 막대, 그리고 석탄이나 숯."
	]
	quest.4200000000010028.title: "모닥불"
	quest.4200000000010029.quest_desc: [
		"횃불이 어색한 곳에 빛을 걸어요. 더 따뜻한 빛, 일은 같아요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010029.title: "랜턴"
	quest.420000000001002A.quest_desc: [
		"옅은 파랑으로 타고, 근처에는 거의 아무것도 나타나지 않아요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001002A.title: "영혼 랜턴"
	quest.420000000001002B.quest_desc: [
		"너와 함께 올라가고, 당기면 사라져요. 높이 짓는 일이 더 이상 무섭지 않아요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001002B.title: "비계"
	quest.420000000001002C.quest_desc: [
		"장식을 매달 사슬이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001002C.title: "사슬"
	quest.420000000001002D.quest_desc: [
		"가장자리를 가두세요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001002D.title: "철창"
	quest.420000000001002E.quest_desc: [
		"공중섬 창문용 유리예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001002E.title: "유리판"
	quest.420000000001002F.quest_desc: [
		"부드럽고 잘 타며 염색하기 쉬워요. 어느 공중섬이든 결국 침대가 필요해요.",
		"방법: 풀을 준 뒤 양을 깎거나, 끈 네 개예요."
	]
	quest.420000000001002F.title: "하얀 양털"
	quest.4200000000010030.quest_desc: [
		"블록 전체가 필요 없는 바닥을 위한 얇은 양털이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010030.title: "하얀 양탄자"
	quest.4200000000010031.quest_desc: [
		"자갈로 된 공중섬에 초록과 분홍을 조금 더해 줘요.",
		"방법: 이끼에 참나무를 더하거나, 이끼에 뼛가루를 뿌려요. 벌은 꽃을 받아들여요."
	]
	quest.4200000000010031.title: "꽃이 핀 진달래"
	quest.4200000000010032.quest_desc: [
		"천천히 퍼지며, 거친 돌 받침대의 모습을 부드럽게 해 줘요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010032.title: "이끼 블록"
	quest.4200000000010033.quest_desc: [
		"공중섬 아래에 매달린 뿌리예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010033.title: "매달린 뿌리"
	quest.4200000000010034.quest_desc: [
		"벽에 달라붙어 횃불 하나 없이 밝혀 줘요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010034.title: "발광 이끼"
	quest.4200000000010035.quest_desc: [
		"뾰족한 장식용 점적석이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010035.title: "뾰족한 점적석"
	quest.4200000000010036.quest_desc: [
		"블록으로 된 자수정이에요. 인장은 나중에 파편을 원할 거예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010036.title: "자수정 블록"
	quest.4200000000010037.quest_desc: [
		"주괴 아홉 개를 눌러 붙인 거예요. 밖에 두면 초록으로 변해요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010037.title: "구리 블록"
	quest.4200000000010038.quest_desc: [
		"철 원석 아홉 덩이를 단단히 쌓아 화로를 기다리고 있어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010038.title: "철 원석 블록"
	quest.4200000000010039.quest_desc: [
		"흩어진 석탄보다 훨씬 오래 타요. 화로에 넣고 자리를 뜨세요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000010039.title: "석탄 블록"
	quest.420000000001003A.quest_desc: [
		"동물을 먹이고 낙하를 늦춰 줘요. 농부들은 둘 다 쓰려고 가까이 둬요.",
		"방법: 밀 아홉 개예요. 밀 세 개로도 빵이 돼요."
	]
	quest.420000000001003A.title: "건초 더미"
	quest.420000000001003B.quest_desc: [
		"켈프 아홉 개를 눌러 만든 연료예요. 보기보다 더 많이 제련해요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001003B.title: "말린 켈프 블록"
	quest.420000000001003C.quest_desc: [
		"종이와 가죽, 제작법이 붙은 무언가가 되기를 기다리고 있어요.",
		"방법: 종이 세 장에 가죽이에요. 종이는 사탕수수예요."
	]
	quest.420000000001003C.title: "책"
	quest.420000000001003D.quest_desc: [
		"책과 지도를 위한 종이예요.",
		"방법: 사탕수수 세 개를 한 줄로 놓으세요. 수수는 부싯돌 망이나 그보다 나은 망으로 흙을 체질하면 나와요."
	]
	quest.420000000001003D.title: "종이"
	quest.420000000001003E.quest_desc: [
		"염료와 책에는 잉크가 필요해요.",
		"방법: 숯에 유리병이에요. 오징어는 여기서 절대 나타나지 않아요."
	]
	quest.420000000001003E.title: "먹물 주머니"
	quest.420000000001003F.quest_desc: [
		"화살과 책을 위한 깃털이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000001003F.title: "깃털"
	quest.4200000000010040.quest_desc: [
		"책과 키트를 위한 가죽이에요.",
		"방법: 썩은 살점을 제련하거나 모닥불에서 구우세요. 부싯돌 망으로 흙을 체질하세요. /clowder hub 공중섬 지킴이가 실 18개에 두 개를 팔아요."
	]
	quest.4200000000010040.title: "가죽"
	quest.4200000000010041.quest_desc: [
		"작업대, 묘목, 화로, 물, 코덱스. 공중섬은 버텨요.",
		"가닥에 장력을 주세요. 공중섬 지킴이가 응답하고, 증표는 당신이 앉히면 돼요.",
		"받아서 부족의 선물 하나를 고르세요. 공유 목숨이 하나 더 늘어나는 귀환의 실, 또는 보급품이에요.",
		"방법: 이것과 연결된 퀘스트를 끝낸 다음, 가닥 증표를 받으세요. 증표를 장력 기둥에 앉히세요."
	]
	quest.4200000000010041.quest_subtitle: "깨어남"
	quest.4200000000010041.title: "토양 매듭"
	quest.4200000000010042.quest_desc: [
		"증표를 든 채 자신의 Clowder 장력 기둥을 우클릭하세요.",
		"홈이 빛나고, 부족이 울리고, 공중섬이 바뀌어요.",
		"방법: 가닥 증표를 손에 든 채 장력 기둥을 우클릭하세요."
	]
	quest.4200000000010042.title: "토양 앉히기"
	quest.4200000000010043.quest_desc: [
		"동굴 없는 공중섬에 좀비. 공허가 안부를 전해요.",
		"가장자리를 밝히세요.",
		"방법: 밤에 공중섬에서 좀비를 처치하세요. 가장자리를 밝히세요."
	]
	quest.4200000000010043.title: "무언가 올라왔다"
	quest.4200000000020044.quest_desc: [
		"어디서 왔는지 기억하는 실.",
		"실을 풀어 끈으로 만드세요. 끈 네 개가 털실 두 개를 자아요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 끈 네 개 → 털실 두 개. 장력 통: 끈 + 진주. 베틀 보풀 넷."
	]
	quest.4200000000020044.title: "공허의 털실 뽑기"
	quest.4200000000020045.quest_desc: [
		"조약돌과 막대기. 떨어진 모래알을 자갈, 모래, 가루로 부수세요.",
		"방법: 조약돌 + 막대기. 모래알을 자갈, 모래, 가루로 부수세요."
	]
	quest.4200000000020045.title: "물레 망치"
	quest.4200000000020046.quest_desc: [
		"털실 둘레에 끈. 베틀이 떨어뜨린 것을 걸러요——그리고 흙에서 베틀 보풀을 빗어내요.",
		"방법: 털실 둘레에 끈. 자갈 가수의 노점에서 하나를 팔아요."
	]
	quest.4200000000020046.title: "망 꿰기"
	quest.4200000000020047.quest_desc: [
		"물을 붓고 양동이는 바로 돌아와요. 흙을 넣으세요. 점토를 기다리세요.",
		"같은 통의 끈과 진주가 털실이 돼요.",
		"방법: 판자, 끈, 공허의 털실. 물을 부으세요(양동이는 돌아와요), 흙을 넣으세요 → 점토."
	]
	quest.4200000000020047.title: "장력 통"
	quest.4200000000020048.quest_desc: [
		"통에서 점토 열여섯. 한 번에 흙을 여덟 넣으세요.",
		"방법: 장력 통 — 물 + 흙. 메아리 분쇄기가 모래를 점토로 두드려요."
	]
	quest.4200000000020048.title: "점토 주머니"
	quest.4200000000020049.quest_desc: [
		"점토와 뼛가루. 굽지 않은 양동이를 빚으세요.",
		"방법: 점토 공 + 뼛가루, 무정형. 점토는 장력 통에서 나와요."
	]
	quest.4200000000020049.title: "도자기 점토"
	quest.420000000002004A.quest_desc: [
		"제련하세요. 철이 아직 소문인 곳에서 도자기가 용암을 담아요.",
		"방법: 도자기 점토를 굽지 않은 양동이로 빚은 다음 제련하세요."
	]
	quest.420000000002004A.title: "도자기 도구"
	quest.420000000002004B.quest_desc: [
		"자갈 가수는 파편마다 울림으로 이름을 붙였어요.",
		"철이 들릴 때까지 체로 거르세요.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.420000000002004B.title: "떨어진 모래알 체질"
	quest.420000000002004C.quest_desc: [
		"여분의 타격 한 세트.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.420000000002004C.title: "Wooden Hammer"
	quest.420000000002004D.quest_desc: [
		"모래알에서 나온 물질. 한 시간 전엔 가루였던 돌 예순넷.",
		"방법: 물 옆에 용암(또는 얼음을 녹이기). 돌을 망치로 치세요. /clowder hub 의 자갈 가수 좌판이 묶음을 팔아요."
	]
	quest.420000000002004D.title: "돌멩이"
	quest.420000000002004E.quest_desc: [
		"베틀 가루는 자갈 속에서 기다려요. 부싯돌도요.",
		"방법: 조약돌을 두드리세요 (물레 망치 또는 메아리 분쇄기)."
	]
	quest.420000000002004E.title: "자갈길"
	quest.420000000002004F.quest_desc: [
		"고운 모래알. 유리는 나중, 그리고 철 망이 가장 잘 거르는 것.",
		"방법: 자갈을 두드리세요."
	]
	quest.420000000002004F.title: "모래 비축"
	quest.4200000000020050.quest_desc: [
		"무너진 세계의 재. 레드스톤과 화약이 그 안에 숨어요.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.4200000000020050.title: "가루 더미"
	quest.4200000000020051.quest_desc: [
		"슬라임 둘레에 털실. 공중섬 퇴비가 슬라임을 만들어요.",
		"매듭은 베틀의 부드러운 문이니, 둘은 남겨 두세요.",
		"방법: 슬라임볼을 두른 공허의 털실 고리."
	]
	quest.4200000000020051.title: "결속 매듭 묶기"
	quest.4200000000020052.quest_desc: [
		"매듭 둘레에 판자. 망을 당겨 펴고, 모래알을 올려 일하게 두세요.",
		"호퍼가 그것을 넣어요. 공중섬의 첫 기계예요.",
		"방법: 결속 매듭 둘레에 판자. 망을 당겨 펴고, 호퍼로 모래알을 넣고, 호퍼 위에 앉히세요."
	]
	quest.4200000000020052.title: "베틀 틀 세우기"
	quest.4200000000020053.quest_desc: [
		"철은 낮고 참을성이 있어요. 망에서 덩어리 여덟.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.4200000000020053.title: "Iron Ore Chunk"
	quest.4200000000020054.quest_desc: [
		"자갈에서 조금씩 체로 걸러져요. 망이 당신 눈보다 먼저 구리를 찾아요.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.4200000000020054.title: "Copper Ore Chunk"
	quest.4200000000020055.quest_desc: [
		"금은 대답할 수고를 거의 하지 않아요. 넷이면 충분해요.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.4200000000020055.title: "Gold Ore Chunk"
	quest.4200000000020056.quest_desc: [
		"라인에 연료를 넣으세요.",
		"방법: 자갈을 체로 거르거나, 석탄 광석을 제련하세요."
	]
	quest.4200000000020056.title: "석탄"
	quest.4200000000020057.quest_desc: [
		"덩어리에서 원석으로. 계속 제련하세요.",
		"방법: 자갈을 체로 걸러 철광석 덩어리를 얻고, 넷이 철광석 블록이 되며, 캐면 철 원석이 떨어져요."
	]
	quest.4200000000020057.title: "철 원석"
	quest.4200000000020058.quest_desc: [
		"회수가 갚아 줘요. 공허가 당신에게 주고 싶지 않던 주괴 열여섯이에요.",
		"방법: 철 원석 / 철 모래알을 제련하세요 (화로 또는 잿불 가마). 자갈을 체로 쳐 덩이를 얻으세요."
	]
	quest.4200000000020058.title: "철 주괴"
	quest.4200000000020059.quest_desc: [
		"전선과 전구, 나중에는 부족 공명기예요.",
		"방법: 구리 원석 / 구리 모래알을 제련하세요. 자갈을 체로 치세요."
	]
	quest.4200000000020059.title: "구리 주괴"
	quest.420000000002005A.quest_desc: [
		"도금한 도구, 그리고 무늬 직공을 위한 금판이에요.",
		"방법: 금 원석 / 금 모래알을 제련하세요. 체에서 더 드문 수확이에요."
	]
	quest.420000000002005A.title: "금 주괴"
	quest.420000000002005B.quest_desc: [
		"더 날카로운 수확. 부싯돌 망이 모래알에서 해진 실을 털어내요.",
		"방법: 실 망 (끈) 둘레에 부싯돌."
	]
	quest.420000000002005B.title: "부싯돌 망"
	quest.420000000002005C.quest_desc: [
		"더 무거운 가루를 위한 금속 실이에요. 철 망에서 가닥 섬유가 떨어져요.",
		"방법: 실 망 (부싯돌) 둘레에 철. 가닥 섬유는 여기서 시작해요."
	]
	quest.420000000002005C.title: "철 망"
	quest.420000000002005D.quest_desc: [
		"녹여서 떨어뜨려요. 시간을 주면 조약돌이 용암이 돼요.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.420000000002005D.title: "도가니"
	quest.420000000002005E.quest_desc: [
		"Ex Deorum 의 통. 퇴비, 그리고 물은 천천히 점토로.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.420000000002005E.title: "통 (돌)"
	quest.420000000002005F.quest_desc: [
		"더 단단한 타격, 더 긴 수명이에요.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.420000000002005F.title: "Stone Hammer"
	quest.4200000000020060.quest_desc: [
		"광석을 자갈과 모래알로 부숴요. 체 뒤에 있는 시끄러운 요령이에요.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.4200000000020060.title: "Iron Hammer"
	quest.4200000000020061.quest_desc: [
		"더 넓은 망, 한 번에 아홉이에요.",
		"방법: Ex Deorum 의 체, 망치, 도가니, 또는 통. 망을 모래알에 맞추세요."
	]
	quest.4200000000020061.title: "압축 체"
	quest.4200000000020062.quest_desc: [
		"속이 보여요. 모래가 유리가 돼요.",
		"방법: 모래를 제련하세요. 망치로 조약돌을 자갈로, 자갈을 모래로, 그다음 화로로 넣으세요."
	]
	quest.4200000000020062.title: "유리"
	quest.4200000000020063.quest_desc: [
		"이제는 철로 비를 담으세요.",
		"방법: 철 주괴 셋, 또는 /clowder hub 공중섬 지킴이 (실 8). 녹인 얼음으로 채우세요."
	]
	quest.4200000000020063.title: "양동이"
	quest.4200000000020064.quest_desc: [
		"공허의 열을, 손에.",
		"방법: Ex Deorum 용암 도가니, 또는 발톱 흑요석 다음의 네더 용암 웅덩이."
	]
	quest.4200000000020064.title: "용암이 담긴 양동이"
	quest.4200000000020065.quest_desc: [
		"포탈 생각. 용암 근원에 물을.",
		"방법: 용암 근원에 물을 (또는 물에 용암을). 용암 근원은 남기세요."
	]
	quest.4200000000020065.title: "흑요석"
	quest.4200000000020066.quest_desc: [
		"모래알의 드문 행운. 둘이면 시작이에요.",
		"방법: 철 망 이상으로 자갈을 체로 치거나, 메아리 분쇄기로 다이아몬드 광석을 처리하세요."
	]
	quest.4200000000020066.title: "다이아몬드"
	quest.4200000000020067.quest_desc: [
		"망 강화의 연료예요.",
		"방법: 자갈, 또는 실 + 자갈 소모."
	]
	quest.4200000000020067.title: "부싯돌"
	quest.4200000000020068.quest_desc: [
		"모래알과 가루로 만들어요. 크리퍼에게서 빼앗는 게 아니에요. 조심히 다루세요.",
		"방법: 가루나 영혼 모래를 체로 치거나, 밤에 공중섬의 크리퍼에게서 얻으세요. 조금 생긴 뒤에는 가장자리를 밝혀 두세요."
	]
	quest.4200000000020068.title: "화약"
	quest.4200000000020069.quest_desc: [
		"불꽃이 이것을 원할 거예요. 건조하게 두세요.",
		"방법: 자갈을 체로 치거나, 회수 뒤에 메아리 분쇄기로 레드스톤 광석을 처리하세요."
	]
	quest.4200000000020069.title: "레드스톤"
	quest.420000000002006A.quest_desc: [
		"마법 부여대에 먹여요. 장비가 더 잘 듣게 하는 푸른 가루예요.",
		"방법: 자갈을 체로 치거나, 메아리 분쇄기로 청금석 광석을 처리하세요."
	]
	quest.420000000002006A.title: "청금석"
	quest.420000000002006B.quest_desc: [
		"흔한 돌 혼합물이에요. 주로 건축과, 나중에 레시피를 섞는 데 쓰여요.",
		"방법: 흙/자갈의 돌멩이를 체로 치거나, JEI 에서 조약돌에 섬록암을 더하세요."
	]
	quest.420000000002006B.title: "안산암"
	quest.420000000002006C.quest_desc: [
		"얼룩진 돌, 구조보다 장식에 가까워요. 자갈 가수는 이것을 시끄러운 돌이라 불렀어요.",
		"방법: 돌멩이를 체로 치거나, 조약돌에 네더 석영을 더하세요."
	]
	quest.420000000002006C.title: "섬록암"
	quest.420000000002006D.quest_desc: [
		"촘촘하고 분홍 얼룩이 있어요. 튀고 싶은 바닥에 잘 맞아요.",
		"방법: 돌멩이를 체로 치거나, 섬록암에 네더 석영을 더하세요."
	]
	quest.420000000002006D.title: "화강암"
	quest.420000000002006E.quest_desc: [
		"다른 곳에서 온 구멍 많은 바위. 한번 붙으면 영원히 타요.",
		"방법: 여기 네더는 지형이 아니라 공허예요. 마녀의 물이 든 Ex Deorum 통에 용암을 부으세요 (균사체 위에 둔 물통. 균사체 포자는 흙을 체로 쳐서 얻어요)."
	]
	quest.420000000002006E.title: "네더랙"
	quest.420000000002006F.quest_desc: [
		"그 위를 지나는 걸음마다 느려지고, 영혼 불에 더 차가운 푸른빛을 먹여요.",
		"방법: 모래를 마녀의 물이 든 Ex Deorum 통에 넣으세요. 요새의 네더 사마귀 방에 조금 있어요. 영혼 모래 위 해골 셋이 위더를 만들어요."
	]
	quest.420000000002006F.title: "영혼 모래"
	quest.4200000000020070.quest_desc: [
		"네더 발광석을 갈아 만든 가루. 양조와 더 부드러운 광원에 쓰여요.",
		"방법: 영혼 모래를 체로 치거나, 공중섬의 마녀."
	]
	quest.4200000000020070.title: "발광석 가루"
	quest.4200000000020071.quest_desc: [
		"줄기에 도끼를 휘두르지 않고 나무의 잎을 벗겨요.",
		"방법: 막대 넷. 자갈 가수의 노점에서 하나를 팔아요."
	]
	quest.4200000000020071.title: "갈고리"
	quest.4200000000020072.quest_desc: [
		"체에서 점점 커지는 더미로 나와요. 어느 망에도 늘 조금 모자라요.",
		"방법: 해진 실을 풀어요 (1 → 3). 거미. 메아리 결속에서 베틀 보풀. 털실 역소모."
	]
	quest.4200000000020072.title: "끈"
	quest.4200000000020073.quest_desc: [
		"매듭 결합제 — 또는 공중섬 퇴비 제조법.",
		"방법: 흙 둘 + 밀 씨앗 + 뼛가루(공중섬 퇴비), 또는 /clowder hub 공중섬 지킴이."
	]
	quest.4200000000020073.title: "슬라임볼"
	quest.4200000000020074.quest_desc: [
		"뼛가루로 갈거나, 통째로 남겨 무리의 다음 늑대를 번식해요.",
		"방법: 밤의 스켈레톤, 또는 /clowder hub 공중섬 지킴이 (실 16으로 8개)."
	]
	quest.4200000000020074.title: "뼈"
	quest.4200000000020075.quest_desc: [
		"쓰고, 살짝 독이 있어요. 양조에는 쓰지만, 그냥 먹는 사람은 없어요.",
		"방법: 밤의 공중섬에 있는 거미."
	]
	quest.4200000000020075.title: "거미 눈"
	quest.4200000000020076.quest_desc: [
		"털실, 자기, 돌아가는 베틀 틀, 상자 속의 철.",
		"가닥에 장력을 주세요. 자갈 가수가 답해요.",
		"받아서 부족의 선물 하나를 고르세요. 공유 목숨이 하나 더 늘어나는 귀환의 실, 또는 보급품이에요.",
		"방법: 이것과 연결된 퀘스트를 끝낸 다음, 가닥 증표를 받으세요. 증표를 장력 기둥에 앉히세요."
	]
	quest.4200000000020076.quest_subtitle: "회수"
	quest.4200000000020076.title: "돌 매듭"
	quest.4200000000020077.quest_desc: [
		"증표를 든 채 자신의 Clowder 장력 기둥을 우클릭하세요.",
		"홈이 빛나고, 부족이 울리고, 공중섬이 바뀌어요.",
		"방법: 가닥 증표를 손에 든 채 장력 기둥을 우클릭하세요."
	]
	quest.4200000000020077.title: "돌 앉히기"
	quest.4200000000020078.quest_desc: [
		"크리퍼는 처리했어요. 화약은 놀람보다 값져요.",
		"방법: 크리퍼 셋을 죽이세요. 화약이 보상이에요."
	]
	quest.4200000000020078.title: "쾅, 나중에"
	quest.4200000000030079.quest_desc: [
		"공중섬에 이랑을 긁으세요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 철 주괴 둘을 막대 위에."
	]
	quest.4200000000030079.title: "철 괭이"
	quest.420000000003007A.quest_desc: [
		"빵은 기반이에요. 밀 서른둘은 밭이지, 작은 밭떼기가 아니에요.",
		"방법: 경작지에 밀 씨앗, 그다음 뼛가루. 씨앗은 풀을 부수거나 시작 상자에서."
	]
	quest.420000000003007A.title: "밀밭"
	quest.420000000003007B.quest_desc: [
		"먹는 것을 심으세요.",
		"방법: 풀을 부수거나, 부싯돌 망으로 흙을 거르세요. 경작지에 심으세요. 뼛가루가 첫 밭을 빠르게 해요."
	]
	quest.420000000003007B.title: "씨앗 주머니"
	quest.420000000003007C.quest_desc: [
		"빠름은 친절이에요. 퇴비와 뼈.",
		"방법: 뼈를 격자에 넣거나, 실 + 썩은 살점 소모, 또는 /clowder hub 공중섬 지킴이."
	]
	quest.420000000003007C.title: "뼛가루 기관"
	quest.420000000003007D.quest_desc: [
		"수확을 준비하세요.",
		"방법: JEI 에서 Farmer's Delight 를 제작하세요 (제작대, 도마, 또는 요리 냄비). 작물 씨앗은 흙을 체로 쳐서 나와요."
	]
	quest.420000000003007D.title: "농부의 칼"
	quest.420000000003007E.quest_desc: [
		"부엌은 여기서 시작돼요.",
		"방법: JEI 에서 Farmer's Delight 를 제작하세요 (제작대, 도마, 또는 요리 냄비). 작물 씨앗은 흙을 체로 쳐서 나와요."
	]
	quest.420000000003007E.title: "도마"
	quest.420000000003007F.quest_desc: [
		"따뜻한 식사는 배고픔 이상을 채워요.",
		"방법: JEI 에서 Farmer's Delight 를 제작하세요 (제작대, 도마, 또는 요리 냄비). 작물 씨앗은 흙을 체로 쳐서 나와요."
	]
	quest.420000000003007F.title: "조리용 냄비"
	quest.4200000000030080.quest_desc: [
		"단정한 포기로 자라고, 생으로보다 요리해서 먹는 편이 나아요.",
		"방법: JEI 에서 Farmer's Delight 를 제작하세요 (제작대, 도마, 또는 요리 냄비). 작물 씨앗은 흙을 체로 쳐서 나와요."
	]
	quest.4200000000030080.title: "양배추"
	quest.4200000000030081.quest_desc: [
		"제 격자를 타고 올라 붉게 익어요. 소스는 여기서 시작돼요.",
		"방법: JEI 에서 Farmer's Delight 를 제작하세요 (제작대, 도마, 또는 요리 냄비). 작물 씨앗은 흙을 체로 쳐서 나와요."
	]
	quest.4200000000030081.title: "토마토"
	quest.4200000000030082.quest_desc: [
		"기쁨의 눈물.",
		"방법: JEI 에서 Farmer's Delight 를 제작하세요 (제작대, 도마, 또는 요리 냄비). 작물 씨앗은 흙을 체로 쳐서 나와요."
	]
	quest.4200000000030082.title: "양파"
	quest.4200000000030083.quest_desc: [
		"정수 농사가 시작돼요. 첫 줄에서 열여섯.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"씨앗의 등뼈. 체로 치거나 기르세요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"에센스에서 씨앗을 일으켜요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030085.title: "주입 제단"
	quest.4200000000030086.quest_desc: [
		"제단 주위에 네 개예요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030086.title: "주입 받침대"
	quest.4200000000030087.quest_desc: [
		"공중섬을 더 키워요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030087.title: "흙 씨앗"
	quest.4200000000030088.quest_desc: [
		"도끼 없이 수관을 키워요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030088.title: "나무 씨앗"
	quest.4200000000030089.quest_desc: [
		"캐는 게 아니라 기른 거예요. 곡괭이를 휘두르지 말고 에센스를 수확해요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030089.title: "돌 씨앗"
	quest.420000000003008A.quest_desc: [
		"작물에서 얻는 금속이에요. 회수의 두 번째 엔진이에요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.420000000003008A.title: "철 씨앗"
	quest.420000000003008B.quest_desc: [
		"구리 광석 대신 구리 에센스를 내는 작물이에요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.420000000003008B.title: "구리 씨앗"
	quest.420000000003008C.quest_desc: [
		"공중섬 위에서 바로 금 에센스를 키우는 금빛 작물이에요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.420000000003008C.title: "금 씨앗"
	quest.420000000003008D.quest_desc: [
		"채굴 없이 밭을 연료원으로 바꿔요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.420000000003008D.title: "석탄 씨앗"
	quest.420000000003008E.quest_desc: [
		"작물에서 담는 병 속 비예요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.420000000003008E.title: "물 씨앗"
	quest.420000000003008F.quest_desc: [
		"작은 공중섬을 위한 알찬 재배예요.",
		"방법: JEI 의 테라코타 Botany Pot. 화분에 흙 + 씨앗을 넣어요. 뼛가루는 여전히 도움이 돼요."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"스스로 수확하는 화분이에요.",
		"방법: JEI 의 호퍼 Botany Pot. 상자/호퍼 위에 두고 스스로 수확해요."
	]
	quest.4200000000030090.title: "호퍼 화분"
	quest.4200000000030091.quest_desc: [
		"등급을 올려요. 씨앗은 더 탐욕스러워지고, 더 좋아져요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"처음 씨앗보다 강한, 더 깊은 등급의 작물 에센스예요.",
		"방법: JEI 에서 Mystical Agriculture 를 제작하세요. Inferium 과 Prosperity 는 체에서 나와요. 씨앗은 주입 제단에서 주입해요."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"뼛가루 아홉으로 블록 하나예요. 엔진용 보관이에요.",
		"방법: 뼛가루 아홉. 뼈는 스켈레톤이나 공중섬 지킴이에게서 얻어요."
	]
	quest.4200000000030093.title: "뼈 블록"
	quest.4200000000030094.quest_desc: [
		"싹의 잉여를 쌓아 둬요.",
		"방법: 밀 아홉 개예요. 밀 세 개로도 빵이 돼요."
	]
	quest.4200000000030094.title: "건초 사일로"
	quest.4200000000030095.quest_desc: [
		"더 나은 농지예요. 뿌리묶이도 인정할 거예요.",
		"방법: 유기 퇴비를 놓고 기다리면, 천천히 비옥한 토양이 돼요."
	]
	quest.4200000000030095.title: "기름진 흙"
	quest.4200000000030096.quest_desc: [
		"먹여 주는 토양을 먹이세요.",
		"방법: JEI 에서 Farmer's Delight 를 제작하세요 (제작대, 도마, 또는 요리 냄비). 작물 씨앗은 흙을 체로 쳐서 나와요."
	]
	quest.4200000000030096.title: "유기농 퇴비"
	quest.4200000000030097.quest_desc: [
		"한 줄 심거나, 말에게 주거나, 그냥 생으로 먹어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000030097.title: "당근"
	quest.4200000000030098.quest_desc: [
		"주식 작물, 감자예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000030098.title: "감자"
	quest.4200000000030099.quest_desc: [
		"빨리 자라고 빨갛게 물들여요. 수프나 스튜로, 아니면 땅에서 바로 먹어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000030099.title: "비트"
	quest.420000000003009A.quest_desc: [
		"식량과 거래용 수박이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000003009A.title: "수박"
	quest.420000000003009B.quest_desc: [
		"식량과 장식용 호박이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000003009B.title: "호박"
	quest.420000000003009C.quest_desc: [
		"종이와 설탕이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000003009C.title: "사탕수수"
	quest.420000000003009D.quest_desc: [
		"물 없이도 자라고, 기대는 것은 뭐든 다치게 해요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000003009D.title: "선인장"
	quest.420000000003009E.quest_desc: [
		"빨리 솟고 뜨겁게 타요. 나무가 적은 공중섬에 요긴한 연료예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000003009E.title: "대나무"
	quest.420000000003009F.quest_desc: [
		"짓는 사이에 먹는 열매예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000003009F.title: "달콤한 열매"
	quest.42000000000300A0.quest_desc: [
		"정글 원목에서 자라고, 단것마다 맛을 내는 갈색으로 갈려요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000300A0.title: "코코아"
	quest.42000000000300A1.quest_desc: [
		"참나무 잎에서 제 시간에 떨어져요. 결국엔 공짜 음식이에요.",
		"방법: 참나무 잎은 몇 개만 떨어뜨려요; Pam's 사과나무(철 망 흙에서 나온 묘목)는 많이 열어요."
	]
	quest.42000000000300A1.title: "사과"
	quest.42000000000300A2.quest_desc: [
		"그릇 하나, 작업대는 없어요. 게으른 농부의 저녁이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000300A2.title: "버섯 스튜"
	quest.42000000000300A3.quest_desc: [
		"벌과의 더 깊은 일이 시작되기 전, 벌집의 맛이에요.",
		"방법: 가득 찬 벌집에 유리병. 아래에는 모닥불."
	]
	quest.42000000000300A3.title: "꿀이 든 병"
	quest.42000000000300A4.quest_desc: [
		"동굴 덩굴에서 자라고, 먹는 동안 굴을 밝혀요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000300A4.title: "발광 열매"
	quest.42000000000300A5.quest_desc: [
		"병에 담을 만한 모든 물약의 바탕이에요. 영혼 모래에서만 자라요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000300A5.title: "네더 사마귀"
	quest.42000000000300A6.quest_desc: [
		"밭, 부엌, 오르는 에센스.",
		"가닥에 장력을 거세요. 뿌리묶이가 답해요.",
		"받아서 부족의 선물 하나를 고르세요. 공유 목숨이 하나 더 늘어나는 귀환의 실, 또는 보급품이에요.",
		"방법: 이것과 연결된 퀘스트를 끝낸 다음, 가닥 증표를 받으세요. 증표를 장력 기둥에 앉히세요."
	]
	quest.42000000000300A6.quest_subtitle: "뿌리"
	quest.42000000000300A6.title: "싹의 매듭"
	quest.42000000000300A7.quest_desc: [
		"증표를 든 채 자신의 Clowder 장력 기둥을 우클릭하세요.",
		"홈이 빛나고, 부족이 울리고, 공중섬이 바뀌어요.",
		"방법: 가닥 증표를 손에 든 채 장력 기둥을 우클릭하세요."
	]
	quest.42000000000300A7.title: "싹 앉히기"
	quest.42000000000300A8.quest_desc: [
		"뿌리묶이는 누구나 결국 하나를 뽑아요.",
		"먹지 마세요. 버리지도 마세요.",
		"방법: 드문 감자 수확. 선택인 싹의 비밀."
	]
	quest.42000000000300A8.title: "잘못된 감자"
	quest.42000000000400A9.quest_desc: [
		"원하는 조건으로 공허를 자르세요. 도면은 여덟 장이에요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 종이 넷과 파란 염료 하나, 모양 없이. 네 장이 나와요."
	]
	quest.42000000000400A9.title: "청사진 종이"
	quest.42000000000400AA.quest_desc: [
		"상자에 든 도면.",
		"도면 종이 넷, 모양 없이 — 공중섬을 차지하면 Silent Gear 의 입장 선물이 지워져요. 우클릭하면 시작 도면이 나와요.",
		"방법: 도면 종이 넷, 모양 없이. 우클릭하면 시작 도면이 나와요. 공중섬을 차지하면 Silent Gear 의 입장 선물이 지워져요."
	]
	quest.42000000000400AA.title: "청사진 패키지"
	quest.42000000000400AB.quest_desc: [
		"부품을 더하기 전, 모듈형 도구가 시작되는 틀이에요.",
		"방법: 도면 꾸러미를 풀거나, JEI. 발톱이 도구 계열의 이름을 붙여요."
	]
	quest.42000000000400AB.title: "막대 도면"
	quest.42000000000400AC.quest_desc: [
		"금속보다 오래가는 곡괭이를 성형하세요.",
		"방법: 도면 꾸러미를 풀거나, JEI. 발톱이 도구 계열의 이름을 붙여요."
	]
	quest.42000000000400AC.title: "곡괭이 도면"
	quest.42000000000400AD.quest_desc: [
		"도끼를 성형하세요.",
		"방법: 도면 꾸러미를 풀거나, JEI. 발톱이 도구 계열의 이름을 붙여요."
	]
	quest.42000000000400AD.title: "도끼 도면"
	quest.42000000000400AE.quest_desc: [
		"삽을 성형하세요.",
		"방법: 도면 꾸러미를 풀거나, JEI. 발톱이 도구 계열의 이름을 붙여요."
	]
	quest.42000000000400AE.title: "삽 도면"
	quest.42000000000400AF.quest_desc: [
		"날을 성형하세요.",
		"방법: 도면 꾸러미를 풀거나, JEI. 발톱이 도구 계열의 이름을 붙여요."
	]
	quest.42000000000400AF.title: "검 도면"
	quest.42000000000400B0.quest_desc: [
		"자랄 자리예요.",
		"방법: 도면 종이 다음 JEI. 발톱이 강화 계열의 이름을 붙여요."
	]
	quest.42000000000400B0.title: "업그레이드 베이스"
	quest.42000000000400B1.quest_desc: [
		"부품용 재료 주괴가 서른두 개예요.",
		"방법: 철 원석 / 철 모래알을 제련하세요 (화로 또는 잿불 가마). 자갈을 체로 쳐 덩이를 얻으세요."
	]
	quest.42000000000400B1.title: "철 덩이"
	quest.42000000000400B2.quest_desc: [
		"철만으로는 안 되는 데까지 날을 세워요.",
		"방법: 철 망 이상으로 자갈을 체로 치거나, 메아리 분쇄기로 다이아몬드 광석을 처리하세요."
	]
	quest.42000000000400B2.title: "다이아몬드 끝"
	quest.42000000000400B3.quest_desc: [
		"잎과 양털, 나중엔 벌집이에요.",
		"방법: 철 주괴 둘을 대각선으로. 양과 벌집을 깎으세요."
	]
	quest.42000000000400B3.title: "가위"
	quest.42000000000400B4.quest_desc: [
		"공중섬에도 가장자리가 있어요. 몹에게도요.",
		"방법: 철 주위에 판자 여섯. 보조손으로 막기."
	]
	quest.42000000000400B4.title: "방패"
	quest.42000000000400B5.quest_desc: [
		"일부러 밤을 넘기세요.",
		"방법: 철 주괴 여덟. 체 자갈을 제련하세요."
	]
	quest.42000000000400B5.title: "철 흉갑"
	quest.42000000000400B6.quest_desc: [
		"낙하를 조심하세요.",
		"방법: 철 주괴 다섯."
	]
	quest.42000000000400B6.title: "철 투구"
	quest.42000000000400B7.quest_desc: [
		"먼저 다리를 가려요. 피해는 대부분 어차피 아래에서 와요.",
		"방법: 철 주괴 일곱."
	]
	quest.42000000000400B7.title: "철 레깅스"
	quest.42000000000400B8.quest_desc: [
		"미끄러지면 공허가 되는 턱에서 발밑을 단단히 해 줘요.",
		"방법: 철 주괴 넷."
	]
	quest.42000000000400B8.title: "철 부츠"
	quest.42000000000400B9.quest_desc: [
		"공허의 몹을 멀리 두세요.",
		"방법: 끈 셋과 막대 셋."
	]
	quest.42000000000400B9.title: "활"
	quest.42000000000400BA.quest_desc: [
		"거리를 둘 이유가 예순넷이에요.",
		"방법: 부싯돌, 막대, 깃털. 스켈레톤이 남는 것을 떨궈요."
	]
	quest.42000000000400BA.title: "화살 묶음"
	quest.42000000000400BB.quest_desc: [
		"지나갈 길을 밝히세요.",
		"방법: 철 주괴와 부싯돌."
	]
	quest.42000000000400BB.title: "부싯돌과 부시"
	quest.42000000000400BC.quest_desc: [
		"블록 열 개. 가장자리 보행자라면 알아볼 문이에요.",
		"방법: 용암 근원에 물을 (또는 물에 용암을). 용암 근원은 남기세요."
	]
	quest.42000000000400BC.title: "흑요석 틀"
	quest.42000000000400BD.quest_desc: [
		"발 디딜 곳 준비. 다른 곳이 있어요.",
		"방법: 엔더 진주 (가장자리 보행자의 노점 / 엔더맨)에, 발톱 흑요석 다음 네더 요새의 블레이즈 가루. 눈 여덟 재고는 선택이에요. 엔드 수정은 같은 제작을 써요."
	]
	quest.42000000000400BD.title: "엔더의 눈"
	quest.42000000000400BE.quest_desc: [
		"단단한 도구를 위한 부드러운 힘.",
		"방법: 다이아몬드 둘, 흑요석 넷, 책. 다이아몬드는 철 망 자갈에서 나와요."
	]
	quest.42000000000400BE.title: "마법 부여대"
	quest.42000000000400BF.quest_desc: [
		"지니고 있는 것을 고치고 이름을 붙이세요.",
		"방법: 철 블록 셋을 주괴 넷 위에."
	]
	quest.42000000000400BF.title: "모루"
	quest.42000000000400C0.quest_desc: [
		"네 것이라고 부르세요.",
		"방법: 낚시 / 희귀 상자, 또는 /clowder hub 의 인장 조각가 노점 (실 24). 선택이에요."
	]
	quest.42000000000400C0.title: "이름표"
	quest.42000000000400C1.quest_desc: [
		"부품마다 조립하는 모듈식 괭이의 시작 틀이에요.",
		"방법: 도면 꾸러미를 여세요. 또는 JEI."
	]
	quest.42000000000400C1.title: "괭이 도면"
	quest.42000000000400C2.quest_desc: [
		"한 포기가 아니라 한 번에 작물의 넓은 폭을 베어요.",
		"방법: 도면 꾸러미를 여세요. 또는 JEI."
	]
	quest.42000000000400C2.title: "낫 도면"
	quest.42000000000400C3.quest_desc: [
		"캐고, 베고, 파는 도구 하나. 이제 손에 든 것을 바꾸지 않아도 돼요.",
		"방법: 도면 꾸러미를 여세요. 또는 JEI."
	]
	quest.42000000000400C3.title: "Paxel 도면"
	quest.42000000000400C4.quest_desc: [
		"한 번에 돌을 3×3으로 부숴요.",
		"방법: 도면 꾸러미를 여세요. 또는 JEI."
	]
	quest.42000000000400C4.title: "망치 도면"
	quest.42000000000400C5.quest_desc: [
		"어떤 삽보다 빨리 흙과 모래에 넓은 구멍을 파요.",
		"방법: 도면 꾸러미를 여세요. 또는 JEI."
	]
	quest.42000000000400C5.title: "굴착 도면"
	quest.42000000000400C6.quest_desc: [
		"작고, 빠르고, 정확해요. 전쟁이 아니라 가까운 일을 위해 만들어졌어요.",
		"방법: 도면 꾸러미를 여세요. 또는 JEI."
	]
	quest.42000000000400C6.title: "칼 도면"
	quest.42000000000400C7.quest_desc: [
		"부드러운 판이에요. 마법을 부여하기 쉽고, 방어보다 마법이 더 가치 있어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000400C7.title: "금 갑옷 조각"
	quest.42000000000400C8.quest_desc: [
		"바다의 발톱.",
		"선택이에요. 공허가 끝내 주지 않을 수도 있어요.",
		"방법: 드라운드만. 선택이에요."
	]
	quest.42000000000400C8.title: "삼지창"
	quest.42000000000400C9.quest_desc: [
		"장전은 느리고, 타격은 세며, 필요할 때까지 충전을 유지해요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000400C9.title: "쇠뇌"
	quest.42000000000400CA.quest_desc: [
		"공허를 살피세요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000400CA.title: "망원경"
	quest.42000000000400CB.quest_desc: [
		"도면, 등에 철, 밖으로 난 문.",
		"가닥에 장력을 주세요: 가장자리 보행자가 답해요. 땋기가 열려요.",
		"받아서 부족의 선물 하나를 고르세요. 공유 목숨이 하나 더 늘어나는 귀환의 실, 또는 보급품이에요.",
		"방법: 이것과 연결된 퀘스트를 끝낸 다음, 가닥 증표를 받으세요. 증표를 장력 기둥에 앉히세요."
	]
	quest.42000000000400CB.quest_subtitle: "가장자리"
	quest.42000000000400CB.title: "발톱 매듭"
	quest.42000000000400CC.quest_desc: [
		"증표를 든 채 자신의 Clowder 장력 기둥을 우클릭하세요.",
		"홈이 빛나고, 부족이 울리고, 공중섬이 바뀌어요.",
		"방법: 가닥 증표를 손에 든 채 장력 기둥을 우클릭하세요."
	]
	quest.42000000000400CC.title: "발톱 앉히기"
	quest.42000000000400CD.quest_desc: [
		"키 큰 무언가가 되돌아봤어요. 가장자리 보행자는 그들을 문의 파수꾼이라 불렀어요.",
		"방법: 엔더맨을 처치하세요. 엔더 진주는 가장자리 보행자의 노점에서도 나와요."
	]
	quest.42000000000400CD.title: "가장자리의 가장자리"
	quest.42000000000500CE.quest_desc: [
		"웅웅 전의 짧은 신호. 가루 예순넷.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 자갈을 체로 치거나, 회수 뒤에 메아리 분쇄기로 레드스톤 광석을 처리하세요."
	]
	quest.42000000000500CE.title: "레드스톤 가루"
	quest.42000000000500CF.quest_desc: [
		"나란한 열. 여덟은 줄이지, 화로가 아니에요.",
		"방법: 빈 가운데 둘레에 조약돌 여덟."
	]
	quest.42000000000500CF.title: "화로 배열"
	quest.42000000000500D0.quest_desc: [
		"손 쓰지 않고 모래알을 옮기세요.",
		"방법: 상자 둘레에 철 다섯. 베틀 틀이나 장력 통 아래에 두세요 (아래로 추출)."
	]
	quest.42000000000500D0.title: "호퍼 줄"
	quest.42000000000500D1.quest_desc: [
		"박자를 재세요.",
		"방법: 네더 석영, 레드스톤 횃불, 돌. 석영은 영혼 모래를 체로 쳐요. 네더에 갈 필요는 없어요."
	]
	quest.42000000000500D1.title: "비교기"
	quest.42000000000500D2.quest_desc: [
		"뼈, 끈, 자수정. 첫 박자.",
		"두 개가 나와요 — 하나는 영혼 코덱스에 남기세요.",
		"방법: 뼈 하나, 끈, 자수정. /clowder hub 공중섬 지킴이가 뼈를 팔아요. 불꽃 / 웅웅 문."
	]
	quest.42000000000500D2.title: "웅웅: 뼈 방울"
	quest.42000000000500D3.quest_desc: [
		"옛 부족 노래의 조각. 방울이 필요해요.",
		"방법: 뼈 방울, 자수정과 레드스톤, 모양 없이. 두 개가 나와요."
	]
	quest.42000000000500D3.title: "웅웅: 영혼 조각"
	quest.42000000000500D4.quest_desc: [
		"방울 둘레에 구리. 영혼에 맞춘 금속이에요.",
		"방법: 뼈 방울 둘레에 구리. 두 개가 나와요."
	]
	quest.42000000000500D4.title: "웅웅: 구리 공명기"
	quest.42000000000500D5.quest_desc: [
		"치세요. 파동을 붙잡으세요. 뭐든 배선하기 전에 들어요.",
		"방울 둘, 조각 하나, 가죽 둘, 판자 넷 — /clowder hub 의 공중섬 지킴이가 가죽을 팔아요.",
		"방법: 뼈 방울 둘, 영혼 조각 하나, 가죽 둘, 판자 넷. 맨손으로 박자에 맞춰 치세요 (17–23틱). 파동 24."
	]
	quest.42000000000500D5.title: "웅웅: 북심장"
	quest.42000000000500D6.quest_desc: [
		"도구, 주문, 여행을 위해 파동을 지니세요 — 공명기 + 조각이 필요해요.",
		"방법: 만든 다음 북심장에서 채우세요 (셀로 클릭). 도구, 주문, 여행이 셀에서 써요."
	]
	quest.42000000000500D6.title: "웅웅: 파동 셀"
	quest.42000000000500D7.quest_desc: [
		"열린 하늘 아래에서 주변 레이를 박자로 끌어요. 토템의 목소리가 보태져요. 북심장은 필요 없어요.",
		"방법: 하늘 아래, 물/초록 근처에 두세요. 느린 파동. 불꽃 사다리."
	]
	quest.42000000000500D7.title: "웅웅: 레이 수집기"
	quest.42000000000500D8.quest_desc: [
		"메아리 촉매를 앉히세요 (일할수록 닳아요). 서로 다른 원소 토템 둘도. 야영지는 자기 힘을 노래해요. 레드스톤이 화음을 멈춰요.",
		"방법: 메아리 촉매를 앉히고, 서로 다른 토템 둘을 8칸 이내에. 레드스톤이 멈춰요."
	]
	quest.42000000000500D8.title: "웅웅: 파동 공명기"
	quest.42000000000500D9.quest_desc: [
		"Forge 에너지의 완충 — 파동에서 전선으로 가는 다리. 원하면.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500D9.title: "Powah 시작 셀"
	quest.42000000000500DA.quest_desc: [
		"연료를 태워 Forge 에너지로 바꾸세요.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500DA.title: "Powah 연소기"
	quest.42000000000500DB.quest_desc: [
		"에너지를 이어서 옮기세요.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500DB.title: "Powah 케이블"
	quest.42000000000500DC.quest_desc: [
		"하늘의 힘, 온통 하늘인 공중섬에서.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500DC.title: "시작 태양광 패널"
	quest.42000000000500DD.quest_desc: [
		"열 차이를 태워 힘으로 바꿔요. 한쪽은 뜨겁게, 다른 쪽은 차갑게 넣으세요.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500DD.title: "열 발전기"
	quest.42000000000500DE.quest_desc: [
		"막대 고리 안에서 아이템을 충전해요.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500DE.title: "Energizing Orb"
	quest.42000000000500DF.quest_desc: [
		"오브에 공급하세요.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500DF.title: "충전 막대"
	quest.42000000000500E0.quest_desc: [
		"모아 둔 힘 한 줌.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500E0.title: "배터리"
	quest.42000000000500E1.quest_desc: [
		"부수고 다시 놓는 대신, 기계를 그 자리에서 돌려요.",
		"방법: Powah 전력망 장 — 불꽃 파동이 생긴 뒤에 충전 오브와 케이블."
	]
	quest.42000000000500E1.title: "Wrench"
	quest.42000000000500E2.quest_desc: [
		"일반 화로보다 두 배로 빨리 광석을 제련해요. 광석만이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500E2.title: "용광로"
	quest.42000000000500E3.quest_desc: [
		"모닥불보다 두 배로 빨리 고기를 익혀요. 음식만이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500E3.title: "훈연기"
	quest.42000000000500E4.quest_desc: [
		"석탄 아홉을 단단히 눌러요. 블록 하나가 덩이 한 묶음보다 오래가요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500E4.title: "석탄 블록 (불꽃)"
	quest.42000000000500E5.quest_desc: [
		"앞에 있는 것으로 아이템을 한 번에 하나씩 밀어 넣어요.",
		"방법: 레드스톤 둘레에 조약돌."
	]
	quest.42000000000500E5.title: "공급기"
	quest.42000000000500E6.quest_desc: [
		"뜻을 담아 밀어요.",
		"방법: 조약돌, 활, 그리고 레드스톤."
	]
	quest.42000000000500E6.title: "발사기"
	quest.42000000000500E7.quest_desc: [
		"신호가 오면 블록을 앞으로 밀고, 다음 신호를 기다려요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500E7.title: "피스톤"
	quest.42000000000500E8.quest_desc: [
		"블록을 밀어 내고, 신호가 끊기면 다시 당겨요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500E8.title: "끈끈이 피스톤"
	quest.42000000000500E9.quest_desc: [
		"관찰자가 박자를 읽어요.",
		"방법: 조약돌, 레드스톤, 네더 석영."
	]
	quest.42000000000500E9.title: "관찰자"
	quest.42000000000500EA.quest_desc: [
		"중계기가 회로의 박자를 맞춰요.",
		"방법: 레드스톤 횃불, 레드스톤, 돌. 배관 장에서는 시계에 써요."
	]
	quest.42000000000500EA.title: "중계기"
	quest.42000000000500EB.quest_desc: [
		"명중을 기록하고, 중심에 가까울수록 신호가 강해요.",
		"방법: 건초 둘레에 레드스톤. 건초는 밀 셋이에요."
	]
	quest.42000000000500EB.title: "과녁"
	quest.42000000000500EC.quest_desc: [
		"벼락을 지붕에서 멀리 끌어 전하를 땅에 흘려요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500EC.title: "피뢰침"
	quest.42000000000500ED.quest_desc: [
		"전력의 시간이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500ED.title: "시계"
	quest.42000000000500EE.quest_desc: [
		"횃불 없는 빛.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500EE.title: "구리 전구"
	quest.42000000000500EF.quest_desc: [
		"신호가 오면 켜지고, 끊기는 순간 어두워져요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500EF.title: "레드스톤 조명"
	quest.42000000000500F0.quest_desc: [
		"하늘을 읽고, 해와 함께 오르내리는 신호를 보내요.",
		"방법: 유리, 네더 석영, 나무 반 블록."
	]
	quest.42000000000500F0.title: "햇빛 감지기"
	quest.42000000000500F1.quest_desc: [
		"손으로 신호를 켜거나 꺼요. 있는 스위치 중 가장 오래됐어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F1.title: "레버"
	quest.42000000000500F2.quest_desc: [
		"버튼은 레드스톤 짧은 신호를 내요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F2.title: "버튼"
	quest.42000000000500F3.quest_desc: [
		"공기보다 무거운 것이 위에 서면 신호를 보내요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F3.title: "압력판"
	quest.42000000000500F4.quest_desc: [
		"길 가로질러 끈을 매 두면, 건너는 것은 무엇이든 잡아요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F4.title: "철사 덫 갈고리"
	quest.42000000000500F5.quest_desc: [
		"아래 블록 종류마다 음 하나를 내요. 북심장은 늘어선 것에서 노래를 들어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F5.title: "소리 블록"
	quest.42000000000500F6.quest_desc: [
		"공중섬 사기를 위한 주크박스.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F6.title: "주크박스"
	quest.42000000000500F7.quest_desc: [
		"중력이나 한 번 밀면 굴러가요. 레일이 없으면 탈 수 없어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F7.title: "광산 수레"
	quest.42000000000500F8.quest_desc: [
		"공허의 사이를 잇는 레일.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F8.title: "레일"
	quest.42000000000500F9.quest_desc: [
		"수레용 전동 레일.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500F9.title: "전동 레일"
	quest.42000000000500FA.quest_desc: [
		"지나가는 수레를 읽고, 위로 굴러가면 신호를 보내요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.42000000000500FA.title: "감지 레일"
	quest.42000000000500FB.quest_desc: [
		"대체 태양광 제작.",
		"방법: 유리 셋, 청금석 셋, 거울 셋. 각각 한 줄."
	]
	quest.42000000000500FB.title: "Solar Flux 셀"
	quest.42000000000500FC.quest_desc: [
		"간단한 아이템 파이프.",
		"방법: 철 + 레드스톤. Pipez 렌치로 면을 맞추세요."
	]
	quest.42000000000500FC.title: "Pipez 아이템"
	quest.42000000000500FD.quest_desc: [
		"간단한 유체 파이프.",
		"방법: 철 + 양동이 + 레드스톤. 렌치로 한 면을 웅크리며 사용하면 추출, 그 면을 우클릭하면 필터예요."
	]
	quest.42000000000500FD.title: "Pipez 유체"
	quest.42000000000500FE.quest_desc: [
		"기계 사이의 평범한 에너지 파이프.",
		"방법: 철 + 레드스톤. 기계 사이에 FE 를 옮겨요."
	]
	quest.42000000000500FE.title: "Pipez 에너지"
	quest.42000000000500FF.quest_desc: [
		"어느 파이프 면이 기계에서 빼낼지 정하거나, 면을 끊어요. 파이프는 부수지 않아요.",
		"방법: 부싯돌 둘과 막대기 둘. 기계의 파이프 면을 웅크리며 사용하면 추출, 한 번 더 하면 끊어요. 추출 중인 면을 우클릭하면 필터예요."
	]
	quest.42000000000500FF.title: "Pipez 렌치"
	quest.4200000000050100.quest_desc: [
		"격자 선을 표시해요. 영혼 조각이 필요해요.",
		"방법: 뼛가루 둘, 청금석, 영혼 조각 하나. 무정형. 네 개가 나와요."
	]
	quest.4200000000050100.title: "의식 분필"
	quest.4200000000050101.quest_desc: [
		"두드린 북, 붙든 파동, 앉힌 공명기.",
		"가닥에 장력을 주세요: 북심장이 답해요.",
		"받아서 부족의 선물 하나를 고르세요. 공유 목숨이 하나 더 늘어나는 귀환의 실, 또는 보급품이에요.",
		"방법: 이것과 연결된 퀘스트를 끝낸 다음, 가닥 증표를 받으세요. 증표를 장력 기둥에 앉히세요."
	]
	quest.4200000000050101.quest_subtitle: "웅웅"
	quest.4200000000050101.title: "불꽃 매듭"
	quest.4200000000050102.quest_desc: [
		"증표를 든 채 자신의 Clowder 장력 기둥을 우클릭하세요.",
		"홈이 빛나고, 부족이 울리고, 공중섬이 바뀌어요.",
		"방법: 가닥 증표를 손에 든 채 장력 기둥을 우클릭하세요."
	]
	quest.4200000000050102.title: "불꽃 앉히기"
	quest.4200000000050103.quest_desc: [
		"부족 직조를 따라 메아리 정제를 거쳐 공명 핵까지 가세요. 조화 활성기는 야영지의 조화를 이 장의 기계를 위한 FE 로 바꿔요. 등급이 없으면 변환은 초당 파동 60이고, 메아리 장치에서 등급을 올리면 더 나와요. FE 는 받을 수 없어요. 레드스톤은 변환과 내보내기를 둘 다 멈춰요.",
		"방법: 구리 주괴 다섯, 레드스톤 셋, 공명 핵 하나."
	]
	quest.4200000000050103.title: "웅웅임이 전류가 되다"
	quest.4200000000050104.quest_desc: [
		"마녀, 공중섬에, 밤에. 북은 경고하지 않았어요.",
		"방법: 밤의 공중섬에서 마녀를 처치하세요."
	]
	quest.4200000000050104.title: "병에 든 말썽"
	quest.4200000000060105.quest_desc: [
		"잠자는 동안 일하는 손이에요. 서른둘.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 안산암 + 철 조각을 제작대(또는 혼합기)에서."
	]
	quest.4200000000060105.title: "안산암 합금"
	quest.4200000000060106.quest_desc: [
		"회전의 등뼈예요.",
		"방법: 안산암 합금을 JEI 에 나온 절단 / 제작 레시피로."
	]
	quest.4200000000060106.title: "축"
	quest.4200000000060107.quest_desc: [
		"톱니바퀴 하나. 그다음 같은 톱니바퀴를 또.",
		"방법: 축 + 판자."
	]
	quest.4200000000060107.title: "톱니바퀴"
	quest.4200000000060108.quest_desc: [
		"이는 더 많고, 회전은 더 느려요.",
		"방법: JEI 의 Create 제작 (제작대, 프레스, 혼합기 또는 배치기). 안산암 합금과 물레방아가 라인을 시작해요."
