	quest.4200000000200505.quest_desc: [
		"여러 부품을 완성품 하나로 합쳐요.",
		"방법: Mekanism 작업장 챕터 — 체의 광석 덩어리, 그다음 공장 라인."
	]
	quest.4200000000200505.title: "결합기"
	quest.4200000000210506.quest_desc: [
		"좀비는 원하든 말든 이걸 떨어뜨려요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 밤에 공중섬에서 좀비를 죽이거나, 어두운 구멍에서 죽이세요."
	]
	quest.4200000000210506.title: "썩은 살점 비축"
	quest.4200000000210507.quest_desc: [
		"스켈레톤이 이걸 남겨요. 나중에 갈아서 뼛가루로 쓰세요.",
		"방법: 밤의 스켈레톤, 또는 /clowder hub 공중섬 지킴이 (실 16으로 8개)."
	]
	quest.4200000000210507.title: "뼈 비축"
	quest.4200000000210508.quest_desc: [
		"크리퍼가 이걸 내줘요. 가끔은 폭발과 함께예요.",
		"방법: 가루나 영혼 모래를 체로 치거나, 밤에 공중섬의 크리퍼에게서 얻으세요. 조금 생긴 뒤에는 가장자리를 밝혀 두세요."
	]
	quest.4200000000210508.title: "화약 비축"
	quest.4200000000210509.quest_desc: [
		"거미가 이걸 떨어뜨려요. 체는 절대 안 그래요.",
		"방법: 해진 실을 풀어요 (1 → 3). 거미. 메아리 결속에서 베틀 보풀. 털실 역소모."
	]
	quest.4200000000210509.title: "끈 비축"
	quest.420000000021050A.quest_desc: [
		"독으로 양조되고, 이상한 제작법 몇 가지에 들어가요.",
		"방법: 밤의 공중섬에 있는 거미."
	]
	quest.420000000021050A.title: "거미 눈 비축"
	quest.420000000021050B.quest_desc: [
		"엔더맨이 이걸 떨어뜨려요. 공허에 비는 것보다 농장이 나아요.",
		"방법: 엔더맨, 또는 /clowder hub 의 가장자리 보행자 노점."
	]
	quest.420000000021050B.title: "엔더 진주 농장"
	quest.420000000021050C.quest_desc: [
		"양조대와 블레이즈 버너, 둘 다의 연료예요.",
		"방법: 발톱 흑요석 다음, 네더 요새. 양조는 막대를 원해요. Ars 와 Occultism 은 기다리지 않아요."
	]
	quest.420000000021050C.title: "블레이즈 막대 농장"
	quest.420000000021050D.quest_desc: [
		"드문 전리품이에요. 재생 물약의 열쇠예요.",
		"방법: 발톱 흑요석 다음의 네더 가스트."
	]
	quest.420000000021050D.title: "가스트 눈물 농장"
	quest.420000000021050E.quest_desc: [
		"화염 저항으로 양조되고, 제작 몇 가지에 들어가요.",
		"방법: 슬라임볼을 용암 통에 떨어뜨리거나, 슬라임에 블레이즈 가루, 또는 마그마 큐브."
	]
	quest.420000000021050E.title: "마그마 크림 농장"
	quest.420000000021050F.quest_desc: [
		"피스톤, 슬라임 블록, 끈에 쓸 만큼 끈적해요.",
		"방법: 흙 둘 + 밀 씨앗 + 뼛가루(공중섬 퇴비), 또는 /clowder hub 공중섬 지킴이."
	]
	quest.420000000021050F.title: "슬라임볼 농장"
	quest.4200000000210510.quest_desc: [
		"세 개면 싸울 만한 보스를 소환해요.",
		"방법: 발톱 흑요석 다음, 네더 요새. 해골 셋이면 위더가 시작돼요."
	]
	quest.4200000000210510.title: "위더 스켈레톤 해골"
	quest.4200000000210511.quest_desc: [
		"위더 자신의 세금이에요. 드물고, 힘으로 무거워요.",
		"방법: 위더(영혼 모래 위 해골 셋), 또는 /clowder hub 의 북심장 노점에서 한 번, 실 두루마리 12(실 972). 선택 전리품이에요. 엔드도 몹 농장 100%도 막지 않아요."
	]
	quest.4200000000210511.title: "네더의 별"
	quest.4200000000210512.quest_desc: [
		"죽어도 남는 보관인 셜커 상자가 돼요.",
		"선택이에요. 여기에는 셜커가 없어서, 팩이 껍질을 만들어요.",
		"방법: 팩 제작법, 퍼퍼 블록 여섯, 엔더 진주 둘, 결속 매듭 하나. 셜커는 여기서 절대 나타나지 않아요. 선택이에요."
	]
	quest.4200000000210512.title: "셜커 껍질 농장"
	quest.4200000000210513.quest_desc: [
		"다른 방법이 없을 때 겉날개를 고쳐요.",
		"방법: 사흘 밤 잠을 거르고, 그다음 팬텀을 죽이세요. 선택이에요."
	]
	quest.4200000000210513.title: "팬텀 막"
	quest.4200000000210514.quest_desc: [
		"오징어 먹물이에요. 염색과 옛날식 글쓰기에 쓸모 있어요.",
		"방법: 숯에 유리병이에요. 오징어는 여기서 절대 나타나지 않아요."
	]
	quest.4200000000210514.title: "먹물 주머니 농장"
	quest.4200000000210515.quest_desc: [
		"표지판과 아이템 액자를 어둠 속에서 빛나게 해요.",
		"방법: 발광 오징어는 공중섬에 절대 나타나지 않아요. 선택이에요."
	]
	quest.4200000000210515.title: "발광 먹물"
	quest.4200000000210516.quest_desc: [
		"가디언이 떨어뜨려요. 프리즈머린 블록과 랜턴용이에요.",
		"방법: 해양 기념비는 없어요. 프리즈머린 씨앗을 키우지 않으면 선택이에요."
	]
	quest.4200000000210516.title: "프리즈머린 조각"
	quest.4200000000210517.quest_desc: [
		"바다를 밝히고 몇 가지 제작에 들어가는 가디언의 드롭이에요.",
		"방법: 해양 기념비는 없어요. 선택이에요."
	]
	quest.4200000000210517.title: "프리즈머린 수정"
	quest.4200000000210518.quest_desc: [
		"전달체를 둘러요. 여덟 개를 모아 틀을 완성하세요.",
		"선택이에요. 공허가 끝내 주지 않을 수도 있어요.",
		"방법: 바다만. 선택이에요."
	]
	quest.4200000000210518.title: "앵무조개 껍데기 (사냥)"
	quest.4200000000210519.quest_desc: [
		"죽음을 한 번 속인 뒤, 사라져요.",
		"방법: 퀘스트 보상만. 시계 앉히기와 인장 앉히기가 하나씩 주고, 나중 가닥 매듭 선물은 더 줘요. 습격과 소환사는 공중섬에 오지 않아요. 선택이에요."
	]
	quest.4200000000210519.title: "토템 (사냥)"
	quest.420000000021051A.quest_desc: [
		"골렘은 경비를 서는 동안 철을 떨어뜨려요.",
		"방법: 철 원석 / 철 모래알을 제련하세요 (화로 또는 잿불 가마). 자갈을 체로 쳐 덩이를 얻으세요."
	]
	quest.420000000021051A.title: "철 골렘의 선물"
	quest.420000000021051B.quest_desc: [
		"눈덩이를 던져요. 탄약으로는 쓸모 있지만, 싸움꾼은 아니에요.",
		"방법: 얼음 하나(키트 / 얼음 생성기), 무정형으로 눈덩이 넷."
	]
	quest.420000000021051B.title: "눈 골렘"
	quest.420000000021051C.quest_desc: [
		"스켈레톤이 공중섬의 탄약을 채워 둬요.",
		"방법: 부싯돌, 막대, 깃털. 스켈레톤이 남는 것을 떨궈요."
	]
	quest.420000000021051C.title: "화살 농장"
	quest.420000000021051D.quest_desc: [
		"맞은 것에 잠깐 빛나는 표시를 남겨요.",
		"방법: 화살 둘레에 발광석 가루."
	]
	quest.420000000021051D.title: "분광 화살"
	quest.420000000021051E.quest_desc: [
		"안장을 찾으면 타세요.",
		"선택이에요 — Clowder 회관의 공중섬 지킴이가 하나를 팔아요.",
		"방법: Clowder 회관(/clowder hub)의 공중섬 지킴이 가게에서 다이아몬드 블록을 교환하세요. Chocobo 안장은 다른 아이템이에요."
	]
	quest.420000000021051E.title: "안장 (사냥)"
	quest.420000000021051F.quest_desc: [
		"몹에 이름을 붙여 다시는 사라지지 않게 해요.",
		"선택이에요 — Clowder 회관의 인장 조각가가 하나를 팔아요.",
		"방법: 낚시 / 희귀 상자, 또는 /clowder hub 의 인장 조각가 노점 (실 24). 선택이에요."
	]
	quest.420000000021051F.title: "이름표 농장"
	quest.4200000000210520.quest_desc: [
		"고리나 케이블을 붙들어 매요.",
		"방법: 슬라임볼 둘레에 끈 넷. 슬라임은 공중섬 퇴비예요 (흙, 씨앗, 뼛가루)."
	]
	quest.4200000000210520.title: "끈 (사냥)"
	quest.4200000000210521.quest_desc: [
		"닭이 낳는 쪽이, 줍는 쪽보다 빨라요.",
		"방법: 공중섬의 닭에게 밀 씨앗, 또는 몹 농장 장의 닭장."
	]
	quest.4200000000210521.title: "달걀 비축"
	quest.4200000000210522.quest_desc: [
		"가죽과 소고기 비축이에요.",
		"방법: 썩은 살점을 제련하거나 모닥불에서 구우세요. 부싯돌 망으로 흙을 체질하세요. /clowder hub 공중섬 지킴이가 실 18개에 두 개를 팔아요."
	]
	quest.4200000000210522.title: "가죽 비축"
	quest.4200000000210523.quest_desc: [
		"양은 깎은 뒤에 양털을 다시 길러요.",
		"방법: 풀을 준 뒤 양을 깎거나, 끈 네 개예요."
	]
	quest.4200000000210523.title: "양털 비축"
	quest.4200000000210524.quest_desc: [
		"부엌을 위한 식량 비축이에요.",
		"방법: 공중섬의 소에게 밀."
	]
	quest.4200000000210524.title: "소고기 비축"
	quest.4200000000210525.quest_desc: [
		"돼지가 줘요. 먹기 전에 익히세요.",
		"방법: 공중섬의 돼지에게 감자나 당근."
	]
	quest.4200000000210525.title: "돼지고기 비축"
	quest.4200000000210526.quest_desc: [
		"식사와 깃털을 위한 닭이에요.",
		"방법: 공중섬의 닭에게 씨앗."
	]
	quest.4200000000210526.title: "닭고기 비축"
	quest.4200000000210527.quest_desc: [
		"양고기예요. 날것보다 구운 편이 나아요.",
		"방법: 공중섬의 양에게 밀."
	]
	quest.4200000000210527.title: "양고기 비축"
	quest.4200000000210528.quest_desc: [
		"하나를 내줄 수 있으면 행운의 물약을 빚어요.",
		"선택이에요. 공허가 끝내 주지 않을 수도 있어요.",
		"방법: 토끼는 공중섬에 나타나지 않아요. 선택이에요."
	]
	quest.4200000000210528.title: "토끼 발"
	quest.4200000000210529.quest_desc: [
		"드래곤 알 곁에 둘 만한 전시품이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000210529.title: "좀비 머리"
	quest.420000000021052A.quest_desc: [
		"선반 위 드래곤 알과 잘 어울려요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000021052A.title: "스켈레톤 해골"
	quest.420000000021052B.quest_desc: [
		"전리품 선반에, 드래곤 알 곁에 둘 머리가 하나 더예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000021052B.title: "크리퍼 머리"
	quest.420000000021052C.quest_desc: [
		"머리 하나 더, 드래곤 알 곁이 제자리예요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000021052C.title: "피글린 머리"
	quest.420000000021052D.quest_desc: [
		"가장 드문 머리. 싸움이 끝난 뒤에만 얻어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000021052D.title: "드래곤 머리"
	quest.420000000021052E.quest_desc: [
		"플레이어가 우연히 하나를 떨어뜨릴 때만이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.420000000021052E.title: "플레이어 머리"
	quest.420000000022052F.quest_desc: [
		"첫 제작은 2개예요 — 나중에 코덱스를 위해 하나를 남기세요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 뼈 하나, 끈, 자수정. /clowder hub 공중섬 지킴이가 뼈를 팔아요. 불꽃 / 웅웅 문."
	]
	quest.420000000022052F.title: "뼈 방울"
	quest.4200000000220530.quest_desc: [
		"옛 부족 노래의 조각이에요 — 뼈 방울이 필요해요.",
		"방법: 뼈 방울, 자수정과 레드스톤, 모양 없이. 두 개가 나와요."
	]
	quest.4200000000220530.title: "정령 조각"
	quest.4200000000220531.quest_desc: [
		"금속을 영혼에 맞추세요 — 뼈 방울 둘레에 구리.",
		"방법: 뼈 방울 둘레에 구리. 두 개가 나와요."
	]
	quest.4200000000220531.title: "구리 공명기"
	quest.4200000000220532.quest_desc: [
		"격자 선을 표시하세요 — 분필에 조각이 필요해요.",
		"방법: 뼛가루 둘, 청금석, 영혼 조각 하나. 무정형. 네 개가 나와요."
	]
	quest.4200000000220532.title: "의식 분필 (부족)"
	quest.4200000000220533.quest_desc: [
		"심장을 놓으세요 — 뼈 방울 둘, 영혼 조각, 가죽 둘, 판자 넷 (공중섬 지킴이가 가죽을 팔아요).",
		"방법: 뼈 방울 둘, 영혼 조각 하나, 가죽 둘, 판자 넷. 맨손으로 박자에 맞춰 치세요 (17–23틱). 파동 24."
	]
	quest.4200000000220533.title: "북심장의 박동"
	quest.4200000000220534.quest_desc: [
		"아홉 부족이 한 번 흥얼거렸어요 — 여분의 뼈 방울과 조각이 필요해요.",
		"방법: 제작하거나 불꽃/부족 직조 보상으로 받아요. 우클릭: 격자가 어떻게 돌아가는지."
	]
	quest.4200000000220534.title: "정령 서고"
	quest.4200000000220535.quest_desc: [
		"레이를 박자로 끌어들이세요.",
		"방법: 하늘 아래, 물/초록 근처에 두세요. 느린 파동. 불꽃 사다리."
	]
	quest.4200000000220535.title: "레이 수집기"
	quest.4200000000220536.quest_desc: [
		"도구, 주문, 이동을 위해 파동을 옮겨요. 북심장에서 채우세요.",
		"방법: 만든 다음 북심장에서 채우세요 (셀로 클릭). 도구, 주문, 여행이 셀에서 써요."
	]
	quest.4200000000220536.title: "펄스 전지"
	quest.4200000000220537.quest_desc: [
		"메아리 촉매를 앉히세요. 일하는 동안 닳아요. 여덟 블록 안에 서로 다른 토템 목소리 둘을 더하세요. 목소리가 많을수록 노래가 세져요. 레드스톤이 그것을 멈춰요.",
		"방법: 메아리 촉매를 앉히고, 서로 다른 토템 둘을 8칸 이내에. 레드스톤이 멈춰요."
	]
	quest.4200000000220537.title: "펄스 공명기"
	quest.4200000000220538.quest_desc: [
		"돌의 부족이 대답해요.",
		"방법: 뼈 방울, 원목 둘, 흙, 구리 공명기."
	]
	quest.4200000000220538.title: "대지의 토템"
	quest.4200000000220539.quest_desc: [
		"화염의 부족이 대답해요.",
		"방법: 뼈 방울, 원목 둘, 목탄, 구리 공명기."
	]
	quest.4200000000220539.title: "불의 토템"
	quest.420000000022053A.quest_desc: [
		"조수의 부족이 대답해요.",
		"방법: 뼈 방울, 원목 둘, 물 양동이(또는 도자기 물 양동이), 구리 공명기."
	]
	quest.420000000022053A.title: "물의 토템"
	quest.420000000022053B.quest_desc: [
		"바람의 부족이 대답해요.",
		"방법: 뼈 방울, 원목 둘, 깃털, 구리 공명기."
	]
	quest.420000000022053B.title: "공기의 토템"
	quest.420000000022053C.quest_desc: [
		"다섯째 부족 — 청지기의 핵.",
		"방법: 뼈 방울, 원목 둘, 영혼 조각, 구리 공명기."
	]
	quest.420000000022053C.title: "영혼의 토템"
	quest.420000000022053D.quest_desc: [
		"격자 노래를 시작하세요. 돌이나 메아리 단계 아이템을 기다려요. 원석 금속은 메아리 분쇄기에서 모래알이 돼요.",
		"방법: 영혼 코덱스 + 부족 직조. 돌이나 메아리 단계 아이템을 앉히세요. 원석 금속은 메아리 분쇄기에 넣어요."
	]
	quest.420000000022053D.title: "노래 작업대"
	quest.420000000022053E.quest_desc: [
		"토템 사이로 배음을 보내세요.",
		"방법: 레드스톤 둘레에 구리 공명기 넷. 넷이 나와요."
	]
	quest.420000000022053E.title: "격자 전도체"
	quest.420000000022053F.quest_desc: [
		"1단계를 흥얼거리세요 — 광석을 부숴요. 돌은 조각이 되고, 조약돌은 자갈이 되고, 원석 금속은 모래알이 돼요. 모래알 분쇄는 초당 40 파동으로 4초예요.",
		"방법: 돌 + 뼈 방울 + 구리 공명기. 8 안에 대지의 토템. 돌 → 조각; 조약돌 → 자갈; 원석 금속 → 모래알. 초당 40 파동으로 4초."
	]
	quest.420000000022053F.title: "메아리 파쇄"
	quest.4200000000220540.quest_desc: [
		"분쇄를 들은 조각.",
		"방법: 메아리 분쇄기에 돌 (조약돌 말고). 샘 등급의 돌, 또는 섬세한 손길로 캔 돌."
	]
	quest.4200000000220540.title: "메아리 파편 (부족)"
	quest.4200000000220541.quest_desc: [
		"2단계를 흥얼거리세요 — 조율.",
		"방법: 돌 일곱, 영혼 조각, 구리 공명기."
	]
	quest.4200000000220541.title: "메아리 조율"
	quest.4200000000220542.quest_desc: [
		"열쇠를 찾은 메아리.",
		"방법: 영혼 코덱스 + 부족 직조. 작업대, 토템, 파동 비용은 코덱스 페이지에 있어요."
	]
	quest.4200000000220542.title: "조율된 메아리"
	quest.4200000000220543.quest_desc: [
		"결속 단계 — 영혼을 금속에 매듭지으세요.",
		"방법: 돌 일곱, 자수정 조각, 구리 공명기."
	]
	quest.4200000000220543.title: "메아리 결속"
	quest.4200000000220544.quest_desc: [
		"미끄러지지 않을 메아리.",
		"방법: 영혼 코덱스 + 부족 직조. 작업대, 토템, 파동 비용은 코덱스 페이지에 있어요."
	]
	quest.4200000000220544.title: "결속된 메아리"
	quest.4200000000220545.quest_desc: [
		"다시 짜기 단계 — 주괴를 부르세요.",
		"방법: 돌 다섯, 금 주괴, 구리 공명기 둘, 영혼 조각."
	]
	quest.4200000000220545.title: "메아리 현현"
	quest.4200000000220546.quest_desc: [
		"화로가 아니라 영맥이 의지해서 생겨난 금속이에요.",
		"방법: 영혼 코덱스 + 부족 직조. 작업대, 토템, 파동 비용은 코덱스 페이지에 있어요."
	]
	quest.4200000000220546.title: "현현한 주괴"
	quest.4200000000220547.quest_desc: [
		"부족이 남긴 것을 지키세요.",
		"방법: 판자 일곱, 상자, 뼈 방울."
	]
	quest.4200000000220547.title: "조상 저장고"
	quest.4200000000220548.quest_desc: [
		"변경 쪽으로 이어진 금고예요.",
		"방법: 선조 보관함, 철 주괴 넷, 영혼 조각, 구리 공명기 둘, 파동 셀."
	]
	quest.4200000000220548.title: "깊은 저장고"
	quest.4200000000220549.quest_desc: [
		"쓰이지 않은 인장. 의식이 채우기를 기다려요.",
		"방법: 종이 일곱, 영혼 조각, 뼈 방울. 둘이 나와요."
	]
	quest.4200000000220549.title: "빈 인장"
	quest.420000000022054A.quest_desc: [
		"돌의 부족의 인장이에요.",
		"방법: 빈 인장과 흙, 무정형."
	]
	quest.420000000022054A.title: "땅 인장"
	quest.420000000022054B.quest_desc: [
		"화염의 부족의 인장이에요.",
		"방법: 빈 인장과 목탄, 무정형."
	]
	quest.420000000022054B.title: "불 인장"
	quest.420000000022054C.quest_desc: [
		"조수의 부족의 인장이에요.",
		"방법: 빈 인장과 물 양동이(또는 도자기 물 양동이), 무정형."
	]
	quest.420000000022054C.title: "물 인장"
	quest.420000000022054D.quest_desc: [
		"바람의 부족의 인장이에요.",
		"방법: 빈 인장과 깃털, 무정형."
	]
	quest.420000000022054D.title: "바람 인장"
	quest.420000000022054E.quest_desc: [
		"청지기 부족의 인장이에요.",
		"방법: 빈 인장과 영혼 조각, 무정형."
	]
	quest.420000000022054E.title: "정령 인장"
	quest.420000000022054F.quest_desc: [
		"인장을 바치세요. 베틀에 부탁하세요.",
		"방법: 돌 다섯, 자수정 조각, 뼈 방울."
	]
	quest.420000000022054F.title: "의식 단"
	quest.4200000000220550.quest_desc: [
		"맨손으로 사용하고 문의 의식을 연주해요. 떨어지는 박을 A, S, D, F 로 맞히세요. 60%를 맞히면 열리고, 맥박은 필요 없어요.",
		"방법: 문의 북을 맨손으로 사용하고 문의 의식을 연주해요. 떨어지는 박을 A, S, D, F 로 맞히세요. 60%를 맞히면 열리고, 맥박은 필요 없어요. 먼저 귀환 나침반을 묶어요."
	]
	quest.4200000000220550.title: "문의 북 (부족)"
	quest.4200000000220551.quest_desc: [
		"야영지의 문턱을 조각한 영혼 틀로 꾸미세요. 나침반과 문의 북이 이동을 해 줘요.",
		"방법: 철 주괴 넷, 영혼 조각 둘, 구리 공명기 둘, 자수정 조각."
	]
	quest.4200000000220551.title: "정령 문"
	quest.4200000000220552.quest_desc: [
		"파동을 쓰는 도구예요.",
		"방법: 현현 주괴 셋, 뼈 방울, 막대기."
	]
	quest.4200000000220552.title: "영혼 장비 곡괭이"
	quest.4200000000220553.quest_desc: [
		"파동을 쓰는 날이에요.",
		"방법: 현현 주괴 둘, 뼈 방울, 막대기."
	]
	quest.4200000000220553.title: "정령장비 날"
	quest.4200000000220554.quest_desc: [
		"변경의 돌. 있어서는 안 될 곳, 발밑에 있어요.",
		"방법: 변경 조약돌을 제련하세요. 문의 북을 통해 변경에서 캐요."
	]
	quest.4200000000220554.title: "변경의 돌 (부족)"
	quest.4200000000220555.quest_desc: [
		"변경의 돌부스러기. 수수해도 많아요.",
		"방법: 문의 북을 통해 변경에서 변경의 돌을 캐세요."
	]
	quest.4200000000220555.title: "마치 조약돌"
	quest.4200000000220556.quest_desc: [
		"해가 닿지 않는 곳에서 자란 나무예요.",
		"방법: 문의 북을 통해 변경의 나무를 베세요."
	]
	quest.4200000000220556.title: "마치 원목"
	quest.4200000000220557.quest_desc: [
		"변경에서 켠 재목. 나온 곳이 그런데도 튼튼해요.",
		"방법: 변경 원목 하나가 판자 넷이 돼요."
	]
	quest.4200000000220557.title: "마치 판자"
	quest.4200000000220558.quest_desc: [
		"바람이 전혀 없어도 속삭이는 잎이에요.",
		"방법: 문의 북을 통한 변경의 나무. 가위나 섬세한 손길이 잎을 남겨요."
	]
	quest.4200000000220558.title: "마치 잎"
	quest.4200000000220559.quest_desc: [
		"남은 영맥으로 웅웅거리는 갈대예요.",
		"방법: 변경에서 야생으로 자라고, 갈대 보의 상자에 있으며, 뿌리묶이 장로가 거래해요."
	]
	quest.4200000000220559.title: "영혼 갈대 (부족)"
	quest.420000000022055A.quest_desc: [
		"대지의 토템 옆에서 메아리 분쇄기에 원석 철을 넣으세요. 모래알이 둘 나와요. 화로에서 제련하거나 용광로에서 주괴로 만드세요. 다른 Mods 가 태그된 원석 금속을 댈 수 있어요.",
		"방법: 영혼 코덱스 + 부족 직조. 작업대, 토템, 파동 비용은 코덱스 페이지에 있어요."
	]
	quest.420000000022055A.title: "광석은 두 번 기억해요"
	quest.420000000022055B.quest_desc: [
		"물이 양털을 영혼 직물로 묶어요. 작업대 위나 옆에서 넣고, 끝난 것은 아래에서 꺼내세요.",
		"방법: 영혼 코덱스 + 부족 직조. 작업대, 토템, 파동 비용은 코덱스 페이지에 있어요."
	]
	quest.420000000022055B.title: "목소리 있는 천"
	quest.420000000022055C.quest_desc: [
		"영혼 아래에서 현현 주괴를 다시 현현하세요. 공명 핵은 더 강한 장비와 먼 길을 열어요.",
		"방법: 영혼 코덱스 + 부족 직조. 작업대, 토템, 파동 비용은 코덱스 페이지에 있어요."
	]
	quest.420000000022055C.title: "살아있는 심장"
	quest.420000000022055D.quest_desc: [
		"상급 셀 하나에 파동 4,800을, 최상급 셀에는 19,200을 지니세요. 나서기 전에 북심장이나 공명기에서 충전하세요.",
		"방법: 파동 셀 하나, 공명 핵 둘, 현현 주괴 둘."
	]
	quest.420000000022055D.title: "더 긴 노래"
	quest.420000000022055E.quest_desc: [
		"저수조 하나에 양동이 열여섯. 양동이와 액체 파이프, 둘 다 돼요. 비교기가 찬 정도를 읽어요. 레드스톤은 채우기와 빼기를 잠가요. 부수면 액체는 떨어진 블록에 남아요. 하늘돌 탱크는 쏟아요.",
		"방법: 만들고, 양동이나 파이프로 채우고, 집으세요 — 액체는 남아요. AE2 하늘돌 탱크는 부수면 비어요."
	]
	quest.420000000022055E.title: "구리에 담긴 비"
	quest.420000000022055F.quest_desc: [
		"조율기로 기계의 면을 표시한 다음, 릴레이 판에 사용하세요. 다른 기계에 사용하면 표시가 바뀌어요. 판에는 표시하지 마세요.",
		"방법: 구리 공명기 둘 위에 영혼 조각."
	]
	quest.420000000022055F.title: "먼 끝에 이름을 붙이세요"
	quest.4200000000220560.quest_desc: [
		"판을 상자나 기계의 면에 끼우세요. 판 둘을 같은 고유한 결속 아이템으로 짝을 짓거나, 조율기로 목적지를 묶으세요. 가까운 화물은 32블록까지, 초당 16개, 파동 8이에요. 레드스톤은 그것을 멈춰요. 5.0부터 판은 여덟 블록 안에 깨어 있는 바람의 공명 토템을 원하고, 없으면 가만히 서서 어떤 목소리가 빠졌는지 말해요.",
		"방법: 호퍼 하나, 구리 공명기 하나, 의식 분필 둘, 현현 주괴 하나."
	]
	quest.4200000000220560.title: "보급의 길"
	quest.4200000000220561.quest_desc: [
		"판을 탱크의 면에 끼우세요. 판 둘을 짝짓거나, 조율기로 목적지를 묶으세요. 가까운 액체는 32블록까지, 초당 250 mB, 파동 8이에요. 양쪽 끝이 모두 로드되어 있어야 해요. 5.0부터 판은 여덟 블록 안에 깨어 있는 바람의 공명 토템을 원하고, 없으면 가만히 서서 어떤 목소리가 빠졌는지 말해요.",
		"방법: 정령 저수조 하나, 구리 공명기 하나, 의식 분필 둘, 현현 주괴 하나."
	]
	quest.4200000000220561.title: "비의 길"
	quest.4200000000220562.quest_desc: [
		"장거리는 성공한 박마다 파동 16으로 아이템을 128블록까지 옮겨요. 호환되는 어떤 mod 의 일반 보관함이나 쓰세요. 5.0부터 판은 여덟 블록 안에 깨어 있는 바람의 공명 토템을 원하고, 없으면 가만히 서서 어떤 목소리가 빠졌는지 말해요.",
		"방법: 아이템 중계기 하나, 공명 핵 둘, 엔더 진주 둘."
	]
	quest.4200000000220562.title: "공방을 가로질러"
	quest.4200000000220563.quest_desc: [
		"장거리는 박마다 파동 16으로 액체를 128블록까지 옮겨요. 가득 찬 수신 쪽은 안전하게 멈추고, 레드스톤은 받는 저수조를 잠글 수 있어요. 5.0부터 판은 여덟 블록 안에 깨어 있는 바람의 공명 토템을 원하고, 없으면 가만히 서서 어떤 목소리가 빠졌는지 말해요.",
		"방법: 유체 중계기 하나, 공명 핵 둘, 엔더 진주 둘."
	]
	quest.4200000000220563.title: "물길을 가로질러"
	quest.4200000000220564.quest_desc: [
		"Tribal Power를 Mekanism, Powah 또는 AE2의 에너지 수용기로 이어 주세요. 파동 하나가 100 FE가 돼요. 무등급 변환은 초당 60 파동(6,000 FE/s)이에요. 메아리 거점에서 어댑터의 등급을 올리면, 맨손 상태가 현재 속도를 알려 줘요. 그래도 FE는 받을 수 없어요. 레드스톤은 변환과 내보내기를 멈춰요.",
		"방법: 구리 주괴 다섯, 레드스톤 셋, 공명 핵 하나."
	]
	quest.4200000000220564.title: "박자가 전류가 되다"
	quest.4200000000220565.quest_desc: [
		"여섯 겹 지팡이. 웅크리고 사용해 대지, 불, 물, 바람, 영, 베틀을 돌려 가며 고르세요. 사용하면 시전해요. 베틀의 목소리는 올가미로, 대상을 여덟 블록 당신 쪽으로 당겨요. 대상 없이 웅크려 시전하면 땀이고, 여섯 블록 순간이동이에요. 충전된 셀을 지니세요. 영혼 코덱스가 각 주문과 비용을 설명해요.",
		"방법: 영혼 인장, 공명 핵, 현현 주괴, 원목 둘."
	]
	quest.4200000000220565.title: "한 손에 여섯 목소리"
	quest.4200000000220566.quest_desc: [
		"주로 든 손으로 돌 면을 웅크리고 사용해요. 블록당 8 파동으로, 일부러 삼 곱하기 삼을 잘라요. 보통의 파괴 보호와 도구 조건은 그대로예요.",
		"방법: 현현 주괴 둘, 공명 핵, 구리 공명기 둘."
	]
	quest.4200000000220566.title: "돌이 문간을 내주다"
	quest.4200000000220567.quest_desc: [
		"두건은 충전된 셀이 받치는 동안 밤눈을 빌려 줘요. 잇지 않은 부위는 사초마다 2 파동을 끌어요. 묶인 목소리는 3이 들어요.",
		"방법: 영혼 직물 다섯, 투구 모양. 나중에 레이 렌즈를 올리면 레이가 보여요."
	]
	quest.4200000000220567.title: "고요 속의 눈"
	quest.4200000000220568.quest_desc: [
		"로브는 저항을 줘요. 일할 때 입으세요. 셀은 충전된 채로 두세요.",
		"방법: 영혼 직물 일곱과 공명 핵."
	]
	quest.4200000000220568.title: "짠 피신처"
	quest.4200000000220569.quest_desc: [
		"짠 다리갑옷은 속도를 빌려 줘요. 파동 비용은 다른 부위와 따로예요.",
		"방법: 영혼 직물 여섯과 공명 핵."
	]
	quest.4200000000220569.title: "야영이 걸음을 맞추다"
	quest.420000000022056A.quest_desc: [
		"부츠는 파동이 남는 동안 내려갈 때 느린 낙하를 빌려 줄 수 있어요. 묶인 귀환길은 그래도 지니고 다닐 만해요.",
		"방법: 영혼 직물 넷, 부츠 모양."
	]
	quest.420000000022056A.title: "더 부드러운 하강"
	quest.420000000022056B.quest_desc: [
		"다시 쓸 수 있는 인장을 맞는 토템 곁에 앉히세요. 여섯 블록 축복은 이초마다 8 파동이에요. 높은 레드스톤은 그것을 멈춰요. 맨손으로 웅크리면 인장을 되찾아요.",
		"방법: 현현 주괴 둘, 구리 주괴 둘, 공명 핵, 돌 셋."
	]
	quest.420000000022056B.title: "머무는 축복"
	quest.420000000022056C.quest_desc: [
		"단단한 바닥의 윗면을 웅크리고 사용해 묶으세요. 같은 세계에서 128블록 안이면 20 파동으로 돌아와요. 착지 바닥에 동력을 주면 도착이 잠겨요.",
		"방법: 현현 주괴 넷 안의 나침반."
	]
	quest.420000000022056C.title: "첫 귀환길"
	quest.420000000022056D.quest_desc: [
		"한 차원 안이면 어떤 거리든 40 파동으로 돌아와요. 마른 착지를 남기고, 그 위에 빈 블록을 둘 두세요.",
		"방법: 공명 핵 넷 안의 이정표 나침반."
	]
	quest.420000000022056D.title: "지평선 너머"
	quest.420000000022056E.quest_desc: [
		"문의 북 너머에서 변경의 수정을 찾으세요. 사람, 아이템, 유체의 별길은 모두 같은 후반 재료를 써요.",
		"방법: 변경의 동굴에서 수정을 캐거나, 변경의 상자에서 찾으세요. 문의 북이 먼저예요."
	]
	quest.420000000022056E.title: "장막 너머의 목소리"
	quest.420000000022056F.quest_desc: [
		"마지막 나침반은 100 파동으로 차원을 건너요. 탐험 전에 안전한 귀환을 묶으세요. 이동은 사용 사이에 오초를 기다려요.",
		"방법: 지평선 나침반, 영혼 인장 둘, 변경의 수정 둘."
	]
	quest.420000000022056F.title: "세계 사이의 길"
	quest.4200000000220570.quest_desc: [
		"별의 화물은 거리 제한 없이 차원을 넘어요. 성공한 박마다 파동 32가 들어요. 받는 쪽은 이미 로드되어 있어야 해요. 숨은 청크 로딩은 없어요. 5.0부터 판은 여덟 블록 안에 응답 중인 공명 토템(베틀)을 원하고, 없으면 멈춰 서서 빠진 목소리를 말해요.",
		"방법: 장거리 아이템 릴레이, 영혼의 인장 둘, 변경 수정 둘."
	]
	quest.4200000000220570.title: "장막을 넘는 보급"
	quest.4200000000220571.quest_desc: [
		"별의 유체는 플레이어와 아이템과 같은 차원 단계를 따라요. 목적지 탱크는 로드된 채로 두세요. 탱크가 가득 차거나 세계가 로드되지 않으면, 화물을 쓰지 않고 멈춰요. 5.0부터 판은 여덟 블록 안에 응답 중인 공명 토템(베틀)을 원하고, 없으면 멈춰 서서 빠진 목소리를 말해요.",
		"방법: 장거리 유체 릴레이, 영혼의 인장 둘, 변경 수정 둘."
	]
	quest.4200000000220571.title: "장막을 넘는 비"
	quest.4200000000220572.quest_desc: [
		"길 위에서 개인용 54칸 깊은 보관함을 여세요. 보관함과 가방이 함께 쓰는 같은 금고예요. 변경 조율이 여는 비용을 없애요.",
		"방법: 영혼 직물 여섯, 공명 핵 둘, 깊은 보관함."
	]
	quest.4200000000220572.title: "손에 쥔 야영"
	quest.4200000000220573.quest_desc: [
		"문은 살아 있는 나라로 열려요. 어떤 생물은 아직 옛 노래를 지니고, 어떤 생물은 그 부서진 조각을 지켜요. 온순한 쪽은 솔질하세요. 수호자에게는 충전된 파동 셀과 돌아갈 길을 갖추고 맞서세요.",
		"방법: 제작하거나 불꽃/부족 직조 보상으로 받아요. 우클릭: 격자가 어떻게 돌아가는지."
	]
	quest.4200000000220573.title: "돌아오는 노래"
	quest.4200000000220574.quest_desc: [
		"뿔에 옛 숲의 노래를 지닌 여명의 풀뜯이예요. 밀로 번식시키고, 다 자란 것을 솔질하면 여명의 벨벳이 나와요.",
		"오버월드 숲과 변경에서 찾으세요. 그 시약을 물의 목소리 아래 메아리 결속으로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 다 자란 여명의 수사슴을 솔질하세요. 밀로 번식시켜요."
	]
	quest.4200000000220574.title: "여명의 수사슴: 돌아온 노래"
	quest.4200000000220575.quest_desc: [
		"꼬리가 안전한 길을 표시하는, 수줍은 황혼의 채집꾼이에요. 달콤한 열매로 번식시키고, 다 자란 것을 솔질하면 등불 솜털이 나와요.",
		"오버월드 숲과 변경에서 찾으세요. 그 시약을 물의 목소리 아래 메아리 결속으로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 다 자란 등불 여우를 솔질하세요. 달콤한 열매로 번식시켜요."
	]
	quest.4200000000220575.title: "등불 여우: 돌아온 노래"
	quest.4200000000220576.quest_desc: [
		"살아있는 껍질을 가진 습지의 참을성 있는 정원사예요. 해초로 번식시키고, 다 자란 것을 솔질하면 자연히 벗은 이끼등 비늘이 나와요.",
		"오버월드 늪과 변경에서 찾으세요. 그 시약을 물의 목소리 아래 메아리 결속으로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 다 자란 이끼등을 솔질하세요. 해초로 번식시켜요."
	]
	quest.4200000000220576.title: "이끼등: 돌아온 노래"
	quest.4200000000220577.quest_desc: [
		"부서진 불의 의식의 잔해예요. 근접 타격이 잠깐 불을 붙여요. 물을 가까이 두세요.",
		"오버월드 숲과 변경에서 찾으세요. 그 시약을 영혼의 목소리 아래 메아리 조율로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 재결속에서 떨어져요. 적대적인 영혼은 어둠이 필요해요."
	]
	quest.4200000000220577.title: "재결속: 돌아온 노래"
	quest.4200000000220578.quest_desc: [
		"끊긴 레이 선에 뒤틀린 숲의 수호자예요. 느리지만 튼튼해요. 타격이 여행자를 잠깐 땅에 뿌리박아요.",
		"오버월드 숲과 변경에서 찾으세요. 그 시약을 영혼의 목소리 아래 메아리 조율로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 뿌리결속에서 떨어져요. 적대적인 영혼은 어둠이 필요해요."
	]
	quest.4200000000220578.title: "뿌리결속: 돌아온 노래"
	quest.4200000000220579.quest_desc: [
		"영혼 갈대 사이에 숨은 습지 사냥꾼이에요. 빠른 타격에는 짧은 독이 실려요.",
		"오버월드 늪과 변경에서 찾으세요. 그 시약을 영혼의 목소리 아래 메아리 조율로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 갈대 추적자에게서 떨어져요. 적대적인 영혼은 어둠이 필요해요."
	]
	quest.4200000000220579.title: "갈대 추적자: 돌아온 노래"
	quest.420000000022057A.quest_desc: [
		"노래하는 돌 갑옷을 입은 수정 들판의 청소부예요. 무거운 밀침과는 거리를 두세요.",
		"변경에서 찾으세요. 그 시약을 영혼의 목소리 아래 메아리 조율로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 파편등에게서 떨어져요. 적대적인 영혼은 어둠이 필요해요."
	]
	quest.420000000022057A.title: "파편등: 돌아온 노래"
	quest.420000000022057B.quest_desc: [
		"아직도 옛길을 지키는 빈 파수꾼이에요. 그 손길은 공격하는 쪽의 악력을 약하게 해요.",
		"변경에서 찾으세요. 그 시약을 영혼의 목소리 아래 메아리 조율로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 빈 파수꾼에게서 떨어져요. 적대적인 영혼은 어둠이 필요해요."
	]
	quest.420000000022057B.title: "빈 파수꾼: 돌아온 노래"
	quest.420000000022057C.quest_desc: [
		"폭풍이 키운 영혼으로, 넓은 장막 날개를 가졌어요. 밝은 티끌 무리가 돌풍을 알려요. 엄폐가 공격을 끊어요.",
		"변경에서 찾으세요. 그 시약을 물의 목소리 아래 메아리 결속으로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 폭풍 나방에게서 떨어져요. 적대적인 영혼은 어둠이 필요해요."
	]
	quest.420000000022057C.title: "폭풍 나방: 돌아온 노래"
	quest.420000000022057D.quest_desc: [
		"날렵한 잉걸의 영혼이에요. 불타는 화살 전에 불꽃을 모아요. 주문은 지형에 불을 붙이지 않아요.",
		"변경에서 찾으세요. 그 시약을 영혼의 목소리 아래 메아리 조율로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 잉걸 임프에게서 떨어져요. 적대적인 영혼은 어둠이 필요해요."
	]
	quest.420000000022057D.title: "잉걸 임프: 돌아온 노래"
	quest.420000000022057E.quest_desc: [
		"잃어버린 부족을 기억하는 떠 있는 유물이에요. 예고된 종소리가 느려지게 해요. 엄폐가 노래를 끊어요.",
		"변경에서 찾으세요. 그 시약을 영혼의 목소리 아래 메아리 조율로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 애도의 종에게서 떨어져요. 적대적인 영은 어둠이 필요해요."
	]
	quest.420000000022057E.title: "애도의 종: 돌아온 노래"
	quest.420000000022057F.quest_desc: [
		"격자의 균열에 이끌리는 사냥꾼이에요. 거리는 빨리 좁히지만, 혼자서는 세계 사이를 넘지 못해요.",
		"변경에서 찾으세요. 그 시약을 영혼의 목소리 아래 메아리 조율로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 균열 사냥개에게서 떨어져요. 적대적인 영은 어둠이 필요해요."
	]
	quest.420000000022057F.title: "균열 사냥개: 돌아온 노래"
	quest.4200000000220580.quest_desc: [
		"부서진 노래를 지키는 여덟 다리 지킴이에요. 물면 먹이가 느려지지만, 거미줄을 놓거나 야영지를 망가뜨리지는 않아요.",
		"변경에서 찾으세요. 그 시약을 물의 목소리 아래 메아리 결속으로 돌려주면, 쓸모 있는 재료가 돼요. 불을 밝힌 길을 만드세요. 적대적인 영혼은 어둠을 요구해요.",
		"방법: 메아리 직공에게서 떨어져요. 적대적인 영은 어둠이 필요해요."
	]
	quest.4200000000220580.title: "메아리 직공: 돌아온 노래"
	quest.4200000000220581.quest_desc: [
		"현장 노트가 끝났어요. 순한 수확과 되찾은 유물이 다시 천과 메아리가 되었어요. 밤의 베일 아래에서 야영지가 더 가득한 노래로 답해요.",
		"드문 보상: Clowder 공유 목숨 하나, 팀 전체에 한 번뿐이에요. 이런 보상은 캠페인에 여섯밖에 없어요.",
		"방법: 영혼 코덱스 + 부족 직조. 작업대, 토템, 파동 비용은 코덱스 페이지에 있어요."
	]
	quest.4200000000220581.title: "열세 목소리, 하나의 하늘"
	quest.4200000000220582.quest_desc: [
		"야영지의 노래를 구리에 거세요. 영혼 랜턴은 연료 없이 빛을 가득 내요; 레드스톤은 그 빛을 낮춰요. 어둠에서 돌아오는 안전한 길을 표시하세요.",
		"방법: 구리 주괴 셋, 영혼 조각 하나, 판자 하나."
	]
	quest.4200000000220582.title: "돌아오는 이를 위한 빛"
	quest.4200000000220583.quest_desc: [
		"방울은 장식이면서 악기예요. 비교기는 맑은 하늘에 0, 비에 8, 천둥에 15를 내요. 레드스톤은 그것을 잠재워요.",
		"방법: 판자 셋, 구리 주괴 셋, 뼈 방울 하나."
	]
	quest.4200000000220583.title: "날씨를 들어요"
	quest.4200000000220584.quest_desc: [
		"조각한 탁자는 27묶음을 담아요. 일반 아이템 파이프와 릴레이가 공물을 나눌 수 있어요; 비교기는 찬 정도를 읽고, 레드스톤은 접근을 잠가요.",
		"방법: 상자 하나, 묶인 메아리 하나, 판자 둘, 돌 둘."
	]
	quest.4200000000220584.title: "화로 곁의 자리"
	quest.4200000000220585.quest_desc: [
		"숲 돌보미를 작물 높이에, 9×9 밭에 놓으세요. 씨앗은 첫 줄에 넣고, 수확은 아래 두 줄을 채워요. 심기는 파동 4, 수확하고 다시 심기는 12가 들어요. 동력은 여덟 블록 안에 공급하세요. 출력이 가득 차면 작물은 남고, 레드스톤은 작업을 멈춰요. 5.0부터는 여덟 블록 안에 깨어 있는 대지의 공명 토템을 바라며, 없으면 가만히 서서 빠진 목소리를 말해요. 물의 토템도 곁에 두면 밭의 고랑마다 물을 줘요.",
		"방법: 철 괭이, 대지의 인장, 묶인 메아리, 구리 주괴 둘, 판자 둘."
	]
	quest.4200000000220585.title: "정원이 계속 노래해요"
	quest.4200000000220586.quest_desc: [
		"매초 파동 여덟이 24블록 안의 적대적인 생성을 막아요. 이미 있는 생물은 그대로 남아요. 수호는 요람의 적대 소환도 막으니, 소환터는 그 밖에 두세요. 레드스톤은 곧바로 수호를 잠재워요. 5.0부터는 여덟 블록 안에 깨어 있는 영혼의 공명 토템을 바라며, 없으면 가만히 서서 빠진 목소리를 말해요.",
		"방법: 영혼의 인장, 묶인 메아리 둘, 메아리 파편, 변경의 판자 셋."
	]
	quest.4200000000220586.title: "야영지 가장자리의 고요"
	quest.4200000000220587.quest_desc: [
		"길의 닻은 매초 파동 16으로 자기 청크를 깨운 채로 둬요. 먼 중계기의 받는 쪽에 하나를 두고, 그곳의 동력을 유지하세요. 한 차원에서는 닻이 많아야 32개까지 돌아요. 레드스톤이나 빈 버퍼는 청크를 놓아요. 5.0부터는 여덟 블록 안에 깨어 있는 대지의 공명 토템을 바라며, 없으면 가만히 서서 빠진 목소리를 말해요.",
		"방법: 변경의 수정 둘, 엔더의 눈, 발현된 주괴 둘, 공명 핵, 변경의 돌 셋."
	]
	quest.4200000000220587.title: "기억하는 야영지"
	quest.4200000000220588.quest_desc: [
		"충전되지 않은 형상을 지원되는 생물에게 웅크리고 사용해, 해롭지 않은 각인을 받으세요. 형상은 종을 기억해요. 보스는 묶을 수 없고, 코덱스가 맞는 영혼과 갱신을 설명해 줘요.",
		"방법: 뼈 방울, 영혼 직물 둘, 공명 핵, 묶인 메아리."
	]
	quest.4200000000220588.title: "살아있는 목소리를 빌리세요"
	quest.4200000000220589.quest_desc: [
		"깨어난 형상을 첫 칸에, 영혼 직물을 둘째 칸에 앉히세요. 성공한 소환은 매번 파동 80, 영혼 직물 하나, 결속의 실 하나를 써요. 세 블록 안에 안전한 바닥을 남겨 두세요. 근처 생물 여덟이 소환의 요람을 멈추고, 레드스톤은 모든 작업과 자동화를 멈춰요. 5.0부터는 여덟 블록 안에 지켜 둔 영혼의 공명 토템을 원하고, 없으면 멈춰 서서 어느 목소리가 빠졌는지 말해요.",
		"방법: 현현된 주괴 둘, 변경의 수정 하나, 묶인 메아리 둘, 공명 핵 하나, 변경 판자 셋."
	]
	quest.4200000000220589.title: "빌린 생명을 위한 화로"
	quest.420000000022058A.quest_desc: [
		"영혼의 봉인을 의식 화로에 놓으세요. 여덟 블록 안에 대지, 바람, 영혼의 토템을 두고, 근처에 파동 200, 인벤토리에 영혼 직물 셋을 가져오세요. 새겨진 형상을 화로에 사용해 소환의 실 512가닥을 깨우세요. 모두 쓰이면, 이 의식을 반복해 결속을 새로이 하세요.",
		"방법: 영혼의 봉인을 의식 화로에. 대지, 바람, 영혼 토템을 8 안에. 파동 200. 영혼 직물 셋. 새겨진 형상을 사용하세요."
	]
	quest.420000000022058A.title: "세 목소리가 실을 깨워요"
	quest.420000000022058B.quest_desc: [
		"성공한 소환을 한 번 마치세요. 실패하거나 막힌 시도는 실도 공물도 쓰지 않아요. 결속 하나는 성공한 소환 512회 동안 가요. 요람을 부수고 다시 놓아도 결속은 결코 새로워지지 않아요. 형상의 툴팁이 남은 횟수를 보여주고, 비교기가 요람에 남은 결속의 힘을 읽어요.",
		"방법: 소환의 요람에서 성공한 소환을 한 번 마치세요. 실패한 시도는 아무것도 쓰지 않아요."
	]
	quest.420000000022058B.title: "요람에서 온 대답"
	quest.4200000000228001.quest_desc: [
		"문의 북 너머, 변경의 초원과 고지에 가라앉은 선조의 전당이 숨어요. 걸어 들어가면 이것이 체크돼요. 전당마다 전승 석판이 네 개 늘어서 있어요. 빠짐없이 읽으세요. 상자에는 베틀 실, 메아리, 영혼 직물, 봉인이 있어요. 빈 파수꾼이 아직 지키고 있어요.",
		"방법: 문의 북으로 변경에 들어가 선조의 전당으로 걸어 들어가세요. 그런 다음 전승 석판 넷을 읽으세요."
	]
	quest.4200000000228001.title: "시간을 지키던 전당"
	quest.4200000000228002.quest_desc: [
		"베틀 실은 손에 든 베틀이에요. 선조의 전당 상자에는 둘에서 넷이 있고, 불리지 않은 자는 열여섯 이상을 찢어 내며, 베틀 바느질꾼 장로가 친구 평판에서 하나를 바꿔 줘요. 여섯 번째 목소리의 시약이에요.",
		"방법: 선조의 전당 상자, 불리지 않은 자, 또는 친구 평판의 베틀 바느질꾼 장로."
	]
	quest.4200000000228002.title: "실 그 자체의 가닥"
	quest.4200000000228003.quest_desc: [
		"메아리 파편 주위에 변경의 돌 여덟이면 전승 석판이 둘 나와요. 놓으면 석판이 아홉 부족의 조각을 보여 줘요. 크리에이티브에서 웅크려 사용하면 어느 것인지 바뀌어요. 네 전당을 그것으로 두르세요.",
		"방법: 메아리 파편 주위에 변경의 돌 여덟. 둘이 나와요."
	]
	quest.4200000000228003.title: "읽은 것을 새기세요"
	quest.4200000000228004.quest_desc: [
		"공명 핵 둘레에, 변경 판자 위로 가죽이에요. 변경 고지의 북의 원에는 이미 하나가 있어요. 이건 집에서 앉힐 네 것이에요. 숨 하나를 두고 네 번 치세요. 오래된 무언가가 일어나요.",
		"방법: 가죽 셋, 변경 판자 다섯, 공명 핵 하나."
	]
	quest.4200000000228004.title: "울리지 않는 북"
	quest.4200000000228005.quest_desc: [
		"불리지 않은 자는 세 단계의 북의 영이에요. 박: 충격파에 맞서 웅크려 버티세요. 합창: 불러내는 메아리 직공을 베어 내세요. 침묵: 같은 네 박 리듬으로 침묵의 북을 칠 때까지는 다치지 않아요. 그 리듬이 그를 기절시키고, 가하는 피해를 두 배로 만들어요. 충전된 파동 셀과 돌아갈 길을 챙기세요.",
		"방법: 침묵의 북에서 불리지 않은 자와 싸우세요. 박에서는 웅크리고, 침묵에서는 네 박을 치세요."
	]
	quest.4200000000228005.title: "북은 기억해요"
	quest.4200000000228006.quest_desc: [
		"처치마다 불리지 않은 자의 심장 하나, 베틀 실과 공명 핵과 함께예요. 그것으로는 베틀 토템만 만들고 다른 것은 없어요. 아껴 쓰세요.",
		"방법: 침묵의 북에 있는 불리지 않은 자는 처치마다 하나를 떨어뜨려요."
	]
	quest.4200000000228006.title: "잠잠해진 북"
	quest.4200000000228007.quest_desc: [
		"베틀 실과 변경 수정 사이에 불리지 않은 자의 심장을, 변경 판자 위에 놓아요. 베틀이 대지, 불, 물, 바람, 영에 합류해요. 파동 공명기를 위한 서로 다른 목소리이자, 메아리 풀기와 레이 결속이 요구하는 조율이에요.",
		"방법: 불리지 않은 자의 심장 하나, 변경 수정 넷, 베틀 실 둘, 변경 판자 둘."
	]
	quest.4200000000228007.title: "여섯 번째 목소리"
	quest.4200000000228008.quest_desc: [
		"빈 인장과 베틀 실이에요. 의식 화로에 앉히면 베틀 인장이 장력을 축복해요. 2초마다 범위 안의 모두가 지닌 셀에 파동을 둘 채우고, 행운을 빌려 줘요.",
		"방법: 빈 인장과 베틀 실, 무정형."
	]
	quest.4200000000228008.title: "장력의 인장"
	quest.4200000000228009.quest_desc: [
		"베틀 실과 구리 공명기를 변경의 돌 위에. 베틀의 목소리 아래에서 메아리 풀기는 격자를 거꾸로 돌려요. 현현 주괴는 결속된 메아리 둘로, 결속은 조율 둘로, 조율은 조각 둘로, 영혼 직물은 양털 둘로, 공명 핵은 현현 주괴 셋으로, 낡은 영혼 장비 도구는 무엇이든 현현 주괴 하나로요.",
		"방법: 변경의 돌 다섯, 베틀 실, 구리 공명기 둘, 영혼 조각."
	]
	quest.4200000000228009.title: "격자, 거꾸로"
	quest.420000000022800A.quest_desc: [
		"육중 지팡이를 베틀의 목소리로 돌리세요. 계류는 대상을 여섯 파동으로 여덟 칸 당신 쪽으로 당겨요. 대상 없이 웅크려 시전하면 땀이고, 공기를 여섯 칸 순간이동하며 비용은 열이에요. 둘 다 쓰면 이것을 체크하세요.",
		"방법: 육중 지팡이를 베틀의 목소리로. 대상을 계류한 다음, 웅크려 땀을 쓰세요. 둘 다 발동하면 체크하세요."
	]
	quest.420000000022800A.title: "계류와 땀"
	quest.420000000022800B.quest_desc: [
		"부족 야영지가 변경에 아홉 서 있어요. 가닥마다 하나: 오두막, 불, 부족 화로, 토템, 깃발, 그리고 부족의 혈족 넷. 그 부족이 좋아하는 것이나 충전된 파동 셀로 화로를 우클릭하면 그들에 대한 평판이 올라요. 혈족을 해치면 25예요. 부족 깃발을 부수면 5, 화로는 40이에요. 평범한 야영지 블록은 깎이지 않아요.",
		"방법: 변경의 부족 화로를 그 부족이 좋아하는 것이나 충전된 파동 셀로 우클릭하세요."
	]
	quest.420000000022800B.title: "따뜻하게"
	quest.420000000022800C.quest_desc: [
		"손님은 50, 친구는 150, 혈족은 400, 목소리는 800이에요. 화로 근처의 처치와 끝낸 거래도 반영돼요. 장로는 단계마다 제안 두 가지를 거래해요. 자갈 가수는 원석값으로 메아리를 팔고, 인장 조각가는 인장과 의식 석판을 팔고, 베틀 바느질꾼은 베틀 실과 이정표 나침반을 팔며, 혈족에서는 베틀 닻과 베틀 인장도 팔아요. `/tribalpower standing` 이 아홉을 모두 출력해요.",
		"방법: 부족과 친구(150)가 되세요. /tribalpower standing."
	]
	quest.420000000022800C.title: "좋은 사이"
	quest.420000000022800D.quest_desc: [
		"목소리 평판에서 장로가 부족 표식을 손에 한 번 눌러 줘요. 그 부족의 코덱스 페이지를 열고, 혈족 토템이 없어서는 안 되는 재료예요.",
		"방법: 부족과 목소리(800). 장로가 표식을 한 번 줘요."
	]
	quest.420000000022800D.title: "아홉이 합의"
	quest.420000000022800E.quest_desc: [
		"부족 표식을 드세요. 부족마다 다르고, 아홉이 가능해요.",
		"방법: 부족과 목소리(800)가 되세요. 그 장로가 표식을 한 번 줘요."
	]
	quest.420000000022800E.title: "부족의 표식"
	quest.420000000022800F.quest_desc: [
		"부족 표식, 그 부족 조율의 공명 토템, 영혼 직물 둘. 혈족 토템은 파동 공명기의 서로 다른 목소리로 하나 더 세어지고, 작업대에 그 부족의 조율을 빌려 주어서, 아홉 부족이 야영지의 노래를 열다섯 목소리까지 실어 갈 수 있어요.",
		"방법: 제작 칸에 부족 표식, 그 부족의 공명 토템, 영혼 직물 둘."
	]
	quest.420000000022800F.title: "목소리가 아닌 목소리"
	quest.4200000000228010.quest_desc: [
		"야영지의 북장이는 몇 초마다 쳐요. 북심장을 한 명에서 여덟 블록 안에 두면, 박마다 파동을 둘 먹여요. 북장이가 격자를 먹이고 있을 때 이것을 체크하세요.",
		"방법: 야영지 북장이로부터 8 안에 북심장을 두세요. 파동을 넣고 있을 때 체크하세요."
	]
	quest.4200000000228010.title: "야영지가 박자를 지켜요"
	quest.4200000000228011.quest_desc: [
		"돌 둘과 시약을 인장 둘레에 두세요. 인장은 돌려받아요. 매듭 뿌리를 대지의 인장 옆에. 파동 600. 이십 분 동안 화로 둘레 아홉 청크의 작물, 묘목, 줄기가 더 빨리 자라요. 그 인장을 앉힌 의식 화로에, 의식의 원 안에서 의식 서판을 웅크리며 사용하세요 (대각선에 받침대 넷, 분필로 이어요). 파동은 여덟 블록 안의 격자에서 끌어와요.",
		"방법: 돌 둘, 매듭 뿌리, 대지의 인장, 무정형. 인장은 돌아와요."
	]
	quest.4200000000228011.title: "의식 서판: 초록색 축복"
	quest.4200000000228012.quest_desc: [
		"돌 둘과 시약을 인장 둘레에 두세요. 인장은 돌려받아요. 갈대 송곳니를 물의 인장 옆에. 파동 400. 이십 분의 비, 저수조와 작물을 위해서예요. 그 인장을 앉힌 의식 화로에, 의식의 원 안에서 의식 서판을 웅크리며 사용하세요 (대각선에 받침대 넷, 분필로 이어요). 파동은 여덟 블록 안의 격자에서 끌어와요.",
		"방법: 돌 둘, 갈대 송곳니, 물의 인장, 무정형. 인장은 돌아와요."
	]
	quest.4200000000228012.title: "의식 서판: 비 부르기"
	quest.4200000000228013.quest_desc: [
		"돌 둘과 시약을 인장 둘레에 놓아요. 인장은 되돌려져요. 폭풍 날개를 바람 인장 옆에. 파동 400. 사십 분 동안 맑은 하늘. 그 인장을 앉힌 의식 화로에, 의식의 원 안에서 석판을 웅크리며 사용하세요 (대각선 위의 받침대 넷, 분필이 그것들을 이어요). 파동은 여덟 블록 안의 격자에서 끌려와요.",
		"방법: 돌 둘, 폭풍 날개, 바람 인장, 무정형. 인장이 돌아와요."
	]
	quest.4200000000228013.title: "의식 서판: 하늘 맑히기"
	quest.4200000000228014.quest_desc: [
		"돌 둘과 시약을 인장 둘레에 놓아요. 인장은 되돌려져요. 잔불 심장을 불 인장 옆에. 파동 800. 밤을 다음 해돋이까지 재촉해요. 세계 전체에. 그 인장을 앉힌 의식 화로에, 의식의 원 안에서 석판을 웅크리며 사용하세요 (대각선 위의 받침대 넷, 분필이 그것들을 이어요). 파동은 여덟 블록 안의 격자에서 끌려와요.",
		"방법: 돌 둘, 잔불 심장, 불 인장, 무정형. 인장이 돌아와요."
	]
	quest.4200000000228014.title: "의식 서판: 새벽의 부름"
	quest.4200000000228015.quest_desc: [
		"돌 둘과 시약을 인장 둘레에 놓아요. 인장은 되돌려져요. 파수 인장을 영혼 인장 옆에. 파동 600. 십오 분 동안 예순네 블록 안에 적대적 생성이 없어요. 그 인장을 앉힌 의식 화로에, 의식의 원 안에서 석판을 웅크리며 사용하세요 (대각선 위의 받침대 넷, 분필이 그것들을 이어요). 파동은 여덟 블록 안의 격자에서 끌려와요.",
		"방법: 돌 둘, 파수 인장, 영혼 인장, 무정형. 인장이 돌아와요."
	]
	quest.4200000000228015.title: "의식 서판: 고요한 밤"
	quest.4200000000228016.quest_desc: [
		"돌 둘과 시약을 인장 둘레에 놓아요. 인장은 되돌려져요. 베틀 실을 베틀 인장 옆에. 파동 1200. 가장 가까운 토템을 예순네 블록 안의 다른 토템과 삼십 분짜리 레이 선으로 잇고, 그 사이로 파동을 흘려요. 그 인장을 앉힌 의식 화로에, 의식의 원 안에서 석판을 웅크리며 사용하세요 (대각선 위의 받침대 넷, 분필이 그것들을 이어요). 파동은 여덟 블록 안의 격자에서 끌려와요.",
		"방법: 돌 둘, 베틀 실, 베틀 인장, 무정형. 인장이 돌아와요."
	]
	quest.4200000000228016.title: "의식 서판: 레이 결속"
	quest.4200000000228017.quest_desc: [
		"아무 의식이나 행하세요. 화로 둘레의 격자에 파동이 너무 적으면 아무것도 소모되지 않고, 화로가 그렇게 말해요.",
		"방법: 맞는 인장과 파동이 있는 의식의 원 안의 의식 화로에, 아무 의식 석판이나 웅크리며 사용하세요."
	]
	quest.4200000000228017.title: "첫 의식"
	quest.4200000000228018.quest_desc: [
		"영혼 직물 둘, 영혼 조각, 그 종의 시약. 어른 사역마에게 사용하세요. 동물은 육십 퍼센트, 실패해도 부적은 남아요. 잔재는 자기 부족과 목소리를 원하고, 사십 퍼센트, 실패하면 부적은 소모돼요.",
		"방법: 영혼 직물 둘, 영혼 조각, 사역마 시약 하나 (새벽 벨벳, 등불 솜털, 폭풍 날개 등)."
	]
	quest.4200000000228018.title: "야생의 것을 위한 부적"
	quest.4200000000228019.quest_desc: [
		"맺어진 사역마는 따라오고, 네 뒤를 따라 순간이동하며, 절대 사라지지 않고, 네가 다치게 할 수 없으며, 솔질하면 두 배로 나와요. 등불 여우, 이끼등, 여명의 수사슴에서 시작해요. 잔재는 목소리가 필요해요. 싸움꾼 하나와 조수 둘이 따라올 수 있어요. 앉은 것은 세지 않아요.",
		"방법: 어른 사역마에게 결속의 부적을 사용하세요. 첫 결속에서 발전 과제가 발동해요."
	]
	quest.4200000000228019.title: "어둠 속의 친구"
	quest.420000000022801A.quest_desc: [
		"종이, 영혼 직물, 영혼 조각. 플레이어에게 헌장을 써서 네 야영지로 초대하거나, 공중에서 써서 그 야영지를 보세요. `/tribalpower camp` 은 생성, 초대, 참가, 탈퇴, 추방, 이름 변경을 해요.",
		"방법: 종이, 영혼 직물, 영혼 조각, 무정형."
	]
	quest.420000000022801A.title: "많은 목소리의 야영지"
	quest.420000000022801B.quest_desc: [
		"야영지 구성원은 모든 깊은 보관함과 여행자의 가방 뒤에 있는 쉰네 칸짜리 야영지 금고를 나누고, 서로의 장치의 주인으로 세며, 길의 닻 열둘을 모으고, 부족 위상의 4분의 1을 야영지에 비춰요. Clowder는 그 야영지가 아니에요 — /tribalpower camp create <name> 이 그거예요.",
		"방법: /tribalpower camp create <name> (Clowder가 아니에요). 첫 야영지에서 발전 과제가 발동해요."
	]
	quest.420000000022801B.title: "금고 하나, 예산 하나"
	quest.420000000022801C.quest_desc: [
		"유리판은 구리 공명기와 영혼 조각 위예요. 들고 있으면 렌즈가 서 있는 곳의 레이 세기를 보여주고 주변 땅에 그리며, 레이 수집기나 사역마에 웅크리며 사용하면 수치가 나와요.",
		"방법: 유리판, 구리 공명기, 영혼 조각을 세로로."
	]
	quest.420000000022801C.title: "레이를 보다"
	quest.420000000022801D.quest_desc: [
		"레드스톤과 구리 공명기 위에 석영, 그 아래 변경의 돌. 어떤 파동 저장체를 향해도, 저장된 양에 비례해 레드스톤 0에서 15를 내보내요.",
		"방법: 석영, 레드스톤 둘, 구리 공명기, 변경의 돌."
	]
	quest.420000000022801D.title: "파동을 위한 바늘"
	quest.420000000022801E.quest_desc: [
		"레드스톤과 구리 공명기 위에 레드스톤 횃불, 그 아래 변경의 돌. 향한 저장체가 문턱 이상이면 신호를 내보내요. 우클릭으로 25, 50, 75, 100퍼센트를 돌려요. 파동으로 움직이는 자동화의 부품이에요.",
		"방법: 레드스톤 횃불, 레드스톤 둘, 구리 공명기, 변경의 돌."
	]
	quest.420000000022801E.title: "노래의 한 줄"
	quest.420000000022801F.quest_desc: [
		"영혼 코덱스를 아무 부족 블록에나 웅크려 사용하면 단순한 보고가 나와요. 저장된 파동, 그것을 먹이는 발전기, 여덟 블록 안의 조율, 현재 제작법에 빠진 것, 가득 찬 출력, 레드스톤 정지, 불러오지 않은 중계 끝. 모르던 것을 알려 주면 이것을 체크하세요.",
		"방법: 영혼 코덱스를 부족 블록에 웅크려 사용하세요. 보고가 진짜 고장을 짚으면 체크하세요."
	]
	quest.420000000022801F.title: "코덱스에 이유를 물어요"
	quest.4200000000228020.quest_desc: [
		"돌의 샘에 조약돌을 청하세요. 돌은 만들지 않아요. 돌에게 머물러 달라고 청해요. 조약돌에는 형태와 파동만 필요해요. 여덟 블록 안의 대지의 토템이 있으면 돌을 청할 수 있어요.",
		"방법: 조약돌 다섯, 메아리 파편, 북심장."
	]
	quest.4200000000228020.title: "돌의 샘"
	quest.4200000000228021.quest_desc: [
		"아무 무늬나 완성하세요. 배치가 의식이에요. 흩어진 장치는 의식이 아니에요.",
		"방법: 영혼 코덱스의 의식 무늬를 놓으세요. 처음 원이 완성되면 발전 과제가 발동해요."
	]
	quest.4200000000228021.title: "원을 그려요"
	quest.4200000000228022.quest_desc: [
		"돌의 샘에 첫 조약돌을 청하세요. 돌은 만들지 않아요. 돌에게 머물러 달라고 청해요.",
		"방법: 조약돌이 나올 때까지 돌의 샘을 돌리세요. 처음 머물 때 발전 과제."
	]
	quest.4200000000228022.title: "돌은 머물러요"
	quest.4200000000228023.quest_desc: [
		"샘이 일하는 동안 영혼 코덱스를 웅크려 사용하세요. 보고가 저장된 파동이나 빠진 토템을 짚으면 체크하세요.",
		"방법: 돌의 샘에 영혼 코덱스를 웅크려 사용하세요. 보고가 진짜 고장이나 가득 찬 버퍼를 짚으면 체크하세요."
	]
	quest.4200000000228023.title: "샘이 답해요"
	quest.4200000000228024.quest_desc: [
		"샘에 충전된 셀을 두어, 청함이 멈추지 않게 하세요.",
		"방법: 북심장에서 파동 셀을 채운 뒤, 샘이 공급받으면 체크하세요."
	]
	quest.4200000000228024.title: "샘의 셀"
	quest.4200000000228025.quest_desc: [
		"망은 광석을 찾지 않아요. 망은 광석이 내릴 곳을 줘요. 듣는 구덩이 위에 앉히세요.",
		"방법: 변경의 돌 넷, 조율된 메아리 둘, 영혼 직물 둘, 구리 공명기."
	]
	quest.4200000000228025.title: "듣는 망"
	quest.4200000000228026.quest_desc: [
		"닻돌 넷이 구덩이 모서리를 잡아요. 그것들이 없으면 망이 설 곳이 없어요.",
		"방법: 메아리 파편 위에 변경의 돌 넷. 넷이 나와요."
	]
	quest.4200000000228026.title: "닻 넷"
	quest.4200000000228027.quest_desc: [
		"듣는 구덩이를 통해 첫 광석을 불러 올리세요.",
		"방법: 닻돌이 있는 구덩이 위에 공명 망. 첫 광석에 발전 과제가 발동해요."
	]
	quest.4200000000228027.title: "땅에 물어요"
	quest.4200000000228028.quest_desc: [
		"구덩이의 금 모래알은 철 다음의 목소리예요.",
		"방법: 땅에 계속 물으세요. 금 모래알이 손에 있으면 체크하세요."
	]
	quest.4200000000228028.title: "구덩이의 금"
	quest.4200000000228029.quest_desc: [
		"구덩이는 파동을 써요. 망 위에 셀을 두어, 청함이 멈추지 않게 하세요.",
		"방법: 북심장에서 파동 셀을 채우고, 코덱스가 가리키는 곳에 앉히세요."
	]
	quest.4200000000228029.title: "구덩이가 박자를 지켜요"
	quest.420000000022802A.quest_desc: [
		"문틀 열하나와 쐐기돌이 길을 고리로 둘러요. 빠진 틀은 빠진 걸음이에요.",
		"방법: 변경의 돌 여섯, 구리 주괴 둘, 메아리 파편. 넷이 나와요."
	]
	quest.420000000022802A.title: "길을 위한 틀"
	quest.420000000022802B.quest_desc: [
		"쐐기돌은 열두 번째 돌이에요. 그것이 없으면 고리는 무늬일 뿐이에요.",
		"방법: 문틀 넷, 공명 핵, 영혼 조각, 파동 셀."
	]
	quest.420000000022802B.title: "쐐기돌"
	quest.420000000022802C.quest_desc: [
		"길의 문에 불을 켜요. 틀 열하나, 쐐기돌 하나, 그리고 있을 곳.",
		"방법: 고리를 마치고 불을 켜세요. 길이 열리면 발전 과제가 발동해요."
	]
	quest.420000000022802C.title: "길을 열어요"
	quest.420000000022802D.quest_desc: [
		"쐐기돌에 인장을 웅크려 사용해 적어두세요. 두 번째 쐐기돌에 쓰면 둘을 묶어요.",
		"방법: 빈 인장, 베틀 실, 영혼 조각, 무정형."
	]
	quest.420000000022802D.title: "목적지를 적어요"
	quest.420000000022802E.quest_desc: [
		"먼 문으로 한 차원에서 다른 차원으로 건너세요. 베틀은 실 한 가닥이 아니었어요.",
		"방법: 문의 인장으로 쐐기돌 둘을 묶은 뒤, 먼 문을 걸으세요."
	]
	quest.420000000022802E.title: "긴 실"
	quest.420000000022802F.quest_desc: [
		"불의 발전기예요. 토템 가까이 앉히세요. 손에 든 북심장은 이 목소리를 돌리지 못해요.",
		"방법: 구리 주괴 셋, 잔불 매듭, 불 인장, 변경의 판자 둘."
	]
	quest.420000000022802F.title: "불의 목소리"
	quest.4200000000228030.quest_desc: [
		"바람의 발전기예요. 토템 가까이 앉혀, 여섯이 서로 듣게 하세요.",
		"방법: 영혼 직물 넷, 폭풍 날개, 바람 인장, 변경의 판자 둘."
	]
	quest.4200000000228030.title: "바람의 목소리"
	quest.4200000000228031.quest_desc: [
		"물의 발전기예요. 토템 가까이 앉히세요. 저수조와 샘이 이 목소리를 들어요.",
		"방법: 가죽 둘, 변경의 판자 셋, 매듭 뿌리, 물의 인장."
	]
	quest.4200000000228031.title: "물의 목소리"
	quest.4200000000228032.quest_desc: [
		"깨움의 종은 영혼의 긴 음이에요. 토템 가까이, 다른 다섯과 함께 앉히세요.",
		"방법: 종 조각, 구리 주괴 넷, 영혼의 인장, 영혼 조각."
	]
	quest.4200000000228032.title: "대지의 깨어남"
	quest.4200000000228033.quest_desc: [
		"여섯 번째 발전기예요. 베틀의 목소리는 베틀 실이 필요해요. 불리지 않은 자와 베틀 바느질꾼 장로가 그것을 보관해요.",
		"방법: 변경의 수정 넷, 베틀 실 둘, 영혼 직물 둘, 공명 핵."
	]
	quest.4200000000228033.title: "여섯 번째 발전기"
	quest.4200000000228034.quest_desc: [
		"돌무지는 장에 파동을 모아, 여섯 목소리가 하나의 완충을 나눠 써요.",
		"방법: 변경의 돌 여섯, 묶인 메아리 둘, 파동 셀."
	]
	quest.4200000000228034.title: "파동의 돌무지"
	quest.4200000000228035.quest_desc: [
		"발전기 여섯이 서로 32블록 안에서, 목소리마다 하나씩, 모두 돌게 하세요.",
		"방법: 잿불 뿔피리, 바람 하프, 파도 북, 깨어남의 종, 베틀 닻, 북심장을 32 안에. 목소리 여섯이면 발전 과제."
	]
	quest.4200000000228035.title: "노래하는 여섯 목소리"
	quest.4200000000228036.quest_desc: [
		"저수조더러 계속 주게 청해요. 십 분 동안의 물이고, 인장은 남아요.",
		"방법: 맞는 인장과 파동이 있는 의식의 원 안의 의식 화로에 석판을 웅크리며 사용하세요."
	]
	quest.4200000000228036.title: "계속 주는 샘"
	quest.4200000000228037.quest_desc: [
		"불리지 않은 자가 아직 기억하는 북의 원. 선택인 기념품이에요.",
		"방법: 침묵의 북에 있는 불리지 않은 자가 떨어뜨릴 수 있어요. 선택이에요."
	]
	quest.4200000000228037.title: "북의 원"
	quest.4200000000228038.quest_desc: [
		"첫 의식 뒤의 빈 인장, 다음 원을 위해 준비됐어요.",
		"방법: 화로에서 첫 의식. 여분의 빈 인장을 손에 들었을 때 체크하세요."
	]
	quest.4200000000228038.title: "여분의 인장"
	quest.4200000000228039.quest_desc: [
		"불의 작업장이에요. 여덟 안의 불의 토템과 파동이 광물 모래알을 포함해 화로 제작법을 모두 돌려요. 손에 든 북심장은 이 가마를 유지하지 못해요.",
		"방법: 화로 + 공명기 + 방울. 불의 토템. 파동으로 모래알을 제련해요. 손에 든 북심장은 돌리지 못해요."
	]
	quest.4200000000228039.title: "가마 속의 모래알"
	quest.420000000022803A.quest_desc: [
		"작업장을 위해 조제 인장을 짜요. 빈 병은 담겼던 칸으로 돌아와요. 측면 입출력은 관전자와 다른 야영지를 거절해요. 5.0부터는 여덟 블록 안에 응답 중인 공명 토템(베틀)을 원하고, 없으면 멈춰 서서 빠진 목소리를 말해요.",
		"방법: 영혼 코덱스가 인장 베틀 제작을 알려 줘요. 병을 앉히면 그 칸으로 돌아와요."
	]
	quest.420000000022803A.title: "인장을 위한 베틀"
	quest.420000000022803B.quest_desc: [
		"싼 파동 등 넷(빛나는 갈대, 파편 등, 메아리 벽등, 잿불 그릇)이 격자에서 초당 파동 1–2를 뽑아요. 레드스톤이 그것들을 어둡게 해요.",
		"방법: 파편 등을 만들어 파동에서 여덟 블록 안에 놓고, 밤을 원하면 레드스톤으로 어둡게 하세요."
	]
	quest.420000000022803B.title: "파동을 마시는 등"
	quest.420000000022803C.quest_desc: [
		"영혼 부적 열 개는 부족 칸 셋에 차요. Curios는 없어요. 하늘을 바람에 묶으면 크리에이티브 비행이에요. 공명 토템을 웅크려 사용해 목소리를 결속하세요. 합창은 화로에서 근처의 목소리를 모두 결속해요.",
		"방법: 하늘 부적을 만든 뒤, 바람 토템에 웅크려 사용하세요. 영혼 코덱스: 영혼 부적."
	]
	quest.420000000022803C.title: "목소리가 있는 부적"
	quest.420000000022803D.quest_desc: [
		"물의 작업장이에요. 영혼 장비와 같이 메아리 거점에서 등급을 올리세요. 등급이 높을수록 빨라지며 파동을 더 써요. 등급은 집어 들어도 남아요. 5.0부터는 여덟 블록 안에 응답 중인 물의 공명 토템을 원하고, 없으면 멈춰 서서 빠진 목소리를 말해요.",
		"방법: 영혼 코덱스의 작업장 페이지. 조수 펌프를 저수조 면에 놓고, 계속 조용하면 코덱스를 웅크려 사용하세요."
	]
	quest.420000000022803D.title: "저수조용 펌프"
	quest.420000000022803E.quest_desc: [
		"파동은 여전히 하나당 100 FE가 돼요. 무등급 변환은 초당 60 파동이에요. 메아리 조율, 그다음 메아리 결속, 그다음 메아리 현현에서 어댑터의 등급을 올리면, 맨손 상태가 현재 속도를 알려 줘요. 그래도 FE는 받을 수 없어요.",
		"방법: 조화 활성기를 메아리 조율, 그다음 메아리 결속, 그다음 메아리 현현에 웅크려 사용하세요. 진단이 60을 넘는 속도를 말하면 체크하세요."
	]
	quest.420000000022803E.title: "전류의 등급"
	quest.420000000022803F.quest_desc: [
		"놓아 둔 공명 토템(파동 40)에 영혼 장비 조각이나 부적을 웅크려 사용해 그 목소리를 결속하세요. 섞어 차는 것이 의도예요. 토템은 소모되지 않아요. 베틀에는 베틀 토템이 필요해요.",
		"방법: 근처에 파동 40이 있는 토템에 도구, 방어구, 또는 부적을 웅크려 사용하세요. 툴팁이 결속된 목소리를 말하면 체크하세요."
	]
	quest.420000000022803F.title: "목소리를 결속"
	quest.4200000000228040.quest_desc: [
		"갈대 등이에요. 야영지 길에 쓸 싼 파동 불빛. 선택이에요.",
		"방법: 빛나는 갈대를 만드세요. 파동 가까이에 놓으세요. 선택이에요."
	]
	quest.4200000000228040.title: "갈대 불빛"
	quest.4200000000228041.quest_desc: [
		"파동을 마시는 벽등이에요. 선택이에요.",
		"방법: 메아리 벽등을 만들어 거세요. 선택이에요."
	]
	quest.4200000000228041.title: "메아리 벽등"
	quest.4200000000228042.quest_desc: [
		"파동으로 켜는 야영지 불빛의 그릇이에요. 선택이에요.",
		"방법: 잿불 그릇을 만드세요. 선택이에요."
	]
	quest.4200000000228042.title: "잔불 그릇"
	quest.4200000000228043.quest_desc: [
		"바람 부적을 천장에 거세요. 변경 야영지 가구: 걸상, 탁자, 항아리, 자리, 선반, 그리고 이것. 선택이에요.",
		"방법: 바람 부적을 만들어 거세요. 선택인 기념품이에요."
	]
	quest.4200000000228043.title: "바람 위의 부적"
	quest.4200000000228044.quest_desc: [
		"합창은 의식 화로에서 근처 토템의 목소리를 모두 결속해요. 하늘이 손에 있으면 선택이에요.",
		"방법: 합창 부적을 만든 뒤, 목소리가 범위 안인 화로에서 웅크려 사용하세요. 선택이에요."
	]
	quest.4200000000228044.title: "근처의 모든 목소리"
	quest.4200000000228045.quest_desc: [
		"도끼는 곡괭이처럼 파동을 써요. 메아리 거점에서 등급을 올리고, 토템을 웅크려 사용해 목소리를 결속하세요. 선택이에요.",
		"방법: 영혼 장비 도끼를 만드세요. 곡괭이가 있으면 선택이에요."
	]
	quest.4200000000228045.title: "목재의 날"
	quest.4200000000228046.quest_desc: [
		"벽돌과 그릇을 구리 세 개 위에 놓아요. 켜진 모닥불, 불, 마그마, 용암 또는 잿불 그릇 위에 두세요. 파동은 전혀 요구하지 않아요. 재료는 최대 넷과 그릇 하나, 순서는 상관없고, 한 끼에 약 열두 초예요. 호퍼는 위와 옆에서 넣고, 아래에서 끼니를 꺼내요.",
		"방법: 벽돌과 그릇을 구리 세 개 위에 놓아요. 모닥불, 불, 마그마, 용암 또는 잿불 그릇 위에 두세요. 파동은 없어요."
	]
	quest.4200000000228046.title: "야영지용 솥"
	quest.4200000000228047.quest_desc: [
		"잿불 황무지의 뜨거운 붉은 덩이줄기예요. 딴 것이 씨앗이에요. 감자처럼 경작지에 심으세요. 영혼 장비 괭이가 한 번에 거두고 다시 심어요.",
		"방법: 문의 북을 통해 잿불 황무지에서 야생으로 자라요. 딴 것이 씨앗이에요. 경작지에 심으세요."
	]
	quest.4200000000228047.title: "잿불 뿌리"
	quest.4200000000228048.quest_desc: [
		"갈대 습지에서 야생으로 자라요. 한 무더기를 따서, 딴 것을 심으세요. 갈아 놓은 땅에서 네 단계로 자라고, 벌이 수분해요.",
		"방법: 문의 북을 통해 갈대 습지에서 야생으로 자라요. 딴 것을 경작지에 심으세요."
	]
	quest.4200000000228048.title: "습지 쌀"
	quest.4200000000228049.quest_desc: [
		"눈밭에서 나요. 영혼 주전자의 약초로도 쳐요.",
		"방법: 문의 북을 통해 눈밭에서 야생으로 자라요. 딴 것을 경작지에 심으세요."
	]
	quest.4200000000228049.title: "서리 열매"
	quest.420000000022804A.quest_desc: [
		"미광 능선에서 나요. 영혼 주전자의 약초이면서 작물이기도 해요.",
		"방법: 문의 북을 통해 미광 능선에서 야생으로 자라요. 딴 것을 경작지에 심으세요."
	]
	quest.420000000022804A.title: "미광 콩"
	quest.420000000022804B.quest_desc: [
		"초원에서 나며, 부족 요리 대부분이 이 곡식으로 돼요. 나머지보다 먼저 한 이랑 기르세요.",
		"방법: 문의 북을 통해 초원에서 야생으로 자라요. 딴 것을 경작지에 심으세요."
	]
	quest.420000000022804B.title: "초원 곡식"
	quest.420000000022804C.quest_desc: [
		"초원 곡식 둘과 철 모래알 하나, 화로 솥에. 부족 요리를 먹으면 그 은혜를 오 분 동안 실어요. 자갈 가수의 것은 광석에서 더 많이 깨요. 부족이 당신을 친구라 부르면 그 친척이 작물 넷에 그 요리를 팔고, 부족의 화로에 그 부족의 요리를 바치면 위상 여섯을 받아요.",
		"방법: 초원 곡식 둘과 철 모래알을 열 위의 화로 솥에. 자갈 가수의 친척이 친구 평판에서 이걸 팔아요."
	]
	quest.420000000022804C.title: "자갈 가수의 빵"
	quest.420000000022804D.quest_desc: [
		"날 사냥감 둘과 잿불 뿌리 하나. 날 사냥감은 변경의 사냥감에게서 떨어져요. 가장자리 보행자의 은혜: 웅크린 동안 떨어지지 않아요. 부족마다 요리가 있어요. JEI 가 솥 아래에 아홉을 모두 적어요.",
		"방법: 날 사냥감 둘과 잿불 뿌리를 화로 솥에. 날 사냥감은 변경의 사냥감에게서 떨어져요."
	]
	quest.420000000022804D.title: "가장자리 보행자의 육포"
	quest.420000000022804E.quest_desc: [
		"지킴이의 뿌리 으깸, 모래알 구운 빵, 잿불 뿌리와 초원 곡식을 솥에. 잔치를 단단한 블록 위에 놓으면 여섯 인분을 담아요. 어느 몫이든 배를 채우고, 팔 분 동안 대지의 축복을 줘요 — 더 빨리 파고, 굳게 버텨요. 목소리마다 자기 요리의 잔치가 있어요.",
		"방법: 지킴이의 뿌리 으깸, 모래알 구운 빵, 잿불 뿌리, 초원 곡식을 화로 솥에. 놓으세요. 여섯 인분."
	]
	quest.420000000022804E.title: "야영지의 상"
	quest.420000000022804F.quest_desc: [
		"가마솥 둘레에 뼈와 철, 그 아래에 뼈 방울. 열 위에 두세요. 자리 셋: 주머니에서 꺼낸 가공하지 않은 시약, 변경의 풀, 바탕 — 유리병은 팅크 둘, 벌집 조각은 연고 둘, 목탄은 향 넷. 한 번은 십 초이고 격자에서 파동 24예요. 여덟 블록 안의 가장 가까운 토템이 달임에 노래를 넣어요.",
		"방법: 가마솥 둘레에 뼈와 철, 아래에 뼈 방울. 열 위에 두세요. 8 안의 토템이 달임을 빚어요."
	]
	quest.420000000022804F.title: "불 위의 주전자"
	quest.4200000000228050.quest_desc: [
		"시약의 계열이 약을 고르요: 불쏘시개는 힘, 냉각은 화염 저항, 해독제는 독을 풀고, 수선은 재생, 그런 식이에요. 팅크는 삼 분 가고, 병을 돌려줘요. 어떤 약이든 영혼 병, 불리지 않은 고요, 해짐, 레이 병을 풀어요.",
		"방법: 영혼 주전자 — 가공하지 않은 시약, 변경의 풀, 유리병. 십 초, 파동 24, 팅크 둘."
	]
	quest.4200000000228050.title: "마셔요"
	quest.4200000000228051.quest_desc: [
		"바탕은 벌집 조각이에요. 연고는 자신이나 친구, 주민, 사역마에게 쓰세요: 한 번에 하트 셋, 해로운 효과는 모두 사라지고, 약은 팅크 시간의 절반이에요. 이것을 한 묶음 가진 것이 변경의 힘든 밤과 집까지 걸어가는 길의 차이예요.",
		"방법: 영혼 주전자 — 가공하지 않은 시약, 변경의 풀, 벌집 조각. 한 번에 연고 둘."
	]
	quest.4200000000228051.title: "바르세요"
	quest.4200000000228052.quest_desc: [
		"바탕은 목탄이에요. 향을 의식 화로대에 앉히세요 — 열여섯 개까지, 인장도 파동도 없이 — 이 초마다 여덟 블록 안의 모두가 약을 받고, 사역마는 하트 하나가 수선돼요. 한 개는 삼십 초 타요. 레드스톤이 끄고, 맨손으로 웅크리면 도로 가져가세요.",
		"방법: 영혼 주전자 — 가공하지 않은 시약, 변경의 풀, 목탄. 한 번에 향 넷. 의식 화로대에서 태우세요."
	]
	quest.4200000000228052.title: "모두를 위해 태워요"
	quest.4200000000228053.quest_desc: [
		"막대기 위 현현 주괴 양옆에 뼈 방울 둘이에요. 사용을 길게 누르면, 반초마다 여섯 블록 안에서 바라보는 상대나 당신을 파동 2로 하트 사분의 삼만큼 수선해요. 나머지 영혼 장비처럼 메아리 작업대에서 등급을 받고, 결속부터는 흔들 때마다 영혼 병이 한 단계 풀려요.",
		"방법: 막대기 위 현현 주괴 양옆에 뼈 방울 둘. 사용을 길게 눌러 바라보는 상대를 수선하세요."
	]
	quest.4200000000228053.title: "흔들어요"
	quest.4200000000228054.quest_desc: [
		"조약돌을 마그마 블록 위에 두면 넷이 나와요. 열 위에서는 김이 나요. 뜨거운 돌이 다섯 블록 안에 있고 머리 위에 지붕이 있는 침대에서 밤을 통째로 자면, 완전히 치유되고 정화되어 깨며, 영혼의 축복이 십 분 붙어 병이 자리 잡지 못해요.",
		"방법: 마그마 블록 위에 조약돌, 넷이 나와요. 지붕 있는 침대에서 다섯 블록 안, 열 위에 두세요."
	]
	quest.4200000000228054.title: "오두막의 밤"
	quest.4200000000228055.quest_desc: [
		"돌 둘, 이끼등 비늘과 영혼 갈대를 영혼 인장 둘레에 두면, 인장은 되돌려줘요. 의식의 원 안에서 영혼 인장이 앉은 화로에 500 파동으로 시전하면, 열두 블록 안의 모두가 하트 열 칸 치유되고 정화와 축복을 받으며, 원은 십 분 열려 있어요. 쓰러진 사역마의 영혼 잔재를 먼저 받침대에 올리면, 온전한 모습으로 돌아와요.",
		"방법: 돌 둘, 이끼등 비늘, 영혼 갈대, 영혼 인장, 무정형. 인장이 돌아와요. 의식의 원 안, 인장이 앉은 화로에 시전하세요."
	]
	quest.4200000000228055.title: "의식 서판: 치유의 원"
	quest.4200000000228056.quest_desc: [
		"현현 주괴, 뼈 방울, 막대기를 대각선으로 놓아요. 피해 7, 사거리 하나 반 추가, 달리며 찌르면 35퍼센트 더 세게 맞아요. 그 아래는 칼날이에요. 메아리 작업대에서 등급을 받고, 메아리 타격에 파동을 쓰며, 토템의 목소리를 받아요. 균열 사냥개를 팔 길이만큼 떨어뜨려 둬요.",
		"방법: 현현 주괴, 뼈 방울, 막대기를 대각선으로. 메아리 작업대에서 칼날처럼 등급을 받아요."
	]
	quest.4200000000228056.title: "먼저 사거리"
	quest.4200000000228057.quest_desc: [
		"현현 주괴 넷을 T자로 뼈 방울 위에 놓아요. 피해 10, 사거리 반 추가, 무거워요 — 손에 들고 있는 동안 걸음이 느려져요 — 그리고 일족에서 가장 넓고 가장 센 휩쓸기예요. 미늘창, 전투 도끼, 전쟁 망치, 단검, 낫, 삼지창도 같은 방식으로 만들고, 각각 사거리, 속도, 무게를 서로 맞바꿔요.",
		"방법: 현현 주괴 넷을 T자로 뼈 방울 위에. 무거워요. 가장 넓은 휩쓸기예요."
	]
	quest.4200000000228057.title: "가장 넓은 휩쓸기"
	quest.4200000000228058.quest_desc: [
		"실과 구리 공명기를 뼈 방울 둘레에 둬요. 지니고 있는 셀의 파동으로 음파탄을 쏘고, 시구 화살도 받아요. 다시 놓기가 빠르고, 급할 때는 반만 당겨도 돼요.",
		"방법: 실과 구리 공명기를 뼈 방울 둘레에. 지니고 있는 파동으로 음파탄을 쏴요."
	]
	quest.4200000000228058.title: "노래하는 활"
	quest.4200000000228059.quest_desc: [
		"파동 활 양옆에 현현 주괴를, 아래에는 철사 덫 갈고리와 막대기를 놓으세요. 사용을 길게 눌러 장전하세요——미리 파동 10, 완전 당김보다 조금 더 김——그러고 다시 사용해 쏘세요. 약 1.5배의 세기로 맞히고, 거의 곧게 날며, 원하는 만큼 시위를 유지해요.",
		"방법: 파동 활 양옆에 현현 주괴, 아래에는 철사 덫 갈고리와 막대기. 사용을 길게 눌러 장전하고, 사용해 쏘세요."
	]
	quest.4200000000228059.title: "활의 더 무거운 자매"
	quest.420000000022805A.quest_desc: [
		"노래 작업대에는 결과 옆에 무기 자리가 있어요. 손이 닿는 곳에 토템을 세우고 격자에 파동을 넣은 뒤, 한 종류의 강화한 시약 넷이 든 시약 주머니를 단축바에 두고, 영혼 장비 무기를 앉히고, 시약을 골라 도유를 누르세요: 시약 넷과 파동 32예요. 작열은 태우고, 폭풍부름은 번개를 호로 날리고, 피의 갈증은 생명을 빼앗고, 수선은 무기를 고치며, 모두 열하나로 한 번에 하나이고, 다른 시약이 그것을 바꿔요. 팩이 tribalpower:anointable 을 열지 않으면 작업대의 일을 받는 것은 영혼 장비뿐이에요. 무기가 하나를 지니면 이것을 체크하세요.",
		"방법: 노래 작업대의 무기 자리에 영혼 장비 무기를 두고, 주머니에 강화한 시약 넷, 파동 32로 도유를 누르세요. 도유되면 체크하세요."
	]
	quest.420000000022805A.title: "칼날 속의 시약"
	quest.420000000022805B.quest_desc: [
		"영혼 갈대 둘레에 덩굴, 그리고 엔더 진주로 둘이 나와요. 같은 기둥의 각 층에 하나씩 두면, 서로를 찾고, 연결과 동력이 필요 없어요. 점프하면 위의 다음 승강기로 오르고, 웅크리면 아래의 것으로 내려가며, 각 방향 48블록까지예요. 위에 천장이 있는 승강기는 건너뛰어요.",
		"방법: 영혼 갈대 둘레에 덩굴과 엔더 진주로 둘이 나와요. 한 기둥에 쌓고, 점프로 오르고, 웅크리기로 내려요."
	]
	quest.420000000022805B.title: "기둥 위로"
	quest.420000000022805C.quest_desc: [
		"끈 아래에 영혼 갈대. 생물에 사용해 담고, 블록에 사용해 내려놓으면, 안전하고 온전해요. 플레이어나 보스, 변경의 정예는 안 돼요. 짠 것은 두 번, 한 번 왕복이고, 구리와 현현과 공명 항아리는 더 담으며, 공명은 닳지 않아요. 사용이 한 번만 남으면 생물을 담지 않아요.",
		"방법: 끈 아래에 영혼 갈대. 생물에 사용해 담고, 블록에 사용해 내려놓으세요. 두 번."
	]
	quest.420000000022805C.title: "생물을 집으로 나르기"
	quest.420000000022805D.quest_desc: [
		"소리 블록 둘레, 판자 위에 가죽. 문의 의식을 끝에 차원문이 없는 놀이로 해요. 들어 있는 모든 곡을, 박이 선에 닿을 때 A, S, D, F 로 연주해요. 곡마다 최고 점수와 서버 상위 다섯의 게시판을 남겨요. 진짜 문의 북 전에 여기서 연습하세요.",
		"방법: 소리 블록 둘레, 판자 위에 가죽. 사용해서 곡을 고르고 A, S, D, F 로 연주하세요."
	]
	quest.420000000022805D.title: "즐거움의 북"
	quest.420000000022805E.quest_desc: [
		"영혼의 인장 둘레에 발광석 넷, 현현 주괴 둘, 황금 당근, 영혼 직물. 사용하면 착용하고, 웅크린 채 사용하면 부적 칸 셋이 열려요. 등롱 부적은 영의 목소리를 실어요. 야간 투시, 그리고 당신에게 걸린 목소리 축복은 무엇이든 절반만큼 더 오래가요. 착용한 부적은 들고 있는 파동 셀에서, 목소리마다 2초마다 파동 2를 써요.",
		"방법: 영혼의 인장 둘레에 발광석 넷, 현현 주괴 둘, 황금 당근, 영혼 직물. 사용하면 착용하고, 웅크린 채 사용하면 칸이 열려요."
	]
	quest.420000000022805E.title: "착용하는 빛"
	quest.420000000022805F.quest_desc: [
		"부족이 당신을 손님이라고 하면, 그 장로를 우클릭해서 이야기하세요. 일을 부탁하면 부탁을 건네요 — 하루에 셋이 열리고, 부족마다 하나만 들고, 각각이 평판을 주며, 세 번째마다 부족 표식이에요. 이야기를 부탁하면 일곱 걸음의 길이 시작돼요. 친구, 그들이 아끼는 것, 불 가까이에서의 사냥, 야영지의 의식, 그들의 요리, 그리고 보내는 곳. 마지막 걸음은 수호자와의 시련이에요. 이야기 하나를 끝내고 그 유물을 드세요.",
		"방법: 손님 이상에서 부족의 장로를 우클릭하고 이야기를 부탁하세요. 일곱 걸음은 수호자에서 끝나요. 첫 유물에서 발전 과제가 발동해요."
	]
	quest.420000000022805F.title: "들려준 이야기"
	quest.4200000000228060.quest_desc: [
		"공중섬 지킴이의 유물이에요. 그들의 이야기는 초원의 짓밟힌 고리에 있는 쇄도의 영에서 끝나고, 시련에서 이기면 장로가 그것을 건네요. 소지품 어디에 두어도 평판이 어떻든 그들의 은혜를 유지해요. 밭을 절대 짓밟지 않아요.",
		"방법: 공중섬 지킴이의 이야기를 장로와 끝내세요. 시련은 초원의 쇄도의 영이에요."
	]
	quest.4200000000228060.title: "간직한 잿불"
	quest.4200000000228061.quest_desc: [
		"자갈 가수의 유물이에요. 그들의 이야기는 수정 들판, 노래하는 균열의 프리즘 뱀에서 끝나고, 시련에서 이기면 장로가 유물을 건네요. 소지품 어디에 두어도 신임이 어떻든 그들의 은혜가 남고, 광석에서 더 많이 나와요.",
		"방법: 자갈 가수의 이야기를 그들의 장로와 끝내세요. 시련은 수정 들판의 프리즘 뱀이에요."
	]
	quest.4200000000228061.title: "울리는 돌"
	quest.4200000000228062.quest_desc: [
		"뿌리묶이의 유물이에요. 그들의 이야기는 갈대 습지, 잠긴 뿌리의 늪의 여족장에서 끝나고, 시련에서 이기면 장로가 유물을 건네요. 소지품 어디에 두어도 신임이 어떻든 그들의 은혜가 남고, 주변의 작물이 서둘러 자라요.",
		"방법: 뿌리묶이의 이야기를 그들의 장로와 끝내세요. 시련은 갈대 습지의 늪의 여족장이에요."
	]
	quest.4200000000228062.title: "첫 뿌리"
	quest.4200000000228063.quest_desc: [
		"가장자리 보행자의 유물이에요. 그들의 이야기는 고지의 보금자리에 있는 폭풍 로크에서 끝나고, 시련에서 이기면 장로가 유물을 건네요. 소지품 어디에 두어도 신임이 어떻든 그들의 은혜가 남고, 웅크리는 동안은 절대 떨어지지 않아요.",
		"방법: 가장자리 보행자의 이야기를 그들의 장로와 끝내세요. 시련은 고지의 폭풍 로크예요."
	]
	quest.4200000000228063.title: "다리 못"
	quest.4200000000228064.quest_desc: [
		"북심장의 유물이에요. 그들의 이야기는 잿불 황무지, 광재 왕좌의 광재 거신에서 끝나고, 시련에서 이기면 장로가 유물을 건네요. 소지품 어디에 두어도 신임이 어떻든 그들의 은혜가 남고, 더 빨리 휘둘러요.",
		"방법: 북심장의 이야기를 그들의 장로와 끝내세요. 시련은 잿불 황무지의 광재 거신이에요."
	]
	quest.4200000000228064.title: "고른 북"
	quest.4200000000228065.quest_desc: [
		"무늬 직공의 유물이에요. 이야기는 얕은 물의 조수의 돌에 있는 조수의 북꾼에서 끝나고, 시련에서 이기면 장로가 그것을 건네요. 소지품 어디에 두어도 신임이 어떻든 은혜가 남고, 근처의 메아리 작업대는 두 배로 일해요.",
		"방법: 무늬 직공의 이야기를 장로와 함께 끝내세요. 시련은 얕은 물의 조수의 북꾼이에요."
	]
	quest.4200000000228065.title: "고요한 톱니"
	quest.4200000000228066.quest_desc: [
		"군락 지킴이의 유물이에요. 이야기는 눈밭의 돌무덤 고리에 있는 돌무덤 망령에서 끝나고, 시련에서 이기면 장로가 그것을 건네요. 소지품 어디에 두어도 신임이 어떻든 은혜가 남고, 쏘이지 않아요.",
		"방법: 군락 지킴이의 이야기를 장로와 함께 끝내세요. 시련은 눈밭의 돌무덤 망령이에요."
	]
	quest.4200000000228066.title: "벌집 인장"
	quest.4200000000228067.quest_desc: [
		"인장 조각가의 유물이에요. 이야기는 미광 능선의 봉인된 문에 있는 금고 파수꾼에서 끝나고, 시련에서 이기면 장로가 그것을 건네요. 소지품 어디에 두어도 신임이 어떻든 은혜가 남고, 부적은 파동을 절반만 요구해요.",
		"방법: 인장 조각가의 이야기를 장로와 함께 끝내세요. 시련은 미광 능선의 금고 파수꾼이에요."
	]
	quest.4200000000228067.title: "공손한 인장"
	quest.4200000000228068.quest_desc: [
		"베틀 바느질꾼의 유물이에요. 이야기는 침묵의 북에 있는 불리지 않은 자에서 끝나고, 시련에서 이기면 장로가 그것을 건네요. 소지품 어디에 두어도 신임이 어떻든 은혜가 남고, 더 싸게 노래해요.",
		"방법: 베틀 바느질꾼의 이야기를 장로와 함께 끝내세요. 시련은 침묵의 북에 있는 불리지 않은 자예요."
	]
	quest.4200000000228068.title: "아홉째 실"
	quest.4200000000228069.quest_desc: [
		"모든 부족의 이야기가 끝났어요: 수호자 여덟과 불리지 않은 자를 마주쳤어요. 유물 아홉이 모두 소지품에 있으면 아홉째 서약이 손에 닿아요. `/tribalpower standing` 이 각 부족과의 신임을 보여 줘요.",
		"방법: 이야기 아홉을 모두 끝내세요. 아홉째 유물이 손에 있으면 발전 과제가 발동해요."
	]
	quest.4200000000228069.title: "아홉 유물"
	quest.420000000022806A.quest_desc: [
		"잿불 황무지의 광재 왕좌예요. 돌 고리 한가운데 수호자의 제단이 있고, 윤이 나는 심층암 위, 켜진 초 네 개 사이, 위는 열린 하늘이에요. 빈손으로 웅크린 채 제단을 사용하면 원하는 것을 알려 줘요. 마그마 비늘 여덟이에요. 올려놓고 물러서세요. 내리찍기에 버티려면 웅크리세요. 격앙되면 고리가 불타고 잉걸 임프가 광재에서 일어나요. 체력이 절반이면 격앙되어 자기 나라의 생물을 불러요. 그것들은 아무것도 떨어뜨리지 않아요. 반 분만 내버려 두면 다시 잠들고, 제단은 호출 사이에 이십 분을 쉬어요. 광재 핵을 떨어뜨리고, 쓰러지면 북심장의 이야기가 끝나요.",
		"방법: 그 나라 수호자의 제단을 빈손으로 웅크려 사용하고, 말한 시약 여덟을 올려 이기세요. 처치하면 발전 과제가 발동해요."
	]
	quest.420000000022806A.title: "광재 거신, 잠잠해짐"
	quest.420000000022806B.quest_desc: [
		"갈대 습지의 잠긴 뿌리예요. 돌 고리 한가운데 수호자의 제단이 있고, 윤이 나는 심층암 위, 켜진 초 네 개 사이, 위는 열린 하늘이에요. 빈손으로 웅크린 채 제단을 사용하면 원하는 것을 알려 줘요. 갈대 송곳니 여덟이에요. 올려놓고 물러서세요. 올가미가 끌어당겨 느리게 해요. 단단한 땅에 머물고, 부르는 갈대 추적자를 베어 버리세요. 체력이 절반이면 격앙되어 자기 나라의 생물을 불러요. 그것들은 아무것도 떨어뜨리지 않아요. 반 분만 내버려 두면 다시 잠들고, 제단은 호출 사이에 이십 분을 쉬어요. 습지의 심장을 떨어뜨리고, 쓰러지면 뿌리묶이의 이야기가 끝나요.",
		"방법: 그 나라 수호자의 제단을 빈손으로 웅크려 사용하고, 말한 시약 여덟을 올려 이기세요. 처치하면 발전 과제가 발동해요."
	]
	quest.420000000022806B.title: "늪의 여족장, 잠잠해짐"
	quest.420000000022806C.quest_desc: [
		"눈밭의 돌무덤 고리예요. 돌 고리 한가운데 수호자의 제단이 있고, 윤이 나는 심층암 위, 켜진 초 네 개 사이, 위는 열린 하늘이에요. 빈손으로 웅크린 채 제단을 사용하면 원하는 것을 알려 줘요. 서리 큰턱 여덟이에요. 올려놓고 물러서세요. 숨결이 앞의 모든 것을 얼려요. 뒤로 돌아가세요. 부르는 서리 기는 자는 느려요. 체력이 절반이면 격앙되어 자기 나라의 생물을 불러요. 그것들은 아무것도 떨어뜨리지 않아요. 반 분만 내버려 두면 다시 잠들고, 제단은 호출 사이에 이십 분을 쉬어요. 돌무덤의 돌을 떨어뜨리고, 쓰러지면 군락 지킴이의 이야기가 끝나요.",
		"방법: 그 나라 수호자의 제단을 빈손으로 웅크려 사용하고, 말한 시약 여덟을 올려 이기세요. 처치하면 발전 과제가 발동해요."
	]
	quest.420000000022806C.title: "돌무덤 망령, 잠잠해짐"
	quest.420000000022806D.quest_desc: [
		"수정 들판의 노래하는 균열이에요. 돌 고리 한가운데 수호자의 제단이 있고, 윤이 나는 심층암 위, 켜진 초 네 개 사이, 위는 열린 하늘이에요. 빈손으로 웅크린 채 제단을 사용하면 원하는 것을 알려 줘요. 프리즘 갑각 여덟이에요. 올려놓고 물러서세요. 빛의 화살을 쏘아 당신을 빛나게 표시해요. 옆으로 움직이고 다가가세요. 격앙되면 더하는 두 번째 화살을 살피세요. 체력이 절반이면 격앙되어 자기 나라의 생물을 불러요. 그것들은 아무것도 떨어뜨리지 않아요. 반 분만 내버려 두면 다시 잠들고, 제단은 호출 사이에 이십 분을 쉬어요. 프리즘 핵을 떨어뜨리고, 쓰러지면 자갈 가수의 이야기가 끝나요.",
		"방법: 그 나라 수호자의 제단을 빈손으로 웅크려 사용하고, 말한 시약 여덟을 올려 이기세요. 처치하면 발전 과제가 발동해요."
	]
	quest.420000000022806D.title: "프리즘 뱀, 잠잠해짐"
	quest.420000000022806E.quest_desc: [
		"미광 능선의 봉인된 문이에요. 돌 고리 한가운데 수호자의 제단이 있고, 윤이 나는 심층암 위, 켜진 초 네 개 사이, 위는 열린 하늘이에요. 빈손으로 웅크린 채 제단을 사용하면 원하는 것을 알려 줘요. 파수 인장 여덟이에요. 올려놓고 물러서세요. 변경에서 가장 무거운 갑옷과, 능선 밖으로 던져 버리는 휩쓸기예요. 격앙되면 한 번에 삼 초씩 몸을 막아요. 지나가길 기다리세요. 체력이 절반이면 격앙되어 자기 나라의 생물을 불러요. 그것들은 아무것도 떨어뜨리지 않아요. 반 분만 내버려 두면 다시 잠들고, 제단은 호출 사이에 이십 분을 쉬어요. 금고의 인장을 떨어뜨리고, 쓰러지면 인장 조각가의 이야기가 끝나요.",
		"방법: 그 나라 수호자의 제단을 빈손으로 웅크려 사용하고, 말한 시약 여덟을 올려 이기세요. 처치하면 발전 과제가 발동해요."
	]
	quest.420000000022806E.title: "금고 파수꾼, 잠잠해짐"
	quest.420000000022806F.quest_desc: [
		"얕은 물의 조수의 돌: 돌 고리이고, 한가운데 수호자의 제단이 있어요. 윤이 나는 심층암 위, 켜진 초 네 개 사이, 위는 열린 하늘이에요. 빈손으로 웅크린 채 제단을 사용하면 원하는 것을 알려 줘요 — 염수 송곳니 여덟 — 그런 다음 올려놓고 물러서세요. 박마다 모두를 끌어당기고 다치게 해요. 물가에서 싸우세요. 등은 단단한 것에 기대세요. 체력이 절반이면 격앙되어 자기 나라의 생물을 불러요. 그것들은 아무것도 떨어뜨리지 않아요. 반 분만 내버려 두면 다시 잠들어요. 제단은 호출 사이에 이십 분을 쉬어요. 조수의 껍데기를 떨어뜨리고, 쓰러지면 무늬 직공의 이야기가 끝나요.",
		"방법: 그 나라 수호자의 제단을 빈손으로 웅크려 사용하고, 말한 시약 여덟을 올려 이기세요. 처치하면 발전 과제가 발동해요."
	]
	quest.420000000022806F.title: "조수의 북꾼, 잠잠"
	quest.4200000000228070.quest_desc: [
		"초원의 짓밟힌 고리: 돌 고리이고, 한가운데 수호자의 제단이 있어요. 윤이 나는 심층암 위, 켜진 초 네 개 사이, 위는 열린 하늘이에요. 빈손으로 웅크린 채 제단을 사용하면 원하는 것을 알려 줘요 — 정강이 힘줄 여덟 — 그런 다음 올려놓고 물러서세요. 돌진해요. 옆으로 피하고, 지나갈 때 치세요. 굴의 이갈이가 올라오면 블록 위에 서세요. 체력이 절반이면 격앙되어 자기 나라의 생물을 불러요. 그것들은 아무것도 떨어뜨리지 않아요. 반 분만 내버려 두면 다시 잠들어요. 제단은 호출 사이에 이십 분을 쉬어요. 무리의 뿔을 떨어뜨리고, 쓰러지면 공중섬 지킴이의 이야기가 끝나요.",
		"방법: 그 나라 수호자의 제단을 빈손으로 웅크려 사용하고, 말한 시약 여덟을 올려 이기세요. 처치하면 발전 과제가 발동해요."
	]
	quest.4200000000228070.title: "쇄도의 영, 잠잠"
	quest.4200000000228071.quest_desc: [
		"고지의 보금자리: 돌 고리이고, 한가운데 수호자의 제단이 있어요. 윤이 나는 심층암 위, 켜진 초 네 개 사이, 위는 열린 하늘이에요. 빈손으로 웅크린 채 제단을 사용하면 원하는 것을 알려 줘요 — 폭풍 날개 여덟 — 그런 다음 올려놓고 물러서세요. 급강하해서 당신을 공중으로 던져요. 격앙되면 급강하마다 번개가 따라와요. 활과 지붕이 방패보다 더 도움이 돼요. 체력이 절반이면 격앙되어 자기 나라의 생물을 불러요. 그것들은 아무것도 떨어뜨리지 않아요. 반 분만 내버려 두면 다시 잠들어요. 제단은 호출 사이에 이십 분을 쉬어요. 폭풍의 깃털을 떨어뜨리고, 쓰러지면 가장자리 보행자의 이야기가 끝나요.",
		"방법: 그 나라 수호자의 제단을 빈손으로 웅크려 사용하고, 말한 시약 여덟을 올려 이기세요. 처치하면 발전 과제가 발동해요."
	]
	quest.4200000000228071.title: "폭풍 로크, 잠잠"
	quest.4200000000228072.quest_desc: [
		"수호자의 핵 여덟과 불리지 않은 자의 심장, 무정형. 핵 하나와 베틀 실이면 대신 공명 핵이 여섯 나와요. 둘 다 원하면 떨어지는 것을 한 벌 더 가져가세요. 수호자마다 보스 바는 그 부족의 색을 입어요.",
		"방법: 수호자의 핵 여덟과 불리지 않은 자의 심장, 무정형. 유물 아홉을 지닌 채 베틀의 원에서 시전하세요."
	]
	quest.4200000000228072.title: "아홉의 석판"
	quest.4200000000228073.quest_desc: [
		"베틀의 원을 그리세요 — 의식의 원 안 화로에 베틀 인장을 앉힌 것 — 그리고 유물 아홉을 모두 지닌 채 석판을 시전하세요. 의식은 이루어지기 전에 자기 파동을 끌어요. 빛 아홉이 떠올라요. 각각 부족의 색으로 하나씩이에요. 그때부터 모든 부족이 적어도 혈족으로 대하고, 아홉 은혜가 한동안 당신에게 내려앉고, 오로라는 그 아래에 서는 밤마다 가득 타요. 플레이어당 한 번이에요. 두 번째 시전은 원만 밝혀요.",
		"방법: 의식의 원 안 화로에 베틀 인장, 소지품에 유물 아홉. 화로에 석판을 웅크린 채 사용하세요."
	]
	quest.4200000000228073.title: "베틀이 동의해요"
	quest.4200000000228074.quest_desc: [
		"베틀 역사의 조각 열여섯이 변경에 새겨져 있어요. 폐허 벽에 새긴 돌이 여덟, 수호자의 터에 둘×둘 벽화가 여덟이에요. 하나를 우클릭하면 읽혀요. 영혼 코덱스가 그것을 간직하고, 연대기 항목이 순서대로 놓아요. 열여섯을 모두 읽으면 이야기가 온전해져요.",
		"방법: 변경 폐허의 새긴 돌 여덟과 수호자의 터에 있는 벽화 여덟을 모두 우클릭하세요."
	]
	quest.4200000000228074.title: "온전한 연대기"
	quest.4200000000228075.quest_desc: [
		"변경 폐허의 벽에 박혀 있어요. 옛 작업장, 가라앉은 사당, 봉분, 무덤, 금고. 찾은 자리에서 읽고, 집어 자기 벽에 두세요. 읽은 것은 읽은 채로 남아요.",
		"방법: 변경 폐허의 벽에 박혀 있어요. 읽은 다음 부수고, 자기 벽에 두세요."
	]
	quest.4200000000228075.title: "기억하는 돌"
	quest.4200000000228076.quest_desc: [
		"각 수호자의 터에서 너비 두 블록, 높이 두 블록이에요. 각각 서 있는 나라를 그려요. 어느 부분을 읽어도 전부를 읽어요. 한 덩어리로 놓고, 한 덩어리로 내려요. 크리에이티브에서 자른 벽화는 웅크린 클릭으로 장이 바뀌어요.",
		"방법: 각 수호자의 터에 둘×둘로 서 있어요. 읽은 다음 통째로 떼어 집에 놓으세요."
	]
	quest.4200000000228076.title: "제 나라를 그리는 벽"
	quest.4200000000228077.quest_desc: [
		"변경은 스스로 움직여요. 재내림, 희광 폭풍, 백색 눈안개, 갈대 안개가 나라를 가두고 낮에 영을 일으켜요. 각각 한 목소리의 발전기를 먹이고, 다른 목소리의 것은 막아요. 가끔 한 목소리의 레이 실이 치솟아요. 그것을 나르는 수집기는 두 배를 내요. 하지만 수집기 없는 빈 교차점에 서면, 레이 병이 땅을 흔들고 파동을 빼요. 부족마다 차례로 축제 날을 가져요. 잔치에 들면 선물이 있어요. 곁으로 떠다니는 따뜻한 빛은 떠도는 영이에요. 닿으면 그 나라 이야기의 한 줄과 작은 선물을 받아요. 폭풍과 쇄도는 2분 전에, 채팅과 단축바 위에서 알려 줘요. 하나를 견디면 이것을 체크하세요.",
		"방법: 날씨, 쇄도, 축제 날 중 하나에 변경에 있으세요. 그러면 체크하세요."
	]
	quest.4200000000228077.title: "변경은 숨 쉬어요"
	quest.420000000023058C.quest_desc: [
		"자갈 가수는 돌을 두 번 같은 방식으로 자르지 않아요. 이 작업대는 모든 절단을 기억해요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 돌 + 작업대 부품은 JEI 에. 블록을 넣고 변형을 고르세요."
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"나무에도 같은 수예요. 하나에서 판자 백 개.",
		"방법: Chipped 목수 작업대는 JEI 에. 석공 작업대와 같은 생각이고, 나무용이에요."
	]
	quest.420000000023058D.title: "목수 작업대"
	quest.420000000023058E.quest_desc: [
		"모래를 유리로, 그리고 유리를 빛이 받을 모든 모양으로.",
		"방법: Chipped 작업대는 JEI 에 (석공, 목수, 유리 불기…). 블록을 작업대에 넣고 절단을 고르세요."
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"양털과 천, 다시 짠 것이에요. 베틀을 깁고 있는 공중섬에는 어울려요.",
		"방법: Chipped 작업대는 JEI 에 (석공, 목수, 유리 불기…). 블록을 작업대에 넣고 절단을 고르세요."
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"잎, 묘목, 자라는 것들이 변종별로 나뉘어 있어요.",
		"방법: Chipped 작업대는 JEI 에 (석공, 목수, 유리 불기…). 블록을 작업대에 넣고 절단을 고르세요."
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"색 블록과 더 낯선 돌이에요. 변형을 고르세요. 작업대가 나머지를 갖고 있어요.",
		"방법: Chipped 작업대는 JEI 에 (석공, 목수, 유리 불기…). 블록을 작업대에 넣고 절단을 고르세요."
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"금속과 기계 얼굴의 블록이에요. 취향대로 자르세요.",
		"방법: Chipped 작업대는 JEI 에 (석공, 목수, 유리 불기…). 블록을 작업대에 넣고 절단을 고르세요."
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"석공 작업대에 블록을 넣고, 변형의 벽에서 고르세요.",
		"방법: 돌 네 개를 정사각형으로, 또는 석재 절단기."
	]
	quest.4200000000230593.title: "돌의 절단"
	quest.4200000000230594.quest_desc: [
		"목수 작업대는 나무에 같은 일을 해요.",
		"방법: 제작 칸에 원목 하나면 넷이 돼요."
	]
	quest.4200000000230594.title: "판자의 절단"
	quest.4200000000230595.quest_desc: [
		"유리 불기가 아는 유리판은 모두 여기서 시작해요.",
		"방법: 모래를 제련하세요. 망치로 조약돌을 자갈로, 자갈을 모래로, 그다음 화로로 넣으세요."
	]
	quest.4200000000230595.title: "유리의 절단"
	quest.4200000000230596.quest_desc: [
		"자갈 가수가 다투기 좋아하는 돌이에요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000230596.title: "심층암 종류"
	quest.4200000000230597.quest_desc: [
		"구운 점토, 백 가지로.",
		"방법: 벽돌 아이템 네 개. 점토 공은 제련하면 벽돌이 돼요."
	]
	quest.4200000000230597.title: "벽돌 종류"
	quest.4200000000230598.quest_desc: [
		"공중섬의 자갈, 잘게 잘려 있어요.",
		"방법: 제작하거나, 제련하거나, 체로 치거나, 몹에게서 얻으세요. JEI 가 공중섬의 모든 출처를 보여줘요."
	]
	quest.4200000000230598.title: "사암 종류"
	quest.4200000000240599.quest_desc: [
		"공중섬을 누군가 사는 곳으로 바꾸는 첫 번째예요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 참나무 판자는 JEI 에. Handcrafted 의 첫 물건이에요."
	]
	quest.4200000000240599.title: "의자"
	quest.420000000024059A.quest_desc: [
		"생각하는 동안 코덱스를 내려놓을 곳이에요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.420000000024059A.title: "탁자"
	quest.420000000024059B.quest_desc: [
		"통이 일하는 동안 Clowder 가 앉을 자리예요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.420000000024059B.title: "벤치"
	quest.420000000024059C.quest_desc: [
		"다시 읽겠다고 미뤄 둔 코덱스 페이지를 위한 곳이에요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.420000000024059C.title: "선반"
	quest.420000000024059D.quest_desc: [
		"거기에 어울리는 Handcrafted 수납이에요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.420000000024059D.title: "찬장"
	quest.420000000024059E.quest_desc: [
		"공중섬 지킴이는 잘 잤어요. 당신도 그래야 해요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.420000000024059E.title: "멋진 침대"
	quest.420000000024059F.quest_desc: [
		"등불, 한 페이지, 둘의 자리예요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.420000000024059F.title: "협탁"
	quest.42000000002405A0.quest_desc: [
		"틀을 자르고, 아무 블록으로 입히세요. 모양은 하나, 겉은 전부예요.",
		"방법: 철 주괴를 틀 입방체 세 개 위에. 틀 블록을 잘라요."
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"위장 블록을 기다리는 빈 정육면체예요.",
		"방법: 틀 톱, 그다음 틀 정육면체/반 블록/계단. 위장은 블록을 든 채 우클릭이에요."
	]
	quest.42000000002405A1.title: "Framed Cube"
	quest.42000000002405A2.quest_desc: [
		"반은 틀, 선택지는 두 배예요.",
		"방법: 틀 톱, 그다음 틀 정육면체/반 블록/계단. 위장은 블록을 든 채 우클릭이에요."
	]
	quest.42000000002405A2.title: "Framed Slab"
	quest.42000000002405A3.quest_desc: [
		"기대어 선 벽의 모습을, 무엇이든 입는 계단이에요.",
		"방법: 틀 톱, 그다음 틀 정육면체/반 블록/계단. 위장은 블록을 든 채 우클릭이에요."
	]
	quest.42000000002405A3.title: "Framed Stairs"
	quest.42000000002405A4.quest_desc: [
		"공허가 한 번도 주지 않은 지붕과 지붕선을 위해서예요.",
		"방법: 틀 톱, 그다음 틀 정육면체/반 블록/계단. 위장은 블록을 든 채 우클릭이에요."
	]
	quest.42000000002405A4.title: "Framed Slope"
	quest.42000000002405A5.quest_desc: [
		"가장자리 보행자는 더 적은 것으로 공허를 건넜어요. 다음 공중섬까지 멋지게 닿으세요.",
		"방법: JEI 에서 맞는 돌/나무로 Macaw 다리를 만드세요."
	]
	quest.42000000002405A5.title: "밧줄 다리"
	quest.42000000002405A6.quest_desc: [
		"공중섬 위의 지붕. 여기 위쪽의 비는 언제나 야심뿐이에요.",
		"방법: JEI 에서 맞는 나무로 Macaw 지붕을 만드세요."
	]
	quest.42000000002405A6.title: "다락 지붕"
	quest.42000000002405A7.quest_desc: [
		"편안함도 기반 시설이에요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.42000000002405A7.title: "소파"
	quest.42000000002405A8.quest_desc: [
		"Farmer's Delight 계열을 위한 부엌 가장자리예요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.42000000002405A8.title: "조리대"
	quest.42000000002405A9.quest_desc: [
		"수염 코덱스가 여백을 얻는 곳이에요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.42000000002405A9.title: "책상"
	quest.42000000002405AA.quest_desc: [
		"탁자와 어울리는 작은 수납이에요.",
		"방법: 판자로 된 Handcrafted 가구는 JEI 에. 첫 의자는 참나무예요."
	]
	quest.42000000002405AA.title: "서랍"
	quest.42000000002405AB.quest_desc: [
		"벽 속에 숨는 문턱이에요.",
		"방법: 틀 톱, 그다음 틀 정육면체/반 블록/계단. 위장은 블록을 든 채 우클릭이에요."
	]
	quest.42000000002405AB.title: "Framed Door"
	quest.42000000002405AC.quest_desc: [
		"얇은 덮개, 완전한 위장이에요.",
		"방법: 틀 톱, 그다음 틀 정육면체/반 블록/계단. 위장은 블록을 든 채 우클릭이에요."
	]
	quest.42000000002405AC.title: "Framed Panel"
	quest.42000000002405AD.quest_desc: [
		"취향껏 꾸밀 수 있는 가장자리 난간이에요.",
		"방법: 틀 톱, 그다음 틀 정육면체/반 블록/계단. 위장은 블록을 든 채 우클릭이에요."
	]
	quest.42000000002405AD.title: "Framed Fence"
	quest.42000000002405AE.quest_desc: [
		"회색이고 솔직해요. 나온 그 자갈처럼요.",
		"방법: JEI 에서 맞는 돌/나무로 Macaw 다리를 만드세요."
	]
	quest.42000000002405AE.title: "안산암 다리"
	quest.42000000002505AF.quest_desc: [
		"벽등이에요. 부끄러워 꽂아 둔 횃불이 아니에요. 청지기에게는 기준이 있었어요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 횃불 + 철 조각. 청지기실의 첫 제작이에요."
	]
	quest.42000000002505AF.title: "벽 촛대"
	quest.42000000002505B0.quest_desc: [
		"떨어지는 모래. 시계 가닥보다 앞선, 유일한 정직한 시계예요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B0.title: "모래시계"
	quest.42000000002505B1.quest_desc: [
		"블록에서 유체를 똑똑 떨어뜨리세요. 작고, 묘하게 만족스러워요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B1.title: "수도꼭지"
	quest.42000000002505B2.quest_desc: [
		"손으로 돌리세요. 북심장도 어딘가에서 시작했어요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B2.title: "크랭크"
	quest.42000000002505B3.quest_desc: [
		"물건을 내보이세요. 증표, 페이지, 트로피.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B3.title: "아이템 선반"
	quest.42000000002505B4.quest_desc: [
		"자루를 담는 자루예요. 회수의 어수선함, 정리했어요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B4.title: "자루"
	quest.42000000002505B5.quest_desc: [
		"해진 실을, 더 나쁜 자기 생각에서 멀리 잠가 두세요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B5.title: "금고"
	quest.42000000002505B6.quest_desc: [
		"Clowder 전체가 읽는 곳에 페이지를 붙이세요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B6.title: "게시판"
	quest.42000000002505B7.quest_desc: [
		"야심 있는 화분이에요. 공중섬이 얇은 곳에서 조금 기르세요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B7.title: "큰 화분"
	quest.42000000002505B8.quest_desc: [
		"물레 베틀 조각을 감상할 수 있는 곳에 올리세요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B8.title: "받침대"
	quest.42000000002505B9.quest_desc: [
		"쿠키나 벌, 아니면 질서라는 작은 품위를 넣어 두세요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505B9.title: "병 (37)"
	quest.42000000002505BA.quest_desc: [
		"침대를 통째로 사다리로 끌어올리지 않고 출현을 정하세요.",
		"방법: JEI 의 양털. 흰 침낭. 염색 종류도 있어요. 침대 전부 없이 출현 지점을 정해요."
	]
	quest.42000000002505BA.title: "침낭"
	quest.42000000002505BB.quest_desc: [
		"낮을 잠으로 보내세요. 몹이 쉰 Skybound 를 만나게 해요.",
		"방법: JEI 에서 양털 + 실. 밧줄과 못에 거세요."
	]
	quest.42000000002505BB.title: "해먹"
	quest.42000000002505BC.quest_desc: [
		"기둥 둘 사이에, 낭떠러지 위로 해먹을 걸고, 한번 해보세요.",
		"방법: 끈과 철 주괴. 둘을 놓고, 그다음 해먹을 거세요."
	]
	quest.42000000002505BC.title: "밧줄과 못"
	quest.42000000002505BD.quest_desc: [
		"공중섬의 긴 밤을 위한, 더 안정된 불꽃이에요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505BD.title: "촛대"
	quest.42000000002505BE.quest_desc: [
		"오르거나, 매달리거나, 다리를 놓으세요. 가장자리 보행자는 이것만 믿었어요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505BE.title: "밧줄 (37)"
	quest.42000000002505BF.quest_desc: [
		"레드스톤 마음대로 밧줄을 올리고 내리세요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505BF.title: "도르래 블록"
	quest.42000000002505C0.quest_desc: [
		"그 위로 떨어지면, 공허가 벌을 잊어요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505C0.title: "깃털 블록"
	quest.42000000002505C1.quest_desc: [
		"Clowder 모두가 따질 수 있는 계획을 분필로 그리세요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505C1.title: "칠판"
	quest.42000000002505C2.quest_desc: [
		"실려 가기 싫은 작은 것을 옮기세요.",
		"방법: JEI 에서 Supplementaries 제작(벽등, 자루, 금고, 밧줄…). 청지기실이 작업대 이름을 알려 줘요."
	]
	quest.42000000002505C2.title: "동물 우리"
	quest.42000000002605C3.quest_desc: [
		"첫 전선이에요. 북심장이 지키던 파동이 이제 갈 곳이 있어요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 압연기에서 구리 판을 압연하세요. 이번 챕터는 여기서 시작해요."
	]
	quest.42000000002605C3.title: "구리 철사"
	quest.42000000002605C4.quest_desc: [
		"한쪽은 회전, 다른 쪽은 Forge 에너지. 두 가닥이 악수해요.",
		"방법: Create Crafts & Additions — 압연기의 구리선, 그다음 커넥터와 모터."
	]
	quest.42000000002605C4.title: "커넥터"
	quest.42000000002605C5.quest_desc: [
		"에너지가 다시 회전이 돼요. 시계 가닥이 이제 불꽃 가닥으로 돌아요.",
		"방법: Create Crafts & Additions — 압연기의 구리선, 그다음 커넥터와 모터."
	]
	quest.42000000002605C5.title: "전기 모터"
	quest.42000000002605C6.quest_desc: [
		"전선과 작업 사이에 전하를 담아 두세요.",
		"방법: Create Crafts & Additions — 압연기의 구리선, 그다음 커넥터와 모터."
	]
	quest.42000000002605C6.title: "커패시터"
	quest.42000000002605C7.quest_desc: [
		"저장한 전류의 벽이에요. 공중섬이 허락하는 만큼 크게 지어요.",
		"방법: Create Crafts & Additions — 압연기의 구리선, 그다음 커넥터와 모터."
	]
	quest.42000000002605C7.title: "모듈형 축전지"
	quest.42000000002605C8.quest_desc: [
		"주괴로 막대와 선——프레스에 대한 Create 의 대답이에요.",
		"방법: Create Crafts & Additions — 압연기의 구리선, 그다음 커넥터와 모터."
	]
	quest.42000000002605C8.title: "압연기"
	quest.42000000002605C9.quest_desc: [
		"마법 부여대의 미신 없이 부여하세요. 경험치를 먹이면, 의도를 받아요.",
		"방법: 블레이즈 버너 다음의 Create Enchantment Industry. JEI 가 인쇄기와 경험치 양동이의 이름을 알려요."
	]
	quest.42000000002605C9.title: "Blaze Enchanter"
	quest.42000000002605CA.quest_desc: [
		"액체 수련을 들고 다녀요. 청지기라면 천하면서도 쓸모 있다고 봤을 거예요.",
		"방법: 블레이즈 버너 다음의 Create Enchantment Industry. JEI 가 인쇄기와 경험치 양동이의 이름을 알려요."
	]
	quest.42000000002605CA.title: "경험치 양동이"
	quest.42000000002605CB.quest_desc: [
		"책과 설계와 페이지를 복사하세요. 수염 코덱스가 조용히 인정해요.",
		"방법: 블레이즈 버너 다음의 Create Enchantment Industry. JEI 가 인쇄기와 경험치 양동이의 이름을 알려요."
	]
	quest.42000000002605CB.title: "Printer"
	quest.42000000002605CC.quest_desc: [
		"용암과 열을 동력으로. 다리일 뿐, 웅웅 그 자체는 아니에요.",
		"방법: 오스뮴 + 화로 + 구리. 첫 Mekanism 발전기예요."
	]
	quest.42000000002605CC.title: "지열 발전기"
	quest.42000000002605CD.quest_desc: [
		"온통 하늘인 공중섬에서, 해는 아무도 배급하지 않는 유일한 자원이에요.",
		"방법: Mekanism 작업장 라인 다음의 Mekanism 발전기. 열 발전기가 첫 제작이에요."
	]
	quest.42000000002605CD.title: "태양광 발전기"
	quest.42000000002605CE.quest_desc: [
		"공중섬이 높을수록 더 세게 돌아요. 높게 지으세요.",
		"방법: Mekanism 작업장 라인 다음의 Mekanism 발전기. 열 발전기가 첫 제작이에요."
	]
	quest.42000000002605CE.title: "풍력 발전기"
	quest.42000000002605CF.quest_desc: [
		"싹 가닥의 남는 것을 태우세요. 공중섬에서는 아무것도 낭비가 아니에요.",
		"방법: Mekanism 작업장 라인 다음의 Mekanism 발전기. 열 발전기가 첫 제작이에요."
	]
	quest.42000000002605CF.title: "바이오연료 발전기"
	quest.42000000002605D0.quest_desc: [
		"Mekanism 을 깊게 판 Clowder 를 위한 후반 동력이에요.",
		"방법: Mekanism 작업장 라인 다음의 Mekanism 발전기. 열 발전기가 첫 제작이에요."
	]
	quest.42000000002605D0.title: "기체 연소 발전기"
	quest.42000000002605D1.quest_desc: [
		"디지털 베틀이 주머니 속에 있어요. 공중섬 어디서든 다시 짜세요.",
		"방법: AE2 네트워크와 충전된 무선 키트 다음의 무선 단말기. JEI 가 제작 이름을 알려요."
	]
	quest.42000000002605D1.title: "무선 단말기 (38)"
	quest.42000000002605D2.quest_desc: [
		"Mekanism 의 화학 물질을 AE2 네트워크에 저장해요. 늦은 두 기둥을 땋아 둔 거예요.",
		"방법: AE2 하우징 + Mekanism 화학 물질 다음의 Applied Mekanistics 화학 셀."
	]
	quest.42000000002605D2.title: "화학 셀"
	quest.42000000002605D3.quest_desc: [
		"구리선이 파동 전부를 못 나를 때를 위해서예요.",
		"방법: Create Crafts & Additions — 압연기의 구리선, 그다음 커넥터와 모터."
	]
	quest.42000000002605D3.title: "대형 단자"
	quest.42000000002605D4.quest_desc: [
		"레벨이 오르는 케이크예요. 주방 라인에는 말하지 마세요.",
		"방법: 블레이즈 버너 다음의 Create Enchantment Industry. JEI 가 인쇄기와 경험치 양동이의 이름을 알려요."
	]
	quest.42000000002605D4.title: "경험치 케이크"
	quest.42000000002605D5.quest_desc: [
		"같은 공짜 하늘을 더 크게 한 입이에요.",
		"방법: Mekanism 작업장 라인 다음의 Mekanism 발전기. 열 발전기가 첫 제작이에요."
	]
	quest.42000000002605D5.title: "고급 태양광"
	quest.42000000002605D6.quest_desc: [
		"화학 셀이라면 모두 필요한 껍질이에요.",
		"방법: AE2 하우징 + Mekanism 화학 물질 다음의 Applied Mekanistics 화학 셀."
	]
	quest.42000000002605D6.title: "화학 하우징"
	quest.42000000002605D7.quest_desc: [
		"기체를 한 만큼 네트워크 밖으로 나르세요.",
		"방법: AE2 하우징 + Mekanism 화학 물질 다음의 Applied Mekanistics 화학 셀."
	]
	quest.42000000002605D7.title: "휴대용 화학 셀"
	quest.42000000002705D8.quest_desc: [
		"모든 가닥에는 절단이 끊고 야생이 된 베틀의 구조물, 수호자가 있어요. 괴물을 죽이는 게 아니라, 이겨서 가닥에 장력을 되돌리는 거예요. 가닥을 앉힌 뒤에 그 해진 토템을 만들고 투기장 밖 어디서든 쓰면, 당신과 32블록 안의 모든 Clowder 동료가 그 무대로 끌려가요. 이기면 모두가 그 수호자의 짜인 유물을 집으로 가져가요. 지면 토템을 소모한 채 도로 뱉겨 나와요.",
		"유물은 Curios 유물 칸, 보조손, 또는 단축바에서 작동해요. 착용 중에는 지속 효과, 우클릭은 재사용 대기시간이 있는 힘이에요. `/guardians leave` 는 싸움을 포기하고, `/guardians status` 는 Clowder 의 기록을 보여요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 체크. 그 가닥을 앉힌 뒤에 해진 토템을 각각 만드세요. 투기장 밖에서 쓰세요."
	]
	quest.42000000002705D8.title: "절단에 대한 답"
	quest.42000000002705D9.quest_desc: [
		"굴의 그릇: 흙 네 단이 진흙 구덩이까지 내려가는 가라앉은 그릇이며, 짙은 참나무 뿌리 아치 여섯 아래 구덩이 바닥에 청록 뿌리 이음새 일곱이 빛나요.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705D9.title: "토템: 잠자리"
	quest.42000000002705DA.quest_desc: [
		"체력의 사분의 일마다 잠자리는 내리쳐 구덩이를 흙 한 층으로 채우고, 그 안에서는 무적이 돼요. 일곱 솔기 중 하나가 켜져요: 그곳까지 수로를 파고, 핵을 드러낸 뒤 쳐서 매장을 깨세요. 첫 번째 문이고, 너그러운 문이에요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705DA.title: "장력 되돌리기: 잠자리"
	quest.42000000002705DB.quest_desc: [
		"뿌리심장: 받는 밀쳐내기가 육십 퍼센트 줄고, 아무것도 당신을 끌어당길 수 없어요. 뿌리 내리기는 오 초 동안 당신을 땅에 심고, 흡수의 하트 여덟 뒤에 두어요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705DB.title: "유물: 뿌리심장"
	quest.42000000002705DC.quest_desc: [
		"맷돌구덩: 심층암 채석장이에요. 바닥에 회전하는 숫돌 고리가 있고, 돌 체 슈트 네 개가 자갈을 중앙 자갈 구덩이로 쏟아요.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705DC.title: "토템: 맷돌아귀"
	quest.42000000002705DD.quest_desc: [
		"맷돌아귀는 아귀가 닫혀 있는 동안 면역이에요. 슈트마다 십오 초마다 자갈 블록을 하나 떨어뜨리니, 하나를 고리 위로 옮겨 구덩이 입까지 타고 가게 하고, 아귀를 십이 초 동안 열린 채 걸리게 하세요. 고리는 단계마다 반대로 돌며, 방심한 사람을 구덩이로 밀어요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705DD.title: "장력 되돌리기: 맷돌아귀"
	quest.42000000002705DE.quest_desc: [
		"분쇄핵: 채굴 피로에 면역. 손에 든 체는 행운 추가 굴림을 하나 얻어요. 갈기는 다음에 맞힌 것에서 방어력 2를 벗겨요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705DE.title: "유물: 분쇄핵"
	quest.42000000002705DF.quest_desc: [
		"무성한 테라스: 잎 덮개 아래 정원 테라스 넷, 격자 기둥 여덟, 둘째 층에 가지치기 자리 넷이에요.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705DF.title: "토템: 가시어미"
	quest.42000000002705E0.quest_desc: [
		"가시어미는 결코 치지 않아요. 퍼지고 만지면 타는 가시 울타리를 뿌리며, 가지치기 자리가 덮일 때마다 회복해요. 가위와 도끼로 치워요. 자리에서 울타리 여덟을 퇴비로 만들면 가지치기 파도가 나가 땅을 비우고 그녀를 기절시켜요. 깨끗한 피해 틈은 그것뿐이에요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705E0.title: "장력 되돌리기: 가시어미"
	quest.42000000002705E1.quest_desc: [
		"가시씨앗: 가시, 그리고 열매나 선인장 피해가 없어요. 개화는 울타리 고리를 올리고, 그 안의 당신과 Clowder 에게 재생 II를 줘요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705E1.title: "유물: 가시씨앗"
	quest.42000000002705E2.quest_desc: [
		"하늘의 파편: 공허 위에 떠 있는 심층암 파편 열 개, 그 사이의 무너지는 다리, 보스가 착지하는 주 파편 위의 금색 발톱 자국.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705E2.title: "토템: 가장자리 보행자"
	quest.42000000002705E3.quest_desc: [
		"순수한 결투예요. 가장자리 보행자는 파편에서 파편으로 뛰고 벽에서 가장 멀리 선 이에게 덮치며, 금색 발톱 자국이 한 호흡 전에 착지할 곳을 보여 줘요 — 거기서 벗어나세요. 다리는 뒤에서 무너졌다가 나중에 돌아와요. 떨어지면 하트 여섯과 공중섬으로 돌아가는 길이 들어요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705E3.title: "장력 되돌리기: 가장자리 보행자"
	quest.42000000002705E4.quest_desc: [
		"가장자리 발걸음: 열두 블록 미만의 낙하에는 피해가 없고, 가장자리에서 미끄러지지 않아요. 가장자리 발걸음은 여섯 블록을 두 번 돌진하고, 끝에 더 강한 타격이 있어요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705E4.title: "유물: 가장자리 발걸음"
	quest.42000000002705E5.quest_desc: [
		"대장간 북: 용암 분화구 위의 황동 북단, 그 앞에 타격 패드가 있는 구리 피스톤 망치 여덟, 바닥을 지나는 용암 수로 넷.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705E5.title: "토템: 북심장"
	quest.42000000002705E6.quest_desc: [
		"북심장은 네 번째 박마다 그 직후 한순간만 다칠 수 있어요. 강박에 박자 판 위에 서서 세 배로 치는 불꽃을 충전하고, 네 번째 박에 용암 수로가 솟으니 수로가 아니라 판 위에 있으세요. 템포는 단계마다 올라가요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705E6.title: "장력 되돌리기: 북심장"
	quest.42000000002705E7.quest_desc: [
		"북의 맥: 네 번째 타격마다 하트가 둘 더 들어가요. 강박은 일곱 블록 안의 모든 것을 기절시키고 밀어내요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705E7.title: "유물: 북의 맥"
	quest.42000000002705E8.quest_desc: [
		"탈진기: 철 허브 주위를 도는 구리 고리 넷이 짙은 참나무 순서 타일을 싣고, 톱니탑 여섯과 열여섯 블록짜리 추가 박자를 지켜요.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705E8.title: "토템: 톱니장이"
	quest.42000000002705E9.quest_desc: [
		"단계마다 톱니장이가 태엽을 감아요: 도는 고리 위에서 타일이 순서대로 켜지고, 십이 초 안에 그 순서로 밟아요. 성공하면 몸통이 팔 초 열리고, 실패하면 톱니탑이 모두 발사해요. 추는 메트로놈이고, 멀리 흔들리면 고리가 반대로 돌아요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705E9.title: "장력 되돌리기: 톱니장이"
	quest.42000000002705EA.quest_desc: [
		"톱니고리: 성급함 I, 도구 소모가 오분의 일 더 느려요. 되감기는 지닌 다른 유물을 모두 되돌리고, 삼 초 전 있던 곳으로 당신을 당겨요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705EA.title: "유물: 톱니고리"
	quest.42000000002705EB.quest_desc: [
		"벌집: 육각형 밀랍 투기장이에요. 오르내리는 벌집 방, 꿀 웅덩이, 벽에 수벌 방이 여섯이에요.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705EB.title: "토템: 군체의식"
	quest.42000000002705EC.quest_desc: [
		"군체의식은 약하지만, 파도마다 방 여섯이 수벌을 쏟아요. 수벌 방에 모닥불을 놓으면 삼십 초 동안 봉인되고, 여섯을 모두 봉인하면 왕실이 십 초 열려요. 당신 자신의 Productive Bees 가 수벌을 보자마자 공격해요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705EC.title: "장력 되돌리기: 군체의식"
	quest.42000000002705ED.quest_desc: [
		"군체의 부름: 벌은 절대 당신에게 덤비지 않고, 열여섯 블록 안의 벌통은 십분의 일 더 빨리 일해요. 무리 부르기: 당신이 맞힌 것을 유물 벌 네 마리가 쫓아요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705ED.title: "유물: 군체의 부름"
	quest.42000000002705EE.quest_desc: [
		"수호의 원: 금빛 원과 자수정 첨탑이 선 문양 기둥 아홉이 있는 돌 성소이고, 가운데는 금 말뚝이 박힌 아홉 변의 단이에요.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705EE.title: "토템: 인장 파괴자"
	quest.42000000002705EF.quest_desc: [
		"인장 파괴자는 켜진 결계 셋 뒤에 숨어요. 단의 말뚝이 단계마다 한 번 순서를 밝혀요 — 먼저 보세요. 그 순서로 Ars 해제나 인장 가닥 아이템으로 기둥을 해제하면 되고, 틀리면 셋이 다시 무장하고 결계 유리가 물어요. 셋을 맞히면 열두 초 동안 열려요. 나중 단계는 룬을 섞고 미끼를 더해요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705EF.title: "장력 되돌리기: 인장 파괴자"
	quest.42000000002705F0.quest_desc: [
		"인장의 표: 받는 마법 피해가 오분의 일 줄어요. 인장의 표는 당신이나, 바라보는 Clowder 동료를 무거운 한 방으로부터 지켜 줘요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705F0.title: "유물: 인장의 표"
	quest.42000000002705F1.quest_desc: [
		"무너지는 베틀: 너비 예순여섯 블록의 베틀이며, 바닥은 날실이고, 종광 막대가 떨어지면 판자 띠가 풀려 실다리가 돼요.",
		"해진 실 넷과 그 가닥의 블록 넷을 공허의 털실 주위에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705F1.title: "토템: 짜이지 않은 자"
	quest.42000000002705F2.quest_desc: [
		"다섯 단계예요. 각각 삼십 초 동안 나머지 여덟 방식 중 둘을 인용하고, 그다음 종광 막대가 떨어지며 띠가 셋 더 풀려요. 진정한 모습에서는 마지막 네 띠가 남고, 날실만이 그가 서 있는 들보로 올라가는 길이에요. 거기서 처치하세요: 다시 짜기.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705F2.title: "장력 되돌리기: 짜이지 않은 자"
	quest.42000000002705F3.quest_desc: [
		"베틀 실: Clowder의 베틀 장력이 둘 더 늘고, 감쇠가 더 느려져요. 베틀 실은 Clowder를 당신 곁에 묶어요. 진정한 다시 짜기의 쐐기돌이자, 봉인된 두 투기장의 열쇠예요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705F3.title: "유물: 베틀 실"
	quest.42000000002705F4.quest_desc: [
		"부두 쓰레기통: 부두 그 자체의 한구석으로, 판자 마당, 천 시트를 널어 둔 빨랫줄, 양털 바구니, 빨간 양탄자가 있어요.",
		"해진 실 네 개와 양털 네 개, 공허의 털실 둘레에.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705F4.title: "토템: 보풀 골렘"
	quest.42000000002705F5.quest_desc: [
		"위험 없는 단 하나의 싸움이에요. 골렘은 보풀 공을 던져 잠시만 눈멀게 하고 빨래 뒤에 숨지만, 양탄자를 두드리면 재채기하고 비틀거려요. 토템과 투기장과 관문을 가르쳐요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705F5.title: "장력 되돌리기: 보풀 골렘"
	quest.42000000002705F6.quest_desc: [
		"보풀 실오라기: 선인장, 열매, 울타리 피해와 밀려남에 면역이에요. 먼지는 가까운 몹을 눈멀게 해 도망치게 해요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705F6.title: "유물: 보풀 실오라기"
	quest.42000000002705F7.quest_desc: [
		"매듭 정원: 울타리 미로가 네 겹인 아래의 풀섬으로, 틈과 가지, 조약돌 길, 그 위에 매달린 밧줄 매듭 고리가 있어요.",
		"공허의 털실 주위에 해진 실 넷과 잎 넷.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705F7.title: "토템: 엉킴"
	quest.42000000002705F8.quest_desc: [
		"거미는 자르는 데 세 번 쳐야 하는 밧줄 매듭으로 당신 뒤의 길을 막고, 막다른 곳에 혼자 있으면 물어요. 미로에서는 함께 있으세요. 선택이고, 중반이며, 꾸미기용 보상이에요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705F8.title: "장력 되돌리기: 엉킴"
	quest.42000000002705F9.quest_desc: [
		"매듭 부적: 거미줄, 영혼 모래, 꿀, 가루눈에서 느려지지 않고, 얼음에서 미끄러짐이 절반이에요. 엉킴은 처음 맞힌 몹을 뿌리로 묶어요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705F9.title: "유물: 매듭 부적"
	quest.42000000002705FA.quest_desc: [
		"두 미친 투기장이 다시 짜기만 여는 문 뒤에서 기다려요. 그 토템은 제작 칸에 베틀 실 유물이 필요하고, 하늘을 닫은 Clowder 에게만 대답해요. 보스는 당신의 열 배에서 스무 배 크기예요. 모두를 데려오세요.",
		"방법: 가닥 아홉을 모두 앉힌 다음, 다시 짜세요. 하늘이 닫히면 발전 과제가 발동해요."
	]
	quest.42000000002705FA.title: "봉인된 문"
	quest.42000000002705FB.quest_desc: [
		"단절: 빛나는 절단이 가로지르는 커다란 흑요석 파편, 주위를 떠다니는 세계 파편 스무 개, 공중의 청록색 공허의 눈물.",
		"해진 실과 흑요석이 베틀 실 유물 주위에 있고, 유물은 되돌려져요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705FB.title: "토템: 첫 번째 절단"
	quest.42000000002705FC.quest_desc: [
		"절단이 파편에 남긴 형상이며, 누가 휘둘렀는지의 자백은 아니에요. 스무 초마다 파편을 가로지르는 선을 베어 블록이 열다섯 초 동안 떨어지고, 이음매는 신속을 주지만 광선은 이음매를 따라와요. 떠도는 파편은 짓누르고, 공허의 눈물은 끌어당기며, 체력이 오분의 일이 되면 파편이 절단을 따라 둘로 갈라져요. 다시 짜기 후에만.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705FC.title: "장력 되돌리기: 첫 번째 절단"
	quest.42000000002705FD.quest_desc: [
		"첫 번째 절단의 파편: 결계 단계를 베어 넘어요. 팩에서 최고, 통과한 이를 위해 남겨 둔 거예요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705FD.title: "유물: 첫 번째 절단의 파편"
	quest.42000000002705FE.quest_desc: [
		"위의 베틀: 퍼퍼로 짠 직물, 가닥 다리 아홉 개가 기둥이 선 발판 아홉 곳으로 이어지고, 성당의 실 스물일곱 가닥이 예순네 블록 위의 쐐기돌까지 올라가요.",
		"베틀 실 유물 주위에 해진 실과 퍼퍼를 두어요. 유물은 되돌려받아요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.42000000002705FE.title: "토템: 과도한 직조자"
	quest.42000000002705FF.quest_desc: [
		"당신이 되살린 베틀이 당신에게 등을 돌렸어요. 과도한 직조자는 아홉 수호자의 그림자를 각자 가닥 위로 던져요. 그림자를 죽이면 그 실이 스물다섯 초 동안 팽팽해지고, 그때만 베틀 자체를 다칠 수 있어요. 나중에는 셋을, 그다음엔 아홉을 모두 던져요.",
		"방법: 맞는 해진 토템을 쓰고 투기장에서 이기세요. 발전 과제가 이것을 완료해요."
	]
	quest.42000000002705FF.title: "장력 되돌리기: 과도한 직조자"
	quest.4200000000270600.quest_desc: [
		"과도한 직조자의 북: 모든 가닥 유물의 메아리가 하나로 모이고, 쓰러진 Clowder 동료를 다시 짜요.",
		"승리에 있던 Clowder 구성원마다 하나, 바로 보관함으로 들어가요.",
		"방법: 수염 코덱스, 끊긴 수호자 — 토템, 투기장, 유물. 토템은 공중섬에서 응답해요."
	]
	quest.4200000000270600.title: "유물: 과도한 직조자의 북"
	quest.42000000002805E3.quest_desc: [
		"야생 공중섬 주자는 공허의 공중섬에 나타나지 않아요. 문의 북에서 문의 의식을 연주하고 (맨손으로 사용하고, 박을 A, S, D, F 로 치세요) 변경을 걸으세요. 노란색은 초원과 갈대 습지에서 풀을 뜯어요. 고지는 우수 등급 쪽으로 기울어요. 눈밭은 훌륭함 등급을 숨겨요. 잿불 황무지는 화염 새를 두어요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 문의 북을 맨손으로 사용하고 문의 의식을 연주해요. 떨어지는 박을 A, S, D, F 로 맞히세요. 60%를 맞히면 열리고, 맥박은 필요 없어요. 먼저 귀환 나침반을 묶어요."
	]
	quest.42000000002805E3.title: "변경으로 가는 문"
	quest.42000000002805E4.quest_desc: [
		"야생 Gysahl은 갈대 습지, 초원, 고지에서 자라고, 습지에서 가장 빽빽해요. 따면 씨앗도 떨어지고, 변경 잎이나 풀을 괭이로 부수면 씨앗이 더 나와요. 씨앗은 집의 경작지에 심으세요.",
		"방법: 변경에서 야생 Gysahl을 따세요 (갈대 습지가 가장 빽빽해요). 따면 씨앗도 떨어져요. 집의 경작지에 심으세요."
	]
	quest.42000000002805E4.title: "Gysahl Green"
	quest.42000000002805E5.quest_desc: [
		"책과 Gysahl 잎이에요. 어디서든 쓰세요: 페이지에는 자기 새 각각의 색, 등급, 클래스, 경주 우승 수, 마지막 견과가 적혀요.",
		"방법: 책과 Gysahl이에요. 어디서든 쓰세요. 페이지에 자기 새들이 적혀요."
	]
	quest.42000000002805E5.title: "Chocobo Almanac"
	quest.42000000002805E6.quest_desc: [
		"야생 노란색에게 Gysahl을 먹여 길들이세요. 가죽, 실, 철로 안장을 만든 다음 타세요. 질주하면 돌진하고, 힘을 빼면 기력이 돌아와요.",
		"방법: 가죽, 실, 철이에요. 야생 노란색을 Gysahl로 길들이고, 그다음 안장을 얹으세요."
	]
	quest.42000000002805E6.title: "Chocobo Saddle"
	quest.42000000002805E7.quest_desc: [
		"금 조각이 시계를 두르고, Gysahl 하나예요. 태엽을 감으면 수염바람으로, 그리고 다시 돌아옴으로 데려가요. 변경을 걸은 뒤, Esther는 Clowder 회관에도 서 있어요: 안장 얹은 새를 타고 그녀에게 가거나, 수염바람 안내자에게 물어보세요.",
		"방법: 금 조각이 시계를 두르고, Gysahl 하나예요. 태엽으로 수염바람과 되돌아옴으로 이동하세요. 안장 얹은 새도 함께 와요."
	]
	quest.42000000002805E7.title: "Chocobo Pocketwatch"
	quest.42000000002805E8.quest_desc: [
		"손에 든 미끼는 야생 새를 끌어오고, 들판 너머로 윤곽을 그려요.",
		"방법: 미끼를 만드세요. 들고 변경의 노란색을 찾으세요."
	]
	quest.42000000002805E8.title: "Chocobo Lure"
	quest.42000000002805E9.quest_desc: [
		"Gysahl 씨앗을 경작지에 심으세요. 집의 작은 밭이 농장 줄의 시작이에요.",
		"방법: 야생 Gysahl을 따면 씨앗이 떨어지고, 풀과 변경 잎을 괭이로 부숴도 떨어져요. 경작지에 심으세요."
	]
	quest.42000000002805E9.title: "Gysahl Seeds"
	quest.42000000002805EA.quest_desc: [
		"성별이 반대인 성체 둘에게 Carob 견과를 먹이세요. 등급이 좋음 이상인 노랑 둘에 Carob을 더하면 초록이나 파랑으로 부화할 수 있어요. 부모는 각자 클래스 C 1위가 5회 필요하고, 합쳐 16회면 색이 확정돼요. 우수 등급의 초록과 우수 등급의 파랑이 각자 클래스 B 1위를 8회 가지면 검정으로 부화해요 (실패하면 하양. 합쳐 24회면 확실한 굴림).",
		"방법: 수염바람의 견과 지킴이 Bilo가 Carob을 팔아요. 클래스 A 경주도 그걸 지급해요."
	]
	quest.42000000002805EA.title: "Carob Nut"
	quest.42000000002805EB.quest_desc: [
		"사다리 중간의 푸른 풀이에요. 속도, 체력, 지능, 또는 협력을 훈련하세요. 새는 종류마다 배불러요.",
		"방법: 수염바람의 현자 Wynn."
	]
	quest.42000000002805EB.title: "Curiel 푸른 풀"
	quest.42000000002805EC.quest_desc: [
		"최상급 훈련용 푸른 풀이에요. 더 싼 잎으로 새가 배부르면 사다리를 올라가세요.",
		"방법: 수염바람의 현자 Wynn, 또는 클래스 S 경주 상품."
	]
	quest.42000000002805EC.title: "Sylkis 푸른 풀"
	quest.42000000002805ED.quest_desc: [
		"Zeio 없이는 금색이 부화하지 않아요. 등급이 훌륭함인 검정과 훌륭함인 노랑, 각자 클래스 A 1위 10회 (합쳐 32회면 확실한 굴림).",
		"방법: 수염바람의 견과 지킴이 Bilo가 Zeio를 팔아요. 클래스 S 경주는 드물게 그걸 지급해요."
	]
	quest.42000000002805ED.title: "Zeio Nut"
	quest.42000000002805EE.quest_desc: [
		"코스에서 딴 GP예요. 광장의 노점은 모든 값을 GP로 매겨요.",
		"방법: 수염바람의 한 판에서 상위 세 자리 안에 드세요. 안장 얹은 새를 타고 Esther에게 가서 참가하세요."
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"첫 교배용 견과예요. 재능은 견과를 따르고 색은 부모를 따르지만, Carob 이나 Zeio 가 끼면 예외예요.",
		"방법: 수염바람의 견과 지킴이 Bilo가 Pepio를 팔아요. 클래스 C 우승도 그걸 지급할 수 있어요."
	]
	quest.42000000002805EF.title: "Pepio Nut"
	quest.42000000002805F0.quest_desc: [
		"Gysahl 둘과 뼛가루예요. 평범한 푸른 풀에서 한 단계 위예요.",
		"방법: 무정형 — Gysahl 둘과 뼛가루."
	]
	quest.42000000002805F0.title: "Krakka 푸른 풀"
	quest.42000000002805F1.quest_desc: [
		"다음 훈련용 푸른 풀이에요. 농장이 돌아가면 선택이에요.",
		"방법: 현자 Wynn, 또는 JEI 에 적힌 제작법."
	]
	quest.42000000002805F1.title: "Tantal 푸른 풀"
	quest.42000000002805F2.quest_desc: [
		"또 하나의 훈련용 푸른 풀이에요. 선택이에요.",
		"방법: 광장의 현자 Wynn."
	]
	quest.42000000002805F2.title: "Pahsana 푸른 풀"
	quest.42000000002805F3.quest_desc: [
		"또 하나의 훈련용 푸른 풀이에요. 선택이에요.",
		"방법: 광장의 현자 Wynn."
	]
	quest.42000000002805F3.title: "Mimett 푸른 풀"
	quest.42000000002805F4.quest_desc: [
		"또 하나의 훈련용 푸른 풀이에요. 선택이에요.",
		"방법: 광장의 현자 Wynn."
	]
	quest.42000000002805F4.title: "Reagan 푸른 풀"
	quest.42000000002805F5.quest_desc: [
		"중간 견과예요. 선택이에요.",
		"방법: 수염바람의 견과 지킴이 Bilo가 Luchile를 팔아요."
	]
	quest.42000000002805F5.title: "Luchile Nut"
	quest.42000000002805F6.quest_desc: [
		"중간 견과예요. 선택이에요.",
		"방법: 수염바람의 견과 지킴이 Bilo가 Saraha를 팔아요."
	]
	quest.42000000002805F6.title: "Saraha Nut"
	quest.42000000002805F7.quest_desc: [
		"중간 견과예요. 선택이에요.",
		"방법: 수염바람의 견과 지킴이 Bilo가 Lasan을 팔아요."
	]
	quest.42000000002805F7.title: "Lasan Nut"
	quest.42000000002805F8.quest_desc: [
		"중후반 교배용 견과예요. 선택이에요. 견과 지킴이 Bilo가 팔아요.",
		"방법: 수염바람의 견과 지킴이 Bilo가 Pram을 팔아요."
	]
	quest.42000000002805F8.title: "Pram Nut"
	quest.42000000002805F9.quest_desc: [
		"수염바람의 축제 노점은 폭죽, 리드, 회중시계, Chocobo 연감을 GP로 팔아요.",
		"방법: 종이에 화약. 터뜨리는 건 선택이에요."
	]
	quest.42000000002805F9.title: "축제 폭죽"
	quest.42000000002805FA.quest_desc: [
		"후반 교배용 견과예요. 선택이에요.",
		"방법: 수염바람의 견과 지킴이 Bilo가 Porov를 팔아요."
	]
	quest.42000000002805FA.title: "Porov Nut"
	quest.42000000002905FB.quest_desc: [
		"공허는 Pam's 덤불을 길러 본 적이 없어요. 끈 망으로 흙을 체질하세요. 정원을 부숴 건조 씨앗을 얻으세요 — 칠리, 옥수수, 선인장 열매.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 끈 망 이상으로 흙을 체질하세요 (Ex Deorum 또는 공허의 베틀)."
	]
	quest.42000000002905FB.title: "Arid Garden"
	quest.42000000002905FC.quest_desc: [
		"같은 흙에서 나오는 한랭 작물이에요. 덤불을 부수고, 필요한 걸 심으세요.",
		"방법: 끈 망 이상으로 흙을 체질하세요."
	]
	quest.42000000002905FC.title: "Frost Garden"
	quest.42000000002905FD.quest_desc: [
		"잎 그늘의 작물이에요. 체는 같고, 덤불은 달라요.",
		"방법: 끈 망 이상으로 흙을 체질하세요."
	]
	quest.42000000002905FD.title: "Shaded Garden"
	quest.42000000002905FE.quest_desc: [
		"습한 작물이에요. 쌀과, 늪을 닮은 나머지 씨앗이 여기 살아요.",
		"방법: 끈 망 이상으로 흙을 체질하세요."
	]
	quest.42000000002905FE.title: "Soggy Garden"
	quest.42000000002905FF.quest_desc: [
		"따뜻한 작물이에요. 덤불은 상자에 넣어 두고, 심으면 그래도 퍼져요.",
		"방법: 끈 망 이상으로 흙을 체질하세요."
	]
	quest.42000000002905FF.title: "Tropical Garden"
	quest.4200000000290600.quest_desc: [
		"여섯 중 마지막이에요. 공중섬의 HarvestCraft 씨앗은 모두 이런 덤불 중 하나로 시작해요.",
		"방법: 끈 망 이상으로 흙을 체질하세요."
	]
	quest.4200000000290600.title: "Windy Garden"
	quest.4200000000290601.quest_desc: [
		"Farmer's Delight 도마가 아니에요. 구리, 막대기, 판자. 냄비에 넣기 전에 과일과 채소를 손질하세요.",
		"방법: 구리, 막대기, 판자. Farmer's Delight 도마가 아니에요."
	]
	quest.4200000000290601.title: "수확판"
	quest.4200000000290602.quest_desc: [
		"수프, 스튜, 육수예요. 구리와 막대기. 솥은 제작할 때마다 돌아와요.",
		"방법: 구리와 막대기. 솥은 무정형 조리마다 돌아와요."
	]
	quest.4200000000290602.title: "수확 솥"
	quest.4200000000290603.quest_desc: [
		"프라이팬 요리예요. 구리와 막대기. Delight 프라이팬과는 다른 제작이에요. JEI 가 구분해 줘요.",
		"방법: 구리와 막대기. Delight 프라이팬과는 달라요."
	]
	quest.4200000000290603.title: "수확 프라이팬"
	quest.4200000000290604.quest_desc: [
		"소스와 졸임이에요. 구리와 막대기. 솥 옆에 두세요.",
		"방법: 구리와 막대기."
	]
	quest.4200000000290604.title: "Saucepan"
	quest.4200000000290605.quest_desc: [
		"테라코타 고리예요. 파이, 빵, 오븐 모양이 필요한 모든 것.",
		"방법: 빈 가운데 둘레에 테라코타 여덟."
	]
	quest.4200000000290605.title: "Bakeware"
	quest.4200000000290606.quest_desc: [
		"판자와 막대기. 반죽물, 반죽, 샐러드. 조용한 작업대예요.",
		"방법: 판자와 막대기."
	]
	quest.4200000000290606.title: "Mixing Bowl"
	quest.4200000000290607.quest_desc: [
		"테라코타예요. 과일을 넣고 짜내요. 밭이 아니라 나무와 짝을 지으세요.",
		"방법: 테라코타. 네 개를 T자로."
	]
	quest.4200000000290607.title: "Juicer"
	quest.4200000000290608.quest_desc: [
		"막대기와 원목. 반죽을 펴세요. 굽기 틀이 기다려요.",
		"방법: 원목 양옆에 막대기."
	]
	quest.4200000000290608.title: "롤러"
	quest.4200000000290609.quest_desc: [
		"부싯돌 체에서 나온 안산암 돌멩이, 그다음 막대기예요. 밀가루, 향신료, 페이스트.",
		"방법: 안산암(부싯돌 체로 거른 흙이나 자갈의 돌멩이)과 막대기."
	]
	quest.4200000000290609.title: "Grinder"
	quest.420000000029060A.quest_desc: [
		"물 양동이를 여덟으로 나눠요. 대부분의 레시피는 바닐라 양동이가 아니라 이것을 원해요.",
		"방법: 물 양동이 하나 → 민물 여덟."
	]
	quest.420000000029060A.title: "Fresh Water"
	quest.420000000029060B.quest_desc: [
		"공중섬에는 소가 없어요. 코코넛(철 망의 흙)에 민물, 아니면 나중에 우유 양동이를 나누세요.",
		"방법: 코코넛(철 망의 흙)에 민물, 또는 우유 양동이를 나누세요."
	]
	quest.420000000029060B.title: "Fresh Milk"
	quest.420000000029060C.quest_desc: [
		"솥에 물, 또는 분쇄예요. 거의 모든 짠 레시피가 찾아요.",
		"방법: 솥에 물 또는 민물. 솥은 돌아와요."
	]
	quest.420000000029060C.title: "Salt"
	quest.420000000029060D.quest_desc: [
		"밀을 분쇄기에 넣어요. 반죽은 여기서 시작돼요.",
		"방법: 분쇄기에 밀(또는 다른 가루 작물). 분쇄기는 돌아와요."
	]
	quest.420000000029060D.title: "Flour"
	quest.420000000029060E.quest_desc: [
		"밀가루, 소금, 민물이에요. 파이와 빵이 이 덩어리를 같이 써요.",
		"방법: 섞는 그릇, 밀가루, 물, 소금."
	]
	quest.420000000029060E.title: "Dough"
	quest.420000000029060F.quest_desc: [
		"뼈나 채소를 솥에 넣어요. 수프는 흐릿한 국물이 아니라 이것 한 병을 원해요.",
		"방법: 솥에 뼈(공중섬 지킴이가 뼈를 팔아요) 또는 남은 채소."
	]
	quest.420000000029060F.title: "Stock"
	quest.4200000000290610.quest_desc: [
		"철 망의 흙이에요. 공중섬에서 키우세요. 바닐라 참나무는 Pam's 사과를 떨어뜨리지 않아요.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.4200000000290610.title: "사과나무"
	quest.4200000000290611.quest_desc: [
		"드레싱과 생선에 쓰는 산이에요. 같은 철 체예요.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.4200000000290611.title: "레몬나무"
	quest.4200000000290612.quest_desc: [
		"나무껍질 향신료예요. 구운 것과 차.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.4200000000290612.title: "계피나무"
	quest.4200000000290613.quest_desc: [
		"우유, 기름, 열대 요리예요.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.4200000000290613.title: "코코넛 야자"
	quest.4200000000290614.quest_desc: [
		"단것에 쓰는 콩이에요. 다른 것들처럼 심으세요.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.4200000000290614.title: "바닐라 덩굴"
	quest.4200000000290615.quest_desc: [
		"Pam's 사과나무는 평범한 사과를 맺어요. 참나무 잎이 떨어뜨리는 것보다 훨씬 많아요. 착즙기와 굽기 틀 모두 이것을 원해요.",
		"방법: 참나무 잎은 몇 개만 떨어뜨려요; Pam's 사과나무(철 망 흙에서 나온 묘목)는 많이 열어요."
	]
	quest.4200000000290615.title: "Pam's 사과"
	quest.4200000000290616.quest_desc: [
		"굽기 틀, 반죽, 설탕, 사과. HarvestCraft 에서 처음 완성하는 구운 음식이에요.",
		"방법: 굽기 틀, 반죽, 설탕, 사과나무의 Pam's 사과."
	]
	quest.4200000000290616.title: "사과 파이 (수확)"
	quest.4200000000290617.quest_desc: [
		"착즙기에 섞은 과일이에요. 수박 주스가 아닌 공중섬 음료예요.",
		"방법: 착즙기와 섞은 과일."
	]
	quest.4200000000290617.title: "Fruit Punch"
	quest.4200000000290618.quest_desc: [
		"프라이팬, 빵, 치즈. 나무가 자라는 동안의 빠른 점심이에요.",
		"방법: 프라이팬, 빵, 버터, 치즈. 전부 민물, 코코넛 밀크, 밀가루에서 나와요."
	]
	quest.4200000000290618.title: "Grilled Cheese"
	quest.4200000000290619.quest_desc: [
		"건조 고추, 토마토, 양파, 콩, 향신잎, 그리고 고기나 연두부. Food Extended 가 제 몫을 하기 시작해요.",
		"방법: 솥, 건조 칠리, 토마토, 양파, 콩, 향신잎, 고기나 연두부."
	]
	quest.4200000000290619.title: "칠리 볼"
	quest.420000000029061A.quest_desc: [
		"분쇄기의 향신료, 정원의 채소, 솥질이에요.",
		"방법: 냄비, 쌀, 코코넛, 칠리, 후추, 커리 가루(향신잎 + 겨자 + 계피)."
	]
	quest.420000000029061A.title: "커리 접시"
	quest.420000000029061B.quest_desc: [
		"반죽, 소스, 고기. 베이킹 틀. HarvestCraft 로 차린 한 끼예요.",
		"방법: 베이킹 틀, 반죽, 토마토, 치즈, 페퍼로니(돼지 베이컨, 또는 단풍 + 콩의 두부 베이컨)."
	]
	quest.420000000029061B.title: "Pepperoni Pizza"
	quest.420000000029061C.quest_desc: [
		"질퍽 정원의 쌀, 당근, 양파, 완두, 달걀. 닭이 생기기 전까지 연두부가 대신해요.",
		"방법: 프라이팬, 질퍽 정원의 쌀, 당근, 양파, 완두, 달걀. 연두부는 달걀로 쳐요."
	]
	quest.420000000029061C.title: "정원 볶음밥"
	quest.420000000029061D.quest_desc: [
		"찻잎과 향신잎을 솥에. 그늘 정원과 질퍽 정원이 둘 다 맡아요.",
		"방법: 솥, 찻잎, 향신잎. 그늘 정원은 차와 향신료를 둘 다 떨어뜨려요."
	]
	quest.420000000029061D.title: "Green Tea"
	quest.420000000029061E.quest_desc: [
		"기름과 감칠맛 나는 열매예요. 철 망의 선택 수확이에요.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.420000000029061E.title: "올리브나무"
	quest.420000000029061F.quest_desc: [
		"과즙과 껍질이에요. 선택이에요.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.420000000029061F.title: "오렌지나무"
	quest.4200000000290620.quest_desc: [
		"여름 과일이에요. 선택이에요.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.4200000000290620.title: "복숭아나무"
	quest.4200000000290621.quest_desc: [
		"분쇄기에 넣을 후추예요. 선택이에요.",
		"방법: 철 망으로 흙을 쳐서 주방 묘목을 얻고, 열매를 키우세요."
	]
	quest.4200000000290621.title: "후추나무"
	quest.4200000000290622.quest_desc: [
		"튀김 기름이에요. 선택 상비품이에요.",
		"방법: JEI 에서 씨앗이나 올리브를 짜세요. 선택 상비품이에요."
	]
	quest.4200000000290622.title: "Cooking Oil"
	quest.4200000000290623.quest_desc: [
		"우유와 소금이에요. 선택 상비품이에요.",
		"방법: 솥과 우유(코코넛 민물 우유도 돼요)."
	]
	quest.4200000000290623.title: "Butter"
	quest.4200000000290624.quest_desc: [
		"달걀을 착즙기에 넣어요. 선택이에요.",
		"방법: 착즙기와 달걀(연두부도 쳐요). 선택이에요."
	]
	quest.4200000000290624.title: "Mayonnaise"
	quest.4200000000290625.quest_desc: [
		"도마, 섞은 과일. 선택이에요.",
		"방법: 도마와 섞은 과일. 선택이에요."
	]
	quest.4200000000290625.title: "Fruit Salad"
	quest.4200000000290626.quest_desc: [
		"파스타의 밤이에요. 선택이에요.",
		"방법: 정원과 과일나무가 재료를 대줘요. 콩 두부가 고기와 달걀을 대신해요. JEI 가 작업대를 알려줘요."
	]
	quest.4200000000290626.title: "스파게티 저녁"
	quest.4200000000290627.quest_desc: [
		"자랑용 아침이에요. 선택이에요.",
		"방법: 정원과 과일나무가 재료를 대줘요. 콩 두부가 고기와 달걀을 대신해요. JEI 가 작업대를 알려줘요."
	]
	quest.4200000000290627.title: "Bacon Pancakes"
	quest.4200000000290628.quest_desc: [
		"아보카도 묘목은 철 망의 흙, 그다음 프라이팬, 토스트, 소금, 마늘, 향신잎.",
		"방법: 철 망의 아보카도 묘목, 그다음 프라이팬에 토스트, 소금, 마늘, 향신잎."
	]
	quest.4200000000290628.title: "Avocado Toast"
	quest.4200000000290629.quest_desc: [
		"Delight 의 햄버거가 아니에요. 선택이에요.",
		"방법: 정원과 과일나무가 재료를 대줘요. 콩 두부가 고기와 달걀을 대신해요. JEI 가 작업대를 알려줘요."
	]
	quest.4200000000290629.title: "양파 버거"
	quest.420000000029062A.quest_desc: [
		"착즙기, 사과. 선택이에요.",
		"방법: 착즙기와 Pam's 사과. 선택이에요."
	]
	quest.420000000029062A.title: "Apple Juice"
	quest.420000000029062B.quest_desc: [
		"프라이팬, 빵과 버터. 선택이에요.",
		"방법: 프라이팬, 빵과 버터. 선택이에요."
	]
	quest.420000000029062B.title: "토스트 한 장"
	quest.42000000002A062C.quest_desc: [
		"막대 네 개를 네모로. 경작지에 놓으세요. 바닐라 씨앗은 심으면 바뀌지만, Mystical Agriculture 씨앗은 아니에요.",
		"같은 블록에 막대 한 묶음을 더 넣어 교배 작물을 만드세요. 옆에 다 자란 것을 닮는 빈 쌍이라, 네 면을 부모로 둘러싸면 몇 분 안에 스스로 씨를 맺고, 뼛가루를 쓰면 바로 시도가 일어나요.",
		"아홉 부족이 다음 Clowder를 위해 물자를 남겨 두었어요. 청지기 보관함으로 무작위 보급을 열거나, 작은 보관함 넷을 중간으로, 중간 셋을 큰 것으로 만드세요. 큰 봉인일수록 굴림이 많고 보급 폭도 넓으며, 따로 열면 기본 보급이 더 나와요. 안에는 기계나 진행 증표가 숨어 있지 않지만, 모든 봉인에 실 파편의 작은 확률과 귀환의 실 한 줄의 아주 작은 확률이 있고, 큰 봉인일수록 확률이 좋아요.",
		"방법: 막대 네 개를 네모로. 경작지에 놓고 씨앗을 심으세요."
	]
	quest.42000000002A062C.title: "나무 작물 막대"
	quest.42000000002A062D.quest_desc: [
		"책과 깃펜(책, 먹물 주머니, 깃털)과 밀 씨앗. 분석기에 넣어 두세요.",
		"방법: 책과 깃펜(책, 먹물 주머니, 깃털)과 밀 씨앗. 목탄과 유리병으로 잉크가 돼요."
	]
	quest.42000000002A062D.title: "작물 일지"
	quest.42000000002A062E.quest_desc: [
		"유리판과 막대. 작물을 보면 따지 않고 성장, 수확량, 강도를 읽어요.",
		"방법: 막대 사이에 유리판, 그다음 막대 손잡이. 심은 작물을 보세요."
	]
	quest.42000000002A062E.title: "Magnifying Glass"
	quest.42000000002A062F.quest_desc: [
		"유리, 돌 반 블록, 판자, 막대. 일지와 함께 씨앗을 넣으세요. 교배가 보여요.",
		"번식력은 교배를 움직이는 능력치예요. 새 씨앗은 10 중 1이고, 점수가 오를수록 부모로 뽑힐 확률이 올라가요. 분석하고 좋은 것을 다시 심으면 교배가 더 빨라져요.",
		"방법: 유리판, 돌 반 블록, 판자, 막대. 일지를 앉히고 그다음 씨앗을 넣으세요."
	]
	quest.42000000002A062F.title: "Seed Analyzer"
	quest.42000000002A0630.quest_desc: [
		"이 팩에서는 잡초가 꺼져 있지만, 갈퀴는 그래도 막대를 걷어내요. 그래도 하나 들고 다니세요.",
		"방법: 막대 위에 나무 울타리. 잡초는 꺼져 있어요. 그래도 막대를 걷어내요."
	]
	quest.42000000002A0630.title: "나무 갈퀴"
	quest.42000000002A0631.quest_desc: [
		"능력치를 그대로 둔 채 식물을 집어 다시 놓으세요. 10-10을 깨지 않고 옮기세요.",
		"방법: 철 주괴 두 개와 막대. 능력치를 그대로 두고 식물을 집으세요."
	]
	quest.42000000002A0631.title: "모종삽"
	quest.42000000002A0632.quest_desc: [
		"다 자란 식물을 잘라 절단 산출물을 얻고 초기화하세요. 꽃과 일부 HarvestCraft 작물이에요.",
		"방법: 가위, 철, 막대. 다 자란 식물을 잘라 초기화하세요."
	]
	quest.42000000002A0632.title: "적취기"
	quest.42000000002A0633.quest_desc: [
		"교배 계통을 들고 다니세요. 분석기에서 채우고, 막대 위에 비우세요.",
		"방법: 가죽과 끈. 분석기에서 채우세요."
	]
	quest.42000000002A0633.title: "씨앗 주머니"
	quest.42000000002A0634.quest_desc: [
		"더 튼튼한 막대. 심는 규칙은 같고, 부딪혀도 덜 성가셔요.",
		"방법: 철 조각 두 개를 세로로 놓으면 여덟 개가 돼요."
	]
	quest.42000000002A0634.title: "Iron Crop Sticks"
	quest.42000000002A0635.quest_desc: [
		"더 나은 갈퀴. 잡초가 없어도 여전히 습관이에요.",
		"방법: 막대 위에 철창."
	]
	quest.42000000002A0635.title: "철 갈퀴"
	quest.42000000002A0636.quest_desc: [
		"수로를 위해 물을 담아 둬요. 아침마다 양동이를 들지 않는 공중섬 농장이에요.",
		"방법: 판자. 수로를 위해 물을 담아 두세요."
	]
	quest.42000000002A0636.title: "Irrigation Tank"
	quest.42000000002A0637.quest_desc: [
		"물탱크의 물을 이랑을 따라 흘리세요. 작물은 당신이 아니라 수로에서 마셔요.",
		"방법: 물탱크에서 무정형 제작. 물탱크 하나가 수로 여덟 개가 돼요."
	]
	quest.42000000002A0637.title: "Irrigation Channel"
	quest.42000000002A0638.quest_desc: [
		"물탱크를 부수지 않고 줄을 멈추고 다시 흐르게 하세요.",
		"방법: 철창, 빨간색 염료, 철 주괴. 물탱크를 부수지 않고 줄을 멈추고 다시 흐르게 하세요."
	]
	quest.42000000002A0638.title: "Channel Valve"
	quest.42000000002A0639.quest_desc: [
		"네모로 비를 내려요. 막대 위의 수로에 앉히세요.",
		"방법: 막대 위의 수로에 앉히세요. 제작 이름은 JEI에 있어요."
	]
	quest.42000000002A0639.title: "Sprinkler"
	quest.42000000002A063A.quest_desc: [
		"수로를 덮어 이랑을 걸을 수 있게 하세요.",
		"방법: 수로를 덮어 이랑을 걸을 수 있게 하세요."
	]
	quest.42000000002A063A.title: "수로 격자"
	quest.42000000002A063B.quest_desc: [
		"방의 상태를 읽어요. 빛, 습도, 작물이 멈춘 이유예요.",
		"방법: 만든 다음 방에 놓아 빛과 습도를 읽으세요."
	]
	quest.42000000002A063B.title: "Greenhouse Monitor"
	quest.42000000002A063C.quest_desc: [
		"후반의 막대예요. 불에 강하고 고집스러워, 나무로는 버거운 식물용이에요. 이웃한 다 자란 작물 둘은 교배할 수 있어요.",
		"방법: 흑요석 두 개를 세로로 놓으면 여덟 개가 돼요. 이웃한 다 자란 작물 둘은 교배할 수 있어요."
	]
	quest.42000000002A063C.title: "Obsidian Crop Sticks"
	quest.42000000002A063D.quest_desc: [
		"걸을 수 있는 수로. 선택이에요.",
		"방법: 걸을 수 있는 수로. 선택이에요."
	]
	quest.42000000002A063D.title: "속이 빈 수로"
	quest.42000000002A063E.quest_desc: [
		"광석 작물이 이것을 떨어뜨려요. 선택인 교배 계통이에요.",
		"방법: 나무 작물 막대는 막대로. 일지는 책과 깃펜과 씨앗. 분석기는 유리와 나무. 경작지에 심으세요."
	]
	quest.42000000002A063E.title: "구리 조각 작물"
	quest.42000000002A063F.quest_desc: [
		"막대에서 나오는 석영. 선택이에요.",
		"방법: 나무 작물 막대는 막대로. 일지는 책과 깃펜과 씨앗. 분석기는 유리와 나무. 경작지에 심으세요."
	]
	quest.42000000002A063F.title: "석영 조각 작물"
	quest.42000000002A0640.quest_desc: [
		"작물에서 얻는 연료예요. 선택이에요.",
		"방법: 나무 작물 막대는 막대로. 일지는 책과 깃펜과 씨앗. 분석기는 유리와 나무. 경작지에 심으세요."
	]
	quest.42000000002A0640.title: "Coal Pebble"
	quest.42000000002A0641.quest_desc: [
		"후반 광석 작물이에요. 선택이에요.",
		"방법: 나무 작물 막대는 막대로. 일지는 책과 깃펜과 씨앗. 분석기는 유리와 나무. 경작지에 심으세요."
	]
	quest.42000000002A0641.title: "에메랄드 조각 작물"
	quest.42000000002A0642.quest_desc: [
		"후반 광석 작물이에요. 선택이에요.",
		"방법: 나무 작물 막대는 막대로. 일지는 책과 깃펜과 씨앗. 분석기는 유리와 나무. 경작지에 심으세요."
	]
	quest.42000000002A0642.title: "다이아몬드 조각 작물"
	quest.42000000002A0643.quest_desc: [
		"정점 광석 작물이에요. 선택이고, 느려요.",
		"방법: 나무 작물 막대는 막대로. 일지는 책과 깃펜과 씨앗. 분석기는 유리와 나무. 경작지에 심으세요."
	]
	quest.42000000002A0643.title: "Netherite Sliver"
	quest.42000000002A0644.quest_desc: [
		"AgriCraft 만의 꽃이에요. 선택이에요.",
		"방법: 나무 작물 막대는 막대로. 일지는 책과 깃펜과 씨앗. 분석기는 유리와 나무. 경작지에 심으세요."
	]
	quest.42000000002A0644.title: "Amathyllis Petal"
	reward.5000000000060135.title: "귀환의 실: Clowder 목숨 +1"
	reward.5000000000080193.title: "귀환의 실: Clowder 목숨 +1"
	reward.50000000000901CC.title: "귀환의 실: Clowder 목숨 +1"
	reward.5000000000170337.title: "귀환의 실: Clowder 목숨 +1"
