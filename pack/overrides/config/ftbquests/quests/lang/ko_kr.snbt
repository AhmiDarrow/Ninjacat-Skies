	chapter.310000000000002B.chapter_subtitle: [
		"옛 세계의 조각이 공중섬까지 떠올라요. 풀리기 전에 닿으세요."
	]
	chapter.310000000000002B.title: "표류 잔해"
	quest.42000000002B0801.quest_desc: [
		"토양에 장력이 걸리면, 옛 세계의 조각이 가끔 공중섬까지 떠올라 당신의 씨실에 걸려요. 하나가 도착하면 청지기가 Clowder 전체에 알려요.",
		"오래 머물지 않아요. 잔해는 Clowder 의 온라인 시간으로 한동안 버티다 공허로 다시 풀려요. 아무도 떨어지지 않고, 당신이 얻은 것도 잃지 않아요."
	]
	quest.42000000002B0801.title: "떠내려오는 것"
	quest.42000000002B0802.quest_desc: [
		"공중섬 가장자리에 서서 잔해를 마주 보고 계류 실패를 사용하세요. 실다리가 스스로 놓이며, 반 걸음씩 올라가요.",
		"떨어지면 실이 당신을 받아 주고, 하트 셋을 가져가요. 공허는 풍경이지, 벌이 아니에요."
	]
	quest.42000000002B0802.title: "공허를 건너기"
	quest.42000000002B0803.quest_desc: [
		"모든 잔해는 한 가지를 시켜요. 심장 상자를 열거나, 스포너를 부수거나, 기둥에 실을 다시 꿰거나, 메아리를 집까지 걸어 데려가거나, 솔기를 지키세요.",
		"끝내면 발을 들인 사람 모두가 건진 씨실과 인장을 받아요. 인양자의 틀이 씨실을 실패, 미끼, 열쇠, 장식으로 바꿔요."
	]
	quest.42000000002B0803.title: "인양"
	quest.42000000002B0804.quest_desc: [
		"잔해 도감은 당신이 끝낸 부족마다의 장소를 남겨요. 가닥 아홉, 장소 종류 여섯. 열을 다 채우기, 행을 다 채우기, 스탬프를 다 모으기. 각각 작고 영구적인 특전을 줘요.",
		"페이지에는 코덱스의 이야기가 따라와요. 상자에서 찾은 힌트 페이지가 숨은 방을 열어요. 잔해 도감을 열면 이것이 완료돼요."
	]
	quest.42000000002B0804.title: "도감"
	quest.42000000002B0805.quest_desc: [
		"표류 잔해 인장 다섯을 가져오세요. 잔해 다섯을 Clowder 의 누구든 끝낸 것이에요.",
		"반복 가능: 원하는 만큼 제출하세요.",
		"방법: 표류 잔해의 과제를 마치세요. 발을 들인 사람 모두가 인장을 받아요."
	]
	quest.42000000002B0805.title: "인장 다섯"
	quest.42000000002B0806.quest_desc: [
		"해진 생성기 셋을 부수고 핵을 제출하세요.",
		"반복 가능: 원하는 만큼 제출하세요.",
		"방법: 표류 잔해에서 해진 생성기를 부수세요. 각각 핵을 떨어뜨려요."
	]
	quest.42000000002B0806.title: "해진 핵"
	quest.42000000002B0807.quest_desc: [
		"수선한 잔재의 파편이에요. 제출하세요.",
		"반복 가능: 원하는 만큼 제출하세요.",
		"방법: 요새의 봉인된 균열을 씨실 열쇠로 열고, 안의 잔재를 수선하세요."
	]
	quest.42000000002B0807.title: "균열 파편"
	quest.42000000002B0808.quest_desc: [
		"가닥 하나의 핵을 모두. 그 부족의 미끼는 반값이고, 잔해는 조금 더 자주 오며, 깃발은 당신 것이에요."
	]
	quest.42000000002B0808.title: "한 열 전부"
	quest.42000000002B0809.quest_desc: [
		"아홉 부족 모두에서 장소 종류 하나. 그 숨은 방은 이제 항상 열려요."
	]
	quest.42000000002B0809.title: "한 행 전부"
	quest.42000000002B080A.quest_desc: [
		"보정마다 잔해를 하나씩 마치세요. 잔해가 사분의 일 더 오래 버텨요."
	]
	quest.42000000002B080A.title: "스탬프 여섯"
	quest.42000000002B080B.quest_desc: [
		"스물다섯 페이지가 채워졌어요."
	]
	quest.42000000002B080B.title: "도감의 절반"
	quest.42000000002B080C.quest_desc: [
		"그 잔해의 가닥에 맞춰 깎은 씨실 열쇠가 요새의 봉인된 균열을 열어요. 안에는 작고 해진 무언가가 수호자의 모습을 하고 있어요."
	]
	quest.42000000002B080C.title: "균열 속으로"
	quest.42000000002B080D.quest_desc: [
		"잔재 아홉을 모두 수선하세요. 씨실 열쇠는 반값이에요."
	]
	quest.42000000002B080D.title: "모든 잔재"
	quest.42000000002B080E.quest_desc: [
		"쉰네 페이지 전부. Skies 아래 어딘가에서 옛 세계의 심장이 이쪽으로 떠오기 시작해요."
	]
	quest.42000000002B080E.title: "모든 페이지"
	quest.42000000002B080F.quest_desc: [
		"옛 세계의 심장에 서서 실을 다시 꿰세요. 두 번은 오지 않아요."
	]
	quest.42000000002B080F.title: "짜임의 심장"
}
