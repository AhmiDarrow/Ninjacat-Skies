	quest.4200000000150301.title: "가마솥"
	quest.4200000000150302.quest_desc: [
		"아래와 위 용기 사이로 아이템을 자동으로 옮겨요.",
		"방법: 상자 둘레에 철 다섯. 베틀 틀이나 장력 통 아래에 두세요 (아래로 추출)."
	]
	quest.4200000000150302.title: "여분 호퍼"
	quest.4200000000150303.quest_desc: [
		"넣은 아이템을 쏘거나 사용해요.",
		"방법: 조약돌, 활, 그리고 레드스톤."
