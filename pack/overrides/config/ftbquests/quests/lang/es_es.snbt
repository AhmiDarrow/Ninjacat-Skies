{
	chapter.3100000000000001.chapter_subtitle: [
		"Despierta — sobrevive, reclama la plataforma, deja que el Códice despierte."
	]
	chapter.3100000000000001.title: "Hebra: Tierra"
	chapter.3100000000000002.chapter_subtitle: [
		"Recupera — devuelve el mundo caído a la materia."
	]
	chapter.3100000000000002.title: "Hebra: Piedra"
	chapter.3100000000000003.chapter_subtitle: [
		"Enraíza — haz crecer anclas para que la plataforma deje de deshilacharse."
	]
	chapter.3100000000000003.title: "Hebra: Brote"
	chapter.3100000000000004.chapter_subtitle: [
		"Borde — equípate y sal de la plataforma a propósito."
	]
	chapter.3100000000000004.title: "Hebra: Garra"
	chapter.3100000000000005.chapter_subtitle: [
		"Zumba — ritmo y pulso antes que los cables."
	]
	chapter.3100000000000005.title: "Hebra: Chispa"
	chapter.3100000000000006.chapter_subtitle: [
		"Patrón — una fábrica como una canción que se lleva sola."
	]
	chapter.3100000000000006.title: "Hebra: Reloj"
	chapter.3100000000000007.chapter_subtitle: [
		"Colonia — mantén vivo algo que mantiene viva otra cosa."
	]
	chapter.3100000000000007.title: "Hebra: Enjambre"
	chapter.3100000000000008.chapter_subtitle: [
		"Ata — sellos, ritos y dos caminos de trenza en un cordón."
	]
	chapter.3100000000000008.title: "Hebra: Sello"
	chapter.3100000000000009.chapter_subtitle: [
		"Retrama — el telar digital, la Marca, el Fragmento."
	]
	chapter.3100000000000009.title: "Hebra: Huso"
	chapter.310000000000000A.title: "Cedazo hondo"
	chapter.310000000000000B.title: "Almacén y mochilas"
	chapter.310000000000000C.title: "Factoría Mekanism"
	chapter.310000000000000D.title: "Red Powah"
	chapter.310000000000000E.title: "Lado arcano"
	chapter.310000000000000F.chapter_subtitle: [
		"Equipos, la Sala, el Poste y el Desgarro."
	]
	chapter.310000000000000F.title: "Sala Clowder"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Línea de cocina"
	chapter.3100000000000013.title: "Hechizos de batalla"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Decoración de plataforma"
	chapter.3100000000000016.title: "Apoyo en el Nether"
	chapter.3100000000000017.title: "Apoyo en el End"
	chapter.3100000000000018.title: "Campos de esencia"
	chapter.3100000000000019.chapter_subtitle: [
		"Cada nido es un anillo de algo alrededor de una flor."
	]
	chapter.3100000000000019.title: "Colmenar del Enjambre"
	chapter.310000000000001A.title: "Red de tubos"
	chapter.310000000000001B.title: "Otro mundo"
	chapter.310000000000001C.title: "Relojería profunda"
	chapter.310000000000001D.title: "Red de Huso"
	chapter.310000000000001E.title: "Oficio del vacío"
	chapter.310000000000001F.title: "Líneas empaquetadas"
	chapter.3100000000000020.title: "QIO y la cima de Mek"
	chapter.3100000000000021.title: "Caza y granja"
	chapter.3100000000000022.title: "Tejido tribal"
	chapter.3100000000000023.chapter_subtitle: [
		"Los Cantores de grava cortan una piedra de cien modos."
	]
	chapter.3100000000000023.title: "Cantero"
	chapter.3100000000000024.chapter_subtitle: [
		"Una plataforma es un repecho hasta que alguien le pone una silla."
	]
	chapter.3100000000000024.title: "Mobiliario"
	chapter.3100000000000025.chapter_subtitle: [
		"Las máquinas pequeñas que dejaron los custodios."
	]
	chapter.3100000000000025.title: "Pequeñas custodías"
	chapter.3100000000000026.chapter_subtitle: [
		"El pulso de los Corazones de tambor aprende a correr por el cobre."
	]
	chapter.3100000000000026.title: "La corriente"
	chapter.3100000000000027.chapter_subtitle: [
		"El Corte partió a trece guardianes. Vuelve a tensar cada Hebra venciendo a su guardián."
	]
	chapter.3100000000000027.title: "Guardianes partidos"
	chapter.3100000000000028.chapter_subtitle: [
		"Recorre la Marca. Domestica un amarillo. Esther espera en la Sala después de que hayas estado allí."
	]
	chapter.3100000000000028.title: "Corredores de plataforma"
	chapter.3100000000000029.chapter_subtitle: [
		"Huertos del cedazo. Cocina lo que una plataforma del vacío nunca cultivó."
	]
	chapter.3100000000000029.title: "Mesa de la cosecha"
	chapter.310000000000002A.chapter_subtitle: [
		"Palos de cultivo, estadísticas, riego. En un saliente, las malas hierbas no se asientan."
	]
	chapter.310000000000002A.title: "Palos de cultivo"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Fabricar y tensión"
	chapter_group.2100000000000003.title: "Retramar"
	chapter_group.2100000000000004.title: "Caminos laterales"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"Despertaste en un saliente. Mira el precipicio y luego haz clic aquí.",
		"El acento grave (`) es la lista de tareas. El Códice de los Bigotes es Empieza aquí.",
		"Cómo: haz clic en la misión. Luego golpea el roble."
	]
	quest.4200000000018001.title: "Mira el precipicio"
	quest.4200000000010001.quest_desc: [
		"Eres Skybound. Esto es lo que no cayó.",
		"Ocho troncos. Empieza por el árbol; él empezó contigo.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: golpea el roble de tu plataforma. Ocho troncos empiezan Despertar."
	]
	quest.4200000000010001.title: "Despertar en una plataforma"
	quest.4200000000010002.quest_desc: [
		"La tierra es una promesa que la plataforma le hace a tus botas.",
		"Dieciséis bloques. Ensancha la promesa.",
		"Cómo: cofre inicial, sumidero de roca+hilo, sobras del cedazo, o /clowder hub (Guardianes de la plataforma)."
	]
	quest.4200000000010002.title: "Algo donde pisar"
	quest.4200000000010003.quest_desc: [
		"Las manos necesitan una superficie. Todo lo que viene después es una superficie.",
		"Cómo: cuatro tablas en un cuadrado."
	]
	quest.4200000000010003.title: "Haz una mesa de trabajo"
	quest.4200000000010004.quest_desc: [
		"Garra llega después. Por ahora, madera que muerde.",
		"Cómo: tres tablas sobre dos palos."
	]
	quest.4200000000010004.title: "Pico de madera"
	quest.4200000000010005.quest_desc: [
		"Verde contra el precipicio.",
		"Plántalo antes de tener hambre.",
		"Cómo: rompe hojas de roble, o /clowder hub Atarraíces (8 Hilo por cuatro)."
	]
	quest.4200000000010005.title: "Primer retoño"
	quest.4200000000010006.quest_desc: [
		"Sesenta y cuatro tablas son una plataforma que deja de sentirse como un saliente.",
		"Cómo: un tronco en la cuadrícula de crafteo da cuatro."
	]
	quest.4200000000010006.title: "Reserva de tablas"
	quest.4200000000010007.quest_desc: [
		"Mangos, armazones, los huesos de las herramientas.",
		"Cómo: dos tablas en una columna."
	]
	quest.4200000000010007.title: "Manojo de palos"
	quest.4200000000010008.quest_desc: [
		"Pon las cosas donde se queden. Un Clowder comparte un cofre antes que cualquier otra cosa.",
		"Cómo: ocho tablas alrededor de un centro vacío."
	]
	quest.4200000000010008.title: "Cofre para el Clowder"
	quest.4200000000010009.quest_desc: [
		"Mira el borde antes de que el borde te vea.",
		"Cómo: carbón o carbón vegetal sobre un palo. En /clowder hub los Parientes venden un paquete."
	]
	quest.4200000000010009.title: "Línea de antorchas"
	quest.420000000001000A.quest_desc: [
		"El hielo y la lava hacen piedra donde no había.",
		"Las plataformas Normal y Difícil traen las dos. Los Guardianes de la plataforma en /clowder hub venden un cubo.",
		"Cómo: lava junto al agua (o hielo derretido). Martillea la piedra. El puesto de los Cantores de grava en /clowder hub vende un fardo."
	]
	quest.420000000001000A.title: "Reserva de roca"
	quest.420000000001000B.quest_desc: [
		"Calor que todavía no es Chispa.",
		"Los Guardianes de la plataforma habrían llamado a esto un hogar.",
		"Cómo: ocho rocas alrededor de un centro vacío."
	]
	quest.420000000001000B.title: "Calor del horno"
	quest.420000000001000C.quest_desc: [
		"El hambre es un vacío blando. Ocho hogazas lo cierran un rato.",
		"Cómo: tres trigos en fila, o /clowder hub Guardián del hogar."
	]
	quest.420000000001000C.title: "Cocina una comida"
	quest.420000000001000D.quest_desc: [
		"Pon lava, funde el hielo en una fuente y llena el cubo.",
		"Fácil trae agua; Normal y Difícil traen las piezas.",
		"Cómo: cubo vacío sobre una fuente de agua. Normal/Difícil: pon lava, funde el hielo, llena."
	]
	quest.420000000001000D.title: "Atrapa la lluvia"
	quest.420000000001000E.quest_desc: [
		"Retales del Telar que aún aguantan. Cada misión devuelve algunos.",
		"Desteje uno para cuerda, o gástalos en los puestos de los Parientes en /clowder hub.",
		"Cómo: recompensas de misiones, tierra con malla de pedernal en un Bastidor del telar, alijos del custodio."
	]
	quest.420000000001000E.title: "Moneda deshilachada"
	quest.420000000001000F.quest_desc: [
		"Dañado, pero aún enseña. Abre Empieza aquí.",
		"Clic derecho en el libro y abre Empieza aquí. Acento grave (`): la lista de tareas.",
		"Cómo: kit inicial / cofre del muelle. Clic derecho en el libro; el acento grave (`) es la lista de tareas."
	]
	quest.420000000001000F.title: "Códice en mano"
	quest.4200000000010010.quest_desc: [
		"Fija un punto de reaparición.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010010.title: "Reclamo de cama"
	quest.4200000000010011.quest_desc: [
		"Baja a las profundidades sin soga. Tan barata que puedes dejar una en cada pozo.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010011.title: "Escalera abajo"
	quest.4200000000010012.quest_desc: [
		"Seda de araña guardada para mallas de más adelante. Cada fibra acaba usándose.",
		"Cómo: desteje Hilo deshilachado (1 → 3). Arañas. Pelusa del telar en una Atadura de eco. Sumidero inverso de estambre."
	]
	quest.4200000000010012.title: "Reserva de cuerda"
	quest.4200000000010013.quest_desc: [
		"Acelera lo verde.",
		"Cómo: huesos en una cuadrícula, o sumidero de Hilo + carne podrida, o /clowder hub Guardianes de la plataforma."
	]
	quest.4200000000010013.title: "Reserva de polvo de hueso"
	quest.4200000000010014.quest_desc: [
		"Ensancha la plataforma.",
		"Cómo: cofre inicial, sumidero de roca+hilo, sobras del cedazo, o /clowder hub (Guardianes de la plataforma)."
	]
	quest.4200000000010014.title: "Plataforma de tierra"
	quest.4200000000010015.quest_desc: [
		"Pódalas ahora, compostálas después. En una plataforma no se desperdicia nada.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010015.title: "Hojas de roble"
	quest.4200000000010016.quest_desc: [
		"Un rincón tranquilo.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010016.title: "Maceta"
	quest.4200000000010017.quest_desc: [
		"El barril de Ex Deorum: compost, y agua en arcilla por el camino lento.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010017.title: "Barril"
	quest.4200000000010018.quest_desc: [
		"Desecho a polvo.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010018.title: "Compostador"
	quest.4200000000010019.quest_desc: [
		"Ara un surco.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010019.title: "Azada de madera"
	quest.420000000001001A.quest_desc: [
		"Tala troncos más rápido que las manos desnudas. La primera herramienta de verdad que posee un Skybound.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001001A.title: "Hacha de madera"
	quest.420000000001001B.quest_desc: [
		"Convierte tierra y grava en suelo despejado. Lenta, pero funciona.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001001B.title: "Pala de madera"
	quest.420000000001001C.quest_desc: [
		"Apenas detiene a un zombi, pero lo detiene. Mejor que blandir un puño.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001001C.title: "Espada de madera"
	quest.420000000001001D.quest_desc: [
		"Cabe sopa, estofado y poco más. Vajilla simple para una plataforma simple.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001001D.title: "Cuenco"
	quest.420000000001001E.quest_desc: [
		"Etiqueta la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001001E.title: "Marco"
	quest.420000000001001F.quest_desc: [
		"Hazlo un hogar.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001001F.title: "Cuadro"
	quest.4200000000010020.quest_desc: [
		"Deja el viento y los monstruos en el lado correcto del muro.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010020.title: "Puerta de roble"
	quest.4200000000010021.quest_desc: [
		"Marca un borde sin tapar la vista. Útil donde la caída es de verdad.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010021.title: "Valla de roble"
	quest.4200000000010022.quest_desc: [
		"Convierte un muro liso en algo que sí puedes trepar.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010022.title: "Escaleras de roble"
	quest.4200000000010023.quest_desc: [
		"Medio bloque, el doble de opciones de suelo. Útil en sitios estrechos.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010023.title: "Losa de roble"
	quest.4200000000010024.quest_desc: [
		"Trampillas de acceso.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010024.title: "Trampilla de roble"
	quest.4200000000010025.quest_desc: [
		"Dispara una señal cuando algo la pisa. Las puertas se abren solas.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010025.title: "Placa de presión de roble"
	quest.4200000000010026.quest_desc: [
		"Botón para toques de redstone.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010026.title: "Botón de roble"
	quest.4200000000010027.quest_desc: [
		"Valla el borde de la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010027.title: "Puerta de valla de palos"
	quest.4200000000010028.quest_desc: [
		"Cocina la comida despacio y deja el humo visible a leguas.",
		"Cómo: troncos, palos y carbón o carbón vegetal."
	]
	quest.4200000000010028.title: "Hoguera"
	quest.4200000000010029.quest_desc: [
		"Cuelga luz donde una antorcha quedaría mal. Brillo más cálido, el mismo trabajo.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010029.title: "Farol"
	quest.420000000001002A.quest_desc: [
		"Arde de un azul pálido y evita que casi todo aparezca cerca.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001002A.title: "Farol de almas"
	quest.420000000001002B.quest_desc: [
		"Sube contigo y desaparece al tirar. Construir en alto deja de dar miedo.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001002B.title: "Andamio"
	quest.420000000001002C.quest_desc: [
		"Cadena para colgar un adorno.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001002C.title: "Cadena"
	quest.420000000001002D.quest_desc: [
		"Enjaula el borde.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001002D.title: "Barras de hierro"
	quest.420000000001002E.quest_desc: [
		"Cristal para las ventanas de la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001002E.title: "Panel de cristal"
	quest.420000000001002F.quest_desc: [
		"Suave, inflamable y fácil de teñir. Toda plataforma acaba necesitando una cama.",
		"Cómo: esquila las ovejas después de darles hierba, o cuatro cuerdas."
	]
	quest.420000000001002F.title: "Lana blanca"
	quest.4200000000010030.quest_desc: [
		"Una capa fina de lana para suelos que no necesitan un bloque entero.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010030.title: "Alfombra blanca"
	quest.4200000000010031.quest_desc: [
		"Aporta un poco de verde y rosa a una plataforma hecha de grava.",
		"Cómo: musgo más roble, o polvo de hueso sobre el musgo. Las abejas aceptan la flor."
	]
	quest.4200000000010031.title: "Azalea en flor"
	quest.4200000000010032.quest_desc: [
		"Se extiende despacio y suaviza el aspecto de las plataformas de piedra en bruto.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010032.title: "Bloque de musgo"
	quest.4200000000010033.quest_desc: [
		"Raíces colgantes bajo la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010033.title: "Raíces colgantes"
	quest.4200000000010034.quest_desc: [
		"Se agarra a las paredes y las ilumina sin una sola antorcha.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010034.title: "Liquen luminoso"
	quest.4200000000010035.quest_desc: [
		"Espeleotema para un toque puntiagudo.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010035.title: "Espeleotema puntiagudo"
	quest.4200000000010036.quest_desc: [
		"Amatista en un bloque. Sello querrá esquirlas más adelante.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010036.title: "Bloque de amatista"
	quest.4200000000010037.quest_desc: [
		"Nueve lingotes prensados. Se pone verde si lo dejas fuera.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010037.title: "Bloque de cobre"
	quest.4200000000010038.quest_desc: [
		"Nueve trozos de hierro en bruto bien apilados, a la espera de un horno.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010038.title: "Bloque de hierro en bruto"
	quest.4200000000010039.quest_desc: [
		"Arde mucho más que el carbón suelto. Alimenta el horno y vete.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000010039.title: "Bloque de carbón"
	quest.420000000001003A.quest_desc: [
		"Alimenta a los animales y frena una caída. Los granjeros lo tienen cerca por las dos cosas.",
		"Cómo: nueve de trigo. Tres de trigo también hacen pan."
	]
	quest.420000000001003A.title: "Bloque de heno"
	quest.420000000001003B.quest_desc: [
		"Nueve algas prensadas como combustible. Funde más de lo que parece.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001003B.title: "Bloque de algas secas"
	quest.420000000001003C.quest_desc: [
		"Papel y cuero, a la espera de ser algo con receta.",
		"Cómo: tres papeles más cuero. El papel es caña de azúcar."
	]
	quest.420000000001003C.title: "Libro"
	quest.420000000001003D.quest_desc: [
		"Papel para libros y mapas.",
		"Cómo: tres cañas de azúcar en fila. La caña sale al cribar tierra con malla de pedernal o mejor."
	]
	quest.420000000001003D.title: "Papel"
	quest.420000000001003E.quest_desc: [
		"El tinte y los libros necesitan tinta.",
		"Cómo: carbón vegetal más una botella de cristal. Los calamares nunca aparecen aquí."
	]
	quest.420000000001003E.title: "Saco de tinta"
	quest.420000000001003F.quest_desc: [
		"Plumas para flechas y libros.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000001003F.title: "Pluma"
	quest.4200000000010040.quest_desc: [
		"Cuero para libros y kits.",
		"Cómo: funde carne podrida o cocínala en la hoguera. Criba tierra con malla de pedernal. /clowder hub Los Guardianes de la plataforma venden dos por 18 Hilo."
	]
	quest.4200000000010040.title: "Cuero"
	quest.4200000000010041.quest_desc: [
		"Mesa, retoño, hogar, agua, Códice. La plataforma aguanta.",
		"Tensa la Hebra: los Guardianes de la plataforma responden, y la ficha es tuya para asentarla.",
		"Reclámalo y elige un regalo de la tribu: un Hilo del Retorno para una vida compartida más, o suministros.",
		"Cómo: termina las misiones enlazadas a esta y luego reclámala para la ficha de Hebra. Asienta la ficha en tu Poste de tensión."
	]
	quest.4200000000010041.quest_subtitle: "Despertar"
	quest.4200000000010041.title: "Nudo de Tierra"
	quest.4200000000010042.quest_desc: [
		"Clic derecho en el Poste de tensión de tu Clowder con la ficha.",
		"La muesca se enciende, la tribu repica, la plataforma cambia.",
		"Cómo: clic derecho en tu Poste de tensión con la ficha de Hebra en la mano."
	]
	quest.4200000000010042.title: "Asienta Tierra"
	quest.4200000000010043.quest_desc: [
		"Un zombi en una plataforma sin cuevas. El vacío manda recuerdos.",
		"Ilumina los bordes.",
		"Cómo: mata un zombi en la plataforma de noche. Ilumina los bordes."
	]
	quest.4200000000010043.title: "Ha surgido algo"
	quest.4200000000020044.quest_desc: [
		"Hilo que recuerda de dónde vino.",
		"Desteje Hilo en cuerda; cuatro cuerdas hilan dos estambres.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: cuatro cuerdas → dos estambres. Barril de tensión: cuerda + perla. Cuatro Pelusas del telar."
	]
	quest.4200000000020044.title: "Saca Hilaza del vacío"
	quest.4200000000020045.quest_desc: [
		"Roca y palos. Rompe la arenilla caída en grava, arena y polvo.",
		"Cómo: roca + palos. Rompe arenilla en grava, arena y polvo."
	]
	quest.4200000000020045.title: "Martillo de huso"
	quest.4200000000020046.quest_desc: [
		"Cuerda alrededor de estambre. Atrapa lo que soltó el Telar — y peina Pelusa del telar de la tierra.",
		"Cómo: cuerda alrededor de estambre. El puesto de los Cantores de grava vende una."
	]
	quest.4200000000020046.title: "Enhebra la malla"
	quest.4200000000020047.quest_desc: [
		"Vierte agua; el cubo vuelve al momento. Añade tierra. Espera la arcilla.",
		"Cuerda y una perla en el mismo barril hacen estambre.",
		"Cómo: tablas, cuerda e Hilaza del vacío. Vierte agua (el cubo vuelve), añade tierra → arcilla."
	]
	quest.4200000000020047.title: "Barril de tensión"
	quest.4200000000020048.quest_desc: [
		"Dieciséis de arcilla del barril. Carga ocho de tierra cada vez.",
		"Cómo: Barril de tensión — agua + tierra. La Fractura de eco machaca arena en arcilla."
	]
	quest.4200000000020048.title: "Bolsillo de arcilla"
	quest.4200000000020049.quest_desc: [
		"Arcilla y polvo de hueso. Da forma al cubo sin cocer.",
		"Cómo: bola de arcilla + polvo de hueso, sin forma. La arcilla sale del Barril de tensión."
	]
	quest.4200000000020049.title: "Arcilla de porcelana"
	quest.420000000002004A.quest_desc: [
		"Fúndelo. La porcelana lleva la lava donde el hierro aún es un rumor.",
		"Cómo: da forma a la arcilla de porcelana en un cubo sin cocer y luego fúndelo."
	]
	quest.420000000002004A.title: "Herramienta de porcelana"
	quest.420000000002004B.quest_desc: [
		"Los Cantores de grava nombraban cada fragmento por su eco.",
		"Criba hasta que oigas el hierro.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.420000000002004B.title: "Criba arenilla caída"
	quest.420000000002004C.quest_desc: [
		"Un juego de golpes de sobra.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.420000000002004C.title: "Martillo de madera"
	quest.420000000002004D.quest_desc: [
		"Materia de la arenilla. Sesenta y cuatro piedras que hace una hora eran polvo.",
		"Cómo: lava junto al agua (o hielo derretido). Martillea la piedra. El puesto de los Cantores de grava en /clowder hub vende un fardo."
	]
	quest.420000000002004D.title: "Guijarros"
	quest.420000000002004E.quest_desc: [
		"El polvo del Telar espera en la grava. El pedernal también.",
		"Cómo: golpea roca (Martillo de huso o Fractura de eco)."
	]
	quest.420000000002004E.title: "Camino de grava"
	quest.420000000002004F.quest_desc: [
		"Arenilla fina. Vidrio más tarde, y la mejor captura de la malla de hierro.",
		"Cómo: golpea grava."
	]
	quest.420000000002004F.title: "Alijo de arena"
	quest.4200000000020050.quest_desc: [
		"Ceniza del mundo caído. El redstone y la pólvora se esconden en ella.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.4200000000020050.title: "Montón de polvo"
	quest.4200000000020051.quest_desc: [
		"Estambre alrededor de slime. El compost de la plataforma hace el slime.",
		"El Nudo es la puerta blanda del Telar; guarda dos.",
		"Cómo: anillo de Hilaza del vacío alrededor de una bola de slime."
	]
	quest.4200000000020051.title: "Ata un Nudo vinculante"
	quest.4200000000020052.quest_desc: [
		"Tablas alrededor de un Nudo. Tensa una malla, carga arenilla y déjala trabajar.",
		"Las tolvas lo alimentan. Es la primera máquina de la plataforma.",
		"Cómo: tablas alrededor de un Nudo vinculante. Tensa una malla, mete arenilla con una tolva y ponlo sobre una tolva."
	]
	quest.4200000000020052.title: "Alza el Bastidor del telar"
	quest.4200000000020053.quest_desc: [
		"El hierro es grave y paciente. Ocho trozos de la malla.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.4200000000020053.title: "Trozo de mena de hierro"
	quest.4200000000020054.quest_desc: [
		"Cribado de la grava, poco a poco. La malla encuentra el cobre antes que tus ojos.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.4200000000020054.title: "Trozo de mena de cobre"
	quest.4200000000020055.quest_desc: [
		"El oro apenas se molesta en responder. Con cuatro basta.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.4200000000020055.title: "Trozo de mena de oro"
	quest.4200000000020056.quest_desc: [
		"Alimenta la línea.",
		"Cómo: criba grava, o funde mena de carbón."
	]
	quest.4200000000020056.title: "Carbón"
	quest.4200000000020057.quest_desc: [
		"De trozos a crudo. Sigue fundiendo.",
		"Cómo: criba grava para trozos de mena de hierro; cuatro hacen un bloque de mena de hierro, y al minarlo suelta hierro crudo."
	]
	quest.4200000000020057.title: "Hierro en bruto"
	quest.4200000000020058.quest_desc: [
		"Recuperación paga. Dieciséis lingotes que el vacío no quería que tuvieras.",
		"Cómo: funde hierro en bruto / arenilla de hierro (horno o Horno de brasas). Criba grava para sacar trozos."
	]
	quest.4200000000020058.title: "Lingote de hierro"
	quest.4200000000020059.quest_desc: [
		"Cable y bombillas, y resonadores tribales más tarde.",
		"Cómo: funde cobre en bruto / arenilla de cobre. Criba grava."
	]
	quest.4200000000020059.title: "Lingote de cobre"
	quest.420000000002005A.quest_desc: [
		"Herramientas doradas, y placas de oro para los Tejedores de patrones.",
		"Cómo: funde oro en bruto / arenilla de oro. Captura más rara del cedazo."
	]
	quest.420000000002005A.title: "Lingote de oro"
	quest.420000000002005B.quest_desc: [
		"Captura más fina. Las mallas de pedernal sacuden Hilo deshilachado de la arenilla.",
		"Cómo: pedernal alrededor de una malla de Hilo (cuerda)."
	]
	quest.420000000002005B.title: "Malla de pedernal"
	quest.420000000002005C.quest_desc: [
		"Hilo metálico para el polvo más pesado. Las mallas de hierro son donde cae el Filamento de Hebra.",
		"Cómo: hierro alrededor de una malla de Hilo (pedernal). Aquí empieza el Filamento de Hebra."
	]
	quest.420000000002005C.title: "Malla de hierro"
	quest.420000000002005D.quest_desc: [
		"Funde y gotea. Del adoquín a la lava, si le das tiempo.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.420000000002005D.title: "Crisol"
	quest.420000000002005E.quest_desc: [
		"El barril de Ex Deorum: compost, y agua en arcilla por el camino lento.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.420000000002005E.title: "Barril (piedra)"
	quest.420000000002005F.quest_desc: [
		"Golpes más duros, vida más larga.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.420000000002005F.title: "Martillo de piedra"
	quest.4200000000020060.quest_desc: [
		"Tritura la mena en grava y arenilla, el truco ruidoso detrás del cedazo.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.4200000000020060.title: "Martillo de hierro"
	quest.4200000000020061.quest_desc: [
		"Malla más ancha, nueve de una vez.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.4200000000020061.title: "Cedazo comprimido"
	quest.4200000000020062.quest_desc: [
		"Se ve a través. De arena a vidrio.",
		"Cómo: funde arena. Martillea adoquín hasta grava, grava hasta arena, y luego al horno."
	]
	quest.4200000000020062.title: "Vidrio"
	quest.4200000000020063.quest_desc: [
		"Ahora lleva la lluvia en hierro.",
		"Cómo: tres lingotes de hierro, o /clowder hub Guardianes de la plataforma (8 Hilo). Llénalo a partir de hielo fundido."
	]
	quest.4200000000020063.title: "Cubo"
	quest.4200000000020064.quest_desc: [
		"Calor del vacío, en la mano.",
		"Cómo: crisol de lava de Ex Deorum, o un lago de lava del Nether tras la obsidiana de Garra."
	]
	quest.4200000000020064.title: "Cubo de lava"
	quest.4200000000020065.quest_desc: [
		"Pensamientos de portal. Agua sobre una fuente de lava.",
		"Cómo: agua sobre una fuente de lava (o lava sobre agua). Conserva la fuente de lava."
	]
	quest.4200000000020065.title: "Obsidiana"
	quest.4200000000020066.quest_desc: [
		"Suerte rara con la arenilla. Dos es un comienzo.",
		"Cómo: criba grava con una malla de hierro o mejor, o mena de diamante en la Fractura de eco."
	]
	quest.4200000000020066.title: "Diamante"
	quest.4200000000020067.quest_desc: [
		"Combustible para mejorar la malla.",
		"Cómo: grava, o sumidero de Hilo + grava."
	]
	quest.4200000000020067.title: "Pedernal"
	quest.4200000000020068.quest_desc: [
		"Hecha de arenilla y polvo, no saqueada de un creeper. Manéjala con cuidado.",
		"Cómo: criba polvo o arena de almas, o creepers en la plataforma de noche. Mantén los bordes iluminados cuando ya tengas un poco."
	]
	quest.4200000000020068.title: "Pólvora"
	quest.4200000000020069.quest_desc: [
		"Chispa lo va a querer. Manténlo seco.",
		"Cómo: criba grava, o mena de redstone en la Fractura de eco tras Recuperación."
	]
	quest.4200000000020069.title: "Redstone"
	quest.420000000002006A.quest_desc: [
		"Alimenta la mesa de encantamientos. Polvo azul que hace que el equipo escuche mejor.",
		"Cómo: criba grava, o mena de lapislázuli en la Fractura de eco."
	]
	quest.420000000002006A.title: "Lapislázuli"
	quest.420000000002006B.quest_desc: [
		"Una mezcla de piedra corriente, útil sobre todo para construir y para mezclar recetas más tarde.",
		"Cómo: criba guijarros de tierra/grava, o adoquín más diorita en JEI."
	]
	quest.420000000002006B.title: "Andesita"
	quest.420000000002006C.quest_desc: [
		"Piedra moteada, más decorativa que estructural. Los Cantores de grava la llamaban la ruidosa.",
		"Cómo: criba guijarros, o adoquín más cuarzo del Nether."
	]
	quest.420000000002006C.title: "Diorita"
	quest.420000000002006D.quest_desc: [
		"Densa y con motas rosas, buena para un suelo que quiere destacar.",
		"Cómo: criba guijarros, o diorita más cuarzo del Nether."
	]
	quest.420000000002006D.title: "Granito"
	quest.420000000002006E.quest_desc: [
		"Roca porosa del otro lugar. Arde para siempre en cuanto prende.",
		"Cómo: el Nether aquí es vacío, no terreno. Vierte lava en un barril de Ex Deorum con agua de bruja (un barril de agua sobre micelio; las esporas de micelio se criban de la tierra)."
	]
	quest.420000000002006E.title: "Piedra del Nether"
	quest.420000000002006F.quest_desc: [
		"Frena cada paso que lo cruza, y da al fuego de almas un azul más frío.",
		"Cómo: arena en un barril de Ex Deorum con agua de bruja. Las salas de verrugas de la fortaleza guardan un poco. Tres calaveras sobre arena de almas hacen un Wither."
	]
	quest.420000000002006F.title: "Arena de almas"
	quest.4200000000020070.quest_desc: [
		"Molido de la piedra luminosa del Nether, útil para brebajes y para luces más suaves.",
		"Cómo: criba arena de almas, o brujas en la plataforma."
	]
	quest.4200000000020070.title: "Polvo de piedra luminosa"
	quest.4200000000020071.quest_desc: [
		"Arranca las hojas de un árbol sin blandir un hacha contra el tronco.",
		"Cómo: cuatro palos. El puesto de los Cantores de grava vende uno."
	]
	quest.4200000000020071.title: "Cayado"
	quest.4200000000020072.quest_desc: [
		"Sale del cedazo en montones que crecen. Nunca alcanza del todo para cada malla.",
		"Cómo: desteje Hilo deshilachado (1 → 3). Arañas. Pelusa del telar en una Atadura de eco. Sumidero inverso de estambre."
	]
	quest.4200000000020072.title: "Cuerda"
	quest.4200000000020073.quest_desc: [
		"Ligante de nudos — o receta de compost de la plataforma.",
		"Cómo: dos tierras + semillas de trigo + polvo de hueso (compost de la plataforma), o /clowder hub Guardianes de la plataforma."
	]
	quest.4200000000020073.title: "Bola de slime"
	quest.4200000000020074.quest_desc: [
		"Molido da polvo de hueso, o entero para criar al siguiente lobo de la manada.",
		"Cómo: esqueletos de noche, o /clowder hub Guardianes de la plataforma (16 de Hilo por 8)."
	]
	quest.4200000000020074.title: "Hueso"
	quest.4200000000020075.quest_desc: [
		"Amargo y un poco tóxico. Los alquimistas lo usan; nadie lo come solo.",
		"Cómo: arañas en la plataforma de noche."
	]
	quest.4200000000020075.title: "Ojo de araña"
	quest.4200000000020076.quest_desc: [
		"Estambre, porcelana, un Bastidor del telar que funcione, hierro en el cofre.",
		"Tensa la Hebra: responden los Cantores de grava.",
		"Reclámalo y elige un regalo de la tribu: un Hilo del Retorno para una vida compartida más, o suministros.",
		"Cómo: termina las misiones enlazadas a esta y luego reclámala para la ficha de Hebra. Asienta la ficha en tu Poste de tensión."
	]
	quest.4200000000020076.quest_subtitle: "Recuperación"
	quest.4200000000020076.title: "Nudo de Piedra"
	quest.4200000000020077.quest_desc: [
		"Clic derecho en el Poste de tensión de tu Clowder con la ficha.",
		"La muesca se enciende, la tribu repica, la plataforma cambia.",
		"Cómo: clic derecho en tu Poste de tensión con la ficha de Hebra en la mano."
	]
	quest.4200000000020077.title: "Asienta Piedra"
	quest.4200000000020078.quest_desc: [
		"Un creeper, resuelto. La pólvora vale más que el susto.",
		"Cómo: mata a tres creepers. La pólvora es la recompensa."
	]
	quest.4200000000020078.title: "Bum, más tarde"
	quest.4200000000030079.quest_desc: [
		"Ara filas en la plataforma.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: dos lingotes de hierro sobre un palo."
	]
	quest.4200000000030079.title: "Azada de hierro"
	quest.420000000003007A.quest_desc: [
		"El pan es infraestructura. Treinta y dos trigos son un campo, no un bancal.",
		"Cómo: semillas de trigo en tierra de cultivo, luego polvo de hueso. Las semillas salen al romper hierba o del cofre inicial."
	]
	quest.420000000003007A.title: "Campo de trigo"
	quest.420000000003007B.quest_desc: [
		"Planta lo que comes.",
		"Cómo: rompe hierba, o criba tierra con una malla de pedernal. Planta en tierra de cultivo; el polvo de hueso acelera el primer campo."
	]
	quest.420000000003007B.title: "Bolsa de semillas"
	quest.420000000003007C.quest_desc: [
		"La velocidad es amabilidad. Compost y huesos.",
		"Cómo: huesos en una cuadrícula, o sumidero de Hilo + carne podrida, o /clowder hub Guardianes de la plataforma."
	]
	quest.420000000003007C.title: "Motor de polvo de hueso"
	quest.420000000003007D.quest_desc: [
		"Prepara la cosecha.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000003007D.title: "Cuchillo de granjero"
	quest.420000000003007E.quest_desc: [
		"Aquí empieza una cocina.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000003007E.title: "Tabla de cortar"
	quest.420000000003007F.quest_desc: [
		"Las comidas calientes sacian más que el hambre.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000003007F.title: "Olla de cocina"
	quest.4200000000030080.quest_desc: [
		"Crece en cogollos ordenados, mejor cocinada en algo que cruda.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000030080.title: "Col"
	quest.4200000000030081.quest_desc: [
		"Trepa su propio enrejado y madura rojo. La salsa empieza aquí.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000030081.title: "Tomate"
	quest.4200000000030082.quest_desc: [
		"Lágrimas de alegría.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000030082.title: "Cebolla"
	quest.4200000000030083.quest_desc: [
		"Empieza el cultivo de esencia. Dieciséis de la primera hilera.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"La columna de las semillas. Críbala o cultívala.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Alza semillas a partir de esencia.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030085.title: "Altar de infusión"
	quest.4200000000030086.quest_desc: [
		"Cuatro alrededor del altar.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030086.title: "Pedestal de infusión"
	quest.4200000000030087.quest_desc: [
		"Haz crecer más plataforma.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030087.title: "Semillas de tierra"
	quest.4200000000030088.quest_desc: [
		"Haz crecer el dosel sin el hacha.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030088.title: "Semillas de madera"
	quest.4200000000030089.quest_desc: [
		"Cultivado, no minado. Cosecha esencia en vez de blandir un pico.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030089.title: "Semillas de piedra"
	quest.420000000003008A.quest_desc: [
		"Metal de un cultivo. El segundo motor de Recuperación.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000003008A.title: "Semillas de hierro"
	quest.420000000003008B.quest_desc: [
		"Un cultivo que da esencia de cobre en vez de mena de cobre.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000003008B.title: "Semillas de cobre"
	quest.420000000003008C.quest_desc: [
		"Un cultivo dorado que hace crecer esencia de oro en la propia plataforma.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000003008C.title: "Semillas de oro"
	quest.420000000003008D.quest_desc: [
		"Convierte un bancal en fuente de combustible, sin necesidad de minar.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000003008D.title: "Semillas de carbón"
	quest.420000000003008E.quest_desc: [
		"Lluvia embotellada, salida de un cultivo.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000003008E.title: "Semillas de agua"
	quest.420000000003008F.quest_desc: [
		"Crecimiento compacto para una plataforma pequeña.",
		"Cómo: Botany Pot de terracota en JEI. Tierra + una semilla en la maceta; el polvo de hueso sigue ayudando."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"La maceta que se cosecha sola.",
		"Cómo: Botany Pot con tolva en JEI. Se pone sobre un cofre/tolva y se cosecha solo."
	]
	quest.4200000000030090.title: "Maceta tolva"
	quest.4200000000030091.quest_desc: [
		"Sube de grado. Las semillas se vuelven más codiciosas y mejores.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"Un grado más profundo de esencia de cultivo, más fuerte que las semillas con las que empezaste.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Nueve polvos de hueso hacen un bloque. Almacén para el motor.",
		"Cómo: nueve polvos de hueso. Huesos de esqueletos o de los Guardianes de la plataforma."
	]
	quest.4200000000030093.title: "Bloque de hueso"
	quest.4200000000030094.quest_desc: [
		"Excedente de Brote, apilado.",
		"Cómo: nueve de trigo. Tres de trigo también hacen pan."
	]
	quest.4200000000030094.title: "Silo de heno"
	quest.4200000000030095.quest_desc: [
		"Mejor tierra de cultivo. Los Atarraíces lo aprobarían.",
		"Cómo: coloca Compost orgánico y espera; madura despacio hasta ser Tierra rica."
	]
	quest.4200000000030095.title: "Tierra rica"
	quest.4200000000030096.quest_desc: [
		"Alimenta la tierra que te alimenta.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000030096.title: "Compost orgánico"
	quest.4200000000030097.quest_desc: [
		"Planta una hilera, alimenta a un caballo o cómetela cruda.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000030097.title: "Zanahoria"
	quest.4200000000030098.quest_desc: [
		"Cultivo base de patata.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000030098.title: "Patata"
	quest.4200000000030099.quest_desc: [
		"Crece deprisa y tiñe de rojo. Sopa, guiso o directo del suelo.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000030099.title: "Remolacha"
	quest.420000000003009A.quest_desc: [
		"Sandía para comida y trueques.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000003009A.title: "Sandía"
	quest.420000000003009B.quest_desc: [
		"Calabaza para comida y decoración.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000003009B.title: "Calabaza"
	quest.420000000003009C.quest_desc: [
		"Papel y azúcar.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000003009C.title: "Caña de azúcar"
	quest.420000000003009D.quest_desc: [
		"Crece sin agua y hiere a todo lo que se apoya en él.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000003009D.title: "Cactus"
	quest.420000000003009E.quest_desc: [
		"Sube deprisa y arde fuerte. Combustible útil si a la plataforma le faltan árboles.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000003009E.title: "Bambú"
	quest.420000000003009F.quest_desc: [
		"Bayas mientras construyes.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000003009F.title: "Bayas dulces"
	quest.42000000000300A0.quest_desc: [
		"Cultivado en troncos de jungla, molido en el marrón que da sabor a todo lo dulce.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000300A0.title: "Cacao"
	quest.42000000000300A1.quest_desc: [
		"Cae de las hojas de roble a su tiempo. Comida gratis, tarde o temprano.",
		"Cómo: las hojas de roble sueltan unas pocas; un manzano de Pam's (retoño de tierra con malla de hierro) da muchas."
	]
	quest.42000000000300A1.title: "Manzana"
	quest.42000000000300A2.quest_desc: [
		"Un cuenco, sin mesa de trabajo. La cena del granjero perezoso.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000300A2.title: "Estofado de champiñones"
	quest.42000000000300A3.quest_desc: [
		"Un sabor de la colmena antes de que empiece el trabajo más hondo con las abejas.",
		"Cómo: frasco de cristal sobre una colmena llena. Hoguera debajo."
	]
	quest.42000000000300A3.title: "Frasco de miel"
	quest.42000000000300A4.quest_desc: [
		"Crecen en enredaderas de cueva y alumbran el túnel mientras las comes.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000300A4.title: "Bayas luminosas"
	quest.42000000000300A5.quest_desc: [
		"La base de toda poción que merezca embotellarse. Solo crece en arena de almas.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000300A5.title: "Verruga del Nether"
	quest.42000000000300A6.quest_desc: [
		"Un campo, una cocina, esencia que sube.",
		"Tensa la Hebra: los Atarraíces responden.",
		"Reclámalo y elige un regalo de la tribu: un Hilo del Retorno para una vida compartida más, o suministros.",
		"Cómo: termina las misiones enlazadas a esta y luego reclámala para la ficha de Hebra. Asienta la ficha en tu Poste de tensión."
	]
	quest.42000000000300A6.quest_subtitle: "Raíz"
	quest.42000000000300A6.title: "Nudo de Brote"
	quest.42000000000300A7.quest_desc: [
		"Clic derecho en el Poste de tensión de tu Clowder con la ficha.",
		"La muesca se enciende, la tribu repica, la plataforma cambia.",
		"Cómo: clic derecho en tu Poste de tensión con la ficha de Hebra en la mano."
	]
	quest.42000000000300A7.title: "Asienta Brote"
	quest.42000000000300A8.quest_desc: [
		"Los Atarraíces sacan una cada uno, tarde o temprano.",
		"No te la comas. Tampoco la tires.",
		"Cómo: una cosecha rara de patata. Secreto opcional de Brote."
	]
	quest.42000000000300A8.title: "Patata equivocada"
	quest.42000000000400A9.quest_desc: [
		"Corta el vacío a tu manera. Ocho hojas de planos.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: cuatro papeles y un tinte azul, sin forma. Da cuatro hojas."
	]
	quest.42000000000400A9.title: "Papel de planos"
	quest.42000000000400AA.quest_desc: [
		"Planos en una caja.",
		"Cuatro Papel de planos, sin forma — reclamar una plataforma borra el regalo de entrada de Silent Gear. Clic derecho para desenvolver los planos iniciales.",
		"Cómo: cuatro Papel de planos, sin forma. Clic derecho para desenvolver los planos iniciales. Reclamar una plataforma borra el regalo de entrada de Silent Gear."
	]
	quest.42000000000400AA.title: "Paquete de planos"
	quest.42000000000400AB.quest_desc: [
		"La plantilla de la que parte una herramienta modular, antes de que le añadas las piezas.",
		"Cómo: desenvuelve el Paquete de planos, o JEI. Garra da nombre a la línea de herramientas."
	]
	quest.42000000000400AB.title: "Plano de vara"
	quest.42000000000400AC.quest_desc: [
		"Da forma a un pico que dura más que su metal.",
		"Cómo: desenvuelve el Paquete de planos, o JEI. Garra da nombre a la línea de herramientas."
	]
	quest.42000000000400AC.title: "Plano de pico"
	quest.42000000000400AD.quest_desc: [
		"Da forma a un hacha.",
		"Cómo: desenvuelve el Paquete de planos, o JEI. Garra da nombre a la línea de herramientas."
	]
	quest.42000000000400AD.title: "Plano de hacha"
	quest.42000000000400AE.quest_desc: [
		"Da forma a una pala.",
		"Cómo: desenvuelve el Paquete de planos, o JEI. Garra da nombre a la línea de herramientas."
	]
	quest.42000000000400AE.title: "Plano de pala"
	quest.42000000000400AF.quest_desc: [
		"Da forma a una hoja.",
		"Cómo: desenvuelve el Paquete de planos, o JEI. Garra da nombre a la línea de herramientas."
	]
	quest.42000000000400AF.title: "Plano de espada"
	quest.42000000000400B0.quest_desc: [
		"Sitio para crecer.",
		"Cómo: JEI después del Papel de planos. Garra da nombre a la línea de mejoras."
	]
	quest.42000000000400B0.title: "Base de mejora"
	quest.42000000000400B1.quest_desc: [
		"Treinta y dos lingotes de material para las piezas.",
		"Cómo: funde hierro en bruto / arenilla de hierro (horno o Horno de brasas). Criba grava para sacar trozos."
	]
	quest.42000000000400B1.title: "Masa de hierro"
	quest.42000000000400B2.quest_desc: [
		"Afila el filo más allá de lo que el hierro solo alcanza.",
		"Cómo: criba grava con una malla de hierro o mejor, o mena de diamante en la Fractura de eco."
	]
	quest.42000000000400B2.title: "Punta de diamante"
	quest.42000000000400B3.quest_desc: [
		"Hojas y lana, y panales más tarde.",
		"Cómo: dos lingotes de hierro en diagonal. Esquila ovejas y nidos de abejas."
	]
	quest.42000000000400B3.title: "Tijeras"
	quest.42000000000400B4.quest_desc: [
		"Las plataformas tienen bordes. Los monstruos también.",
		"Cómo: seis tablas alrededor del hierro. Bloqueo con la mano secundaria."
	]
	quest.42000000000400B4.title: "Escudo"
	quest.42000000000400B5.quest_desc: [
		"Sobrevive a la noche a propósito.",
		"Cómo: ocho lingotes de hierro. Funde grava de cedazo."
	]
	quest.42000000000400B5.title: "Peto de hierro"
	quest.42000000000400B6.quest_desc: [
		"Cuidado con la caída.",
		"Cómo: cinco lingotes de hierro."
	]
	quest.42000000000400B6.title: "Yelmo de hierro"
	quest.42000000000400B7.quest_desc: [
		"Cubre las piernas primero. La mayor parte del daño viene de abajo igualmente.",
		"Cómo: siete lingotes de hierro."
	]
	quest.42000000000400B7.title: "Grebas de hierro"
	quest.42000000000400B8.quest_desc: [
		"Afirma el paso en los salientes donde un resbalón es el vacío.",
		"Cómo: cuatro lingotes de hierro."
	]
	quest.42000000000400B8.title: "Botas de hierro"
	quest.42000000000400B9.quest_desc: [
		"Mantén lejos a los monstruos del vacío.",
		"Cómo: tres cuerdas y tres palos."
	]
	quest.42000000000400B9.title: "Arco"
	quest.42000000000400BA.quest_desc: [
		"Sesenta y cuatro razones para guardar distancia.",
		"Cómo: pedernal, palo, pluma. Los esqueletos sueltan de más."
	]
	quest.42000000000400BA.title: "Fajo de flechas"
	quest.42000000000400BB.quest_desc: [
		"Alumbra el paso.",
		"Cómo: lingote de hierro más pedernal."
	]
	quest.42000000000400BB.title: "Mechero"
	quest.42000000000400BC.quest_desc: [
		"Diez bloques. Una puerta que los Caminabordes reconocerían.",
		"Cómo: agua sobre una fuente de lava (o lava sobre agua). Conserva la fuente de lava."
	]
	quest.42000000000400BC.title: "Marco de obsidiana"
	quest.42000000000400BD.quest_desc: [
		"Preparación de un apoyo. Existe otro sitio.",
		"Cómo: perla de ender (puesto de los Caminabordes / endermen) más pólvora de blaze de una fortaleza del Nether, tras la obsidiana de Garra. El acopio de ocho ojos es opcional; los cristales del End usan el mismo crafteo."
	]
	quest.42000000000400BD.title: "Ojo de ender"
	quest.42000000000400BE.quest_desc: [
		"Poder blando para herramientas duras.",
		"Cómo: dos diamantes, cuatro obsidiana, libro. Los diamantes salen de la grava con malla de hierro."
	]
	quest.42000000000400BE.title: "Mesa de encantamientos"
	quest.42000000000400BF.quest_desc: [
		"Repara y pon nombre a lo que llevas.",
		"Cómo: tres bloques de hierro sobre cuatro lingotes."
	]
	quest.42000000000400BF.title: "Yunque"
	quest.42000000000400C0.quest_desc: [
		"Llámalo tuyo.",
		"Cómo: pesca / cofres raros, o el puesto de los Talladores de sellos en /clowder hub (24 Hilo). Opcional."
	]
	quest.42000000000400C0.title: "Etiqueta"
	quest.42000000000400C1.quest_desc: [
		"La plantilla inicial de una azada modular, hecha pieza a pieza.",
		"Cómo: desenvolve el Paquete de planos, o JEI."
	]
	quest.42000000000400C1.title: "Plano de azada"
	quest.42000000000400C2.quest_desc: [
		"Limpia una franja ancha de cultivos de un golpe, en vez de una planta.",
		"Cómo: desenvolve el Paquete de planos, o JEI."
	]
	quest.42000000000400C2.title: "Plano de hoz"
	quest.42000000000400C3.quest_desc: [
		"Una herramienta que mina, tala y cava. Ya no cambias lo de la mano.",
		"Cómo: desenvolve el Paquete de planos, o JEI."
	]
	quest.42000000000400C3.title: "Plano de Paxel"
	quest.42000000000400C4.quest_desc: [
		"Rompe piedra en un tres por tres de un solo golpe.",
		"Cómo: desenvolve el Paquete de planos, o JEI."
	]
	quest.42000000000400C4.title: "Plano de martillo"
	quest.42000000000400C5.quest_desc: [
		"Abre hoyos anchos en tierra y arena más rápido que cualquier pala.",
		"Cómo: desenvolve el Paquete de planos, o JEI."
	]
	quest.42000000000400C5.title: "Plano de excavador"
	quest.42000000000400C6.quest_desc: [
		"Pequeño, rápido y preciso. Hecho para el trabajo de cerca, no para la guerra.",
		"Cómo: desenvolve el Paquete de planos, o JEI."
	]
	quest.42000000000400C6.title: "Plano de cuchillo"
	quest.42000000000400C7.quest_desc: [
		"Placas blandas, fáciles de encantar, que valen más por su magia que por su defensa.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000400C7.title: "Piezas de armadura de oro"
	quest.42000000000400C8.quest_desc: [
		"Garra de mar.",
		"Opcional — el vacío puede no ofrecerte nunca uno.",
		"Cómo: solo ahogados. Opcional."
	]
	quest.42000000000400C8.title: "Tridente"
	quest.42000000000400C9.quest_desc: [
		"Carga despacio, pega fuerte y guarda la carga hasta que la necesites.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000400C9.title: "Ballesta"
	quest.42000000000400CA.quest_desc: [
		"Escudriña el vacío.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000400CA.title: "Catalejo"
	quest.42000000000400CB.quest_desc: [
		"Planos, hierro a la espalda, una puerta de salida.",
		"Tensa la Hebra: responden los Caminabordes. La trenza se abre.",
		"Reclámalo y elige un regalo de la tribu: un Hilo del Retorno para una vida compartida más, o suministros.",
		"Cómo: termina las misiones enlazadas a esta y luego reclámala para la ficha de Hebra. Asienta la ficha en tu Poste de tensión."
	]
	quest.42000000000400CB.quest_subtitle: "Borde"
	quest.42000000000400CB.title: "Nudo de Garra"
	quest.42000000000400CC.quest_desc: [
		"Clic derecho en el Poste de tensión de tu Clowder con la ficha.",
		"La muesca se enciende, la tribu repica, la plataforma cambia.",
		"Cómo: clic derecho en tu Poste de tensión con la ficha de Hebra en la mano."
	]
	quest.42000000000400CC.title: "Asienta Garra"
	quest.42000000000400CD.quest_desc: [
		"Algo alto devolvió la mirada. Los Caminabordes los llamaban celadores de puertas.",
		"Cómo: mata a un enderman. Las perlas de ender también salen del puesto de los Caminabordes."
	]
	quest.42000000000400CD.title: "Borde del Borde"
	quest.42000000000500CE.quest_desc: [
		"Una señal breve antes del Zumbido. Sesenta y cuatro de polvo.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: criba grava, o mena de redstone en la Fractura de eco tras Recuperación."
	]
	quest.42000000000500CE.title: "Polvo de redstone"
	quest.42000000000500CF.quest_desc: [
		"Calor en paralelo. Ocho es una línea, no un horno.",
		"Cómo: ocho rocas alrededor de un centro vacío."
	]
	quest.42000000000500CF.title: "Hilera de hornos"
	quest.42000000000500D0.quest_desc: [
		"Mueve la arenilla sin manos.",
		"Cómo: cinco hierros alrededor de un cofre. Ponlo bajo un Bastidor del telar o un Barril de tensión (extrae hacia ABAJO)."
	]
	quest.42000000000500D0.title: "Línea de tolvas"
	quest.42000000000500D1.quest_desc: [
		"Mide el compás.",
		"Cómo: cuarzo del Nether, antorcha de redstone, piedra. El cuarzo se criba de la arena de almas; no hace falta ir al Nether."
	]
	quest.42000000000500D1.title: "Comparador"
	quest.42000000000500D2.quest_desc: [
		"Hueso, cuerda, amatista. El primer compás.",
		"Da dos — guarda uno para el Códice de los Espíritus.",
		"Cómo: un hueso, cuerda, amatista. /clowder hub Los Guardianes de la plataforma venden huesos. Puerta de Chispa / Zumbido."
	]
	quest.42000000000500D2.title: "Zumbido: Carrillón de hueso"
	quest.42000000000500D3.quest_desc: [
		"Una esquirla de un canto tribal antiguo. Necesita un carrillón.",
		"Cómo: Carrillón de hueso, amatista y redstone, sin forma. Da dos."
	]
	quest.42000000000500D3.title: "Zumbido: Esquirla espiritual"
	quest.42000000000500D4.quest_desc: [
		"Cobre alrededor de un carrillón: metal afinado al espíritu.",
		"Cómo: cobre alrededor de un Carrillón de hueso. Da dos."
	]
	quest.42000000000500D4.title: "Zumbido: Resonador de cobre"
	quest.42000000000500D5.quest_desc: [
		"Golpéalo. Sostén un Pulso. Escucha antes de cablear nada.",
		"Dos carrillones, una esquirla, dos cueros, cuatro tablas — los Guardianes de la plataforma en /clowder hub venden cuero.",
		"Cómo: dos Carrillones de hueso, una Esquirla espiritual, dos cueros y cuatro tablas. Golpea con las manos vacías a tempo (17–23 ticks) para 24 de Pulso."
	]
	quest.42000000000500D5.title: "Zumbido: Corazón de tambor"
	quest.42000000000500D6.quest_desc: [
		"Lleva Pulso para herramientas, hechizos y viajes — necesita Resonador + Esquirla.",
		"Cómo: fabrícala y luego llénala desde un Corazón de tambor (clic con la célula). Herramientas, hechizos y viajes beben de la célula."
	]
	quest.42000000000500D6.title: "Zumbido: Célula de Pulso"
	quest.42000000000500D7.quest_desc: [
		"Atrae la ley ambiente y vuélvela compases bajo cielo abierto. Las voces de los tótems suman; no hace falta un Corazón de tambor.",
		"Cómo: colócalo bajo el cielo, cerca de agua/verde. Pulso lento. Escalera de Chispa."
	]
	quest.42000000000500D7.title: "Zumbido: Colector de ley"
	quest.42000000000500D8.quest_desc: [
		"Asienta un catalizador de eco (se desgasta mientras trabaja) y dos tótems elementales distintos. El campamento canta su propia energía; la redstone pausa la armonía.",
		"Cómo: asienta un catalizador de eco y dos tótems distintos en un radio de 8. La redstone lo pausa."
	]
	quest.42000000000500D8.title: "Zumbido: Resonador de Pulso"
	quest.42000000000500D9.quest_desc: [
		"Un búfer de Energía de Forge — el puente del Pulso al cable, si lo quieres.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500D9.title: "Célula inicial de Powah"
	quest.42000000000500DA.quest_desc: [
		"Quema combustible para Energía de Forge.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500DA.title: "Quemador Powah"
	quest.42000000000500DB.quest_desc: [
		"Haz circular la energía.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500DB.title: "Cable Powah"
	quest.42000000000500DC.quest_desc: [
		"Energía del cielo, en una plataforma que es todo cielo.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500DC.title: "Panel solar inicial"
	quest.42000000000500DD.quest_desc: [
		"Quema una diferencia de calor y la hace energía. Aliméntalo caliente por un lado y frío por el otro.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500DD.title: "Generador térmico"
	quest.42000000000500DE.quest_desc: [
		"Carga objetos en un anillo de varas.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500DE.title: "Orbe energizante"
	quest.42000000000500DF.quest_desc: [
		"Alimenta el orbe.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500DF.title: "Vara energizante"
	quest.42000000000500E0.quest_desc: [
		"Un bolsillo de energía guardada.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500E0.title: "Batería"
	quest.42000000000500E1.quest_desc: [
		"Gira las máquinas en su sitio, en vez de romperlas y volver a ponerlas.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000500E1.title: "Llave inglesa"
	quest.42000000000500E2.quest_desc: [
		"Funde mena el doble de rápido que un horno normal, solo mena.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500E2.title: "Alto horno"
	quest.42000000000500E3.quest_desc: [
		"Cocina carne el doble de rápido que una hoguera, solo comida.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500E3.title: "Ahumador"
	quest.42000000000500E4.quest_desc: [
		"Nueve carbones, prensados y densos. Un bloque dura más que una pila entera de trozos.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500E4.title: "Bloque de carbón (Chispa)"
	quest.42000000000500E5.quest_desc: [
		"Empuja un objeto cada vez hacia lo que tenga delante.",
		"Cómo: roca alrededor de redstone."
	]
	quest.42000000000500E5.title: "Soltador"
	quest.42000000000500E6.quest_desc: [
		"Empuja con propósito.",
		"Cómo: roca, arco y redstone."
	]
	quest.42000000000500E6.title: "Dispensador"
	quest.42000000000500E7.quest_desc: [
		"Empuja un bloque hacia delante al recibir una señal y luego espera a la siguiente.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500E7.title: "Pistón"
	quest.42000000000500E8.quest_desc: [
		"Empuja un bloque y lo trae de vuelta cuando cae la señal.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500E8.title: "Pistón pegajoso"
	quest.42000000000500E9.quest_desc: [
		"El observador lee el pulso.",
		"Cómo: roca, redstone y cuarzo del Nether."
	]
	quest.42000000000500E9.title: "Observador"
	quest.42000000000500EA.quest_desc: [
		"El repetidor temporiza el circuito.",
		"Cómo: antorcha de redstone, redstone, piedra. El capítulo de tubos lo usa para los relojes."
	]
	quest.42000000000500EA.title: "Repetidor"
	quest.42000000000500EB.quest_desc: [
		"Registra un impacto con una fuerza de señal según lo cerca que esté del centro.",
		"Cómo: redstone alrededor del heno. El heno son tres trigos."
	]
	quest.42000000000500EB.title: "Diana"
	quest.42000000000500EC.quest_desc: [
		"Desvía un rayo de tu tejado y descarga la carga a tierra.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500EC.title: "Pararrayos"
	quest.42000000000500ED.quest_desc: [
		"Hora de la energía.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500ED.title: "Reloj"
	quest.42000000000500EE.quest_desc: [
		"Luz sin antorchas.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500EE.title: "Bombilla de cobre"
	quest.42000000000500EF.quest_desc: [
		"Se enciende con una señal y se apaga en el momento en que esta para.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500EF.title: "Lámpara de redstone"
	quest.42000000000500F0.quest_desc: [
		"Lee el cielo y manda una señal que sube y baja con el sol.",
		"Cómo: cristal, cuarzo del Nether, losas de madera."
	]
	quest.42000000000500F0.title: "Sensor de luz solar"
	quest.42000000000500F1.quest_desc: [
		"Enciende o apaga una señal a mano. El interruptor más viejo que hay.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F1.title: "Palanca"
	quest.42000000000500F2.quest_desc: [
		"El botón da un toque de redstone.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F2.title: "Botón"
	quest.42000000000500F3.quest_desc: [
		"Manda una señal cuando algo más pesado que el aire se posa encima.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F3.title: "Placa de presión"
	quest.42000000000500F4.quest_desc: [
		"Con una cuerda tensada a través de un camino, atrapa todo lo que cruza.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F4.title: "Gancho"
	quest.42000000000500F5.quest_desc: [
		"Toca una nota por cada tipo de bloque debajo. Los Corazones de tambor oyen una canción en una fila de ellos.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F5.title: "Bloque de notas"
	quest.42000000000500F6.quest_desc: [
		"Tocadiscos para el ánimo de la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F6.title: "Tocadiscos"
	quest.42000000000500F7.quest_desc: [
		"Rueda por gravedad o por un empujón. Sin raíles, no hay viaje.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F7.title: "Vagoneta"
	quest.42000000000500F8.quest_desc: [
		"Raíles que cruzan el vano del vacío.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F8.title: "Raíl"
	quest.42000000000500F9.quest_desc: [
		"Raíl propulsor para vagonetas.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500F9.title: "Raíl propulsor"
	quest.42000000000500FA.quest_desc: [
		"Lee una vagoneta que pasa y dispara una señal cuando rueda por encima.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000500FA.title: "Raíl detector"
	quest.42000000000500FB.quest_desc: [
		"Fabricación solar de recambio.",
		"Cómo: tres cristales, tres lapislázulis y tres Espejos, una fila de cada uno."
	]
	quest.42000000000500FB.title: "Célula Solar Flux"
	quest.42000000000500FC.quest_desc: [
		"Tubos de objetos sencillos.",
		"Cómo: hierro + redstone. Ajusta las caras con la llave inglesa de Pipez."
	]
	quest.42000000000500FC.title: "Pipez de objetos"
	quest.42000000000500FD.quest_desc: [
		"Tubos de fluidos sencillos.",
		"Cómo: hierro + cubos + redstone. Uso agachado de la llave inglesa en un lado para extraer; clic derecho en ese lado para los filtros."
	]
	quest.42000000000500FD.title: "Pipez de fluidos"
	quest.42000000000500FE.quest_desc: [
		"Tubos de energía corrientes entre máquinas.",
		"Cómo: hierro + redstone. Lleva FE entre máquinas."
	]
	quest.42000000000500FE.title: "Pipez de energía"
	quest.42000000000500FF.quest_desc: [
		"Elige qué lados del tubo extraen de una máquina, o corta un lado, sin romper el tubo.",
		"Cómo: dos pedernales y dos palos. Uso agachado en un lado del tubo junto a una máquina para que extraiga, otra vez para cortarlo; clic derecho en un lado que extrae para los filtros."
	]
	quest.42000000000500FF.title: "Llave inglesa Pipez"
	quest.4200000000050100.quest_desc: [
		"Marca las líneas de la celosía — necesita una Esquirla espiritual.",
		"Cómo: dos polvos de hueso, lapislázuli y una Esquirla espiritual, sin forma. Da cuatro."
	]
	quest.4200000000050100.title: "Tiza ritual"
	quest.4200000000050101.quest_desc: [
		"Un tambor golpeado, un Pulso sostenido, un Resonador asentado.",
		"Tensa la Hebra: los Corazones de tambor responden.",
		"Reclámalo y elige un regalo de la tribu: un Hilo del Retorno para una vida compartida más, o suministros.",
		"Cómo: termina las misiones enlazadas a esta y luego reclámala para la ficha de Hebra. Asienta la ficha en tu Poste de tensión."
	]
	quest.4200000000050101.quest_subtitle: "Zumbido"
	quest.4200000000050101.title: "Nudo de Chispa"
	quest.4200000000050102.quest_desc: [
		"Clic derecho en el Poste de tensión de tu Clowder con la ficha.",
		"La muesca se enciende, la tribu repica, la plataforma cambia.",
		"Cómo: clic derecho en tu Poste de tensión con la ficha de Hebra en la mano."
	]
	quest.4200000000050102.title: "Asienta Chispa"
	quest.4200000000050103.quest_desc: [
		"Sigue el Tejido tribal por el refinado de eco hasta un Núcleo resonante. El Energizador armónico convierte la armonía del campamento en FE para las máquinas de este capítulo. La conversión sin rango es 60 de Pulso por segundo; súbele el rango en las estaciones de eco para conseguir más. No puede recibir FE. La redstone pausa tanto la conversión como la exportación.",
		"Cómo: cinco lingotes de cobre, tres de redstone y un Núcleo resonante."
	]
	quest.4200000000050103.title: "El zumbido se vuelve corriente"
	quest.4200000000050104.quest_desc: [
		"Una bruja, en tu plataforma, de noche. Los tambores no te avisaron.",
		"Cómo: mata a una bruja en la plataforma de noche."
	]
	quest.4200000000050104.title: "Lío embotellado"
	quest.4200000000060105.quest_desc: [
		"Manos que trabajan mientras duermes. Treinta y dos.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: andesita + pepita de hierro en una mesa de trabajo (o mezclador)."
	]
	quest.4200000000060105.title: "Aleación de andesita"
	quest.4200000000060106.quest_desc: [
		"La columna vertebral de la rotación.",
		"Cómo: aleación de andesita en una receta de corte / de crafteo, listada en JEI."
	]
	quest.4200000000060106.title: "Eje"
	quest.4200000000060107.quest_desc: [
		"Un engranaje. Luego el mismo engranaje otra vez.",
		"Cómo: eje + tablas."
	]
	quest.4200000000060107.title: "Engranaje"
	quest.4200000000060108.quest_desc: [
		"Más dientes, giro más lento.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.4200000000060108.title: "Engranaje grande"
	quest.4200000000060109.quest_desc: [
		"La carcasa de andesita es el marco de Create.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.4200000000060109.title: "Carcasa de andesita"
	quest.420000000006010A.quest_desc: [
		"Un río en el cielo, girando.",
		"Cómo: ocho tablas alrededor de un eje. Hace falta un flujo de agua al lado."
	]
	quest.420000000006010A.title: "Rueda de agua"
	quest.420000000006010B.quest_desc: [
		"Genera rotación a mano cuando aún no gira nada más.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.420000000006010B.title: "Manivela"
	quest.420000000006010C.quest_desc: [
		"Muele grava hasta hacerla polvo, sin martillo.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.420000000006010C.title: "Muela"
	quest.420000000006010D.quest_desc: [
		"La cubeta contiene la mezcla de Create.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.420000000006010D.title: "Cubeta"
	quest.420000000006010E.quest_desc: [
		"Placas y caminos.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.420000000006010E.title: "Prensa mecánica"
	quest.420000000006010F.quest_desc: [
		"Recetas a granel, rápido.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.420000000006010F.title: "Mezclador mecánico"
	quest.4200000000060110.quest_desc: [
		"Una superficie plana que mantiene quieto un objeto para la correa o la prensa.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.4200000000060110.title: "Depósito"
	quest.4200000000060111.quest_desc: [
		"Las correas mueven objetos a lo largo de los ejes.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.4200000000060111.title: "Conector de correa"
	quest.4200000000060112.quest_desc: [
		"Deja caer objetos recto hacia abajo entre máquinas, sin necesitar correa.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.4200000000060112.title: "Conducto"
