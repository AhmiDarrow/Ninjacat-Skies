		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D047D.title: "Bus de exportación (Red)"
	quest.42000000001D047E.quest_desc: [
		"Deja que la red lea un inventario de fuera como si fuera suyo.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D047E.title: "Bus de almacenamiento (Red)"
	quest.42000000001D047F.quest_desc: [
