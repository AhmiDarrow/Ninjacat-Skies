	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"Sobra de Enjambre, apilada.",
		"Cómo: cuatro frascos de miel. Los frascos vuelven."
	]
	quest.4200000000070155.title: "Bloque de miel"
	quest.4200000000070156.quest_desc: [
		"Una abeja que no existía antes de que construyeras el nido.",
		"Minera, albañil, cavadora, carpintera — mira a una.",
		"Cómo: mira a una Productive Bee cuando despierte un nido. Primeras alas es el nido de roble."
	]
	quest.4200000000070156.quest_subtitle: "Colonia"
	quest.4200000000070156.title: "Algo nuevo zumba"
	quest.4200000000070157.quest_desc: [
		"Arena alrededor de una flor. Mineras cenicientas y de chocolate.",
		"Cómo: anillo del material del nido alrededor de una flor pequeña. Colócalo y luego clic derecho con una flor pequeña para despertarlo; las abejas salen al cabo de un rato."
	]
	quest.4200000000070157.title: "Anillo de arena"
	quest.4200000000070158.quest_desc: [
		"Caña de azúcar alrededor de una flor. Abejas de caña y albañiles.",
		"Cómo: anillo del material del nido alrededor de una flor pequeña. Colócalo y luego clic derecho con una flor pequeña para despertarlo; las abejas salen al cabo de un rato."
	]
	quest.4200000000070158.title: "Anillo de caña"
	quest.4200000000070159.quest_desc: [
		"Bloques de slime alrededor de una flor. Adivina.",
		"Cómo: anillo del material del nido alrededor de una flor pequeña. Colócalo y luego clic derecho con una flor pequeña para despertarlo; las abejas salen al cabo de un rato."
	]
	quest.4200000000070159.title: "Anillo de slime"
	quest.420000000007015A.quest_desc: [
		"Heno alrededor de una flor. Abejorros, y abejas normales también.",
		"Cómo: anillo del material del nido alrededor de una flor pequeña. Colócalo y luego clic derecho con una flor pequeña para despertarlo; las abejas salen al cabo de un rato."
	]
	quest.420000000007015A.title: "Anillo de heno"
	quest.420000000007015B.quest_desc: [
		"Nieve alrededor de una flor. Abejas del sudor, curiosamente.",
		"Cómo: anillo del material del nido alrededor de una flor pequeña. Colócalo y luego clic derecho con una flor pequeña para despertarlo; las abejas salen al cabo de un rato."
	]
	quest.420000000007015B.title: "Anillo de nieve"
	quest.420000000007015C.quest_desc: [
		"Quema miel para dar energía. Una colmena con doble tarea.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.420000000007015C.title: "Generador de miel"
	quest.420000000007015D.quest_desc: [
		"Muestra una abeja, con alas y todo, sin una colmena pegada.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.420000000007015D.title: "Tarro"
	quest.420000000007015E.quest_desc: [
		"Calma una colmena llena de abejas antes de que escarbes en busca de panal.",
		"Cómo: troncos, palos y carbón o carbón vegetal."
	]
	quest.420000000007015E.title: "Hoguera (Enjambre)"
	quest.420000000007015F.quest_desc: [
		"Alimenta a las abejas y florece dos veces al año; el resto del tiempo, siempre verde.",
		"Cómo: musgo más roble, o polvo de hueso sobre el musgo. Las abejas aceptan la flor."
	]
	quest.420000000007015F.title: "Azalea en flor (Enjambre)"
	quest.4200000000070160.quest_desc: [
		"Alto, amarillo y siempre de cara al sol. Las abejas lo encuentran fácil.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000070160.title: "Girasol"
	quest.4200000000070161.quest_desc: [
		"Dos bloques de flor morada que las abejas cruzarán una plataforma para alcanzar.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000070161.title: "Lila"
	quest.4200000000070162.quest_desc: [
		"Una flor alta que las abejas prefieren, y un color más para el jardín.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000070162.title: "Rosal"
	quest.4200000000070163.quest_desc: [
		"Rosa y llena, plantada donde una colmena necesite más pasto cerca.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000070163.title: "Peonía"
	quest.4200000000070164.quest_desc: [
		"Una flor baja y sola, pero a las abejas no les importa la altura.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000070164.title: "Tulipán naranja"
	quest.4200000000070165.quest_desc: [
		"Un nido que construiste, una colmena que moviste, una centrífuga, una incubadora, campos de esencia.",
		"Da tensión a la Hebra: responden los Guardianes de la colonia.",
		"Reclámalo y elige un regalo de la tribu: un Hilo del Retorno para una vida compartida más, o suministros.",
		"Cómo: termina las misiones enlazadas a esta y luego reclámala para la ficha de Hebra. Asienta la ficha en tu Poste de tensión."
	]
	quest.4200000000070165.quest_subtitle: "Colonia"
	quest.4200000000070165.title: "Nudo del Enjambre"
	quest.4200000000070166.quest_desc: [
		"Clic derecho en el Poste de tensión de tu Clowder con la ficha.",
		"La muesca se enciende, la tribu repica, la plataforma cambia.",
		"Cómo: clic derecho en tu Poste de tensión con la ficha de Hebra en la mano."
	]
	quest.4200000000070166.title: "Asienta Enjambre"
	quest.4200000000070167.quest_desc: [
		"Mataste una abeja.",
		"Los Guardianes de la colonia quieren hablar. Aquí tienes un frasco; piénsalo.",
		"Cómo: mata una abeja (oculto). El frasco es la lección."
	]
	quest.4200000000070167.title: "Arrepentimiento"
	quest.4200000000080168.quest_desc: [
		"Los custodios dejaron trucos en el cristal. Treinta y dos esquirlas.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: criba, o amatista en ciernes si cultivas una hilera de geodas. Occultism quiere esquirlas."
	]
	quest.4200000000080168.title: "Amatista"
	quest.4200000000080169.quest_desc: [
		"Clic derecho en el Poste de tensión con 16 Filamentos de Hebra en la mano. No hace falta asentar ninguna Hebra.",
		"Atar empieza aquí.",
		"Cómo: clic derecho en el Poste de tensión con 16 Filamentos de Hebra en la mano. Tamiza grava o arena con una malla de Hilo de hierro para encontrarlos."
	]
	quest.4200000000080169.title: "Cordón de trenza"
	quest.420000000008016A.quest_desc: [
		"Escribe el rito antes de tallarlo.",
		"Cómo: libro, saco de tinta, pluma. Carbón vegetal más un frasco de cristal hacen la tinta."
	]
	quest.420000000008016A.title: "Libro y pluma"
	quest.420000000008016B.quest_desc: [
		"Poder blando para herramientas duras.",
		"Cómo: dos diamantes, cuatro obsidiana, libro. Los diamantes salen de la grava con malla de hierro."
	]
	quest.420000000008016B.title: "Mesa de encantamientos (Sello)"
	quest.420000000008016C.quest_desc: [
		"Alimenta la mesa.",
		"Cómo: nueve lapislázuli. Criba grava o mena de lapislázuli en la Fractura de eco."
	]
	quest.420000000008016C.title: "Bloque de lapislázuli"
	quest.420000000008016D.quest_desc: [
		"Rodea una mesa de encantamientos para abrir sus encantamientos más fuertes.",
		"Cómo: seis tablas y tres libros. Los libros son papel más cuero."
	]
	quest.420000000008016D.title: "Librería"
	quest.420000000008016E.quest_desc: [
		"Cura a fondo y da un brillo que se apaga al cabo de un minuto.",
		"Cómo: ocho de oro alrededor de una manzana. No la encantada."
	]
	quest.420000000008016E.title: "Manzana dorada"
	quest.420000000008016F.quest_desc: [
		"Sáltate la caída.",
		"Cómo: endermen, o el puesto de los Caminabordes en /clowder hub."
	]
	quest.420000000008016F.title: "Perla de ender"
	quest.4200000000080170.quest_desc: [
		"Convierte frascos de agua en algo con un efecto de verdad.",
		"Cómo: vara de blaze sobre tres rocas. La vara sale de una fortaleza del Nether, tras la obsidiana de Garra."
	]
	quest.4200000000080170.title: "Soporte para pociones"
	quest.4200000000080171.quest_desc: [
		"Calor para las pociones.",
		"Cómo: fabrícalo con una vara de blaze, o en una fortaleza tras la obsidiana de Garra."
	]
	quest.4200000000080171.title: "Polvo de blaze"
	quest.4200000000080172.quest_desc: [
		"Alimenta el soporte para pociones y demuestra que ya te has enfrentado al Nether.",
		"Cómo: fortaleza del Nether tras la obsidiana de Garra. Las pociones quieren una vara; Ars y Occultism no la esperan."
	]
	quest.4200000000080172.title: "Vara de blaze"
	quest.4200000000080173.quest_desc: [
		"Tuerce el efecto de una poción hacia algo peor, a propósito.",
		"Cómo: ojo de araña, champiñón marrón, azúcar."
	]
	quest.4200000000080173.title: "Ojo fermentado"
	quest.4200000000080174.quest_desc: [
		"Polvo de piedra luminosa para recetas.",
		"Cómo: criba arena de almas, o brujas en la plataforma."
	]
	quest.4200000000080174.title: "Polvo de piedra luminosa (Sello)"
	quest.4200000000080175.quest_desc: [
		"Aliento de lo que guarda el End.",
		"Cómo: frasco de cristal sobre el dragón. La isla del End ya no está. Opcional."
	]
	quest.4200000000080175.title: "Aliento de dragón"
	quest.4200000000080176.quest_desc: [
		"Una oportunidad más.",
		"Opcional — ninguna incursión llega a la plataforma, y el pack no fabrica uno.",
		"Cómo: solo recompensas de misiones. Asienta Reloj y Asienta Sello dan uno cada uno, y los regalos de los Nudos de Hebra tardíos ofrecen más. Las incursiones y los invocadores nunca llegan a la plataforma. Opcional."
	]
	quest.4200000000080176.title: "Tótem"
	quest.4200000000080177.quest_desc: [
		"Guarda la Fuente, el combustible que los hechizos queman.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.4200000000080177.title: "Gema de fuente"
	quest.4200000000080178.quest_desc: [
		"Cultivada, no encontrada. Madera para herramientas de conjuro y pedestales de hechizos.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.4200000000080178.title: "Madera arcana"
	quest.4200000000080179.quest_desc: [
		"Primeros hechizos. Magia de igual a igual, si la quieres junto a los ritos.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.4200000000080179.title: "Libro de hechizos de novato"
	quest.420000000008017A.quest_desc: [
		"Un cultivo arcano, criado tanto por su tela como por su magia.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008017A.title: "Flor de mago"
	quest.420000000008017B.quest_desc: [
		"Brasero para el trabajo ritual.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008017B.title: "Brasero ritual"
	quest.420000000008017C.quest_desc: [
		"Muestra un reactivo y lo pasa al ritual que lo necesite.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008017C.title: "Pedestal arcano"
	quest.420000000008017D.quest_desc: [
		"Escribe hechizos y páginas.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008017D.title: "Mesa de escribas"
	quest.420000000008017E.quest_desc: [
		"Imbuye los reactivos con fuente.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008017E.title: "Cámara de imbuición"
	quest.420000000008017F.quest_desc: [
		"Guarda Fuente de más, para que un hechizo no se seque a mitad de conjuro.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008017F.title: "Tarro de fuente"
	quest.4200000000080180.quest_desc: [
		"Llama a los espíritus por sus nombres.",
		"Cómo: un libro y Semillas de sueño de demonio, sin forma. Léelo; el Fuego espiritual es lo siguiente."
	]
	quest.4200000000080180.title: "Diccionario de Occultism"
	quest.4200000000080181.quest_desc: [
		"Una llama fría para rituales que el fuego normal no termina.",
		"Cómo: enciende el Fuego espiritual como muestra el Diccionario de los espíritus (¡Arde!), luego deja caer andesita dentro."
	]
	quest.4200000000080181.title: "Fuego espiritual"
	quest.4200000000080182.quest_desc: [
		"Un foco para invocar. Los ritos son pacientes.",
		"Cómo: oro alrededor de un cuenco de sacrificio. El diccionario nombra el ritual."
	]
	quest.4200000000080182.title: "Cuenco de sacrificio dorado"
	quest.4200000000080183.quest_desc: [
		"El corazón del crafteo basado en el aura, afinado a la tierra de alrededor.",
		"Cómo: Ritual del bosque (JEI): tres piedras, una Hoja de oro, un lingote de oro y una Ficha de la alegría. Línea del Corazón del aura."
	]
	quest.4200000000080183.title: "Altar natural"
	quest.4200000000080184.quest_desc: [
		"Una planta imbuida por un aura alta, hilada en algo más raro.",
		"Cómo: cuatro hojas y cuatro pepitas de oro alrededor de hierba corta dan cuatro Fibras brillantes. Ponla en la copa de un árbol; sus hojas se vuelven doradas con el tiempo."
	]
	quest.4200000000080184.title: "Fibra brillante"
	quest.4200000000080185.quest_desc: [
		"Material tocado por el aura, más valioso de lo que parece tirado en el suelo.",
		"Cómo: rompe las hojas doradas crecidas de la Fibra brillante."
	]
	quest.4200000000080185.title: "Hoja de oro"
	quest.4200000000080186.quest_desc: [
		"Hierro que ha absorbido el aura ambiente hasta valer más que la mena.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000080186.title: "Hierro imbuido"
	quest.4200000000080187.quest_desc: [
		"Te deja ver el nivel de aura de la tierra a tu alrededor.",
		"Cómo: Hoja de oro + ojo de araña. Muestra el aura local."
	]
	quest.4200000000080187.title: "Ojo"
	quest.4200000000080188.quest_desc: [
		"Una ficha de alegría. El Altar natural y el Absorbedor herbívoro se construyen sobre una.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000080188.title: "Ficha de la alegría"
	quest.4200000000080189.quest_desc: [
		"Reserva de pergamino de hechizos.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.4200000000080189.title: "Pergamino de hechizo"
	quest.420000000008018A.quest_desc: [
		"Marca un sitio al que volver con una palabra, no con un paseo.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008018A.title: "Pergamino de transposición"
	quest.420000000008018B.quest_desc: [
		"Plántala, cuídala y cosecha tela empapada de magia baja.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008018B.title: "Cultivo de flor de mago"
	quest.420000000008018C.quest_desc: [
		"La página en blanco sobre la que se escribe un hechizo.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.420000000008018C.title: "Glifo en blanco"
	quest.420000000008018D.quest_desc: [
		"Lanza hechizos de combate sin tocar jamás una varita.",
		"Cómo: tres cadenas, cuatro cueros y dos papeles. El capítulo de hechizos nombra la tinta."
	]
	quest.420000000008018D.title: "Libro de hechizos de Iron"
	quest.420000000008018E.quest_desc: [
		"El combustible que los lanzadores queman, hechizo tras hechizo.",
		"Cómo: mata a lanzadores o craftea lo listado en JEI. Combustible para tinta y libros."
	]
	quest.420000000008018E.title: "Esencia arcana"
	quest.420000000008018F.quest_desc: [
		"Inscribe un hechizo en un libro, un nivel cada vez.",
		"Cómo: botella + esencia + tinte. La primera tinta de inscripción."
	]
	quest.420000000008018F.title: "Tinta común"
	quest.4200000000080190.quest_desc: [
		"Color para los ritos.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000080190.title: "Flor mística"
	quest.4200000000080191.quest_desc: [
		"Eco de la oscuridad profunda.",
		"Opcional — el vacío puede no ofrecerte nunca uno.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000080191.title: "Esquirla de eco"
	quest.4200000000080192.quest_desc: [
		"Una trenza hilada, pociones embotelladas, hechizos y espíritus llamados.",
		"Pon tensión a la Hebra: responden los Talladores de sellos.",
		"Reclámalo y elige un regalo de la tribu: un Hilo del Retorno para una vida compartida más, o suministros.",
		"Cómo: termina las misiones enlazadas a esta y luego reclámala para la ficha de Hebra. Asienta la ficha en tu Poste de tensión."
	]
	quest.4200000000080192.quest_subtitle: "Atar"
	quest.4200000000080192.title: "Nudo de Sello"
	quest.4200000000080193.quest_desc: [
		"Clic derecho en el Poste de tensión de tu Clowder con la ficha.",
		"La muesca se enciende, la tribu repica, la plataforma cambia.",
		"Recompensa rara: una vida compartida de Clowder, una sola vez para todo el equipo. Solo hay seis recompensas así en la campaña.",
		"Cómo: clic derecho en tu Poste de tensión con la ficha de Hebra en la mano."
	]
	quest.4200000000080193.title: "Asienta el Sello"
	quest.4200000000080194.quest_desc: [
		"Una manzana que los custodios nunca comieron. Tú tampoco deberías, probablemente.",
		"Cómo: no es un crafteo de la plataforma. Secreto opcional — no es requisito del Nudo de Sello."
	]
	quest.4200000000080194.title: "Oro viejo"
	quest.4200000000090195.quest_desc: [
		"Una malla de hierro, grava o arena, paciencia.",
		"El Filamento de Hebra es el hilo propio del Telar. La trenza se hila a partir de él.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: malla de Hilo (hierro) sobre grava, arena o polvo (Bastidor del telar o cedazo)."
	]
	quest.4200000000090195.title: "Hila el Filamento"
	quest.4200000000090196.quest_desc: [
		"Dieciséis Filamentos, un clic derecho en el Poste de tensión.",
		"El atado ha empezado; retramar empieza aquí.",
		"Cómo: clic derecho en el Poste de tensión con 16 Filamentos de Hebra en la mano. Tamiza grava o arena con una malla de Hilo de hierro para encontrarlos."
	]
	quest.4200000000090196.title: "Empalma una trenza"
	quest.4200000000090197.quest_desc: [
		"Cuarzo Certus — el hilo frío de un telar digital.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.4200000000090197.title: "Trama fría"
	quest.4200000000090198.quest_desc: [
		"Cuarzo molido, el material de base del que se construye el telar digital.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.4200000000090198.title: "Polvo de Certus"
	quest.4200000000090199.quest_desc: [
		"El bloque carcasa de cada máquina de la red, extraído de los yacimientos de Certus.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.4200000000090199.title: "Piedra celeste"
	quest.420000000009019A.quest_desc: [
		"Fluix — certus, cuarzo y redstone cargados en agua.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.420000000009019A.title: "Urdimbre cargada"
	quest.420000000009019B.quest_desc: [
		"Una mezcla de cuarzo, redstone y vidrio, molida fina para fabricar en la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.420000000009019B.title: "Polvo de Fluix"
	quest.420000000009019C.quest_desc: [
		"Silicio para los procesadores de AE2.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.420000000009019C.title: "Silicio"
	quest.420000000009019D.quest_desc: [
		"El inscriptor prensa los circuitos como el Telar prensa la tela.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.420000000009019D.title: "Prensa el patrón"
	quest.420000000009019E.quest_desc: [
		"Estampa una placa de silicio como el Telar prensa la tela.",
		"Cómo: bloque de hierro, Nudo vinculante, hierro y cuarzo. AE2 solo duplica una prensa que ya tengas."
	]
	quest.420000000009019E.title: "Prensa de silicio del inscriptor"
	quest.420000000009019F.quest_desc: [
		"Estampa la matriz de un procesador lógico, un golpe cada vez.",
		"Cómo: bloque de hierro, Nudo vinculante, hierro y oro. La primera copia es la receta del Nudo."
	]
	quest.420000000009019F.title: "Prensa lógica"
	quest.42000000000901A0.quest_desc: [
		"Estampa la matriz de un procesador de cálculo.",
		"Cómo: bloque de hierro, Nudo vinculante, hierro y certus (cedazo, arena). La primera copia es la receta del Nudo."
	]
	quest.42000000000901A0.title: "Prensa de cálculo"
	quest.42000000000901A1.quest_desc: [
		"Fabricación de la matriz de ingeniería.",
		"Cómo: bloque de hierro, Nudo vinculante, hierro y diamante. La primera copia es la receta del Nudo."
	]
	quest.42000000000901A1.title: "Prensa de ingeniería"
	quest.42000000000901A2.quest_desc: [
		"Procesador lógico para AE2.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901A2.title: "Procesador lógico"
	quest.42000000000901A3.quest_desc: [
		"Un componente de los patrones de autofabricación, hecho de silicio y cuarzo certus.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901A3.title: "Procesador de cálculo"
	quest.42000000000901A4.quest_desc: [
		"Un procesador más denso, necesario para las partes más exigentes de la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901A4.title: "Procesador de ingeniería"
	quest.42000000000901A5.quest_desc: [
		"Aloja las células que guardan todo lo que la red recuerda.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901A5.title: "Unidad ME"
	quest.42000000000901A6.quest_desc: [
		"La carcasa en la que se construye una célula de almacenamiento.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901A6.title: "Carcasa de célula de objetos"
	quest.42000000000901A7.quest_desc: [
		"El primer cofre digital.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901A7.title: "Célula de objetos de 1k"
	quest.42000000000901A8.quest_desc: [
		"Ve la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901A8.title: "Terminal ME"
	quest.42000000000901A9.quest_desc: [
		"Te deja fabricar directamente con lo que la red ya guarda.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901A9.title: "Terminal de fabricación"
	quest.42000000000901AA.quest_desc: [
		"El controlador. Quiere un Nudo vinculante en su centro.",
		"Núcleo de Huso.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901AA.title: "Telar digital"
	quest.42000000000901AB.quest_desc: [
		"Úsalo con las manos vacías y toca el Rito de la puerta: acierta los golpes que caen en A, S, D, F. Logra un 60% y se abre; no hace falta Pulso.",
		"Cómo: usa el Tambor de puerta con las manos vacías y toca el Rito de la puerta: acierta los golpes que caen en A, S, D, F. Logra un 60% y se abre; no hace falta Pulso. Vincula primero una brújula de regreso."
	]
	quest.42000000000901AB.title: "Tambor de puerta"
	quest.42000000000901AC.quest_desc: [
		"Un apoyo de más allá de la puerta. Trae uno a casa.",
		"Cómo: funde la Roca de la Marca. Pícala en la Marca, a través de un Tambor de puerta."
	]
	quest.42000000000901AC.title: "Piedra de la Marca"
	quest.42000000000901AD.quest_desc: [
		"Lleva los canales de la red de una máquina a la siguiente.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901AD.title: "Cable de Fluix"
	quest.42000000000901AE.quest_desc: [
		"Mete objetos en el almacén.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901AE.title: "Bus de importación"
	quest.42000000000901AF.quest_desc: [
		"Empuja objetos de la red a un cofre o una máquina.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901AF.title: "Bus de exportación"
	quest.42000000000901B0.quest_desc: [
		"Lee un inventario de fuera y lo mete en la red como si fuera una célula.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B0.title: "Bus de almacenamiento"
	quest.42000000000901B1.quest_desc: [
		"Añade capacidad de fabricación en masa a la fabricación automática de la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B1.title: "Unidad de fabricación"
	quest.42000000000901B2.quest_desc: [
		"Hace que más trabajos de fabricación corran a la vez.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B2.title: "Unidad de coprocesado de fabricación"
	quest.42000000000901B3.quest_desc: [
		"Guarda patrones de los que tira la red mientras fabrica.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B3.title: "Almacén de fabricación de 1k"
	quest.42000000000901B4.quest_desc: [
		"Alimenta de patrones a las máquinas, igual que un telar alimenta de hilo a la lanzadera.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B4.title: "Proveedor de patrones"
	quest.42000000000901B5.quest_desc: [
		"Construye a partir de patrones. Quiere un Cordón de trenza en el corazón.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B5.title: "Ensamblador molecular"
	quest.42000000000901B6.quest_desc: [
		"Un patrón vacío, a la espera de que le grabes una receta.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B6.title: "Patrón en blanco"
	quest.42000000000901B7.quest_desc: [
		"Alimenta de energía el telar digital.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B7.title: "Aceptor de energía"
	quest.42000000000901B8.quest_desc: [
		"Quema para AE — rama opcional de energía.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B8.title: "Cámara de vibración"
	quest.42000000000901B9.quest_desc: [
		"Una célula de almacenamiento con más sitio que el tamaño anterior.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901B9.title: "Célula de objetos 4k"
	quest.42000000000901BA.quest_desc: [
		"Cabe mucho más que cualquier cofre, la célula más densa antes de que la unidad se llene.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901BA.title: "Célula de objetos 16k"
	quest.42000000000901BB.quest_desc: [
		"La carcasa dentro de la que se monta una célula de fluidos.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901BB.title: "Carcasa de célula de fluidos"
	quest.42000000000901BC.quest_desc: [
		"Un depósito digital, que guarda líquido que la red puede sacar desde cualquier sitio.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901BC.title: "Célula de fluidos 1k"
	quest.42000000000901BD.quest_desc: [
		"Coloca bloques de la red como lo haría una mano, sin tenerla.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901BD.title: "Plano de formación"
	quest.42000000000901BE.quest_desc: [
		"Rompe los bloques de delante y los mete en la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901BE.title: "Plano de aniquilación"
	quest.42000000000901BF.quest_desc: [
		"Redstone de la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901BF.title: "Emisor de nivel"
	quest.42000000000901C0.quest_desc: [
		"Conecta la red con el mundo, e intercambia objetos al otro lado del borde.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901C0.title: "Interfaz"
	quest.42000000000901C1.quest_desc: [
		"Une dos redes a una distancia que el cable normal no alcanza.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901C1.title: "Anillo cuántico"
	quest.42000000000901C2.quest_desc: [
		"La otra mitad emparejada de un anillo cuántico, que ata dos redes.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901C2.title: "Enlace cuántico"
	quest.42000000000901C3.quest_desc: [
		"Alcanza la red desde cualquier sitio dentro del alcance, sin cable bajo los pies.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901C3.title: "Terminal inalámbrico"
	quest.42000000000901C4.quest_desc: [
		"Copia los ajustes de una máquina a otra sin volver a teclearlos.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901C4.title: "Tarjeta de memoria"
	quest.42000000000901C5.quest_desc: [
		"Herramienta de red para AE2.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901C5.title: "Herramienta de red"
	quest.42000000000901C6.quest_desc: [
		"Carga el cuarzo certus hasta dejarlo listo para un trabajo más fino.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901C6.title: "Cargador"
	quest.42000000000901C7.quest_desc: [
		"Acelera una yema de cristal en crecimiento hasta un racimo de tamaño completo.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000000901C7.title: "Acelerador de crecimiento de cristales"
	quest.42000000000901C8.quest_desc: [
		"Prueba del dosel de la Marca — recuerdo opcional de retramar.",
		"Cómo: crece silvestre en la Marca, reposa en cofres de la presa de juncos, y un Anciano de los Atarraíces lo comercia."
	]
	quest.42000000000901C8.title: "Junco espiritual"
	quest.42000000000901C9.quest_desc: [
		"Una trenza, un telar digital, una puerta, una piedra de la Marca.",
		"Tensa la novena Hebra. Luego el Fragmento, luego el Poste.",
		"Reclámalo y elige un regalo de la tribu: un Hilo del Retorno para una vida compartida más, o suministros.",
		"Cómo: termina las misiones enlazadas a esta y luego reclámala para la ficha de Hebra. Asienta la ficha en tu Poste de tensión."
	]
	quest.42000000000901C9.quest_subtitle: "Retramar"
	quest.42000000000901C9.title: "Nudo de Huso"
	quest.42000000000901CA.quest_desc: [
		"Clic derecho en el Poste de tensión de tu Clowder con la ficha.",
		"La muesca se enciende, la tribu repica, la plataforma cambia.",
		"Cómo: clic derecho en tu Poste de tensión con la ficha de Hebra en la mano."
	]
	quest.42000000000901CA.title: "Asienta Huso"
	quest.42000000000901CB.quest_desc: [
		"Nueve asentadas, una piedra de la Marca, un clic derecho en el Poste: el Fragmento.",
		"Asiéntalo. El corte se cierra sobre tu plataforma.",
		"Cómo: nueve fichas asentadas y luego haz clic derecho en el Poste con la Piedra de la Marca."
	]
	quest.42000000000901CB.quest_subtitle: "Retramar"
	quest.42000000000901CB.title: "Fragmento del telar"
	quest.42000000000901CC.quest_desc: [
		"Asienta el Fragmento en el Poste de tensión.",
		"Nueve tribus, un hilo. Ve a ver qué guardó la Marca para ti.",
		"Recompensa rara: una vida compartida de Clowder, una sola vez para todo el equipo. Solo hay seis recompensas así en la campaña.",
		"Cómo: asienta el Fragmento del telar de Huso en el Poste de tensión. El progreso se activa cuando el cielo se cierra."
	]
	quest.42000000000901CC.quest_subtitle: "El corte, cerrado"
	quest.42000000000901CC.title: "Retramar"
	quest.42000000000901CD.quest_desc: [
		"Un Wither, en una plataforma, en el cielo. Los Pespunteadores del telar se habrían quedado impresionados y luego furiosos.",
		"Cómo: Wither (tres calaveras sobre arena de almas), o el puesto de los Corazones de tambor en /clowder hub una vez, por 12 Rollos de Hilo (972 de Hilo). Trofeo opcional — no bloquea el End ni la Granja de monstruos al 100%."
	]
	quest.42000000000901CD.title: "Una estrella, de algún modo"
	quest.42000000000A01CE.quest_desc: [
		"Las hojas sueltan más retoños.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01CE.title: "Bases del cayado"
	quest.42000000000A01CF.quest_desc: [
		"Criba más rápido que el cayado de madera, y dura mucho más.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01CF.title: "Cayado de hueso"
	quest.42000000000A01D0.quest_desc: [
		"La malla más sencilla. Todo lo que cribas empieza pasando por aquí.",
		"Cómo: nueve cuerdas en un 3x3. El puesto de los Cantores de grava vende la malla de Hilo (cuerda) del Telar del vacío, que criba igual."
	]
	quest.42000000000A01D0.title: "Malla de cuerda"
	quest.42000000000A01D1.quest_desc: [
		"Atrapa esquirlas más finas que la cuerda. Se cuelan menos restos por el tejido.",
		"Cómo: cuatro pedernales y cinco cuerdas en damero. El pedernal sale de la grava, o de Hilo + grava."
	]
	quest.42000000000A01D1.title: "Malla de pedernal (cedazo)"
	quest.42000000000A01D2.quest_desc: [
		"Los hilos de hierro atrapan arenilla más pesada y sacan restos más raros del montón.",
		"Cómo: cuatro lingotes de hierro y cinco cuerdas en damero. Ningún puesto lo vende."
	]
	quest.42000000000A01D2.title: "Malla de hierro (cedazo)"
	quest.42000000000A01D3.quest_desc: [
		"Malla de nivel de oro. Las probabilidades se inclinan hacia las menas que importan.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01D3.title: "Malla de oro"
	quest.42000000000A01D4.quest_desc: [
		"Criba grava con esto y los diamantes salen mucho más a menudo.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01D4.title: "Malla de diamante"
	quest.42000000000A01D5.quest_desc: [
		"La malla más fina que hay. Nada criba mejor que el hilo de netherita.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01D5.title: "Malla de netherita"
	quest.42000000000A01D6.quest_desc: [
		"Arcilla refinada y lisa, lista para cocerse en un crisol que aguanta calor de verdad.",
		"Cómo: bola de arcilla + polvo de hueso, sin forma. La arcilla sale del Barril de tensión."
	]
	quest.42000000000A01D6.title: "Arcilla de porcelana (cedazo)"
	quest.42000000000A01D7.quest_desc: [
		"Arcilla de porcelana con forma de crisol. Cuécelo en un horno.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01D7.title: "Crisol sin cocer"
	quest.42000000000A01D8.quest_desc: [
		"Aguanta el calor del fundido sin rajarse. Funde lo que sacó el cedazo.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01D8.title: "Crisol de porcelana"
	quest.42000000000A01D9.quest_desc: [
		"Salpica agua sobre los cultivos sin pisotear los surcos.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01D9.title: "Regadera de madera"
	quest.42000000000A01DA.quest_desc: [
		"Un chorro más ancho y un depósito más hondo. Riegas más de la plataforma en cada viaje.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01DA.title: "Regadera de hierro"
	quest.42000000000A01DB.quest_desc: [
		"Suéltalo sobre las hojas y hila seda mientras come.",
		"Cómo: rompe hojas con un cayado; los gusanos de seda caen de vez en cuando."
	]
	quest.42000000000A01DB.title: "Gusano de seda"
	quest.42000000000A01DC.quest_desc: [
		"Agua extraña que inclina los retoños y las semillas hacia cultivos más raros.",
		"Cómo: un barril con agua sobre micelio se vuelve agua de bruja; llena un cubo desde él. Las esporas de micelio se criban de la tierra."
	]
	quest.42000000000A01DC.title: "Cubo de agua de bruja"
	quest.42000000000A01DD.quest_desc: [
		"Espárcelas y el micelio se arrastra hacia fuera, bloque a paciente bloque.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01DD.title: "Esporas de micelio"
	quest.42000000000A01DE.quest_desc: [
		"Tíralas sobre tierra y el césped se extiende sin esperar a la lluvia.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01DE.title: "Semillas de césped"
	quest.42000000000A01DF.quest_desc: [
		"Arenilla que sustituye a la roca. Devuélvela al martillo para sacar más.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01DF.title: "Guijarro de piedra"
	quest.42000000000A01E0.quest_desc: [
		"Nueve rocas apretadas en piedra de almacén, para una plataforma que crece.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01E0.title: "Roca comprimida"
	quest.42000000000A01E1.quest_desc: [
		"Rompe la roca en grava más rápido que cualquier martillo anterior.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01E1.title: "Martillo de netherita"
	quest.42000000000A01E2.quest_desc: [
		"Piedra del Nether, bien triturada. El basalto y la piedra negra empiezan aquí los dos.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01E2.title: "Guijarro de piedra negra"
	quest.42000000000A01E3.quest_desc: [
		"Pizarra profunda triturada hasta arenilla, lista otra vez para el cedazo.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01E3.title: "Guijarro de pizarra profunda"
	quest.42000000000A01E4.quest_desc: [
		"Piedra pálida sacada de un cribado hondo, sobre todo buena para construir.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01E4.title: "Calcita"
	quest.42000000000A01E5.quest_desc: [
		"Piedra gris de las profundidades, sencilla y fácil de tallar.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000000A01E5.title: "Toba"
	quest.42000000000A01E6.quest_desc: [
		"Crece despacio bajo tierra; apílalo y deja que vuelva a gotear en estalactitas.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000A01E6.title: "Espeleotema"
	quest.42000000000A01E7.quest_desc: [
		"Absorbe el agua estancada deprisa, útil tras una granja inundada.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000A01E7.title: "Esponja"
	quest.42000000000B01E8.quest_desc: [
		"Enlaza el almacenamiento de alrededor en una sola red en la que buscar.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: un barril de madera o un cofre, dos comparadores, tablas y piedra. Enlaza los barriles Sophisticated cercanos."
	]
	quest.42000000000B01E8.title: "Controlador de almacén"
	quest.42000000000B01E9.quest_desc: [
		"Un barril que admite mejoras: filtros, tolvas, imanes y vacío.",
		"Cómo: mejora un barril con cobre. JEI nombra el crafteo."
	]
	quest.42000000000B01E9.title: "Barril de cobre"
	quest.42000000000B01EA.quest_desc: [
		"Más ranuras, más filas de mejoras.",
		"Cómo: barriles y mejoras en JEI. El controlador enlaza una pared de barriles."
	]
	quest.42000000000B01EA.title: "Barril de hierro"
	quest.42000000000B01EB.quest_desc: [
		"Atrae los objetos caídos directo al barril desde el otro lado de la plataforma.",
		"Cómo: barriles y mejoras en JEI. El controlador enlaza una pared de barriles."
	]
	quest.42000000000B01EB.title: "Mejora de imán avanzada"
	quest.42000000000B01EC.quest_desc: [
		"Entra por un lado y sale por el otro, sin bloque de tolva.",
		"Cómo: barriles y mejoras en JEI. El controlador enlaza una pared de barriles."
	]
	quest.42000000000B01EC.title: "Mejora de tolva"
	quest.42000000000B01ED.quest_desc: [
		"Borra todo lo que pase de la capacidad, para que el cajón nunca se atasque.",
		"Cómo: barriles y mejoras en JEI. El controlador enlaza una pared de barriles."
	]
	quest.42000000000B01ED.title: "Mejora de vacío"
	quest.42000000000B01EE.quest_desc: [
		"Atrae lo que cae cerca directo al almacén en el que va montada.",
		"Cómo: barriles y mejoras en JEI. El controlador enlaza una pared de barriles."
	]
	quest.42000000000B01EE.title: "Mejora de recogida"
	quest.42000000000B01EF.quest_desc: [
		"Una ranura, ordenada y a la vista. La forma más simple de guardar objetos a granel.",
		"Cómo: troncos de roble + cofre. El primer cajón."
	]
	quest.42000000000B01EF.title: "Cajón de roble 1x1"
	quest.42000000000B01F0.quest_desc: [
		"Dos ranuras una junto a la otra, para separar objetos parecidos.",
		"Cómo: cajones de roble 1x1 / 1x2 / 2x2, luego el cajón compactador y el controlador. JEI nombra el crafteo."
	]
	quest.42000000000B01F0.title: "Cajón de roble 1x2"
	quest.42000000000B01F1.quest_desc: [
		"Cuatro ranuras en un marco. Almacén denso en poco sitio.",
		"Cómo: cajones de roble 1x1 / 1x2 / 2x2, luego el cajón compactador y el controlador. JEI nombra el crafteo."
	]
	quest.42000000000B01F1.title: "Cajón de roble 2x2"
	quest.42000000000B01F2.quest_desc: [
		"Compacta solo lo que guarda, en bloques, a medida que se llena.",
		"Cómo: cajones de roble 1x1 / 1x2 / 2x2, luego el cajón compactador y el controlador. JEI nombra el crafteo."
	]
	quest.42000000000B01F2.title: "Cajón compactador"
	quest.42000000000B01F3.quest_desc: [
		"Enlaza el almacenamiento de alrededor en una sola red en la que buscar.",
		"Cómo: cajones de roble 1x1 / 1x2 / 2x2, luego el cajón compactador y el controlador. JEI nombra el crafteo."
	]
	quest.42000000000B01F3.title: "Controlador de almacén (Almacén)"
	quest.42000000000B01F4.quest_desc: [
		"Atrae los objetos cercanos directo al cajón.",
		"Cómo: cajones de roble 1x1 / 1x2 / 2x2, luego el cajón compactador y el controlador. JEI nombra el crafteo."
	]
	quest.42000000000B01F4.title: "Mejora recolectora"
	quest.42000000000B01F5.quest_desc: [
		"Saca objetos del cofre o de la máquina puesta a su lado.",
		"Cómo: cajones de roble 1x1 / 1x2 / 2x2, luego el cajón compactador y el controlador. JEI nombra el crafteo."
	]
	quest.42000000000B01F5.title: "Mejora extractora"
	quest.42000000000B01F6.quest_desc: [
		"Empuja lo guardado al inventario que tenga al lado.",
		"Cómo: cajones de roble 1x1 / 1x2 / 2x2, luego el cajón compactador y el controlador. JEI nombra el crafteo."
	]
	quest.42000000000B01F6.title: "Mejora impulsora"
	quest.42000000000B01F7.quest_desc: [
		"Borra todo lo que pase de la capacidad, para que el cajón nunca se atasque.",
		"Cómo: cajones de roble 1x1 / 1x2 / 2x2, luego el cajón compactador y el controlador. JEI nombra el crafteo."
	]
	quest.42000000000B01F7.title: "Mejora de vacío (Almacén)"
	quest.42000000000B01F8.quest_desc: [
		"Un inventario portátil que libera la barra de acceso rápido y el espacio de los bolsillos.",
		"Cómo: cuero + cofre. Luego mejoras de hierro/oro/diamante."
	]
	quest.42000000000B01F8.title: "Mochila"
	quest.42000000000B01F9.quest_desc: [
		"Más ranuras que la mochila simple, y una ranura para mejorarla.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B01F9.title: "Mochila de hierro"
	quest.42000000000B01FA.quest_desc: [
		"Aún más holgada, con ranuras libres para mejoras útiles.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B01FA.title: "Mochila de oro"
	quest.42000000000B01FB.quest_desc: [
		"Los bolsillos más hondos, antes de que encantar lleve el almacén todavía más lejos.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B01FB.title: "Mochila de diamante"
	quest.42000000000B01FC.quest_desc: [
		"Atrae lo que cae cerca directo al almacén en el que va montada.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B01FC.title: "Mejora de recogida (Almacén)"
	quest.42000000000B01FD.quest_desc: [
		"Filtra lo que entra en las mochilas.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B01FD.title: "Mejora de filtro"
	quest.42000000000B01FE.quest_desc: [
		"Deja que la mochila craftee con lo que ya tiene guardado.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B01FE.title: "Mejora de crafteo"
	quest.42000000000B01FF.quest_desc: [
		"Te alimenta sola con lo que guarda cuando baja el hambre.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B01FF.title: "Mejora de alimentación"
	quest.42000000000B0200.quest_desc: [
		"Cambia una herramienta rota por una nueva de la mochila.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B0200.title: "Mejora de reposición"
	quest.42000000000B0201.quest_desc: [
		"Vacía la mochila en los cofres cercanos cuando te acercas.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B0201.title: "Mejora de depósito"
	quest.42000000000B0202.quest_desc: [
		"Añade un tanque de fluidos dentro de la mochila para llevar líquidos.",
		"Cómo: mochila de cuero, luego mejoras de hierro/oro/diamante en JEI."
	]
	quest.42000000000B0202.title: "Mejora de tanque"
	quest.42000000000C0203.quest_desc: [
		"El metal base de casi todas las máquinas y carcasas de esta línea.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0203.title: "Lingote de acero"
	quest.42000000000C0204.quest_desc: [
		"El metal central de la mayoría de cables, tanques y máquinas tempranas.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0204.title: "Lingote de osmio"
	quest.42000000000C0205.quest_desc: [
		"Una aleación dura, prensada con polvo de obsidiana, para un equipo más resistente.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0205.title: "Obsidiana refinada"
	quest.42000000000C0206.quest_desc: [
		"La placa lógica más simple. La mayoría de las máquinas tempranas necesitan unas cuantas.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0206.title: "Circuito de control básico"
	quest.42000000000C0207.quest_desc: [
		"Una placa lógica más aguda, para las máquinas un peldaño más arriba en la línea.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0207.title: "Circuito de control avanzado"
	quest.42000000000C0208.quest_desc: [
		"La placa lógica más aguda, reservada a las máquinas de lo alto de la línea.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0208.title: "Circuito de control de élite"
	quest.42000000000C0209.quest_desc: [
		"Infunde los metales con carbono, redstone o polvo de diamante antes de fundirlos.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0209.title: "Infusor metalúrgico"
	quest.42000000000C020A.quest_desc: [
		"Duplica la mayoría de las menas crudas en dos polvos, en vez de uno.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C020A.title: "Cámara de enriquecimiento"
	quest.42000000000C020B.quest_desc: [
		"Muele o tritura material a granel.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C020B.title: "Trituradora"
	quest.42000000000C020C.quest_desc: [
		"Funde menas con energía en vez de combustible, y un poco más rápido también.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C020C.title: "Fundidora energizada"
	quest.42000000000C020D.quest_desc: [
		"Purifica la mena enriquecida con oxígeno y saca un tercer producto, a veces más.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C020D.title: "Cámara de purificación"
	quest.42000000000C020E.quest_desc: [
		"Inyecta gas en la mena para el rendimiento más rico que da la línea.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C020E.title: "Inyección química"
	quest.42000000000C020F.quest_desc: [
		"Comprime el polvo de osmio en lingotes, más rápido que un horno a solas.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C020F.title: "Compresor de osmio"
	quest.42000000000C0210.quest_desc: [
		"Una sola ranura de pila, que guarda mucho más de lo que un cofre puede.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0210.title: "Contenedor básico"
	quest.42000000000C0211.quest_desc: [
		"Guarda un pozo hondo de un solo fluido en un único bloque.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0211.title: "Tanque de fluidos básico"
	quest.42000000000C0212.quest_desc: [
		"Amortigua la energía entre las máquinas para que los picos no frenen la línea.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0212.title: "Cubo de energía básico"
	quest.42000000000C0213.quest_desc: [
		"Lleva energía a las máquinas. El cable más habitual de la plataforma.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0213.title: "Cable universal básico"
	quest.42000000000C0214.quest_desc: [
		"Mueve fluidos entre tanques y máquinas a lo largo de la plataforma.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0214.title: "Tubería mecánica básica"
	quest.42000000000C0215.quest_desc: [
		"Mueve objetos automáticamente entre inventarios conectados.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0215.title: "Transportador logístico básico"
	quest.42000000000C0216.quest_desc: [
		"Gira, hace de llave y reconfigura las caras de las máquinas con una sola herramienta.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0216.title: "Configurador"
	quest.42000000000C0217.quest_desc: [
		"Mochila a chorro de Mek — impulso opcional.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0217.title: "Mochila a chorro"
	quest.42000000000C0218.quest_desc: [
		"Suaviza el daño de caída y te compra un segundo antes de que el vacío te reclame.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0218.title: "Zapatillas libres"
	quest.42000000000C0219.quest_desc: [
		"Una herramienta que mina, corta y pelea, más afilada con cada mejora.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C0219.title: "Desensamblador atómico"
	quest.42000000000C021A.quest_desc: [
		"El armazón estructural sobre el que se montan casi todas las máquinas multibloque.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C021A.title: "Carcasa de acero"
	quest.42000000000C021B.quest_desc: [
		"Une dos puntos, y al cruzarlos te saltas el camino de en medio.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C021B.title: "Teletransportador"
	quest.42000000000C021C.quest_desc: [
		"Mina un radio amplio por su cuenta y te clasifica lo que extrae.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000000C021C.title: "Minero digital"
	quest.42000000000D021D.quest_desc: [
		"Un ingrediente base pegajoso del que salen casi todas las máquinas de la red.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D021D.title: "Pasta dieléctrica"
	quest.42000000000D021E.quest_desc: [
		"Guarda una medida de energía.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D021E.title: "Condensador básico"
	quest.42000000000D021F.quest_desc: [
		"Guarda una reserva honda de energía para las máquinas de alrededor.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D021F.title: "Célula de energía básica"
	quest.42000000000D0220.quest_desc: [
		"Quema combustible en energía, con más eficiencia que un horno normal.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0220.title: "Quemador básico"
	quest.42000000000D0221.quest_desc: [
		"Convierte la lava en energía constante mientras la lava dure.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0221.title: "Quemador de magma básico"
	quest.42000000000D0222.quest_desc: [
		"Genera energía con la luz del día, más de lo que una sola célula logra sola.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0222.title: "Panel solar básico"
	quest.42000000000D0223.quest_desc: [
		"Genera energía de la diferencia de calor entre bloques cercanos, unos calientes y otros fríos.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0223.title: "Generador térmico básico"
	quest.42000000000D0224.quest_desc: [
		"Quema combustible sólido sin pausa, para un chorrito de energía fuerte y fiable.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0224.title: "Reactor básico"
	quest.42000000000D0225.quest_desc: [
		"Mueve más energía por tick que el cable inicial.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0225.title: "Cable de energía básico"
	quest.42000000000D0226.quest_desc: [
		"Te carga directamente, sin cables ni ranuras.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0226.title: "Transmisor de jugador básico"
	quest.42000000000D0227.quest_desc: [
		"Mete energía en las máquinas cercanas igual que una tolva mete objetos.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0227.title: "Tolva de energía básica"
	quest.42000000000D0228.quest_desc: [
		"Carga las celdas energizantes más rápido cuando se coloca junto al montaje de cristales.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0228.title: "Vara energizante básica"
	quest.42000000000D0229.quest_desc: [
		"Una reserva de energía de bolsillo, para llevarla a mano entre máquinas.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D0229.title: "Batería básica"
	quest.42000000000D022A.quest_desc: [
		"El primer nivel de cristal para la cámara de celdas de la vara energizante.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D022A.title: "Cristal niótico"
	quest.42000000000D022B.quest_desc: [
		"Un nivel de cristal más fuerte, más adelante en el montaje de la cámara energizante.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D022B.title: "Cristal espiritado"
	quest.42000000000D022C.quest_desc: [
		"El nivel de cristal más fuerte que puede contener la cámara energizante.",
		"Cómo: capítulo Red Powah — orbe energizante y cables, cuando ya exista el Pulso de Chispa."
	]
	quest.42000000000D022C.title: "Cristal nitro"
	quest.42000000000E022D.quest_desc: [
		"Hilada de la flor de mago, y tejida en túnicas y equipo de hechizos.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E022D.title: "Fibra de mago"
	quest.42000000000E022E.quest_desc: [
		"Una flor que, tras la cosecha, vuelve a sacar la fibra en el tallo.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E022E.title: "Flor de mago"
	quest.42000000000E022F.quest_desc: [
		"Guarda un estanque denso de fuente, el combustible detrás de cada hechizo.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E022F.title: "Bloque de gema de fuente"
	quest.42000000000E0230.quest_desc: [
		"Admite más glifos de los que permite el libro inicial.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0230.title: "Libro de hechizos de aprendiz"
	quest.42000000000E0231.quest_desc: [
		"El libro de hechizos más grande, con sitio para un arsenal completo de glifos.",
		"Cómo: Libro de hechizos del mago, tres perlas de ender, dos esmeraldas, un Tótem de inmortalidad, una estrella del Nether y un Tributo wilden, sin forma. Tótem: receta del pack, cuatro bloques de oro y cuatro esmeraldas alrededor de una manzana dorada."
	]
	quest.42000000000E0231.title: "Libro de hechizos de archimago"
	quest.42000000000E0232.quest_desc: [
		"Lanza un hechizo vinculado automáticamente en cuanto detecta un objetivo.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0232.title: "Torreta de hechizos"
	quest.42000000000E0233.quest_desc: [
		"Lanza su hechizo vinculado con un temporizador fijo, no al ver.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0233.title: "Torreta de hechizos con temporizador"
	quest.42000000000E0234.quest_desc: [
		"La pieza central para crear libros de hechizos, varitas y otro equipo arcano.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0234.title: "Aparato de encantamiento"
	quest.42000000000E0235.quest_desc: [
		"Va dentro del aparato de encantamiento y hace funcionar sus recetas.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0235.title: "Núcleo arcano"
	quest.42000000000E0236.quest_desc: [
		"Lleva fuente entre un punto arcano y un tarro o un hechizo enlazados.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0236.title: "Relé"
	quest.42000000000E0237.quest_desc: [
		"Parte una línea de fuente para alimentar varios sitios a la vez.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0237.title: "Divisor de relé"
	quest.42000000000E0238.quest_desc: [
		"Convierte el crecimiento de los cultivos cercanos en un goteo lento de fuente.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0238.title: "Nexo de fuente agronómico"
	quest.42000000000E0239.quest_desc: [
		"Convierte el calor de la lava cercana en un goteo constante de fuente.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0239.title: "Nexo de fuente volcánico"
	quest.42000000000E023A.quest_desc: [
		"Invoca una wixie que fabrica recetas por ti mientras trabajas en otro sitio.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E023A.title: "Amuleto de Wixie"
	quest.42000000000E023B.quest_desc: [
		"Invoca un starbuncle que, a una orden, trae objetos del almacén.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E023B.title: "Amuleto de Starbuncle"
	quest.42000000000E023C.quest_desc: [
		"Invoca un drygmy que genera poco a poco, cerca, un recurso elegido.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E023C.title: "Amuleto de Drygmy"
	quest.42000000000E023D.quest_desc: [
		"Invoca un whirlisprig que cuida y hace crecer los cultivos por su cuenta.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E023D.title: "Amuleto de Whirlisprig"
	quest.42000000000E023E.quest_desc: [
		"Invoca un gólem que cosecha brotes de amatista sin levantar un pico.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E023E.title: "Amuleto de gólem de amatista"
	quest.42000000000E023F.quest_desc: [
		"Recoge y coloca bloques a distancia, y conecta máquinas entre sí desde lejos.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E023F.title: "Varita de dominio"
	quest.42000000000E0240.quest_desc: [
		"Marca un objeto como permitido al meterlo en un filtro.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0240.title: "Pergamino de permitir"
	quest.42000000000E0241.quest_desc: [
		"Marca un objeto como denegado al meterlo en un filtro.",
		"Cómo: Lado arcano — madera arcana y baya de fuente desde el musgo, luego la cascada."
	]
	quest.42000000000E0241.title: "Pergamino de denegar"
	quest.42000000000F0242.quest_desc: [
		"Troncos alrededor de un Nudo vinculante, Hilo encima. Colócalo en la plataforma.",
		"Quédate cerca: la plataforma empieza a curarte en cuanto una Hebra queda asentada.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: troncos alrededor de un Nudo vinculante, Hilo encima. Colócalo en la plataforma. Míralo para completar."
	]
	quest.42000000000F0242.title: "Levanta el Poste"
	quest.42000000000F0243.quest_desc: [
		"Llave del nexo en la mano, o /clowder hub. Aquí se reúne cada Clowder del servidor.",
		"/clowder return brings you home.",
		"Cómo: Llave del nexo o `/clowder hub`. `/clowder return` vuelve a casa."
	]
	quest.42000000000F0243.title: "Entra en la Sala"
	quest.42000000000F0244.quest_desc: [
		"Sobre el Muelle se alza una columna oscura y lenta: el corte mismo.",
		"Se adelgaza conforme los Clowders asientan Hebras. Vuelve de vez en cuando a comprobarlo.",
		"Cómo: /clowder hub, mira hacia arriba la columna oscura sobre el Muelle y luego pulsa la marca de verificación."
	]
	quest.42000000000F0244.title: "Mira el Desgarro"
	quest.42000000000F0245.quest_desc: [
		"Pon una plataforma a tu nombre.",
		"Cómo: K abre el panel de la isla. Sostén la Carta; úsala agachado en el suelo de una plataforma del Supramundo para sellar la aparición. Empieza aquí detalla los pasos."
	]
	quest.42000000000F0245.title: "Carta de la isla"
	quest.42000000000F0246.quest_desc: [
		"Abre el camino de vuelta a la Sala Clowder desde cualquier punto de la Hebra.",
		"Cómo: kit inicial / Sala. `/clowder hub` y la Llave del nexo van a la Sala Clowder; `/clowder return` vuelve a casa."
	]
	quest.42000000000F0246.title: "Llave del nexo"
	quest.42000000000F0247.quest_desc: [
		"Un diseño de estandarte que marca lo lejos que ha llegado tu Hebra.",
		"Cómo: fabrícalo en la Sala o en JEI. Una marca de estandarte, no una ficha de Hebra."
	]
	quest.42000000000F0247.title: "Estandarte de Hebra"
	quest.42000000000F0248.quest_desc: [
		"El acento grave (`) abre la lista de tareas. Clic derecho en el Códice de los Bigotes para Empieza aquí. La misma campaña; no hagas Mayús-clic en el libro.",
		"Cómo: un libro y cualquier piedra, sin forma. El acento grave (`) abre la misma lista sin él."
	]
	quest.42000000000F0248.title: "Lista de tareas"
	quest.42000000000F0249.quest_desc: [
		"Sigue alimentado en las salidas de reclamación.",
		"Cómo: ocho pepitas de oro alrededor de una zanahoria. Las zanahorias son un botín raro de los zombis; el tentempié es opcional."
	]
	quest.42000000000F0249.title: "Tentempié de reclamación"
	quest.42000000000F024A.quest_desc: [
		"Traza las plataformas a tu alrededor mientras tu Clowder se extiende hacia fuera.",
		"Cómo: una brújula rodeada de papel."
	]
	quest.42000000000F024A.title: "Mapa"
	quest.42000000000F024B.quest_desc: [
		"Señala de vuelta al punto de aparición del mundo; útil cuando las plataformas se multiplican.",
		"Cómo: hierro alrededor de redstone."
	]
	quest.42000000000F024B.title: "Brújula"
	quest.42000000000F024C.quest_desc: [
		"Fija una brújula a un punto exacto en vez del punto de aparición.",
		"Cómo: un lingote de netherita en ladrillos de piedra cincelados. Lujo tardío del Clowder."
	]
	quest.42000000000F024C.title: "Magnetita"
	quest.42000000000F024D.quest_desc: [
		"Señala hacia tu última muerte, para que nada siga perdido en el vacío.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000F024D.title: "Brújula de recuperación"
	quest.42000000000F024E.quest_desc: [
		"Repica lo bastante fuerte para reunir a todo el Clowder en una plataforma.",
		"Cómo: no hay receta. El ritual Contactar al espíritu salvaje de Occultism crea uno, pero hace falta una cabra, y las cabras nunca llegan a la plataforma. Opcional."
	]
	quest.42000000000F024E.title: "Campana"
	quest.42000000000F024F.quest_desc: [
		"Mantiene un libro abierto para que lo lea todo el Clowder.",
		"Cómo: losas de madera alrededor de una librería."
	]
	quest.42000000000F024F.title: "Atril"
	quest.42000000000F0250.quest_desc: [
		"Etiqueta un distrito para que los recién llegados sepan qué plataforma es cuál.",
		"Cómo: tablas sobre un palo."
	]
	quest.42000000000F0250.title: "Letrero de roble"
	quest.42000000000F0251.quest_desc: [
		"Un estandarte en blanco, listo para los colores del Clowder.",
		"Cómo: seis de lana sobre un palo."
	]
	quest.42000000000F0251.title: "Estandarte blanco"
	quest.42000000000F0252.quest_desc: [
		"Escudo listo para estandartes.",
		"Cómo: seis tablas alrededor del hierro. Bloqueo con la mano secundaria."
	]
	quest.42000000000F0252.title: "Escudo listo para estandarte"
	quest.42000000000F0253.quest_desc: [
		"Lánzalos cuando una Hebra por fin vuelva a reunirse.",
		"Cómo: papel más pólvora. Estallido opcional."
	]
	quest.42000000000F0253.title: "Fuego artificial"
	quest.42000000000F0254.quest_desc: [
		"Compártelo con la Sala.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000F0254.title: "Tributo de galletas"
	quest.42000000000F0255.quest_desc: [
		"Comida compartida para celebrar una Hebra bien y de verdad retramada.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000F0255.title: "Tarta"
	quest.42000000000F0256.quest_desc: [
		"Disco de gato — ánimo del paquete.",
		"Opcional — el vacío puede no ofrecerte nunca uno.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000F0256.title: "Disco de música"
	quest.42000000000F0257.quest_desc: [
		"Lleva a un animal domado o comprado de vuelta a la plataforma sin tener que perseguirlo.",
		"Cómo: cuatro cuerdas alrededor de una bola de slime. El slime es compost de la plataforma (tierra, semillas, polvo de hueso)."
	]
	quest.42000000000F0257.title: "Rienda"
	quest.42000000000F0258.quest_desc: [
		"Monta cuando encuentres una montura.",
		"Opcional — los Guardianes de la plataforma en la Sala Clowder venden una.",
		"Cómo: intercambia un bloque de diamante con los Guardianes de la plataforma en su tienda de la Sala Clowder (/clowder hub). La Montura Chocobo es otro objeto."
	]
	quest.42000000000F0258.title: "Montura"
	quest.42000000000F0259.quest_desc: [
		"Para el día en que alguien construya un mar. Opcional.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000000F0259.title: "Barca"
	quest.4200000000110278.quest_desc: [
		"Muestra dónde el aura se acumula, espesa o fina, por la tierra.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: Hoja de oro + ojo de araña. Muestra el aura local."
	]
	quest.4200000000110278.title: "Ojo (Aura)"
	quest.4200000000110279.quest_desc: [
		"Tejida con oro, sirve para infundir a las plantas un aura concentrada.",
		"Cómo: cuatro hojas y cuatro pepitas de oro alrededor de hierba corta dan cuatro Fibras brillantes. Ponla en la copa de un árbol; sus hojas se vuelven doradas con el tiempo."
	]
	quest.4200000000110279.title: "Fibra brillante (Aura)"
	quest.420000000011027A.quest_desc: [
		"Un material refinado para las recetas de nivel superior del altar.",
		"Cómo: rompe las hojas doradas crecidas de la Fibra brillante."
	]
	quest.420000000011027A.title: "Hoja de oro (Aura)"
	quest.420000000011027B.quest_desc: [
		"Hojas que guardan un suave brillo dorado todo el año.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011027B.title: "Hojas doradas"
	quest.420000000011027C.quest_desc: [
		"Sostiene un ingrediente para el Ritual del bosque, colocado alrededor de un retoño.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011027C.title: "Soporte de madera"
	quest.420000000011027D.quest_desc: [
		"El altar donde el aura impulsa recetas de crafteo más fuertes.",
		"Cómo: Ritual del bosque (JEI): tres piedras, una Hoja de oro, un lingote de oro y una Ficha de la alegría. Línea del Corazón del aura."
	]
	quest.420000000011027D.title: "Altar natural (Aura)"
	quest.420000000011027E.quest_desc: [
		"Hierro cargado de aura, un paso hacia el Lingote de las profundidades.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011027E.title: "Hierro imbuido (Aura)"
	quest.420000000011027F.quest_desc: [
		"Corteza arrancada de árboles antiguos, útil en recetas de aura.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011027F.title: "Corteza antigua"
	quest.4200000000110280.quest_desc: [
		"Una ficha de alegría. El Altar natural y el Absorbedor herbívoro se construyen sobre una.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110280.title: "Ficha de alegría (Aura)"
	quest.4200000000110281.quest_desc: [
		"Una ficha de miedo. El Menguador del dosel y el Absorbedor remanente se fabrican sobre una.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110281.title: "Ficha de miedo"
	quest.4200000000110282.quest_desc: [
		"Una ficha de ira. El Catalizador desmoronante y la Marca de tiro necesitan una.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110282.title: "Ficha de ira"
	quest.4200000000110283.quest_desc: [
		"Una ficha de pesar. La Mesa de ofrendas y el Desenredador de mortales necesitan una.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110283.title: "Ficha de pesar"
	quest.4200000000110284.quest_desc: [
		"Espíritu de aura para rituales.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110284.title: "Espíritu de la llamada"
	quest.4200000000110285.quest_desc: [
		"Espíritu de nacimiento para ritos de aura.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110285.title: "Espíritu del alumbramiento"
	quest.4200000000110286.quest_desc: [
		"Guarda una reserva de aura para cuando la tierra se quede escasa.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110286.title: "Tesoro de aura"
	quest.4200000000110287.quest_desc: [
		"Tarde. Solo si el Aura lo quiere.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110287.title: "Catalizador de creación"
	quest.4200000000110288.quest_desc: [
		"Revela el aura y las condiciones de aparición en un tramo más amplio de tierra.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110288.title: "Ocular ambiental"
	quest.4200000000110289.quest_desc: [
		"Colocado junto al Altar natural, abre las recetas de triturado del altar.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110289.title: "Catalizador desmoronante"
	quest.420000000011028A.quest_desc: [
		"Colocado junto al Altar natural, abre las recetas de transmutación del altar.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011028A.title: "Catalizador de transmutación"
	quest.420000000011028B.quest_desc: [
		"Lingotes del cielo, oro contaminado y chatarra de netherita, prensados en el Lingote de las profundidades.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011028B.title: "Lingote de las profundidades"
	quest.420000000011028C.quest_desc: [
		"Marca un trazado de granja que atrae el aura para que los cultivos crezcan más rápido.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011028C.title: "Plantilla de cultivo"
	quest.420000000011028D.quest_desc: [
		"Genera aura cada vez que un proyectil cae cerca.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011028D.title: "Marca de tiro"
	quest.420000000011028E.quest_desc: [
		"Genera aura lentamente con las flores que florecen cerca.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011028E.title: "Absorbedor herbívoro"
	quest.420000000011028F.quest_desc: [
		"Genera aura lentamente con los robles que crecen cerca.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.420000000011028F.title: "Menguador del dosel"
	quest.4200000000110290.quest_desc: [
		"Una flor del End, extrañamente a gusto en una plataforma.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110290.title: "Rosa del olvido"
	quest.4200000000110291.quest_desc: [
		"Ilumina una zona para que las criaturas hostiles no aparezcan allí.",
		"Cómo: Fibra brillante en los árboles → Hoja de oro → Altar natural. El capítulo del aura nombra las fichas y los generadores."
	]
	quest.4200000000110291.title: "Lámpara del santuario"
	quest.4200000000120292.quest_desc: [
		"Cocina comidas tipo estofado que sirven más de un plato a la vez.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000120292.title: "Olla de cocina (Cocina)"
	quest.4200000000120293.quest_desc: [
		"La sartén saltea los platos.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000120293.title: "Sartén"
	quest.4200000000120294.quest_desc: [
		"Estufa para Farmer's Delight.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000120294.title: "Estufa"
	quest.4200000000120295.quest_desc: [
		"Corta carne y verduras en los ingredientes que piden otras recetas.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000120295.title: "Tabla de cortar (Cocina)"
	quest.4200000000120296.quest_desc: [
		"Cesta para acarrear la cosecha.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000120296.title: "Cesta"
	quest.4200000000120297.quest_desc: [
		"Puedes treparla como una enredadera, y hace falta en varias recetas de cocina.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000120297.title: "Cuerda"
	quest.4200000000120298.quest_desc: [
		"Frena una caída larga y te rebota hacia arriba sin un rasguño.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.4200000000120298.title: "Red de seguridad"
	quest.4200000000120299.quest_desc: [
		"Cuando la labras y la siembras, acelera el crecimiento de los cultivos cercanos.",
		"Cómo: coloca Compost orgánico y espera; madura despacio hasta ser Tierra rica."
	]
	quest.4200000000120299.title: "Tierra rica (Cocina)"
	quest.420000000012029A.quest_desc: [
		"Convierte restos de comida en compost para enriquecer la tierra.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000012029A.title: "Compost orgánico (Cocina)"
	quest.420000000012029B.quest_desc: [
		"Una comida contundente envuelta en col que restaura un buen tramo de hambre.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000012029B.title: "Rollos de col"
	quest.420000000012029C.quest_desc: [
		"Rápido de cocinar, rápido de comer, un hambre decente para el esfuerzo.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000012029C.title: "Sándwich de beicon"
	quest.420000000012029D.quest_desc: [
		"Una comida en capas que restaura más hambre que las partes por separado.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000012029D.title: "Hamburguesa"
	quest.420000000012029E.quest_desc: [
		"Un cuenco que calienta y restaura hambre y saturación a la vez.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000012029E.title: "Sopa de pollo"
	quest.420000000012029F.quest_desc: [
		"El guiso de ternera llena de verdad.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.420000000012029F.title: "Guiso de ternera"
	quest.42000000001202A0.quest_desc: [
		"Fideos y caldo, lo bastante contundente para un día entero de trabajo.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A0.title: "Sopa de fideos"
	quest.42000000001202A1.quest_desc: [
		"Un postre al horno que merece la espera y restaura un buen tramo de hambre.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A1.title: "Tarta de manzana"
	quest.42000000001202A2.quest_desc: [
		"Ácido y dulce, uno de los postres más ricos en la plataforma.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A2.title: "Tarta de queso de bayas dulces"
	quest.42000000001202A3.quest_desc: [
		"Arroz para la línea de cocina.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A3.title: "Arroz"
	quest.42000000001202A4.quest_desc: [
		"Comida reconfortante de la línea de cocina.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A4.title: "Arroz frito"
	quest.42000000001202A5.quest_desc: [
		"Pequeños paquetes rellenos, rápidos de cocinar por tandas.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A5.title: "Empanadillas"
	quest.42000000001202A6.quest_desc: [
		"Una bebida caliente hecha con granos de cacao y leche.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A6.title: "Cacao caliente"
	quest.42000000001202A7.quest_desc: [
		"Una bebida fresca exprimida de sandía, restaura un poco de hambre enseguida.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A7.title: "Zumo de sandía"
	quest.42000000001202A8.quest_desc: [
		"Tela tejida que se usa en varias recetas de cocina y de decoración.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A8.title: "Lona"
	quest.42000000001202A9.quest_desc: [
		"Un suelo tejido y blando, un cambio de textura frente a la madera lisa.",
		"Cómo: fabricación de Farmer's Delight en JEI (mesa de crafteo, tabla de cortar u olla de cocina). Las semillas de cultivo salen al cribar tierra."
	]
	quest.42000000001202A9.title: "Tatami"
	quest.42000000001302AA.quest_desc: [
		"El primer libro que te deja lanzar hechizos en un combate de verdad.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: tres cadenas, cuatro cueros y dos papeles. El capítulo de hechizos nombra la tinta."
	]
	quest.42000000001302AA.title: "Libro de hechizos de hierro"
	quest.42000000001302AB.quest_desc: [
		"Tiene más ranuras de hechizo que el libro de hierro anterior.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302AB.title: "Libro de hechizos de oro"
	quest.42000000001302AC.quest_desc: [
		"Un libro más resistente, con aún más sitio para hechizos.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302AC.title: "Libro de hechizos de diamante"
	quest.42000000001302AD.quest_desc: [
		"Alimenta el lanzamiento de hechizos y está en la base de la mayoría de recetas de hechizos.",
		"Cómo: mata a lanzadores o craftea lo listado en JEI. Combustible para tinta y libros."
	]
	quest.42000000001302AD.title: "Esencia arcana (Hechizos)"
	quest.42000000001302AE.quest_desc: [
		"Escribe hechizos y páginas.",
		"Cómo: botella + esencia + tinte. La primera tinta de inscripción."
	]
	quest.42000000001302AE.title: "Tinta común"
	quest.42000000001302AF.quest_desc: [
		"Escribe en un libro hechizos y pergaminos de nivel poco común.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302AF.title: "Tinta poco común"
	quest.42000000001302B0.quest_desc: [
		"Escribe en un libro hechizos y pergaminos de nivel raro.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B0.title: "Tinta rara"
	quest.42000000001302B1.quest_desc: [
		"Escribe en un libro hechizos y pergaminos de nivel épico.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B1.title: "Tinta épica"
	quest.42000000001302B2.quest_desc: [
		"Escribe los hechizos más raros y más fuertes que un libro puede guardar.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B2.title: "Tinta legendaria"
	quest.42000000001302B3.quest_desc: [
		"Lanza un hechizo una sola vez, sin tener que aprenderlo en un libro.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B3.title: "Pergamino"
	quest.42000000001302B4.quest_desc: [
		"Tela mágica para túnicas.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B4.title: "Tela mágica"
	quest.42000000001302B5.quest_desc: [
		"Armadura ligera que prima el lanzamiento de hechizos sobre la defensa pura.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B5.title: "Yelmo del mago errante"
	quest.42000000001302B6.quest_desc: [
		"Armadura de pecho hecha para la velocidad al lanzar, no para el daño que aguanta.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B6.title: "Peto del mago errante"
	quest.42000000001302B7.quest_desc: [
		"Un bastón que canaliza hechizos de fuego con más fuerza.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B7.title: "Bastón de Pyrium"
	quest.42000000001302B8.quest_desc: [
		"Un bastón modesto para quien acaba de empezar a lanzar.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302B8.title: "Bastón barbagrís"
	quest.42000000001302B9.quest_desc: [
		"Una hoja que castiga a quien lanza hechizos y corta sus defensas.",
		"Cómo: receta del pack, dos Lingotes arcanos en la diagonal, una cadena a cada lado y un diamante en la empuñadura. Su único portador salvaje vive en los fuertes de invocadores, que la plataforma nunca tiene."
	]
	quest.42000000001302B9.title: "Cazamagos"
	quest.42000000001302BA.quest_desc: [
		"El libro de hechizos más temprano: pocas ranuras, pero fácil de conseguir.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302BA.title: "Libro de hechizos de cobre"
	quest.42000000001302BB.quest_desc: [
		"El libro de hechizos más fuerte, el que tiene más ranuras de hechizo.",
		"Cómo: cuatro Telas arcanas, dos Viales de sangre, un lingote de netherita, una Botella de relámpago y un Libro en ruinas (receta del pack). JEI lo llama Códice antiguo."
	]
	quest.42000000001302BB.title: "Libro de hechizos de netherita"
	quest.42000000001302BC.quest_desc: [
		"Metal refinado, usado en el equipo de hechizos de gama alta.",
		"Cómo: Esencia arcana y tinta, luego un libro de hechizos. El capítulo Hechizos nombra la escalera."
	]
	quest.42000000001302BC.title: "Lingote arcano"
	quest.42000000001302BD.quest_desc: [
		"Un libro dañado que se puede volver a componer en conocimiento.",
		"Cómo: receta del pack, un libro encantado rodeado de cuatro Esencias arcanas y cuatro arenas de almas. JEI lo llama Libro en ruinas."
	]
	quest.42000000001302BD.title: "Códice en ruinas"
	quest.42000000001402BE.quest_desc: [
		"La primera pieza de Solar Flux. Las células, los revestimientos y la Mejora en blanco se fabrican a partir de ella.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: tres cristales sobre un lingote de hierro hacen tres Espejos."
	]
	quest.42000000001402BE.title: "Espejo"
	quest.42000000001402BF.quest_desc: [
		"El primer nivel de célula solar, débil pero barata de apilar.",
		"Cómo: tres cristales, tres lapislázulis y tres Espejos, una fila de cada uno."
	]
	quest.42000000001402BF.title: "Célula fotovoltaica 1"
	quest.42000000001402C0.quest_desc: [
		"Una célula solar más fuerte, un paso por encima del nivel anterior.",
		"Cómo: tres bolas de arcilla, tres lapislázulis, dos Espejos y una Célula fotovoltaica I."
	]
	quest.42000000001402C0.title: "Célula fotovoltaica 2"
	quest.42000000001402C1.quest_desc: [
		"Célula solar de nivel medio, con bastante más salida por panel.",
		"Cómo: tres cristales, tres polvos de piedra luminosa, dos obsidianas y una Célula fotovoltaica II."
	]
	quest.42000000001402C1.title: "Célula fotovoltaica 3"
	quest.42000000001402C2.quest_desc: [
		"Una célula solar de nivel alto, para un panel hecho para crecer.",
		"Cómo: tres Revestimientos ardientes, dos polvos de piedra luminosa, un diamante, dos bloques de cuarzo y una Célula fotovoltaica III."
	]
	quest.42000000001402C2.title: "Célula fotovoltaica 4"
	quest.42000000001402C3.quest_desc: [
		"Casi en la cima, esta célula saca mucha energía de la luz del día.",
		"Cómo: tres Cristales de esmeralda, dos bloques de piedra luminosa, un bloque de diamante, un bloque de cuarzo y dos Células fotovoltaicas IV. Hace dos."
	]
	quest.42000000001402C3.title: "Célula fotovoltaica 5"
	quest.42000000001402C4.quest_desc: [
		"La célula solar más fuerte que se fabrica, el techo de un solo panel.",
		"Cómo: tres Cristales de ender, dos bloques de piedra luminosa, un bloque de esmeralda, un bloque de cuarzo y dos Células fotovoltaicas V. Hace dos."
	]
	quest.42000000001402C4.title: "Célula fotovoltaica 6"
	quest.42000000001402C5.quest_desc: [
		"Permite a un panel solar guardar una reserva mayor de energía.",
		"Cómo: cinco bloques de redstone, un bloque de diamante y una Mejora en blanco."
	]
	quest.42000000001402C5.title: "Mejora de capacidad"
	quest.42000000001402C6.quest_desc: [
		"Saca más energía de la misma luz del sol.",
		"Cómo: tres Espejos, una Mejora en blanco y una Célula fotovoltaica I."
	]
	quest.42000000001402C6.title: "Mejora de eficiencia"
	quest.42000000001402C7.quest_desc: [
		"Permite a un panel solar enviar la energía más rápido.",
		"Cómo: seis redstone y dos lingotes de oro alrededor de una Mejora en blanco."
	]
	quest.42000000001402C7.title: "Mejora de transferencia"
	quest.42000000001402C8.quest_desc: [
		"Pasa la energía a las máquinas unidas al panel, a unos pocos bloques.",
		"Cómo: cuatro lingotes de hierro, dos pistones y dos redstone alrededor de una Mejora en blanco."
	]
	quest.42000000001402C8.title: "Mejora de travesía"
	quest.42000000001402C9.quest_desc: [
		"Envía energía a los jugadores que están junto al panel.",
		"Cómo: cuatro polvos de piedra luminosa y cuatro Ojos de ender alrededor de una Mejora en blanco."
	]
	quest.42000000001402C9.title: "Mejora dispersiva"
	quest.42000000001402CA.quest_desc: [
		"Envía energía a un bloque vinculado dentro del alcance, sin cables.",
		"Cómo: cuatro perlas de ender y cuatro bloques de redstone alrededor de una Mejora dispersiva."
	]
	quest.42000000001402CA.title: "Mejora de carga de bloque"
	quest.42000000001402CB.quest_desc: [
		"Permite al panel fundir objetos con la luz solar guardada, en vez de combustible.",
		"Cómo: cinco carbones, un horno y dos Revestimientos llameantes alrededor de una Mejora en blanco."
	]
	quest.42000000001402CB.title: "Mejora de horno"
	quest.42000000001402CC.quest_desc: [
		"Cristal de espejo engastado con una esmeralda. El Cristal de ender y la Célula fotovoltaica V se construyen sobre él.",
		"Cómo: una esmeralda entre dos Espejos en columna da dos."
	]
	quest.42000000001402CC.title: "Cristal de esmeralda"
	quest.42000000001402CD.quest_desc: [
		"Cristal de esmeralda cargado con perlas y un ojo. La Célula fotovoltaica VI se construye sobre él.",
		"Cómo: tres Cristales de esmeralda sobre un Ojo de ender entre dos perlas de ender dan tres."
	]
	quest.42000000001402CD.title: "Cristal de ender"
	quest.42000000001402CE.quest_desc: [
		"Un acabado de Espejo espolvoreado con pólvora de blaze. La Célula fotovoltaica IV y la Mejora de horno lo usan.",
		"Cómo: pólvora de blaze entre dos Espejos en columna da dos."
	]
	quest.42000000001402CE.title: "Revestimiento llameante"
	quest.42000000001402CF.quest_desc: [
		"Una mejora aún sin definir, que se craftea en cualquier tipo de mejora.",
		"Cómo: cuatro adoquines alrededor de un Espejo."
	]
	quest.42000000001402CF.title: "Mejora en blanco"
	quest.42000000001502D0.quest_desc: [
		"Piedra sencilla y fiable para muros y suelos.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: cuatro piedras en un cuadrado, o el cortapiedras."
	]
	quest.42000000001502D0.title: "Ladrillos de piedra"
	quest.42000000001502D1.quest_desc: [
		"Remate de ladrillo musgoso para la plataforma.",
		"Cómo: ladrillos de piedra más enredaderas o musgo. Después, el cortapiedras."
	]
	quest.42000000001502D1.title: "Ladrillos de piedra musgosa"
	quest.42000000001502D2.quest_desc: [
		"Ladrillos de piedra envejecidos, con un aspecto gastado y agrietado.",
		"Cómo: funde ladrillos de piedra."
	]
	quest.42000000001502D2.title: "Ladrillos de piedra agrietados"
	quest.42000000001502D3.quest_desc: [
		"Ladrillos de piedra tallados para remates y líneas de acento.",
		"Cómo: dos losas de ladrillos de piedra, o el cortapiedras."
	]
	quest.42000000001502D3.title: "Ladrillos de piedra cincelados"
	quest.42000000001502D4.quest_desc: [
		"Un acabado de piedra plano y uniforme para suelos.",
		"Cómo: funde piedra. Las losas salen del cortapiedras."
	]
	quest.42000000001502D4.title: "Piedra lisa"
	quest.42000000001502D5.quest_desc: [
		"Piedra gris pulida hasta un acabado liso.",
		"Cómo: cuatro andesitas, o el cortapiedras."
	]
	quest.42000000001502D5.title: "Andesita pulida"
	quest.42000000001502D6.quest_desc: [
		"Piedra blanca y luminosa, pulida y lisa.",
		"Cómo: cuatro dioritas, o el cortapiedras."
	]
	quest.42000000001502D6.title: "Diorita pulida"
	quest.42000000001502D7.quest_desc: [
		"Piedra rosa cálida, pulida para los detalles.",
		"Cómo: cuatro granitos, o el cortapiedras."
	]
	quest.42000000001502D7.title: "Granito pulido"
	quest.42000000001502D8.quest_desc: [
		"Bloques de arcilla cocida, rojo cálido contra la piedra gris.",
		"Cómo: cuatro ladrillos (objetos). Las bolas de arcilla se funden en ladrillos."
	]
	quest.42000000001502D8.title: "Ladrillos"
	quest.42000000001502D9.quest_desc: [
		"Barro pálido y compacto, formado como remate de construcción.",
		"Cómo: cuatro adobes. El barro es tierra más una botella de agua; el barro y el trigo hacen adobe."
	]
	quest.42000000001502D9.title: "Ladrillos de adobe"
	quest.42000000001502DA.quest_desc: [
		"Ladrillos de piedra oscura sacados de las profundidades.",
		"Cómo: pizarra profunda pulida en un cuadrado, o el cortapiedras. Cuatro guijarros de pizarra profunda (criba tierra) hacen pizarra profunda adoquinada."
	]
	quest.42000000001502DA.title: "Ladrillos de pizarra profunda"
	quest.42000000001502DB.quest_desc: [
		"Baldosas oscuras y lisas para un suelo más elegante.",
		"Cómo: ladrillos de pizarra profunda en un cuadrado, o el cortapiedras."
	]
	quest.42000000001502DB.title: "Baldosas de pizarra profunda"
	quest.42000000001502DC.quest_desc: [
		"Piedra oscura del Nether, firme y sencilla.",
		"Cómo: agua de bruja vertida en un barril de lava, o cuatro guijarros de piedra negra. Los Bastiones se construyen con ella."
	]
	quest.42000000001502DC.title: "Piedra negra"
	quest.42000000001502DD.quest_desc: [
		"Piedra negra pulida hasta un brillo oscuro y lustroso.",
		"Cómo: cuatro piedra negra, o el cortapiedras. El Nether, tras Garra."
	]
	quest.42000000001502DD.title: "Piedra negra pulida"
	quest.42000000001502DE.quest_desc: [
		"Piedra negra salpicada de oro, rara y decorativa.",
		"Cómo: bastión del Nether tras la obsidiana de Garra. Una rama final de la decoración, no una puerta de más adelante."
	]
	quest.42000000001502DE.title: "Piedra negra dorada"
	quest.42000000001502DF.quest_desc: [
		"Bloque de un blanco vivo, un básico de la decoración de la plataforma.",
		"Cómo: cuatro cuarzo del Nether. El Nether, tras Garra."
	]
	quest.42000000001502DF.title: "Bloque de cuarzo"
	quest.42000000001502E0.quest_desc: [
		"Cuarzo alisado, para remates limpios.",
		"Cómo: funde un bloque de cuarzo."
	]
	quest.42000000001502E0.title: "Cuarzo liso"
	quest.42000000001502E1.quest_desc: [
		"Piedra púrpura del End, una pieza de acento un poco rara.",
		"Cómo: cuatro frutas chorus horneadas. La fruta chorus es el puesto de los Caminabordes."
	]
	quest.42000000001502E1.title: "Bloque de purpur"
	quest.42000000001502E2.quest_desc: [
		"Piedra nacida del mar, con un leve centelleo azul.",
		"Cómo: hacen falta fragmentos de prismarina. Solo el océano. Opcional."
	]
	quest.42000000001502E2.title: "Prismarina"
	quest.42000000001502E3.quest_desc: [
		"Una prismarina más oscura, buena para acentos profundos.",
		"Cómo: hacen falta fragmentos de prismarina. Solo el océano. Opcional."
	]
	quest.42000000001502E3.title: "Prismarina oscura"
	quest.42000000001502E4.quest_desc: [
		"Una luz firme, sacada del fondo del océano.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502E4.title: "Linterna marina"
	quest.42000000001502E5.quest_desc: [
		"Una luz naranja y cálida, criada de un hongo del Nether.",
		"Cómo: crece en hongos enormes. Planta un hongo en nylio y échale polvo de hueso."
	]
	quest.42000000001502E5.title: "Brillongo"
	quest.42000000001502E6.quest_desc: [
		"Una luz amarilla y suave, sin llama alguna.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502E6.title: "Ranoluz ocre"
	quest.42000000001502E7.quest_desc: [
		"Una luz pálida y luminosa, con un brillo de perla.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502E7.title: "Ranoluz perlada"
	quest.42000000001502E8.quest_desc: [
		"Una luz verde fresca, sin llama y segura en interiores.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502E8.title: "Ranoluz verde"
	quest.42000000001502E9.quest_desc: [
		"Cristal que bloquea la luz, pero deja la vista.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502E9.title: "Cristal tintado"
	quest.42000000001502EA.quest_desc: [
		"Cristal blanco suave, para una luz de ventana delicada.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502EA.title: "Cristal blanco"
	quest.42000000001502EB.quest_desc: [
		"Cristal azul pálido, cercano al cielo abierto.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502EB.title: "Cristal azul claro"
	quest.42000000001502EC.quest_desc: [
		"Cristal cian fresco, para una sala más calmada.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502EC.title: "Cristal cian"
	quest.42000000001502ED.quest_desc: [
		"Cristal de un morado profundo, un guiño al vacío de abajo.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502ED.title: "Cristal morado"
	quest.42000000001502EE.quest_desc: [
		"Una llama pequeña y firme, para luz de ambiente.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502EE.title: "Vela"
	quest.42000000001502EF.quest_desc: [
		"Una vela pálida, discreta contra paredes claras.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502EF.title: "Vela blanca"
	quest.42000000001502F0.quest_desc: [
		"Trepa el borde de la plataforma con seguridad.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F0.title: "Torre de andamio"
	quest.42000000001502F1.quest_desc: [
		"Escaleras para plataformas en vertical.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F1.title: "Reserva de escaleras"
	quest.42000000001502F2.quest_desc: [
		"Raíles a través del vacío.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F2.title: "Raíl de sobra"
	quest.42000000001502F3.quest_desc: [
		"Te mantiene a flote si la plataforma llega a encontrar agua.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F3.title: "Barca de roble"
	quest.42000000001502F4.quest_desc: [
		"Decoración para los muros de la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F4.title: "Cuadro de sobra"
	quest.42000000001502F5.quest_desc: [
		"Muestra un conjunto completo de armadura en la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F5.title: "Soporte para armadura"
	quest.42000000001502F6.quest_desc: [
		"Sostiene un objeto expuesto que nunca se apaga.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F6.title: "Marco brillante"
	quest.42000000001502F7.quest_desc: [
		"Macetas para el verde.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F7.title: "Maceta de repuesto"
	quest.42000000001502F8.quest_desc: [
		"Carteles colgantes para las salas.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F8.title: "Cartel colgante de roble"
	quest.42000000001502F9.quest_desc: [
		"Telar para trabajar estandartes.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502F9.title: "Telar"
	quest.42000000001502FA.quest_desc: [
		"Corta la piedra en formas precisas, sin desperdicio.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502FA.title: "Cortapiedras"
	quest.42000000001502FB.quest_desc: [
		"Repara herramientas y quita encantamientos que no quieres.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502FB.title: "Afiladora"
	quest.42000000001502FC.quest_desc: [
		"Mejora el equipo con plantillas de herrería y netherita.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502FC.title: "Mesa de herrería"
	quest.42000000001502FD.quest_desc: [
		"Traza la cuadrícula de la isla.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502FD.title: "Mesa de cartografía"
	quest.42000000001502FE.quest_desc: [
		"Un puesto de trabajo de aldeano, casi solo de adorno en la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502FE.title: "Mesa de flechas"
	quest.42000000001502FF.quest_desc: [
		"Funde menas el doble de rápido que un horno normal.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001502FF.title: "Alto horno de repuesto"
	quest.4200000000150300.quest_desc: [
		"Cocina comida el doble de rápido que un horno normal.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000150300.title: "Ahumador de repuesto"
	quest.4200000000150301.quest_desc: [
		"Guarda un poco de agua, tinte o poción.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000150301.title: "Caldero"
	quest.4200000000150302.quest_desc: [
		"Mueve objetos automáticamente entre los contenedores de abajo y de arriba.",
		"Cómo: cinco hierros alrededor de un cofre. Ponlo bajo un Bastidor del telar o un Barril de tensión (extrae hacia ABAJO)."
	]
	quest.4200000000150302.title: "Tolva de repuesto"
	quest.4200000000150303.quest_desc: [
		"Dispara o usa el objeto que le cargues.",
		"Cómo: roca, arco y redstone."
	]
	quest.4200000000150303.title: "Dispensador de repuesto"
	quest.4200000000150304.quest_desc: [
		"Emite un pulso de redstone cada vez que cambia el bloque de delante.",
		"Cómo: roca, redstone y cuarzo del Nether."
	]
	quest.4200000000150304.title: "Observador de repuesto"
	quest.4200000000150305.quest_desc: [
		"Una señal de redstone constante y fuerte, en forma de bloque.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000150305.title: "Bloque de redstone"
	quest.4200000000150306.quest_desc: [
		"Envía una fuerza de señal según lo bien que la golpees.",
		"Cómo: redstone alrededor del heno. El heno son tres trigos."
	]
	quest.4200000000150306.title: "Diana de repuesto"
	quest.4200000000150307.quest_desc: [
		"Toca una nota al golpearlo o al darle energía. Afínalo a mano.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000150307.title: "Bloque de notas de repuesto"
	quest.4200000000150308.quest_desc: [
		"Reproduce discos de música por toda la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.4200000000150308.title: "Tocadiscos de repuesto"
	quest.4200000000150309.quest_desc: [
		"La campana marca el Clowder.",
		"Cómo: no hay receta. El ritual Contactar al espíritu salvaje de Occultism crea uno, pero hace falta una cabra, y las cabras nunca llegan a la plataforma. Opcional."
	]
	quest.4200000000150309.title: "Campana de repuesto"
	quest.420000000015030A.quest_desc: [
		"Fija tu punto de reaparición en el Nether y se carga con piedra luminosa.",
		"Cómo: obsidiana llorosa más piedra luminosa. Reaparición solo en el Nether."
	]
	quest.420000000015030A.title: "Ancla de reaparición"
	quest.420000000015030B.quest_desc: [
		"Fija una brújula a este bloque exacto, en vez del punto de aparición.",
		"Cómo: un lingote de netherita en ladrillos de piedra cincelados. Lujo tardío del Clowder."
	]
	quest.420000000015030B.title: "Magnetita de repuesto"
	quest.420000000015030C.quest_desc: [
		"Desvía los rayos, a salvo, lejos de la plataforma.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.420000000015030C.title: "Pararrayos de repuesto"
	quest.420000000015030D.quest_desc: [
		"Un almacén personal que te sigue vayas donde vayas.",
		"Cómo: ocho de obsidiana alrededor de un Ojo de ender. El ojo es perla de ender más pólvora de blaze."
	]
	quest.420000000015030D.title: "Cofre de ender"
	quest.420000000015030E.quest_desc: [
		"Se craftea en una caja de shulker, almacén apilable y seguro.",
		"Cómo: receta del pack, seis bloques de purpur, dos perlas de ender y un Nudo vinculante. Los shulkers nunca aparecen aquí. Opcional."
	]
	quest.420000000015030E.title: "Caparazón de shulker"
	quest.420000000016030F.quest_desc: [
		"El suelo y las paredes de donde sea que construyas sobre lava.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: el Nether aquí es vacío, no terreno. Vierte lava en un barril de Ex Deorum con agua de bruja (un barril de agua sobre micelio; las esporas de micelio se criban de la tierra)."
	]
	quest.420000000016030F.title: "Reserva de piedra del Nether"
	quest.4200000000160310.quest_desc: [
		"Lodolita cocida, reforzada con cuarzo. Mantiene la forma cerca del fuego.",
		"Cómo: funde piedra del Nether y luego cuatro objetos de ladrillo del Nether."
	]
	quest.4200000000160310.title: "Ladrillos del Nether"
	quest.4200000000160311.quest_desc: [
		"Verruga del Nether horneada en ladrillo. Color más cálido, la misma fuerza.",
		"Cómo: ladrillos del Nether más verruga del Nether. El Nether, después de Garra."
	]
	quest.4200000000160311.title: "Ladrillos rojos del Nether"
	quest.4200000000160312.quest_desc: [
		"Columna de magma enfriada, cortada en bloques para un apoyo.",
		"Cómo: lava que fluye sobre tierra de almas junto a hielo azul, o cuatro guijarros de basalto al cribar piedra negra triturada."
	]
	quest.4200000000160312.title: "Basalto"
	quest.4200000000160313.quest_desc: [
		"Basalto lijado hasta quedar liso. Se lee como piedra, no como andamio.",
		"Cómo: cortapiedras, o cuatro de basalto."
	]
	quest.4200000000160313.title: "Basalto pulido"
	quest.4200000000160314.quest_desc: [
		"Basalto sin las estrías. Bueno para suelos planos y remates.",
		"Cómo: funde basalto."
	]
	quest.4200000000160314.title: "Basalto liso"
	quest.4200000000160315.quest_desc: [
		"La roca del Nether. Fábricala hacia herramientas y ladrillos.",
		"Cómo: agua de bruja vertida en un barril de lava, o cuatro guijarros de piedra negra. Los Bastiones se construyen con ella."
	]
	quest.4200000000160315.title: "Reserva de piedra negra"
	quest.4200000000160316.quest_desc: [
		"Calienta el agua cercana hasta que hierve y hace daño a los pies descalzos.",
		"Cómo: cuatro cremas de magma. Una bola de slime en un barril de lava hace crema."
	]
	quest.4200000000160316.title: "Bloque de magma"
	quest.4200000000160317.quest_desc: [
		"Reserva de arena de almas para apoyar el pie.",
		"Cómo: arena en un barril de Ex Deorum con agua de bruja. Las salas de verrugas de la fortaleza guardan un poco. Tres calaveras sobre arena de almas hacen un Wither."
	]
	quest.4200000000160317.title: "Reserva de arena de almas"
	quest.4200000000160318.quest_desc: [
		"Deja que el fuego de almas y las antorchas de almas ardan en vez de la llama normal.",
		"Cómo: arena de almas echada en un barril de lava de Ex Deorum."
	]
	quest.4200000000160318.title: "Tierra de almas"
	quest.4200000000160319.quest_desc: [
		"Se tritura en cuatro de polvo, o ilumina una sala sin humo.",
		"Cómo: cuatro polvos de piedra luminosa. El polvo se criba de la arena de almas."
	]
	quest.4200000000160319.title: "Piedra luminosa"
	quest.420000000016031A.quest_desc: [
		"Un hongo que brilla solo. No hace falta cableado.",
		"Cómo: crece en hongos enormes. Planta un hongo en nylio y échale polvo de hueso."
	]
	quest.420000000016031A.title: "Reserva de luz de hongo"
	quest.420000000016031B.quest_desc: [
		"Nueve verrugas del Nether reunidas en un bloque. Sobre todo decoración y tinte.",
		"Cómo: nueve verrugas del Nether. La verruga se criba de la arena de almas, o crece en los jardines de la fortaleza."
	]
	quest.420000000016031B.title: "Bloque de verrugas del Nether"
	quest.420000000016031C.quest_desc: [
		"El primo azul del bloque carmesí. La misma receta, un color más frío.",
		"Cómo: crece en hongos distorsionados enormes. Echa polvo de hueso a un hongo distorsionado sobre nilio distorsionado."
	]
	quest.420000000016031C.title: "Bloque de verrugas distorsionadas"
	quest.420000000016031D.quest_desc: [
		"Madera que no es madera. Se descorteza y hace tablas como cualquier tronco.",
		"Cómo: esporas de nilio carmesí (criba piedra del Nether triturada) sobre piedra del Nether, polvo de hueso en el nilio para un hongo, y luego polvo de hueso en el hongo."
	]
	quest.420000000016031D.title: "Tallo carmesí"
	quest.420000000016031E.quest_desc: [
		"El otro tronco de hongo. Las tablas salen azules, no rojas.",
		"Cómo: esporas de nilio distorsionado (criba piedra del Nether triturada) sobre piedra del Nether, polvo de hueso en el nilio para un hongo, y luego polvo de hueso en el hongo."
	]
	quest.420000000016031E.title: "Tallo distorsionado"
	quest.420000000016031F.quest_desc: [
		"Cadena para colgar un adorno.",
		"Cómo: bosques carmesí tras Garra. Cuelgan del techo."
	]
	quest.420000000016031F.title: "Enredaderas lacrimosas"
	quest.4200000000160320.quest_desc: [
		"Trepa un bosque distorsionado y marca un apoyo en la bruma.",
		"Cómo: bosques distorsionados tras Garra. Crecen hacia arriba desde el nilio."
	]
	quest.4200000000160320.title: "Enredaderas retorcidas"
	quest.4200000000160321.quest_desc: [
		"Llora luz morada y ancla un punto de reaparición en el Nether.",
		"Cómo: cofres de bastión, trueque con piglins o abejas Draconic que trabajan la obsidiana. Los portales en ruinas no se generan aquí."
	]
	quest.4200000000160321.title: "Obsidiana llorosa"
	quest.4200000000160322.quest_desc: [
		"Enterrado bajo las menas ordinarias. Fúndelo hacia la netherita.",
		"Cómo: martillea la piedra negra hasta hacer piedra negra triturada y críbala. Los cofres del bastión guardan un poco."
	]
	quest.4200000000160322.title: "Escombros ancestrales"
	quest.4200000000160323.quest_desc: [
		"Cuatro fragmentos y cuatro lingotes de oro hacen un lingote de netherita.",
		"Cómo: funde escombros ancestrales. Cuatro fragmentos más oro hacen un lingote."
	]
	quest.4200000000160323.title: "Fragmento de netherita"
	quest.4200000000160324.quest_desc: [
		"El metal más duro que una mano de Skybound llegará a sostener.",
		"Cómo: cuatro fragmentos más cuatro de oro. Los escombros son un Nether raro, tras Garra."
	]
	quest.4200000000160324.title: "Lingote de netherita"
	quest.4200000000160325.quest_desc: [
		"Alimenta soportes para pociones y altos hornos a la vez. Guarda un montón de sobra.",
		"Cómo: fortaleza del Nether tras la obsidiana de Garra. Las pociones quieren una vara; Ars y Occultism no la esperan."
	]
	quest.4200000000160325.title: "Reserva de varas de blaze"
	quest.4200000000160326.quest_desc: [
		"La poción de regeneración necesita una, y paciencia cerca de un ghast.",
		"Cómo: ghasts del Nether tras la obsidiana de Garra."
	]
	quest.4200000000160326.title: "Lágrima de ghast"
	quest.4200000000160327.quest_desc: [
		"Se destila en resistencia al fuego, o se vuelve a fabricar en un bloque de magma.",
		"Cómo: una bola de slime echada en un barril de lava, slime más polvo de blaze, o cubos de magma."
	]
	quest.4200000000160327.title: "Crema de magma"
	quest.4200000000160328.quest_desc: [
		"Tres invocan un Wither. Una también queda bien en una estantería.",
		"Cómo: fortaleza del Nether tras la obsidiana de Garra. Tres calaveras inician un Wither."
	]
	quest.4200000000160328.title: "Calavera de esqueleto wither"
	quest.4200000000160329.quest_desc: [
		"Los piglins cambian por oro. Las pepitas sirven igual que los lingotes.",
		"Cómo: un lingote hace nueve, o mena de oro del Nether."
	]
	quest.4200000000160329.title: "Montón de pepitas de oro"
	quest.420000000016032A.quest_desc: [
		"Se funde en oro y se mina más rápido que la mena de la que toma el nombre.",
		"Cómo: combinador de Mekanism, ocho oros en bruto más netherrack. El Nether vacío no tiene mena."
	]
	quest.420000000016032A.title: "Mena de oro del Nether"
	quest.420000000016032B.quest_desc: [
		"Piedra blanca y brillante que sirve para construir y para llevar señales de comparador.",
		"Cómo: criba arena de almas, o trueque con piglins."
	]
	quest.420000000016032B.title: "Cuarzo"
	quest.420000000016032C.quest_desc: [
		"Lanzada, prende fuego. Cargada en un dispensador, también.",
		"Cómo: pólvora de blaze, carbón y pólvora."
	]
	quest.420000000016032C.title: "Carga de fuego"
	quest.4200000000178001.quest_desc: [
		"Doce marcos de portal no son un crafteo de la plataforma, así que el End queda a un bocado.",
		"Cómelo para plantarte en la plataforma de obsidiana del End; come la mitad que queda para volver a casa, al sitio del que comiste.",
		"Cómo: cinco perlas de ender, dos huesos y dos pólvoras de blaze en una mesa de crafteo."
	]
	quest.4200000000178001.title: "Manzana del End"
	quest.420000000017032D.quest_desc: [
		"Piedra pálida del otro lado. Pesada, sencilla e infinita.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: fruta chorus y perlas de ender (puesto de los Caminabordes) alrededor de un Nudo vinculante. Da ocho. La isla del End ya no está."
	]
	quest.420000000017032D.title: "Piedra del End"
	quest.420000000017032E.quest_desc: [
		"Piedra del End cortada en cuadrado, para líneas más limpias en una plataforma del End.",
		"Cómo: cuatro Piedra del End en cuadrado, o el cortapiedras. La Piedra del End es el crafteo del Nudo."
	]
	quest.420000000017032E.title: "Ladrillos de piedra del End"
	quest.420000000017032F.quest_desc: [
		"Crece de la fruta chorus y luego se hornea en piedra de construcción.",
		"Cómo: cuatro frutas chorus horneadas. La fruta chorus es el puesto de los Caminabordes."
	]
	quest.420000000017032F.title: "Reserva de bloque de purpur"
	quest.4200000000170330.quest_desc: [
		"Purpur con un motivo de columna, orientado como lo coloques.",
		"Cómo: dos losas de purpur, o el cortapiedras. Primero la fruta chorus horneada."
	]
	quest.4200000000170330.title: "Pilar de purpur"
	quest.4200000000170331.quest_desc: [
		"Una luz fría que nunca parpadea y también hace de poste de raíl.",
		"Cómo: vara de blaze más fruta chorus horneada. El Nether, tras Garra; el chorus es el puesto de los Caminabordes."
	]
	quest.4200000000170331.title: "Vara del End"
	quest.4200000000170332.quest_desc: [
		"Cómela y te teletransportas un salto corto e impredecible.",
		"Cómo: puesto de los Caminabordes en /clowder hub. Las islas exteriores del End ya no están."
	]
	quest.4200000000170332.title: "Fruta chorus"
	quest.4200000000170333.quest_desc: [
		"Fruta chorus cocinada. Se fabrica en purpur y tintes sin teletransportarte.",
		"Cómo: funde fruta chorus del puesto de los Caminabordes."
	]
	quest.4200000000170333.title: "Chorus horneado"
	quest.4200000000170334.quest_desc: [
		"Lánzala y llegas donde cae, menos un poco de salud.",
		"Cómo: endermen, o el puesto de los Caminabordes en /clowder hub."
	]
	quest.4200000000170334.title: "Reserva de perlas de ender"
	quest.4200000000170335.quest_desc: [
		"Reserva de ojos de ender.",
		"Cómo: perla de ender (puesto de los Caminabordes / endermen) más pólvora de blaze de una fortaleza del Nether, tras la obsidiana de Garra. El acopio de ocho ojos es opcional; los cristales del End usan el mismo crafteo."
	]
	quest.4200000000170335.title: "Reserva de ojo de ender"
	quest.4200000000170336.quest_desc: [
		"Aliento de dragón para pociones.",
		"Cómo: frasco de cristal sobre el dragón. La isla del End ya no está. Opcional."
	]
	quest.4200000000170336.title: "Reserva de aliento de dragón"
	quest.4200000000170337.quest_desc: [
		"El único trofeo del dragón. Nunca se queda quieto al hacer clic.",
		"Recompensa rara: una vida compartida de Clowder, una sola vez para todo el equipo. Solo hay seis recompensas así en la campaña.",
		"Cómo: el dragón se fue con la isla del End. Trofeo opcional: no bloquea los cofres de ender."
	]
	quest.4200000000170337.title: "Muestra del huevo de dragón"
	quest.4200000000170338.quest_desc: [
		"Élitros para viajar por el cielo.",
		"Opcional — el vacío puede no ofrecerte nunca uno.",
		"Cómo: las ciudades del End ya no están. Opcional."
	]
	quest.4200000000170338.title: "Muestra de élitros"
	quest.4200000000170339.quest_desc: [
		"Caparazones de shulker para cajas.",
		"Opcional: aquí no hay shulkers, así que el pack fabrica los caparazones.",
		"Cómo: receta del pack, seis bloques de purpur, dos perlas de ender y un Nudo vinculante. Los shulkers nunca aparecen aquí. Opcional."
	]
	quest.4200000000170339.title: "Reserva de caparazón de shulker"
	quest.420000000017033A.quest_desc: [
		"Un cofre portátil que guarda su contenido al romperlo.",
		"Opcional: los Caminabordes en la Sala Clowder venden una.",
		"Cómo: dos Caparazones de shulker alrededor de un cofre (los caparazones son una receta del pack), o el puesto de los Caminabordes en /clowder hub por 22 Madejas de Hilo (198 de Hilo). Opcional."
	]
	quest.420000000017033A.title: "Muestra de caja de shulker"
	quest.420000000017033B.quest_desc: [
		"Cristales del End: con cuidado.",
		"Cómo: cristal, ojo de ender, lágrima de ghast. Nether tras la obsidiana de Garra; el huevo es opcional."
	]
	quest.420000000017033B.title: "Muestra de cristal del End"
	quest.420000000017033C.quest_desc: [
		"Cada cofre de ender, en cada plataforma, comparte un único almacén oculto.",
		"Cómo: ocho de obsidiana alrededor de un Ojo de ender. El ojo es perla de ender más pólvora de blaze."
	]
	quest.420000000017033C.title: "Muestra del cofre de ender"
	quest.420000000017033D.quest_desc: [
		"Plántala en piedra del End y la fruta chorus crece hacia arriba.",
		"Cómo: las islas exteriores del End ya no están. La fruta chorus está en el puesto de los Caminabordes. Opcional."
	]
	quest.420000000017033D.title: "Flor chorus"
	quest.420000000017033E.quest_desc: [
		"Doce de estos, llenos de ojos, abren el camino al End.",
		"Cómo: no es un crafteo de la plataforma. Opcional."
	]
	quest.420000000017033E.title: "Marco del portal del End"
	quest.420000000017033F.quest_desc: [
		"Cemento hecho sólido. Oscuro como el vacío, y permanente cuando fragua.",
		"Cómo: cemento más agua. El polvo es arena, grava y tinte."
	]
	quest.420000000017033F.title: "Hormigón negro"
	quest.4200000000170340.quest_desc: [
		"Un color de acento chillón para un bioma quieto y pálido.",
		"Cómo: cemento más agua. El polvo es arena, grava y tinte."
	]
	quest.4200000000170340.title: "Hormigón morado"
	quest.4200000000170341.quest_desc: [
		"Lava enfriada al contacto con el agua. Resiste las explosiones y se pica despacio.",
		"Cómo: agua sobre una fuente de lava (o lava sobre agua). Conserva la fuente de lava."
	]
	quest.4200000000170341.title: "Reserva de obsidiana"
	quest.4200000000170342.quest_desc: [
		"Brilla débil y, cargada, te lanza desde un ancla de reaparición.",
		"Cómo: cofres de bastión, trueque con piglins o abejas Draconic que trabajan la obsidiana. Los portales en ruinas no se generan aquí."
	]
	quest.4200000000170342.title: "Reserva de obsidiana llorosa"
	quest.4200000000170343.quest_desc: [
		"Cárgala con piedra luminosa para fijar un punto de reaparición en el Nether.",
		"Cómo: obsidiana llorosa más piedra luminosa. Reaparición solo en el Nether."
	]
	quest.4200000000170343.title: "Muestra del ancla de reaparición"
	quest.4200000000170344.quest_desc: [
		"En la mano secundaria, anula un golpe que, si no, sería mortal.",
		"Cómo: solo recompensas de misiones. Asienta Reloj y Asienta Sello dan uno cada uno, y los regalos de los Nudos de Hebra tardíos ofrecen más. Las incursiones y los invocadores nunca llegan a la plataforma. Opcional."
	]
	quest.4200000000170344.title: "Muestra del tótem"
	quest.4200000000170345.quest_desc: [
		"Lo único que suelta el Wither. Un faro necesita una para encenderse.",
		"Cómo: Wither (tres calaveras sobre arena de almas), o el puesto de los Corazones de tambor en /clowder hub una vez, por 12 Rollos de Hilo (972 de Hilo). Trofeo opcional — no bloquea el End ni la Granja de monstruos al 100%."
	]
	quest.4200000000170345.title: "Muestra de la estrella del Nether"
	quest.4200000000170346.quest_desc: [
		"Alimentado por una pirámide de bloques minerales, concede mejoras mientras estás en su zona.",
		"Cómo: estrella del Nether, cristal y obsidiana. Trofeo opcional — las ramas del océano cuelgan de Reserva de obsidiana."
	]
	quest.4200000000170346.title: "Muestra del faro"
	quest.4200000000170347.quest_desc: [
		"Rodeado de prismarina, concede respiración acuática y prisa bajo el agua.",
		"Opcional — el vacío puede no ofrecerte nunca uno.",
		"Cómo: necesita Corazón del mar y nautilo. Solo océano. Opcional."
	]
	quest.4200000000170347.title: "Muestra del conducto"
	quest.4200000000170348.quest_desc: [
		"Ocho rodean un conducto y una se craftea en la brújula del mar.",
		"Opcional — el vacío puede no ofrecerte nunca uno.",
		"Cómo: solo océano. Opcional."
	]
	quest.4200000000170348.title: "Concha de nautilo"
	quest.4200000000170349.quest_desc: [
		"Botín raro de un ahogado. Lánzalo, o canaliza un rayo en una tormenta.",
		"Cómo: solo ahogados. Opcional."
	]
	quest.4200000000170349.title: "Muestra del tridente"
	quest.420000000018034A.quest_desc: [
		"Esencia base. Alimenta por igual aceleradores de crecimiento y reprocesadores.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000018034A.title: "Reserva de Inferium"
	quest.420000000018034B.quest_desc: [
		"Una semilla a medias. Necesita esencia antes de hacer crecer nada.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000018034B.title: "Base de Prosperity"
	quest.420000000018034C.quest_desc: [
		"Se consume una vez y sube la esencia al siguiente nivel.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000018034C.title: "Cristal de infusión"
	quest.420000000018034D.quest_desc: [
		"Esencia de segundo nivel, refinada a partir de pilas de Inferium.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000018034D.title: "Reserva de Prudentium"
	quest.420000000018034E.quest_desc: [
		"Esencia de tercer nivel, un peldaño por encima de Prudentium.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000018034E.title: "Reserva de Tertium"
	quest.420000000018034F.quest_desc: [
		"Esencia de cuarto nivel, cerca de lo alto de la cadena.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000018034F.title: "Reserva de Imperium"
	quest.4200000000180350.quest_desc: [
		"Esencia de quinto nivel, casi tan refinada como se puede.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180350.title: "Reserva de Supremium"
	quest.4200000000180351.quest_desc: [
		"La cima ya refinada. Hace falta para el mejor equipo y las mejores semillas.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180351.title: "Esencia despertada"
	quest.4200000000180352.quest_desc: [
		"La pieza central para despertar la esencia hasta su forma final.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180352.title: "Altar del despertar"
	quest.4200000000180353.quest_desc: [
		"Rodea el altar con estos para completar el despertar.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180353.title: "Pedestal del despertar"
	quest.4200000000180354.quest_desc: [
		"Un cristal de infusión al que nunca se le acaban las cargas.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180354.title: "Cristal maestro"
	quest.4200000000180355.quest_desc: [
		"Guarda esencia a granel para que las máquinas no se queden secas.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180355.title: "Vasija de esencia"
	quest.4200000000180356.quest_desc: [
		"El componente base de toda máquina que va con esencia.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180356.title: "Armazón de máquina"
	quest.4200000000180357.quest_desc: [
		"Vigila los cultivos cercanos y los rompe en el momento en que maduran.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180357.title: "Cosechadora"
	quest.4200000000180358.quest_desc: [
		"Convierte las semillas de sobra otra vez en esencia, en vez de en trastos.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180358.title: "Reprocesador de semillas"
	quest.4200000000180359.quest_desc: [
		"Acelera los cultivos cercanos con esencia de Inferium.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.4200000000180359.title: "Acelerador Inferium"
	quest.420000000018035A.quest_desc: [
		"Un acelerador más fuerte, un nivel por encima de Inferium.",
		"Cómo: fabricación de Mystical Agriculture en JEI. Inferium y Prosperity salen del cedazo; las semillas se infunden en el Altar de infusión."
	]
	quest.420000000018035A.title: "Acelerador Prudentium"
	quest.420000000018035B.quest_desc: [
		"Aceleración de nivel medio para un campo con más trajín.",
