	quest.42000000001903A2.quest_desc: [
		"Guarda una abeja a salvo para el transporte entre plataformas.",
		"Cómo: solo en cofres de aldea, y el vacío no tiene aldeas. Opcional."
	]
	quest.42000000001903A2.title: "Jaula robusta"
	quest.42000000001903A3.quest_desc: [
		"Recoge abejas en tarros automáticamente; no hace falta red.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903A3.title: "Capturador (Colmenar)"
	quest.42000000001903A4.quest_desc: [
		"Mantiene alimentada una colmena para que las abejas sigan trabajando.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903A4.title: "Comedero"
	quest.42000000001903A5.quest_desc: [
		"Llena frascos con la miel guardada de una colmena.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903A5.title: "Embotellador (Colmenar)"
	quest.42000000001903A6.quest_desc: [
		"Gira el panal y lo separa en miel, cera y panales.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903A6.title: "Centrífuga (Colmenar)"
	quest.42000000001903A7.quest_desc: [
		"Una centrífuga que gira sola en cuanto tiene energía.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903A7.title: "Centrífuga energética (Colmenar)"
	quest.42000000001903A8.quest_desc: [
		"Gira más rápido si la alimenta una fuente de calor.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903A8.title: "Centrífuga calentada"
	quest.42000000001903A9.quest_desc: [
		"Hace eclosionar larvas de abeja en abejas nuevas con rasgos útiles.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903A9.title: "Incubadora (Colmenar)"
	quest.42000000001903AA.quest_desc: [
		"Empareja dos abejas y produce crías con rasgos mezclados.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903AA.title: "Cámara de cría (Colmenar)"
	quest.42000000001903AB.quest_desc: [
		"Lee los rasgos de una abeja y los apunta para la cría.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903AB.title: "Indexador de genes (Colmenar)"
	quest.42000000001903AC.quest_desc: [
		"Quema miel y da un hilo lento y constante de energía.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903AC.title: "Generador de miel (Colmenar)"
	quest.42000000001903AD.quest_desc: [
		"Un tentempié que mantiene calmada y sana a una abeja enjaulada.",
		"Cómo: panal más un frasco de miel, sin forma."
	]
	quest.42000000001903AD.title: "Golosina de miel (Colmenar)"
	quest.42000000001903AE.quest_desc: [
		"Un cubo lleno de miel, listo para verter o quemar.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903AE.title: "Cubo de miel"
	quest.42000000001903AF.quest_desc: [
		"Se funde para hacer velas, o sella el marco de una colmena.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903AF.title: "Reserva de cera"
	quest.42000000001903B0.quest_desc: [
		"Un panal que se puede ajustar para coincidir con cualquier abeja.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903B0.title: "Panal configurable"
	quest.42000000001903B1.quest_desc: [
		"Los rasgos de una abeja, extraídos y listos para embotellar.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903B1.title: "Muestra de genes"
	quest.42000000001903B2.quest_desc: [
		"La genética de una abeja, guardada para criar más adelante.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903B2.title: "Frasco de genes"
	quest.42000000001903B3.quest_desc: [
		"Cuatro panales prensados en sólido, sobre todo para construir.",
		"Cómo: cuatro panales."
	]
	quest.42000000001903B3.title: "Bloque de panal"
	quest.42000000001903B4.quest_desc: [
		"Ralentiza las caídas y el movimiento. Pegajoso bajo los pies, dulce en una tolva.",
		"Cómo: cuatro frascos de miel. Los frascos vuelven."
	]
	quest.42000000001903B4.title: "Bloque de miel (colmenar)"
	quest.42000000001903B5.quest_desc: [
		"Una colmena salvaje. Ahúmala para calmarla antes de coger el panal.",
		"Cómo: tres panales y seis tablas. Una hoguera debajo las calma."
	]
	quest.42000000001903B5.title: "Colmena del juego base"
	quest.42000000001903B6.quest_desc: [
		"El humo desde abajo mantiene tranquilas a las abejas durante la cosecha.",
		"Cómo: troncos, palos y carbón o carbón vegetal."
	]
	quest.42000000001903B6.title: "Hoguera debajo"
	quest.42000000001903B7.quest_desc: [
		"Flores para el trabajo de las abejas.",
		"Cómo: polvo de hueso sobre la hierba, o una flor pequeña para el nido de roble."
	]
	quest.42000000001903B7.title: "Manto de flores"
	quest.42000000001903B8.quest_desc: [
		"Más flores cerca significa más polen para la colmena.",
		"Cómo: polvo de hueso en la hierba. Las abejas quieren cualquier flor pequeña."
	]
	quest.42000000001903B8.title: "Campo de dientes de león"
	quest.42000000001903B9.quest_desc: [
		"Una flor más vistosa, que algunas abejas prefieren a los dientes de león.",
		"Cómo: musgo más roble, o polvo de hueso sobre el musgo. Las abejas aceptan la flor."
	]
	quest.42000000001903B9.title: "Floración de azalea"
	quest.42000000001903BA.quest_desc: [
		"Una fruta del End de la que algunas abejas recolectan a gusto.",
		"Cómo: puesto de los Caminabordes en /clowder hub. Las islas exteriores del End ya no están."
	]
	quest.42000000001903BA.title: "Tentempié chorus"
	quest.42000000001903BB.quest_desc: [
		"Un favorito extraño para algunas de las abejas más duras.",
		"Cómo: agua sobre una fuente de lava (o lava sobre agua). Conserva la fuente de lava."
	]
	quest.42000000001903BB.title: "Golosina de obsidiana"
	quest.42000000001903BC.quest_desc: [
		"Más estancias para la colmena, esta vez cortadas de abedul.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903BC.title: "Ampliación de abedul"
	quest.42000000001903BD.quest_desc: [
		"Estancias revestidas de abeto, atornilladas a la colmena.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903BD.title: "Ampliación de abeto"
	quest.42000000001903BE.quest_desc: [
		"Paneles de roble oscuro, el mismo fin: más estancias para las abejas.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903BE.title: "Ampliación de roble oscuro"
	quest.42000000001903BF.quest_desc: [
		"Estancias de acacia para una colmena que ha crecido más de la cuenta.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903BF.title: "Ampliación de acacia"
	quest.42000000001903C0.quest_desc: [
		"Estancias de madera de jungla, igual de amplias que el resto.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903C0.title: "Ampliación de jungla"
	quest.42000000001903C1.quest_desc: [
		"Estancias revestidas de cerezo, pura cuestión de estilo.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903C1.title: "Ampliación de cerezo"
	quest.42000000001903C2.quest_desc: [
		"Estancias revestidas de carmesí para una colmena que se ha ido al Nether.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903C2.title: "Ampliación carmesí"
	quest.42000000001903C3.quest_desc: [
		"Estancias revestidas de madera distorsionada, la mitad azul del par.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903C3.title: "Ampliación distorsionada"
	quest.42000000001903C4.quest_desc: [
		"Estancias de bambú, más ligeras y igual de útiles.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903C4.title: "Ampliación de bambú"
	quest.42000000001903C5.quest_desc: [
		"Estancias de mangle, la madera más nueva de la lista.",
		"Cómo: el crafteo de Productive Bees está en JEI. Enjambre nombra la colmena, la centrífuga y los pasos de cría."
	]
	quest.42000000001903C5.title: "Ampliación de mangle"
	quest.42000000001903C6.quest_desc: [
		"Miel que puedes beber directa del frasco.",
		"Cómo: frasco de cristal sobre una colmena llena. Hoguera debajo."
	]
	quest.42000000001903C6.title: "Reserva de frascos de miel"
	quest.42000000001903C7.quest_desc: [
		"Se elabora en golosinas y tartas para un Clowder hambriento.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001903C7.title: "Reserva de azúcar"
	quest.42000000001903C8.quest_desc: [
		"Vacíos y a la espera de miel, pociones o experiencia.",
		"Cómo: fabrica, funde, criba o que lo suelte un monstruo. JEI lista cada fuente en la plataforma."
	]
	quest.42000000001903C8.title: "Reserva de frascos"
	quest.42000000001903C9.quest_desc: [
		"Un par de repuesto para cortar el panal sin hacer daño a las abejas.",
		"Cómo: dos lingotes de hierro en diagonal. Esquila ovejas y nidos de abejas."
	]
	quest.42000000001903C9.title: "Tijeras de repuesto"
	quest.42000000001A03CA.quest_desc: [
		"Un bloque que mueve objetos adonde le digas — el sistema nervioso de la plataforma.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: lingotes de hierro y barrotes de hierro alrededor de un módulo en blanco; salen cuatro. Los módulos van en el enrutador."
	]
	quest.42000000001A03CA.title: "Enrutador modular"
	quest.42000000001A03CB.quest_desc: [
		"La tarjeta en la que se escribe cada comportamiento del enrutador.",
		"Cómo: Enrutador modular más módulos en blanco en JEI. Extractor/emisor/rompedor van dentro del enrutador."
	]
	quest.42000000001A03CB.title: "Módulo en blanco"
	quest.42000000001A03CC.quest_desc: [
		"Saca objetos de un vecino y los mete en el enrutador.",
		"Cómo: Enrutador modular más módulos en blanco en JEI. Extractor/emisor/rompedor van dentro del enrutador."
	]
	quest.42000000001A03CC.title: "Módulo extractor"
	quest.42000000001A03CD.quest_desc: [
		"Empuja objetos a un punto marcado al otro lado de la plataforma.",
		"Cómo: Enrutador modular más módulos en blanco en JEI. Extractor/emisor/rompedor van dentro del enrutador."
	]
	quest.42000000001A03CD.title: "Módulo emisor"
	quest.42000000001A03CE.quest_desc: [
		"Rompe un bloque delante del enrutador y quédate con lo que suelte.",
		"Cómo: Enrutador modular más módulos en blanco en JEI. Extractor/emisor/rompedor van dentro del enrutador."
	]
	quest.42000000001A03CE.title: "Módulo rompedor"
	quest.42000000001A03CF.quest_desc: [
		"Coloca un bloque adonde apunta el enrutador.",
		"Cómo: Enrutador modular más módulos en blanco en JEI. Extractor/emisor/rompedor van dentro del enrutador."
	]
	quest.42000000001A03CF.title: "Módulo colocador"
	quest.42000000001A03D0.quest_desc: [
		"Emite redstone cuando el contenido del enrutador cruce un umbral.",
		"Cómo: Enrutador modular más módulos en blanco en JEI. Extractor/emisor/rompedor van dentro del enrutador."
	]
	quest.42000000001A03D0.title: "Módulo detector"
	quest.42000000001A03D1.quest_desc: [
		"Lleva objetos entre cofres, máquinas y plataformas.",
		"Cómo: hierro + redstone. Ajusta las caras con la llave inglesa de Pipez."
	]
	quest.42000000001A03D1.title: "Tubo de objetos"
	quest.42000000001A03D2.quest_desc: [
		"Lleva líquidos entre tanques y máquinas, sin ir y venir con el cubo.",
		"Cómo: hierro + cubos + redstone. Uso agachado de la llave inglesa en un lado para extraer; clic derecho en ese lado para los filtros."
	]
	quest.42000000001A03D2.title: "Tubo de fluidos"
	quest.42000000001A03D3.quest_desc: [
		"Lleva energía entre las máquinas que la hacen y las que la necesitan.",
		"Cómo: hierro + redstone. Lleva FE entre máquinas."
	]
	quest.42000000001A03D3.title: "Tubo de energía"
	quest.42000000001A03D4.quest_desc: [
		"Lleva químicos entre las máquinas que los manejan.",
		"Cómo: tubos de hierro + redstone en JEI. Uso agachado de la llave inglesa para marcar los lados que extraen; clic derecho en uno para los filtros. El capítulo de tubos es la escalera completa."
	]
	quest.42000000001A03D4.title: "Tubo de gas"
	quest.42000000001A03D5.quest_desc: [
		"Un tubo, muchas tareas.",
		"Cómo: tubos de hierro + redstone en JEI. Uso agachado de la llave inglesa para marcar los lados que extraen; clic derecho en uno para los filtros. El capítulo de tubos es la escalera completa."
	]
	quest.42000000001A03D5.title: "Tubo universal"
	quest.42000000001A03D6.quest_desc: [
		"Usa agachado un lado del tubo para que extraiga de una máquina, o para cortarlo.",
		"Cómo: dos pedernales y dos palos. Uso agachado en un lado del tubo junto a una máquina para que extraiga, otra vez para cortarlo; clic derecho en un lado que extrae para los filtros."
	]
	quest.42000000001A03D6.title: "Llave inglesa de tubos"
	quest.42000000001A03D7.quest_desc: [
		"Mejora de velocidad para un tubo.",
		"Cómo: tubos de hierro + redstone en JEI. Uso agachado de la llave inglesa para marcar los lados que extraen; clic derecho en uno para los filtros. El capítulo de tubos es la escalera completa."
	]
	quest.42000000001A03D7.title: "Mejora básica"
	quest.42000000001A03D8.quest_desc: [
		"Encájala en un tubo para mover más por tick.",
		"Cómo: tubos de hierro + redstone en JEI. Uso agachado de la llave inglesa para marcar los lados que extraen; clic derecho en uno para los filtros. El capítulo de tubos es la escalera completa."
	]
	quest.42000000001A03D8.title: "Mejora mejorada"
	quest.42000000001A03D9.quest_desc: [
		"Una mejora más fuerte, para una línea con mucha carga.",
		"Cómo: tubos de hierro + redstone en JEI. Uso agachado de la llave inglesa para marcar los lados que extraen; clic derecho en uno para los filtros. El capítulo de tubos es la escalera completa."
	]
	quest.42000000001A03D9.title: "Mejora avanzada"
	quest.42000000001A03DA.quest_desc: [
		"El nivel más alto de caudal de Pipez.",
		"Cómo: tubos de hierro + redstone en JEI. Uso agachado de la llave inglesa para marcar los lados que extraen; clic derecho en uno para los filtros. El capítulo de tubos es la escalera completa."
	]
	quest.42000000001A03DA.title: "Mejora definitiva"
	quest.42000000001A03DB.quest_desc: [
		"Quita los topes de caudal de Pipez.",
		"Cómo: solo creativo; Pipez no tiene receta de supervivencia. Opcional."
	]
	quest.42000000001A03DB.title: "Mejora infinita"
	quest.42000000001A03DC.quest_desc: [
		"Define qué objetos acepta o ignora un extremo del tubo.",
		"Cómo: tubos de hierro + redstone en JEI. Uso agachado de la llave inglesa para marcar los lados que extraen; clic derecho en uno para los filtros. El capítulo de tubos es la escalera completa."
	]
	quest.42000000001A03DC.title: "Herramienta de filtro"
	quest.42000000001A03DD.quest_desc: [
		"El transportador original. Lento, barato y siempre útil.",
		"Cómo: cinco hierros alrededor de un cofre. Ponlo bajo un Bastidor del telar o un Barril de tensión (extrae hacia ABAJO)."
	]
	quest.42000000001A03DD.title: "Tolva de repuesto (Tubos)"
	quest.42000000001A03DE.quest_desc: [
		"Línea de soltadores para la logística.",
		"Cómo: roca alrededor de redstone."
	]
	quest.42000000001A03DE.title: "Línea de soltadores"
	quest.42000000001A03DF.quest_desc: [
		"Dispara o coloca lo que tenga cargado al recibir una señal.",
		"Cómo: roca, arco y redstone."
	]
	quest.42000000001A03DF.title: "Línea de dispensadores"
	quest.42000000001A03E0.quest_desc: [
		"Lee lo lleno que está un contenedor y suelta una señal.",
		"Cómo: cuarzo del Nether, antorcha de redstone, piedra. El cuarzo se criba de la arena de almas; no hace falta ir al Nether."
	]
	quest.42000000001A03E0.title: "Comparador (Tubos)"
	quest.42000000001A03E1.quest_desc: [
		"El observador lee el pulso.",
		"Cómo: roca, redstone y cuarzo del Nether."
	]
	quest.42000000001A03E1.title: "Línea de observadores"
	quest.42000000001A03E2.quest_desc: [
		"Una fuente de señal siempre activa, o un inversor junto a una palanca.",
		"Cómo: redstone sobre un palo."
	]
	quest.42000000001A03E2.title: "Antorcha de redstone"
	quest.42000000001A03E3.quest_desc: [
		"El repetidor temporiza el circuito.",
		"Cómo: antorcha de redstone, redstone, piedra. El capítulo de tubos lo usa para los relojes."
	]
	quest.42000000001A03E3.title: "Repetidor (Tubos)"
	quest.42000000001A03E4.quest_desc: [
		"Si un proyectil lo golpea, suelta una señal según la fuerza.",
		"Cómo: redstone alrededor del heno. El heno son tres trigos."
	]
	quest.42000000001A03E4.title: "Diana"
	quest.42000000001A03E5.quest_desc: [
		"Lee el cielo y da señal según la luz o la hora.",
		"Cómo: cristal, cuarzo del Nether, losas de madera."
	]
	quest.42000000001A03E5.title: "Sensor de luz solar (Tubos)"
	quest.42000000001A03E6.quest_desc: [
		"Sujeta un libro y da señal cuando se pasa una página.",
		"Cómo: losas de madera alrededor de una librería."
	]
	quest.42000000001A03E6.title: "Atril (Tubos)"
	quest.42000000001A03E7.quest_desc: [
		"Señala mientras está abierto, como un cofre con un cable trampa.",
		"Cómo: gancho de cable trampa más un cofre."
	]
	quest.42000000001A03E7.title: "Cofre trampa"
	quest.42000000001A03E8.quest_desc: [
		"Carga una cinta, o saca objetos de ella, según hacia dónde mire.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001A03E8.title: "Embudo de Create"
	quest.42000000001A03E9.quest_desc: [
		"Un embudo que puede filtrar lo que mueve.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001A03E9.title: "Embudo de latón"
	quest.42000000001A03EA.quest_desc: [
		"Deja caer objetos en línea recta hacia abajo, entre pisos.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001A03EA.title: "Conducto (Tubos)"
	quest.42000000001A03EB.quest_desc: [
		"Un conducto que puede filtrar objetos y retenerlos.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001A03EB.title: "Conducto inteligente"
	quest.42000000001A03EC.quest_desc: [
		"Clasifica y mueve objetos, con prioridad configurable por cara.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000001A03EC.title: "Logístico Mek"
	quest.42000000001A03ED.quest_desc: [
		"Mueve fluidos con presión, así que sube tan fácil como baja.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000001A03ED.title: "Tubería Mek"
	quest.42000000001A03EE.quest_desc: [
		"Lleva energía entre máquinas, con varios niveles de caudal.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000001A03EE.title: "Cable Mek"
	quest.42000000001A03EF.quest_desc: [
		"Mueve químicos y gases por una línea sellada.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000001A03EF.title: "Tubo Mek"
	quest.42000000001A03F0.quest_desc: [
		"Una línea más rápida para mover objetos por una plataforma ajetreada.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000001A03F0.title: "Transportador avanzado"
	quest.42000000001A03F1.quest_desc: [
		"Aún más rápido, para una red que ya superó lo básico.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000001A03F1.title: "Transportador de élite"
	quest.42000000001A03F2.quest_desc: [
		"La línea de objetos más rápida que hay, para una plataforma al máximo.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000001A03F2.title: "Transportador definitivo"
	quest.42000000001A03F3.quest_desc: [
		"La línea de energía de mayor caudal, para salas de maquinaria pesada.",
		"Cómo: capítulo Factoría Mekanism — trozos de mena del cedazo, y luego la línea de fábrica."
	]
	quest.42000000001A03F3.title: "Cable definitivo"
	quest.42000000001B03F4.quest_desc: [
		"Lista cada espíritu que puedes vincular y lo que necesita.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: un libro y Semillas de sueño de demonio, sin forma. Léelo; el Fuego espiritual es lo siguiente."
	]
	quest.42000000001B03F4.title: "Diccionario de espíritus"
	quest.42000000001B03F5.quest_desc: [
		"Arde en violeta y nunca se propaga. Sirve para encender rituales.",
		"Cómo: enciende el Fuego espiritual como muestra el Diccionario de los espíritus (¡Arde!), luego deja caer andesita dentro."
	]
	quest.42000000001B03F5.title: "Fuego de espíritus (Otromundo)"
	quest.42000000001B03F6.quest_desc: [
		"Señala el mineral enterrado o las estructuras ocultas cercanas.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03F6.title: "Vara de adivinación"
	quest.42000000001B03F7.quest_desc: [
		"Quita la tiza ritual del suelo cuando termines.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03F7.title: "Cepillo"
	quest.42000000001B03F8.quest_desc: [
		"Crece hasta ser un árbol que no pertenece a este mundo.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03F8.title: "Brote del Otromundo"
	quest.42000000001B03F9.quest_desc: [
		"Madera de un árbol extraño, usada en rituales de vinculación.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03F9.title: "Tronco del Otromundo"
	quest.42000000001B03FA.quest_desc: [
		"Sostiene una ofrenda mientras dura un ritual de vinculación.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03FA.title: "Cuenco de sacrificio"
	quest.42000000001B03FB.quest_desc: [
		"Un cuenco dorado que acelera el ritual en el que se usa.",
		"Cómo: oro alrededor de un cuenco de sacrificio. El diccionario nombra el ritual."
	]
	quest.42000000001B03FB.title: "Cuenco de oro"
	quest.42000000001B03FC.quest_desc: [
		"Un contrato sin firmar, a la espera del nombre de un espíritu.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03FC.title: "Libro de vinculación vacío"
	quest.42000000001B03FD.quest_desc: [
		"Vincula la clase más débil de espíritu, un buen primer intento.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03FD.title: "Libro de Foliot"
	quest.42000000001B03FE.quest_desc: [
		"Vincula un espíritu de fuerza media, un trabajo más fuerte que un foliot.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03FE.title: "Libro de Djinni"
	quest.42000000001B03FF.quest_desc: [
		"Vincula un espíritu feroz. El ritual pide más preparación.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B03FF.title: "Libro de Afrit"
	quest.42000000001B0400.quest_desc: [
		"Vincula al espíritu más fuerte del diccionario.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0400.title: "Libro de Marid"
	quest.42000000001B0401.quest_desc: [
		"Un foco que ayuda a un ritual a mantener su forma.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0401.title: "Gema sintonizada con espíritus"
	quest.42000000001B0402.quest_desc: [
		"Mineral de más allá de este mundo, que se funde en Iesnium.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0402.title: "Iesnium en bruto"
	quest.42000000001B0403.quest_desc: [
		"Un metal que solo existe al otro lado.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0403.title: "Lingote de Iesnium"
	quest.42000000001B0404.quest_desc: [
		"Envía mineros espirituales ya vinculados al Otromundo a cavar.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0404.title: "Pozo minero dimensional"
	quest.42000000001B0405.quest_desc: [
		"El espíritu más débil, puesto a minar bajo tierra.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0405.title: "Minero Foliot"
	quest.42000000001B0406.quest_desc: [
		"Enlaza los frascos de almacenamiento de espíritus en una sola red en la que buscar.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0406.title: "Controlador de almacén (Otromundo)"
	quest.42000000001B0407.quest_desc: [
		"Atrae a ciertos espíritus hacia un círculo ritual.",
		"Cómo: criba, o amatista en ciernes si cultivas una hilera de geodas. Occultism quiere esquirlas."
	]
	quest.42000000001B0407.title: "Foco de amatista"
	quest.42000000001B0408.quest_desc: [
		"Se funde para cuencos de oro y otro equipo ritual.",
		"Cómo: funde oro en bruto / arenilla de oro. Captura más rara del cedazo."
	]
	quest.42000000001B0408.title: "Reserva de lingote de oro"
	quest.42000000001B0409.quest_desc: [
		"Páginas en blanco, listas para ser un libro de vinculación.",
		"Cómo: tres papeles más cuero. El papel es caña de azúcar."
	]
	quest.42000000001B0409.title: "Reserva de libros"
	quest.42000000001B040A.quest_desc: [
		"Tiñe la tiza ritual para marcar un círculo de invocación.",
		"Cómo: azul más rojo, o una flor morada. Occultism lo quiere."
	]
	quest.42000000001B040A.title: "Tinte morado"
	quest.42000000001B040B.quest_desc: [
		"Tiñe la tiza ritual, una marca más sencilla que el morado.",
		"Cómo: polvo de hueso en una cuadrícula, o una flor blanca."
	]
	quest.42000000001B040B.title: "Tinte blanco"
	quest.42000000001B040C.quest_desc: [
		"Tiñe la tiza ritual para un círculo más oscuro.",
		"Cómo: carbón vegetal o un saco de tinta (carbón vegetal más una botella de cristal)."
	]
	quest.42000000001B040C.title: "Tinte negro"
	quest.42000000001B040D.quest_desc: [
		"Suelo ritual, con una textura que los rituales parecen apreciar.",
		"Cómo: arena en un barril de Ex Deorum con agua de bruja. Las salas de verrugas de la fortaleza guardan un poco. Tres calaveras sobre arena de almas hacen un Wither."
	]
	quest.42000000001B040D.title: "Reserva de arena de almas (Otro mundo)"
	quest.42000000001B040E.quest_desc: [
		"Una capa de base para rituales que se inclinan hacia el fuego.",
		"Cómo: el Nether aquí es vacío, no terreno. Vierte lava en un barril de Ex Deorum con agua de bruja (un barril de agua sobre micelio; las esporas de micelio se criban de la tierra)."
	]
	quest.42000000001B040E.title: "Reserva de piedra del Nether (Otro mundo)"
	quest.42000000001B040F.quest_desc: [
		"Un marco oscuro y estable para un círculo ritual.",
		"Cómo: agua sobre una fuente de lava (o lava sobre agua). Conserva la fuente de lava."
	]
	quest.42000000001B040F.title: "Reserva de obsidiana (Otro mundo)"
	quest.42000000001B0410.quest_desc: [
		"Una ofrenda hacia la que algunos espíritus se sienten atraídos.",
		"Cómo: endermen, o el puesto de los Caminabordes en /clowder hub."
	]
	quest.42000000001B0410.title: "Reserva de perlas de ender (Otro mundo)"
	quest.42000000001B0411.quest_desc: [
		"Una ofrenda de alto valor para un ritual exigente.",
		"Cómo: criba grava con una malla de hierro o mejor, o mena de diamante en la Fractura de eco."
	]
	quest.42000000001B0411.title: "Reserva de diamantes"
	quest.42000000001B0412.quest_desc: [
		"Un libro de vinculación con un foliot ya sellado dentro.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0412.title: "Libro vinculado de Foliot"
	quest.42000000001B0413.quest_desc: [
		"Un libro de vinculación con un djinni ya sellado dentro.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0413.title: "Libro vinculado de Djinni"
	quest.42000000001B0414.quest_desc: [
		"Un libro de vinculación con un afrit ya sellado dentro.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0414.title: "Libro vinculado de Afrit"
	quest.42000000001B0415.quest_desc: [
		"Un libro de vinculación con un marid ya sellado dentro.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0415.title: "Libro vinculado de Marid"
	quest.42000000001B0416.quest_desc: [
		"Una muestra de veta, que merece fundirse cuando encuentres más.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0416.title: "Mena de Iesnium"
	quest.42000000001B0417.quest_desc: [
		"Un afrit enviado a lo hondo a minar donde los espíritus menores no van.",
		"Cómo: Diccionario de espíritus, luego Fuego de espíritus y cuencos. El capítulo Otromundo nombra los ritos."
	]
	quest.42000000001B0417.title: "Afrit minero de las profundidades"
	quest.42000000001C0418.quest_desc: [
		"Gírala a mano cuando todavía no gira nada más.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0418.title: "Manivela (Relojería)"
	quest.42000000001C0419.quest_desc: [
		"Lleva la rotación de una máquina a la siguiente.",
		"Cómo: aleación de andesita en una receta de corte / de crafteo, listada en JEI."
	]
	quest.42000000001C0419.title: "Reserva de ejes"
	quest.42000000001C041A.quest_desc: [
		"El engranaje muerde el eje.",
		"Cómo: eje + tablas."
	]
	quest.42000000001C041A.title: "Reserva de engranajes"
	quest.42000000001C041B.quest_desc: [
		"Engrana en ángulo y cambia la velocidad de giro.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C041B.title: "Engranaje grande (Relojería)"
	quest.42000000001C041C.quest_desc: [
		"Lleva la rotación a la vuelta de la esquina sin perder velocidad.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C041C.title: "Caja de engranajes (Relojería)"
	quest.42000000001C041D.quest_desc: [
		"Activa un modo de la máquina.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C041D.title: "Embrague (Relojería)"
	quest.42000000001C041E.quest_desc: [
		"Invierte el sentido de rotación con un pulso de redstone.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C041E.title: "Cambio de marchas (Relojería)"
	quest.42000000001C041F.quest_desc: [
		"Envía la rotación muy lejos sin un muro de ejes.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C041F.title: "Transmisión de cadena"
	quest.42000000001C0420.quest_desc: [
		"Una transmisión de cadena que puede invertir o pararse a una orden.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0420.title: "Cadena ajustable"
	quest.42000000001C0421.quest_desc: [
		"Gira con el agua que cae, despacio pero firme.",
		"Cómo: ocho tablas alrededor de un eje. Hace falta un flujo de agua al lado."
	]
	quest.42000000001C0421.title: "Rueda de agua (Relojería)"
	quest.42000000001C0422.quest_desc: [
		"Rueda más grande, más fuerza de giro con la misma corriente.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0422.title: "Rueda grande"
	quest.42000000001C0423.quest_desc: [
		"Convierte las velas en rotación, viento de la plataforma incluido.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0423.title: "Soporte de molino de viento (Relojería)"
	quest.42000000001C0424.quest_desc: [
		"Gira estructuras enteras construidas encima.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0424.title: "Soporte mecánico (Relojería)"
	quest.42000000001C0425.quest_desc: [
		"Gira una estructura según un horario, como la aguja de un reloj.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0425.title: "Soporte de relojería"
	quest.42000000001C0426.quest_desc: [
		"Convierte el vapor de la caldera en un giro constante.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0426.title: "Motor de vapor"
	quest.42000000001C0427.quest_desc: [
		"Suelta el exceso de presión con un sonido que oyes en toda la plataforma.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0427.title: "Silbato de vapor"
	quest.42000000001C0428.quest_desc: [
		"Calienta las cubetas lo bastante para el alto horno y las pociones.",
		"Cómo: fabrica un quemador de blaze vacío y úsalo sobre un blaze de una fortaleza del Nether, después de la obsidiana de Garra."
	]
	quest.42000000001C0428.title: "Quemador de blaze"
	quest.42000000001C0429.quest_desc: [
		"Recoge lo que cae dentro, para mezclar o prensar.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C0429.title: "Cubeta (Relojería)"
	quest.42000000001C042A.quest_desc: [
		"Mezcla recetas al por mayor, rápido.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
	quest.42000000001C042A.title: "Mezclador mecánico (Relojería)"
	quest.42000000001C042B.quest_desc: [
		"Prensa lingotes en láminas y compacta lo que hay en una cubeta.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
