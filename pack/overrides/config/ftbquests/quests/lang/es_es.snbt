	quest.42000000001F04D2.quest_desc: [
		"Reúne los paquetes partidos en pedidos completos.",
		"Cómo: crafteo de Create en JEI (mesa de trabajo, prensa, mezclador o desplegador). La aleación de andesita y una rueda de agua empiezan la línea."
	]
