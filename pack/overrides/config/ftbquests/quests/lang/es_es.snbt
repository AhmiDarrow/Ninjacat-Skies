	quest.42000000001F04C6.quest_desc: [
		"Guarda un lote de recetas de paquete para volver a usarlas.",
		"Cómo: componente de paquete, luego Empaquetador / Codificador. Hace falta una red de AE2 para la pieza ME."
	]
	quest.42000000001F04C6.title: "Portarrecetas"
	quest.42000000001F04C7.quest_desc: [
		"Copia los ajustes de un bloque a otro y ahorra muchos clics.",
		"Cómo: componente de paquete, luego Empaquetador / Codificador. Hace falta una red de AE2 para la pieza ME."
	]
	quest.42000000001F04C7.title: "Clonador de ajustes"
	quest.42000000001F04C8.quest_desc: [
		"Llena un paquete de fluido en vez de objetos.",
		"Cómo: componente de paquete, luego Empaquetador / Codificador. Hace falta una red de AE2 para la pieza ME."
	]
	quest.42000000001F04C8.title: "Llenador de paquetes de fluido"
	quest.42000000001F04C9.quest_desc: [
