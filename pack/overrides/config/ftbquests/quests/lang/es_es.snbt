	chapter.310000000000002B.chapter_subtitle: [
		"Trozos del viejo mundo suben a la deriva hasta tu plataforma. Llega a ellos antes de que se destejan."
	]
	chapter.310000000000002B.title: "Pecios a la deriva"
	quest.42000000002B0801.quest_desc: [
		"Cuando Tierra está en tensión, trozos del viejo mundo suben de vez en cuando hasta tu plataforma y se enganchan en tu trama. El custodio avisa a todo el Clowder cuando llega uno.",
		"No se quedan: un pecio aguanta un rato del tiempo en línea de tu Clowder y luego se desteje de vuelta al vacío. Nadie cae, y nada de lo que ganaste se pierde."
	]
	quest.42000000002B0801.title: "Algo a la deriva"
	quest.42000000002B0802.quest_desc: [
		"Ponte en el borde de tu plataforma, mira el pecio y usa una Bobina de amarre: un puente de hilo se tiende solo, subiendo en medios pasos.",
		"Si te caes, el hilo te atrapa, por tres corazones. El vacío es el paisaje, no el castigo."
	]
	quest.42000000002B0802.title: "Cruza el vacío"
	quest.42000000002B0803.quest_desc: [
		"Cada pecio pide una cosa: abre su cofre del corazón, rompe sus generadores, reenhebra sus pilares, camina hasta casa con un eco, o aguanta la costura.",
		"Termínalo y todos los que pongan el pie en él reciben Trama rescatada y un Sello. El Bastidor del recuperador convierte la trama en bobinas, señuelos, llaves y adornos."
	]
	quest.42000000002B0803.title: "Salvamento"
	quest.42000000002B0804.quest_desc: [
		"El Atlas de pecios guarda los lugares de cada tribu que has terminado: nueve Hebras por seis clases de lugar. Una columna llena, una fila llena, todas las estampas: cada cosa da una ventaja pequeña y permanente.",
		"Las páginas traen su relato en el Códice. Las páginas de pista halladas en cofres abren salas ocultas. Abre el Atlas de pecios para marcar esto."
	]
	quest.42000000002B0804.title: "El Atlas"
	quest.42000000002B0805.quest_desc: [
		"Trae cinco Sellos del pecio: cinco pecios terminados, por cualquiera de tu Clowder.",
		"Repetible: entrégalos tantas veces como quieras.",
		"Cómo: termina la tarea de un pecio a la deriva. Todos los que pongan el pie en él reciben un Sello."
	]
	quest.42000000002B0805.title: "Cinco sellos"
	quest.42000000002B0806.quest_desc: [
		"Rompe tres generadores deshilachados y entrega sus núcleos.",
		"Repetible: entrégalos tantas veces como quieras.",
		"Cómo: rompe un generador deshilachado en un pecio a la deriva; cada uno suelta su núcleo."
	]
	quest.42000000002B0806.title: "Núcleos deshilachados"
	quest.42000000002B0807.quest_desc: [
		"Un fragmento de un Remanente remendado. Entrégalo.",
		"Repetible: entrégalos tantas veces como quieras.",
		"Cómo: abre la grieta sellada de un Bastión con una Llave de trama y remienda el Remanente de dentro."
	]
	quest.42000000002B0807.title: "Fragmento de grieta"
	quest.42000000002B0808.quest_desc: [
		"Todos los núcleos de una Hebra. Los señuelos de esa tribu cuestan la mitad, sus pecios llegan un poco más a menudo y su estandarte es tuyo."
	]
	quest.42000000002B0808.title: "Una columna entera"
	quest.42000000002B0809.quest_desc: [
		"Una clase de lugar en las nueve tribus. Sus salas ocultas quedan siempre abiertas."
	]
	quest.42000000002B0809.title: "Una fila entera"
	quest.42000000002B080A.quest_desc: [
		"Termina un pecio de cada modificador. Tus pecios aguantan un cuarto más."
	]
	quest.42000000002B080A.title: "Seis estampas"
	quest.42000000002B080B.quest_desc: [
		"Veinticinco páginas llenas."
	]
	quest.42000000002B080B.title: "Medio Atlas"
	quest.42000000002B080C.quest_desc: [
		"Una Llave de trama cortada para la Hebra de ese pecio abre la grieta sellada de un Bastión. Dentro, algo pequeño y deshilachado viste la forma de un Guardián."
	]
	quest.42000000002B080C.title: "Hacia la grieta"
	quest.42000000002B080D.quest_desc: [
		"Remienda los nueve Remanentes. Las Llaves de trama cuestan la mitad."
	]
	quest.42000000002B080D.title: "Todos los Remanentes"
	quest.42000000002B080E.quest_desc: [
		"Todas las cincuenta y cuatro páginas. En algún lugar bajo los Skies, el corazón del viejo mundo empieza a derivar hacia ti."
	]
	quest.42000000002B080E.title: "Cada página"
	quest.42000000002B080F.quest_desc: [
		"Ponte en el corazón del viejo mundo y vuelve a enhebrarlo. No viene dos veces."
	]
	quest.42000000002B080F.title: "Corazón del tejido"
}
