		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D047F.title: "Terminal"
	quest.42000000001D0480.quest_desc: [
		"Fabrica directamente con lo que esté guardando la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0480.title: "Terminal de fabricación (Red)"
	quest.42000000001D0481.quest_desc: [
		"Escribe la receta que seguirá un patrón.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0481.title: "Codificación de patrón"
	quest.42000000001D0482.quest_desc: [
		"Muestra cada patrón que la red conoce ahora.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0482.title: "Acceso a patrones"
	quest.42000000001D0483.quest_desc: [
		"Suministra patrones a las máquinas que fabrican solas.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0483.title: "Proveedor de patrones (Red)"
	quest.42000000001D0484.quest_desc: [
		"Ensambla lo fabricado siguiendo un patrón guardado.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0484.title: "Ensamblador molecular (Red)"
	quest.42000000001D0485.quest_desc: [
		"Un bloque de memoria que la red usa mientras fabrica.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0485.title: "Unidad de fabricación (Red)"
	quest.42000000001D0486.quest_desc: [
		"Acelera un solo trabajo de fabricación que corre por la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0486.title: "Acelerador de fabricación"
	quest.42000000001D0487.quest_desc: [
		"Añade memoria de fabricación a una unidad de fabricación.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0487.title: "Almacén de fabricación de 1k"
	quest.42000000001D0488.quest_desc: [
		"Más memoria de fabricación para trabajos más grandes.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0488.title: "Almacén de fabricación de 4k"
	quest.42000000001D0489.quest_desc: [
		"Un bloque serio de memoria de fabricación.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0489.title: "Almacén de fabricación de 16k"
	quest.42000000001D048A.quest_desc: [
		"Memoria de fabricación suficiente para los trabajos más grandes de la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D048A.title: "Almacén de fabricación de 64k"
	quest.42000000001D048B.quest_desc: [
		"Memoria de fabricación de archivo, rara vez necesaria, pero ahí cuando lo es.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D048B.title: "Almacén de fabricación de 256k"
	quest.42000000001D048C.quest_desc: [
		"Emite redstone en cuanto un objeto vigilado cruza una cantidad.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D048C.title: "Emisor de nivel (Red)"
	quest.42000000001D048D.quest_desc: [
		"Coloca bloques de la red en el mundo.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D048D.title: "Plano de formación (Red)"
	quest.42000000001D048E.quest_desc: [
		"Rompe bloques y arrastra lo que cae hasta la red.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D048E.title: "Plano de aniquilación (Red)"
	quest.42000000001D048F.quest_desc: [
		"Lleva un canal de la red a través de un corte en el tendido de cable.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D048F.title: "Túnel P2P"
	quest.42000000001D0490.quest_desc: [
		"Pliega un trocito de espacio en una célula portátil.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0490.title: "Espacial 2"
	quest.42000000001D0491.quest_desc: [
		"Consulta el almacén de la red desde cualquier sitio, con un amplificador cerca.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0491.title: "Terminal inalámbrico (Red)"
	quest.42000000001D0492.quest_desc: [
		"Fabrica desde la red sin volver andando hasta un terminal.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0492.title: "Fabricación inalámbrica"
	quest.42000000001D0493.quest_desc: [
		"Dispara bolas de materia; cárgalo antes de necesitarlo.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0493.title: "Cañón de materia"
	quest.42000000001D0494.quest_desc: [
		"Un bloque transparente para carcasas de controlador y tendidos de cable.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0494.title: "Vidrio de cuarzo"
	quest.42000000001D0495.quest_desc: [
		"Vidrio que brilla solo, sin antorcha.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0495.title: "Cuarzo vibrante"
	quest.42000000001D0496.quest_desc: [
		"Un bloque de almacenamiento sólido, cuatro cristales condensados en uno.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0496.title: "Bloque de Fluix"
	quest.42000000001D0497.quest_desc: [
		"Divide una célula de almacenamiento en varios depósitos más pequeños.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
	quest.42000000001D0497.title: "Mesa de células"
	quest.42000000001E0498.quest_desc: [
		"Arcilla y polvo de hueso, un paso hacia las herramientas de porcelana.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: bola de arcilla + polvo de hueso, sin forma. La arcilla sale del Barril de tensión."
	]
	quest.42000000001E0498.title: "Arcilla de porcelana (Oficio del vacío)"
	quest.42000000001E0499.quest_desc: [
		"Un cubo más ligero, más suave con el presupuesto de grava del principio.",
		"Cómo: da forma a la arcilla de porcelana en un cubo sin cocer y luego fúndelo."
	]
	quest.42000000001E0499.title: "Cubo de porcelana"
	quest.42000000001E049A.quest_desc: [
		"Funde bloques hasta líquido sobre un fuego.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E049A.title: "Crisol de porcelana (Oficio del vacío)"
	quest.42000000001E049B.quest_desc: [
		"La primera malla del cedazo; lenta, pero funciona.",
		"Cómo: nueve cuerdas en un 3x3. El puesto de los Cantores de grava vende la malla de Hilo (cuerda) del Telar del vacío, que criba igual."
	]
	quest.42000000001E049B.title: "Malla de cuerda (Oficio del vacío)"
	quest.42000000001E049C.quest_desc: [
		"Criba más rápido que la cuerda, y la mejora vale la pena.",
		"Cómo: cuatro pedernales y cinco cuerdas en damero. El pedernal sale de la grava, o de Hilo + grava."
	]
	quest.42000000001E049C.title: "Malla de pedernal (Oficio del vacío)"
	quest.42000000001E049D.quest_desc: [
		"Una malla intermedia y sólida, para cribar con constancia.",
		"Cómo: cuatro lingotes de hierro y cinco cuerdas en damero. Ningún puesto lo vende."
	]
	quest.42000000001E049D.title: "Malla de hierro (Voidcraft)"
	quest.42000000001E049E.quest_desc: [
		"Saca botines más raros que el hierro.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E049E.title: "Malla de oro (Voidcraft)"
	quest.42000000001E049F.quest_desc: [
		"Criba lo bastante rápido para mantener alimentada una línea de tolvas.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E049F.title: "Malla de diamante (Voidcraft)"
	quest.42000000001E04A0.quest_desc: [
		"La mejor malla que un cedazo podrá sostener jamás.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04A0.title: "Malla de netherita (Voidcraft)"
	quest.42000000001E04A1.quest_desc: [
		"Hilada de cuerda, la fibra propia del Telar.",
		"Cómo: cuatro cuerdas → dos estambres. Barril de tensión: cuerda + perla. Cuatro Pelusas del telar."
	]
	quest.42000000001E04A1.title: "Reserva de Hilaza del vacío"
	quest.42000000001E04A2.quest_desc: [
		"La puerta blanda del Telar: los postes, las prensas y los controladores quieren uno.",
		"Cómo: anillo de Hilaza del vacío alrededor de una bola de slime."
	]
	quest.42000000001E04A2.title: "Reserva de Nudo vinculante"
	quest.42000000001E04A3.quest_desc: [
		"La versión del Telar del vacío de la malla básica de cedazo.",
		"Cómo: cuerda alrededor de estambre. El puesto de los Cantores de grava vende una."
	]
	quest.42000000001E04A3.title: "Malla de Hilo (cuerda)"
	quest.42000000001E04A4.quest_desc: [
		"Una malla del Telar del vacío, un paso por encima de la cuerda lisa.",
		"Cómo: pedernal alrededor de una malla de Hilo (cuerda)."
	]
	quest.42000000001E04A4.title: "Malla de Hilo (pedernal)"
	quest.42000000001E04A5.quest_desc: [
		"Una malla del Telar del vacío, hecha para un rendimiento constante.",
		"Cómo: hierro alrededor de una malla de Hilo (pedernal). Aquí empieza el Filamento de Hebra."
	]
	quest.42000000001E04A5.title: "Malla de Hilo (hierro)"
	quest.42000000001E04A6.quest_desc: [
		"Rompe la arenilla un paso más fina: de roca a grava, de grava a arena, de arena a polvo.",
		"Cómo: roca + palos. Rompe arenilla en grava, arena y polvo."
	]
	quest.42000000001E04A6.title: "Martillo de huso (Voidcraft)"
	quest.42000000001E04A7.quest_desc: [
		"Arranca hojas para sacar retoños y gusanos de seda.",
		"Cómo: cuatro palos. El puesto de los Cantores de grava vende uno."
	]
	quest.42000000001E04A7.title: "Cayado de huso"
	quest.42000000001E04A8.quest_desc: [
		"El bastidor de cedazo del Telar: tensa una malla sobre él y aliméntalo con arenilla.",
		"Cómo: tablas alrededor de un Nudo vinculante. Tensa una malla, mete arenilla con una tolva y ponlo sobre una tolva."
	]
	quest.42000000001E04A8.title: "Bastidor del telar"
	quest.42000000001E04A9.quest_desc: [
		"El agua y la tierra se vuelven arcilla; la cuerda y una perla se vuelven estambre.",
		"Cómo: tablas, cuerda e Hilaza del vacío. Vierte agua (el cubo vuelve), añade tierra → arcilla."
	]
	quest.42000000001E04A9.title: "Barril de tensión (Voidcraft)"
	quest.42000000001E04AA.quest_desc: [
		"Nueve bloques de tierra plegados en uno, para el viaje hacia arriba.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04AA.title: "Tierra comprimida"
	quest.42000000001E04AB.quest_desc: [
		"Nueve rocas apretadas, baratas y sin fin.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04AB.title: "Roca comprimida (Voidcraft)"
	quest.42000000001E04AC.quest_desc: [
		"Nueve gravas compactadas; un cedazo comprimido las toma enteras.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04AC.title: "Grava comprimida"
	quest.42000000001E04AD.quest_desc: [
		"Nueve bloques de arena prensados en uno, para acarrear.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04AD.title: "Arena comprimida"
	quest.42000000001E04AE.quest_desc: [
		"Nueve bloques de polvo prensados, por la misma razón.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04AE.title: "Polvo comprimido"
	quest.42000000001E04AF.quest_desc: [
		"Piedra del Nether compactada, para un inventario más ligero.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04AF.title: "Piedra del Nether comprimida"
	quest.42000000001E04B0.quest_desc: [
		"Piedra del End compactada, útil cuando haya que alimentar el vacío.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04B0.title: "Piedra del End comprimida"
	quest.42000000001E04B1.quest_desc: [
		"Pizarra profunda compactada, nueve en uno, y sigue siendo solo piedra.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04B1.title: "Pizarra profunda comprimida"
	quest.42000000001E04B2.quest_desc: [
		"Revienta de golpe una pila entera de bloques comprimidos.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04B2.title: "Martillo comprimido"
	quest.42000000001E04B3.quest_desc: [
		"Un martillo más débil para romper bloques comprimidos.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04B3.title: "Martillo de hierro comprimido"
	quest.42000000001E04B4.quest_desc: [
		"Un cedazo ancho: varios montones de grava a la vez.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04B4.title: "Cedazo comprimido (Voidcraft)"
	quest.42000000001E04B5.quest_desc: [
		"Criba igual que el de roble; solo cambia la veta.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04B5.title: "Cedazo de abedul"
	quest.42000000001E04B6.quest_desc: [
		"Fermenta igual que cualquier otro barril.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04B6.title: "Barril de abedul"
	quest.42000000001E04B7.quest_desc: [
		"Funde bloques igual que cualquier otro crisol.",
		"Cómo: cedazo, martillo, crisol o barril de Ex Deorum. Ajusta la malla a la arenilla."
	]
	quest.42000000001E04B7.title: "Crisol de abedul"
	quest.42000000001E04B8.quest_desc: [
		"La moneda de la Hebra; gánala, gástala y no la malgastes.",
		"Cómo: recompensas de misiones, tierra con malla de pedernal en un Bastidor del telar, alijos del custodio."
	]
	quest.42000000001E04B8.title: "Reserva de Hilo deshilachado"
	quest.42000000001E04B9.quest_desc: [
		"Páginas de archivo y notas.",
		"Cómo: asienta una Hebra en el Poste, o en el puesto de los Talladores de sellos en /clowder hub (8 Hilo). Clic derecho para leer; se guardan, no se gastan."
	]
	quest.42000000001E04B9.title: "Páginas del códice"
	quest.42000000001E04BA.quest_desc: [
		"Clic derecho y abre Empieza aquí. Acento grave (`): la lista de tareas. El libro no asigna misiones.",
		"Cómo: kit inicial / cofre del muelle. Clic derecho en el libro; el acento grave (`) es la lista de tareas."
	]
	quest.42000000001E04BA.title: "Códice de los Bigotes"
	quest.42000000001F04BB.quest_desc: [
		"El papel de dentro de un paquete, antes de sellarlo del todo.",
		"Las Nueve Tribus dejaron provisiones para el siguiente Clowder. Usa un alijo del custodio para desenvolver suministros al azar, o fabrica cuatro alijos pequeños en uno mediano y tres medianos en uno grande. Los sellos más grandes tienen más tiradas y un fondo de suministros más amplio; abrirlos por separado da más suministros básicos. Dentro no se esconden máquinas ni fichas de progreso, pero cada sello tiene una probabilidad pequeña de un Fragmento de Hilo y una muy pequeña de un Hilo de retorno entero; los sellos más grandes tienen mejores probabilidades.",
		"Cómo: lingotes de oro y tablas alrededor de un Ojo de ender. El primer crafteo de Packaged Auto."
	]
	quest.42000000001F04BB.title: "Componente de paquete"
	quest.42000000001F04BC.quest_desc: [
		"Una envoltura de paquete hecha, en cambio, alrededor de un patrón guardado.",
		"Cómo: componente de paquete, luego Empaquetador / Codificador. Hace falta una red de AE2 para la pieza ME."
	]
	quest.42000000001F04BC.title: "Componente de paquete ME"
	quest.42000000001F04BD.quest_desc: [
		"Sella objetos en un paquete para que la línea los mueva.",
		"Cómo: componente de paquete, luego Empaquetador / Codificador. Hace falta una red de AE2 para la pieza ME."
	]
	quest.42000000001F04BD.title: "Empaquetador (empaquetado)"
	quest.42000000001F04BE.quest_desc: [
