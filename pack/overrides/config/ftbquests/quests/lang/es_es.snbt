		"Cómo: componente de paquete, luego Empaquetador / Codificador. Hace falta una red de AE2 para la pieza ME."
	]
	quest.42000000001F04C9.title: "Objeto paquete"
	quest.42000000001F04CA.quest_desc: [
		"Mete mucho más en un solo paquete que el tipo básico.",
		"Cómo: componente de paquete, luego Empaquetador / Codificador. Hace falta una red de AE2 para la pieza ME."
	]
	quest.42000000001F04CA.title: "Paquete de volumen"
	quest.42000000001F04CB.quest_desc: [
		"Marca adónde debe llegar un intermediario de fabricación.",
		"Cómo: componente de paquete, luego Empaquetador / Codificador. Hace falta una red de AE2 para la pieza ME."
	]
	quest.42000000001F04CB.title: "Marcador de intermediario"
	quest.42000000001F04CC.quest_desc: [
		"Enlaza la línea de empaquetado con el telar digital.",
		"Cómo: Red de Huso — Certus de la arena, el controlador quiere un Nudo vinculante."
	]
