		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0483.title: "パターン供給器（ネットワーク）"
	quest.42000000001D0484.quest_desc: [
		"保存されたパターンに従って、製作したアイテムを組み立てる。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0484.title: "分子組立機（ネットワーク）"
	quest.42000000001D0485.quest_desc: [
		"製作のあいだネットワークが使うメモリの塊。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0485.title: "製作ユニット（ネットワーク）"
	quest.42000000001D0486.quest_desc: [
		"ネットワークを通る製作作業を一つ速める。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0486.title: "製作加速"
	quest.42000000001D0487.quest_desc: [
		"製作ユニットに製作メモリを足す。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0487.title: "1k 製作ストレージ"
	quest.42000000001D0488.quest_desc: [
		"より大きい作業のための製作メモリ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0488.title: "4k 製作ストレージ"
	quest.42000000001D0489.quest_desc: [
		"本格的な製作メモリの塊。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0489.title: "16k 製作ストレージ"
	quest.42000000001D048A.quest_desc: [
		"ネットワーク最大の作業に足りる製作メモリ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D048A.title: "64k 製作ストレージ"
	quest.42000000001D048B.quest_desc: [
		"保管級の製作メモリで、めったに要らないが、要るときにはそこにある。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D048B.title: "256k 製作ストレージ"
	quest.42000000001D048C.quest_desc: [
		"追跡中のアイテムが数を超えると、レッドストーンを出す。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D048C.title: "レベルエミッター（ネットワーク）"
	quest.42000000001D048D.quest_desc: [
		"ネットワークからブロックを世界へ置く。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D048D.title: "形成プレーン（ネットワーク）"
	quest.42000000001D048E.quest_desc: [
		"ブロックを壊し、落ちたものをネットワークへ引き込む。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D048E.title: "消滅プレーン（ネットワーク）"
	quest.42000000001D048F.quest_desc: [
		"ケーブルの切れ目を越えて、ネットワークのチャンネルを一つ運ぶ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D048F.title: "P2P トンネル"
	quest.42000000001D0490.quest_desc: [
		"空間の小さな一塊を、携帯セルへ折り込む。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0490.title: "空間 2"
	quest.42000000001D0491.quest_desc: [
		"近くに増幅器があれば、どこからでもネットワークの貯蔵を閲覧せよ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0491.title: "ワイヤレス端末（ネットワーク）"
	quest.42000000001D0492.quest_desc: [
		"端末まで歩いて戻らず、ネットワークから製作せよ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0492.title: "ワイヤレス製作"
	quest.42000000001D0493.quest_desc: [
		"マターボールを撃ち、必要になる前にチャージせよ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0493.title: "マターキャノン"
	quest.42000000001D0494.quest_desc: [
		"コントローラーの殻とケーブル配線のための透明ブロック。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0494.title: "クォーツガラス"
	quest.42000000001D0495.quest_desc: [
		"自分で光るガラスで、松明は要らない。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0495.title: "鮮やかなクォーツ"
	quest.42000000001D0496.quest_desc: [
		"固体の貯蔵ブロックで、結晶四つを一つに凝縮したもの。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0496.title: "フルーシュブロック"
	quest.42000000001D0497.quest_desc: [
		"収納セルを、いくつかの小さな枠に分ける。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001D0497.title: "セル作業台"
	quest.42000000001E0498.quest_desc: [
		"粘土と骨粉で、磁器の道具への一歩。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 粘土玉 + 骨粉、不定形。粘土は張力の樽から。"
	]
	quest.42000000001E0498.title: "磁器粘土（虚空工芸）"
	quest.42000000001E0499.quest_desc: [
		"より軽いバケツで、序盤の砂利の予算にやさしい。",
		"手順: 磁器粘土を未焼成のバケツに成形し、それから製錬する。"
	]
	quest.42000000001E0499.title: "陶器のバケツ"
	quest.42000000001E049A.quest_desc: [
		"火の上でブロックを溶かして液体にする。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E049A.title: "磁器のるつぼ（虚空工芸）"
	quest.42000000001E049B.quest_desc: [
		"ふるいの最初の網で、遅いがちゃんと働く。",
		"手順: 紐を九本、3x3に。砂利歌いの屋台が虚空の織機の糸の網（紐）を売る。ふるい方は同じ。"
	]
	quest.42000000001E049B.title: "紐の網（虚空工芸）"
	quest.42000000001E049C.quest_desc: [
		"紐より速くふるい、強化する価値がある。",
		"手順: 火打石四つと紐五つを市松に。火打石は砂利から、または糸 + 砂利。"
	]
	quest.42000000001E049C.title: "火打石の網（虚空工芸）"
	quest.42000000001E049D.quest_desc: [
		"安定してふるうための、しっかりした中間の網。",
		"手順: 鉄インゴット四つと紐五つを市松に。どの屋台も売っていない。"
	]
	quest.42000000001E049D.title: "鉄の網（Voidcraft）"
	quest.42000000001E049E.quest_desc: [
		"鉄より珍しいものが落ちる。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E049E.title: "金の網（Voidcraft）"
	quest.42000000001E049F.quest_desc: [
		"ホッパーの列を養える速さでふるう。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E049F.title: "ダイヤモンドの網（Voidcraft）"
	quest.42000000001E04A0.quest_desc: [
		"ふるいが抱えられる最高の網。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04A0.title: "ネザライトの網（Voidcraft）"
	quest.42000000001E04A1.quest_desc: [
		"紐から紡いだ、織機自身の繊維。",
		"手順: 紐四つ → 毛糸二つ。張力の樽：紐 + パール。織機の糸くず四つ。"
	]
	quest.42000000001E04A1.title: "虚空の毛糸の備蓄"
	quest.42000000001E04A2.quest_desc: [
		"織機の柔らかい門。柱もプレスもコントローラーも、一つを求める。",
		"手順: スライムボールを囲む虚空の毛糸の輪。"
	]
	quest.42000000001E04A2.title: "結束の結びの備蓄"
	quest.42000000001E04A3.quest_desc: [
		"基本のふるい網を、虚空の織機の流儀で。",
		"手順: 毛糸の周りに紐。砂利歌いの屋台で一つ売っている。"
	]
	quest.42000000001E04A3.title: "糸の網（紐）"
	quest.42000000001E04A4.quest_desc: [
		"虚空の織機の網。ただの紐より一段階上。",
		"手順: 糸の網（紐）の周りに火打石。"
	]
	quest.42000000001E04A4.title: "糸の網（火打石）"
	quest.42000000001E04A5.quest_desc: [
		"安定した産出のための、虚空の織機の網。",
		"手順: 糸の網（火打石）の周りに鉄。ストランド繊維はここから始まる。"
	]
	quest.42000000001E04A5.title: "糸の網（鉄）"
	quest.42000000001E04A6.quest_desc: [
		"砂粒を一段階細かく砕く。丸石は砂利へ、砂利は砂へ、砂は粉へ。",
		"手順: 丸石 + 棒。砂粒を砂利、砂、粉に砕く。"
	]
	quest.42000000001E04A6.title: "紡錘の槌（Voidcraft）"
	quest.42000000001E04A7.quest_desc: [
		"葉をこそぎ、苗木と蚕を得る。",
		"手順: 棒四つ。砂利歌いの屋台が一つ売る。"
	]
	quest.42000000001E04A7.title: "紡錘の鉤杖"
	quest.42000000001E04A8.quest_desc: [
		"織機のふるい枠。網を張り、砂粒を入れる。",
		"手順: 結束の結びの周りに板材。網を張り、ホッパーで砂粒を入れ、ホッパーの上に置く。"
	]
	quest.42000000001E04A8.title: "織機枠"
	quest.42000000001E04A9.quest_desc: [
		"水と土は粘土に。紐と真珠は毛糸に。",
		"手順: 板材、紐、虚空の毛糸。水を注ぐ（バケツは戻る）、土を足す → 粘土。"
	]
	quest.42000000001E04A9.title: "張力の樽（Voidcraft）"
	quest.42000000001E04AA.quest_desc: [
		"土ブロック九つを一つにたたんだ。上へ運ぶため。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04AA.title: "圧縮された土"
	quest.42000000001E04AB.quest_desc: [
		"丸石九つをぎゅっと詰めた。安くて尽きない。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04AB.title: "圧縮丸石（Voidcraft）"
	quest.42000000001E04AC.quest_desc: [
		"砂利九つを押し固めたもの。圧縮ふるいが丸ごと受け取る。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04AC.title: "圧縮された砂利"
	quest.42000000001E04AD.quest_desc: [
		"砂ブロック九つを一つにプレスした。運ぶため。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04AD.title: "圧縮された砂"
	quest.42000000001E04AE.quest_desc: [
		"粉ブロック九つを、同じ理由で押し固めた。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04AE.title: "圧縮されたダスト"
	quest.42000000001E04AF.quest_desc: [
		"インベントリを軽くするため、圧縮したネザーの石。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04AF.title: "圧縮されたネザーラック"
	quest.42000000001E04B0.quest_desc: [
		"エンドストーンを圧縮した。虚空に餌が要るときに役立つ。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04B0.title: "圧縮されたエンドストーン"
	quest.42000000001E04B1.quest_desc: [
		"深層岩を九対一で圧縮した。それでもただの石材。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04B1.title: "圧縮された深層岩"
	quest.42000000001E04B2.quest_desc: [
		"圧縮ブロックのスタックを、一度にまとめて叩き割る。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04B2.title: "圧縮ハンマー"
	quest.42000000001E04B3.quest_desc: [
		"圧縮ブロックを壊す、より弱いハンマー。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04B3.title: "鉄の圧縮ハンマー"
	quest.42000000001E04B4.quest_desc: [
		"幅の広いふるい。砂利の山を一度にいくつも。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04B4.title: "圧縮ふるい（Voidcraft）"
	quest.42000000001E04B5.quest_desc: [
		"オークと同じようにふるう。木目が違うだけ。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04B5.title: "シラカバのふるい"
	quest.42000000001E04B6.quest_desc: [
		"ほかのどの樽とも同じように発酵する。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04B6.title: "シラカバのバレル"
	quest.42000000001E04B7.quest_desc: [
		"ほかのどのるつぼとも同じようにブロックを溶かす。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000001E04B7.title: "シラカバのるつぼ"
	quest.42000000001E04B8.quest_desc: [
		"ストランドの通貨。稼いで、使って、無駄にしない。",
		"手順: クエスト報酬、織機枠に火打石の網を張った土、執事の蔵。"
	]
	quest.42000000001E04B8.title: "ほつれた糸の備蓄"
	quest.42000000001E04B9.quest_desc: [
		"書庫のページとメモ。",
		"手順: 柱にストランドを据えるか、 /clowder hub の印彫りの屋台で（糸 8）。右クリックで読む。消費せず、手元に残る。"
	]
	quest.42000000001E04B9.title: "写本のページ"
	quest.42000000001E04BA.quest_desc: [
		"右クリックして「ここから始める」を開く。グレーブ（`）：任務リスト。本はクエストを割り当てない。",
		"手順: 初期キット / 桟橋のチェスト。本を右クリックすると、グレイブ（`）が任務一覧。"
	]
	quest.42000000001E04BA.title: "ウィスカー写本"
	quest.42000000001F04BB.quest_desc: [
		"封をする前の、荷物の中の紙。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: エンダーアイの周りに金インゴットと板材。Packaged Auto の最初のクラフト。"
	]
	quest.42000000001F04BB.title: "荷物の部品"
	quest.42000000001F04BC.quest_desc: [
		"保存したパターンを芯にして組んだ、別の小包の包み。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04BC.title: "ME 小包部品"
	quest.42000000001F04BD.quest_desc: [
		"アイテムを小包に封じて、ラインが運べるようにする。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04BD.title: "包装機（包装）"
	quest.42000000001F04BE.quest_desc: [
		"包装機にもう一つの包装スロットを足す。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04BE.title: "包装機の拡張"
	quest.42000000001F04BF.quest_desc: [
		"小包を開いて、ばらのアイテムに戻す。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04BF.title: "開梱機"
	quest.42000000001F04C0.quest_desc: [
		"製作レシピを小包のパターンへ書き込む。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04C0.title: "エンコーダー"
	quest.42000000001F04C1.quest_desc: [
		"書き込まれたレシピどおりに小包を組み立てる。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04C1.title: "製作機"
	quest.42000000001F04C2.quest_desc: [
		"合う住所のほうへ小包を回す。",
		"手順: 分配機マーカー、包装部品、シュルカーの殻二つ、エンダーパール四つ、鉄ブロック一つ。殻: パックのレシピ、プルプァブロック六つ、エンダーパール二つ、結束の結び一つ。"
	]
	quest.42000000001F04C2.title: "分配機"
	quest.42000000001F04C3.quest_desc: [
		"分配機が小包を送れる行き先を印す。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04C3.title: "配分機マーカー"
	quest.42000000001F04C4.quest_desc: [
		"出来た小包をラインへ流し、引き取りを待つ。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04C4.title: "包装供給器"
	quest.42000000001F04C5.quest_desc: [
		"遠い製作機が、代わりにこのブロックから要求できる。",
		"手順: 代理マーカー、包装部品、シュルカーの殻二つ、エンダーパール二つ、泣く黒曜石二つ、鉄ブロック一つ。殻: パックのレシピ、プルプァブロック六つ、エンダーパール二つ、結束の結び一つ。"
	]
	quest.42000000001F04C5.title: "製作代理"
	quest.42000000001F04C6.quest_desc: [
		"小包のレシピをまとめて保管し、また使える。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04C6.title: "レシピホルダー"
	quest.42000000001F04C7.quest_desc: [
		"一つのブロックの設定を別のへ写し、クリックをかなり省く。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04C7.title: "設定複製機"
	quest.42000000001F04C8.quest_desc: [
		"アイテムではなく、流体で小包を満たす。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04C8.title: "液体梱包充填機"
	quest.42000000001F04C9.quest_desc: [
		"運ぶにもしまうにも使える、封じたアイテムの束。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04C9.title: "小包アイテム"
	quest.42000000001F04CA.quest_desc: [
		"基本の種類より、小包一つにはるかに多く詰まる。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04CA.title: "体積梱包"
	quest.42000000001F04CB.quest_desc: [
		"製作代理が届くべき場所を印す。",
		"手順: 小包の部品、次に包装機 / エンコーダー。ME の部分には AE2 のネットワークが要る。"
	]
	quest.42000000001F04CB.title: "プロキシマーカー"
	quest.42000000001F04CC.quest_desc: [
		"包装ラインをデジタル織機につなぐ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001F04CC.title: "AE インターフェース"
	quest.42000000001F04CD.quest_desc: [
		"製作パターンを包装ラインへ渡す。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001F04CD.title: "パターン供給器（包装）"
	quest.42000000001F04CE.quest_desc: [
		"デジタル織機自身のパターン用にアイテムを作る。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001F04CE.title: "分子組立機（包装）"
	quest.42000000001F04CF.quest_desc: [
		"まずデジタル織機のネットワークがないと、この包装は何も動かない。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001F04CF.title: "ME コントローラー"
	quest.42000000001F04D0.quest_desc: [
		"エネルギーか信号を配線する。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000001F04D0.title: "Fluix ケーブル（包装）"
	quest.42000000001F04D1.quest_desc: [
		"Create 側のアイテムを機械のやり方で包む。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.42000000001F04D1.title: "Create 包装機"
	quest.42000000001F04D2.quest_desc: [
		"分かれた荷物を集め、一つの注文に戻す。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.42000000001F04D2.title: "Create 再包装機"
	quest.42000000001F04D3.quest_desc: [
		"つながった在庫の網から、包装済みアイテムを要求する。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.42000000001F04D3.title: "在庫ティッカー（包装）"
	quest.42000000001F04D4.quest_desc: [
		"順番待ちの小包をまとめて置く緩衝チェスト。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.42000000001F04D4.title: "物品庫（包装）"
	quest.42000000002004D5.quest_desc: [
		"QIO のネットワーク向けの、基本の量子貯蔵ディスク。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004D5.title: "QIO ドライブ基台"
	quest.42000000002004D6.quest_desc: [
		"量子ディスク一つに、貯蔵をはるかに多く載せる。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004D6.title: "QIO 超高密度"
	quest.42000000002004D7.quest_desc: [
		"大きさを手放し、生の密度を取る量子ディスク。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004D7.title: "QIO 時間膨張"
	quest.42000000002004D8.quest_desc: [
		"Mekanism が作る最大の量子ディスク。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004D8.title: "QIO 超大質量"
	quest.42000000002004D9.quest_desc: [
		"量子ディスクを何枚も、一つの筐体に収める。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004D9.title: "QIO ドライブ配列"
	quest.42000000002004DA.quest_desc: [
		"QIO のネットワークが蓄えているものをすべて見渡す。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004DA.title: "QIOダッシュボード"
	quest.42000000002004DB.quest_desc: [
		"QIO の操作盤をポケットに入れて持ち歩く。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004DB.title: "携帯 QIO"
	quest.42000000002004DC.quest_desc: [
		"高度な Mekanism 機械のほとんどに使う、基本の外枠。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004DC.title: "鋼鉄の外枠 (QIO)"
	quest.42000000002004DD.quest_desc: [
		"一つのブロックに莫大な電力を蓄える。",
		"まれな報酬：Clowder の共有ライフ一つ、チーム全体で一度きり。こうした報酬はキャンペーンに六つしかない。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004DD.title: "究極キューブ"
	quest.42000000002004DE.quest_desc: [
		"一種類のアイテムだけを、巨大なスタックで持つ。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004DE.title: "究極ビン"
	quest.42000000002004DF.quest_desc: [
		"いくつものスタックを一度に、Mekanism の最高速で精錬する。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004DF.title: "究極製錬工場"
	quest.42000000002004E0.quest_desc: [
		"Mekanism が出せる最高の速さで鉱石を濃縮する。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E0.title: "究極濃縮工場"
	quest.42000000002004E1.quest_desc: [
		"Mekanism が出せる最高の速さで鉱石を粉砕する。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E1.title: "究極粉砕工場"
	quest.42000000002004E2.quest_desc: [
		"チャンクを自動で掘り抜き、まっすぐ虚空まで行く。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E2.title: "デジタル採掘機 (QIO)"
	quest.42000000002004E3.quest_desc: [
		"作業ヘッドを自分で付け替えるモジュール式の道具。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E3.title: "原子分解機 (QIO)"
	quest.42000000002004E4.quest_desc: [
		"Mekanism の機械のあいだで面を回し、設定を写す。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E4.title: "設定器 (QIO)"
	quest.42000000002004E5.quest_desc: [
		"つながった二つの台のあいだを、一瞬で飛ばす。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E5.title: "テレポーター (QIO)"
	quest.42000000002004E6.quest_desc: [
		"テレポーターが開くポータルの枠になる。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E6.title: "テレポーターフレーム"
	quest.42000000002004E7.quest_desc: [
		"反物質を生む反応炉のための外枠。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E7.title: "SPS筐体"
	quest.42000000002004E8.quest_desc: [
		"化学物質を送り込み、反応炉から反物質を引き出す。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E8.title: "SPS ポート"
	quest.42000000002004E9.quest_desc: [
		"反物質反応炉の産出を速める。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004E9.title: "過充電コイル"
	quest.42000000002004EA.quest_desc: [
		"終盤の化学のため、回転で同位体を引き分ける。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004EA.title: "同位体遠心分離機"
	quest.42000000002004EB.quest_desc: [
		"鉱石を化学の泥漿に溶かす。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004EB.title: "化学溶解"
	quest.42000000002004EC.quest_desc: [
		"結晶化する前に、泥漿を洗い清める。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004EC.title: "化学洗浄機"
	quest.42000000002004ED.quest_desc: [
		"化学物質を、また硬い結晶に戻す。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004ED.title: "化学結晶機"
	quest.42000000002004EE.quest_desc: [
		"太陽光が動かす中性子を、材料に打ち込む。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004EE.title: "太陽中性子"
	quest.42000000002004EF.quest_desc: [
		"電力をそのまま熱に変え、ボイラーに使う。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004EF.title: "抵抗型発熱器"
	quest.42000000002004F0.quest_desc: [
		"電力ではなく、熱のために木を燃やす。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F0.title: "薪木ストーブ"
	quest.42000000002004F1.quest_desc: [
		"ほかでは不可能な材料の、終盤の合成。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F1.title: "反陽子"
	quest.42000000002004F2.quest_desc: [
		"採掘も穴掘りも、その先も一つでこなすモジュール式の道具。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F2.title: "Meka-Tool"
	quest.42000000002004F3.quest_desc: [
		"モジュールごとに強化する頭用のスーツ防具。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F3.title: "Meka ヘルメット"
	quest.42000000002004F4.quest_desc: [
		"モジュールごとに強化する胸用のスーツ防具。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F4.title: "Meka 胴防具"
	quest.42000000002004F5.quest_desc: [
		"モジュールごとに強化する脚用のスーツ防具。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F5.title: "Meka パンツ"
	quest.42000000002004F6.quest_desc: [
		"モジュールごとに強化する足用のスーツ防具。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F6.title: "Meka ブーツ"
	quest.42000000002004F7.quest_desc: [
		"蒸気ボイラーの外殻。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F7.title: "ボイラーケーシング"
	quest.42000000002004F8.quest_desc: [
		"大量の電力を蓄える。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F8.title: "精鋭エネルギーキューブ"
	quest.42000000002004F9.quest_desc: [
		"中くらいの量の電力を蓄える。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004F9.title: "上級エネルギーキューブ"
	quest.42000000002004FA.quest_desc: [
		"始めるのに向いた、少量の電力を蓄える。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004FA.title: "基本エネルギーキューブ (QIO)"
	quest.42000000002004FB.quest_desc: [
		"金属に化学物質を染み込ませ、新しい合金にする。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004FB.title: "冶金注入機 (QIO)"
	quest.42000000002004FC.quest_desc: [
		"精錬の前に原鉱の産出を二倍にする。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004FC.title: "濃縮室 (QIO)"
	quest.42000000002004FD.quest_desc: [
		"まとめの材料を挽くか、砕け。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004FD.title: "粉砕機 (QIO)"
	quest.42000000002004FE.quest_desc: [
		"かまどより速く、燃料ではなく電力で精錬する。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004FE.title: "電力製錬機 (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Mekanism 独自の精密刃で木を切る。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000002004FF.title: "精密製材機"
	quest.4200000000200500.quest_desc: [
		"水を、それを成す二つの気体に分ける。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.4200000000200500.title: "電解分離機"
	quest.4200000000200501.quest_desc: [
		"二つの化学物質を新しい一つに合わせる。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.4200000000200501.title: "化学混成機"
	quest.4200000000200502.quest_desc: [
		"液体か鉱石を浄化しろ。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.4200000000200502.title: "浄化"
	quest.4200000000200503.quest_desc: [
		"鉱石へ化学物質を注入し、産出を増やす。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.4200000000200503.title: "化学注入"
	quest.4200000000200504.quest_desc: [
		"アイテムへオスミウムを圧縮し、装備をより頑丈にする。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.4200000000200504.title: "オスミウム圧縮機 (QIO)"
	quest.4200000000200505.quest_desc: [
		"いくつかの部品を一つの完成品にまとめる。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.4200000000200505.title: "結合機"
	quest.4200000000210506.quest_desc: [
		"ゾンビは、欲しくても欲しくなくても落とす。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 夜に浮島でゾンビを倒すか、暗い穴で。"
	]
	quest.4200000000210506.title: "腐った肉の蓄え"
	quest.4200000000210507.quest_desc: [
		"スケルトンがこれを残す。あとで挽いて骨粉に。",
		"手順: 夜のスケルトン、または /clowder hub 浮島の守り手（糸16で8個）。"
	]
	quest.4200000000210507.title: "骨の蓄え"
	quest.4200000000210508.quest_desc: [
		"クリーパーがこれを払う。ときどき爆発つきで。",
		"手順: 粉かソウルサンドをふるう。または夜の浮島のクリーパー。少し手に入ったら縁を照らしたままに。"
	]
	quest.4200000000210508.title: "火薬の蓄え"
	quest.4200000000210509.quest_desc: [
		"クモは落とすが、ふるいは決して落とさない。",
		"手順: ほつれた糸をほどく (1 → 3)。クモ。残響の結束で織機の糸くず。毛糸の逆消費。"
	]
	quest.4200000000210509.title: "紐の蓄え"
	quest.420000000021050A.quest_desc: [
		"毒に醸造でき、変わったレシピをいくつか支える。",
		"手順: 夜、浮島のクモ。"
	]
	quest.420000000021050A.title: "クモの目の蓄え"
	quest.420000000021050B.quest_desc: [
		"エンダーマンがこれらを落とす。虚空に懇願するより、農場のほうが勝る。",
		"手順: エンダーマン、または /clowder hub の縁歩きの露店。"
	]
	quest.420000000021050B.title: "エンダーパール農場"
	quest.420000000021050C.quest_desc: [
		"醸造台にもブレイズバーナーにもなる燃料。",
		"手順: 爪の黒曜石のあと、ネザー要塞。醸造はロッドを求める；Ars と Occultism は待たない。"
	]
	quest.420000000021050C.title: "ブレイズロッド農場"
	quest.420000000021050D.quest_desc: [
		"まれな落ち物。再生のポーションに欠かせない。",
		"手順: 爪の黒曜石のあとのネザーのガスト。"
	]
	quest.420000000021050D.title: "ガストの涙農場"
	quest.420000000021050E.quest_desc: [
		"耐火に醸造でき、いくつかの製作の材料になる。",
		"手順: スライムボールを溶岩の樽に落とす、スライムにブレイズパウダー、またはマグマキューブ。"
	]
	quest.420000000021050E.title: "マグマクリーム農場"
	quest.420000000021050F.quest_desc: [
		"ピストン、スライムブロック、リードに足りる粘り。",
		"手順: 土二つ + 小麦の種 + 骨粉（浮島の堆肥）、または /clowder hub 浮島の守り手。"
	]
	quest.420000000021050F.title: "スライムボール農場"
	quest.4200000000210510.quest_desc: [
		"三つで、戦う価値のあるボスを召喚する。",
		"手順: 爪の黒曜石のあと、ネザー要塞。頭蓋骨三つでウィザーが始まる。"
	]
	quest.4200000000210510.title: "ウィザースケルトンの頭蓋骨"
	quest.4200000000210511.quest_desc: [
		"ウィザー自身の税。まれで、力をたっぷり帯びる。",
		"手順: ウィザー（ソウルサンドに頭蓋骨三つ）、または /clowder hub の太鼓の心臓の屋台で一度、糸の反 12（糸 972）。任意のトロフィー。エンドもモブ農場の 100% も塞がない。"
	]
	quest.4200000000210511.title: "ネザースター"
	quest.4200000000210512.quest_desc: [
		"死んでも残る保管のシュルカーボックスになる。",
		"任意。ここにはシュルカーがいないので、パックが殻を作る。",
		"手順: パックのレシピ、プルプァブロック六つ、エンダーパール二つ、結束の結び一つ。シュルカーはここでは湧かない。任意。"
	]
	quest.4200000000210512.title: "シュルカーの殻農場"
	quest.4200000000210513.quest_desc: [
		"ほかに手がなければエリトラを直す。",
		"手順: 三晩眠らず、それからファントムを倒す。任意。"
	]
	quest.4200000000210513.title: "ファントムの皮膜"
	quest.4200000000210514.quest_desc: [
		"イカの墨。染料と、昔ながらの筆記に役立つ。",
		"手順: 木炭とガラス瓶。イカはここでは決して湧かない。"
	]
	quest.4200000000210514.title: "イカスミ農場"
	quest.4200000000210515.quest_desc: [
		"看板と額縁を暗闇で光らせる。",
		"手順: ヒカリイカは浮島に決して湧かない。任意。"
	]
	quest.4200000000210515.title: "輝くインク"
	quest.4200000000210516.quest_desc: [
		"ガーディアンが落とす。プリズマリンブロックとランタン用。",
		"手順: 海底神殿はもうない。プリズマリンの種を育てないなら任意。"
	]
	quest.4200000000210516.title: "プリズマリンの欠片"
	quest.4200000000210517.quest_desc: [
		"海を照らし、いくつかのクラフトの材料になるガーディアンのドロップ。",
		"手順: 海底神殿はもうない。任意。"
	]
	quest.4200000000210517.title: "プリズマリンクリスタル"
	quest.4200000000210518.quest_desc: [
		"コンジットを囲む。八個集めて枠を完成させる。",
		"任意。虚空は一度も出さないかもしれない。",
		"手順: 海だけ。任意。"
	]
	quest.4200000000210518.title: "オウムガイの殻（狩り）"
	quest.4200000000210519.quest_desc: [
		"死を一度だけごまかす。それで消える。",
		"手順: クエスト報酬だけ。「時計を据える」と「印を据える」が一つずつくれ、後のストランドの結びの贈り物はさらに出す。襲撃とエヴォーカーは浮島に来ない。任意。"
	]
	quest.4200000000210519.title: "トーテム（狩り）"
	quest.420000000021051A.quest_desc: [
		"ゴーレムは見張りをしながら鉄を落とす。",
		"手順: 鉄の原石 / 鉄の砂粒を製錬する（かまどか残り火の窯）。砂利をふるって塊を得る。"
	]
	quest.420000000021051A.title: "アイアンゴーレムの贈り物"
	quest.420000000021051B.quest_desc: [
		"雪玉を投げる。弾薬にはなるが、戦士には心もとない。",
		"手順: 氷一つ（キット／氷生成器）、不定形で雪玉四つ。"
	]
	quest.420000000021051B.title: "スノーゴーレム"
	quest.420000000021051C.quest_desc: [
		"スケルトンが浮島の弾薬を切らさない。",
		"手順: 火打石、棒、羽。スケルトンが余分を落とす。"
	]
	quest.420000000021051C.title: "矢の農場"
	quest.420000000021051D.quest_desc: [
		"当たったものに、一時的な光を付ける。",
		"手順: 矢の周りにグロウストーンダスト。"
	]
	quest.420000000021051D.title: "光の矢"
	quest.420000000021051E.quest_desc: [
		"鞍を見つけたら乗れ。",
		"任意 — Clowder ホールの浮島の守り手が一つ売る。",
		"手順: Clowder ホール（/clowder hub）の浮島の守り手の店でダイヤモンドブロックを交換する。Chocobo の鞍は別のアイテム。"
	]
	quest.420000000021051E.title: "鞍（狩り）"
	quest.420000000021051F.quest_desc: [
		"モブに名を付け、二度と消えないようにする。",
		"任意 — Clowder ホールの印彫りが一つ売る。",
		"手順: 釣り / 希少なチェスト、または /clowder hub の印彫りの露店（糸24）。任意。"
	]
	quest.420000000021051F.title: "名札農場"
	quest.4200000000210520.quest_desc: [
		"つなぎかケーブルを係留する。",
		"手順: スライムボールの周りに紐を四つ。スライムは浮島の堆肥（土、種、骨粉）。"
	]
	quest.4200000000210520.title: "リード（狩り）"
	quest.4200000000210521.quest_desc: [
		"ニワトリが産む速さに、拾う手が追いつかない。",
		"手順: 浮島のニワトリに小麦の種、またはモブ農場の章の鶏小屋。"
	]
	quest.4200000000210521.title: "卵の蓄え"
	quest.4200000000210522.quest_desc: [
		"革と牛肉の蓄え。",
		"手順: 腐った肉を精錬するか、焚き火で焼く。火打石の網で土をふるう。/clowder hub 浮島の守り手が糸18個で2つ売る。"
	]
	quest.4200000000210522.title: "革の蓄え"
	quest.4200000000210523.quest_desc: [
		"ヒツジは刈ったあと、また羊毛を生やす。",
		"手順: 草を与えてから羊を刈るか、紐4本。"
	]
	quest.4200000000210523.title: "羊毛の蓄え"
	quest.4200000000210524.quest_desc: [
		"台所のための食料の蓄え。",
		"手順: 浮島のウシに小麦。"
	]
	quest.4200000000210524.title: "牛肉の蓄え"
	quest.4200000000210525.quest_desc: [
		"ブタがくれる。食べる前に火を通せ。",
		"手順: 浮島のブタにジャガイモかニンジン。"
	]
	quest.4200000000210525.title: "豚肉の蓄え"
	quest.4200000000210526.quest_desc: [
		"食事と羽のためのニワトリ。",
		"手順: 浮島のニワトリに種。"
	]
	quest.4200000000210526.title: "鶏肉の蓄え"
	quest.4200000000210527.quest_desc: [
		"羊肉。生より焼いたほうがいい。",
		"手順: 浮島のヒツジに小麦。"
	]
	quest.4200000000210527.title: "羊肉の蓄え"
	quest.4200000000210528.quest_desc: [
		"一つ余るなら、幸運のポーションを醸す。",
		"任意。虚空は一度も出さないかもしれない。",
		"手順: ウサギは浮島に湧かない。任意。"
	]
	quest.4200000000210528.title: "ウサギの足"
	quest.4200000000210529.quest_desc: [
		"ドラゴンの卵のそばに置く価値のある飾り。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000210529.title: "ゾンビの頭"
	quest.420000000021052A.quest_desc: [
		"棚のドラゴンの卵とよく合う。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000021052A.title: "スケルトンの頭蓋骨"
	quest.420000000021052B.quest_desc: [
		"ドラゴンの卵のそば、戦利品の棚にもう一つの頭。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000021052B.title: "クリーパーの頭"
	quest.420000000021052C.quest_desc: [
		"もう一つの頭。ドラゴンの卵のそばが似合う。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000021052C.title: "ピグリンの頭"
	quest.420000000021052D.quest_desc: [
		"最も珍しい頭。戦いが終わって初めて得られる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000021052D.title: "ドラゴンの頭"
	quest.420000000021052E.quest_desc: [
		"プレイヤーがふと一つ落とすときだけ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000021052E.title: "プレイヤーの頭"
	quest.420000000022052F.quest_desc: [
		"最初の作成は2個——あとで写本のために一つ残す。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 骨一つ、紐、アメジスト。/clowder hub 浮島の守り手が骨を売る。火花 / 唸りの門。"
	]
	quest.420000000022052F.title: "骨の鈴"
	quest.4200000000220530.quest_desc: [
		"古い部族の歌の欠片——骨の鈴が要る。",
		"手順: 骨の鈴、アメジストとレッドストーン、不定形。二つ出る。"
	]
	quest.4200000000220530.title: "霊の欠片"
	quest.4200000000220531.quest_desc: [
		"金属を霊に調律する——骨の鈴の周りに銅。",
		"手順: 骨の鈴の周りに銅。二つ出る。"
	]
	quest.4200000000220531.title: "銅の共鳴器"
	quest.4200000000220532.quest_desc: [
		"格子の線を印す——チョークに欠片が要る。",
		"手順: 骨粉二つ、ラピスラズリ、霊の欠片一つ。不定形。四つできる。"
	]
	quest.4200000000220532.title: "儀式のチョーク（部族）"
	quest.4200000000220533.quest_desc: [
		"心臓を置く——骨の鈴二つ、霊の欠片、革二つ、板材四つ（浮島の守り手が革を売る）。",
		"手順: 骨の鈴二つ、霊の欠片一つ、革二つ、板材四つ。素手でテンポに合わせて打て（17–23 ティック）とパルスが 24。"
	]
	quest.4200000000220533.title: "太鼓の心臓の拍"
	quest.4200000000220534.quest_desc: [
		"九つの部族が一度ハミングした——予備の骨の鈴と欠片が要る。",
		"手順: 作るか、火花/部族の織りの報酬。右クリック：格子の仕組み。"
	]
	quest.4200000000220534.title: "霊の写本"
	quest.4200000000220535.quest_desc: [
		"レイを拍へ引く。",
		"手順: 空の下、水/緑の近くに置く。遅いパルス。火花の梯子。"
	]
	quest.4200000000220535.title: "レイ収集器"
	quest.4200000000220536.quest_desc: [
		"道具、呪文、移動のためにパルスを運ぶ。太鼓の心臓で満たす。",
		"手順: 作ってから太鼓の心臓で満たす（セルでクリック）。道具、呪文、旅はセルから引く。"
	]
	quest.4200000000220536.title: "パルス電池"
	quest.4200000000220537.quest_desc: [
		"残響の触媒を据える。働くうちに擦り減る。八ブロック以内に異なるトーテムの声を二つ加える。声が多いほど歌は強くなる。レッドストーンで止まる。",
		"手順: 残響の触媒を据え、違うトーテムを二つ、8以内に。レッドストーンで止まる。"
	]
	quest.4200000000220537.title: "パルス共鳴器"
	quest.4200000000220538.quest_desc: [
		"石の部族が応える。",
		"手順: 骨の鈴、原木二つ、土、銅の共鳴器。"
	]
	quest.4200000000220538.title: "大地のトーテム"
	quest.4200000000220539.quest_desc: [
		"炎の部族が応える。",
		"手順: 骨の鈴、原木二つ、木炭、銅の共鳴器。"
	]
	quest.4200000000220539.title: "火のトーテム"
	quest.420000000022053A.quest_desc: [
		"潮の部族が応える。",
		"手順: 骨の鈴、原木二つ、水入りバケツ（または水入りの磁器のバケツ）、銅の共鳴器。"
	]
	quest.420000000022053A.title: "水のトーテム"
	quest.420000000022053B.quest_desc: [
		"風の部族が応える。",
		"手順: 骨の鈴、原木二つ、羽、銅の共鳴器。"
	]
	quest.420000000022053B.title: "大気のトーテム"
	quest.420000000022053C.quest_desc: [
		"第五の部族——執事の核。",
		"手順: 骨の鈴、原木二つ、霊の欠片、銅の共鳴器。"
	]
	quest.420000000022053C.title: "霊のトーテム"
	quest.420000000022053D.quest_desc: [
		"格子の歌を始める。石か、残響段階の品を待つ。粗金属は残響粉砕機では砂粒になる。",
		"手順: 霊の写本 + 部族の織り。石か残響段階の品を据える。粗金属は残響粉砕機へ。"
	]
	quest.420000000022053D.title: "歌の作業台"
	quest.420000000022053E.quest_desc: [
		"トーテムの間で倍音を回す。",
		"手順: レッドストーンの周りに銅の共鳴器四つ。四つできる。"
	]
	quest.420000000022053E.title: "格子の伝導体"
	quest.420000000022053F.quest_desc: [
		"段階一をハミングする——鉱石を砕く。石は欠片に、丸石は砂利に、粗金属は砂粒になる。砂粒の粉砕は40パルス/秒で4秒。",
		"手順: 石 + 骨の鈴 + 銅の共鳴器。8以内に大地のトーテム。石 → 欠片；丸石 → 砂利；粗金属 → 砂粒。40パルス/秒で四秒。"
	]
	quest.420000000022053F.title: "エコー破砕"
	quest.4200000000220540.quest_desc: [
		"粉砕を聞いた欠片。",
		"手順: 残響粉砕機に石（丸石ではない）。泉の段階の石、またはシルクタッチの石。"
	]
	quest.4200000000220540.title: "残響片（部族）"
	quest.4200000000220541.quest_desc: [
		"段階二をハミングする——調律。",
		"手順: 石七つ、霊の欠片、銅の共鳴器。"
	]
	quest.4200000000220541.title: "エコー調律"
	quest.4200000000220542.quest_desc: [
		"鍵を見つけた残響。",
		"手順: 霊の写本 + 部族の織り。ステーション、トーテム、パルスの消費は写本の頁にある。"
	]
	quest.4200000000220542.title: "調律されたエコー"
	quest.4200000000220543.quest_desc: [
		"結束の段階——霊を金属に結ぶ。",
		"手順: 石七つ、アメジストの欠片、銅の共鳴器。"
	]
	quest.4200000000220543.title: "エコー結束"
	quest.4200000000220544.quest_desc: [
		"すり抜けない残響。",
		"手順: 霊の写本 + 部族の織り。ステーション、トーテム、パルスの消費は写本の頁にある。"
	]
	quest.4200000000220544.title: "結ばれたエコー"
	quest.4200000000220545.quest_desc: [
		"織り直しの段階——インゴットを呼ぶ。",
		"手順: 石五つ、金のインゴット、銅の共鳴器二つ、霊の欠片。"
	]
	quest.4200000000220545.title: "エコー顕現"
	quest.4200000000220546.quest_desc: [
		"かまどではなく、霊脈の意志で存在した金属。",
		"手順: 霊の写本 + 部族の織り。ステーション、トーテム、パルスの消費は写本の頁にある。"
	]
	quest.4200000000220546.title: "顕現したインゴット"
	quest.4200000000220547.quest_desc: [
		"部族が残したものを保つ。",
		"手順: 板材七つ、チェスト、骨の鈴。"
	]
	quest.4200000000220547.title: "祖先の貯蔵庫"
	quest.4200000000220548.quest_desc: [
		"辺境へ結ばれた宝物庫。",
		"手順: 祖霊の保管庫、鉄のインゴット四つ、霊の欠片、銅の共鳴器二つ、パルスセル。"
	]
	quest.4200000000220548.title: "深層貯蔵庫"
	quest.4200000000220549.quest_desc: [
		"書かれぬ印。儀式が満たすのを待っている。",
		"手順: 紙七つ、霊の欠片、骨の鈴。二つできる。"
	]
	quest.4200000000220549.title: "空白の印章"
	quest.420000000022054A.quest_desc: [
		"石の部族の印。",
		"手順: 空白の印と土、不定形。"
	]
	quest.420000000022054A.title: "土の印章"
	quest.420000000022054B.quest_desc: [
		"炎の部族の印。",
		"手順: 空白の印と木炭、不定形。"
	]
	quest.420000000022054B.title: "火の印章"
	quest.420000000022054C.quest_desc: [
		"潮の部族の印。",
		"手順: 空白の印と水入りバケツ（または水入りの磁器のバケツ）、不定形。"
	]
	quest.420000000022054C.title: "水の印章"
	quest.420000000022054D.quest_desc: [
		"風の部族の印。",
		"手順: 空白の印と羽、不定形。"
	]
	quest.420000000022054D.title: "風の印章"
	quest.420000000022054E.quest_desc: [
		"執事の部族の印。",
		"手順: 空白の印と霊の欠片、不定形。"
	]
	quest.420000000022054E.title: "霊の印章"
	quest.420000000022054F.quest_desc: [
		"印を供える。織機に頼む。",
		"手順: 石五つ、アメジストの欠片、骨の鈴。"
	]
	quest.420000000022054F.title: "儀式の台座"
	quest.4200000000220550.quest_desc: [
		"素手で使って門の儀式を奏でよ：落ちてくる拍を A、S、D、F で打て。60%当たれば開き、脈は要らない。",
		"手順: 門の太鼓を素手で使い、門の儀式を奏でる。落ちてくる拍を A、S、D、F で打て。60%当たれば開き、脈は要らない。先に帰還のコンパスを結べ。"
	]
	quest.4200000000220550.title: "門の太鼓（部族）"
	quest.4200000000220551.quest_desc: [
		"拠点の敷居を、彫られた霊の枠で飾る。コンパスと門の太鼓が移動を行う。",
		"手順: 鉄のインゴット四つ、霊の欠片二つ、銅の共鳴器二つ、アメジストの欠片。"
	]
	quest.4200000000220551.title: "霊のドア"
	quest.4200000000220552.quest_desc: [
		"パルスを費やす道具。",
		"手順: 顕現インゴット三つ、骨の鈴、棒。"
	]
	quest.4200000000220552.title: "霊装のツルハシ"
	quest.4200000000220553.quest_desc: [
		"パルスを費やす刃。",
		"手順: 顕現インゴット二つ、骨の鈴、棒。"
	]
	quest.4200000000220553.title: "霊装の刃"
	quest.4200000000220554.quest_desc: [
		"辺境の石。あってはならない場所の足元にある。",
		"手順: 辺境の丸石を製錬する。門の太鼓を通って辺境で掘る。"
	]
	quest.4200000000220554.title: "辺境の石（部族）"
	quest.4200000000220555.quest_desc: [
		"辺境の瓦礫。地味だが豊富。",
		"手順: 門の太鼓を通って、辺境で辺境の石を掘る。"
	]
	quest.4200000000220555.title: "マーチの丸石"
	quest.4200000000220556.quest_desc: [
		"日の届かぬ場所で育った木。",
		"手順: 門の太鼓を通って、辺境の木を切る。"
	]
	quest.4200000000220556.title: "マーチの原木"
	quest.4200000000220557.quest_desc: [
		"辺境の製材。出所はともあれ頑丈。",
		"手順: 辺境の原木一本で板材が四つできる。"
	]
	quest.4200000000220557.title: "マーチの板材"
	quest.4200000000220558.quest_desc: [
		"風がまったくなくてもささやく葉。",
		"手順: 門の太鼓を通った辺境の木。ハサミかシルクタッチで葉が残る。"
	]
	quest.4200000000220558.title: "マーチの葉"
	quest.4200000000220559.quest_desc: [
		"残った霊脈でハミングする葦。",
		"手順: 辺境で野生に育ち、葦の堰のチェストにあり、根結びの長老が取引する。"
	]
	quest.4200000000220559.title: "霊の葦（部族）"
	quest.420000000022055A.quest_desc: [
		"大地のトーテムのそばで、残響粉砕機に粗鉄を入れる。砂粒が二つ出る。かまどで製錬するか、溶鉱炉でインゴットにする。ほかの Mods がタグ付きの粗金属を出せる。",
		"手順: 霊の写本 + 部族の織り。ステーション、トーテム、パルスの消費は写本の頁にある。"
	]
	quest.420000000022055A.title: "鉱石は二度覚える"
	quest.420000000022055B.quest_desc: [
		"水が羊毛を霊織布に結ぶ。ステーションの上か横から入れ、できたものを下から取り出す。",
		"手順: 霊の写本 + 部族の織り。ステーション、トーテム、パルスの消費は写本の頁にある。"
	]
	quest.420000000022055B.title: "声のある布"
	quest.420000000022055C.quest_desc: [
		"霊のもとで、顕現インゴットをもう一度顕現する。共鳴の核は、より強い装備と遠い道を開く。",
		"手順: 霊の写本 + 部族の織り。ステーション、トーテム、パルスの消費は写本の頁にある。"
	]
	quest.420000000022055C.title: "生きている心"
	quest.420000000022055D.quest_desc: [
		"上位セル一つにパルス4,800、特大セルなら19,200を運べ。出る前に、太鼓の心臓か共鳴器で充電する。",
		"手順: パルスセル一つ、共鳴の核二つ、顕現インゴット二つ。"
	]
	quest.420000000022055D.title: "より長い歌"
	quest.420000000022055E.quest_desc: [
		"貯槽一つにバケツ十六杯。バケツも液体パイプも使える。コンパレーターが満杯具合を読み、レッドストーンが注入と排出を止める。壊すと、液体は落ちたブロックに残る。天石タンクは中身を捨てる。",
		"手順: 作り、バケツかパイプで満たし、拾う——液体は残る。AE2 の天石タンクは壊すと空になる。"
	]
	quest.420000000022055E.title: "銅に留めた雨"
	quest.420000000022055F.quest_desc: [
		"調律器で機械の面を印し、それから中継板に使う。別の機械に使うと印が入れ替わる。板には印すな。",
		"手順: 銅の共鳴器二つの上に、霊の欠片。"
	]
	quest.420000000022055F.title: "遠い端に名を付ける"
	quest.4200000000220560.quest_desc: [
		"プレートをチェストか機械の面にはめ込む。二つのプレートを同じ唯一の結束アイテムで組むか、調律器で行き先を結ぶ。近場の荷は32ブロックまで、毎秒16個、パルス 8 だ。レッドストーンはそれを止める。5.0 以降、プレートは八ブロック以内に応答中の風の共鳴トーテムを求め、なければ止まって待ち、足りない声を告げる。",
		"手順: ホッパー一つ、銅の共鳴器一つ、儀式のチョーク二つ、顕現インゴット一つ。"
	]
	quest.4200000000220560.title: "物資の道"
	quest.4200000000220561.quest_desc: [
		"プレートをタンクの面にはめ込む。二つのプレートを組むか、調律器で行き先を結ぶ。近場の液体は32ブロックまで、毎秒 250 mB、パルス 8 だ。両端は読み込まれていなければならない。5.0 以降、プレートは八ブロック以内に応答中の風の共鳴トーテムを求め、なければ止まって待ち、足りない声を告げる。",
		"手順: スピリットの貯槽一つ、銅の共鳴器一つ、儀式のチョーク二つ、顕現インゴット一つ。"
	]
	quest.4200000000220561.title: "雨の道"
	quest.4200000000220562.quest_desc: [
		"遠達は、成功した一拍につきパルス 16 で、アイテムを128ブロックまで運ぶ。対応するどの mod でも、普通のインベントリが使える。5.0 以降、プレートは八ブロック以内に応答中の風の共鳴トーテムを求め、なければ止まって待ち、足りない声を告げる。",
		"手順: アイテム中継一つ、共鳴の核二つ、エンダーパール二つ。"
	]
	quest.4200000000220562.title: "工房を越えて"
	quest.4200000000220563.quest_desc: [
		"遠達は、一拍につきパルス 16 で、液体を128ブロックまで運ぶ。満杯の受け側は安全に止まり、レッドストーンは受けの貯槽をロックできる。5.0 以降、プレートは八ブロック以内に応答中の風の共鳴トーテムを求め、なければ止まって待ち、足りない声を告げる。",
		"手順: 流体中継一つ、共鳴の核二つ、エンダーパール二つ。"
	]
	quest.4200000000220563.title: "水路を越えて"
	quest.4200000000220564.quest_desc: [
		"Tribal Power を Mekanism、Powah または AE2 のエネルギー受容体へ橋渡しする。パルス一つが 100 FE になる。無位階の変換は毎秒 60 パルス（6,000 FE/s）。残響の拠点でアダプターの位階を上げ、素手のステータスが現在の速度を告げる。それでも FE は受け取れない。レッドストーンは変換と搬出を止める。",
		"手順: 銅インゴット五つ、レッドストーン三つ、共鳴の核一つ。"
	]
	quest.4200000000220564.title: "拍が電流になる"
	quest.4200000000220565.quest_desc: [
		"六声の杖。しゃがみ使用で大地、火、水、風、霊、織機を順に切り替える。使用で詠唱する。織機の声は繋ぎで、対象を八ブロック手前へ引く。対象のないしゃがみ詠唱は縫いで、六ブロックの瞬移だ。充電したセルを運べ。霊の写本が各呪文とその消費を説明する。",
		"手順: 霊の印章、共鳴の核、顕現のインゴット、原木二つ。"
	]
	quest.4200000000220565.title: "一手に六つの声"
	quest.4200000000220566.quest_desc: [
		"利き手で、石の面をしゃがみ使用する。意図した三×三の切断で、ブロックあたり 8 パルス。通常の破壊保護と道具の条件はそのままだ。",
		"手順: 顕現のインゴット二つ、共鳴の核、銅の共鳴器二つ。"
	]
	quest.4200000000220566.title: "石が戸口を譲る"
	quest.4200000000220567.quest_desc: [
		"頭巾は、充電したセルが支えるあいだ夜目を貸す。未結の部位は四秒ごとに 2 パルスを引く。結んだ声は 3 かかる。",
		"手順: 霊織布五つ、兜の形。後からレイのレンズを載せると、レイが見える。"
	]
	quest.4200000000220567.title: "静けさの目"
	quest.4200000000220568.quest_desc: [
		"袍は耐性を与える。仕事へ着て行き、セルを充電したままに。",
		"手順: 霊織布七つと共鳴の核。"
	]
	quest.4200000000220568.title: "織った隠れ家"
	quest.4200000000220569.quest_desc: [
		"織った脚甲は速さを貸す。そのパルス消費は他の部位とは別だ。",
		"手順: 霊織布六つと共鳴の核。"
	]
	quest.4200000000220569.title: "野営は歩調を保つ"
	quest.420000000022056A.quest_desc: [
		"靴は、パルスが残るあいだ降下中に低速落下を貸せる。結んだ帰還路は、それでも持っていく価値がある。",
		"手順: 霊織布四つ、靴の形。"
	]
	quest.420000000022056A.title: "より柔らかい降下"
	quest.420000000022056B.quest_desc: [
		"再利用できる印を、合うトーテムのそばに据える。六ブロックの祝福は二秒ごとに 8 パルス。高いレッドストーンはそれを止める。素手でしゃがむと印を回収する。",
		"手順: 顕現のインゴット二つ、銅インゴット二つ、共鳴の核、石三つ。"
	]
	quest.420000000022056B.title: "留まる祝福"
	quest.420000000022056C.quest_desc: [
		"硬い床の上面をしゃがみ使用して結ぶ。同じ世界で 128 ブロック以内なら、20 パルスで戻れる。着地の床に動力を入れると、到着をロックする。",
		"手順: 顕現のインゴット四つに囲まれたコンパス。"
	]
	quest.420000000022056C.title: "最初の帰還路"
	quest.420000000022056D.quest_desc: [
		"一つのディメンション内なら、どんな距離でも 40 パルスで戻る。乾いた着地を残し、その上に空きブロックを二つ。",
		"手順: 共鳴の核四つに囲まれた道標のコンパス。"
	]
	quest.420000000022056D.title: "地平の向こう"
	quest.420000000022056E.quest_desc: [
		"門の太鼓の向こうで辺境の水晶を探せ。人、物品、流体の星路は、どれも同じ終盤の素材を引く。",
		"手順: 辺境の洞窟で水晶を掘るか、辺境のチェストで見つける。先に門の太鼓。"
	]
	quest.420000000022056E.title: "帳の向こうの声"
	quest.420000000022056F.quest_desc: [
		"最後のコンパスは 100 パルスで次元を渡る。探索の前に、安全な帰還を結べ。移動は使用のあいだ五秒待つ。",
		"手順: 地平のコンパス、霊の印章二つ、辺境の水晶二つ。"
	]
	quest.420000000022056F.title: "世界のあいだの道"
	quest.4200000000220570.quest_desc: [
		"星界の貨物は距離の上限なく次元を越える。成功した一拍はパルスを32使う。受け側はすでに読み込まれていること。隠れたチャンク読み込みはない。5.0以降、プレートは八ブロック以内に応答中の共鳴のトーテム（織機）を求め、なければ止まり、足りない声を告げる。",
		"手順: 長距離アイテムリレー、霊の封印二つ、辺境の水晶二つ。"
	]
	quest.4200000000220570.title: "補給が帳を越える"
	quest.4200000000220571.quest_desc: [
		"星界の流体は、プレイヤーやアイテムと同じ次元の段をたどる。行き先のタンクは読み込んだままにしておけ。タンクが満杯か、世界が未読み込みなら、貨物を消費せず止まる。5.0以降、プレートは八ブロック以内に応答中の共鳴のトーテム（織機）を求め、なければ止まり、足りない声を告げる。",
		"手順: 長距離流体リレー、霊の封印二つ、辺境の水晶二つ。"
	]
	quest.4200000000220571.title: "雨が帳を越える"
	quest.4200000000220572.quest_desc: [
		"道の上から、自分用の54スロットの深層の蔵を開け。同じ保管庫で、蔵と鞄で共有される。辺境への調律で、開くコストがなくなる。",
		"手順: 霊織布六つ、共鳴の核二つ、深層の蔵。"
	]
	quest.4200000000220572.title: "携える野営"
	quest.4200000000220573.quest_desc: [
		"門は生きた国へ開く。古い歌をまだ運ぶ生き物もいれば、その砕けた欠片を守るものもいる。穏やかなものはブラシで撫でよ。守護者には、チャージしたパルスセルと帰路を用意して向かえ。",
		"手順: 作るか、火花/部族の織りの報酬。右クリック：格子の仕組み。"
	]
	quest.4200000000220573.title: "帰還の歌"
	quest.4200000000220574.quest_desc: [
		"角に古い森の歌を宿す、暁の草食い。小麦で繁殖させ、大人をブラシで撫でると暁のビロードが手に入る。",
		"オーバーワールドの森と辺境で探せ。試薬を、水の声の下で残響結束へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 大人の暁の牡鹿をブラシで撫でる。小麦で繁殖させる。"
	]
	quest.4200000000220574.title: "暁の牡鹿：戻った歌"
	quest.4200000000220575.quest_desc: [
		"尾が安全な道を印す、たそがれの控えめな採食者。スイートベリーで繁殖させ、大人をブラシで撫でると灯籠の綿羽が手に入る。",
		"オーバーワールドの森と辺境で探せ。試薬を、水の声の下で残響結束へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 大人の灯籠狐をブラシで撫でる。スイートベリーで繁殖させる。"
	]
	quest.4200000000220575.title: "灯籠狐：戻った歌"
	quest.4200000000220576.quest_desc: [
		"生きた甲羅を持つ、湿地の辛抱強い庭師。海草で繁殖させ、大人をブラシで撫でると、自然に脱いだ苔背の鱗が手に入る。",
		"オーバーワールドの沼地と辺境で探せ。試薬を、水の声の下で残響結束へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 大人の苔背をブラシで撫でる。海草で繁殖させる。"
	]
	quest.4200000000220576.title: "苔背：戻った歌"
	quest.4200000000220577.quest_desc: [
		"壊れた火の儀式の残骸。近接の一撃がわずかに火を付ける。水を近くに。",
		"オーバーワールドの森と辺境で探せ。試薬を、霊の声の下で残響調律へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 灰縛りから落ちる。敵対する霊には闇が要る。"
	]
	quest.4200000000220577.title: "灰縛り：戻った歌"
	quest.4200000000220578.quest_desc: [
		"断たれたレイの線にねじれた林の守護者。遅いが頑丈。一撃が旅人を一瞬、地に根づかせる。",
		"オーバーワールドの森と辺境で探せ。試薬を、霊の声の下で残響調律へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 根縛りから落ちる。敵対する霊には闇が要る。"
	]
	quest.4200000000220578.title: "根縛り：戻った歌"
	quest.4200000000220579.quest_desc: [
		"霊の葦に隠れた沼の狩人。素早い一撃は短い毒を帯びる。",
		"オーバーワールドの沼地と辺境で探せ。試薬を、霊の声の下で残響調律へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 葦の忍び寄る者から落ちる。敵対する霊には闇が要る。"
	]
	quest.4200000000220579.title: "葦の忍び寄る者：戻った歌"
	quest.420000000022057A.quest_desc: [
		"歌う石の鎧を着た、結晶の野のあさり手。重い押しには距離を取れ。",
		"辺境で探せ。試薬を、霊の声の下で残響調律へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 欠片背から落ちる。敵対する霊には闇が要る。"
	]
	quest.420000000022057A.title: "欠片背：戻った歌"
	quest.420000000022057B.quest_desc: [
		"古い道を今も守る、空の番兵。触れられると、攻撃側の握力が弱る。",
		"辺境で探せ。試薬を、霊の声の下で残響調律へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 虚ろな番兵から落ちる。敵対する霊には闇が要る。"
	]
	quest.420000000022057B.title: "虚ろな番兵：戻った歌"
	quest.420000000022057C.quest_desc: [
		"嵐に養われ、広い帳の翼を持つ霊。明るい粒の集まりが突風を告げる。遮蔽が攻撃を断つ。",
		"辺境で探せ。試薬を、水の声の下で残響結束へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 嵐の蛾から落ちる。敵対する霊には闇が要る。"
	]
	quest.420000000022057C.title: "嵐の蛾：戻った歌"
	quest.420000000022057D.quest_desc: [
		"素早い残り火の霊。燃える矢の前に火花を集める。呪文は地形に火を付けない。",
		"辺境で探せ。試薬を、霊の声の下で残響調律へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 残り火のインプから落ちる。敵対する霊には闇が要る。"
	]
	quest.420000000022057D.title: "残り火のインプ：戻った歌"
	quest.420000000022057E.quest_desc: [
		"失われた部族を覚える、浮かぶ遺物。予告された鐘が動きを遅くする。遮蔽が歌を断つ。",
		"辺境で探せ。試薬を、霊の声の下で残響調律へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 哀悼の鐘から落ちる。敵対する霊には闇が要る。"
	]
	quest.420000000022057E.title: "哀悼の鐘：還った歌"
	quest.420000000022057F.quest_desc: [
		"格子の裂け目に引き寄せられる狩人。距離はすぐ詰めるが、ひとりでは世界から世界へ渡れない。",
		"辺境で探せ。試薬を、霊の声の下で残響調律へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 裂け目の猟犬から落ちる。敵対する霊には闇が要る。"
	]
	quest.420000000022057F.title: "裂け目の猟犬：還った歌"
	quest.4200000000220580.quest_desc: [
		"壊れた歌を守る八本脚の守り手。噛むと獲物は遅くなるが、巣は張らず、野営も傷つけない。",
		"辺境で探せ。試薬を、水の声の下で残響結束へ戻せば、役立つ素材になる。明かりのある道を作れ。敵対する霊は闇を要する。",
		"手順: 残響の織り手から落ちる。敵対する霊には闇が要る。"
	]
	quest.4200000000220580.title: "残響の織り手：還った歌"
	quest.4200000000220581.quest_desc: [
		"野帳は揃った。穏やかな収穫と取り戻した遺物は、再び布と残響になった。夜の帳の下で、野営はより豊かな歌で応える。",
		"まれな報酬：Clowder の共有ライフ一つ、チーム全体で一度きり。こうした報酬はキャンペーンに六つしかない。",
		"手順: 霊の写本 + 部族の織り。ステーション、トーテム、パルスの消費は写本の頁にある。"
	]
	quest.4200000000220581.title: "十三の声、一つの空"
	quest.4200000000220582.quest_desc: [
		"野営の歌を銅に掛けろ。霊のランタンは燃料なしで光を満たす；レッドストーンはそれを弱める。闇から戻る安全な道に印を付けろ。",
		"手順: 銅インゴット三つ、霊の欠片一つと板材一枚。"
	]
	quest.4200000000220582.title: "還る者への灯"
	quest.4200000000220583.quest_desc: [
		"鈴は飾りであり、楽器でもある。コンパレーターは晴天で0、雨で8、雷で15を出す。レッドストーンはそれを黙らせる。",
		"手順: 板材三枚、銅インゴット三つと骨の鈴一つ。"
	]
	quest.4200000000220583.title: "天候を聴け"
	quest.4200000000220584.quest_desc: [
		"彫り卓は27スタックを収める。普通のアイテムパイプとリレーが供え物を分け合える；コンパレーターは満ち具合を読み、レッドストーンは出し入れを鎖す。",
		"手順: チェスト一つ、縛られた残響一つ、板材二枚と石二つ。"
	]
	quest.4200000000220584.title: "炉端の席"
	quest.4200000000220585.quest_desc: [
		"林の守りを作物と同じ高さに、9×9の畝へ置け。種は最初の段に入れ、収穫は下の二段を埋める。植え付けはパルス4、収穫して植え直すには12。動力は8ブロック以内に届けよ。出力が一杯なら作物は残り、レッドストーンは作業を止める。5.0以降は8ブロック以内に応答中の大地の共鳴トーテムを求め、なければ止まって欠けている声を告げる。水のトーテムもそばに置けば、畝の溝をすべて潤す。",
		"手順: 鉄のクワ、大地の印、結ばれた残響、銅インゴット二つ、板材二つ。"
	]
	quest.4200000000220585.title: "庭は歌い続ける"
	quest.4200000000220586.quest_desc: [
		"毎秒パルス8が、24ブロック以内の敵対出現を防ぐ。すでにいる生き物はそのまま残る。守護は揺りかごの敵対召喚も止めるので、召喚の場はその外に置け。レッドストーンはすぐに守護を黙らせる。5.0以降は8ブロック以内に応答中の霊の共鳴トーテムを求め、なければ止まって欠けている声を告げる。",
		"手順: 霊の印、結ばれた残響二つ、残響片、辺境の板材三つ。"
	]
	quest.4200000000220586.title: "野営の縁の静けさ"
	quest.4200000000220587.quest_desc: [
		"道の錨は毎秒パルス16で、自分のチャンクを起こしたままにする。遠い中継の受け側に一つ置き、そこの動力を絶やすな。一つのディメンションで動ける錨は多くて32。レッドストーンか空のバッファが、チャンクを手放す。5.0以降は8ブロック以内に応答中の大地の共鳴トーテムを求め、なければ止まって欠けている声を告げる。",
		"手順: 辺境の水晶二つ、エンダーアイ、顕現インゴット二つ、共鳴の核、辺境の石三つ。"
	]
	quest.4200000000220587.title: "覚えている野営"
	quest.4200000000220588.quest_desc: [
		"未充填の似姿を対応した生き物にしゃがんで使い、害のない刻印を取れ。似姿は種族を覚える。ボスは縛れず、写本が合う霊と結びの更新を説明する。",
		"手順: 骨の鈴、霊織布二つ、共鳴の核、結ばれた残響。"
	]
	quest.4200000000220588.title: "生きた声を借りる"
	quest.4200000000220589.quest_desc: [
		"目覚めた像を最初のスロットに、霊織布を二つ目に据える。成功した召喚は毎回、パルス80、霊織布一つ、結束の糸一本を使う。三ブロック以内に安全な床を残せ。近くの生き物八体で召喚の揺りかごは止まり、レッドストーンは作業と自動化をすべて止める。5.0以降は八ブロック以内に保った霊の共鳴トーテムが要り、なければ止まって、足りない声を告げる。",
		"手順: 顕現のインゴット二つ、辺境の水晶一つ、縛られた残響二つ、共鳴の核一つ、辺境の板材三つ。"
	]
	quest.4200000000220589.title: "借りた命の炉"
	quest.420000000022058A.quest_desc: [
		"霊の封印を儀式の火鉢に置く。八ブロック以内に土、風、霊のトーテム、近くにパルス200、インベントリに霊織布三つを用意する。刻印の像を火鉢に使い、召喚の糸を512本目覚めさせる。すべて使い切ったら、この儀式を繰り返して結束を新たにせよ。",
		"手順: 霊の封印を儀式の火鉢に。土、風、霊のトーテムを8以内に。パルス200。霊織布三つ。刻印の像を使う。"
	]
	quest.420000000022058A.title: "三つの声が糸を目覚めさせる"
	quest.420000000022058B.quest_desc: [
		"成功した召喚を一度終えよ。失敗や阻まれた試みは、糸も供えも消費しない。一つの結束は成功した召喚512回もつ。召喚の揺りかごを壊して置き直しても、結束は決して更新されない。像のツールチップが残り回数を示し、コンパレーターが揺りかごに残る結束の強さを読む。",
		"手順: 召喚の揺りかごから、成功した召喚を一度終える。失敗は何も消費しない。"
	]
	quest.420000000022058B.title: "揺りかごからの答え"
	quest.4200000000228001.quest_desc: [
		"門の太鼓の向こう、辺境のステップと高地に沈んだ祖先の広間が隠れる。歩いて入ると、これが進む。広間ごとに伝承の石板が四枚並ぶ。一枚残らず読め。チェストには織機の糸、残響、霊織布、封印がある。虚ろな番兵がまだ番をしている。",
		"手順: 門の太鼓で辺境へ入り、祖先の広間へ歩く。それから伝承の石板四枚を読む。"
	]
	quest.4200000000228001.title: "時を守った広間"
	quest.4200000000228002.quest_desc: [
		"織機の糸は、手の中の織機だ。祖先の広間のチェストには二から四、歌われぬ者は十六以上を引きちぎり、織機の縫い手の長老が友の立場で一つと交換する。六番目の声の試薬だ。",
		"手順: 祖先の広間のチェスト、歌われぬ者、または友の立場の織機の縫い手の長老。"
	]
	quest.4200000000228002.title: "糸そのもののストランド"
	quest.4200000000228003.quest_desc: [
		"辺境の石八つを残響片の周りに置くと、伝承の石板が二枚できる。置くと、石板は九つの部族の断片を示す。クリエイティブでスニーク使用すると、どれかを切り替える。自分の広間をそれらで埋めよ。",
		"手順: 残響片の周りに辺境の石八つ。二枚できる。"
	]
	quest.4200000000228003.title: "読んだものを彫れ"
	quest.4200000000228004.quest_desc: [
		"共鳴の核の周りに、辺境の板材の上へ革。辺境の高地の太鼓の円には、すでに一つがある。これは家に据えるためのものだ。息をひとつ置いて四回打て。古い何かが立つ。",
		"手順: 革三つ、辺境の板材五つ、共鳴の核一つ。"
	]
	quest.4200000000228004.title: "鳴らない太鼓"
	quest.4200000000228005.quest_desc: [
		"歌われぬ者は三段階の太鼓の霊だ。拍：衝撃波に対してしゃがんで踏ん張れ。合唱：呼び出す残響の織り手を切り倒せ。静寂：同じ四拍のリズムで沈黙の太鼓を打つまで傷つけられない。そのリズムが相手を気絶させ、与えるダメージを二倍にする。充電したパルスセルと帰路を持っていけ。",
		"手順: 沈黙の太鼓で歌われぬ者と戦え。拍ではしゃがみ、静寂では四拍を打て。"
	]
	quest.4200000000228005.title: "太鼓は覚えている"
	quest.4200000000228006.quest_desc: [
		"討伐ごとに歌われぬ者の心が一つ。織機の糸と共鳴の核も一緒だ。これで作れるのは織機のトーテムだけで、ほかには何もない。大事に使え。",
		"手順: 沈黙の太鼓の歌われぬ者は、討伐ごとに一つ落とす。"
	]
	quest.4200000000228006.title: "静まった太鼓"
	quest.4200000000228007.quest_desc: [
		"織機の糸と辺境の水晶の間に歌われぬ者の心を、辺境の板材の上に。織機が大地、火、水、風、霊に加わる。パルス共鳴器のための異なる声であり、残響の解き織りとレイの結束が求める調律だ。",
		"手順: 歌われぬ者の心一つ、辺境の水晶四つ、織機の糸二つ、辺境の板材二つ。"
	]
	quest.4200000000228007.title: "六番目の声"
	quest.4200000000228008.quest_desc: [
		"空白の印と織機の糸。儀式の火鉢に据えると、織機の印は張力を祝福する。二秒ごとに、範囲内の全員が持つセルへパルスを二つ補充し、幸運を貸す。",
		"手順: 空白の印と織機の糸、不定形。"
	]
	quest.4200000000228008.title: "張力の印"
	quest.4200000000228009.quest_desc: [
		"織機の糸と銅の共鳴器を辺境の石の上に。織機の声の下で、残響の解き織りは格子を逆に走らせる：顕現インゴットは結束した残響二つに、結束は調律二つに、調律は欠片二つに、霊織布は羊毛二つに、共鳴の核は顕現インゴット三つに、使い込んだ霊装の道具はどれも顕現インゴット一つに。",
		"手順: 辺境の石五つ、織機の糸、銅の共鳴器二つ、霊の欠片。"
	]
	quest.4200000000228009.title: "格子、逆に"
	quest.420000000022800A.quest_desc: [
		"六重の杖を織機の声まで切り替える。繋留は対象を八ブロック、六パルスで自分へ引く。対象のないスニーク詠唱は縫いで、空中を六ブロック瞬移し、消費は十。両方使ったらこれを完了する。",
		"手順: 六重の杖を織機の声に。対象を繋留し、それからスニークで縫い。両方が出たらチェック。"
	]
	quest.420000000022800A.title: "繋留と縫い"
	quest.420000000022800B.quest_desc: [
		"部族の野営が辺境に九つ立つ。ストランドごとに一つ：小屋、火、部族の炉、トーテム、旗、そして部族の親族が四人。その部族が好むものか、チャージしたパルスセルで炉を右クリックすると、彼らへの評判が上がる。親族を傷つけると25。部族の旗を壊すと5、炉は40。ありふれたキャンプのブロックは減らない。",
		"手順: 辺境の部族の炉を、その部族の好みかチャージしたパルスセルで右クリック。"
	]
	quest.420000000022800B.title: "温めておく"
	quest.420000000022800C.quest_desc: [
		"客人は50、友人は150、親族は400、声は800。炉の近くでの討伐と済ませた取引も数える。長老は位ごとに二つの品を出す。砂利歌いは残響を原石と引き換えに売り、印彫りは印と儀式の石板を売り、織機の縫い手は織機の糸と道標のコンパスを売り、親族では織機の錨と織機の印も。`/tribalpower standing` が九つすべてを出す。",
		"手順: 部族と友人（150）になる。 /tribalpower standing."
	]
	quest.420000000022800C.title: "良い間柄"
	quest.420000000022800D.quest_desc: [
		"声の立場で、長老が一度だけ部族の標を手に押す。それはその部族の写本の頁を開き、親族のトーテムに欠かせない唯一の材料だ。",
		"手順: 部族と声（800）。長老が標を一度渡す。"
	]
	quest.420000000022800D.title: "九つが合意"
	quest.420000000022800E.quest_desc: [
		"部族の標を持て。部族ごとに異なり、九つがあり得る。",
		"手順: 部族と声（800）になる。その長老が標を一度渡す。"
	]
	quest.420000000022800E.title: "部族の標"
	quest.420000000022800F.quest_desc: [
		"部族の標、その部族の調律の共鳴トーテム、霊織布二つ。親族のトーテムはパルス共鳴器の互いに異なる声が一つ増えたものとして数えられ、ステーションにその部族の調律を貸すので、九つの部族でキャンプの歌を十五の声まで運べる。",
		"手順: クラフトグリッドに部族の標、その部族の共鳴トーテム、霊織布二つ。"
	]
	quest.420000000022800F.title: "声ではない声"
	quest.4200000000228010.quest_desc: [
		"キャンプの鼓手は数秒ごとに叩く。太鼓の心臓を一人から八ブロック以内に置くと、一拍ごとにパルスを二つ与える。鼓手が格子を養っているとき、これにチェック。",
		"手順: キャンプの鼓手から8以内に太鼓の心臓を置く。パルスを送っているときチェック。"
	]
	quest.4200000000228010.title: "キャンプが拍を保つ"
	quest.4200000000228011.quest_desc: [
		"石二つと試薬を印章の周りに。印章は返される。結び根を大地の印章のそばに。600パルス。二十分のあいだ、火鉢の周りの九チャンクでは作物、苗木、茎の成長が速くなる。その印章を据えた儀式の火鉢に、儀式の円の中で儀式の板をスニーク使用する（対角に台座四つ、チョークで結ぶ）。パルスは八ブロック以内の格子から引かれる。",
		"手順: 石二つ、結び根、大地の印章、不定形。印章は戻る。"
	]
	quest.4200000000228011.title: "儀式の石板：緑色の祝福"
	quest.4200000000228012.quest_desc: [
		"石二つと試薬を印章の周りに。印章は返される。葦の牙を水の印章のそばに。400パルス。二十分の雨。貯槽と作物のため。その印章を据えた儀式の火鉢に、儀式の円の中で儀式の板をスニーク使用する（対角に台座四つ、チョークで結ぶ）。パルスは八ブロック以内の格子から引かれる。",
		"手順: 石二つ、葦の牙、水の印章、不定形。印章は戻る。"
	]
	quest.4200000000228012.title: "儀式の石板：雨呼び"
	quest.4200000000228013.quest_desc: [
		"石二つと試薬を印章の周りに置く。印章は返される。嵐の翼を風の印の脇に。パルス400。四十分の晴天。その印章を据えた儀式の火鉢に、儀式の円の中で石板をスニーク使用する（対角線上の台座四つ、チョークがそれらを結ぶ）。パルスは八ブロック以内の格子から引かれる。",
		"手順: 石二つ、嵐の翼、風の印、不定形。印章は戻る。"
	]
	quest.4200000000228013.title: "儀式の石板：空晴らし"
	quest.4200000000228014.quest_desc: [
		"石二つと試薬を印章の周りに置く。印章は返される。残り火の心臓を火の印の脇に。パルス800。夜を次の日の出まで急がせ、世界全体に効く。その印章を据えた儀式の火鉢に、儀式の円の中で石板をスニーク使用する（対角線上の台座四つ、チョークがそれらを結ぶ）。パルスは八ブロック以内の格子から引かれる。",
		"手順: 石二つ、残り火の心臓、火の印、不定形。印章は戻る。"
	]
	quest.4200000000228014.title: "儀式の石板：夜明けの呼び"
	quest.4200000000228015.quest_desc: [
		"石二つと試薬を印章の周りに置く。印章は返される。番兵の印を霊の印の脇に。パルス600。十五分、六十四ブロック以内に敵対は湧かない。その印章を据えた儀式の火鉢に、儀式の円の中で石板をスニーク使用する（対角線上の台座四つ、チョークがそれらを結ぶ）。パルスは八ブロック以内の格子から引かれる。",
		"手順: 石二つ、番兵の印、霊の印、不定形。印章は戻る。"
	]
	quest.4200000000228015.title: "儀式の石板：静夜"
	quest.4200000000228016.quest_desc: [
		"石二つと試薬を印章の周りに置く。印章は返される。織機の糸を織機の印の脇に。パルス1200。最も近いトーテムを、六十四ブロック以内の別のトーテムと三十分のレイ線で結び、その間にパルスを通す。その印章を据えた儀式の火鉢に、儀式の円の中で石板をスニーク使用する（対角線上の台座四つ、チョークがそれらを結ぶ）。パルスは八ブロック以内の格子から引かれる。",
		"手順: 石二つ、織機の糸、織機の印、不定形。印章は戻る。"
	]
	quest.4200000000228016.title: "儀式の石板：レイ結束"
	quest.4200000000228017.quest_desc: [
		"どの儀式でも行う。火鉢の周りの格子のパルスが少なすぎると、何も消費されず、火鉢がそう告げる。",
		"手順: 合う印章とパルスを備え、儀式の円の中の儀式の火鉢に、どの儀式の石板でもスニーク使用。"
	]
	quest.4200000000228017.title: "最初の儀式"
	quest.4200000000228018.quest_desc: [
		"霊織布二つ、霊の欠片、その種の試薬。大人の使い魔に使う。動物は六割、失敗しても護符は残る。残骸は自分の部族との声を求め、四割、失敗すると護符は消える。",
		"手順: 霊織布二つ、霊の欠片、使い魔の試薬一つ（暁のビロード、灯籠の綿毛、嵐の翼など）。"
	]
	quest.4200000000228018.title: "野生のものへの護符"
	quest.4200000000228019.quest_desc: [
		"結ばれた使い魔はついてきて、後を追って転移し、決して消えず、あなたには傷つけられず、ブラシで撫でると二倍出る。灯籠狐と苔背と暁の牡鹿から始める。残骸には声が要る。戦う者一人と手伝い二人まで従える。座っている者は数に入らない。",
		"手順: 大人の使い魔に絆の護符を使う。最初の絆で進捗が発動する。"
	]
	quest.4200000000228019.title: "闇の中の友"
	quest.420000000022801A.quest_desc: [
		"紙、霊織布、霊の欠片。プレイヤーに憲章を使い、自分のキャンプへ誘う。空中で使うと、そのキャンプが見える。`/tribalpower camp` は作成、招待、参加、脱退、追放、改名をする。",
		"手順: 紙、霊織布、霊の欠片、不定形。"
	]
	quest.420000000022801A.title: "多くの声のキャンプ"
	quest.420000000022801B.quest_desc: [
		"キャンプの仲間は、どの深層の蔵と旅人の鞄の奥にもある五十四スロットのキャンプ保管庫を共有し、互いの装置の持ち主と数えられ、道の錨を十二まとめ、部族の立場の四分の一をキャンプへ映す。Clowder はそのキャンプではない — /tribalpower camp create <name> がそれだ。",
		"手順: /tribalpower camp create <name>（Clowder ではない）。最初のキャンプで進捗が発動する。"
	]
	quest.420000000022801B.title: "一つの保管庫、一つの予算"
	quest.420000000022801C.quest_desc: [
		"ガラス板を銅の共鳴器と霊の欠片の上に。持つと、レンズは立っている場所のレイの強さを示し、周りの地面にそれを描き、レイ収集器か使い魔にスニーク使用するとその数値が出る。",
		"手順: ガラス板、銅の共鳴器、霊の欠片を縦一列。"
	]
	quest.420000000022801C.title: "レイを見る"
	quest.420000000022801D.quest_desc: [
		"レッドストーンと銅の共鳴器の上にクォーツ、その下に辺境の石。どのパルスの器に向けても、蓄えに比例してレッドストーンを0から15まで出す。",
		"手順: クォーツ、レッドストーン二つ、銅の共鳴器、辺境の石。"
	]
	quest.420000000022801D.title: "パルスの針"
	quest.420000000022801E.quest_desc: [
		"レッドストーンと銅の共鳴器の上にレッドストーントーチ、その下に辺境の石。向けた器がしきい値以上のとき信号を出す。右クリックで25、50、75、100パーセントを巡る。パルスで動く自動化の部品。",
		"手順: レッドストーントーチ、レッドストーン二つ、銅の共鳴器、辺境の石。"
	]
	quest.420000000022801E.title: "歌の一行"
	quest.420000000022801F.quest_desc: [
		"霊の写本をどの部族ブロックにでもスニーク使用すると、簡素な報告が出る。蓄えたパルス、それを養う発電機、八ブロック以内の調律、今のレシピに足りないもの、満杯の出力、レッドストーンの一時停止、読み込まれていない中継の端。知らなかったことを告げたら、これをチェック。",
		"手順: 霊の写本を部族ブロックにスニーク使用。報告が本当の不具合を名指ししたらチェック。"
	]
	quest.420000000022801F.title: "写本に理由を問う"
	quest.4200000000228020.quest_desc: [
		"石の泉に丸石を請う。石は作らない。石には留まるよう頼む。丸石に要るのは形とパルスだけ。八ブロック以内の大地のトーテムがあれば、石を請える。",
		"手順: 丸石五つ、残響片、太鼓の心臓。"
	]
	quest.4200000000228020.title: "石の泉"
	quest.4200000000228021.quest_desc: [
		"どの模様でも完成させる。配置が儀式だ。散らばった装置は儀式ではない。",
		"手順: 霊の写本から儀式の模様を置く。最初の完成した円で進捗が発動する。"
	]
	quest.4200000000228021.title: "円を描く"
	quest.4200000000228022.quest_desc: [
		"石の泉に最初の丸石を請う。石は作らない。石には留まるよう頼む。",
		"手順: 丸石が出るまで石の泉を動かす。最初に留まったとき進捗。"
	]
	quest.4200000000228022.title: "石は留まる"
	quest.4200000000228023.quest_desc: [
		"動いている泉に霊の写本をスニーク使用。報告が蓄えたパルスか、欠けたトーテムを名指ししたらチェック。",
		"手順: 石の泉に霊の写本をスニーク使用。報告が本当の不具合か満杯のバッファを名指ししたらチェック。"
	]
	quest.4200000000228023.title: "泉が答える"
	quest.4200000000228024.quest_desc: [
		"泉に充電したセルを置き、請いが止まらないようにする。",
		"手順: 太鼓の心臓でパルスセルを満たし、泉が養われたらチェック。"
	]
	quest.4200000000228024.title: "泉のセル"
	quest.4200000000228025.quest_desc: [
		"網は鉱石を探さない。網は鉱石に着地する場所を与える。聴きの穴の上に据える。",
		"手順: 辺境の石四つ、調律した残響二つ、霊織布二つ、銅の共鳴器。"
	]
	quest.4200000000228025.title: "聴く網"
	quest.4200000000228026.quest_desc: [
		"錨石四つが穴の角を支える。それがなければ網の立つ場所がない。",
		"手順: 残響片の上に辺境の石四つ。四つできる。"
	]
	quest.4200000000228026.title: "四つの錨"
	quest.4200000000228027.quest_desc: [
		"聴きの穴を通して最初の鉱石を呼び上げる。",
		"手順: 錨石のある穴の上に共鳴の網。最初の鉱石で進捗が発動する。"
	]
	quest.4200000000228027.title: "地面に問う"
	quest.4200000000228028.quest_desc: [
		"穴からの金の砂粒は、鉄の次の声。",
		"手順: 地面に問い続ける。金の砂粒が手にあればチェック。"
	]
	quest.4200000000228028.title: "穴からの金"
	quest.4200000000228029.quest_desc: [
		"穴はパルスを使う。網の上にセルを置き、請いが止まらないようにする。",
		"手順: 太鼓の心臓でパルスセルを満たし、写本の示す場所に据える。"
	]
	quest.4200000000228029.title: "穴が拍を守る"
	quest.420000000022802A.quest_desc: [
		"門枠十一と要石が道を環にする。枠が一つ欠ければ、歩みも一つ欠ける。",
		"手順: 辺境の石六つ、銅インゴット二つ、残響片。四つできる。"
	]
	quest.420000000022802A.title: "道の枠"
	quest.420000000022802B.quest_desc: [
		"要石は十二番目の石。それがなければ輪はただの模様。",
		"手順: 門枠四つ、共鳴の核、霊の欠片、パルスセル。"
	]
	quest.420000000022802B.title: "要石"
	quest.420000000022802C.quest_desc: [
		"道の門を灯す。枠十一、要石一つ、そしている場所。",
		"手順: 輪を仕上げて灯す。道が開くと進捗が発動する。"
	]
	quest.420000000022802C.title: "道を開く"
	quest.420000000022802D.quest_desc: [
		"要石に印をスニーク使用して書き留める。二つ目の要石に使い、二つを結ぶ。",
		"手順: 空白の印、織機の糸、霊の欠片、不定形。"
	]
	quest.420000000022802D.title: "目的地を記す"
	quest.420000000022802E.quest_desc: [
		"遠門で一つの次元から別の次元へ渡る。織機は一本の糸ではなかった。",
		"手順: 門の印で要石二つを結び、遠門を歩く。"
	]
	quest.420000000022802E.title: "長い糸"
	quest.420000000022802F.quest_desc: [
		"火の発電機。トーテムの近くに据える。手にした太鼓の心臓ではこの声は回らない。",
		"手順: 銅インゴット三つ、残り火の結び、火の印、辺境の板材二つ。"
	]
	quest.420000000022802F.title: "火の声"
	quest.4200000000228030.quest_desc: [
		"風の発電機。トーテムの近くに据え、六つが互いを聞けるようにする。",
		"手順: 霊織布四つ、嵐の翼、風の印、辺境の板材二つ。"
	]
	quest.4200000000228030.title: "風の声"
	quest.4200000000228031.quest_desc: [
		"水の発電機。トーテムの近くに据える。貯水槽と泉がこの声を聞く。",
		"手順: 革二つ、辺境の板材三つ、結び根、水の印章。"
	]
	quest.4200000000228031.title: "水の声"
	quest.4200000000228032.quest_desc: [
		"目覚めの鐘は霊の長い音。トーテムの近くに、ほかの五つと共に据える。",
		"手順: 鐘の欠片、銅インゴット四つ、霊の印、霊の欠片。"
	]
	quest.4200000000228032.title: "大地の目覚め"
	quest.4200000000228033.quest_desc: [
		"第六の発電機。織機の声には織機の糸が要る。歌われぬ者と織機の縫い手の長老がそれを持っている。",
		"手順: 辺境の水晶四つ、織機の糸二つ、霊織布二つ、共鳴の核。"
	]
	quest.4200000000228033.title: "第六の発電機"
	quest.4200000000228034.quest_desc: [
		"積石は場にパルスを貯め、六つの声が一つのバッファを分け合える。",
		"手順: 辺境の石六つ、結ばれた残響二つ、パルスセル。"
	]
	quest.4200000000228034.title: "パルスの積石"
	quest.4200000000228035.quest_desc: [
		"発電機六つを、互いに32ブロック以内で、声ごとに一つ、稼働させておけ。",
		"手順: 残り火の角笛、風のハープ、波の太鼓、目覚めの鐘、織機の錨、太鼓の心臓を32以内に。六つの声で進捗。"
	]
	quest.4200000000228035.title: "六つの声が歌う"
	quest.4200000000228036.quest_desc: [
		"貯水槽に、与え続けるよう頼む。十分間の水、そして印章は残る。",
		"手順: 合う印章とパルスを備え、儀式の円の中の儀式の火鉢に石板をスニーク使用。"
	]
	quest.4200000000228036.title: "与え続ける泉"
	quest.4200000000228037.quest_desc: [
		"歌われぬ者がまだ覚えている太鼓の円。任意の記念品。",
		"手順: 沈黙の太鼓にいる歌われぬ者が落とすことがある。任意。"
	]
	quest.4200000000228037.title: "太鼓の円"
	quest.4200000000228038.quest_desc: [
		"最初の儀式のあと、次の円のための空白の印。",
		"手順: 火鉢で最初の儀式。予備の空白の印を手にしたらチェック。"
	]
	quest.4200000000228038.title: "予備の印"
	quest.4200000000228039.quest_desc: [
		"火の作業場。八以内の火のトーテムとパルスが、鉱物の砂粒も含め、かまどのレシピをすべて回す。手持ちの太鼓の心臓ではこの窯は保てない。",
		"手順: かまど + 共鳴器 + 鈴。火のトーテム。パルスで砂粒を製錬する——手持ちの太鼓の心臓では動かせない。"
	]
	quest.4200000000228039.title: "窯の砂粒"
	quest.420000000022803A.quest_desc: [
		"工房のためにレシピの印章を織る。空の瓶は、それを入れていたスロットへ戻る。側面の入出力はスペクテイターと他の拠点を拒む。5.0以降は八ブロック以内に応答中の共鳴のトーテム（織機）が要り、なければ止まって、足りない声を告げる。",
		"手順: 霊の写本が印の織機の作り方を示す。瓶を据えると、そのスロットへ戻る。"
	]
	quest.420000000022803A.title: "印のための織機"
	quest.420000000022803B.quest_desc: [
		"安いパルスの灯が四つ（光る葦、欠片の灯、残響の壁灯、残り火の鉢）。格子から毎秒1–2パルスを引く。レッドストーンはそれらを暗くする。",
		"手順: 欠片の灯を作り、パルスから八ブロック以内に置き、夜が欲しければレッドストーンで暗くする。"
	]
	quest.420000000022803B.title: "パルスを飲む灯"
	quest.420000000022803C.quest_desc: [
		"霊の護符は十種、三つの部族スロットに着ける。Curios は不要。空を風に結ぶとクリエイティブ飛行。共鳴のトーテムをスニークして使って声を結束する。合唱は火鉢で近くの声をすべて結束する。",
		"手順: 空の護符を作り、風のトーテムにスニークして使う。霊の写本：霊の護符。"
	]
	quest.420000000022803C.title: "声を持つ護符"
	quest.420000000022803D.quest_desc: [
		"水の工房。霊装と同じく残響の拠点で位階を上げる。位階が高いほど速くなり、パルスをより使う。位階は拾っても残る。5.0以降は八ブロック以内に応答中の水の共鳴トーテムが要り、なければ止まって、足りない声を告げる。",
		"手順: 霊の写本の工房のページ。潮のポンプを貯槽の面に置き、黙ったままなら写本をスニークして使う。"
	]
	quest.420000000022803D.title: "貯槽のためのポンプ"
	quest.420000000022803E.quest_desc: [
		"パルスは今も一つが 100 FE になる。無位階の変換は毎秒 60 パルス。残響調律、次に残響結束、次に残響顕現でアダプターの位階を上げ、素手のステータスが現在の速度を告げる。それでも FE は受け取れない。",
		"手順: 調和励振器を残響調律、次に残響結束、次に残響顕現へスニークして使う。診断が60を超える速度を告げたらチェックする。"
	]
	quest.420000000022803E.title: "電流の位階"
	quest.420000000022803F.quest_desc: [
		"置いた共鳴のトーテム（パルス40）に、霊装の部品か護符をスニークして使い、その声を結束する。混ぜたセットが想定だ。トーテムは消費されない。織機には織機のトーテムが要る。",
		"手順: 近くにパルス40があるトーテムへ、道具、防具、または護符をスニークして使う。ツールチップが結束した声を告げたらチェック。"
	]
	quest.420000000022803F.title: "声を結束する"
	quest.4200000000228040.quest_desc: [
		"葦の灯。拠点の道のための安いパルスの光。任意。",
		"手順: 光る葦を作る。パルスの近くに置く。任意。"
	]
	quest.4200000000228040.title: "葦の灯"
	quest.4200000000228041.quest_desc: [
		"パルスを飲む壁灯。任意。",
		"手順: 残響の壁灯を作り、掛ける。任意。"
	]
	quest.4200000000228041.title: "エコーの壁灯"
	quest.4200000000228042.quest_desc: [
		"パルスで灯る拠点の火の鉢。任意。",
		"手順: 残り火の鉢を作る。任意。"
	]
	quest.4200000000228042.title: "残り火の鉢"
	quest.4200000000228043.quest_desc: [
		"風の護符を天井から吊る。辺境の拠点の家具：腰掛け、机、壺、敷物、棚、そしてこれ。任意。",
		"手順: 風の護符を作り、吊る。任意のお土産。"
	]
	quest.4200000000228043.title: "風に乗る護符"
	quest.4200000000228044.quest_desc: [
		"合唱は儀式の火鉢で近くのトーテムの声をすべて結束する。空が手元にあれば任意。",
		"手順: 合唱の護符を作り、声が届く火鉢でスニークして使う。任意。"
	]
	quest.4200000000228044.title: "近くのすべての声"
	quest.4200000000228045.quest_desc: [
		"斧はツルハシと同じくパルスを使う。残響の拠点で位階を上げ、トーテムをスニークして使って声を結束する。任意。",
		"手順: 霊装の斧を作る。ツルハシがあれば任意。"
	]
	quest.4200000000228045.title: "材木の刃"
	quest.4200000000228046.quest_desc: [
		"レンガとボウルを銅三つに重ねる。火のついた焚き火、火、マグマ、溶岩、または残り火の鉢の上に置く。パルスはまったく要らない。材料は四つまでとボウル一つ、順不同、一食およそ十二秒。ホッパーは上と横から入れ、下から食事を取り出す。",
		"手順: レンガとボウルを銅三つに重ねる。焚き火、火、マグマ、溶岩、または残り火の鉢の上に置く。パルスは不要。"
	]
	quest.4200000000228046.title: "拠点の鍋"
	quest.4200000000228047.quest_desc: [
		"残り火の荒野の熱い赤い芋。摘んだものが種になる。ジャガイモのように耕地に植える。霊装の鍬は一振りで刈り、植え直す。",
		"手順: 門の太鼓を通って、残り火の荒野で野生に育つ。摘んだものが種になる。耕地に植える。"
	]
	quest.4200000000228047.title: "熾根"
	quest.4200000000228048.quest_desc: [
		"葦の湿地で野生に育つ。ひとむら摘み、摘んだものを植える。耕した土で四段階育ち、ハチが受粉する。",
		"手順: 門の太鼓を通って、葦の湿地で野生に育つ。摘んだものを耕地に植える。"
	]
	quest.4200000000228048.title: "沼沢米"
	quest.4200000000228049.quest_desc: [
		"雪原のもの。霊の薬釜の薬草にもなる。",
		"手順: 門の太鼓を通って、雪原で野生に育つ。摘んだものを耕地に植える。"
	]
	quest.4200000000228049.title: "霜の実"
	quest.420000000022804A.quest_desc: [
		"微光の尾根のもの。霊の薬釜の薬草でもあり、作物でもある。",
		"手順: 門の太鼓を通って、微光の尾根で野生に育つ。摘んだものを耕地に植える。"
	]
	quest.420000000022804A.title: "微光豆"
	quest.420000000022804B.quest_desc: [
		"ステップのもので、部族の料理の大半の土台になる穀物だ。ほかより先にひと畝育てる。",
		"手順: 門の太鼓を通って、ステップで野生に育つ。摘んだものを耕地に植える。"
	]
	quest.420000000022804B.title: "草原穀物"
	quest.420000000022804C.quest_desc: [
		"草原の穀を二つと鉄の砂粒を一つ、炉の鍋へ。部族の料理を食べると、その恩恵を五分間帯びる。砂利歌いのものは鉱石からより多く割る。部族があなたを友と呼ぶと、その親族は作物四つでその料理を売り、部族の炉でその部族の料理を供えると立場が六増える。",
		"手順: 草原の穀二つと鉄の砂粒を、熱の上の炉の鍋へ。砂利歌いの親族は友の立場でこれを売る。"
	]
	quest.420000000022804C.title: "砂利歌いのパン"
	quest.420000000022804D.quest_desc: [
		"生の獲物を二つと残り火の根を一つ。生の獲物は辺境の獲物の獣から落ちる。縁歩きの恩恵：忍び足のあいだ、落ちない。どの部族にも料理がある。JEI は鍋の項に九つすべてを載せる。",
		"手順: 生の獲物二つと残り火の根を炉の鍋へ。生の獲物は辺境の獲物から落ちる。"
	]
	quest.420000000022804D.title: "縁歩きの干し肉"
	quest.420000000022804E.quest_desc: [
		"守り手の根つぶし、砂粒焼きパン、残り火の根と草原の穀を鍋へ。宴を固体ブロックに置くと六人分を保つ。どれも腹を満たし、八分間、大地の祝福を授ける——より速く掘り、踏ん張る。どの声にも、自分の料理の宴がある。",
		"手順: 守り手の根つぶし、砂粒焼きパン、残り火の根、草原の穀を炉の鍋へ。置く。六人分。"
	]
	quest.420000000022804E.title: "キャンプの食卓"
	quest.420000000022804F.quest_desc: [
		"大釜の周りに骨と鉄、その下に骨の鈴。熱の上に置く。席は三つ：袋から出す生の試薬、辺境の草、基剤——ガラス瓶はチンキ二つ、ハニカムは軟膏二つ、木炭は香四つ。一回は十秒、格子からパルス24。八ブロック以内で最も近いトーテムが煎じに歌い込む。",
		"手順: 大釜の周りに骨と鉄、下に骨の鈴。熱の上に置く。8以内のトーテムが煎じを形づくる。"
	]
	quest.420000000022804F.title: "火の上の薬缶"
	quest.4200000000228050.quest_desc: [
		"試薬の系統が薬を決める：焚き付けは力、冷却は火炎耐性、解毒は毒を解き、修繕は再生、ほかもそうだ。チンキは三分続き、瓶を返す。どの薬も霊の病、歌われぬ静寂、ほつれ身、レイの病を解く。",
		"手順: 霊の薬釜——生の試薬、辺境の草、ガラス瓶。十秒、パルス24、チンキ二つ。"
	]
	quest.4200000000228050.title: "飲め"
	quest.4200000000228051.quest_desc: [
		"基剤はハニカム。軟膏は自分か、友、村人、使い魔に使え：一度にハート三つ、有害な効果はすべて消え、薬はチンキの半分の時間。これを一束持つかどうかで、辺境の厳しい夜と歩いて帰る道が分かれる。",
		"手順: 霊の薬釜——生の試薬、辺境の草、ハニカム。一回で軟膏二つ。"
	]
	quest.4200000000228051.title: "塗れ"
	quest.4200000000228052.quest_desc: [
		"基剤は木炭。香を儀式の火鉢に据える——十六本まで、印もパルスも要らず——二秒ごとに八ブロック以内の皆が薬を受け、使い魔はハート一つ繕われる。一本は三十秒燃える。レッドストーンで消え、素手でしゃがめば取り戻せる。",
		"手順: 霊の薬釜——生の試薬、辺境の草、木炭。一回で香四つ、儀式の火鉢で焚く。"
	]
	quest.4200000000228052.title: "皆のために焚け"
	quest.4200000000228053.quest_desc: [
		"棒の上の顕現インゴットを二つの骨の鈴が挟む。使用を長押しすると、半秒ごとに六ブロック以内で見ている相手か自分を、パルス2でハート四分の三だけ繕う。ほかの霊装と同じく残響の台で位を得て、結束からは振るたび霊の病が一段和らぐ。",
		"手順: 棒の上の顕現インゴットを二つの骨の鈴が挟む。使用を長押しし、見ている相手を繕う。"
	]
	quest.4200000000228053.title: "振れ"
	quest.4200000000228054.quest_desc: [
		"丸石をマグマブロックの上に置くと四つできる。熱の上では湯気を立てる。熱い石が五ブロック以内にあり、頭上に屋根のあるベッドで夜をまるごと眠れば、完全に癒え、清められ、十分間の霊の祝福がついて、病は根づけない。",
		"手順: マグマブロックの上に丸石で四つ。屋根のあるベッドから五ブロック以内、熱の上に置け。"
	]
	quest.4200000000228054.title: "小屋の一夜"
	quest.4200000000228055.quest_desc: [
		"石二つ、苔背の鱗と霊の葦を霊の印の周りに置くと、印は手元に戻る。儀式の円の中で、霊の印を据えた火鉢に500パルスで唱えると、十二ブロック以内の皆がハート十個分癒え、清められ、祝福され、円は十分開いたままになる。倒れた使い魔の霊の残滓を先に台座へ置けば、完全な姿で戻る。",
		"手順: 石二つ、苔背の鱗、霊の葦、霊の印、不定形。印は戻る。儀式の円の中の、印を据えた火鉢に唱える。"
	]
	quest.4200000000228055.title: "儀式板：癒しの輪"
	quest.4200000000228056.quest_desc: [
		"顕現インゴット、骨の鈴、棒を斜めに置く。ダメージは七、射程は一・五増し、走りながらの突きは35パーセント強く当たる。その下は刃で、残響の台で位を得て、残響の一撃にパルスを使い、トーテムの声を受ける。裂け目の猟犬を腕の長さに押しとどめる。",
		"手順: 顕現インゴット、骨の鈴、棒を斜めに。残響の台で、刃と同じく位を得る。"
	]
	quest.4200000000228056.title: "まず射程"
	quest.4200000000228057.quest_desc: [
		"顕現インゴット四つをT字に、骨の鈴の上へ置く。ダメージ十、射程は半分増し、重い——手にあるあいだ歩きが遅くなる——そして一族で最も広く、最も強い薙ぎ。ハルバード、戦斧、戦鎚、短剣、大鎌、トライデントも同じ作りで、それぞれ射程、速さ、重さをほかと引き換えにする。",
		"手順: 顕現インゴット四つをT字に、骨の鈴の上へ。重い。最も広い薙ぎ。"
	]
	quest.4200000000228057.title: "最も広い薙ぎ"
	quest.4200000000228058.quest_desc: [
		"糸と銅の共鳴器を骨の鈴の周りに置く。持ち歩くセルのパルスで音の弾を撃ち、詩矢も受ける。すぐ再び放て、急ぐときは半引き。",
		"手順: 糸と銅の共鳴器を骨の鈴の周りに。持ち歩くパルスで音の弾を撃つ。"
	]
	quest.4200000000228058.title: "歌う弓"
	quest.4200000000228059.quest_desc: [
		"顕現インゴットをパルスの弓の両脇に、下にトリップワイヤーフックと棒。使用を長押しして装填する——先にパルス10、満引きより少し長い——それからもう一度使用して撃つ。約1.5倍の強さで当たり、ほぼまっすぐ飛び、構えは好きなだけ保つ。",
		"手順: パルスの弓の両脇に顕現インゴット、下にトリップワイヤーフックと棒。使用を長押しして装填し、使用して撃つ。"
	]
	quest.4200000000228059.title: "弓の、より重い姉妹"
	quest.420000000022805A.quest_desc: [
		"歌の作業台には、出力のそばに武器の座がある。手が届くところにトーテムを立て、格子にパルスを入れ、同種の強化した試薬四つを入れた試薬の袋をホットバーに保ち、霊装の武器を座らせ、試薬を選んで塗油を押す：試薬四つとパルス32。灼熱は焼き、嵐呼びは雷を弧にし、血の渇きは命を奪い、修繕は武器を直す——全部で十一、一度に一つで、別の試薬がそれを置き換える。パックが tribalpower:anointable を開かない限り、作業台の仕事を受けるのは霊装だけだ。武器が一つを帯びたら、これを完了する。",
		"手順: 歌の作業台の武器の座に霊装の武器、袋に強化した試薬四つ、パルス32で塗油を押す。塗油されたらチェック。"
	]
	quest.420000000022805A.title: "刃の中の試薬"
	quest.420000000022805B.quest_desc: [
		"霊の葦の周りにツタ、それにエンダーパールで二つできる。同じ柱の各階に一つ置くと、互いに見つけ合い、接続も動力も要らない。跳ぶと上の次の昇降機へ上がり、スニークすると下のへ降り、各方向48ブロックまで。上に天井がある昇降機は飛ばされる。",
		"手順: 霊の葦の周りにツタとエンダーパールで二つできる。一つの柱に積み、跳んで上がり、スニークで下がる。"
	]
	quest.420000000022805B.title: "柱を上へ"
	quest.420000000022805C.quest_desc: [
		"紐の下に霊の葦。生物に使えば取り込み、ブロックに使えば下ろし、無事で完全なまま。プレイヤーも、ボスも、辺境の精鋭もだめ。織りは二回、往復一つで、銅と顕現と共鳴の壺はもっと持ち、共鳴は決して擦り切れない。残りが一回のときは生物を取らない。",
		"手順: 紐の下に霊の葦。生物に使って取り込み、ブロックに使って下ろす。二回。"
	]
	quest.420000000022805C.title: "生物を家へ運ぶ"
	quest.420000000022805D.quest_desc: [
		"音符ブロックの周りに、板材の上へ革。門の儀式を、終わりにポータルのない遊びとして。入っているすべての曲を、拍が線に届くとき A、S、D、F で奏でる。曲ごとの自己ベストと、サーバー上位五人の掲示を残す。本物の門の太鼓の前に、ここで練習しろ。",
		"手順: 音符ブロックの周りに、板材の上へ革。使って曲を選び、A、S、D、F で奏でる。"
	]
	quest.420000000022805D.title: "楽しみの太鼓"
	quest.420000000022805E.quest_desc: [
		"霊の印を囲むグロウストーン四つ、顕現インゴット二つ、金のニンジン、霊織布。使って身につけ、スニーク使用で護符の枠が三つ開く。灯籠の護符は霊の声を帯びる。暗視、そして身にかかった声の祝福はどれも半分長く続く。身につけた護符は、所持しているパルスセルから、声ごとに二秒あたりパルスを2消費する。",
		"手順: 霊の印を囲むグロウストーン四つ、顕現インゴット二つ、金のニンジン、霊織布。使って身につける。スニーク使用で枠が開く。"
	]
	quest.420000000022805E.title: "身につける光"
	quest.420000000022805F.quest_desc: [
		"部族が客人と呼んだら、その長老を右クリックして話せ。仕事を頼むと依頼を渡す——一日に三つ開き、部族ごとに一つだけ所持し、それぞれが評判を払い、三つごとに部族の標。物語を頼むと七歩の道が始まる。友人、彼らが重んじるもの、火のそばでの狩り、キャンプでの儀式、彼らの料理、そして送り先。最後の一歩は守護者との試練。物語を一つ終え、その遺物を所持しろ。",
		"手順: 客人以上で部族の長老を右クリックし、物語を頼む。七歩は守護者で終わる。最初の遺物で進捗が発動する。"
	]
	quest.420000000022805F.title: "語られた物語"
	quest.4200000000228060.quest_desc: [
		"浮島の守り手の遺物。その物語はステップの踏み荒らされた輪にいる暴走の霊で終わり、試練に勝てば長老が渡す。所持品のどこに入れていても、評判がどうであれ彼らの恩恵を保つ。畑を踏み荒らすことはない。",
		"手順: 浮島の守り手の物語を長老と終える。試練はステップの暴走の霊。"
	]
	quest.4200000000228060.title: "守られた熾火"
	quest.4200000000228061.quest_desc: [
		"砂利歌いの遺物。物語は水晶の野の歌う裂け目にいるプリズムの蛇で終わり、試練に勝てば長老が遺物を渡す。所持品のどこに入れていても、信望がどうであれ彼らの恩恵を保ち、鉱石からより多く採れる。",
		"手順: 砂利歌いの物語をその長老と終える。試練は水晶の野のプリズムの蛇。"
	]
	quest.4200000000228061.title: "鳴る石"
	quest.4200000000228062.quest_desc: [
		"根結びの遺物。物語は葦の湿地の溺れた根にいる沼の女家長で終わり、試練に勝てば長老が遺物を渡す。所持品のどこに入れていても、信望がどうであれ彼らの恩恵を保ち、周りの作物が急いで育つ。",
		"手順: 根結びの物語をその長老と終える。試練は葦の湿地の沼の女家長。"
	]
	quest.4200000000228062.title: "最初の根"
	quest.4200000000228063.quest_desc: [
		"縁歩きの遺物。物語は高地のねぐらにいる嵐のルフで終わり、試練に勝てば長老が遺物を渡す。所持品のどこに入れていても、信望がどうであれ彼らの恩恵を保ち、しゃがんでいる間は決して落ちない。",
		"手順: 縁歩きの物語をその長老と終える。試練は高地の嵐のルフ。"
	]
	quest.4200000000228063.title: "橋釘"
	quest.4200000000228064.quest_desc: [
		"太鼓の心臓の遺物。物語は残り火の荒野の鉱滓の玉座にいる鉱滓の巨神で終わり、試練に勝てば長老が遺物を渡す。所持品のどこに入れていても、信望がどうであれ彼らの恩恵を保ち、振りが速くなる。",
		"手順: 太鼓の心臓の物語をその長老と終える。試練は残り火の荒野の鉱滓の巨神。"
	]
	quest.4200000000228064.title: "安定した太鼓"
	quest.4200000000228065.quest_desc: [
		"模様織りの遺物。物語は浅瀬の潮の石にいる潮の鼓手で終わり、試練に勝てば長老が渡す。所持品のどこに入れていても、信望がどうであれ恩恵は残り、近くの残響の台は倍働く。",
		"手順: 模様織りの物語を長老と終える。試練は浅瀬の潮の鼓手。"
	]
	quest.4200000000228065.title: "静かな歯車"
	quest.4200000000228066.quest_desc: [
		"群れの守り手の遺物。物語は雪原の積石の輪にいる積石の亡霊で終わり、試練に勝てば長老が渡す。所持品のどこに入れていても、信望がどうであれ恩恵は残り、刺されない。",
		"手順: 群れの守り手の物語を長老と終える。試練は雪原の積石の亡霊。"
	]
	quest.4200000000228066.title: "巣の印章"
	quest.4200000000228067.quest_desc: [
		"印彫りの遺物。物語は微光の尾根の封じられた門にいる宝庫の番兵で終わり、試練に勝てば長老が渡す。所持品のどこに入れていても、信望がどうであれ恩恵は残り、護符はパルスを半分しか求めない。",
		"手順: 印彫りの物語を長老と終える。試練は微光の尾根の宝庫の番兵。"
	]
	quest.4200000000228067.title: "丁寧な印章"
	quest.4200000000228068.quest_desc: [
		"織機の縫い手の遺物。物語は沈黙の太鼓の歌われぬ者で終わり、試練に勝てば長老が渡す。所持品のどこに入れていても、信望がどうであれ恩恵は残り、より安く歌える。",
		"手順: 織機の縫い手の物語を長老と終える。試練は沈黙の太鼓の歌われぬ者。"
	]
	quest.4200000000228068.title: "第九の糸"
	quest.4200000000228069.quest_desc: [
		"すべての部族の物語が終わった：守護者八体と歌われぬ者に向き合った。遺物九つを所持品にそろえれば、第九の盟約は手が届く。 `/tribalpower standing` は各部族との信望を示す。",
		"手順: 九つの物語をすべて終える。九つ目の遺物を手にすると進捗が発動する。"
	]
	quest.4200000000228069.title: "九つの遺物"
	quest.420000000022806A.quest_desc: [
		"残り火の荒野の鉱滓の玉座。石の輪の中央に守護者の祭壇があり、磨かれた深層岩の上、灯したろうそく四本のあいだ、頭上は開けた空。祭壇を素手でしゃがみながら使うと、欲しいものを告げる。マグマの鱗を八つ。載せて下がれ。しゃがんで叩きつけに備えよ。奮い立つと輪が燃え、残り火のインプが鉱滓から立つ。体力が半分になると奮い立ち、自国の生き物を呼ぶ。それらは何も落とさない。三十秒放っておくと再び眠り、祭壇は呼び出しのあいだ二十分休む。鉱滓の核を落とし、倒れると太鼓の心臓の物語が終わる。",
		"手順: その国の守護者の祭壇を素手でしゃがみながら使い、告げた試薬を八つ載せて勝て。討伐で進捗が発動する。"
	]
	quest.420000000022806A.title: "鉱滓の巨神、鎮まる"
	quest.420000000022806B.quest_desc: [
		"葦の湿地の溺れた根。石の輪の中央に守護者の祭壇があり、磨かれた深層岩の上、灯したろうそく四本のあいだ、頭上は開けた空。祭壇を素手でしゃがみながら使うと、欲しいものを告げる。葦の牙を八つ。載せて下がれ。罠が引き寄せて遅くする。固い地面に残り、呼ぶ葦の忍び寄る者を切り倒せ。体力が半分になると奮い立ち、自国の生き物を呼ぶ。それらは何も落とさない。三十秒放っておくと再び眠り、祭壇は呼び出しのあいだ二十分休む。湿地の心を落とし、倒れると根結びの物語が終わる。",
		"手順: その国の守護者の祭壇を素手でしゃがみながら使い、告げた試薬を八つ載せて勝て。討伐で進捗が発動する。"
	]
	quest.420000000022806B.title: "沼の女家長、鎮まる"
	quest.420000000022806C.quest_desc: [
		"雪原の積石の輪。石の輪の中央に守護者の祭壇があり、磨かれた深層岩の上、灯したろうそく四本のあいだ、頭上は開けた空。祭壇を素手でしゃがみながら使うと、欲しいものを告げる。霜の大顎を八つ。載せて下がれ。息は前のすべてを凍らせる。背後に回れ。呼ぶ霜の這い者は遅い。体力が半分になると奮い立ち、自国の生き物を呼ぶ。それらは何も落とさない。三十秒放っておくと再び眠り、祭壇は呼び出しのあいだ二十分休む。積石塚の石を落とし、倒れると群れの守り手の物語が終わる。",
		"手順: その国の守護者の祭壇を素手でしゃがみながら使い、告げた試薬を八つ載せて勝て。討伐で進捗が発動する。"
	]
	quest.420000000022806C.title: "積石の亡霊、鎮まる"
	quest.420000000022806D.quest_desc: [
		"水晶の野の歌う裂け目。石の輪の中央に守護者の祭壇があり、磨かれた深層岩の上、灯したろうそく四本のあいだ、頭上は開けた空。祭壇を素手でしゃがみながら使うと、欲しいものを告げる。プリズムの甲殻を八つ。載せて下がれ。光の矢を放ち、あなたを光らせて印をつける。横にずれて詰め、奮い立つと加わる二本目に注意。体力が半分になると奮い立ち、自国の生き物を呼ぶ。それらは何も落とさない。三十秒放っておくと再び眠り、祭壇は呼び出しのあいだ二十分休む。プリズムの核を落とし、倒れると砂利歌いの物語が終わる。",
		"手順: その国の守護者の祭壇を素手でしゃがみながら使い、告げた試薬を八つ載せて勝て。討伐で進捗が発動する。"
	]
	quest.420000000022806D.title: "プリズムの蛇、鎮まる"
	quest.420000000022806E.quest_desc: [
		"微光の尾根の封じられた門。石の輪の中央に守護者の祭壇があり、磨かれた深層岩の上、灯したろうそく四本のあいだ、頭上は開けた空。祭壇を素手でしゃがみながら使うと、欲しいものを告げる。番兵の印を八つ。載せて下がれ。辺境で最も重い鎧と、尾根から投げ落とす薙ぎ。奮い立つと、三秒ずつ身を守る。やり過ごせ。体力が半分になると奮い立ち、自国の生き物を呼ぶ。それらは何も落とさない。三十秒放っておくと再び眠り、祭壇は呼び出しのあいだ二十分休む。宝庫の印を落とし、倒れると印彫りの物語が終わる。",
		"手順: その国の守護者の祭壇を素手でしゃがみながら使い、告げた試薬を八つ載せて勝て。討伐で進捗が発動する。"
	]
	quest.420000000022806E.title: "宝庫の番兵、鎮まる"
	quest.420000000022806F.quest_desc: [
		"浅瀬の潮の石：石の輪で、中央に守護者の祭壇。磨かれた深層岩の上、灯したろうそく四本のあいだ、頭上は開けた空。祭壇を素手でスニーク使用すると、欲しいものを告げる——塩水の牙を八つ——それから載せて下がれ。一拍ごとに全員を引き寄せ、傷つける。岸から戦え。背中はしっかりしたものへ向けろ。体力が半分になると奮起し、自国の生き物を呼ぶ。それらは何も落とさない。三十秒放っておくと再び眠り、祭壇は呼び出しのあいだ二十分休む。潮の殻を落とし、倒れると模様織りの物語が終わる。",
		"手順: その国の守護者の祭壇を素手でしゃがみながら使い、告げた試薬を八つ載せて勝て。討伐で進捗が発動する。"
	]
	quest.420000000022806F.title: "潮の鼓手、鎮まる"
	quest.4200000000228070.quest_desc: [
		"ステップの踏み荒らされた輪：石の輪で、中央に守護者の祭壇。磨かれた深層岩の上、灯したろうそく四本のあいだ、頭上は開けた空。祭壇を素手でスニーク使用すると、欲しいものを告げる——すねの腱を八つ——それから載せて下がれ。突進する。横に避け、通り抜けるときに打て。巣穴の歯軋りが地上に出たら、ブロックの上に立て。体力が半分になると奮起し、自国の生き物を呼ぶ。それらは何も落とさない。三十秒放っておくと再び眠り、祭壇は呼び出しのあいだ二十分休む。群れの角を落とし、倒れると浮島の守り手の物語が終わる。",
		"手順: その国の守護者の祭壇を素手でしゃがみながら使い、告げた試薬を八つ載せて勝て。討伐で進捗が発動する。"
	]
	quest.4200000000228070.title: "暴走の霊、鎮まる"
	quest.4200000000228071.quest_desc: [
		"高地のねぐら：石の輪で、中央に守護者の祭壇。磨かれた深層岩の上、灯したろうそく四本のあいだ、頭上は開けた空。祭壇を素手でスニーク使用すると、欲しいものを告げる——嵐の翼を八つ——それから載せて下がれ。急降下してあなたを空へ放る。奮起すると、急降下のたびに雷が続く。弓と屋根のほうが盾より役に立つ。体力が半分になると奮起し、自国の生き物を呼ぶ。それらは何も落とさない。三十秒放っておくと再び眠り、祭壇は呼び出しのあいだ二十分休む。嵐の羽を落とし、倒れると縁歩きの物語が終わる。",
		"手順: その国の守護者の祭壇を素手でしゃがみながら使い、告げた試薬を八つ載せて勝て。討伐で進捗が発動する。"
	]
	quest.4200000000228071.title: "嵐のルフ、鎮まる"
	quest.4200000000228072.quest_desc: [
		"守護者の核八つと歌われぬ者の心、不定形。核一つと織機の糸では、代わりに共鳴の核が六つできる。両方ほしいなら、落ちるものをもう一組取れ。どの守護者のボスバーも、その部族の色をまとう。",
		"手順: 守護者の核八つと歌われぬ者の心、不定形。遺物九つを身につけ、織機の円で唱える。"
	]
	quest.4200000000228072.title: "九つの石板"
	quest.4200000000228073.quest_desc: [
		"織機の円を描け——儀式の円の内側、火鉢に織機の印を据えたもの——遺物九つをすべて身につけて石板を唱えよ。儀式は成る前にそのパルスを引く。九つの光が昇り、一つずつ各部族の色となる。それ以降どの部族も少なくとも同胞としてあなたを扱い、九つの恩恵がしばらくあなたに落ち着き、オーロラはその下に立つ夜ごとに満ちて燃える。プレイヤーにつき一度で、二度目は円を灯すだけ。",
		"手順: 儀式の円の中の火鉢に織機の印、所持品に遺物九つ。火鉢に石板をスニーク使用。"
	]
	quest.4200000000228073.title: "織機は合意する"
	quest.4200000000228074.quest_desc: [
		"織機の歴史の断片十六が辺境に刻まれている。廃墟の壁に彫り石が八つ、守護者の地に二×二の壁画が八つ。一つを右クリックすると読める。霊の写本がそれを残し、年代記の節が順番に並べる。十六すべてを読めば、物語は揃う。",
		"手順: 辺境の廃墟にある彫り石八つと、守護者の地にある壁画八つをすべて右クリックする。"
	]
	quest.4200000000228074.title: "揃った年代記"
	quest.4200000000228075.quest_desc: [
		"辺境の廃墟の壁に据えてある。古い工房、沈んだ社、墳丘、墓所、宝庫。見つけた場所で読み、拾って自分の壁に据える。読んだものは、読んだまま残る。",
		"手順: 辺境の廃墟の壁に据えてある。読んでから壊し、自分の壁に据える。"
	]
	quest.4200000000228075.title: "覚えている石"
	quest.4200000000228076.quest_desc: [
		"各守護者の地で、幅二ブロック、高さ二ブロック。それぞれ立つ国を描く。どこを読んでも、全体を読む。一つの塊として置き、一つの塊として外れる。クリエイティブで切った壁画は、しゃがみクリックで章が変わる。",
		"手順: 各守護者の地に二×二で立つ。読んでから丸ごと外し、家に置く。"
	]
	quest.4200000000228076.title: "国を描く壁"
	quest.4200000000228077.quest_desc: [
		"辺境は自分から動く。降灰、微光の嵐、白魔、葦霧が国を閉ざし、昼に霊を起こす。それぞれ一つの声の発電機を養い、別の声のを妨げる。ときどき、一つの声のレイの糸が高まる。それを運ぶ収集器は倍を出す。だが収集器のないむき出しの交差に立つと、レイの病が地面を揺らし、パルスを抜く。どの部族も順番に祭りの日を持つ。宴に加われば贈り物。そばへ漂うあたたかい光は彷徨う霊。届けば、その国の物語を一行と、小さな贈り物。嵐と高まりは二分前に、チャットとホットバーの上で告げられる。一つを凌いだら、これをチェックする。",
		"手順: 天候、高まり、祭りの日のいずれかのあいだ辺境にいる。済んだらチェックする。"
	]
	quest.4200000000228077.title: "辺境は息をする"
	quest.420000000023058C.quest_desc: [
		"砂利歌いたちは、石を二度と同じ切り方にはしない。この台はあらゆる切りを覚えている。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 石＋台の部品は JEI に。ブロックを入れて、変種を選ぶ。"
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"木にも同じ手。一枚から百枚の板。",
		"手順: Chipped の大工台は JEI に。石工台と同じ考えで、木向け。"
	]
	quest.420000000023058D.title: "大工台"
	quest.420000000023058E.quest_desc: [
		"砂をガラスに、それからガラスを光が取るあらゆる形に。",
		"手順: Chipped の作業台は JEI に（石工、大工、ガラス吹き…）。台にブロックを入れ、切りを選ぶ。"
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"羊毛と布、織り直したもの。織機を繕っている浮島には、ふさわしい。",
		"手順: Chipped の作業台は JEI に（石工、大工、ガラス吹き…）。台にブロックを入れ、切りを選ぶ。"
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"葉、苗木、育つもの。それぞれの変種に分けてある。",
		"手順: Chipped の作業台は JEI に（石工、大工、ガラス吹き…）。台にブロックを入れ、切りを選ぶ。"
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"色付きのブロックと、もっと妙な石。変種を選ぶ。台が残りを持っている。",
		"手順: Chipped の作業台は JEI に（石工、大工、ガラス吹き…）。台にブロックを入れ、切りを選ぶ。"
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"金属と、機械の顔をしたブロック。好みに切る。",
		"手順: Chipped の作業台は JEI に（石工、大工、ガラス吹き…）。台にブロックを入れ、切りを選ぶ。"
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"石工台にブロックを入れ、変種の壁から選ぶ。",
		"手順: 石を四つ正方形に、または石切台。"
	]
	quest.4200000000230593.title: "石の切り"
	quest.4200000000230594.quest_desc: [
		"大工台は木に同じことをする。",
		"手順: クラフト格子に原木一つで四つ。"
	]
	quest.4200000000230594.title: "板の切り"
	quest.4200000000230595.quest_desc: [
		"ガラス吹きが知るガラス板は、どれもここから始まる。",
		"手順: 砂を製錬する。ハンマーで丸石を砂利に、砂利を砂に、それからかまどへ。"
	]
	quest.4200000000230595.title: "ガラスの切り"
	quest.4200000000230596.quest_desc: [
		"砂利歌いがいちばん争いたがる石。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000230596.title: "深層岩の変種"
	quest.4200000000230597.quest_desc: [
		"焼いた粘土、百通り。",
		"手順: レンガのアイテム四つ。粘土玉は製錬するとレンガになる。"
	]
	quest.4200000000230597.title: "レンガの変種"
	quest.4200000000230598.quest_desc: [
		"浮島の砂利、細く切ってある。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000230598.title: "砂岩の変種"
	quest.4200000000240599.quest_desc: [
		"浮島を、誰かが暮らす場所に変える最初のもの。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: オークの板材は JEI に。Handcrafted の最初の品。"
	]
	quest.4200000000240599.title: "椅子"
	quest.420000000024059A.quest_desc: [
		"考えているあいだ写本を置く場所。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.420000000024059A.title: "机"
	quest.420000000024059B.quest_desc: [
		"樽が働くあいだ、Clowder が座る場所。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.420000000024059B.title: "ベンチ"
	quest.420000000024059C.quest_desc: [
		"また読もうと思ったままの写本のページのために。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.420000000024059C.title: "棚"
	quest.420000000024059D.quest_desc: [
		"そこにあるべき姿の Handcrafted の収納。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.420000000024059D.title: "戸棚"
	quest.420000000024059E.quest_desc: [
		"浮島の守り手はよく眠った。同じように眠れ。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.420000000024059E.title: "飾りベッド"
	quest.420000000024059F.quest_desc: [
		"ランタン、一ページ、両方の場所。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.420000000024059F.title: "ナイトテーブル"
	quest.42000000002405A0.quest_desc: [
		"枠を切り、好きなブロックで着せる。形は一つ、肌はどれでも。",
		"手順: 鉄インゴットを枠付きキューブ三つの上に。枠付きブロックを切る。"
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"カモフラージュのブロックを待つ、真っさらな立方体。",
		"手順: 枠のこ、それから枠付きの立方体／ハーフ／階段。カモフラはブロックを持って右クリック。"
	]
	quest.42000000002405A1.title: "Framed Cube"
	quest.42000000002405A2.quest_desc: [
		"半分の枠、選択肢は二倍。",
		"手順: 枠のこ、それから枠付きの立方体／ハーフ／階段。カモフラはブロックを持って右クリック。"
	]
	quest.42000000002405A2.title: "Framed Slab"
	quest.42000000002405A3.quest_desc: [
		"寄りかかる壁の、どんな姿でもまとう段。",
		"手順: 枠のこ、それから枠付きの立方体／ハーフ／階段。カモフラはブロックを持って右クリック。"
	]
	quest.42000000002405A3.title: "Framed Stairs"
	quest.42000000002405A4.quest_desc: [
		"虚空がくれなかった屋根と屋根の線のために。",
		"手順: 枠のこ、それから枠付きの立方体／ハーフ／階段。カモフラはブロックを持って右クリック。"
	]
	quest.42000000002405A4.title: "Framed Slope"
	quest.42000000002405A5.quest_desc: [
		"縁歩きは、より少ないもので虚空を渡した。次の浮島へ、格好よくたどり着け。",
		"手順: JEI で、合う石／木から Macaw の橋。"
	]
	quest.42000000002405A5.title: "ロープ橋"
	quest.42000000002405A6.quest_desc: [
		"浮島の上に屋根。ここ上空の雨は、いつだって野心だけ。",
		"手順: JEI で、合う木から Macaw の屋根。"
	]
	quest.42000000002405A6.title: "屋根裏の屋根"
	quest.42000000002405A7.quest_desc: [
		"心地よさも基盤だ。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.42000000002405A7.title: "ソファ"
	quest.42000000002405A8.quest_desc: [
		"Farmer's Delight の系統のための台所の縁。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.42000000002405A8.title: "調理台"
	quest.42000000002405A9.quest_desc: [
		"ウィスカー写本が余白を得るところ。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.42000000002405A9.title: "文机"
	quest.42000000002405AA.quest_desc: [
		"机に合う小さな収納。",
		"手順: 板材の Handcrafted 家具は JEI に。最初の椅子はオーク。"
	]
	quest.42000000002405AA.title: "引き出し"
	quest.42000000002405AB.quest_desc: [
		"壁に隠れる敷居。",
		"手順: 枠のこ、それから枠付きの立方体／ハーフ／階段。カモフラはブロックを持って右クリック。"
	]
	quest.42000000002405AB.title: "Framed Door"
	quest.42000000002405AC.quest_desc: [
		"薄い覆い。完全な変装。",
		"手順: 枠のこ、それから枠付きの立方体／ハーフ／階段。カモフラはブロックを持って右クリック。"
	]
	quest.42000000002405AC.title: "Framed Panel"
	quest.42000000002405AD.quest_desc: [
		"好みに着飾れる縁の手すり。",
		"手順: 枠のこ、それから枠付きの立方体／ハーフ／階段。カモフラはブロックを持って右クリック。"
	]
	quest.42000000002405AD.title: "Framed Fence"
	quest.42000000002405AE.quest_desc: [
		"灰色で、正直。生まれた砂利のとおり。",
		"手順: JEI で、合う石／木から Macaw の橋。"
	]
	quest.42000000002405AE.title: "安山岩の橋"
	quest.42000000002505AF.quest_desc: [
		"壁の灯。恥じて突き立てた松明ではない。執事には基準があった。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 松明＋鉄塊。執事所の最初の製作。"
	]
	quest.42000000002505AF.title: "燭台"
	quest.42000000002505B0.quest_desc: [
		"落ちる砂。時計のストランドの前で、唯一正直な時計。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B0.title: "砂時計"
	quest.42000000002505B1.quest_desc: [
		"ブロックから液体を一滴ずつ出す。小さい。妙に気持ちいい。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B1.title: "蛇口"
	quest.42000000002505B2.quest_desc: [
		"手で回せ。太鼓の心臓も、どこかから始まった。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B2.title: "クランク"
	quest.42000000002505B3.quest_desc: [
		"何かを飾って見せる。証、一ページ、トロフィー。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B3.title: "棚"
	quest.42000000002505B4.quest_desc: [
		"袋を入れる袋。回収の散らかりを、片付けて。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B4.title: "袋"
	quest.42000000002505B5.quest_desc: [
		"ほつれた糸を、自分のより悪い考えから離して鍵をかけよ。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B5.title: "金庫"
	quest.42000000002505B6.quest_desc: [
		"Clowder の全員が読む場所に、ページを留めよ。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B6.title: "掲示板"
	quest.42000000002505B7.quest_desc: [
		"野心のある鉢。浮島が薄いところで、少し育てよ。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B7.title: "プランター"
	quest.42000000002505B8.quest_desc: [
		"紡錘の織機の欠片を、眺められる場所に掲げよ。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B8.title: "台座"
	quest.42000000002505B9.quest_desc: [
		"クッキー、ハチ、あるいは秩序という小さな品格をしまう。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505B9.title: "瓶 (37)"
	quest.42000000002505BA.quest_desc: [
		"ベッドを丸ごとハシゴで引き上げずに、出現地点を決めよ。",
		"手順: JEI の羊毛。白い寝袋。染色の種類もある。ベッド一式なしで出現地点を決める。"
	]
	quest.42000000002505BA.title: "寝袋"
	quest.42000000002505BB.quest_desc: [
		"昼を眠って過ごせ。モブが出会うのは、休んだ Skybound だ。",
		"手順: JEI で羊毛＋糸。ロープと釘から吊る。"
	]
	quest.42000000002505BB.title: "ハンモック"
	quest.42000000002505BC.quest_desc: [
		"二つの柱のあいだ、落ち口の上にハンモックを掛けて、試せ。",
		"手順: 紐と鉄インゴット。二つ置いてから、ハンモックを掛ける。"
	]
	quest.42000000002505BC.title: "ロープと釘"
	quest.42000000002505BD.quest_desc: [
		"浮島の長い夜のための、もっと安定した炎。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505BD.title: "ろうそく立て"
	quest.42000000002505BE.quest_desc: [
		"登る、ぶら下がる、橋を架ける。縁歩きはこれを頼りにしていた。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505BE.title: "ロープ (37)"
	quest.42000000002505BF.quest_desc: [
		"レッドストーンの気まぐれで、ロープを上げ下げする。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505BF.title: "滑車ブロック"
	quest.42000000002505C0.quest_desc: [
		"その上に落ちれば、虚空は罰するのを忘れる。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505C0.title: "羽根ブロック"
	quest.42000000002505C1.quest_desc: [
		"Clowder 全員が論じ合える計画を、チョークで描け。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505C1.title: "黒板"
	quest.42000000002505C2.quest_desc: [
		"運んでほしくない小さなものを運ぶ。",
		"手順: JEI で Supplementaries を作る（壁灯、袋、金庫、ロープ…）。執事所が作業台の名を示す。"
	]
	quest.42000000002505C2.title: "ケージ"
	quest.42000000002605C3.quest_desc: [
		"最初の電線。太鼓の心臓が守ってきた脈に、やっと行き先ができた。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 圧延機で銅の板を圧延する。今の章はここから始まる。"
	]
	quest.42000000002605C3.title: "銅のワイヤー"
	quest.42000000002605C4.quest_desc: [
		"片側は回転、もう片側は Forgeエネルギー。二つのストランドが握手する。",
		"手順: Create Crafts & Additions — 圧延機の銅線、それからコネクタとモーター。"
	]
	quest.42000000002605C4.title: "コネクタ"
	quest.42000000002605C5.quest_desc: [
		"エネルギーが回転に戻る。時計のストランドは今、火花のストランドで動く。",
		"手順: Create Crafts & Additions — 圧延機の銅線、それからコネクタとモーター。"
	]
	quest.42000000002605C5.title: "電動モーター"
	quest.42000000002605C6.quest_desc: [
		"電線と作業のあいだに電荷を抱えておく。",
		"手順: Create Crafts & Additions — 圧延機の銅線、それからコネクタとモーター。"
	]
	quest.42000000002605C6.title: "コンデンサ"
	quest.42000000002605C7.quest_desc: [
		"蓄えた電流の壁。浮島が許すかぎり大きく組む。",
		"手順: Create Crafts & Additions — 圧延機の銅線、それからコネクタとモーター。"
	]
	quest.42000000002605C7.title: "モジュール式蓄電池"
	quest.42000000002605C8.quest_desc: [
		"インゴットから棒と線——プレスへの Create の答え。",
		"手順: Create Crafts & Additions — 圧延機の銅線、それからコネクタとモーター。"
	]
	quest.42000000002605C8.title: "圧延機"
	quest.42000000002605C9.quest_desc: [
		"エンチャント台の迷信なしに付与する。経験値を与え、意図を得る。",
		"手順: ブレイズバーナーのあとで Create Enchantment Industry。JEI が印刷機と経験値バケツの名を出す。"
	]
	quest.42000000002605C9.title: "ブレイズエンチャンター"
	quest.42000000002605CA.quest_desc: [
		"液状の修練を、携えて。執事なら、下品で役に立つと見たはずだ。",
		"手順: ブレイズバーナーのあとで Create Enchantment Industry。JEI が印刷機と経験値バケツの名を出す。"
	]
	quest.42000000002605CA.title: "経験値バケツ"
	quest.42000000002605CB.quest_desc: [
		"本を、設計を、頁を写す。ウィスカー写本は静かに認める。",
		"手順: ブレイズバーナーのあとで Create Enchantment Industry。JEI が印刷機と経験値バケツの名を出す。"
	]
	quest.42000000002605CB.title: "印刷機"
	quest.42000000002605CC.quest_desc: [
		"溶岩と熱を動力へ。橋であり、唸りそのものではない。",
		"手順: オスミウム + かまど + 銅。最初の Mekanism 発電機。"
	]
	quest.42000000002605CC.title: "熱発電機"
	quest.42000000002605CD.quest_desc: [
		"空ばかりの浮島では、太陽だけは誰も配給しない資源だ。",
		"手順: Mekanism の工房のラインのあと、Mekanism の発電機。熱発電機が最初のクラフト。"
	]
	quest.42000000002605CD.title: "太陽光発電機"
	quest.42000000002605CE.quest_desc: [
		"浮島が高いほど、強く回る。高く組め。",
		"手順: Mekanism の工房のラインのあと、Mekanism の発電機。熱発電機が最初のクラフト。"
	]
	quest.42000000002605CE.title: "風力発電機"
	quest.42000000002605CF.quest_desc: [
		"芽のストランドの余りを燃やせ。浮島では何一つ無駄にならない。",
		"手順: Mekanism の工房のラインのあと、Mekanism の発電機。熱発電機が最初のクラフト。"
	]
	quest.42000000002605CF.title: "バイオ発電機"
	quest.42000000002605D0.quest_desc: [
		"Mekanism を深く進めた Clowder のための、終盤の動力。",
		"手順: Mekanism の工房のラインのあと、Mekanism の発電機。熱発電機が最初のクラフト。"
	]
	quest.42000000002605D0.title: "ガス燃焼発電機"
	quest.42000000002605D1.quest_desc: [
		"デジタル織機がポケットに。浮島のどこからでも織り直せ。",
		"手順: AE2 のネットワークと充電したワイヤレスキットのあとでワイヤレス端末。JEI がクラフトの名を出す。"
	]
	quest.42000000002605D1.title: "ワイヤレス端末 (38)"
	quest.42000000002605D2.quest_desc: [
		"Mekanism の化学物質を、AE2 のネットワークに蓄える。遅い二つの柱を、一つに編む。",
		"手順: AE2 の筐体 + Mekanism の化学物質のあとで、Applied Mekanistics の化学セル。"
	]
	quest.42000000002605D2.title: "化学セル"
	quest.42000000002605D3.quest_desc: [
		"銅線が脈のすべてを運べないときのために。",
		"手順: Create Crafts & Additions — 圧延機の銅線、それからコネクタとモーター。"
	]
	quest.42000000002605D3.title: "大型コネクタ"
	quest.42000000002605D4.quest_desc: [
		"レベルが上がるケーキ。厨房ラインには言うな。",
		"手順: ブレイズバーナーのあとで Create Enchantment Industry。JEI が印刷機と経験値バケツの名を出す。"
	]
	quest.42000000002605D4.title: "経験値ケーキ"
	quest.42000000002605D5.quest_desc: [
		"同じ無料の空の、もっと大きな一口。",
		"手順: Mekanism の工房のラインのあと、Mekanism の発電機。熱発電機が最初のクラフト。"
	]
	quest.42000000002605D5.title: "上級ソーラー"
	quest.42000000002605D6.quest_desc: [
		"化学セルがどれも必要とする殻。",
		"手順: AE2 の筐体 + Mekanism の化学物質のあとで、Applied Mekanistics の化学セル。"
	]
	quest.42000000002605D6.title: "化学の筐体"
	quest.42000000002605D7.quest_desc: [
		"ガスをいくらか、ネットワークの外へ運べ。",
		"手順: AE2 の筐体 + Mekanism の化学物質のあとで、Applied Mekanistics の化学セル。"
	]
	quest.42000000002605D7.title: "携帯化学セル"
	quest.42000000002705D8.quest_desc: [
		"どのストランドにも、断ちが切り、野に返った織機の構築物である守護者がいる。怪物を殺すのではなく、倒すことでストランドに張力を戻す。ストランドを据えたらそのほつれたトーテムを作り、闘技場の外ならどこでも使うと、あなたと32ブロック以内の Clowder の仲間はみな、その舞台へ引き込まれる。勝てば、あなたたちはみなその守護者の織られた遺物を持ち帰る。負ければ、トーテムを消費したまま吐き出される。",
		"遺物は Curios の遺物スロット、オフハンド、またはホットバーから働く。装備中の常時効果と、クールダウン付きの右クリックの力だ。 `/guardians leave` は戦いを放棄し、 `/guardians status` は Clowder の記録を示す。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: チェック。そのストランドを据えてから、ほつれたトーテムをそれぞれ作る。闘技場の外で使え。"
	]
	quest.42000000002705D8.title: "断ちへの答え"
	quest.42000000002705D9.quest_desc: [
		"巣穴の鉢：四段の土が泥だまりまで下りる沈んだ鉢で、ダークオークの根のアーチ六つの下、穴の床に青緑の根の縫い目が七つ光る。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705D9.title: "トーテム：寝床"
	quest.42000000002705DA.quest_desc: [
		"体力の四分の一ごとに、寝床は叩きつけて穴を土の層で満たし、その中では無敵になる。七つの縫い目の一つが灯る：そこまで水路を掘り、核を露出させて叩き、埋没を解け。最初の門であり、容赦のある門だ。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705DA.title: "張力を戻す：寝床"
	quest.42000000002705DB.quest_desc: [
		"根心：受けるノックバックは六割減り、何もあなたを引けない。根を下ろすは五秒間あなたを地に植え、衝撃吸収のハート八つの後ろに置く。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705DB.title: "遺物：根心"
	quest.42000000002705DC.quest_desc: [
		"挽き穴：深層岩の採石場。床に回る砥石の輪があり、石のふるいのシュート四つが砂利を中央の砂利穴へ注ぐ。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705DC.title: "トーテム：挽き臼の顎"
	quest.42000000002705DD.quest_desc: [
		"挽き臼の顎は口を閉じているあいだ免疫。各シュートは十五秒ごとに砂利ブロックを一つ落とすので、一つを輪へ運び、穴の口まで乗せて、口を十二秒開いたまま詰まらせろ。輪はフェーズごとに逆転し、油断した者を穴へ押し込む。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705DD.title: "張力を戻す：挽き臼の顎"
	quest.42000000002705DE.quest_desc: [
		"挽き核：採掘疲労に免疫。手持ちのふるいは幸運の追加ロールを一つ得る。引き裂きは、次に当てたものから防御力を2はがす。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705DE.title: "遺物：挽き核"
	quest.42000000002705DF.quest_desc: [
		"繁茂のテラス：葉の天蓋の下に庭のテラスが四つ、格子の柱が八本、二段目に剪定台が四つ。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705DF.title: "トーテム：茨の母"
	quest.42000000002705E0.quest_desc: [
		"茨の母は決して打たない。広がって触れると焼ける茨の生垣を蒔き、剪定台が塞がるたびに回復する。ハサミと斧がそれを払う。台で生垣を八つ堆肥にすると剪定の波が走り、地面を払って彼女を気絶させる——きれいなダメージの隙はそれだけ。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705E0.title: "張力を戻す：茨の母"
	quest.42000000002705E1.quest_desc: [
		"茨の種：棘の鎧、そしてベリーやサボテンのダメージなし。開花は生垣の輪を上げ、その中のあなたと Clowder に再生 II を与える。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705E1.title: "遺物：茨の種"
	quest.42000000002705E2.quest_desc: [
		"空の欠片：虚空の上に浮かぶ深層岩の欠片が十、そのあいだに崩れる橋、ボスが着地する主の欠片に金の爪痕。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705E2.title: "トーテム：縁歩き"
	quest.42000000002705E3.quest_desc: [
		"純粋な決闘。縁歩きは欠片から欠片へ跳び、壁から最も遠い者に飛びかかり、金の爪痕が着地点を着地の一息前に示す — そこから外れろ。橋は後ろで崩れ、あとで戻る。落ちるとハート六つと、浮島へ戻る道がかかる。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705E3.title: "張力を戻す：縁歩き"
	quest.42000000002705E4.quest_desc: [
		"縁踏み：十二ブロック未満の落下ならダメージなし、縁から滑り落ちない。縁踏みは六ブロックを二度突進し、終わりにより強い一撃。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705E4.title: "遺物：縁踏み"
	quest.42000000002705E5.quest_desc: [
		"鍛冶の太鼓：溶岩の火口の上に真鍮の太鼓台、その前に打面を備えた銅のピストン槌が八つ、床を通る溶岩の水路が四つ。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705E5.title: "トーテム：太鼓の心臓"
	quest.42000000002705E6.quest_desc: [
		"太鼓の心臓は、四拍ごとにその直後の一瞬だけ傷つけられる。強拍で拍台に立って三倍に数える火花を溜め、四拍目には溶岩の水路が上がるので水路ではなく拍台の上にいろ。テンポは段階ごとに上がる。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705E6.title: "張力を戻す：太鼓の心臓"
	quest.42000000002705E7.quest_desc: [
		"太鼓の脈：四撃ごとにハートが二つ余分に入る。強拍は七ブロック以内のすべてを気絶させ、吹き飛ばす。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705E7.title: "遺物：太鼓の脈"
	quest.42000000002705E8.quest_desc: [
		"がんぎ：鉄のハブの周りを回る銅の輪が四つ、ダークオークの順序タイルを載せ、歯車塔が六つ、十六ブロックの振り子が時を刻む。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705E8.title: "トーテム：歯車師"
	quest.42000000002705E9.quest_desc: [
		"どの段階でも歯車師は巻く：回る輪の上でタイルが順に灯り、十二秒でその順に踏む。成功すると筐体が八秒開き、失敗すると歯車塔がすべて撃つ。振り子はメトロノームで、大きく振れると輪が逆回転する。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705E9.title: "張力を戻す：歯車師"
	quest.42000000002705EA.quest_desc: [
		"歯車の輪：採掘速度上昇 I、道具の消耗は五分の一遅い。巻き戻しは持っている他の遺物をすべて戻し、三秒前にいた場所へ引き戻す。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705EA.title: "遺物：歯車の輪"
	quest.42000000002705EB.quest_desc: [
		"巣板：六角形の蝋の闘技場。昇降する巣房、蜂蜜の池、壁に雄蜂の巣房が六つ。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705EB.title: "トーテム：群れの心"
	quest.42000000002705EC.quest_desc: [
		"群れの心は脆いが、波ごとに六つの巣房が雄蜂を注ぐ。雄蜂の巣房に焚き火を置くと三十秒封じ、六つすべて封じると王室が十秒開く。自分の Productive Bees は雄蜂を見かけると攻撃する。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705EC.title: "張力を戻す：群れの心"
	quest.42000000002705ED.quest_desc: [
		"群れの呼び：ハチはあなたに敵意を向けず、十六ブロック以内の巣箱は一割速く働く。群れを呼ぶ：当てたものの後をレリック蜂四匹が追う。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705ED.title: "遺物：群れの呼び"
	quest.42000000002705EE.quest_desc: [
		"守護の円：金の円と、アメジストの尖塔を頂く紋様の柱九本がある石の聖域で、中央は金の杭が並ぶ九辺の壇。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705EE.title: "トーテム：印破り"
	quest.42000000002705EF.quest_desc: [
		"印破りは、動いている結界三つに隠れる。壇の杭が段階ごとに一度だけ順番を灯す — 先に見ろ。その順に Ars の解除か印ストランドの品で柱を解けばよく、間違えると三つとも再び武装し、結界のガラスが噛む。三つ正しければ十二秒開く。あとの段階はルーンを入れ替え、おとりを足す。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705EF.title: "張力を戻す：印破り"
	quest.42000000002705F0.quest_desc: [
		"印標：受ける魔法ダメージが五分の一減る。印標は、自分か、見ている Clowder の仲間を、重い一撃から一度守る。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705F0.title: "遺物：印標"
	quest.42000000002705F1.quest_desc: [
		"崩れゆく織機：幅六十六ブロックの織機で、床は経糸であり、綜絖の棒が落ちると板の帯がほどけて糸の橋になる。",
		"ほつれた糸四つと、そのストランドのブロック四つを虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705F1.title: "トーテム：織られぬ者"
	quest.42000000002705F2.quest_desc: [
		"五段階。それぞれが三十秒、残る八つの仕組みのうち二つを引き、それから綜絖の棒が落ち、さらに三本の帯がほどける。真の姿では最後の四本が残り、経糸だけが、それが立つ梁への上り道になる。そこで倒せ：織り直し。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705F2.title: "張力を戻す：織られぬ者"
	quest.42000000002705F3.quest_desc: [
		"織機の糸：Clowder の織機の張力が二つ増え、減衰が遅くなる。織機の糸は Clowder をあなたの脇につなぐ。真の織り直しの要石であり、封じられた二つの闘技場への鍵だ。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705F3.title: "遺物：織機の糸"
	quest.42000000002705F4.quest_desc: [
		"桟橋のごみ箱：桟橋そのものの一角で、板の庭、布のシーツの物干し、羊毛の籠、赤い敷物がある。",
		"ほつれた糸四つと羊毛四つを、虚空の毛糸の周りに。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705F4.title: "トーテム：糸くずゴーレム"
	quest.42000000002705F5.quest_desc: [
		"危険のない、ただ一つの戦い。ゴーレムは糸くずの玉を投げてほんの一瞬だけ目をくらませ、洗濯物の陰に隠れるが、敷物を叩くとくしゃみをしてよろめく。トーテムと闘技場と門を教える。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705F5.title: "張力を戻す：糸くずゴーレム"
	quest.42000000002705F6.quest_desc: [
		"糸くずの房：サボテン、ベリー、生垣のダメージと、押されることに免疫。毛ぼこりは近くのモブを目くらましにして逃げられる。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705F6.title: "遺物：糸くずの房"
	quest.42000000002705F7.quest_desc: [
		"結びの庭：生垣迷路が四つの輪になった下の草原の島で、切れ目と突き出し、丸石の道、その上に吊った縄結びの輪がある。",
		"虚空の毛糸の周りに、ほつれた糸四つと葉四つ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705F7.title: "トーテム：絡まり"
	quest.42000000002705F8.quest_desc: [
		"蜘蛛は、切るのに三撃いる縄結びで後ろの道をふさぎ、行き止まりに一人だと噛む。迷路では離れない。任意で、中盤、見た目だけの褒美。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705F8.title: "張力を戻す：絡まり"
	quest.42000000002705F9.quest_desc: [
		"結びのお守り：クモの巣、ソウルサンド、ハチミツ、粉雪で減速せず、氷の滑りは半分。絡まりは当たった最初のモブを根で止める。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705F9.title: "遺物：結びのお守り"
	quest.42000000002705FA.quest_desc: [
		"二つの狂った闘技場が、織り直しだけが開く扉の向こうで待っている。そのトーテムはクラフト枠に織機の糸の遺物が要り、空を閉じた Clowder にだけ応える。ボスはあなたの十倍から二十倍の大きさだ。全員を連れていけ。",
		"手順: 九つのストランドをすべて据えてから、織り直す。空が閉じると進捗が発動する。"
	]
	quest.42000000002705FA.title: "封じられた扉"
	quest.42000000002705FB.quest_desc: [
		"断絶：光る断ちが横切る大きな黒曜石の欠片、周りを漂う世界の欠片が二十、空に青緑の虚空の涙。",
		"ほつれた糸と黒曜石が織機の糸の遺物の周りにあり、遺物は返される。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705FB.title: "トーテム：最初の断ち"
	quest.42000000002705FC.quest_desc: [
		"断ちが欠片に残した形であり、誰が振ったかの告白ではない。二十秒ごとに欠片を横切る線を断ち、ブロックは十五秒のあいだ落ち、継ぎ目は移動速度を与えるがその光線は継ぎ目を追う。漂う欠片は押しつぶし、虚空の涙は引き、体力が五分の一になると欠片は断ちに沿って二つに割れる。織り直しのあとだけ。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705FC.title: "張力を戻す：最初の断ち"
	quest.42000000002705FD.quest_desc: [
		"最初の断ちの欠片：結界の段階を断ち切る。パックで最良、通過した者のため。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705FD.title: "遺物：最初の断ちの欠片"
	quest.42000000002705FE.quest_desc: [
		"上の織機：プルプァの織り、ストランドの橋が九つ、柱のある台が九つへ続き、大聖堂の糸が二十七本、六十四ブロック上の要石まで伸びる。",
		"織機の糸の遺物の周りにほつれた糸とプルプァ。遺物は手元に戻る。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.42000000002705FE.title: "トーテム：織り過ぎ"
	quest.42000000002705FF.quest_desc: [
		"自分で直した織機が逆らう。織り過ぎは九人の守護者の影を、それぞれのストランドへ投げる。影を倒すと、その糸が二十五秒ぴんと張り、そのあいだだけ織機そのものを傷つけられる。あとでは三つ、それから九つすべてを投げる。",
		"手順: 対応するほつれたトーテムを使い、闘技場に勝つ。進捗がこれを完了する。"
	]
	quest.42000000002705FF.title: "張力を戻す：織り過ぎ"
	quest.4200000000270600.quest_desc: [
		"織り過ぎの杼：すべてのストランド遺物の残響が一つになり、倒れた Clowder の仲間を織り直す。",
		"勝利の場にいた Clowder の一員につき一つ、そのままインベントリへ。",
		"手順: ウィスカー写本の断たれた守護者 — トーテム、闘技場、遺物。トーテムは浮島で応える。"
	]
	quest.4200000000270600.title: "遺物：織り過ぎの杼"
	quest.42000000002805E3.quest_desc: [
		"野生の浮島の走り手は虚空の浮島には湧かない。門の太鼓で門の儀式を奏で（素手で使え、拍を A、S、D、F で叩け）、辺境を歩け。黄色はステップと葦の湿地で草を食む。高地は優秀グレードに寄る。雪原は素晴らしいグレードを隠す。残り火の荒野は炎の鳥を抱く。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 門の太鼓を素手で使い、門の儀式を奏でる。落ちてくる拍を A、S、D、F で打て。60%当たれば開き、脈は要らない。先に帰還のコンパスを結べ。"
	]
	quest.42000000002805E3.title: "辺境への門"
	quest.42000000002805E4.quest_desc: [
		"野生の Gysahl は葦の湿地、ステップ、高地に生え、湿地で一番密だ。摘むと種も落ち、辺境の葉や草をクワで壊すと種がさらに出る。種は家の耕地に植えろ。",
		"手順: 辺境で野生の Gysahl を摘む（葦の湿地が一番密）。摘むと種も落ちる。家の耕地に植えろ。"
	]
	quest.42000000002805E4.title: "Gysahl Green"
	quest.42000000002805E5.quest_desc: [
		"本と Gysahl の葉。どこでも使え：ページには自分の鳥それぞれの色、グレード、クラス、レースの勝ち数、最後の木の実が並ぶ。",
		"手順: 本と Gysahl。どこでも使え。ページに自分の鳥が並ぶ。"
	]
	quest.42000000002805E5.title: "Chocobo Almanac"
	quest.42000000002805E6.quest_desc: [
		"野生の黄色に Gysahl を与えて手懐けろ。革、糸、鉄で鞍を作り、乗れ。ダッシュすると突進し、力を抜くと持久力が戻る。",
		"手順: 革、糸、鉄。野生の黄色を Gysahl で手懐け、それから鞍を置け。"
	]
	quest.42000000002805E6.title: "Chocobo Saddle"
	quest.42000000002805E7.quest_desc: [
		"金塊で時計を囲み、Gysahl を添える。ぜんまいを巻くと、ウィスカーウィンドと戻りへ運ぶ。辺境を歩いたあと、Esther は Clowder ホールにも立つ：鞍を置いた鳥で彼女のもとへ行くか、ウィスカーウィンドの案内人に聞け。",
		"手順: 時計を金塊で囲み、Gysahl を添える。ぜんまいでウィスカーウィンドと戻りへ飛べ。鞍を置いた鳥も一緒に来る。"
	]
	quest.42000000002805E7.title: "Chocobo Pocketwatch"
	quest.42000000002805E8.quest_desc: [
		"手にしたルアーは野生の鳥を引き寄せ、野を横切って輪郭を描く。",
		"手順: ルアーを作れ。持って辺境の黄色を探せ。"
	]
	quest.42000000002805E8.title: "Chocobo Lure"
	quest.42000000002805E9.quest_desc: [
		"Gysahl の種を耕地に植えろ。家の一区画が、農場の流れの始まりだ。",
		"手順: 野生の Gysahl を摘むと種が落ち、草と辺境の葉をクワで壊しても落ちる。耕地に植えろ。"
	]
	quest.42000000002805E9.title: "Gysahl Seeds"
	quest.42000000002805EA.quest_desc: [
		"性別が反対の成体二羽に Carob の木の実を食わせろ。グレードが良好以上の黄二羽に Carob を足すと、緑か青が孵ることがある。親はそれぞれクラス C の1位が5回要り、合わせて16回で色が確定する。グレードが優秀な緑と優秀な青が、それぞれクラス B の1位を8回持つと、黒が孵る（外れると白。合わせて24回で確定の出目）。",
		"手順: ウィスカーウィンドの木の実番 Bilo が Carob を売る。クラス A のレースでも払われる。"
	]
	quest.42000000002805EA.title: "Carob Nut"
	quest.42000000002805EB.quest_desc: [
		"梯子の中段の青菜。速度、スタミナ、知力、協調を訓練せよ。鳥は種類ごとに満ちる。",
		"手順: ウィスカーウィンドの賢者 Wynn。"
	]
	quest.42000000002805EB.title: "Curiel の青菜"
	quest.42000000002805EC.quest_desc: [
		"最上の訓練用青菜。安い葉で鳥が満ちたら、梯子を上がれ。",
		"手順: ウィスカーウィンドの賢者 Wynn、またはクラス S のレース賞品。"
	]
	quest.42000000002805EC.title: "Sylkis の青菜"
	quest.42000000002805ED.quest_desc: [
		"Zeio なしに金は孵らない。グレードが素晴らしい黒と素晴らしい黄、それぞれクラス A の1位が10回（合わせて32回で確定の出目）。",
		"手順: ウィスカーウィンドの木の実番 Bilo が Zeio を売る。クラス S のレースではまれに払われる。"
	]
	quest.42000000002805ED.title: "Zeio Nut"
	quest.42000000002805EE.quest_desc: [
		"コースで稼いだ GP。広場の屋台は、何でも GP で値を付ける。",
		"手順: ウィスカーウィンドの一走で上位三着に入る。鞍を置いた鳥で Esther のもとへ行き、参加する。"
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"最初の交配の木の実。才能は木の実に従い、色は親に従う。Carob か Zeio が絡むときは別だ。",
		"手順: ウィスカーウィンドの木の実番 Bilo が Pepio を売る。クラス C の勝利でも払われることがある。"
	]
	quest.42000000002805EF.title: "Pepio Nut"
	quest.42000000002805F0.quest_desc: [
		"Gysahl 二つと骨粉。普通の青菜から一段階上。",
		"手順: 不定形 — Gysahl 二つと骨粉。"
	]
	quest.42000000002805F0.title: "Krakka の青菜"
	quest.42000000002805F1.quest_desc: [
		"次の訓練用青菜。畑が回り出したら任意。",
		"手順: 賢者 Wynn、または JEI に載るレシピ。"
	]
	quest.42000000002805F1.title: "Tantal の青菜"
	quest.42000000002805F2.quest_desc: [
		"もう一つの訓練用青菜。任意。",
		"手順: 広場の賢者 Wynn。"
	]
	quest.42000000002805F2.title: "Pahsana の青菜"
	quest.42000000002805F3.quest_desc: [
		"もう一つの訓練用青菜。任意。",
		"手順: 広場の賢者 Wynn。"
	]
	quest.42000000002805F3.title: "Mimett の青菜"
	quest.42000000002805F4.quest_desc: [
		"もう一つの訓練用青菜。任意。",
		"手順: 広場の賢者 Wynn。"
	]
	quest.42000000002805F4.title: "Reagan の青菜"
	quest.42000000002805F5.quest_desc: [
		"中段の木の実。任意。",
		"手順: ウィスカーウィンドの木の実番 Bilo が Luchile を売る。"
	]
	quest.42000000002805F5.title: "Luchile Nut"
	quest.42000000002805F6.quest_desc: [
		"中段の木の実。任意。",
		"手順: ウィスカーウィンドの木の実番 Bilo が Saraha を売る。"
	]
	quest.42000000002805F6.title: "Saraha Nut"
	quest.42000000002805F7.quest_desc: [
		"中段の木の実。任意。",
		"手順: ウィスカーウィンドの木の実番 Bilo が Lasan を売る。"
	]
	quest.42000000002805F7.title: "Lasan Nut"
	quest.42000000002805F8.quest_desc: [
		"中盤から終盤の交配の木の実。任意。木の実番の Bilo が売る。",
		"手順: ウィスカーウィンドの木の実番 Bilo が Pram を売る。"
	]
	quest.42000000002805F8.title: "Pram Nut"
	quest.42000000002805F9.quest_desc: [
		"ウィスカーウィンドの縁日の屋台は、花火、リード、懐中時計、Chocobo 年鑑を GP で売る。",
		"手順: 紙に火薬。任意の炸裂。"
	]
	quest.42000000002805F9.title: "縁日の花火"
	quest.42000000002805FA.quest_desc: [
		"終盤の交配の木の実。任意。",
		"手順: ウィスカーウィンドの木の実番 Bilo が Porov を売る。"
	]
	quest.42000000002805FA.title: "Porov Nut"
	quest.42000000002905FB.quest_desc: [
		"虚空は Pam's の茂みを育てたことがない。紐の網で土をふるえ。庭を壊して乾燥の種を取れ——チリ、トウモロコシ、サボテンの実。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 紐の網か、それ以上で土をふるう（Ex Deorum か虚空の織機）。"
	]
	quest.42000000002905FB.title: "Arid Garden"
	quest.42000000002905FC.quest_desc: [
		"同じ土からの寒冷作物。茂みを壊し、必要なものを植えろ。",
		"手順: 紐の網か、それ以上で土をふるう。"
	]
	quest.42000000002905FC.title: "Frost Garden"
	quest.42000000002905FD.quest_desc: [
		"葉陰の作物。ふるいは同じ、茂みは別。",
		"手順: 紐の網か、それ以上で土をふるう。"
	]
	quest.42000000002905FD.title: "Shaded Garden"
	quest.42000000002905FE.quest_desc: [
		"湿地の作物。米と、沼を好む残りの種がここにいる。",
		"手順: 紐の網か、それ以上で土をふるう。"
	]
	quest.42000000002905FE.title: "Soggy Garden"
	quest.42000000002905FF.quest_desc: [
		"温暖の作物。茂みはチェストにしまい、植えてもやはり広がる。",
		"手順: 紐の網か、それ以上で土をふるう。"
	]
	quest.42000000002905FF.title: "Tropical Garden"
	quest.4200000000290600.quest_desc: [
		"六つの最後。浮島の HarvestCraft の種は、どれもこうした茂みの一つから始まる。",
		"手順: 紐の網か、それ以上で土をふるう。"
	]
	quest.4200000000290600.title: "Windy Garden"
	quest.4200000000290601.quest_desc: [
		"Farmer's Delight のまな板ではない。銅と棒と板材。鍋に入れる前に果物と野菜を下ごしらえしろ。",
		"手順: 銅、棒、板材。Farmer's Delight のまな板ではない。"
	]
	quest.4200000000290601.title: "収穫ボード"
	quest.4200000000290602.quest_desc: [
		"スープ、シチュー、出汁。銅と棒。鍋はクラフトのたびに戻る。",
		"手順: 銅と棒。鍋は不定形の調理のたびに戻る。"
	]
	quest.4200000000290602.title: "収穫鍋"
	quest.4200000000290603.quest_desc: [
		"スキレット料理。銅と棒。Delight のスキレットとは別のクラフト。JEI が見分ける。",
		"手順: 銅と棒。Delight のスキレットとは別物。"
	]
	quest.4200000000290603.title: "収穫スキレット"
	quest.4200000000290604.quest_desc: [
		"ソースと煮詰め。銅と棒。鍋のそばに置いて。",
		"手順: 銅と棒。"
	]
	quest.4200000000290604.title: "Saucepan"
	quest.4200000000290605.quest_desc: [
		"テラコッタの輪。パイ、パン、オーブンの形が要るもの全部。",
		"手順: テラコッタ八つを空の中央の周りに。"
	]
	quest.4200000000290605.title: "Bakeware"
	quest.4200000000290606.quest_desc: [
		"板材と棒。バッター、生地、サラダ。静かな台。",
		"手順: 板材と棒。"
	]
	quest.4200000000290606.title: "Mixing Bowl"
	quest.4200000000290607.quest_desc: [
		"テラコッタ。果物を入れて絞り出す。畑ではなく木と組ませる。",
		"手順: テラコッタ。四つをT字に。"
	]
	quest.4200000000290607.title: "Juicer"
	quest.4200000000290608.quest_desc: [
		"棒と原木。生地をのばす。焼き型が待っている。",
		"手順: 原木の両側に棒。"
	]
	quest.4200000000290608.title: "ローラー"
	quest.4200000000290609.quest_desc: [
		"火打石のふるいからの安山岩の小石、それから棒。粉、香辛料、ペースト。",
		"手順: 安山岩（火打石のふるいで土か砂利の小石）と棒。"
	]
	quest.4200000000290609.title: "Grinder"
	quest.420000000029060A.quest_desc: [
		"水入りバケツを八つに分ける。大半のレシピはバニラのバケツではなくこれを求める。",
		"手順: 水入りバケツ一つ → 淡水八つ。"
	]
	quest.420000000029060A.title: "Fresh Water"
	quest.420000000029060B.quest_desc: [
		"浮島に牛はいない。ココナッツ（鉄の網の土）に淡水、または後でミルクバケツを分ける。",
		"手順: ココナッツ（鉄の網の土）に淡水、またはミルクバケツを分ける。"
	]
	quest.420000000029060B.title: "Fresh Milk"
	quest.420000000029060C.quest_desc: [
		"鍋に水、または粉ひき。ほぼ全ての塩味レシピが求める。",
		"手順: 鍋に水か淡水。鍋は戻る。"
	]
	quest.420000000029060C.title: "Salt"
	quest.420000000029060D.quest_desc: [
		"小麦を粉ひきへ。生地はここから。",
		"手順: 粉ひきに小麦（または別の粉の作物）。粉ひきは戻る。"
	]
	quest.420000000029060D.title: "Flour"
	quest.420000000029060E.quest_desc: [
		"小麦粉、塩、淡水。パイもパンもこの塊を使う。",
		"手順: 混ぜボウル、小麦粉、水、塩。"
	]
	quest.420000000029060E.title: "Dough"
	quest.420000000029060F.quest_desc: [
		"骨か野菜を鍋へ。スープは曖昧な煮汁ではなく、この瓶を求める。",
		"手順: 鍋に骨（浮島の守り手が骨を売る）か余った野菜。"
	]
	quest.420000000029060F.title: "Stock"
	quest.4200000000290610.quest_desc: [
		"鉄の網の土。浮島で育てる。バニラのオークは Pam's のリンゴを落とさない。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.4200000000290610.title: "リンゴの木"
	quest.4200000000290611.quest_desc: [
		"ドレッシングと魚のための酸。同じ鉄のふるい。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.4200000000290611.title: "レモンの木"
	quest.4200000000290612.quest_desc: [
		"樹皮の香辛料。焼き菓子と茶。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.4200000000290612.title: "シナモンの木"
	quest.4200000000290613.quest_desc: [
		"乳、油、熱帯の料理。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.4200000000290613.title: "ココナッツのヤシ"
	quest.4200000000290614.quest_desc: [
		"甘い物のための豆。他と同じように植える。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.4200000000290614.title: "バニラのつる"
	quest.4200000000290615.quest_desc: [
		"Pam's のリンゴの木は普通のリンゴを実らせ、オークの葉が落とすよりずっと多い。ジューサーも焼き型もこれを求める。",
		"手順: オークの葉は少し落とす；Pam's のリンゴの木（鉄の網の土からの苗木）はたくさん実る。"
	]
	quest.4200000000290615.title: "Pam's のリンゴ"
	quest.4200000000290616.quest_desc: [
		"焼き型、生地、砂糖、リンゴ。HarvestCraft で初めて焼き上がるもの。",
		"手順: 焼き型、生地、砂糖、リンゴの木の Pam's のリンゴ。"
	]
	quest.4200000000290616.title: "アップルパイ（収穫）"
	quest.4200000000290617.quest_desc: [
		"ジューサーに混ぜた果物。スイカジュースではない浮島の飲み物。",
		"手順: ジューサーとミックスフルーツ。"
	]
	quest.4200000000290617.title: "Fruit Punch"
	quest.4200000000290618.quest_desc: [
		"スキレット、パン、チーズ。木が育つあいだの早い昼ごはん。",
		"手順: スキレット、パン、バター、チーズ。すべては淡水、ココナッツミルク、小麦粉から。"
	]
	quest.4200000000290618.title: "Grilled Cheese"
	quest.4200000000290619.quest_desc: [
		"乾燥の唐辛子、トマト、タマネギ、豆、香葉、肉か絹ごし豆腐。Food Extended が役に立ち始める。",
		"手順: 鍋、乾燥チリ、トマト、タマネギ、豆、香葉、肉か絹ごし豆腐。"
	]
	quest.4200000000290619.title: "チリのボウル"
	quest.420000000029061A.quest_desc: [
		"挽き器の香辛料、庭の野菜、鍋の仕事。",
		"手順: 片手鍋、米、ココナッツ、チリ、黒胡椒、カレー粉（香葉 + マスタード + シナモン）。"
	]
	quest.420000000029061A.title: "カレーの皿"
	quest.420000000029061B.quest_desc: [
		"生地、ソース、肉。焼き型。HarvestCraft の一食まるごと。",
		"手順: 焼き型、生地、トマト、チーズ、ペパロニ（豚ベーコン、またはカエデ + 大豆の豆腐ベーコン）。"
	]
	quest.420000000029061B.title: "Pepperoni Pizza"
	quest.420000000029061C.quest_desc: [
		"湿った庭の米、ニンジン、タマネギ、エンドウ、卵。ニワトリがいるまで絹ごし豆腐が代わりになる。",
		"手順: スキレット、湿った庭の米、ニンジン、タマネギ、エンドウ、卵。絹ごし豆腐は卵として数える。"
	]
	quest.420000000029061C.title: "庭の炒飯"
	quest.420000000029061D.quest_desc: [
		"茶葉と香葉を鍋に。日陰の庭と湿った庭で両方が揃う。",
		"手順: 鍋、茶葉、香葉。日陰の庭は茶も香辛料も落とす。"
	]
	quest.420000000029061D.title: "Green Tea"
	quest.420000000029061E.quest_desc: [
		"油と塩味の実。鉄の網の任意の収穫。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.420000000029061E.title: "オリーブの木"
	quest.420000000029061F.quest_desc: [
		"果汁と果皮。任意。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.420000000029061F.title: "オレンジの木"
	quest.4200000000290620.quest_desc: [
		"夏の果実。任意。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.4200000000290620.title: "モモの木"
	quest.4200000000290621.quest_desc: [
		"挽き器に入れる胡椒。任意。",
		"手順: 鉄の網で土をふるい、厨房の苗木を得て、それから実を育てる。"
	]
	quest.4200000000290621.title: "コショウの木"
	quest.4200000000290622.quest_desc: [
		"揚げ油。任意の常備。",
		"手順: JEI で種かオリーブを搾る。任意の常備。"
	]
	quest.4200000000290622.title: "Cooking Oil"
	quest.4200000000290623.quest_desc: [
		"ミルクと塩。任意の常備。",
		"手順: 鍋とミルク（ココナッツの淡水ミルクでよい）。"
	]
	quest.4200000000290623.title: "Butter"
	quest.4200000000290624.quest_desc: [
		"卵をジューサーに通す。任意。",
		"手順: ジューサーと卵（絹ごし豆腐も数える）。任意。"
	]
	quest.4200000000290624.title: "Mayonnaise"
	quest.4200000000290625.quest_desc: [
		"まな板、ミックスフルーツ。任意。",
		"手順: まな板とミックスフルーツ。任意。"
	]
	quest.4200000000290625.title: "Fruit Salad"
	quest.4200000000290626.quest_desc: [
		"パスタの夜。任意。",
		"手順: 庭と果樹が材料を出す。大豆の豆腐が肉と卵の代わりになる。JEI が作業台を示す。"
	]
	quest.4200000000290626.title: "スパゲッティの夕食"
	quest.4200000000290627.quest_desc: [
		"自慢の朝ごはん。任意。",
		"手順: 庭と果樹が材料を出す。大豆の豆腐が肉と卵の代わりになる。JEI が作業台を示す。"
	]
	quest.4200000000290627.title: "Bacon Pancakes"
	quest.4200000000290628.quest_desc: [
		"アボカドの苗には鉄の網の土、それからスキレット、トースト、塩、ニンニク、香葉。",
		"手順: 鉄の網のアボカドの苗、それからスキレットにトースト、塩、ニンニク、香葉。"
	]
	quest.4200000000290628.title: "Avocado Toast"
	quest.4200000000290629.quest_desc: [
		"Delight のハンバーガーではない。任意。",
		"手順: 庭と果樹が材料を出す。大豆の豆腐が肉と卵の代わりになる。JEI が作業台を示す。"
	]
	quest.4200000000290629.title: "オニオンバーガー"
	quest.420000000029062A.quest_desc: [
		"ジューサー、リンゴ。任意。",
		"手順: ジューサーと Pam's のリンゴ。任意。"
	]
	quest.420000000029062A.title: "Apple Juice"
	quest.420000000029062B.quest_desc: [
		"スキレット、パンとバター。任意。",
		"手順: スキレット、パンとバター。任意。"
	]
	quest.420000000029062B.title: "トースト一切れ"
	quest.42000000002A062C.quest_desc: [
		"棒4本を四角に。耕地に置く。バニラの種は植えると変わるが、Mystical Agriculture の種は変わらない。",
		"同じブロックにもう一組の棒を刺すと交雑作物になる。隣で成熟したものの性質を継ぐ空の一対で、四方を親で囲むと数分で自ら種を付け、骨粉を使えばすぐ試みが起きる。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 棒4本を四角に。耕地に置いてから種を植える。"
	]
	quest.42000000002A062C.title: "木の作物棒"
	quest.42000000002A062D.quest_desc: [
		"本と羽根ペン（本、イカスミ、羽根）と小麦の種。分析器に入れておく。",
		"手順: 本と羽根ペン（本、イカスミ、羽根）と小麦の種。木炭とガラス瓶でインクになる。"
	]
	quest.42000000002A062D.title: "作物日誌"
	quest.42000000002A062E.quest_desc: [
		"ガラス板と棒。作物を見て、収穫せずに成長、収量、強度を読む。",
		"手順: 棒の間にガラス板、その下に棒の柄。植えた作物を見る。"
	]
	quest.42000000002A062E.title: "Magnifying Glass"
	quest.42000000002A062F.quest_desc: [
		"ガラス、石のハーフブロック、板材、棒。日誌と一緒に種を入れる。交配が見えるようになる。",
		"稔性は交配を動かす数値だ。新しい種は10のうち1で、1点ごとに親に選ばれる確率が上がるので、分析して最良を植え直せば交雑は速くなる。",
		"手順: ガラス板、石のハーフブロック、板材、棒。日誌を据えてから種を入れる。"
	]
	quest.42000000002A062F.title: "Seed Analyzer"
	quest.42000000002A0630.quest_desc: [
		"このパックでは雑草は出ないが、熊手はそれでも棒を外せる。一本は持っておけ。",
		"手順: 棒の上に木のフェンス。雑草は出ない。それでも棒は外せる。"
	]
	quest.42000000002A0630.title: "木の熊手"
	quest.42000000002A0631.quest_desc: [
		"数値を保ったまま植物を持ち上げて置き直す。10-10を壊さずに移す。",
		"手順: 鉄インゴット二つと棒。数値を保ったまま植物を持ち上げる。"
	]
	quest.42000000002A0631.title: "移植ごて"
	quest.42000000002A0632.quest_desc: [
		"成熟した植物を摘んで摘み取り産物を得て、リセットする。花といくつかの HarvestCraft 作物。",
		"手順: ハサミ、鉄、棒。成熟した植物を摘んでリセットする。"
	]
	quest.42000000002A0632.title: "摘み取り器"
	quest.42000000002A0633.quest_desc: [
		"交配の系統を持ち歩く。分析器から入れて、棒の上に出す。",
		"手順: 革と紐。分析器から入れる。"
	]
	quest.42000000002A0633.title: "種子袋"
	quest.42000000002A0634.quest_desc: [
		"より頑丈な棒。植え方は同じで、ぶつけても面倒が少ない。",
		"手順: 鉄塊を縦に二つで八本できる。"
	]
	quest.42000000002A0634.title: "Iron Crop Sticks"
	quest.42000000002A0635.quest_desc: [
		"より良い熊手。雑草がなくても、まだ癖だ。",
		"手順: 棒の上に鉄格子。"
	]
	quest.42000000002A0635.title: "鉄の熊手"
	quest.42000000002A0636.quest_desc: [
		"水路のために水をためる。毎朝バケツを運ばない浮島の畑。",
		"手順: 板材。水路のために水をためる。"
	]
	quest.42000000002A0636.title: "Irrigation Tank"
	quest.42000000002A0637.quest_desc: [
		"タンクの水を畝に沿って流す。作物はあなたからではなく、水路から飲む。",
		"手順: タンクから不定形。タンク一つが水路八つになる。"
	]
	quest.42000000002A0637.title: "Irrigation Channel"
	quest.42000000002A0638.quest_desc: [
		"タンクを壊さずに水路を止め、また流す。",
		"手順: 鉄格子、赤色の染料、鉄インゴット。タンクを壊さずに水路を止め、また流す。"
	]
	quest.42000000002A0638.title: "Channel Valve"
	quest.42000000002A0639.quest_desc: [
		"四角に雨を降らせる。棒の上の水路に据える。",
		"手順: 棒の上の水路に据える。作り方の名は JEI にある。"
	]
	quest.42000000002A0639.title: "Sprinkler"
	quest.42000000002A063A.quest_desc: [
		"水路に蓋をして、畝を歩けるようにする。",
		"手順: 水路に蓋をして、畝を歩けるようにする。"
	]
	quest.42000000002A063A.title: "水路の格子"
	quest.42000000002A063B.quest_desc: [
		"部屋の状態を読む。光、湿度、作物が止まった理由。",
		"手順: 作って部屋に置く。光と湿度を読む。"
	]
	quest.42000000002A063B.title: "Greenhouse Monitor"
	quest.42000000002A063C.quest_desc: [
		"終盤の棒。耐火で頑固、木に無理を言う植物のため。隣り合う成熟した作物二つは交雑できる。",
		"手順: 黒曜石を縦に二つで八本できる。隣り合う成熟した作物二つは交雑できる。"
	]
	quest.42000000002A063C.title: "Obsidian Crop Sticks"
	quest.42000000002A063D.quest_desc: [
		"歩ける水路。任意。",
		"手順: 歩ける水路。任意。"
	]
	quest.42000000002A063D.title: "中空水路"
	quest.42000000002A063E.quest_desc: [
		"鉱石作物がこれを落とす。任意の交配系統。",
		"手順: 木の作物棒は棒から。日誌は本と羽根ペンと種。分析器はガラスと木。耕地に植える。"
	]
	quest.42000000002A063E.title: "銅塊作物"
	quest.42000000002A063F.quest_desc: [
		"棒からクォーツ。任意。",
		"手順: 木の作物棒は棒から。日誌は本と羽根ペンと種。分析器はガラスと木。耕地に植える。"
	]
	quest.42000000002A063F.title: "クォーツの欠片作物"
	quest.42000000002A0640.quest_desc: [
		"作物から得る燃料。任意。",
		"手順: 木の作物棒は棒から。日誌は本と羽根ペンと種。分析器はガラスと木。耕地に植える。"
	]
	quest.42000000002A0640.title: "Coal Pebble"
	quest.42000000002A0641.quest_desc: [
		"後期の鉱石作物。任意。",
		"手順: 木の作物棒は棒から。日誌は本と羽根ペンと種。分析器はガラスと木。耕地に植える。"
	]
	quest.42000000002A0641.title: "エメラルドの欠片の作物"
	quest.42000000002A0642.quest_desc: [
		"後期の鉱石作物。任意。",
		"手順: 木の作物棒は棒から。日誌は本と羽根ペンと種。分析器はガラスと木。耕地に植える。"
	]
	quest.42000000002A0642.title: "ダイヤモンドの欠片の作物"
	quest.42000000002A0643.quest_desc: [
		"頂点の鉱石作物。任意で、遅い。",
		"手順: 木の作物棒は棒から。日誌は本と羽根ペンと種。分析器はガラスと木。耕地に植える。"
	]
	quest.42000000002A0643.title: "Netherite Sliver"
	quest.42000000002A0644.quest_desc: [
		"AgriCraft 自身の花。任意。",
		"手順: 木の作物棒は棒から。日誌は本と羽根ペンと種。分析器はガラスと木。耕地に植える。"
	]
	quest.42000000002A0644.title: "Amathyllis Petal"
	reward.5000000000060135.title: "帰還の糸：Clowder のライフ +1"
	reward.5000000000080193.title: "帰還の糸：Clowder のライフ +1"
	reward.50000000000901CC.title: "帰還の糸：Clowder のライフ +1"
	reward.5000000000170337.title: "帰還の糸：Clowder のライフ +1"
	reward.50000000002004DD.title: "帰還の糸：Clowder のライフ +1"
	reward.5000000000220581.title: "帰還の糸：Clowder のライフ +1"
	reward.7200000000000101.title: "帰還の糸：Clowder のライフ +1（右クリックで使う）"
	reward.7200000000000102.title: "浮島の守り手の備え（抽選四回）"
	reward.7200000000000201.title: "帰還の糸：Clowder のライフ +1（右クリックで使う）"
	reward.7200000000000202.title: "砂利歌いの備え（抽選四回）"
	reward.7200000000000301.title: "帰還の糸：Clowder のライフ +1（右クリックで使う）"
	reward.7200000000000302.title: "根結びの備え（抽選四回）"
	reward.7200000000000401.title: "帰還の糸：Clowder のライフ +1（右クリックで使う）"
