	quest.42000000001C042B.title: "機械プレス（時計仕掛け）"
	quest.42000000001C042C.quest_desc: [
		"砥石か粉ひきの仕事。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.42000000001C042C.title: "石臼（時計仕掛け）"
	quest.42000000001C042D.quest_desc: [
		"向かい合って回る二つの車輪の間に、鉱石を送る。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.42000000001C042D.title: "破砕ホイール"
	quest.42000000001C042E.quest_desc: [
		"洗いと乾かしのためのファン。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
