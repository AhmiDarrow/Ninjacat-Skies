{
	chapter.3100000000000001.chapter_subtitle: [
		"目覚め——生き延び、浮島を確保し、写本を目覚めさせろ。"
	]
	chapter.3100000000000001.title: "ストランド：土壌"
	chapter.3100000000000002.chapter_subtitle: [
		"回収——落ちた世界を物質へ引き戻せ。"
	]
	chapter.3100000000000002.title: "ストランド：石"
	chapter.3100000000000003.chapter_subtitle: [
		"根を張れ——錨を育て、浮島のほつれを止めろ。"
	]
	chapter.3100000000000003.title: "ストランド：芽"
	chapter.3100000000000004.chapter_subtitle: [
		"縁——支度して、わざと浮島を離れろ。"
	]
	chapter.3100000000000004.title: "ストランド：爪"
	chapter.3100000000000005.chapter_subtitle: [
		"唸れ——針金より先に、リズムと脈動。"
	]
	chapter.3100000000000005.title: "ストランド：火花"
	chapter.3100000000000006.chapter_subtitle: [
		"模様——自分で続いていく歌のような工場。"
	]
	chapter.3100000000000006.title: "ストランド：時計"
	chapter.3100000000000007.chapter_subtitle: [
		"コロニー——何かを生かし、それがまた別のものを生かす。"
	]
	chapter.3100000000000007.title: "ストランド：群れ"
	chapter.3100000000000008.chapter_subtitle: [
		"結べ——印と儀式、一本の紐に二つの編み道。"
	]
	chapter.3100000000000008.title: "ストランド：印"
	chapter.3100000000000009.chapter_subtitle: [
		"織り直せ——デジタルの織機、辺境、断片。"
	]
	chapter.3100000000000009.title: "ストランド：紡錘"
	chapter.310000000000000A.title: "深ふるい"
	chapter.310000000000000B.title: "収納とバックパック"
	chapter.310000000000000C.title: "Mekanism の工房"
	chapter.310000000000000D.title: "Powah の電網"
	chapter.310000000000000E.title: "秘術側"
	chapter.310000000000000F.chapter_subtitle: [
		"チーム、ホール、柱、そしてほつれ。"
	]
	chapter.310000000000000F.title: "Clowder ホール"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "厨房ライン"
	chapter.3100000000000013.title: "戦闘呪文"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "浮島の装飾"
	chapter.3100000000000016.title: "ネザーの足場"
	chapter.3100000000000017.title: "エンドの足場"
	chapter.3100000000000018.title: "エッセンス畑"
	chapter.3100000000000019.chapter_subtitle: [
		"どの巣も、花を囲む何かの輪だ。"
	]
	chapter.3100000000000019.title: "群れの養蜂箱"
	chapter.310000000000001A.title: "配管"
	chapter.310000000000001B.title: "異界"
	chapter.310000000000001C.title: "深層の時計仕掛け"
	chapter.310000000000001D.title: "紡錘の網"
	chapter.310000000000001E.title: "虚空工芸"
	chapter.310000000000001F.title: "包装ライン"
	chapter.3100000000000020.title: "QIO と Mek の頂"
	chapter.3100000000000021.title: "狩りと農"
	chapter.3100000000000022.title: "部族の織り"
	chapter.3100000000000023.chapter_subtitle: [
		"砂利歌いは一つの石を百通りに切る。"
	]
	chapter.3100000000000023.title: "石工"
	chapter.3100000000000024.chapter_subtitle: [
		"浮島は、誰かが椅子を置くまではただの縁だ。"
	]
	chapter.3100000000000024.title: "家具"
	chapter.3100000000000025.chapter_subtitle: [
		"執事が残した小さな機械。"
	]
	chapter.3100000000000025.title: "小さな執事所"
	chapter.3100000000000026.chapter_subtitle: [
		"太鼓の心臓の脈が、銅の中を走ることを覚える。"
	]
	chapter.3100000000000026.title: "電流"
	chapter.3100000000000027.chapter_subtitle: [
		"断ちが十三の守護者を断ち切った。その守護者を倒して、各ストランドの張力を戻せ。"
	]
	chapter.3100000000000027.title: "断たれた守護者"
	chapter.3100000000000028.chapter_subtitle: [
		"辺境を歩け。黄色を手なずけろ。そこに行ったあと、Esther がホールで待っている。"
	]
	chapter.3100000000000028.title: "浮島の走り手"
	chapter.3100000000000029.chapter_subtitle: [
		"ふるいの庭。虚空の浮島が一度も育てなかったものを調理しろ。"
	]
	chapter.3100000000000029.title: "収穫の卓"
	chapter.310000000000002A.chapter_subtitle: [
		"作物の棒、数値、灌漑。岩棚では雑草は根づかない。"
	]
	chapter.310000000000002A.title: "作物の棒"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "製作と張力"
	chapter_group.2100000000000003.title: "織り直す"
	chapter_group.2100000000000004.title: "脇道"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"岩棚で目を覚ました。奈落を見て、それからここをクリック。",
		"グレイブ（`）は任務一覧。ウィスカー写本はここから始める。",
		"手順: クエストをクリック。それからオークを殴る。"
	]
	quest.4200000000018001.title: "奈落を見る"
	quest.4200000000010001.quest_desc: [
		"あなたは Skybound。これは落ちなかったもの。",
		"原木が八つ。木から始めよう。先に始めたのは木のほうだ。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 浮島のオークを殴る。原木八つで目覚めが始まる。"
	]
	quest.4200000000010001.title: "浮島で目覚める"
	quest.4200000000010002.quest_desc: [
		"土は、浮島が靴へ渡す約束。",
		"十六ブロック。約束を広げよう。",
		"手順: 初期チェスト、丸石＋糸の消費レシピ、ふるいの残り、または /clowder hub（浮島の守り手）。"
	]
	quest.4200000000010002.title: "立つ足場"
	quest.4200000000010003.quest_desc: [
		"手には台が要る。このあとは、全部台だ。",
		"手順: 板材四つを正方形に。"
	]
	quest.4200000000010003.title: "作業台を作る"
	quest.4200000000010004.quest_desc: [
		"爪はあとだ。今は、噛む木。",
		"手順: 板材三つを棒二つの上に。"
	]
	quest.4200000000010004.title: "木のツルハシ"
	quest.4200000000010005.quest_desc: [
		"奈落に向かう緑。",
		"腹が減る前に植えよう。",
		"手順: オークの葉を壊す。または /clowder hub 根結び（糸8で四つ）。"
	]
	quest.4200000000010005.title: "最初の苗木"
	quest.4200000000010006.quest_desc: [
		"板材が六十四あれば、浮島は岩棚の気分ではなくなる。",
		"手順: クラフト格子に原木一つで四つ。"
	]
	quest.4200000000010006.title: "板材の蓄え"
	quest.4200000000010007.quest_desc: [
		"柄、枠、道具の骨。",
		"手順: 板材二つを縦に。"
	]
	quest.4200000000010007.title: "棒の束"
	quest.4200000000010008.quest_desc: [
		"物は、留まる場所に置け。Clowder は何を分け合うより先にチェストを分け合う。",
		"手順: 板材八つを空の中央の周りに。"
	]
	quest.4200000000010008.title: "Clowder のチェスト"
	quest.4200000000010009.quest_desc: [
		"縁があなたを見る前に、縁を見よ。",
		"手順: 石炭か木炭を棒の上に。 /clowder hub の親族がひと束を売る。"
	]
	quest.4200000000010009.title: "松明の列"
	quest.420000000001000A.quest_desc: [
		"氷と溶岩が、何もなかった場所に石を作る。",
		"普通と困難の浮島は両方を積んでくる。 /clowder hub の浮島の守り手がバケツを売る。",
		"手順: 水の隣に溶岩（または氷を溶かす）。石をハンマーで叩く。 /clowder hub の砂利歌いの屋台が束を売る。"
	]
	quest.420000000001000A.title: "丸石の蓄え"
	quest.420000000001000B.quest_desc: [
		"まだ火花ではないぬくもり。",
		"浮島の守り手なら、これを炉と呼んだだろう。",
		"手順: 丸石八つを空の中央の周りに。"
	]
	quest.420000000001000B.title: "かまどの熱"
	quest.420000000001000C.quest_desc: [
		"空腹は柔らかい虚空。パン八つがしばらくそれを閉じる。",
		"手順: 小麦三つを横一列に。または /clowder hub の炉の守り手。"
	]
	quest.420000000001000C.title: "食事を作る"
	quest.420000000001000D.quest_desc: [
		"溶岩を置き、氷を水源まで溶かし、バケツを満たす。",
		"簡単は水を積む。普通と困難は部品を積む。",
		"手順: 空のバケツを水源に。普通/困難：溶岩を置き、氷を溶かし、満たす。"
	]
	quest.420000000001000D.title: "雨を受ける"
	quest.420000000001000E.quest_desc: [
		"まだ保っている織機のかけら。どのクエストも少し返す。",
		"一つほどいて紐にするか、 /clowder hub の親族の屋台で使う。",
		"手順: クエスト報酬、織機枠に火打石の網を張った土、執事の蔵。"
	]
	quest.420000000001000E.title: "ほつれた通貨"
	quest.420000000001000F.quest_desc: [
		"傷んでいるが、まだ教える。ここから始めるを開け。",
		"本を右クリックして、ここから始めるを開く。グレイブ（`）：任務一覧。",
		"手順: 初期キット / 桟橋のチェスト。本を右クリックすると、グレイブ（`）が任務一覧。"
	]
	quest.420000000001000F.title: "手にした写本"
	quest.4200000000010010.quest_desc: [
		"スポーン地点を決める。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010010.title: "ベッド確保"
	quest.4200000000010011.quest_desc: [
		"ロープなしで深みへ降りる。どの縦穴にも置きっぱなしにできる安さ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010011.title: "下り梯子"
	quest.4200000000010012.quest_desc: [
		"あとで網に使うクモの糸。どの繊維もいつかは使う。",
		"手順: ほつれた糸をほどく (1 → 3)。クモ。残響の結束で織機の糸くず。毛糸の逆消費。"
	]
	quest.4200000000010012.title: "紐の蓄え"
	quest.4200000000010013.quest_desc: [
		"緑を急がせる。",
		"手順: 骨をグリッドに入れるか、糸 + 腐った肉の消費か、/clowder hub 浮島の守り手。"
	]
	quest.4200000000010013.title: "骨粉の蓄え"
	quest.4200000000010014.quest_desc: [
		"浮島を広げる。",
		"手順: 初期チェスト、丸石＋糸の消費レシピ、ふるいの残り、または /clowder hub（浮島の守り手）。"
	]
	quest.4200000000010014.title: "土の浮島"
	quest.4200000000010015.quest_desc: [
		"今刈って、あとで堆肥に。浮島では何も無駄にならない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010015.title: "オークの葉"
	quest.4200000000010016.quest_desc: [
		"静かな隅。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010016.title: "植木鉢"
	quest.4200000000010017.quest_desc: [
		"Ex Deorum の樽は堆肥にし、水をゆっくり粘土にする。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010017.title: "樽"
	quest.4200000000010018.quest_desc: [
		"ごみを粉に。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010018.title: "コンポスター"
	quest.4200000000010019.quest_desc: [
		"一列を引っかく。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010019.title: "木のクワ"
	quest.420000000001001A.quest_desc: [
		"素手より速く原木を倒す。Skybound が持つ最初の本物の道具。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001001A.title: "木の斧"
	quest.420000000001001B.quest_desc: [
		"土と砂利を整地する。遅いが、役に立つ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001001B.title: "木のシャベル"
	quest.420000000001001C.quest_desc: [
		"ゾンビをかろうじて止める。でも、止める。拳を振るよりまし。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001001C.title: "木の剣"
	quest.420000000001001D.quest_desc: [
		"スープとシチューくらいしか入らない。簡素な浮島に簡素な器。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001001D.title: "ボウル"
	quest.420000000001001E.quest_desc: [
		"浮島に札を付ける。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001001E.title: "額縁"
	quest.420000000001001F.quest_desc: [
		"居場所にする。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001001F.title: "絵画"
	quest.4200000000010020.quest_desc: [
		"風とモブを壁の正しい側に留める。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010020.title: "オークのドア"
	quest.4200000000010021.quest_desc: [
		"景色を遮らず縁を示す。落ちたら本当に落ちる場所で役立つ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010021.title: "オークのフェンス"
	quest.4200000000010022.quest_desc: [
		"切り立った壁を、実際に登れるものにする。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010022.title: "オークの階段"
	quest.4200000000010023.quest_desc: [
		"半ブロックで、床の選択肢は倍。狭い場所で役立つ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010023.title: "オークのハーフブロック"
	quest.4200000000010024.quest_desc: [
		"出入りの上げ戸。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010024.title: "オークのトラップドア"
	quest.4200000000010025.quest_desc: [
		"何かが踏むと信号が出る。ドアは勝手に開く。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010025.title: "オークの感圧板"
	quest.4200000000010026.quest_desc: [
		"レッドストーンの短押し用ボタン。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010026.title: "オークのボタン"
	quest.4200000000010027.quest_desc: [
		"浮島の縁に柵を。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010027.title: "棒のフェンスゲート"
	quest.4200000000010028.quest_desc: [
		"食べ物をゆっくり煮て、煙は遠くまで見える。",
		"手順: 原木、棒、石炭か木炭。"
	]
	quest.4200000000010028.title: "焚き火"
	quest.4200000000010029.quest_desc: [
		"松明が似合わない場所に明かりを吊る。より暖かい光、仕事は同じ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010029.title: "ランタン"
	quest.420000000001002A.quest_desc: [
		"淡い青で燃え、近くにはほとんど何も湧かない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001002A.title: "魂のランタン"
	quest.420000000001002B.quest_desc: [
		"一緒に登り、引っ張ると消える。高いところを建てるのが怖くなくなる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001002B.title: "足場"
	quest.420000000001002C.quest_desc: [
		"吊るして飾る鎖。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001002C.title: "鎖"
	quest.420000000001002D.quest_desc: [
		"縁を囲え。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001002D.title: "鉄格子"
	quest.420000000001002E.quest_desc: [
		"浮島の窓用のガラス。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001002E.title: "ガラス板"
	quest.420000000001002F.quest_desc: [
		"柔らかく、燃えやすく、染めやすい。どの浮島もやがてベッドが要る。",
		"手順: 草を与えてから羊を刈るか、紐4本。"
	]
	quest.420000000001002F.title: "白色の羊毛"
	quest.4200000000010030.quest_desc: [
		"ブロック丸ごと要らない床向けの、薄い羊毛。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010030.title: "白色のカーペット"
	quest.4200000000010031.quest_desc: [
		"砂利の浮島に、緑とピンクを少し足す。",
		"手順: 苔とオーク、または苔に骨粉。ミツバチは花を受け入れる。"
	]
	quest.4200000000010031.title: "花咲くツツジ"
	quest.4200000000010032.quest_desc: [
		"ゆっくり広がり、むき出しの石の台の見た目を和らげる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010032.title: "苔ブロック"
	quest.4200000000010033.quest_desc: [
		"浮島の下に垂れる根。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010033.title: "垂れ根"
	quest.4200000000010034.quest_desc: [
		"壁に張り付いて、松明一本なしで照らす。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010034.title: "ヒカリゴケ"
	quest.4200000000010035.quest_desc: [
		"尖った飾りの鍾乳石。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010035.title: "尖った鍾乳石"
	quest.4200000000010036.quest_desc: [
		"ブロックになったアメジスト。印は後で欠片を求める。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010036.title: "アメジストブロック"
	quest.4200000000010037.quest_desc: [
		"インゴット9個を押し固めたもの。外に置くと緑に変わる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010037.title: "銅ブロック"
	quest.4200000000010038.quest_desc: [
		"鉄の原石9個をぎゅっと重ね、かまどを待っている。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010038.title: "鉄の原石ブロック"
	quest.4200000000010039.quest_desc: [
		"ばらの石炭よりずっと長く燃える。かまどに入れて立ち去れ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000010039.title: "石炭ブロック"
	quest.420000000001003A.quest_desc: [
		"動物の餌になり、落下を遅くする。農家は両方のために近くに置く。",
		"手順: 小麦9個。小麦3個でもパンになる。"
	]
	quest.420000000001003A.title: "干草の俵"
	quest.420000000001003B.quest_desc: [
		"昆布9個を押し固めた燃料。見た目以上に精錬できる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001003B.title: "乾燥した昆布ブロック"
	quest.420000000001003C.quest_desc: [
		"紙と革。レシピのある何かになるのを待っている。",
		"手順: 紙3枚と革。紙はサトウキビ。"
	]
	quest.420000000001003C.title: "本"
	quest.420000000001003D.quest_desc: [
		"本と地図のための紙。",
		"手順: サトウキビを3本一列に。キビは火打石の網かそれ以上で土をふるって得る。"
	]
	quest.420000000001003D.title: "紙"
	quest.420000000001003E.quest_desc: [
		"染料と本にはインクが要る。",
		"手順: 木炭とガラス瓶。イカはここでは決して湧かない。"
	]
	quest.420000000001003E.title: "イカスミ"
	quest.420000000001003F.quest_desc: [
		"矢と本のための羽。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000001003F.title: "羽根"
	quest.4200000000010040.quest_desc: [
		"本とキットのための革。",
		"手順: 腐った肉を精錬するか、焚き火で焼く。火打石の網で土をふるう。/clowder hub 浮島の守り手が糸18個で2つ売る。"
	]
	quest.4200000000010040.title: "革"
	quest.4200000000010041.quest_desc: [
		"作業台、苗木、炉、水、写本。浮島は保つ。",
		"ストランドに張力をかけよ。浮島の守り手が応え、札はあなたが据える。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.4200000000010041.quest_subtitle: "目覚め"
	quest.4200000000010041.title: "土壌の結び"
	quest.4200000000010042.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.4200000000010042.title: "土壌を据える"
	quest.4200000000010043.quest_desc: [
		"洞窟のない浮島にゾンビ。虚空がよろしくと伝えてくる。",
		"縁を照らす。",
		"手順: 夜に浮島でゾンビを倒す。縁を照らす。"
	]
	quest.4200000000010043.title: "何かが出てきた"
	quest.4200000000020044.quest_desc: [
		"出自を覚えている糸。",
		"糸をほどいて紐に。紐四つで毛糸を二つ紡ぐ。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 紐四つ → 毛糸二つ。張力の樽：紐 + パール。織機の糸くず四つ。"
	]
	quest.4200000000020044.title: "虚空の毛糸を引く"
	quest.4200000000020045.quest_desc: [
		"丸石と棒。落ちた砂粒を砂利、砂、粉に砕く。",
		"手順: 丸石 + 棒。砂粒を砂利、砂、粉に砕く。"
	]
	quest.4200000000020045.title: "紡錘の槌"
	quest.4200000000020046.quest_desc: [
		"毛糸の周りに紐。織機が落としたものを捕る——そして土から織機の糸くずを梳き出す。",
		"手順: 毛糸の周りに紐。砂利歌いの屋台で一つ売っている。"
	]
	quest.4200000000020046.title: "網に紐を通す"
	quest.4200000000020047.quest_desc: [
		"水を注ぐ。バケツはそのまま戻る。土を足す。粘土を待つ。",
		"同じ樽の紐とパールが毛糸になる。",
		"手順: 板材、紐、虚空の毛糸。水を注ぐ（バケツは戻る）、土を足す → 粘土。"
	]
	quest.4200000000020047.title: "張力の樽"
	quest.4200000000020048.quest_desc: [
		"樽から粘土十六。一度に土を八つ入れる。",
		"手順: 張力の樽——水 + 土。残響粉砕機が砂を粘土に叩く。"
	]
	quest.4200000000020048.title: "粘土ポケット"
	quest.4200000000020049.quest_desc: [
		"粘土と骨粉。未焼成のバケツを形作る。",
		"手順: 粘土玉 + 骨粉、不定形。粘土は張力の樽から。"
	]
	quest.4200000000020049.title: "磁器粘土"
	quest.420000000002004A.quest_desc: [
		"製錬する。鉄がまだ噂の場所で、磁器が溶岩を運ぶ。",
		"手順: 磁器粘土を未焼成のバケツに成形し、それから製錬する。"
	]
	quest.420000000002004A.title: "磁器の道具"
	quest.420000000002004B.quest_desc: [
		"砂利歌いは、どの欠片にも反響で名をつけた。",
		"鉄が聞こえるまでふるう。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.420000000002004B.title: "落ちた砂粒をふるう"
	quest.420000000002004C.quest_desc: [
		"予備の一撃セット。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.420000000002004C.title: "木のハンマー"
	quest.420000000002004D.quest_desc: [
		"砂粒からの物質。一時間前は粉だった石が六十四。",
		"手順: 水の隣に溶岩（または氷を溶かす）。石をハンマーで叩く。 /clowder hub の砂利歌いの屋台が束を売る。"
	]
	quest.420000000002004D.title: "小石"
	quest.420000000002004E.quest_desc: [
		"織機の粉は砂利の中で待つ。火打石も。",
		"手順: 丸石を叩く（紡錘の槌か残響粉砕機）。"
	]
	quest.420000000002004E.title: "砂利の道"
	quest.420000000002004F.quest_desc: [
		"細かい砂粒。ガラスはあと。鉄の網が一番よく捕るもの。",
		"手順: 砂利を叩く。"
	]
	quest.420000000002004F.title: "砂の蓄え"
	quest.4200000000020050.quest_desc: [
		"落ちた世界の灰。レッドストーンと火薬がそこに潜む。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.4200000000020050.title: "粉の山"
	quest.4200000000020051.quest_desc: [
		"スライムの周りに毛糸。浮島の堆肥がスライムを作る。",
		"結びは織機のやわらかい門。二つ残す。",
		"手順: スライムボールを囲む虚空の毛糸の輪。"
	]
	quest.4200000000020051.title: "結束の結びを結ぶ"
	quest.4200000000020052.quest_desc: [
		"結びの周りに板材。網を張り、砂粒を載せて働かせる。",
		"ホッパーがそれを入れる。浮島で最初の機械だ。",
		"手順: 結束の結びの周りに板材。網を張り、ホッパーで砂粒を入れ、ホッパーの上に置く。"
	]
	quest.4200000000020052.title: "織機枠を立てる"
	quest.4200000000020053.quest_desc: [
		"鉄は低く、辛抱強い。網から塊八つ。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.4200000000020053.title: "鉄鉱石の塊"
	quest.4200000000020054.quest_desc: [
		"砂利から少しずつふるい出す。網はあなたの目より先に銅を見つける。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.4200000000020054.title: "銅鉱石の塊"
	quest.4200000000020055.quest_desc: [
		"金は応える手間をほとんどかけない。四つで足りる。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.4200000000020055.title: "金鉱石の塊"
	quest.4200000000020056.quest_desc: [
		"ラインに燃料を。",
		"手順: 砂利をふるうか、石炭鉱石を製錬する。"
	]
	quest.4200000000020056.title: "石炭"
	quest.4200000000020057.quest_desc: [
		"塊から原石へ。製錬は続ける。",
		"手順: 砂利をふるって鉄鉱石の塊を。四つで鉄鉱石ブロックになり、掘ると鉄の原石が落ちる。"
	]
	quest.4200000000020057.title: "鉄の原石"
	quest.4200000000020058.quest_desc: [
		"回収が払う。虚空があなたに持たせたくなかったインゴット十六本。",
		"手順: 鉄の原石 / 鉄の砂粒を製錬する（かまどか残り火の窯）。砂利をふるって塊を得る。"
	]
	quest.4200000000020058.title: "鉄インゴット"
	quest.4200000000020059.quest_desc: [
		"導線と電球、そのあとは部族の共鳴器。",
		"手順: 銅の原石 / 銅の砂粒を製錬する。砂利をふるう。"
	]
	quest.4200000000020059.title: "銅インゴット"
	quest.420000000002005A.quest_desc: [
		"金の道具、そして模様織りのための金の板。",
		"手順: 金の原石 / 金の砂粒を製錬する。ふるいの獲物としてはより珍しい。"
	]
	quest.420000000002005A.title: "金インゴット"
	quest.420000000002005B.quest_desc: [
		"より鋭い収穫。火打石の網が砂粒からほつれた糸を振り出す。",
		"手順: 糸の網（紐）の周りに火打石。"
	]
	quest.420000000002005B.title: "火打石の網"
	quest.420000000002005C.quest_desc: [
		"重い粉のための金属の糸。鉄の網はストランド繊維が落ちる場所。",
		"手順: 糸の網（火打石）の周りに鉄。ストランド繊維はここから始まる。"
	]
	quest.420000000002005C.title: "鉄の網"
	quest.420000000002005D.quest_desc: [
		"溶かして滴らせる。時間をかければ丸石が溶岩になる。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.420000000002005D.title: "るつぼ"
	quest.420000000002005E.quest_desc: [
		"Ex Deorum の樽は堆肥にし、水をゆっくり粘土にする。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.420000000002005E.title: "樽（石）"
	quest.420000000002005F.quest_desc: [
		"より硬い打撃、より長い寿命。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.420000000002005F.title: "石のハンマー"
	quest.4200000000020060.quest_desc: [
		"鉱石を砂利と砂粒に砕く。ふるいの裏にある騒がしい技。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.4200000000020060.title: "鉄のハンマー"
	quest.4200000000020061.quest_desc: [
		"より広い網。一度に九つ。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.4200000000020061.title: "圧縮ふるい"
	quest.4200000000020062.quest_desc: [
		"透けて見える。砂がガラスになる。",
		"手順: 砂を製錬する。ハンマーで丸石を砂利に、砂利を砂に、それからかまどへ。"
	]
	quest.4200000000020062.title: "ガラス"
	quest.4200000000020063.quest_desc: [
		"今は鉄で雨を運ぶ。",
		"手順: 鉄インゴット三つ、または /clowder hub 浮島の守り手（糸8）。溶けた氷から満たす。"
	]
	quest.4200000000020063.title: "バケツ"
	quest.4200000000020064.quest_desc: [
		"虚空の熱を、手に。",
		"手順: Ex Deorum の溶岩るつぼ、または爪の黒曜石のあとにネザーの溶岩だまり。"
	]
	quest.4200000000020064.title: "溶岩入りバケツ"
	quest.4200000000020065.quest_desc: [
		"ポータルの考え。溶岩源に水を。",
		"手順: 溶岩源に水を（または水に溶岩を）。溶岩源は残す。"
	]
	quest.4200000000020065.title: "黒曜石"
	quest.4200000000020066.quest_desc: [
		"砂粒の珍しい運。二つで始まり。",
		"手順: 鉄の網かそれ以上で砂利をふるう。または残響粉砕機でダイヤモンド鉱石を。"
	]
	quest.4200000000020066.title: "ダイヤモンド"
	quest.4200000000020067.quest_desc: [
		"網の強化の燃料。",
		"手順: 砂利、または糸 + 砂利の消費。"
	]
	quest.4200000000020067.title: "火打石"
	quest.4200000000020068.quest_desc: [
		"砂粒と粉から作る。クリーパーから奪うのではない。慎重に扱え。",
		"手順: 粉かソウルサンドをふるう。または夜の浮島のクリーパー。少し手に入ったら縁を照らしたままに。"
	]
	quest.4200000000020068.title: "火薬"
	quest.4200000000020069.quest_desc: [
		"火花がこれを欲しがる。乾かしておけ。",
		"手順: 砂利をふるう。または回収のあと、残響粉砕機でレッドストーン鉱石を。"
	]
	quest.4200000000020069.title: "レッドストーン"
	quest.420000000002006A.quest_desc: [
		"エンチャント台の糧。装備がもっと素直に聞く青い粉。",
		"手順: 砂利をふるう。または残響粉砕機でラピスラズリ鉱石を。"
	]
	quest.420000000002006A.title: "ラピスラズリ"
	quest.420000000002006B.quest_desc: [
		"ありふれた石の混ぜ物。主に建築と、あとでレシピを混ぜるのに役立つ。",
		"手順: 土/砂利の小石をふるう。または JEI で丸石に閃緑岩を足す。"
	]
	quest.420000000002006B.title: "安山岩"
	quest.420000000002006C.quest_desc: [
		"まだらの石。構造より飾り。砂利歌いはこれをうるさい石と呼んだ。",
		"手順: 小石をふるう。または丸石にネザークォーツを足す。"
	]
	quest.420000000002006C.title: "閃緑岩"
	quest.420000000002006D.quest_desc: [
		"密でピンクの斑点。目立ちたい床に向く。",
		"手順: 小石をふるう。または閃緑岩にネザークォーツを足す。"
	]
	quest.420000000002006D.title: "花崗岩"
	quest.420000000002006E.quest_desc: [
		"向こうの場所から来た多孔の岩。火がつけば、永遠に燃える。",
		"手順: ここのネザーは虚空で、地形ではない。魔女の水が入った Ex Deorum の樽に溶岩を注ぐ（菌糸の上に置いた水樽。菌糸の胞子は土をふるって得る）。"
	]
	quest.420000000002006E.title: "ネザーラック"
	quest.420000000002006F.quest_desc: [
		"踏む一歩を遅くし、ソウルファイアにもっと冷たい青をくべる。",
		"手順: 砂を、魔女の水入りの Ex Deorum の樽へ。要塞のネザーウォート部屋に少しある。ソウルサンドに頭蓋骨三つでウィザー。"
	]
	quest.420000000002006F.title: "ソウルサンド"
	quest.4200000000020070.quest_desc: [
		"ネザーのグロウストーンを砕いた粉で、醸造にも、より柔らかい光源にも使える。",
		"手順: ソウルサンドをふるうか、浮島のウィッチ。"
	]
	quest.4200000000020070.title: "グロウストーンダスト"
	quest.4200000000020071.quest_desc: [
		"幹に斧を振るわず、木から葉をこそぎ取る。",
		"手順: 棒四つ。砂利歌いの屋台が一つ売る。"
	]
	quest.4200000000020071.title: "鉤杖"
	quest.4200000000020072.quest_desc: [
		"ふるいから、増えていく山。どの網にも、いつも少し足りない。",
		"手順: ほつれた糸をほどく (1 → 3)。クモ。残響の結束で織機の糸くず。毛糸の逆消費。"
	]
	quest.4200000000020072.title: "紐"
	quest.4200000000020073.quest_desc: [
		"結びの結合材。または浮島の堆肥レシピ。",
		"手順: 土二つ + 小麦の種 + 骨粉（浮島の堆肥）、または /clowder hub 浮島の守り手。"
	]
	quest.4200000000020073.title: "スライムボール"
	quest.4200000000020074.quest_desc: [
		"骨粉に挽くか、丸ごと残して群れの次のオオカミを育てる。",
		"手順: 夜のスケルトン、または /clowder hub 浮島の守り手（糸16で8個）。"
	]
	quest.4200000000020074.title: "骨"
	quest.4200000000020075.quest_desc: [
		"苦く、かすかに毒。醸造には使うが、そのまま食べる者はいない。",
		"手順: 夜、浮島のクモ。"
	]
	quest.4200000000020075.title: "クモの目"
	quest.4200000000020076.quest_desc: [
		"毛糸、磁器、動く織機枠、チェストの中の鉄。",
		"ストランドに張力を。砂利歌いが応える。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.4200000000020076.quest_subtitle: "回収"
	quest.4200000000020076.title: "石の結び"
	quest.4200000000020077.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.4200000000020077.title: "石を据える"
	quest.4200000000020078.quest_desc: [
		"クリーパーは片付けた。火薬は、怖さより価値がある。",
		"手順: クリーパーを三体倒す。火薬が報酬。"
	]
	quest.4200000000020078.title: "ドカンはあとで"
	quest.4200000000030079.quest_desc: [
		"浮島に列を引っかく。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 鉄インゴット二つを棒の上に。"
	]
	quest.4200000000030079.title: "鉄のクワ"
	quest.420000000003007A.quest_desc: [
		"パンは基盤だ。小麦三十二は畑であり、小さな畝ではない。",
		"手順: 耕地に小麦の種、それから骨粉。種は草を壊すか、初期チェストから。"
	]
	quest.420000000003007A.title: "小麦畑"
	quest.420000000003007B.quest_desc: [
		"食べるものを植える。",
		"手順: 草を壊すか、火打石の網で土をふるう。耕地に植える。骨粉が最初の畑を速める。"
	]
	quest.420000000003007B.title: "種袋"
	quest.420000000003007C.quest_desc: [
		"速さは優しさ。堆肥と骨。",
		"手順: 骨をグリッドに入れるか、糸 + 腐った肉の消費か、/clowder hub 浮島の守り手。"
	]
	quest.420000000003007C.title: "骨粉機関"
	quest.420000000003007D.quest_desc: [
		"収穫の支度。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000003007D.title: "農夫のナイフ"
	quest.420000000003007E.quest_desc: [
		"厨房はここから始まる。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000003007E.title: "まな板"
	quest.420000000003007F.quest_desc: [
		"温かい食事は、空腹以上を満たす。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000003007F.title: "鍋"
	quest.4200000000030080.quest_desc: [
		"きれいな結球で育ち、生より料理したほうがいい。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000030080.title: "キャベツ"
	quest.4200000000030081.quest_desc: [
		"自分の棚を登り、赤く熟す。ソースはここから始まる。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000030081.title: "トマト"
	quest.4200000000030082.quest_desc: [
		"嬉し涙。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000030082.title: "タマネギ"
	quest.4200000000030083.quest_desc: [
		"エッセンス栽培が始まる。最初の列から十六。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"種の背骨。ふるうか、育てる。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"エッセンスから種を起こす。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030085.title: "注入の祭壇"
	quest.4200000000030086.quest_desc: [
		"祭壇の周りに四つ。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030086.title: "注入の台座"
	quest.4200000000030087.quest_desc: [
		"浮島をさらに育てる。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030087.title: "土の種"
	quest.4200000000030088.quest_desc: [
		"斧なしで樹冠を育てる。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030088.title: "木の種"
	quest.4200000000030089.quest_desc: [
		"掘らず、育てる。ツルハシを振る代わりにエッセンスを収穫する。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030089.title: "石の種"
	quest.420000000003008A.quest_desc: [
		"作物からの金属。回収の第二のエンジン。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000003008A.title: "鉄の種"
	quest.420000000003008B.quest_desc: [
		"銅鉱石の代わりに銅のエッセンスを出す作物。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000003008B.title: "銅の種"
	quest.420000000003008C.quest_desc: [
		"浮島の上でそのまま金のエッセンスを育てる金の作物。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000003008C.title: "金の種"
	quest.420000000003008D.quest_desc: [
		"採掘なしで、畑を燃料源に変える。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000003008D.title: "石炭の種"
	quest.420000000003008E.quest_desc: [
		"作物から瓶詰めの雨。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000003008E.title: "水の種"
	quest.420000000003008F.quest_desc: [
		"小さな浮島のための、こぢんまりした栽培。",
		"手順: JEI のテラコッタ Botany Pot。鉢に土 + 種。骨粉は今も役立つ。"
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"自分で収穫する鉢。",
		"手順: JEI のホッパー Botany Pot。チェスト/ホッパーの上に置き、自分で収穫する。"
	]
	quest.4200000000030090.title: "ホッパー鉢"
	quest.4200000000030091.quest_desc: [
		"段階を上げる。種はもっと欲深く、もっと良くなる。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"作物エッセンスの、もう一段深い等級。初めの種より強い。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"骨粉九つでブロック一つ。エンジンのための保管。",
		"手順: 骨粉九つ。骨はスケルトンか浮島の守り手から。"
	]
	quest.4200000000030093.title: "骨ブロック"
	quest.4200000000030094.quest_desc: [
		"芽の余り、積み上げ。",
		"手順: 小麦9個。小麦3個でもパンになる。"
	]
	quest.4200000000030094.title: "干し草サイロ"
	quest.4200000000030095.quest_desc: [
		"より良い畑。根結びも認めるだろう。",
		"手順: 有機堆肥を置いて待つと、ゆっくり豊かな土壌になる。"
	]
	quest.4200000000030095.title: "肥沃な土"
	quest.4200000000030096.quest_desc: [
		"養ってくれる土壌を養う。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000030096.title: "有機コンポスト"
	quest.4200000000030097.quest_desc: [
		"一列植え、馬にやるか、生のまま食べる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000030097.title: "ニンジン"
	quest.4200000000030098.quest_desc: [
		"主食の作物、ジャガイモ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000030098.title: "ジャガイモ"
	quest.4200000000030099.quest_desc: [
		"早く育ち、赤く染める。スープ、シチュー、あるいは土からそのまま。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000030099.title: "ビートルート"
	quest.420000000003009A.quest_desc: [
		"食料と取引のスイカ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000003009A.title: "スイカ"
	quest.420000000003009B.quest_desc: [
		"食料と飾りのカボチャ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000003009B.title: "カボチャ"
	quest.420000000003009C.quest_desc: [
		"紙と砂糖。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000003009C.title: "サトウキビ"
	quest.420000000003009D.quest_desc: [
		"水なしで育ち、寄りかかったものを傷つける。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000003009D.title: "サボテン"
	quest.420000000003009E.quest_desc: [
		"早く伸び、熱く燃える。木の少ない浮島に便利な燃料。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000003009E.title: "竹"
	quest.420000000003009F.quest_desc: [
		"建てながら食べるベリー。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000003009F.title: "スイートベリー"
	quest.42000000000300A0.quest_desc: [
		"ジャングルの原木に育ち、甘いものすべてに風味を足す茶色へ挽かれる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000300A0.title: "カカオ"
	quest.42000000000300A1.quest_desc: [
		"オークの葉から、葉の都合で落ちる。そのうち無料の食料。",
		"手順: オークの葉は少し落とす；Pam's のリンゴの木（鉄の網の土からの苗木）はたくさん実る。"
	]
	quest.42000000000300A1.title: "リンゴ"
	quest.42000000000300A2.quest_desc: [
		"ボウル一つ、作業台なし。怠け者の農夫の夕食。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000300A2.title: "キノコシチュー"
	quest.42000000000300A3.quest_desc: [
		"ハチとの深い仕事が始まる前に、巣の味見。",
		"手順: 満杯のハチの巣にガラス瓶。下に焚き火。"
	]
	quest.42000000000300A3.title: "ハチミツ入りの瓶"
	quest.42000000000300A4.quest_desc: [
		"洞窟のツタに育ち、食べている間トンネルを照らす。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000300A4.title: "グロウベリー"
	quest.42000000000300A5.quest_desc: [
		"瓶に詰める価値のあるポーションすべての土台。ソウルサンドにしか生えない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000300A5.title: "ネザーウォート"
	quest.42000000000300A6.quest_desc: [
		"畑、厨房、昇るエッセンス。",
		"ストランドに張力をかけろ：根結びが応える。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.42000000000300A6.quest_subtitle: "根"
	quest.42000000000300A6.title: "芽の結び"
	quest.42000000000300A7.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.42000000000300A7.title: "芽を据える"
	quest.42000000000300A8.quest_desc: [
		"根結びは、誰でもいつか一本は引く。",
		"食べるな。捨てるな。",
		"手順: まれなジャガイモの収穫。任意の芽の秘密。"
	]
	quest.42000000000300A8.title: "違うジャガイモ"
	quest.42000000000400A9.quest_desc: [
		"自分の条件で虚空を切る。設計図は八枚。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 紙四つと青色の染料一つ、不定形。四枚できる。"
	]
	quest.42000000000400A9.title: "設計図用の紙"
	quest.42000000000400AA.quest_desc: [
		"箱に入った設計図。",
		"設計図の紙四つ、不定形 — 浮島を受け取ると Silent Gear の参加時の贈り物が消える。右クリックで初期設計図を開く。",
		"手順: 設計図の紙四つ、不定形。右クリックで初期設計図を開く。浮島を受け取ると Silent Gear の参加時の贈り物が消える。"
	]
	quest.42000000000400AA.title: "設計図パッケージ"
	quest.42000000000400AB.quest_desc: [
		"部品を足す前に、モジュール工具が始まる雛形。",
		"手順: 設計図の包みを開くか、JEI。爪が工具の系統に名を付ける。"
	]
	quest.42000000000400AB.title: "棒の設計図"
	quest.42000000000400AC.quest_desc: [
		"金属より長く持つツルハシを成形する。",
		"手順: 設計図の包みを開くか、JEI。爪が工具の系統に名を付ける。"
	]
	quest.42000000000400AC.title: "ツルハシの設計図"
	quest.42000000000400AD.quest_desc: [
		"斧を成形する。",
		"手順: 設計図の包みを開くか、JEI。爪が工具の系統に名を付ける。"
	]
	quest.42000000000400AD.title: "斧の設計図"
	quest.42000000000400AE.quest_desc: [
		"シャベルを成形する。",
		"手順: 設計図の包みを開くか、JEI。爪が工具の系統に名を付ける。"
	]
	quest.42000000000400AE.title: "シャベルの設計図"
	quest.42000000000400AF.quest_desc: [
		"刃を成形する。",
		"手順: 設計図の包みを開くか、JEI。爪が工具の系統に名を付ける。"
	]
	quest.42000000000400AF.title: "剣の設計図"
	quest.42000000000400B0.quest_desc: [
		"伸びる余地。",
		"手順: 設計図の紙のあと JEI。爪が強化の系統に名を付ける。"
	]
	quest.42000000000400B0.title: "アップグレード基礎"
	quest.42000000000400B1.quest_desc: [
		"部品にする素材の延べ棒、三十二本。",
		"手順: 鉄の原石 / 鉄の砂粒を製錬する（かまどか残り火の窯）。砂利をふるって塊を得る。"
	]
	quest.42000000000400B1.title: "鉄のマス"
	quest.42000000000400B2.quest_desc: [
		"鉄だけでは届かないところまで刃を研ぐ。",
		"手順: 鉄の網かそれ以上で砂利をふるう。または残響粉砕機でダイヤモンド鉱石を。"
	]
	quest.42000000000400B2.title: "ダイヤモンドの先端"
	quest.42000000000400B3.quest_desc: [
		"葉と羊毛、あとでハニカム。",
		"手順: 鉄インゴット二つを斜めに。羊とハチの巣を刈る。"
	]
	quest.42000000000400B3.title: "ハサミ"
	quest.42000000000400B4.quest_desc: [
		"浮島には縁がある。モブにも。",
		"手順: 鉄の周りに板材を六つ。オフハンドで防御。"
	]
	quest.42000000000400B4.title: "盾"
	quest.42000000000400B5.quest_desc: [
		"わざと夜を越せ。",
		"手順: 鉄インゴット八つ。ふるい砂利を製錬する。"
	]
	quest.42000000000400B5.title: "鉄のチェストプレート"
	quest.42000000000400B6.quest_desc: [
		"落下に気をつけろ。",
		"手順: 鉄インゴット五つ。"
	]
	quest.42000000000400B6.title: "鉄のヘルメット"
	quest.42000000000400B7.quest_desc: [
		"まず脚を覆う。ダメージの大半は、どうせ下から来る。",
		"手順: 鉄インゴット七つ。"
	]
	quest.42000000000400B7.title: "鉄のレギンス"
	quest.42000000000400B8.quest_desc: [
		"滑れば虚空になる棚で、足元を確かにする。",
		"手順: 鉄インゴット四つ。"
	]
	quest.42000000000400B8.title: "鉄のブーツ"
	quest.42000000000400B9.quest_desc: [
		"虚空のモブを遠くに保つ。",
		"手順: 紐三つと棒三つ。"
	]
	quest.42000000000400B9.title: "弓"
	quest.42000000000400BA.quest_desc: [
		"距離を保つ理由が六十四。",
		"手順: 火打石、棒、羽。スケルトンが余分を落とす。"
	]
	quest.42000000000400BA.title: "矢の束"
	quest.42000000000400BB.quest_desc: [
		"通り道を照らす。",
		"手順: 鉄インゴットと火打石。"
	]
	quest.42000000000400BB.title: "火打石と打ち金"
	quest.42000000000400BC.quest_desc: [
		"十ブロック。縁歩きなら見分ける扉。",
		"手順: 溶岩源に水を（または水に溶岩を）。溶岩源は残す。"
	]
	quest.42000000000400BC.title: "黒曜石の枠"
	quest.42000000000400BD.quest_desc: [
		"足場の準備。どこか別の場所がある。",
		"手順: エンダーパール（縁歩きの露店 / エンダーマン）と、爪の黒曜石のあとネザー要塞のブレイズパウダー。目八つの備蓄は任意。エンドクリスタルも同じクラフト。"
	]
	quest.42000000000400BD.title: "エンダーアイ"
	quest.42000000000400BE.quest_desc: [
		"硬い道具のための柔らかい力。",
		"手順: ダイヤモンド二つ、黒曜石四つ、本。ダイヤモンドは鉄の網の砂利から。"
	]
	quest.42000000000400BE.title: "エンチャントテーブル"
	quest.42000000000400BF.quest_desc: [
		"持っているものを直し、名を付ける。",
		"手順: 鉄ブロック三つをインゴット四つの上に。"
	]
	quest.42000000000400BF.title: "金床"
	quest.42000000000400C0.quest_desc: [
		"自分のものと呼ぶ。",
		"手順: 釣り / 希少なチェスト、または /clowder hub の印彫りの露店（糸24）。任意。"
	]
	quest.42000000000400C0.title: "名札"
	quest.42000000000400C1.quest_desc: [
		"部品ごとに組む、モジュール式のクワの初期ひな型。",
		"手順: 設計図の包みを開く。または JEI。"
	]
	quest.42000000000400C1.title: "クワの設計図"
	quest.42000000000400C2.quest_desc: [
		"一株ではなく、一振りで作物の広い帯を刈る。",
		"手順: 設計図の包みを開く。または JEI。"
	]
	quest.42000000000400C2.title: "鎌の設計図"
	quest.42000000000400C3.quest_desc: [
		"採掘し、伐採し、掘る一つの道具。もう手の中で持ち替えない。",
		"手順: 設計図の包みを開く。または JEI。"
	]
	quest.42000000000400C3.title: "Paxel の設計図"
	quest.42000000000400C4.quest_desc: [
		"一撃で石を三×三壊す。",
		"手順: 設計図の包みを開く。または JEI。"
	]
	quest.42000000000400C4.title: "ハンマーの設計図"
	quest.42000000000400C5.quest_desc: [
		"どのシャベルよりも速く、土と砂に広い穴を空ける。",
		"手順: 設計図の包みを開く。または JEI。"
	]
	quest.42000000000400C5.title: "掘削の設計図"
	quest.42000000000400C6.quest_desc: [
		"小さく、速く、正確。戦いでなく、近い仕事のため。",
		"手順: 設計図の包みを開く。または JEI。"
	]
	quest.42000000000400C6.title: "ナイフの設計図"
	quest.42000000000400C7.quest_desc: [
		"柔らかい板金で、エンチャントしやすく、防御より魔法に価値がある。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000400C7.title: "金の防具部品"
	quest.42000000000400C8.quest_desc: [
		"海の爪。",
		"任意。虚空は一度も出さないかもしれない。",
		"手順: ドラウンドだけ。任意。"
	]
	quest.42000000000400C8.title: "トライデント"
	quest.42000000000400C9.quest_desc: [
		"装填は遅く、当たりは重く、必要になるまでチャージを保つ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000400C9.title: "クロスボウ"
	quest.42000000000400CA.quest_desc: [
		"虚空を見渡す。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000400CA.title: "望遠鏡"
	quest.42000000000400CB.quest_desc: [
		"設計図、背中に鉄、外への扉。",
		"ストランドに張力を：縁歩きが応える。編みが開く。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.42000000000400CB.quest_subtitle: "縁"
	quest.42000000000400CB.title: "爪の結び"
	quest.42000000000400CC.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.42000000000400CC.title: "爪を据える"
	quest.42000000000400CD.quest_desc: [
		"背の高い何かがこちらを見た。縁歩きは門の番人と呼んだ。",
		"手順: エンダーマンを倒す。エンダーパールは縁歩きの露店からも出る。"
	]
	quest.42000000000400CD.title: "縁の縁"
	quest.42000000000500CE.quest_desc: [
		"唸りの前の短い信号。粉が六十四。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 砂利をふるう。または回収のあと、残響粉砕機でレッドストーン鉱石を。"
	]
	quest.42000000000500CE.title: "レッドストーンの粉"
	quest.42000000000500CF.quest_desc: [
		"並んだ熱。八つは列であり、かまどではない。",
		"手順: 丸石八つを空の中央の周りに。"
	]
	quest.42000000000500CF.title: "かまどの列"
	quest.42000000000500D0.quest_desc: [
		"砂粒を手を使わずに動かす。",
		"手順: 鉄五つをチェストの周りに。織機枠か張力の樽の下に置く（下へ抽出）。"
	]
	quest.42000000000500D0.title: "ホッパー列"
	quest.42000000000500D1.quest_desc: [
		"拍を測る。",
		"手順: ネザークォーツ、レッドストーントーチ、石。クォーツはソウルサンドからふるう。ネザーへ行く必要はない。"
	]
	quest.42000000000500D1.title: "コンパレーター"
	quest.42000000000500D2.quest_desc: [
		"骨、紐、アメジスト。最初の拍。",
		"二つ出る——一つは霊の写本のために残せ。",
		"手順: 骨一つ、紐、アメジスト。/clowder hub 浮島の守り手が骨を売る。火花 / 唸りの門。"
	]
	quest.42000000000500D2.title: "唸り：骨の鈴"
	quest.42000000000500D3.quest_desc: [
		"古い部族の歌の欠片。鈴が要る。",
		"手順: 骨の鈴、アメジストとレッドストーン、不定形。二つ出る。"
	]
	quest.42000000000500D3.title: "唸り：霊の欠片"
	quest.42000000000500D4.quest_desc: [
		"鈴の周りに銅。霊へ調えた金属。",
		"手順: 骨の鈴の周りに銅。二つ出る。"
	]
	quest.42000000000500D4.title: "唸り：銅の共鳴器"
	quest.42000000000500D5.quest_desc: [
		"打て。パルスを保て。何かを配線する前に聴け。",
		"鈴二つ、欠片一つ、革二つ、板材四つ——/clowder hub の浮島の守り手が革を売る。",
		"手順: 骨の鈴二つ、霊の欠片一つ、革二つ、板材四つ。素手でテンポに合わせて打て（17–23 ティック）とパルスが 24。"
	]
	quest.42000000000500D5.title: "唸り：太鼓の心臓"
	quest.42000000000500D6.quest_desc: [
		"道具、呪文、旅のためにパルスを運ぶ——共鳴器＋欠片が要る。",
		"手順: 作ってから太鼓の心臓で満たす（セルでクリック）。道具、呪文、旅はセルから引く。"
	]
	quest.42000000000500D6.title: "唸り：パルスセル"
	quest.42000000000500D7.quest_desc: [
		"開けた空の下で、周囲のレイを拍へ引く。トーテムの声が加わる。太鼓の心臓は要らない。",
		"手順: 空の下、水/緑の近くに置く。遅いパルス。火花の梯子。"
	]
	quest.42000000000500D7.title: "唸り：レイ収集器"
	quest.42000000000500D8.quest_desc: [
		"残響の触媒を据える（働くほど摩耗する）と、違う元素のトーテムを二つ。キャンプは自分の力を歌う。レッドストーンで調和が止まる。",
		"手順: 残響の触媒を据え、違うトーテムを二つ、8以内に。レッドストーンで止まる。"
	]
	quest.42000000000500D8.title: "唸り：パルス共鳴器"
	quest.42000000000500D9.quest_desc: [
		"Forgeエネルギーの緩衝——パルスから針金への橋。望むなら。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500D9.title: "Powah の初期セル"
	quest.42000000000500DA.quest_desc: [
		"燃料を焼いて Forgeエネルギーにする。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500DA.title: "Powah の燃焼器"
	quest.42000000000500DB.quest_desc: [
		"エネルギーを先へ運ぶ。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500DB.title: "Powah のケーブル"
	quest.42000000000500DC.quest_desc: [
		"空の力。空ばかりの浮島で。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500DC.title: "初期ソーラーパネル"
	quest.42000000000500DD.quest_desc: [
		"熱の差を力に焼く。片方は熱く、もう片方は冷たく与えろ。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500DD.title: "熱発電機"
	quest.42000000000500DE.quest_desc: [
		"ロッドの輪の中でアイテムを充電する。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500DE.title: "エナジャイジングオーブ"
	quest.42000000000500DF.quest_desc: [
		"オーブに供給しろ。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500DF.title: "充填ロッド"
	quest.42000000000500E0.quest_desc: [
		"蓄えた力のひとつかみ。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500E0.title: "電池"
	quest.42000000000500E1.quest_desc: [
		"壊して置き直す代わりに、機械をその場で回す。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000500E1.title: "レンチ"
	quest.42000000000500E2.quest_desc: [
		"普通のかまどの二倍の速さで鉱石を精錬する。鉱石だけ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500E2.title: "溶鉱炉"
	quest.42000000000500E3.quest_desc: [
		"焚き火の二倍の速さで肉を焼く。食料だけ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500E3.title: "燻製器"
	quest.42000000000500E4.quest_desc: [
		"石炭九つを密に押し固める。一塊は塊炭の山一つより長く持つ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500E4.title: "石炭ブロック（火花）"
	quest.42000000000500E5.quest_desc: [
		"正面にあるものへ、アイテムを一つずつ押し出す。",
		"手順: レッドストーンの周りに丸石。"
	]
	quest.42000000000500E5.title: "ドロッパー"
	quest.42000000000500E6.quest_desc: [
		"意図を持って押せ。",
		"手順: 丸石、弓、レッドストーン。"
	]
	quest.42000000000500E6.title: "ディスペンサー"
	quest.42000000000500E7.quest_desc: [
		"信号でブロックを前へ押し、次の信号を待つ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500E7.title: "ピストン"
	quest.42000000000500E8.quest_desc: [
		"ブロックを押し出し、信号が切れると引き戻す。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500E8.title: "粘着ピストン"
	quest.42000000000500E9.quest_desc: [
		"オブザーバーが拍を読む。",
		"手順: 丸石、レッドストーン、ネザークォーツ。"
	]
	quest.42000000000500E9.title: "オブザーバー"
	quest.42000000000500EA.quest_desc: [
		"リピーターが回路の時間を決める。",
		"手順: レッドストーントーチ、レッドストーン、石。配管の章では時計に使う。"
	]
	quest.42000000000500EA.title: "リピーター"
	quest.42000000000500EB.quest_desc: [
		"命中を記録し、中心に近いほど信号が強い。",
		"手順: 干し草の周りにレッドストーン。干し草は小麦三つ。"
	]
	quest.42000000000500EB.title: "的"
	quest.42000000000500EC.quest_desc: [
		"雷を屋根からそらし、電荷を地面へ逃がす。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500EC.title: "避雷針"
	quest.42000000000500ED.quest_desc: [
		"電力の時間。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500ED.title: "時計"
	quest.42000000000500EE.quest_desc: [
		"松明なしの明かり。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500EE.title: "銅の電球"
	quest.42000000000500EF.quest_desc: [
		"信号で灯り、それが止んだ瞬間に暗くなる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500EF.title: "レッドストーンランプ"
	quest.42000000000500F0.quest_desc: [
		"空を読み、太陽とともに強弱する信号を送る。",
		"手順: ガラス、ネザークォーツ、木のハーフブロック。"
	]
	quest.42000000000500F0.title: "日照センサー"
	quest.42000000000500F1.quest_desc: [
		"手で信号を入れたり切ったりする。いちばん古いスイッチ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F1.title: "レバー"
	quest.42000000000500F2.quest_desc: [
		"ボタンはレッドストーンの短い信号を出す。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F2.title: "ボタン"
	quest.42000000000500F3.quest_desc: [
		"空気より重いものが乗ると信号を送る。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F3.title: "感圧板"
	quest.42000000000500F4.quest_desc: [
		"道を横切って紐を張ると、渡るものを何でも捕まえる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F4.title: "トリップワイヤーフック"
	quest.42000000000500F5.quest_desc: [
		"下のブロックの種類ごとに一音を鳴らす。太鼓の心臓は、並べたものに歌を聴く。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F5.title: "音符ブロック"
	quest.42000000000500F6.quest_desc: [
		"浮島の士気を上げるジュークボックス。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F6.title: "ジュークボックス"
	quest.42000000000500F7.quest_desc: [
		"重力か一押しで転がる。レールがなければ乗れない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F7.title: "トロッコ"
	quest.42000000000500F8.quest_desc: [
		"虚空の間を渡すレール。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F8.title: "レール"
	quest.42000000000500F9.quest_desc: [
		"トロッコ用のパワードレール。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500F9.title: "パワードレール"
	quest.42000000000500FA.quest_desc: [
		"通るトロッコを読み、上を転がると信号を出す。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000500FA.title: "ディテクターレール"
	quest.42000000000500FB.quest_desc: [
		"代わりの太陽の作り方。",
		"手順: ガラス三つ、ラピスラズリ三つ、鏡三つ。それぞれ一列。"
	]
	quest.42000000000500FB.title: "Solar Flux セル"
	quest.42000000000500FC.quest_desc: [
		"簡単なアイテム用パイプ。",
		"手順: 鉄 + レッドストーン。Pipez のレンチで面を合わせる。"
	]
	quest.42000000000500FC.title: "Pipez アイテム"
	quest.42000000000500FD.quest_desc: [
		"簡単な液体パイプ。",
		"手順: 鉄 + バケツ + レッドストーン。側面にレンチをスニーク使用で抽出、その面を右クリックでフィルター。"
	]
	quest.42000000000500FD.title: "Pipez 液体"
	quest.42000000000500FE.quest_desc: [
		"機械の間をつなぐ素朴なエネルギーパイプ。",
		"手順: 鉄 + レッドストーン。機械の間で FE を運ぶ。"
	]
	quest.42000000000500FE.title: "Pipez エネルギー"
	quest.42000000000500FF.quest_desc: [
		"どのパイプ面が機械から引き出すかを決め、面を切ることも、パイプを壊さずにできる。",
		"手順: 火打石二つと棒二つ。機械のパイプ面をスニーク使用で抽出し、もう一度で切る。抽出中の面を右クリックでフィルター。"
	]
	quest.42000000000500FF.title: "Pipez のレンチ"
	quest.4200000000050100.quest_desc: [
		"格子の線を印す——霊の欠片が要る。",
		"手順: 骨粉二つ、ラピスラズリ、霊の欠片一つ。不定形。四つできる。"
	]
	quest.4200000000050100.title: "儀式のチョーク"
	quest.4200000000050101.quest_desc: [
		"打った太鼓、保ったパルス、据えた共鳴器。",
		"ストランドに張力をかける：太鼓の心臓が応える。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.4200000000050101.quest_subtitle: "唸り"
	quest.4200000000050101.title: "火花の結び"
	quest.4200000000050102.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.4200000000050102.title: "火花を据える"
	quest.4200000000050103.quest_desc: [
		"部族の織りを残響の精製から共鳴の核まで進め。調和励振器は拠点の調和を、この章の機械のための FE に変える。ランクなしの変換は毎秒パルス 60 で、残響ステーションでランクを上げれば増える。FE は受け取れない。レッドストーンは変換と搬出の両方を止める。",
		"手順: 銅インゴット五つ、レッドストーン三つ、共鳴の核一つ。"
	]
	quest.4200000000050103.title: "唸りが電流になる"
	quest.4200000000050104.quest_desc: [
		"夜の浮島に、魔女。太鼓は警告しなかった。",
		"手順: 夜、浮島で魔女を倒す。"
	]
	quest.4200000000050104.title: "瓶入りの厄介"
	quest.4200000000060105.quest_desc: [
		"眠っているあいだ働く手。三十二。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 安山岩 + 鉄の塊を作業台（またはミキサー）で。"
	]
	quest.4200000000060105.title: "安山岩合金"
	quest.4200000000060106.quest_desc: [
		"回転の背骨。",
		"手順: 安山岩合金を、JEI に載る切断レシピ / クラフトで。"
	]
	quest.4200000000060106.title: "シャフト"
	quest.4200000000060107.quest_desc: [
		"歯車ひとつ。それから同じ歯車をもう一度。",
		"手順: 軸 + 板材。"
	]
	quest.4200000000060107.title: "歯車"
	quest.4200000000060108.quest_desc: [
		"歯は多く、回転は遅く。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060108.title: "大きな歯車"
	quest.4200000000060109.quest_desc: [
		"安山岩の筐体は Create の枠だ。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060109.title: "安山岩ケーシング"
	quest.420000000006010A.quest_desc: [
		"空の川が、回る。",
		"手順: 軸の周りに板材八枚。そばに水流が要る。"
	]
	quest.420000000006010A.title: "水車"
	quest.420000000006010B.quest_desc: [
		"まだ何も回っていないとき、手で回転を生む。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006010B.title: "ハンドクランク"
	quest.420000000006010C.quest_desc: [
		"ハンマーなしで砂利を粉にする。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006010C.title: "石臼"
	quest.420000000006010D.quest_desc: [
		"たらいが Create の混合を受ける。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006010D.title: "鉢"
	quest.420000000006010E.quest_desc: [
		"板と道。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006010E.title: "メカニカルプレス"
	quest.420000000006010F.quest_desc: [
		"まとめレシピ、速く。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006010F.title: "メカニカルミキサー"
	quest.4200000000060110.quest_desc: [
		"ベルトやプレスのために、アイテムを止めて置く平らな面。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060110.title: "デポ"
	quest.4200000000060111.quest_desc: [
		"ベルトは軸に沿ってアイテムを運ぶ。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060111.title: "ベルト接続器"
	quest.4200000000060112.quest_desc: [
		"機械のあいだでアイテムを真下に落とす。ベルトは要らない。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060112.title: "シュート"
	quest.4200000000060113.quest_desc: [
		"洗浄、乾燥、そして砂利を砂へ。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060113.title: "ケース入りファン"
	quest.4200000000060114.quest_desc: [
		"軸の上の手。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060114.title: "デプロイヤー"
	quest.4200000000060115.quest_desc: [
		"回転が足りれば、原木を板材に、木を材木に切る。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060115.title: "メカニカルソー"
	quest.4200000000060116.quest_desc: [
		"砂利ブロックを掘り抜け。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060116.title: "メカニカルドリル"
	quest.4200000000060117.quest_desc: [
		"回転する弧で作物を刈れ。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060117.title: "メカニカルハーベスター"
	quest.4200000000060118.quest_desc: [
		"止まった列車の荷物を積み降ろす。チェストを一つも持ち上げなくていい。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060118.title: "ポータブルストレージインターフェース"
	quest.4200000000060119.quest_desc: [
		"チェスト九個分の収納を、一つの大きなブロックに積む。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060119.title: "アイテム保管庫"
	quest.420000000006011A.quest_desc: [
		"液体をまとめて入れ、隣とつながるとさらに入る。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006011A.title: "液体タンク"
	quest.420000000006011B.quest_desc: [
		"流体をたらいに注ぐ。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006011B.title: "アイテム注液口"
	quest.420000000006011C.quest_desc: [
		"源から流体を汲み上げる。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006011C.title: "ホースプーリー"
	quest.420000000006011D.quest_desc: [
		"組み立ての流体側を示す、安山岩の少し派手な従兄弟。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006011D.title: "銅ケーシング"
	quest.420000000006011E.quest_desc: [
		"回転だけでは満たせない精密機械を覆う。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006011E.title: "真鍮ケーシング"
	quest.420000000006011F.quest_desc: [
		"時計仕掛けの心臓。中心に結束の結びを求める。",
		"加えてくれと願う織機。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006011F.title: "精密機構"
	quest.4200000000060120.quest_desc: [
		"回転速度を制御する。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060120.title: "回転速度コントローラー"
	quest.4200000000060121.quest_desc: [
		"角を曲がる。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060121.title: "ギアボックス"
	quest.4200000000060122.quest_desc: [
		"クラッチが軸の列を止める。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060122.title: "クラッチ"
	quest.4200000000060123.quest_desc: [
		"変速機が回転を反転する。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060123.title: "ギアシフト"
	quest.4200000000060124.quest_desc: [
		"プログラムされた回転。模様織りの歌を、書き留めたもの。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060124.title: "シーケンスギアシフト"
	quest.4200000000060125.quest_desc: [
		"十分速く回ると、たらいの材料を混ぜる。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060125.title: "泡立て器"
	quest.4200000000060126.quest_desc: [
		"軸の上で回り、付けた場所によって空気か舟を押す。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060126.title: "プロペラ"
	quest.4200000000060127.quest_desc: [
		"風車で風を受け、模様が欲しければ染めやすい。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060127.title: "白い帆"
	quest.4200000000060128.quest_desc: [
		"帆の輪を、空からまっすぐ引いた回転に変える。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060128.title: "風車ベアリング"
	quest.4200000000060129.quest_desc: [
		"壁ごと、構造全体を定点の周りに回す。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060129.title: "メカニカルベアリング"
	quest.420000000006012A.quest_desc: [
		"門型がレールに沿って滑る。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006012A.title: "ガントリーキャリッジ"
	quest.420000000006012B.quest_desc: [
		"止まっている組み立てを、レールを走るものに変える。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006012B.title: "トロッコアセンブラ"
	quest.420000000006012C.quest_desc: [
		"トロッコ二つを繋ぎ、一つの列車として走らせる。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006012C.title: "トロッコ連結器"
	quest.420000000006012D.quest_desc: [
		"トロッコやからくりが走る道を敷く。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006012D.title: "軌道"
	quest.420000000006012E.quest_desc: [
		"客車のための列車の扉。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006012E.title: "鉄道用ドア"
	quest.420000000006012F.quest_desc: [
		"列車の経路を組む。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.420000000006012F.title: "時刻表"
	quest.4200000000060130.quest_desc: [
		"別の場所の数字を、実際に見えるブロックへ出す。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060130.title: "ディスプレイリンク"
	quest.4200000000060131.quest_desc: [
		"表示板がデータを出す。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060131.title: "ディスプレイボード"
	quest.4200000000060132.quest_desc: [
		"何かを弾き飛ばすほど強くジャガイモを撃つ。ほとんど笑いのためだ。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060132.title: "ポテトキャノン"
	quest.4200000000060133.quest_desc: [
		"腕が届くより遠くのブロックへ届き、壊す。",
		"手順: JEI の Create クラフト（作業台、プレス、ミキサー、配置器）。安山岩合金と水車でラインが始まる。"
	]
	quest.4200000000060133.title: "マジックハンド"
	quest.4200000000060134.quest_desc: [
		"輪、圧機、混合機、送風機、時計仕掛けの心臓。",
		"ストランドに張力をかける：模様織りの答え。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.4200000000060134.quest_subtitle: "模様"
	quest.4200000000060134.title: "時計の結び"
	quest.4200000000060135.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"まれな報酬：Clowder の共有ライフ一つ、チーム全体で一度きり。こうした報酬はキャンペーンに六つしかない。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.4200000000060135.title: "時計を据える"
	quest.4200000000060136.quest_desc: [
		"スケルトン二十体。明かりをつけておけば、模様は保たれる。",
		"手順: スケルトンを二十体倒す。浮島を明るく保つ。"
	]
	quest.4200000000060136.title: "歯車のカラカラ"
	quest.4200000000070137.quest_desc: [
		"オークの巣を浮島に置き、小さな花で右クリックする。待つ。翼のある何かが木から出てくる。",
		"それを見る。それで達成。",
		"手順: 小さな花でオークの巣を右クリックし、出てくる最初のハチを見る。"
	]
	quest.4200000000070137.quest_subtitle: "群居"
	quest.4200000000070137.title: "初めての翼"
	quest.4200000000070138.quest_desc: [
		"小さな花の周りにオークの原木を八つ。置いて別の花で目覚めさせる；木は翼を覚えている。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.4200000000070138.title: "オークの輪"
	quest.4200000000070139.quest_desc: [
		"草に骨粉。何も咲かない場所にハチは留まらない。",
		"手順: 草に骨粉。ハチは小さな花なら何でも欲しがる。"
	]
	quest.4200000000070139.title: "奪い合う花"
	quest.420000000007013A.quest_desc: [
		"板材と花 — 野生のハチが引っ越してくる家。",
		"手順: 板材二列の間に小さな花を三つ。群れが巣に名を付ける。"
	]
	quest.420000000007013A.title: "ハチの巣"
	quest.420000000007013B.quest_desc: [
		"風の中のコロニー。流れ着かなければ、 /clowder hub の群れの守り手の屋台がハニカムを売る。",
		"手順: ハチが花を済ませたあと、巣か巣箱をハサミで刈る。 /clowder hub の群れの守り手の屋台が八つを糸16で売る。"
	]
	quest.420000000007013B.title: "ハニカム"
	quest.420000000007013C.quest_desc: [
		"働きバチの家。",
		"手順: ハニカム三つと板材六つ。下の焚き火がハチを落ち着かせる。"
	]
	quest.420000000007013C.title: "巣箱"
	quest.420000000007013D.quest_desc: [
		"甘くてねばねばして、胃よりかまどのほうが値打ちがある。",
		"手順: 満杯のハチの巣にガラス瓶。下に焚き火。"
	]
	quest.420000000007013D.title: "ハチミツ入りの瓶（群れ）"
	quest.420000000007013E.quest_desc: [
		"巣箱に手を入れる前に、興奮したハチを落ち着かせるおやつ。",
		"手順: ハニカムとハチミツ入りの瓶、不定形。"
	]
	quest.420000000007013E.title: "ミツバチのおやつ"
	quest.420000000007013F.quest_desc: [
		"花の周りに砂利。採掘バチと掘りバチは粉が好き。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.420000000007013F.title: "砂利の輪"
	quest.4200000000070140.quest_desc: [
		"花の周りに粗い土。ハキリバチと灰色の採掘バチ。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.4200000000070140.title: "粗い土の輪"
	quest.4200000000070141.quest_desc: [
		"花の周りに石。石工バチと、岩を食べる掘りバチ。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.4200000000070141.title: "石の輪"
	quest.4200000000070142.quest_desc: [
		"よく働く家。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.4200000000070142.title: "上級の巣箱"
	quest.4200000000070143.quest_desc: [
		"新しい巣を探して分蜂する前に、巣箱に余裕を持たせる。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.4200000000070143.title: "拡張箱"
	quest.4200000000070144.quest_desc: [
		"手を触れずに収穫を瓶に詰める。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.4200000000070144.title: "瓶詰機"
	quest.4200000000070145.quest_desc: [
		"ハニカムを回して、隠しているもの全部にする。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.4200000000070145.title: "遠心分離機"
	quest.4200000000070146.quest_desc: [
		"同じもの、より速く、エネルギーで。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.4200000000070146.title: "電動式遠心分離機"
	quest.4200000000070147.quest_desc: [
		"一度も刺されずに、空中のハチを網で捕る。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.4200000000070147.title: "捕獲機"
	quest.4200000000070148.quest_desc: [
		"ハチをランタンのように運ぶ。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.4200000000070148.title: "ハチかご"
	quest.4200000000070149.quest_desc: [
		"欲しい遺伝子を孵す。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.4200000000070149.title: "孵卵器"
	quest.420000000007014A.quest_desc: [
		"二つのコロニーをわざと組む。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.420000000007014A.title: "繁殖室"
	quest.420000000007014B.quest_desc: [
		"種のように特性を分ける。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.420000000007014B.title: "遺伝子インデクサー"
	quest.420000000007014C.quest_desc: [
		"菓子の束：コロニーの給料。",
		"手順: ハニカムとハチミツ入りの瓶、不定形。"
	]
	quest.420000000007014C.title: "給餌の強化"
	quest.420000000007014D.quest_desc: [
		"基本をはるかに超えて育てた、より深いエッセンス作物の一つ。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000007014D.title: "ダイヤモンドの種"
	quest.420000000007014E.quest_desc: [
		"掘りに行かずに粉が採れる畑。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000007014E.title: "レッドストーンの種"
	quest.420000000007014F.quest_desc: [
		"エンチャントテーブルがいつも欲しがる青いエッセンスを育てる。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000007014F.title: "ラピスラズリの種"
	quest.4200000000070150.quest_desc: [
		"ネザーの洞窟から掘る代わりに、作物として育てるクォーツ。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000070150.title: "ネザークォーツの種"
	quest.4200000000070151.quest_desc: [
		"ネザーの天井を掘るより、やさしく光を育てる方法。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000070151.title: "グロウストーンの種"
	quest.4200000000070152.quest_desc: [
		"溶岩入りバケツは見当たらず、黒曜石のエッセンスを出す硬い作物。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000070152.title: "黒曜石の種"
	quest.4200000000070153.quest_desc: [
		"高いエッセンス。畑はもう産業だ。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000070153.title: "Imperium"
	quest.4200000000070154.quest_desc: [
		"最後のエッセンス段階。何を作るにせよ、これが良い版だ。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"群れの余り、積み上げ。",
		"手順: ハチミツ入りの瓶四つ。瓶は戻る。"
	]
	quest.4200000000070155.title: "ハチミツブロック"
	quest.4200000000070156.quest_desc: [
		"自分が巣を作るまではいなかったハチ。",
		"採掘、石工、掘り、大工 — 一匹を見る。",
		"手順: 巣が目覚めたあと Productive Bee を見る。初めての翼はオークの巣。"
	]
	quest.4200000000070156.quest_subtitle: "群居"
	quest.4200000000070156.title: "新しいものが唸る"
	quest.4200000000070157.quest_desc: [
		"花の周りに砂。灰色とチョコの採掘バチ。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.4200000000070157.title: "砂の輪"
	quest.4200000000070158.quest_desc: [
		"花の周りにサトウキビ。葦バチと石工バチ。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.4200000000070158.title: "葦の輪"
	quest.4200000000070159.quest_desc: [
		"花の周りにスライムブロック。当ててみて。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.4200000000070159.title: "スライムの輪"
	quest.420000000007015A.quest_desc: [
		"花の周りに干草。マルハナバチと、普通のハチも。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.420000000007015A.title: "干草の輪"
	quest.420000000007015B.quest_desc: [
		"花の周りに雪。奇妙なことに、汗バチ。",
		"手順: 小さな花の周りに巣の素材を輪にする。置いてから小さな花で右クリックして目覚めさせる；しばらくするとハチが出てくる。"
	]
	quest.420000000007015B.title: "雪の輪"
	quest.420000000007015C.quest_desc: [
		"ハチミツを燃やして動力に。巣箱が二役をこなす。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.420000000007015C.title: "ハチミツ発電機"
	quest.420000000007015D.quest_desc: [
		"巣箱なしで、羽ごとハチ一匹を飾る。",
		"手順: Productive Bees のクラフトは JEI にある。群れが巣箱、遠心分離機、繁殖の手順に名を付ける。"
	]
	quest.420000000007015D.title: "瓶"
	quest.420000000007015E.quest_desc: [
		"ハニカムを掘りに行く前に、ハチでいっぱいの巣箱を落ち着かせる。",
		"手順: 原木、棒、石炭か木炭。"
	]
	quest.420000000007015E.title: "焚き火（群れ）"
	quest.420000000007015F.quest_desc: [
		"ハチを養い、年に二度咲く。残りの季節は常緑。",
		"手順: 苔とオーク、または苔に骨粉。ミツバチは花を受け入れる。"
	]
	quest.420000000007015F.title: "開花したツツジ（群れ）"
	quest.4200000000070160.quest_desc: [
		"高く、黄色く、いつも太陽を向く。ハチが見つけやすい。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000070160.title: "ヒマワリ"
	quest.4200000000070161.quest_desc: [
		"紫の花が二ブロック。ハチは浮島を渡ってでも届きに来る。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000070161.title: "ライラック"
	quest.4200000000070162.quest_desc: [
		"ハチが好む高い花。庭にもう一色。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000070162.title: "バラの低木"
	quest.4200000000070163.quest_desc: [
		"ピンクでふっくら。巣箱の近くに餌場がもっと要るところへ植える。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000070163.title: "ボタン"
	quest.4200000000070164.quest_desc: [
		"低くて一輪だが、ハチは高さなど気にしない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000070164.title: "橙色のチューリップ"
	quest.4200000000070165.quest_desc: [
		"自分で作った巣、動かした巣箱、遠心分離機、孵卵器、エッセンスの畑。",
		"ストランドに張力を：群れの守り手が応える。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.4200000000070165.quest_subtitle: "群居"
	quest.4200000000070165.title: "群れの結び"
	quest.4200000000070166.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.4200000000070166.title: "群れを据える"
	quest.4200000000070167.quest_desc: [
		"ハチを殺した。",
		"群れの守り手が話がある。瓶を一つ。考えてみて。",
		"手順: ハチを倒す（隠し）。瓶が教訓。"
	]
	quest.4200000000070167.title: "後悔"
	quest.4200000000080168.quest_desc: [
		"執事が結晶に仕掛けを残した。欠片は三十二。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: ふるい、またはジオードの列を育てるなら芽生えたアメジスト。Occultism は欠片を欲しがる。"
	]
	quest.4200000000080168.title: "アメジスト"
	quest.4200000000080169.quest_desc: [
		"ストランド繊維を16本持って張力の柱を右クリック。どのストランドも据える必要はない。",
		"結びはここから始まる。",
		"手順: ストランド繊維を16本持って張力の柱を右クリック。砂利か砂を鉄の糸の網でふるい、それを見つける。"
	]
	quest.4200000000080169.title: "編み紐"
	quest.420000000008016A.quest_desc: [
		"彫る前に儀式を書け。",
		"手順: 本、イカスミ、羽根。木炭とガラス瓶でインクになる。"
	]
	quest.420000000008016A.title: "本と羽根ペン"
	quest.420000000008016B.quest_desc: [
		"硬い道具のための柔らかい力。",
		"手順: ダイヤモンド二つ、黒曜石四つ、本。ダイヤモンドは鉄の網の砂利から。"
	]
	quest.420000000008016B.title: "エンチャントテーブル（印）"
	quest.420000000008016C.quest_desc: [
		"テーブルに燃料を。",
		"手順: ラピスラズリ九つ。砂利をふるうか、残響粉砕機でラピスラズリ鉱石を。"
	]
	quest.420000000008016C.title: "ラピスラズリブロック"
	quest.420000000008016D.quest_desc: [
		"エンチャントテーブルを囲み、最強のエンチャントを解放する。",
		"手順: 板材六つと本三つ。本は紙と革。"
	]
	quest.420000000008016D.title: "本棚"
	quest.420000000008016E.quest_desc: [
		"深く癒し、一分で消える輝きを与える。",
		"手順: 金を八つ、リンゴの周りに。エンチャント版ではない。"
	]
	quest.420000000008016E.title: "金のリンゴ"
	quest.420000000008016F.quest_desc: [
		"落下を飛ばす。",
		"手順: エンダーマン、または /clowder hub の縁歩きの露店。"
	]
	quest.420000000008016F.title: "エンダーパール"
	quest.4200000000080170.quest_desc: [
		"水入り瓶を、実際に効果のあるものに変える。",
		"手順: ブレイズロッドを丸石三つの上に。ロッドは爪の黒曜石のあと、ネザー要塞から。"
	]
	quest.4200000000080170.title: "醸造台"
	quest.4200000000080171.quest_desc: [
		"ポーションのための熱。",
		"手順: ブレイズロッドから作る。または爪の黒曜石のあと、要塞で。"
	]
	quest.4200000000080171.title: "ブレイズパウダー"
	quest.4200000000080172.quest_desc: [
		"醸造台の燃料になり、ネザーにすでに挑んだ証になる。",
		"手順: 爪の黒曜石のあと、ネザー要塞。醸造はロッドを求める；Ars と Occultism は待たない。"
	]
	quest.4200000000080172.title: "ブレイズロッド"
	quest.4200000000080173.quest_desc: [
		"ポーションの効果を、わざと、もっと悪いものへねじる。",
		"手順: クモの目、茶色のキノコ、砂糖。"
	]
	quest.4200000000080173.title: "発酵した目"
	quest.4200000000080174.quest_desc: [
		"レシピ用のグロウストーンダスト。",
		"手順: ソウルサンドをふるうか、浮島のウィッチ。"
	]
	quest.4200000000080174.title: "グロウストーンダスト（印）"
	quest.4200000000080175.quest_desc: [
		"エンドを守るものの息。",
		"手順: ガラス瓶をドラゴンに。エンドの島はもうない。任意。"
	]
	quest.4200000000080175.title: "ドラゴンブレス"
	quest.4200000000080176.quest_desc: [
		"もう一度のチャンス。",
		"任意——襲撃は浮島へ届かず、パックも一つは作らない。",
		"手順: クエスト報酬だけ。「時計を据える」と「印を据える」が一つずつくれ、後のストランドの結びの贈り物はさらに出す。襲撃とエヴォーカーは浮島に来ない。任意。"
	]
	quest.4200000000080176.title: "トーテム"
	quest.4200000000080177.quest_desc: [
		"呪文が燃やす燃料、源素を蓄える。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.4200000000080177.title: "ソースジェム"
	quest.4200000000080178.quest_desc: [
		"拾うものではなく、育てるもの。詠唱の道具と呪文の台座に使う木。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.4200000000080178.title: "秘術の木"
	quest.4200000000080179.quest_desc: [
		"最初の呪文。儀式のそばに置くなら、並ぶ魔法。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.4200000000080179.title: "初心者のスペルブック"
	quest.420000000008017A.quest_desc: [
		"秘術の作物。魔法と同じくらい、その布のために育てる。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008017A.title: "メイジブルーム"
	quest.420000000008017B.quest_desc: [
		"儀式の作業のための火鉢。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008017B.title: "儀式用火鉢"
	quest.420000000008017C.quest_desc: [
		"試薬を掲げ、必要とする儀式へ送り込む。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008017C.title: "儀式の台座"
	quest.420000000008017D.quest_desc: [
		"呪文とページを写す。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008017D.title: "書記台"
	quest.420000000008017E.quest_desc: [
		"試薬に源素を込める。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008017E.title: "注入チェンバー"
	quest.420000000008017F.quest_desc: [
		"源素を余分に蓄え、詠唱の途中で呪文が枯れないようにする。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008017F.title: "ソース瓶"
	quest.4200000000080180.quest_desc: [
		"霊をその名で呼ぶ。",
		"手順: 本と悪魔の夢の種、不定形。読め；次は霊火。"
	]
	quest.4200000000080180.title: "Occultism 辞典"
	quest.4200000000080181.quest_desc: [
		"普通の火では終わらない儀式に使う冷たい炎。",
		"手順: 霊の辞典の示す通り霊火を灯し（燃える！）、安山岩を落とす。"
	]
	quest.4200000000080181.title: "霊火"
	quest.4200000000080182.quest_desc: [
		"召喚の焦点。儀式は辛抱強い。",
		"手順: 生贄の鉢の周りに金。辞典が儀式の名を示す。"
	]
	quest.4200000000080182.title: "金の生贄の鉢"
	quest.4200000000080183.quest_desc: [
		"オーラを基にしたクラフトの心臓。周囲の土地に調律されている。",
		"手順: 森の儀式（JEI）：石三つ、金の葉、金インゴット、喜びの証。オーラの心臓の系。"
	]
	quest.4200000000080183.title: "Natural Altar"
	quest.4200000000080184.quest_desc: [
		"高いオーラに浸された植物。より珍しいものへ紡がれる。",
		"手順: 短い草の周りに葉四つと金塊四つで、輝く繊維が四つできる。木の梢に置くと、葉は時とともに金色になる。"
	]
	quest.4200000000080184.title: "Brilliant Fiber"
	quest.4200000000080185.quest_desc: [
		"オーラに触れた材料。地面に落ちて見えるより価値がある。",
		"手順: 輝く繊維から育った金の葉を壊す。"
	]
	quest.4200000000080185.title: "Gold Leaf"
	quest.4200000000080186.quest_desc: [
		"周囲のオーラを吸って、鉱石より価値が出た鉄。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000080186.title: "注入された鉄"
	quest.4200000000080187.quest_desc: [
		"周囲の土地のオーラ量が見える。",
		"手順: 金の葉＋クモの目。その場のオーラを示す。"
	]
	quest.4200000000080187.title: "眼"
	quest.4200000000080188.quest_desc: [
		"喜びの証。自然の祭壇と草食吸収器はこれを土台に組む。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000080188.title: "Token of Joy"
	quest.4200000000080189.quest_desc: [
		"呪文の羊皮紙の蓄え。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.4200000000080189.title: "スペルの羊皮紙"
	quest.420000000008018A.quest_desc: [
		"歩くのではなく、一言で戻る場所を印す。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008018A.title: "転移の巻物"
	quest.420000000008018B.quest_desc: [
		"植えて、手入れして、低い魔法を含んだ布を収穫する。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008018B.title: "魔導花の作物"
	quest.420000000008018C.quest_desc: [
		"呪文が書き込まれる白紙。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.420000000008018C.title: "空のグリフ"
	quest.420000000008018D.quest_desc: [
		"杖に一度も触れず、戦闘の呪文を放つ。",
		"手順: 鎖三つ、革四つ、紙二つ。呪文の章がインクの名を示す。"
	]
	quest.420000000008018D.title: "Iron の呪文書"
	quest.420000000008018E.quest_desc: [
		"詠唱者が呪文のたびに燃やす燃料。",
		"手順: 詠唱者を倒すか、JEI に載ったものを作る。インクと本の燃料。"
	]
	quest.420000000008018E.title: "秘術のエッセンス"
	quest.420000000008018F.quest_desc: [
		"本に呪文を刻む。一度に一段階。",
		"手順: 瓶＋エッセンス＋染料。最初の記銘インク。"
	]
	quest.420000000008018F.title: "ありふれたインク"
	quest.4200000000080190.quest_desc: [
		"儀式のための色。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000080190.title: "神秘の花"
	quest.4200000000080191.quest_desc: [
		"深闇の残響。",
		"任意。虚空は一度も出さないかもしれない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000080191.title: "残響片"
	quest.4200000000080192.quest_desc: [
		"編みは紡がれ、薬は瓶に収められ、呪文と霊が呼ばれた。",
		"ストランドに張力をかけて。印彫りが応える。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.4200000000080192.quest_subtitle: "結び"
	quest.4200000000080192.title: "印の結び"
	quest.4200000000080193.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"まれな報酬：Clowder の共有ライフ一つ、チーム全体で一度きり。こうした報酬はキャンペーンに六つしかない。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.4200000000080193.title: "印を据える"
	quest.4200000000080194.quest_desc: [
		"執事が決して食べなかったリンゴ。たぶん食べないほうがいい。",
		"手順: 浮島のクラフトではない。任意の秘密。印の結びの条件にはならない。"
	]
	quest.4200000000080194.title: "古い金"
	quest.4200000000090195.quest_desc: [
		"鉄の網、砂利か砂、そして忍耐。",
		"ストランド繊維は織機自身の糸。編みはそれから紡がれる。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 砂利、砂、または粉の上に糸の網（鉄）（織機枠かふるい）。"
	]
	quest.4200000000090195.title: "繊維を紡ぐ"
	quest.4200000000090196.quest_desc: [
		"繊維十六本、張力の柱を一度右クリック。",
		"結束が始まった。織り直すのはここから。",
		"手順: ストランド繊維を16本持って張力の柱を右クリック。砂利か砂を鉄の糸の網でふるい、それを見つける。"
	]
	quest.4200000000090196.title: "編みを継ぐ"
	quest.4200000000090197.quest_desc: [
		"Certus 水晶 — デジタルな織機の冷たい糸。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.4200000000090197.title: "冷たい横糸"
	quest.4200000000090198.quest_desc: [
		"砕いた水晶。デジタルな織機を組む基の材料。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.4200000000090198.title: "Certus の粉"
	quest.4200000000090199.quest_desc: [
		"ネットワーク機械すべての外殻ブロック。Certus の鉱床から掘る。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.4200000000090199.title: "スカイストーン"
	quest.420000000009019A.quest_desc: [
		"Fluix — 水中で帯電させた certus、クォーツ、レッドストーン。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.420000000009019A.title: "帯電した経糸"
	quest.420000000009019B.quest_desc: [
		"クォーツ、レッドストーン、ガラスを細かく砕いた、ネットワーク製作向けの粉。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.420000000009019B.title: "フルーシュダスト"
	quest.420000000009019C.quest_desc: [
		"AE2 のプロセッサー用シリコン。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.420000000009019C.title: "シリコン"
	quest.420000000009019D.quest_desc: [
		"刻印機は、織機が布を押すように回路を押す。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.420000000009019D.title: "模様を押す"
	quest.420000000009019E.quest_desc: [
		"織機が布を押すように、シリコン板を刻印する。",
		"手順: 鉄ブロック、結束の結び、鉄、クォーツ。AE2 は、もう持っているプレスしか複製しない。"
	]
	quest.420000000009019E.title: "シリコン基盤の金型"
	quest.420000000009019F.quest_desc: [
		"論理プロセッサーの型を、一押しずつ刻印する。",
		"手順: 鉄ブロック、結束の結び、鉄、金。最初の一つは結びの製作。"
	]
	quest.420000000009019F.title: "論理プレス"
	quest.42000000000901A0.quest_desc: [
		"計算プロセッサーの型を刻印する。",
		"手順: 鉄ブロック、結束の結び、鉄、certus（ふるい、砂）。最初の一つは結びの製作。"
	]
	quest.42000000000901A0.title: "計算プレス"
	quest.42000000000901A1.quest_desc: [
		"工学の型の製作。",
		"手順: 鉄ブロック、結束の結び、鉄、ダイヤモンド。最初の一つは結びの製作。"
	]
	quest.42000000000901A1.title: "工学プレス"
	quest.42000000000901A2.quest_desc: [
		"AE2 用の論理プロセッサー。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901A2.title: "論理プロセッサ"
	quest.42000000000901A3.quest_desc: [
		"自動製作パターンの部品。シリコンと certus クォーツから作る。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901A3.title: "演算プロセッサ"
	quest.42000000000901A4.quest_desc: [
		"より密なプロセッサー。ネットワークの手強い部分に要る。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901A4.title: "情報処理プロセッサ"
	quest.42000000000901A5.quest_desc: [
		"ネットワークが覚えている全てを収めるセルを収める。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901A5.title: "ME ドライブ"
	quest.42000000000901A6.quest_desc: [
		"ストレージセルを組み込む殻。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901A6.title: "アイテムセルの筐体"
	quest.42000000000901A7.quest_desc: [
		"最初のデジタルチェスト。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901A7.title: "1k アイテムセル"
	quest.42000000000901A8.quest_desc: [
		"ネットワークを見る。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901A8.title: "ME ターミナル"
	quest.42000000000901A9.quest_desc: [
		"ネットワークが既に持っているものから、直接作れる。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901A9.title: "製作ターミナル"
	quest.42000000000901AA.quest_desc: [
		"コントローラー。中心に結束の結びを求める。",
		"紡錘の核。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901AA.title: "デジタル織機"
	quest.42000000000901AB.quest_desc: [
		"素手で使って門の儀式を奏でよ：落ちてくる拍を A、S、D、F で打て。60%当たれば開き、脈は要らない。",
		"手順: 門の太鼓を素手で使い、門の儀式を奏でる。落ちてくる拍を A、S、D、F で打て。60%当たれば開き、脈は要らない。先に帰還のコンパスを結べ。"
	]
	quest.42000000000901AB.title: "門の太鼓"
	quest.42000000000901AC.quest_desc: [
		"門の向こうからの足場。一つ持ち帰れ。",
		"手順: 辺境の丸石を製錬する。門の太鼓を通って辺境で掘る。"
	]
	quest.42000000000901AC.title: "マーチの石"
	quest.42000000000901AD.quest_desc: [
		"ネットワークのチャンネルを、機械から次の機械へ運ぶ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901AD.title: "Fluix ケーブル"
	quest.42000000000901AE.quest_desc: [
		"アイテムを貯蔵へ引き込む。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901AE.title: "輸入バス"
	quest.42000000000901AF.quest_desc: [
		"アイテムをネットワークからチェストか機械へ押し出す。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901AF.title: "輸出バス"
	quest.42000000000901B0.quest_desc: [
		"外のインベントリを、セルであるかのようにネットワークへ読み込む。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B0.title: "貯蔵バス"
	quest.42000000000901B1.quest_desc: [
		"ネットワークの自動製作に、まとめ作りの容量を足す。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B1.title: "クラフトユニット"
	quest.42000000000901B2.quest_desc: [
		"同時に走る製作作業を増やす。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B2.title: "並列クラフトユニット"
	quest.42000000000901B3.quest_desc: [
		"製作のあいだ、ネットワークが引くパターンを抱える。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B3.title: "1k クラフトストレージ"
	quest.42000000000901B4.quest_desc: [
		"織機が糸を杼へ送るように、機械へパターンを送る。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B4.title: "パターン供給器"
	quest.42000000000901B5.quest_desc: [
		"パターンから組み立てる。中心に編み紐を欲しがる。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B5.title: "分子組立機"
	quest.42000000000901B6.quest_desc: [
		"空のパターン。レシピを書き込まれるのを待っている。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B6.title: "空のパターン"
	quest.42000000000901B7.quest_desc: [
		"デジタル織機へエネルギーを送れ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B7.title: "エネルギーアクセプター"
	quest.42000000000901B8.quest_desc: [
		"AE のために燃やせ — 任意のエネルギーの枝。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B8.title: "火力発電機"
	quest.42000000000901B9.quest_desc: [
		"前のサイズより広い収納セル。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901B9.title: "4kアイテムセル"
	quest.42000000000901BA.quest_desc: [
		"どのチェストよりはるかに多く入る。ドライブが埋まる前の、いちばん密なセル。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901BA.title: "16kアイテムセル"
	quest.42000000000901BB.quest_desc: [
		"流体の収納セルを組み込む殻。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901BB.title: "流体セルの筐体"
	quest.42000000000901BC.quest_desc: [
		"デジタルのタンク。液体を蓄え、ネットワークはどこからでも引き出せる。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901BC.title: "1k流体セル"
	quest.42000000000901BD.quest_desc: [
		"手があるときと同じように、手なしで、ネットワークからブロックを置く。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901BD.title: "形成プレーン"
	quest.42000000000901BE.quest_desc: [
		"前のブロックを壊し、ネットワークへ送り込む。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901BE.title: "消滅プレーン"
	quest.42000000000901BF.quest_desc: [
		"ネットからのレッドストーン。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901BF.title: "レベルエミッター"
	quest.42000000000901C0.quest_desc: [
		"ネットワークを世界へつなぎ、縁を越えてアイテムをやり取りする。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901C0.title: "インターフェース"
	quest.42000000000901C1.quest_desc: [
		"普通のケーブルが届かない距離で、二つのネットワークをつなぐ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901C1.title: "量子リング"
	quest.42000000000901C2.quest_desc: [
		"量子リングの対になる半分。二つのネットワークを結ぶ。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901C2.title: "量子リンク"
	quest.42000000000901C3.quest_desc: [
		"範囲内ならどこからでもネットワークに届く。足元にケーブルはいらない。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901C3.title: "無線ターミナル"
	quest.42000000000901C4.quest_desc: [
		"ある機械の設定を、打ち直さずに別の機械へ写す。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901C4.title: "メモリーカード"
	quest.42000000000901C5.quest_desc: [
		"AE2 向けのネットワークツール。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901C5.title: "ネットワークツール"
	quest.42000000000901C6.quest_desc: [
		"certus クォーツを、より細かい作業に使えるまでチャージする。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901C6.title: "チャージャー"
	quest.42000000000901C7.quest_desc: [
		"育つ水晶の蕾を、フルサイズの塊まで速める。",
		"手順: 紡錘の網 — 砂から Certus、コントローラーは結束の結びを求める。"
	]
	quest.42000000000901C7.title: "結晶成長加速器"
	quest.42000000000901C8.quest_desc: [
		"辺境の樹冠の証 — 織り直す任意の土産。",
		"手順: 辺境で野生に育ち、葦の堰のチェストにあり、根結びの長老が取引する。"
	]
	quest.42000000000901C8.title: "霊の葦"
	quest.42000000000901C9.quest_desc: [
		"編み、デジタル織機、門、辺境の石。",
		"九番目のストランドに張力をかけろ。それから断片、それから柱。",
		"受け取って、部族の贈り物を一つ選べ。共有の命がもう一つ増える帰還の糸か、物資か。",
		"手順: これに繋がるクエストを終えてから、ストランドの札を受け取る。札を張力の柱に据える。"
	]
	quest.42000000000901C9.quest_subtitle: "織り直す"
	quest.42000000000901C9.title: "紡錘の結び"
	quest.42000000000901CA.quest_desc: [
		"札を持って、自分の Clowder の張力の柱を右クリックする。",
		"刻みが灯り、部族が鳴り、浮島が変わる。",
		"手順: ストランドの札を手に、張力の柱を右クリックする。"
	]
	quest.42000000000901CA.title: "紡錘を据える"
	quest.42000000000901CB.quest_desc: [
		"九つ据えて、辺境の石一つ、柱を右クリック一つ：断片。",
		"それを据えろ。断ちが浮島の上で閉じる。",
		"手順: 証を九つ据えてから、辺境の石を持って柱を右クリック。"
	]
	quest.42000000000901CB.quest_subtitle: "織り直す"
	quest.42000000000901CB.title: "織機の欠片"
	quest.42000000000901CC.quest_desc: [
		"張力の柱に断片を据える。",
		"九つの部族、一本の糸。辺境が残したものを見に行け。",
		"まれな報酬：Clowder の共有ライフ一つ、チーム全体で一度きり。こうした報酬はキャンペーンに六つしかない。",
		"手順: 紡錘の織機の欠片を張力の柱に据える。空が閉じると進捗が発動する。"
	]
	quest.42000000000901CC.quest_subtitle: "断ち、閉じた"
	quest.42000000000901CC.title: "織り直す"
	quest.42000000000901CD.quest_desc: [
		"ウィザーが、浮島の上、空に。織機の縫い手は感嘆し、それから激怒しただろう。",
		"手順: ウィザー（ソウルサンドに頭蓋骨三つ）、または /clowder hub の太鼓の心臓の屋台で一度、糸の反 12（糸 972）。任意のトロフィー。エンドもモブ農場の 100% も塞がない。"
	]
	quest.42000000000901CD.title: "星、なんとか"
	quest.42000000000A01CE.quest_desc: [
		"葉が苗木をより多く落とす。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01CE.title: "鉤杖の基本"
	quest.42000000000A01CF.quest_desc: [
		"木の鉤杖より速くふるい、ずっと長く持つ。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01CF.title: "骨のクロック"
	quest.42000000000A01D0.quest_desc: [
		"いちばん素朴な網。ふるうものは、まずここを通る。",
		"手順: 紐を九本、3x3に。砂利歌いの屋台が虚空の織機の糸の網（紐）を売る。ふるい方は同じ。"
	]
	quest.42000000000A01D0.title: "糸のメッシュ"
	quest.42000000000A01D1.quest_desc: [
		"紐より細かいかけらを捕らえる。織り目からすり抜ける端切れは少ない。",
		"手順: 火打石四つと紐五つを市松に。火打石は砂利から、または糸 + 砂利。"
	]
	quest.42000000000A01D1.title: "火打石の網（ふるい）"
	quest.42000000000A01D2.quest_desc: [
		"鉄の糸は、より重い砂粒を捕らえ、山からより珍しい端切れを引き出す。",
		"手順: 鉄インゴット四つと紐五つを市松に。どの屋台も売っていない。"
	]
	quest.42000000000A01D2.title: "鉄の網（ふるい）"
	quest.42000000000A01D3.quest_desc: [
		"金級の網。確率は大事な鉱石のほうへ寄る。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01D3.title: "金のメッシュ"
	quest.42000000000A01D4.quest_desc: [
		"これで砂利をふるうと、ダイヤモンドがずっとよく出る。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01D4.title: "ダイヤモンドのメッシュ"
	quest.42000000000A01D5.quest_desc: [
		"作られた中でいちばん細かい網。ネザライトの糸よりうまくふるうものはない。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01D5.title: "ネザライトのメッシュ"
	quest.42000000000A01D6.quest_desc: [
		"滑らかに精製した粘土。本物の熱を保つるつぼへ焼ける。",
		"手順: 粘土玉 + 骨粉、不定形。粘土は張力の樽から。"
	]
	quest.42000000000A01D6.title: "磁器粘土（ふるい）"
	quest.42000000000A01D7.quest_desc: [
		"るつぼの形にした磁器粘土。かまどで焼く。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01D7.title: "未焼成のるつぼ"
	quest.42000000000A01D8.quest_desc: [
		"溶けた熱を抱えても割れない。ふるいが出したものを製錬する。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01D8.title: "陶器のるつぼ"
	quest.42000000000A01D9.quest_desc: [
		"畝を踏まずに、作物へ水を振りかける。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01D9.title: "木のじょうろ"
	quest.42000000000A01DA.quest_desc: [
		"水しぶきは広く、タンクは深い。一往復で浮島のより広い範囲に水をやる。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01DA.title: "鉄のじょうろ"
	quest.42000000000A01DB.quest_desc: [
		"葉に放つと、食べながら絹を紡ぐ。",
		"手順: 鉤杖で葉を壊す。蚕がときどき落ちる。"
	]
	quest.42000000000A01DB.title: "カイコ"
	quest.42000000000A01DC.quest_desc: [
		"苗木と種を、もっと奇妙な作物へそっと寄せる不思議な水。",
		"手順: 菌糸の上に置いた水入りの樽は魔女の水になる。そこからバケツを満たす。菌糸の胞子は土をふるうと出る。"
	]
	quest.42000000000A01DC.title: "ウィッチウォーター入りバケツ"
	quest.42000000000A01DD.quest_desc: [
		"ばらまくと、菌糸が外へ這う。気長に、一塊ずつ。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01DD.title: "菌糸の胞子"
	quest.42000000000A01DE.quest_desc: [
		"土に投げると、雨を待たずに草が広がる。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01DE.title: "草の種"
	quest.42000000000A01DF.quest_desc: [
		"丸石の代わりになる砂粒。ハンマーに戻すと、もっと出る。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01DF.title: "石の小石"
	quest.42000000000A01E0.quest_desc: [
		"丸石九つをぎゅっと詰めた貯蔵用の石。育っていく浮島のため。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01E0.title: "圧縮丸石"
	quest.42000000000A01E1.quest_desc: [
		"これまでのどのハンマーより速く、丸石を砂利に砕く。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01E1.title: "ネザライトのハンマー"
	quest.42000000000A01E2.quest_desc: [
		"ネザーの石を細かく砕いたもの。玄武岩もブラックストーンも、ここから始まる。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01E2.title: "ブラックストーンの小石"
	quest.42000000000A01E3.quest_desc: [
		"深層岩を砂粒まで砕いたもの。またふるいにかける準備ができている。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01E3.title: "深層岩の小石"
	quest.42000000000A01E4.quest_desc: [
		"深いふるいから引き上げた淡い石。ほとんど建築向き。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01E4.title: "方解石"
	quest.42000000000A01E5.quest_desc: [
		"深みから出た灰色の石。素朴で、形をつけやすい。",
		"手順: Ex Deorum のふるい、ハンマー、るつぼ、または樽。網を砂粒に合わせる。"
	]
	quest.42000000000A01E5.title: "凝灰岩"
	quest.42000000000A01E6.quest_desc: [
		"地下でゆっくり育つ。積んで、また鍾乳石へと滴らせる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000A01E6.title: "鍾乳石"
	quest.42000000000A01E7.quest_desc: [
		"溜まった水を素早く吸い取る。畑が浸水したあとに便利。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000A01E7.title: "スポンジ"
	quest.42000000000B01E8.quest_desc: [
		"周りの貯蔵を、検索できる一つのネットワークにつなぐ。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 木の樽かチェスト、コンパレーター二つ、板材と石。近くの Sophisticated の樽をつなぐ。"
	]
	quest.42000000000B01E8.title: "ストレージコントローラ"
	quest.42000000000B01E9.quest_desc: [
		"強化できる樽。フィルター、ホッパー、磁石、虚空。",
		"手順: 樽を銅で強化する。クラフト名は JEI が示す。"
	]
	quest.42000000000B01E9.title: "銅の樽"
	quest.42000000000B01EA.quest_desc: [
		"スロットが増え、強化の列も増える。",
		"手順: 樽と強化は JEI に。コントローラーが樽の壁を一つにつなぐ。"
	]
	quest.42000000000B01EA.title: "鉄の樽"
	quest.42000000000B01EB.quest_desc: [
		"浮島の向こうから、落ちたアイテムを樽へまっすぐ吸い込む。",
		"手順: 樽と強化は JEI に。コントローラーが樽の壁を一つにつなぐ。"
	]
	quest.42000000000B01EB.title: "アイテム引き寄せ機能・改"
	quest.42000000000B01EC.quest_desc: [
		"一方から入り、もう一方へ出る。ホッパーブロックは要らない。",
		"手順: 樽と強化は JEI に。コントローラーが樽の壁を一つにつなぐ。"
	]
	quest.42000000000B01EC.title: "ホッパー機能"
	quest.42000000000B01ED.quest_desc: [
		"容量を超えた分を消すので、引き出しは決して詰まらない。",
		"手順: 樽と強化は JEI に。コントローラーが樽の壁を一つにつなぐ。"
	]
	quest.42000000000B01ED.title: "虚空強化"
	quest.42000000000B01EE.quest_desc: [
		"近くの落ち物を、取り付けた収納へまっすぐ吸い込む。",
		"手順: 樽と強化は JEI に。コントローラーが樽の壁を一つにつなぐ。"
	]
	quest.42000000000B01EE.title: "回収強化"
	quest.42000000000B01EF.quest_desc: [
		"スロット一つ。分類されて、見える。大量のアイテムをしまう最も単純な方法。",
		"手順: オークの原木＋チェスト。最初の引き出し。"
	]
	quest.42000000000B01EF.title: "オークの引き出し 1x1"
	quest.42000000000B01F0.quest_desc: [
		"スロットを二つ並べ、似たアイテムを分けておく。",
		"手順: オークの引き出し 1x1 / 1x2 / 2x2、それから圧縮引き出しとコントローラー。クラフト名は JEI にある。"
	]
	quest.42000000000B01F0.title: "オークの引き出し 1x2"
	quest.42000000000B01F1.quest_desc: [
		"一つの枠にスロット四つ。小さな床面積で密な収納。",
		"手順: オークの引き出し 1x1 / 1x2 / 2x2、それから圧縮引き出しとコントローラー。クラフト名は JEI にある。"
	]
	quest.42000000000B01F1.title: "オークの引き出し 2x2"
	quest.42000000000B01F2.quest_desc: [
		"溜まるにつれ、中身を自動でブロックに圧縮する。",
		"手順: オークの引き出し 1x1 / 1x2 / 2x2、それから圧縮引き出しとコントローラー。クラフト名は JEI にある。"
	]
	quest.42000000000B01F2.title: "コンパクトドロワー"
	quest.42000000000B01F3.quest_desc: [
		"周りの貯蔵を、検索できる一つのネットワークにつなぐ。",
		"手順: オークの引き出し 1x1 / 1x2 / 2x2、それから圧縮引き出しとコントローラー。クラフト名は JEI にある。"
	]
	quest.42000000000B01F3.title: "収納コントローラー（収納）"
	quest.42000000000B01F4.quest_desc: [
		"近くの落ちたアイテムを引き出しへまっすぐ吸い込む。",
		"手順: オークの引き出し 1x1 / 1x2 / 2x2、それから圧縮引き出しとコントローラー。クラフト名は JEI にある。"
	]
	quest.42000000000B01F4.title: "コレクターアップグレード"
	quest.42000000000B01F5.quest_desc: [
		"隣に置いたチェストや機械からアイテムを引き出す。",
		"手順: オークの引き出し 1x1 / 1x2 / 2x2、それから圧縮引き出しとコントローラー。クラフト名は JEI にある。"
	]
	quest.42000000000B01F5.title: "搬入アップグレード"
	quest.42000000000B01F6.quest_desc: [
		"隣のインベントリへ、しまってあるアイテムを押し込む。",
		"手順: オークの引き出し 1x1 / 1x2 / 2x2、それから圧縮引き出しとコントローラー。クラフト名は JEI にある。"
	]
	quest.42000000000B01F6.title: "搬出アップグレード"
	quest.42000000000B01F7.quest_desc: [
		"容量を超えた分を消すので、引き出しは決して詰まらない。",
		"手順: オークの引き出し 1x1 / 1x2 / 2x2、それから圧縮引き出しとコントローラー。クラフト名は JEI にある。"
	]
	quest.42000000000B01F7.title: "虚空強化（収納）"
	quest.42000000000B01F8.quest_desc: [
		"ホットバーとポケットの空きを増やす、持ち運べるインベントリ。",
		"手順: 革＋チェスト。それから鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B01F8.title: "革のリュック"
	quest.42000000000B01F9.quest_desc: [
		"普通のバックパックよりスロットが多く、強化用のスロットもある。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B01F9.title: "鉄のリュック"
	quest.42000000000B01FA.quest_desc: [
		"さらに広く、便利な強化のためのスロットも残る。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B01FA.title: "金のリュック"
	quest.42000000000B01FB.quest_desc: [
		"エンチャントが収納をさらに先へ進める前の、最も深いポケット。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B01FB.title: "ダイヤモンドのリュック"
	quest.42000000000B01FC.quest_desc: [
		"近くの落ち物を、取り付けた収納へまっすぐ吸い込む。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B01FC.title: "回収強化（収納）"
	quest.42000000000B01FD.quest_desc: [
		"バックパックに入るものを絞り込む。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B01FD.title: "仕分けフィルタ機能"
	quest.42000000000B01FE.quest_desc: [
		"バックパックが、すでにしまってあるものでクラフトできるようにする。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B01FE.title: "作業台機能"
	quest.42000000000B01FF.quest_desc: [
		"空腹が落ちると、しまってある食料で自動的に食べさせる。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B01FF.title: "ごはん機能"
	quest.42000000000B0200.quest_desc: [
		"壊れた道具を、バックパックの新しいものに取り替える。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B0200.title: "回収機能"
	quest.42000000000B0201.quest_desc: [
		"近づくと、バックパックの中身を近くのチェストへ空ける。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B0201.title: "収納機能"
	quest.42000000000B0202.quest_desc: [
		"バックパックの中に液体用タンクを足し、液体を運ばせる。",
		"手順: 革のバックパック、それから JEI の鉄/金/ダイヤモンドの強化。"
	]
	quest.42000000000B0202.title: "タンク機能"
	quest.42000000000C0203.quest_desc: [
		"この系統の機械と筐体の大半を支える基幹の金属。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0203.title: "鋼鉄インゴット"
	quest.42000000000C0204.quest_desc: [
		"ケーブル、タンク、初期の機械の大半を支える中核の金属。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0204.title: "オスミウムインゴット"
	quest.42000000000C0205.quest_desc: [
		"黒曜石の粉を押し固めた硬い合金。より頑丈な装備のため。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0205.title: "精製黒曜石"
	quest.42000000000C0206.quest_desc: [
		"最も単純な論理基板。初期の機械の多くは数枚要る。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0206.title: "基本制御回路"
	quest.42000000000C0207.quest_desc: [
		"ラインの一段上の機械向けの、より鋭い論理基板。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0207.title: "発展制御回路"
	quest.42000000000C0208.quest_desc: [
		"最も鋭い論理基板で、ライン最上の機械に取っておく。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0208.title: "精鋭制御回路"
	quest.42000000000C0209.quest_desc: [
		"精錬の前に、金属へ炭素、レッドストーン、ダイヤモンド粉を染み込ませる。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0209.title: "冶金吹込機"
	quest.42000000000C020A.quest_desc: [
		"ほとんどの原鉱を、粉一つではなく二つにする。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C020A.title: "濃縮室"
	quest.42000000000C020B.quest_desc: [
		"まとめの材料を挽くか、砕け。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C020B.title: "粉砕機"
	quest.42000000000C020C.quest_desc: [
		"燃料ではなく電力で鉱石を精錬し、少しだけ速い。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C020C.title: "電動精錬機"
	quest.42000000000C020D.quest_desc: [
		"濃縮した鉱石を酸素で浄化し、三つ目の産出を得て、ときにはそれ以上。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C020D.title: "浄化室"
	quest.42000000000C020E.quest_desc: [
		"鉱石へガスを注入し、ライン最高の豊かな産出を得る。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C020E.title: "化学注入"
	quest.42000000000C020F.quest_desc: [
		"オスミウムの粉を、かまど単体より速くインゴットへ圧縮する。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C020F.title: "オスミウム圧縮機"
	quest.42000000000C0210.quest_desc: [
		"チェストが持てるよりずっと多く入る、スタック枠が一つ。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0210.title: "基本ビン"
	quest.42000000000C0211.quest_desc: [
		"一つのブロックに、一つの液体の深い溜まりを蓄える。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0211.title: "基本流体タンク"
	quest.42000000000C0212.quest_desc: [
		"機械のあいだで電力を緩衝し、急増でラインが止まらないようにする。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0212.title: "基本エネルギーキューブ"
	quest.42000000000C0213.quest_desc: [
		"機械へ電力を運ぶ。浮島でいちばん普通のケーブル。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0213.title: "基本ユニバーサルケーブル"
	quest.42000000000C0214.quest_desc: [
		"浮島に沿って、タンクと機械のあいだで液体を運ぶ。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0214.title: "基本メカニカルパイプ"
	quest.42000000000C0215.quest_desc: [
		"つながったインベントリのあいだでアイテムを自動で運ぶ。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0215.title: "基本物流トランスポーター"
	quest.42000000000C0216.quest_desc: [
		"一つの道具で、機械の面を回し、締め、設定し直す。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0216.title: "コンフィギュレーター"
	quest.42000000000C0217.quest_desc: [
		"Mek のジェットパック——任意の上昇。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0217.title: "ジェットパック"
	quest.42000000000C0218.quest_desc: [
		"落下ダメージを和らげ、虚空に取られる前に一秒を稼ぐ。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0218.title: "フリーランナー"
	quest.42000000000C0219.quest_desc: [
		"掘って、切って、戦う一つの道具で、強化するたびより鋭くなる。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C0219.title: "原子分解機"
	quest.42000000000C021A.quest_desc: [
		"ほとんどのマルチブロック機械がこれを芯にして組まれる構造枠。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C021A.title: "鋼鉄ケーシング"
	quest.42000000000C021B.quest_desc: [
		"二点をつなぎ、くぐればあいだの歩きを飛ばせる。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C021B.title: "テレポーター"
	quest.42000000000C021C.quest_desc: [
		"広い範囲を自動で掘り、産出を仕分けてくれる。",
		"手順: Mekanism の工房の章 — ふるいの鉱石の塊、それから工場ライン。"
	]
	quest.42000000000C021C.title: "デジタルマイナー"
	quest.42000000000D021D.quest_desc: [
		"電網の機械のほとんどのもとになる、ねばつく基礎材料。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D021D.title: "誘電体ペースト"
	quest.42000000000D021E.quest_desc: [
		"電力をいくらか蓄える。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D021E.title: "基本コンデンサ"
	quest.42000000000D021F.quest_desc: [
		"周りの機械のために、電力の深い蓄えを持つ。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D021F.title: "基本エネルギーセル"
	quest.42000000000D0220.quest_desc: [
		"ただのかまどより効率よく、燃料を電力に変える。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0220.title: "基本燃焼器"
	quest.42000000000D0221.quest_desc: [
		"溶岩があるかぎり、溶岩を安定した電力に変える。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0221.title: "基本マグマ燃焼器"
	quest.42000000000D0222.quest_desc: [
		"日光から電力を生み、セル一つが単独で賄うより多い。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0222.title: "基本ソーラーパネル"
	quest.42000000000D0223.quest_desc: [
		"近くの熱いブロックと冷たいブロックの熱の差から電力を生む。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0223.title: "基本熱発電機"
	quest.42000000000D0224.quest_desc: [
		"固形燃料を安定して焼き、強く頼れる細い電力の流れにする。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0224.title: "基本リアクター"
	quest.42000000000D0225.quest_desc: [
		"初期ケーブルより、1ティックあたり多くのエネルギーを運ぶ。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0225.title: "基本エネルギーケーブル"
	quest.42000000000D0226.quest_desc: [
		"プレイヤーを直接充電する。配線もスロットも要らない。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0226.title: "基本プレイヤー送信機"
	quest.42000000000D0227.quest_desc: [
		"近くの機械にエネルギーを入れる。ホッパーがアイテムを入れるのと同じだ。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0227.title: "基本エネルギーホッパー"
	quest.42000000000D0228.quest_desc: [
		"結晶の組みのそばに置くと、充填セルをより速く充電する。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0228.title: "基本充填ロッド"
	quest.42000000000D0229.quest_desc: [
		"手で機械の間を運ぶ、ポケットのエネルギー予備。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D0229.title: "基本電池"
	quest.42000000000D022A.quest_desc: [
		"充填ロッドのセル室に入れる、最初の結晶段階。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D022A.title: "ニオティッククリスタル"
	quest.42000000000D022B.quest_desc: [
		"より強い結晶段階。充填室の組み立ての、さらに先。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D022B.title: "スピリテッドクリスタル"
	quest.42000000000D022C.quest_desc: [
		"充填室が収められる、最も強い結晶段階。",
		"手順: Powah の電網の章——火花のパルスができてから、充填オーブとケーブル。"
	]
	quest.42000000000D022C.title: "ニトロクリスタル"
	quest.42000000000E022D.quest_desc: [
		"魔術師の花から紡ぎ、ローブと呪文の装備に織る。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E022D.title: "魔術師の繊維"
	quest.42000000000E022E.quest_desc: [
		"収穫したあと、茎に繊維が生え直す花。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E022E.title: "メイジブルーム"
	quest.42000000000E022F.quest_desc: [
		"濃いソースの池、あらゆる呪文の背後の燃料を蓄える。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E022F.title: "ソースジェムブロック"
	quest.42000000000E0230.quest_desc: [
		"初期の本が許すより多くのグリフを収める。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0230.title: "見習いの呪文の本"
	quest.42000000000E0231.quest_desc: [
		"最大の呪文の本で、グリフの武庫を一式入れる余地がある。",
		"手順: 魔術師の呪文の本、エンダーパール三つ、エメラルド二つ、不死のトーテム、ネザースター、Wilden の貢物、不定形。トーテム：パックのレシピ、金のリンゴの周りに金ブロック四つとエメラルド四つ。"
	]
	quest.42000000000E0231.title: "大魔導士のスペルブック"
	quest.42000000000E0232.quest_desc: [
		"標的を感じると、結んだ呪文を自動で放つ。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0232.title: "呪文タレット"
	quest.42000000000E0233.quest_desc: [
		"視界ではなく、一定のタイマーで結んだ呪文を放つ。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0233.title: "タイマースペルタレット"
	quest.42000000000E0234.quest_desc: [
		"呪文の本、杖、その他の秘術装備を作る中心。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0234.title: "エンチャント装置"
	quest.42000000000E0235.quest_desc: [
		"エンチャント装置の内側に座り、そのレシピを動かす。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0235.title: "儀式コア"
	quest.42000000000E0236.quest_desc: [
		"秘術の地点と、結んだ瓶か呪文の間でソースを運ぶ。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0236.title: "リレー"
	quest.42000000000E0237.quest_desc: [
		"ソースの線一本を分け、一度にいくつかの場所へ送る。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0237.title: "リレー分配器"
	quest.42000000000E0238.quest_desc: [
		"近くの作物の成長を、ゆっくりしたソースの滴りに変える。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0238.title: "植生のソースリンク"
	quest.42000000000E0239.quest_desc: [
		"近くの溶岩の熱を、途切れないソースの滴りに変える。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0239.title: "獄炎のソースリンク"
	quest.42000000000E023A.quest_desc: [
		"別の場所で働いている間にレシピを作ってくれる Wixie を召喚する。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E023A.title: "ウィクシーのお守り"
	quest.42000000000E023B.quest_desc: [
		"命じれば保管からアイテムを取ってくる Starbuncle を召喚する。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E023B.title: "スターバンクルのお守り"
	quest.42000000000E023C.quest_desc: [
		"近くで選んだ資源をゆっくり生み出す Drygmy を召喚する。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E023C.title: "ドライグミーのお守り"
	quest.42000000000E023D.quest_desc: [
		"作物をひとりで世話して育てる Whirlisprig を召喚する。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E023D.title: "ワールスプリッグのお守り"
	quest.42000000000E023E.quest_desc: [
		"ツルハシを上げずにアメジストの芽を収穫するゴーレムを召喚する。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E023E.title: "アメジストゴーレムのお守り"
	quest.42000000000E023F.quest_desc: [
		"遠くからブロックを拾って置き、離れた機械同士をつなぐ。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E023F.title: "主権の杖"
	quest.42000000000E0240.quest_desc: [
		"フィルターに入れると、そのアイテムを許可として印す。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0240.title: "許可の巻物"
	quest.42000000000E0241.quest_desc: [
		"フィルターに入れると、そのアイテムを拒否として印す。",
		"手順: 秘術側——苔から秘術の木と源素の実、それから連鎖。"
	]
	quest.42000000000E0241.title: "拒否の巻物"
	quest.42000000000F0242.quest_desc: [
		"結束の結びの周りに原木、上に糸。浮島に置く。",
		"そばに立つ。ストランドが据わると、浮島があなたを癒し始める。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 結束の結びの周りに原木、上に糸。浮島に置く。見れば完了。"
	]
	quest.42000000000F0242.title: "柱を立てる"
	quest.42000000000F0243.quest_desc: [
		"拠点の鍵を手に、または /clowder hub。サーバーのどの Clowder もここで会う。",
		"/clowder return で家に帰れる。",
		"手順: 拠点の鍵か `/clowder hub`。`/clowder return` で家に戻る。"
	]
	quest.42000000000F0243.title: "ホールへ入る"
	quest.42000000000F0244.quest_desc: [
		"桟橋の上に、ゆっくりした暗い柱が立つ。断ちそのもの。",
		"Clowders がストランドを据えるにつれ細る。時々戻って確かめる。",
		"手順: /clowder hub、桟橋の上の暗い柱を見上げ、チェックマークをクリック。"
	]
	quest.42000000000F0244.title: "ほつれを見る"
	quest.42000000000F0245.quest_desc: [
		"浮島を自分の名にする。",
		"手順: K で島のパネルが開く。憲章を持ち、オーバーワールドの浮島の地面でスニーク使用し、出現地点を封じる。ここから始めるが手順を示す。"
	]
	quest.42000000000F0245.title: "島の憲章"
	quest.42000000000F0246.quest_desc: [
		"ストランドのどこからでも、Clowder ホールへの帰り道を開く。",
		"手順: 初期キット／ホール。`/clowder hub` と拠点の鍵は Clowder ホールへ。`/clowder return` で家に戻る。"
	]
	quest.42000000000F0246.title: "拠点の鍵"
	quest.42000000000F0247.quest_desc: [
		"ストランドがどこまで来たかを示す旗の模様。",
		"手順: ホールか JEI で作る。旗の印であり、ストランドの札ではない。"
	]
	quest.42000000000F0247.title: "ストランドの旗"
	quest.42000000000F0248.quest_desc: [
		"グレイブ（`）で任務一覧が開く。ウィスカー写本を右クリックするとここから始める。同じキャンペーン。本の Shift クリックは不要。",
		"手順: 本と任意の石、不定形。グレイブ（`）はそれなしで同じ一覧を開く。"
	]
	quest.42000000000F0248.title: "任務一覧"
	quest.42000000000F0249.quest_desc: [
		"確保の遠征では腹を満たしておく。",
		"手順: ニンジンの周りに金塊を八つ。ニンジンはゾンビのまれな落ち物。軽食は任意。"
	]
	quest.42000000000F0249.title: "確保の軽食"
	quest.42000000000F024A.quest_desc: [
		"Clowder が外へ広がるにつれ、周りの浮島を図にする。",
		"手順: 紙で囲んだコンパス。"
	]
	quest.42000000000F024A.title: "地図"
	quest.42000000000F024B.quest_desc: [
		"ワールドの出現地点を指し、浮島が増えると役に立つ。",
		"手順: レッドストーンの周りに鉄。"
	]
	quest.42000000000F024B.title: "コンパス"
	quest.42000000000F024C.quest_desc: [
		"出現地点ではなく、正確な一点にコンパスを固定する。",
		"手順: 模様入りの石レンガの中にネザライトインゴット。Clowder の後期の贅沢。"
	]
	quest.42000000000F024C.title: "ロードストーン"
	quest.42000000000F024D.quest_desc: [
		"最後に死んだ場所を指す。虚空に何も残さないため。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000F024D.title: "リカバリーコンパス"
	quest.42000000000F024E.quest_desc: [
		"Clowder 全員を一つの浮島に集めるほど大きく鳴る。",
		"手順: クラフトレシピはない。Occultism の野生の霊へ接触する儀式で一つできるが、ヤギが要る。ヤギは浮島まで来ない。任意。"
	]
	quest.42000000000F024E.title: "鐘"
	quest.42000000000F024F.quest_desc: [
		"本を開いたままにし、Clowder 全員が読める。",
		"手順: 本棚の周りに木材のハーフブロック。"
	]
	quest.42000000000F024F.title: "書見台"
	quest.42000000000F0250.quest_desc: [
		"地区に札を付け、新参がどの浮島か分かるようにする。",
		"手順: 棒の上に板材。"
	]
	quest.42000000000F0250.title: "オークの看板"
	quest.42000000000F0251.quest_desc: [
		"Clowder の色を受ける無地の旗。",
		"手順: 棒の上に羊毛を六つ。"
	]
	quest.42000000000F0251.title: "白色の旗"
	quest.42000000000F0252.quest_desc: [
		"旗を受ける準備のできた盾。",
		"手順: 鉄の周りに板材を六つ。オフハンドで防御。"
	]
	quest.42000000000F0252.title: "旗を受ける盾"
	quest.42000000000F0253.quest_desc: [
		"ストランドがついに再び揃うとき、これを打ち上げる。",
		"手順: 紙に火薬。任意の炸裂。"
	]
	quest.42000000000F0253.title: "花火"
	quest.42000000000F0254.quest_desc: [
		"ホールと分ける。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000F0254.title: "クッキーの貢ぎ物"
	quest.42000000000F0255.quest_desc: [
		"確かに織り直されたストランドを祝う分け合いの食べ物。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000F0255.title: "ケーキ"
	quest.42000000000F0256.quest_desc: [
		"ネコのレコード — パックの気分。",
		"任意。虚空は一度も出さないかもしれない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000F0256.title: "レコード"
	quest.42000000000F0257.quest_desc: [
		"手懐けたか買った動物を、追いかけずに浮島へ連れ戻す。",
		"手順: スライムボールの周りに紐を四つ。スライムは浮島の堆肥（土、種、骨粉）。"
	]
	quest.42000000000F0257.title: "リード"
	quest.42000000000F0258.quest_desc: [
		"鞍を見つけたら乗れ。",
		"任意 — Clowder ホールの浮島の守り手が一つ売る。",
		"手順: Clowder ホール（/clowder hub）の浮島の守り手の店でダイヤモンドブロックを交換する。Chocobo の鞍は別のアイテム。"
	]
	quest.42000000000F0258.title: "鞍"
	quest.42000000000F0259.quest_desc: [
		"誰かが海を築く日のために。任意。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000000F0259.title: "ボート"
	quest.4200000000110278.quest_desc: [
		"大地のどこでオーラが濃く、または薄く溜まるかを示す。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 金の葉＋クモの目。その場のオーラを示す。"
	]
	quest.4200000000110278.title: "瞳（オーラ）"
	quest.4200000000110279.quest_desc: [
		"金から織られ、濃縮したオーラを植物に注ぐのに使う。",
		"手順: 短い草の周りに葉四つと金塊四つで、輝く繊維が四つできる。木の梢に置くと、葉は時とともに金色になる。"
	]
	quest.4200000000110279.title: "輝繊維（オーラ）"
	quest.420000000011027A.quest_desc: [
		"祭壇の上位レシピに使う精製素材。",
		"手順: 輝く繊維から育った金の葉を壊す。"
	]
	quest.420000000011027A.title: "金箔（オーラ）"
	quest.420000000011027B.quest_desc: [
		"一年じゅう、やわらかい金色の輝きを保つ葉。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011027B.title: "Golden Leaves"
	quest.420000000011027C.quest_desc: [
		"森の儀式の材料を載せ、苗木の周りに据える。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011027C.title: "Wooden Stand"
	quest.420000000011027D.quest_desc: [
		"オーラがより強いクラフトレシピを動かす祭壇。",
		"手順: 森の儀式（JEI）：石三つ、金の葉、金インゴット、喜びの証。オーラの心臓の系。"
	]
	quest.420000000011027D.title: "自然の祭壇（オーラ）"
	quest.420000000011027E.quest_desc: [
		"オーラを帯びた鉄で、深淵のインゴットへの一歩。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011027E.title: "注入鉄（オーラ）"
	quest.420000000011027F.quest_desc: [
		"古木から剥いだ樹皮で、オーラのレシピに役立つ。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011027F.title: "Ancient Bark"
	quest.4200000000110280.quest_desc: [
		"喜びの証。自然の祭壇と草食吸収器はこれを土台に組む。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110280.title: "喜びの証（オーラ）"
	quest.4200000000110281.quest_desc: [
		"恐怖の証。樹冠減衰器と残留吸収器は、一つを土台に作る。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110281.title: "Token of Fear"
	quest.4200000000110282.quest_desc: [
		"怒りの証。崩解の触媒と射撃標には一つ要る。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110282.title: "Token of Anger"
	quest.4200000000110283.quest_desc: [
		"悲しみの証。供物台と定命の解き手には一つ要る。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110283.title: "Token of Sorrow"
	quest.4200000000110284.quest_desc: [
		"儀式用のオーラの霊。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110284.title: "Spirit of Calling"
	quest.4200000000110285.quest_desc: [
		"オーラの儀礼用の誕生の霊。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110285.title: "Spirit of Birthing"
	quest.4200000000110286.quest_desc: [
		"大地が細るときのために、オーラの蓄えをしまう。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110286.title: "Aura Trove"
	quest.4200000000110287.quest_desc: [
		"終盤。オーラがそれを望むときだけ。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110287.title: "Creational Catalyst"
	quest.4200000000110288.quest_desc: [
		"より広い土地で、オーラと湧き条件を示す。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110288.title: "Environmental Ocular"
	quest.4200000000110289.quest_desc: [
		"自然の祭壇のそばに置くと、祭壇の粉砕レシピが開く。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110289.title: "Crumbling Catalyst"
	quest.420000000011028A.quest_desc: [
		"自然の祭壇のそばに置くと、祭壇の変成レシピが開く。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011028A.title: "Transmutation Catalyst"
	quest.420000000011028B.quest_desc: [
		"空のインゴット、穢れた金、ネザライトの欠片を、深淵のインゴットへと押し固める。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011028B.title: "Ingot of the Depths"
	quest.420000000011028C.quest_desc: [
		"作物が速く育つようオーラを引き込む畑の配置を示す。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011028C.title: "Farming Stencil"
	quest.420000000011028D.quest_desc: [
		"飛び道具が近くに着弾するたびにオーラを生む。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011028D.title: "Shooting Mark"
	quest.420000000011028E.quest_desc: [
		"近くで咲く花から、ゆっくりオーラを生む。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011028E.title: "Herbivorous Absorber"
	quest.420000000011028F.quest_desc: [
		"近くで育つオークから、ゆっくりオーラを生む。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.420000000011028F.title: "Canopy Diminisher"
	quest.4200000000110290.quest_desc: [
		"エンドの花。浮島でも妙に落ち着いている。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110290.title: "Rose of Oblivion"
	quest.4200000000110291.quest_desc: [
		"一帯を照らし、敵対するモブがそこに湧かないようにする。",
		"手順: 木に輝く繊維 → 金の葉 → 自然の祭壇。オーラの章が証と発電機の名を示す。"
	]
	quest.4200000000110291.title: "Lamp of Sanctuary"
	quest.4200000000120292.quest_desc: [
		"煮込み料理を作り、一度に皿一枚より多くをまかなう。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000120292.title: "調理鍋（厨房）"
	quest.4200000000120293.quest_desc: [
		"スキレットで料理を炒める。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000120293.title: "フライパン"
	quest.4200000000120294.quest_desc: [
		"Farmer's Delight のコンロ。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000120294.title: "コンロ"
	quest.4200000000120295.quest_desc: [
		"肉と野菜を、他のレシピが求める材料に切る。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000120295.title: "まな板（厨房）"
	quest.4200000000120296.quest_desc: [
		"収穫を運ぶかご。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000120296.title: "かご"
	quest.4200000000120297.quest_desc: [
		"つる植物のように登れて、いくつかの厨房レシピに必要。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000120297.title: "ロープ"
	quest.4200000000120298.quest_desc: [
		"高い落下を受け止め、無事に上へ跳ね返す。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.4200000000120298.title: "安全ネット"
	quest.4200000000120299.quest_desc: [
		"耕して植えると、近くの作物の成長を促す。",
		"手順: 有機堆肥を置いて待つと、ゆっくり豊かな土壌になる。"
	]
	quest.4200000000120299.title: "豊かな土壌（厨房）"
	quest.420000000012029A.quest_desc: [
		"食べかすを、土壌を肥やす堆肥に変える。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000012029A.title: "有機堆肥（厨房）"
	quest.420000000012029B.quest_desc: [
		"キャベツで包んだボリュームのある食事で、空腹をしっかり回復する。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000012029B.title: "ロールキャベツ"
	quest.420000000012029C.quest_desc: [
		"すぐ作れ、すぐ食べられ、手間のわりに空腹はそこそこ戻る。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000012029C.title: "ベーコンサンド"
	quest.420000000012029D.quest_desc: [
		"重ねた食事で、材料を単体で食べるより多く空腹を回復する。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000012029D.title: "ハンバーガー"
	quest.420000000012029E.quest_desc: [
		"温まる一杯で、空腹と飽和をまとめて回復する。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000012029E.title: "チキンスープ"
	quest.420000000012029F.quest_desc: [
		"牛肉シチューは腹にしっかりたまる。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.420000000012029F.title: "ビーフシチュー"
	quest.42000000001202A0.quest_desc: [
		"麺と出汁で、一日の仕事に足りるほど腹持ちがいい。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A0.title: "ラーメン"
	quest.42000000001202A1.quest_desc: [
		"待つ価値のある焼き菓子で、空腹をたっぷり回復する。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A1.title: "アップルパイ"
	quest.42000000001202A2.quest_desc: [
		"酸っぱくて甘く、浮島でも特に濃いデザートの一つ。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A2.title: "スイートベリーチーズケーキ"
	quest.42000000001202A3.quest_desc: [
		"厨房ライン用の米。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A3.title: "米"
	quest.42000000001202A4.quest_desc: [
		"厨房ラインのほっとする食事。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A4.title: "チャーハン"
	quest.42000000001202A5.quest_desc: [
		"具を包んだ小さな塊で、まとめてすぐ火を通せる。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A5.title: "ダンプリング"
	quest.42000000001202A6.quest_desc: [
		"カカオ豆と牛乳で淹れた温かい飲み物。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A6.title: "ホットココア"
	quest.42000000001202A7.quest_desc: [
		"スイカを搾った冷たい飲み物で、空腹を少しすぐ回復する。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A7.title: "スイカジュース"
	quest.42000000001202A8.quest_desc: [
		"織った布で、厨房と装飾のいくつかのレシピに使う。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A8.title: "キャンバス"
	quest.42000000001202A9.quest_desc: [
		"柔らかく織った床で、素の木とは手触りが変わる。",
		"手順: JEI で Farmer's Delight を作る（作業台、まな板、または調理鍋）。作物の種は土をふるって得る。"
	]
	quest.42000000001202A9.title: "畳"
	quest.42000000001302AA.quest_desc: [
		"本物の戦いで呪文を唱えられる最初の本。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 鎖三つ、革四つ、紙二つ。呪文の章がインクの名を示す。"
	]
	quest.42000000001302AA.title: "鉄の呪文本"
	quest.42000000001302AB.quest_desc: [
		"前の鉄の本より呪文の枠が多い。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302AB.title: "金の呪文本"
	quest.42000000001302AC.quest_desc: [
		"もっと頑丈な本で、呪文を入れる余地がさらに広い。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302AC.title: "ダイヤモンドの呪文本"
	quest.42000000001302AD.quest_desc: [
		"呪文を唱える燃料になり、ほとんどの呪文レシピの土台にある。",
		"手順: 詠唱者を倒すか、JEI に載ったものを作る。インクと本の燃料。"
	]
	quest.42000000001302AD.title: "秘術のエッセンス（呪文）"
	quest.42000000001302AE.quest_desc: [
		"呪文とページを写す。",
		"手順: 瓶＋エッセンス＋染料。最初の記銘インク。"
	]
	quest.42000000001302AE.title: "コモンインク"
	quest.42000000001302AF.quest_desc: [
		"珍しい位の呪文と巻物を本に書き込む。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302AF.title: "アンコモンインク"
	quest.42000000001302B0.quest_desc: [
		"希少な位の呪文と巻物を本に書き込む。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B0.title: "レアインク"
	quest.42000000001302B1.quest_desc: [
		"英雄級の呪文と巻物を本に書き込む。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B1.title: "エピックインク"
	quest.42000000001302B2.quest_desc: [
		"本が抱えられるうち、最も希少で最も強い呪文を書き込む。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B2.title: "レジェンダリーインク"
	quest.42000000001302B3.quest_desc: [
		"本で覚えていなくても、呪文を一度だけ唱えられる。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B3.title: "スクロール"
	quest.42000000001302B4.quest_desc: [
		"ローブ用の魔法の布。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B4.title: "魔法の布"
	quest.42000000001302B5.quest_desc: [
		"素の防御より詠唱を優先する軽い防具。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B5.title: "放浪の魔術師のヘルメット"
	quest.42000000001302B6.quest_desc: [
		"受けるダメージより詠唱の速さを優先した胸当て。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B6.title: "放浪の魔術師のチェストプレート"
	quest.42000000001302B7.quest_desc: [
		"火の呪文をより強い力で通す杖。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B7.title: "焔結晶の杖"
	quest.42000000001302B8.quest_desc: [
		"唱え始めたばかりの者向けの、控えめな杖。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302B8.title: "長老の杖"
	quest.42000000001302B9.quest_desc: [
		"呪文使いを罰し、その防御を断ち切る刃。",
		"手順: パックのレシピ。秘術のインゴット二つを対角線に、両脇に鎖、柄にダイヤモンド。野生の所持者はエヴォーカーの砦にしかおらず、浮島にはその砦はない。"
	]
	quest.42000000001302B9.title: "メイジハンター"
	quest.42000000001302BA.quest_desc: [
		"いちばん早い呪文本。枠は少ないが、手に入れやすい。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302BA.title: "銅の呪文本"
	quest.42000000001302BB.quest_desc: [
		"最強の呪文本。呪文の枠はどの本より多い。",
		"手順: 秘術の布四つ、血の小瓶二つ、ネザライトインゴット、稲妻の瓶、廃れた本（パックのレシピ）。JEI では古代の写本と出る。"
	]
	quest.42000000001302BB.title: "ネザライトの呪文本"
	quest.42000000001302BC.quest_desc: [
		"上位の詠唱装備に広く使う、精錬した金属。",
		"手順: 秘術のエッセンスとインク、それから呪文本。呪文の章が梯子に名を付ける。"
	]
	quest.42000000001302BC.title: "秘術のインゴット"
	quest.42000000001302BD.quest_desc: [
		"傷ついた本。また知識へとつなぎ直せる。",
		"手順: パックのレシピ。エンチャントの本を秘術のエッセンス四つとソウルサンド四つで囲む。JEI では廃れた本と出る。"
	]
	quest.42000000001302BD.title: "廃れた写本"
	quest.42000000001402BE.quest_desc: [
		"Solar Flux の最初の部品。セル、被覆、空の強化はこれから作る。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 鉄インゴットの上にガラス三つで、鏡が三つできる。"
	]
	quest.42000000001402BE.title: "鏡"
	quest.42000000001402BF.quest_desc: [
		"太陽電池の最初の段階。弱いが、まとめて作るのは安い。",
		"手順: ガラス三つ、ラピスラズリ三つ、鏡三つ。それぞれ一列。"
	]
	quest.42000000001402BF.title: "光電池 1"
	quest.42000000001402C0.quest_desc: [
		"前の段階より一段強い太陽電池。",
		"手順: 粘土玉三つ、ラピスラズリ三つ、鏡二つ、光電池 I。"
	]
	quest.42000000001402C0.title: "光電池 2"
	quest.42000000001402C1.quest_desc: [
		"中位の太陽電池。パネルあたりの出力がはっきり増える。",
		"手順: ガラス三つ、グロウストーンダスト三つ、黒曜石二つ、光電池 II。"
	]
	quest.42000000001402C1.title: "光電池 3"
	quest.42000000001402C2.quest_desc: [
		"規模を伸ばすパネル向けの、上位の太陽電池。",
		"手順: 烈火の被覆三つ、グロウストーンダスト二つ、ダイヤモンド、クォーツブロック二つ、光電池 III。"
	]
	quest.42000000001402C2.title: "光電池 4"
	quest.42000000001402C3.quest_desc: [
		"ほぼ最上位。この電池は日光から本気の電力を引き出す。",
		"手順: エメラルドガラス三つ、グロウストーンブロック二つ、ダイヤモンドブロック、クォーツブロック、光電池 IV 二つ。二つできる。"
	]
	quest.42000000001402C3.title: "光電池 5"
	quest.42000000001402C4.quest_desc: [
		"作れる中で最強の太陽電池。パネル一枚の上限。",
		"手順: エンダーガラス三つ、グロウストーンブロック二つ、エメラルドブロック、クォーツブロック、光電池 V 二つ。二つできる。"
	]
	quest.42000000001402C4.title: "光電池 6"
	quest.42000000001402C5.quest_desc: [
		"ソーラーパネルが蓄電の備えをより大きく持てるようにする。",
		"手順: レッドストーンブロック五つ、ダイヤモンドブロック、空の強化。"
	]
	quest.42000000001402C5.title: "容量強化"
	quest.42000000001402C6.quest_desc: [
		"同じ日光から、より多くの電力を絞り出す。",
		"手順: 鏡三つ、空の強化、光電池 I。"
	]
	quest.42000000001402C6.title: "効率強化"
	quest.42000000001402C7.quest_desc: [
		"ソーラーパネルが電力をより速く送り出せるようにする。",
		"手順: 空の強化の周りにレッドストーン六つと金インゴット二つ。"
	]
	quest.42000000001402C7.title: "転送強化"
	quest.42000000001402C8.quest_desc: [
		"パネルにつながった機械へ、数ブロック以内で電力を渡す。",
		"手順: 空の強化の周りに鉄インゴット四つ、ピストン二つ、レッドストーン二つ。"
	]
	quest.42000000001402C8.title: "横断強化"
	quest.42000000001402C9.quest_desc: [
		"パネルの近くに立つプレイヤーへ電力を送る。",
		"手順: 空の強化を、グロウストーンダスト四つとエンダーアイ四つで囲む。"
	]
	quest.42000000001402C9.title: "拡散強化"
	quest.42000000001402CA.quest_desc: [
		"範囲内のリンクしたブロック一つへ電力を送る。ケーブルは要らない。",
		"手順: 拡散強化を、エンダーパール四つとレッドストーンブロック四つで囲む。"
	]
	quest.42000000001402CA.title: "ブロック充電強化"
	quest.42000000001402CB.quest_desc: [
		"パネルが燃料の代わりに蓄えた日光でアイテムを製錬できるようにする。",
		"手順: 空の強化を、石炭五つ、かまど一つ、烈火の被膜二つで囲む。"
	]
	quest.42000000001402CB.title: "かまど強化"
	quest.42000000001402CC.quest_desc: [
		"エメラルドをはめ込んだ鏡ガラス。エンダーガラスと光電池 V はこれを土台にする。",
		"手順: 鏡二つのあいだにエメラルドを縦一列に置くと、二つできる。"
	]
	quest.42000000001402CC.title: "エメラルドガラス"
	quest.42000000001402CD.quest_desc: [
		"真珠と目で帯電させたエメラルドガラス。光電池 VI はこれを土台にする。",
		"手順: エンダーパール二つのあいだのエンダーアイの上にエメラルドガラスを三つ置くと、三つできる。"
	]
	quest.42000000001402CD.title: "エンダーガラス"
	quest.42000000001402CE.quest_desc: [
		"ブレイズパウダーをまぶした鏡の仕上げ。光電池 IV とかまど強化がこれを使う。",
		"手順: 鏡二つのあいだにブレイズパウダーを縦一列に置くと、二つできる。"
	]
	quest.42000000001402CE.title: "烈火の被膜"
	quest.42000000001402CF.quest_desc: [
		"まだ用途の決まらない強化アイテム。どの強化にも加工できる。",
		"手順: 鏡を丸石四つで囲む。"
	]
	quest.42000000001402CF.title: "空の強化"
	quest.42000000001502D0.quest_desc: [
		"壁と床のための、飾り気がなく頼りになる石。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: 石を四つ正方形に、または石切台。"
	]
	quest.42000000001502D0.title: "石レンガ"
	quest.42000000001502D1.quest_desc: [
		"浮島の苔むしたレンガ縁取り。",
		"手順: 石レンガにツタか苔。そのあと石切台。"
	]
	quest.42000000001502D1.title: "苔むした石レンガ"
	quest.42000000001502D2.quest_desc: [
		"風化した石レンガで、すり減ってひび割れた見た目。",
		"手順: 石レンガを製錬する。"
	]
	quest.42000000001502D2.title: "ひび割れた石レンガ"
	quest.42000000001502D3.quest_desc: [
		"縁取りと差し色の線のための、彫られた石レンガ。",
		"手順: 石レンガのハーフブロック二つ、または石切台。"
	]
	quest.42000000001502D3.title: "模様入り石レンガ"
	quest.42000000001502D4.quest_desc: [
		"床向けの、平らで均一な石の仕上げ。",
		"手順: 石を製錬する。ハーフブロックは石切台から。"
	]
	quest.42000000001502D4.title: "滑らかな石"
	quest.42000000001502D5.quest_desc: [
		"灰色の石を滑らかに磨き上げたもの。",
		"手順: 安山岩を四つ、または石切台。"
	]
	quest.42000000001502D5.title: "磨かれた安山岩"
	quest.42000000001502D6.quest_desc: [
		"明るく白い石で、滑らかに磨いてある。",
		"手順: 閃緑岩を四つ、または石切台。"
	]
	quest.42000000001502D6.title: "磨かれた閃緑岩"
	quest.42000000001502D7.quest_desc: [
		"暖かい桃色の石。細部用に磨いてある。",
		"手順: 花崗岩を四つ、または石切台。"
	]
	quest.42000000001502D7.title: "磨かれた花崗岩"
	quest.42000000001502D8.quest_desc: [
		"焼いた粘土のブロックで、灰色の石に暖かい赤。",
		"手順: レンガのアイテム四つ。粘土玉は製錬するとレンガになる。"
	]
	quest.42000000001502D8.title: "レンガ"
	quest.42000000001502D9.quest_desc: [
		"薄い色の固めた泥。建物の縁取りに成形してある。",
		"手順: 固めた泥を四つ。泥は土に水入り瓶で、泥と小麦が固めた泥になる。"
	]
	quest.42000000001502D9.title: "泥レンガ"
	quest.42000000001502DA.quest_desc: [
		"深みから引き上げた暗い石レンガ。",
		"手順: 磨かれた深層岩を正方形に、または石切台。深層岩の小石四つ（土をふるう）で深層岩の丸石になる。"
	]
	quest.42000000001502DA.title: "深層岩レンガ"
	quest.42000000001502DB.quest_desc: [
		"よりすっきりした床のための、滑らかな暗いタイル。",
		"手順: 深層岩レンガを正方形に、または石切台。"
	]
	quest.42000000001502DB.title: "深層岩タイル"
	quest.42000000001502DC.quest_desc: [
		"丈夫で飾り気のない、ネザーの暗い石。",
		"手順: 魔女の水を溶岩の樽に注ぐか、黒石の小石を四つ。砦はこれで築かれている。"
	]
	quest.42000000001502DC.title: "ブラックストーン"
	quest.42000000001502DD.quest_desc: [
		"つやのある暗い光沢まで磨いたブラックストーン。",
		"手順: ブラックストーン四つ、または石切台。爪のあとにネザー。"
	]
	quest.42000000001502DD.title: "磨かれたブラックストーン"
	quest.42000000001502DE.quest_desc: [
		"金がちりばめられたブラックストーン。希少で、飾り向き。",
		"手順: 爪の黒曜石のあとにネザーの砦。装飾の末端で、あとの門ではない。"
	]
	quest.42000000001502DE.title: "きらめくブラックストーン"
	quest.42000000001502DF.quest_desc: [
		"真っ白なブロック。浮島の装飾の定番。",
		"手順: ネザークォーツ四つ。爪のあとにネザー。"
	]
	quest.42000000001502DF.title: "クォーツブロック"
	quest.42000000001502E0.quest_desc: [
		"縁取りをきれいにする、平らに磨いたクォーツ。",
		"手順: クォーツブロックを製錬する。"
	]
	quest.42000000001502E0.title: "滑らかなクォーツ"
	quest.42000000001502E1.quest_desc: [
		"紫のエンドストーン。少し変わった差し色。",
		"手順: 焼いたコーラスフルーツ四つ。コーラスフルーツは縁歩きの屋台。"
	]
	quest.42000000001502E1.title: "プルプァブロック"
	quest.42000000001502E2.quest_desc: [
		"海で生まれた石。かすかな青い輝き。",
		"手順: プリズマリンの欠片が要る。海だけ。任意。"
	]
	quest.42000000001502E2.title: "プリズマリン"
	quest.42000000001502E3.quest_desc: [
		"より暗いプリズマリン。深い差し色に向く。",
		"手順: プリズマリンの欠片が要る。海だけ。任意。"
	]
	quest.42000000001502E3.title: "ダークプリズマリン"
	quest.42000000001502E4.quest_desc: [
		"海底から引き上げた、安定した光。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502E4.title: "シーランタン"
	quest.42000000001502E5.quest_desc: [
		"ネザーの菌から育てた、暖かい橙の光。",
		"手順: 巨大な菌に生える。ナイリウムに菌を植え、骨粉を与える。"
	]
	quest.42000000001502E5.title: "シュルームライト"
	quest.42000000001502E6.quest_desc: [
		"炎がまったくない、柔らかい黄色の光。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502E6.title: "黄土色のフロッグライト"
	quest.42000000001502E7.quest_desc: [
		"真珠の艶を帯びた、淡い光。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502E7.title: "真珠色のフロッグライト"
	quest.42000000001502E8.quest_desc: [
		"炎がなく、屋内でも安全な、涼しい緑の光。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502E8.title: "翠色のフロッグライト"
	quest.42000000001502E9.quest_desc: [
		"光は遮り、眺めは残すガラス。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502E9.title: "遮光ガラス"
	quest.42000000001502EA.quest_desc: [
		"窓の光をやわらかくする、柔らかい白いガラス。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502EA.title: "白色の色付きガラス"
	quest.42000000001502EB.quest_desc: [
		"開けた空に近い、淡い青のガラス。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502EB.title: "空色の色付きガラス"
	quest.42000000001502EC.quest_desc: [
		"部屋を落ち着かせる、涼しい青緑のガラス。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502EC.title: "青緑色の色付きガラス"
	quest.42000000001502ED.quest_desc: [
		"深い紫のガラス。下の虚空への会釈。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502ED.title: "紫色の色付きガラス"
	quest.42000000001502EE.quest_desc: [
		"雰囲気を灯す、小さく安定した炎。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502EE.title: "ろうそく"
	quest.42000000001502EF.quest_desc: [
		"淡いろうそく。明るい壁では控えめ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502EF.title: "白色のろうそく"
	quest.42000000001502F0.quest_desc: [
		"浮島の縁を安全に登れ。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F0.title: "足場の塔"
	quest.42000000001502F1.quest_desc: [
		"縦に伸びる浮島のための梯子。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F1.title: "梯子の蓄え"
	quest.42000000001502F2.quest_desc: [
		"虚空を渡るレール。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F2.title: "予備のレール"
	quest.42000000001502F3.quest_desc: [
		"浮島がいつか水に出会っても、浮かんでいられる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F3.title: "オークのボート"
	quest.42000000001502F4.quest_desc: [
		"浮島の壁を飾る。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F4.title: "予備の絵画"
	quest.42000000001502F5.quest_desc: [
		"浮島に防具一式を飾って見せる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F5.title: "防具立て"
	quest.42000000001502F6.quest_desc: [
		"飾ったアイテムを支え、決して暗くならない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F6.title: "輝く額縁"
	quest.42000000001502F7.quest_desc: [
		"緑のための植木鉢。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F7.title: "予備の植木鉢"
	quest.42000000001502F8.quest_desc: [
		"部屋のための吊り看板。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F8.title: "オークの吊り看板"
	quest.42000000001502F9.quest_desc: [
		"旗の作業のための織機。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502F9.title: "織機"
	quest.42000000001502FA.quest_desc: [
		"石を正確な形に切り、無駄がない。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502FA.title: "石切台"
	quest.42000000001502FB.quest_desc: [
		"道具を修理し、要らないエンチャントを剥がす。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502FB.title: "砥石"
	quest.42000000001502FC.quest_desc: [
		"鍛冶型とネザライトで装備を強化する。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502FC.title: "鍛冶台"
	quest.42000000001502FD.quest_desc: [
		"島の格子を描く。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502FD.title: "製図台"
	quest.42000000001502FE.quest_desc: [
		"村人の仕事場で、浮島ではほとんど飾り。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502FE.title: "矢細工台"
	quest.42000000001502FF.quest_desc: [
		"普通のかまどの二倍の速さで鉱石を精錬する。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.42000000001502FF.title: "予備の溶鉱炉"
	quest.4200000000150300.quest_desc: [
		"普通のかまどの二倍の速さで食べ物を調理する。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000150300.title: "予備の燻製器"
	quest.4200000000150301.quest_desc: [
		"水、染料、ポーションを少し入れる。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000150301.title: "大釜"
	quest.4200000000150302.quest_desc: [
		"下と上のコンテナのあいだでアイテムを自動で運ぶ。",
		"手順: 鉄五つをチェストの周りに。織機枠か張力の樽の下に置く（下へ抽出）。"
	]
	quest.4200000000150302.title: "予備のホッパー"
	quest.4200000000150303.quest_desc: [
		"装填したアイテムを撃つか、使う。",
		"手順: 丸石、弓、レッドストーン。"
	]
	quest.4200000000150303.title: "予備のディスペンサー"
	quest.4200000000150304.quest_desc: [
		"正面のブロックが変わると、レッドストーンを一拍送る。",
		"手順: 丸石、レッドストーン、ネザークォーツ。"
	]
	quest.4200000000150304.title: "予備のオブザーバー"
	quest.4200000000150305.quest_desc: [
		"一定で強いレッドストーン信号を、ブロックの形で。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000150305.title: "レッドストーンブロック"
	quest.4200000000150306.quest_desc: [
		"当たりの良さに応じた信号強度を送る。",
		"手順: 干し草の周りにレッドストーン。干し草は小麦三つ。"
	]
	quest.4200000000150306.title: "予備の的"
	quest.4200000000150307.quest_desc: [
		"叩くか動力を受けると、一音を鳴らす。手で調律する。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000150307.title: "予備の音符ブロック"
	quest.4200000000150308.quest_desc: [
		"浮島じゅうにレコードを鳴らす。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.4200000000150308.title: "予備のジュークボックス"
	quest.4200000000150309.quest_desc: [
		"鐘は Clowder を示す。",
		"手順: クラフトレシピはない。Occultism の野生の霊へ接触する儀式で一つできるが、ヤギが要る。ヤギは浮島まで来ない。任意。"
	]
	quest.4200000000150309.title: "予備の鐘"
	quest.420000000015030A.quest_desc: [
		"ネザーでのリスポーン地点を決め、グロウストーンで充電する。",
		"手順: 泣く黒曜石にグロウストーン。リスポーンはネザーだけ。"
	]
	quest.420000000015030A.title: "リスポーンアンカー"
	quest.420000000015030B.quest_desc: [
		"スポーン地点ではなく、このブロックそのものにコンパスを固定する。",
		"手順: 模様入りの石レンガの中にネザライトインゴット。Clowder の後期の贅沢。"
	]
	quest.420000000015030B.title: "予備のロードストーン"
	quest.420000000015030C.quest_desc: [
		"落雷を浮島から安全にそらす。",
		"手順: 作る、精錬する、ふるう、またはモブが落とす。JEI が浮島の入手元を全部出す。"
	]
	quest.420000000015030C.title: "予備の避雷針"
	quest.420000000015030D.quest_desc: [
		"どこへ行っても付いてくる、個人の保管場所。",
		"手順: エンダーアイの周りに黒曜石八つ。目はエンダーパールにブレイズパウダー。"
	]
	quest.420000000015030D.title: "エンダーチェスト"
	quest.420000000015030E.quest_desc: [
		"シュルカーボックスになり、重ねられて安全に保管できる。",
		"手順: パックのレシピ、プルプァブロック六つ、エンダーパール二つ、結束の結び一つ。シュルカーはここでは湧かない。任意。"
	]
	quest.420000000015030E.title: "シュルカーの殻"
	quest.420000000016030F.quest_desc: [
		"溶岩の上に建てる場所ならどこでも、床と壁になる。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: ここのネザーは虚空で、地形ではない。魔女の水が入った Ex Deorum の樽に溶岩を注ぐ（菌糸の上に置いた水樽。菌糸の胞子は土をふるって得る）。"
	]
	quest.420000000016030F.title: "ネザーラックの備蓄"
	quest.4200000000160310.quest_desc: [
		"石英で支えた焼成の泥岩。火のそばでも形を保つ。",
		"手順: ネザーラックを製錬し、それからネザーレンガのアイテムを四つ。"
	]
	quest.4200000000160310.title: "ネザーレンガ"
	quest.4200000000160311.quest_desc: [
		"ネザーウォートを焼いてレンガに。色はより暖かく、強さは同じ。",
		"手順: ネザーレンガにネザーウォート。爪のあとのネザー。"
	]
	quest.4200000000160311.title: "赤いネザーレンガ"
	quest.4200000000160312.quest_desc: [
		"冷めたマグマの柱を、足がかりのブロックに切ったもの。",
		"手順: 青氷のそばでソウルソイルの上を流れる溶岩、または砕いたブラックストーンをふるって得る玄武岩の小石四つ。"
	]
	quest.4200000000160312.title: "玄武岩"
	quest.4200000000160313.quest_desc: [
		"滑らかになるまで磨いた玄武岩。足場ではなく、石として読める。",
		"手順: 石切台、または玄武岩四つ。"
	]
	quest.4200000000160313.title: "磨かれた玄武岩"
	quest.4200000000160314.quest_desc: [
		"筋のない玄武岩。平らな床と縁取りに向く。",
		"手順: 玄武岩を製錬する。"
	]
	quest.4200000000160314.title: "滑らかな玄武岩"
	quest.4200000000160315.quest_desc: [
		"ネザーの丸石。道具とレンガのほうへクラフトする。",
		"手順: 魔女の水を溶岩の樽に注ぐか、黒石の小石を四つ。砦はこれで築かれている。"
	]
	quest.4200000000160315.title: "ブラックストーンの備蓄"
	quest.4200000000160316.quest_desc: [
		"近くの水を沸騰まで温め、素足を傷つける。",
		"手順: マグマクリーム四つ。溶岩の樽にスライムボールを入れるとクリームになる。"
	]
	quest.4200000000160316.title: "マグマブロック"
	quest.4200000000160317.quest_desc: [
		"足がかり用のソウルサンド備蓄。",
		"手順: 砂を、魔女の水入りの Ex Deorum の樽へ。要塞のネザーウォート部屋に少しある。ソウルサンドに頭蓋骨三つでウィザー。"
	]
	quest.4200000000160317.title: "ソウルサンドの備蓄"
	quest.4200000000160318.quest_desc: [
		"普通の炎の代わりに、ソウルファイアとソウルトーチを燃やす。",
		"手順: ソウルサンドを Ex Deorum の溶岩の樽に落とす。"
	]
	quest.4200000000160318.title: "ソウルソイル"
	quest.4200000000160319.quest_desc: [
		"粉四つに砕けるか、煙なしで部屋を照らす。",
		"手順: グロウストーンダスト四つ。粉はソウルサンドをふるって得る。"
	]
	quest.4200000000160319.title: "グロウストーン"
	quest.420000000016031A.quest_desc: [
		"ひとりでに光る菌。配線は要らない。",
		"手順: 巨大な菌に生える。ナイリウムに菌を植え、骨粉を与える。"
	]
	quest.420000000016031A.title: "シュルームライトの備蓄"
	quest.420000000016031B.quest_desc: [
		"ネザーウォートを九つ束ねたブロック。ほとんど装飾と染料。",
		"手順: ネザーウォート九つ。ウォートはソウルサンドをふるうか、要塞の庭で育つ。"
	]
	quest.420000000016031B.title: "ネザーウォートブロック"
	quest.420000000016031C.quest_desc: [
		"真紅のブロックの青い親戚。レシピは同じで、色はより冷たい。",
		"手順: 巨大な歪んだキノコに生える。歪んだナイリウムの上の歪んだキノコに骨粉を使う。"
	]
	quest.420000000016031C.title: "歪んだネザーウォートブロック"
	quest.420000000016031D.quest_desc: [
		"木ではない木。どの原木とも同じように皮を剥ぎ、板にする。",
		"手順: 真紅のナイリウムの胞子（砕いたネザーラックをふるう）をネザーラックの上に置き、ナイリウムに骨粉でキノコを出し、そのキノコに骨粉。"
	]
	quest.420000000016031D.title: "真紅の幹"
	quest.420000000016031E.quest_desc: [
		"もう一方の菌の幹。板は赤ではなく青になる。",
		"手順: 歪んだナイリウムの胞子（砕いたネザーラックをふるう）をネザーラックの上に置き、ナイリウムに骨粉でキノコを出し、そのキノコに骨粉。"
	]
	quest.420000000016031E.title: "歪んだ幹"
	quest.420000000016031F.quest_desc: [
		"吊るして飾る鎖。",
		"手順: 爪のあとの真紅の森。天井から垂れる。"
	]
	quest.420000000016031F.title: "しだれツタ"
	quest.4200000000160320.quest_desc: [
		"歪んだ森をよじ登り、霞の中に足場を印す。",
		"手順: 爪のあとの歪んだ森。ナイリウムから上へ伸びる。"
	]
	quest.4200000000160320.title: "ねじれツタ"
	quest.4200000000160321.quest_desc: [
		"紫の光を泣き、ネザーにリスポーン地点を据える。",
		"手順: 砦のチェスト、ピグリンとの物々交換、または黒曜石を働かせる Draconic のハチ。荒廃したポータルはここでは生成されない。"
	]
	quest.4200000000160321.title: "泣く黒曜石"
	quest.4200000000160322.quest_desc: [
		"普通の鉱石より下に埋まっている。ネザライトへ製錬する。",
		"手順: ハンマーでブラックストーンを砕いたブラックストーンにし、ふるう。砦のチェストに少し入っている。"
	]
	quest.4200000000160322.title: "古代の残骸"
	quest.4200000000160323.quest_desc: [
		"欠片四つと金のインゴット四つで、ネザライトインゴットが一つできる。",
		"手順: 古代の残骸を製錬する。欠片四つに金でインゴットになる。"
	]
	quest.4200000000160323.title: "ネザライトの欠片"
	quest.4200000000160324.quest_desc: [
		"Skybound の手が持つことになる、いちばん硬い金属。",
		"手順: 欠片四つに金四つ。残骸は爪のあとの希少なネザー。"
	]
	quest.4200000000160324.title: "ネザライトインゴット"
	quest.4200000000160325.quest_desc: [
		"醸造台と溶鉱炉、両方の燃料になる。予備に一スタック残しておく。",
		"手順: 爪の黒曜石のあと、ネザー要塞。醸造はロッドを求める；Ars と Occultism は待たない。"
	]
	quest.4200000000160325.title: "ブレイズロッドの備蓄"
	quest.4200000000160326.quest_desc: [
		"再生のポーションには一つ要る。ガストのそばでは、忍耐も。",
		"手順: 爪の黒曜石のあとのネザーのガスト。"
	]
	quest.4200000000160326.title: "ガストの涙"
	quest.4200000000160327.quest_desc: [
		"耐火に醸造するか、マグマブロックへ戻して作る。",
		"手順: スライムボールを溶岩の樽に落とす、スライムにブレイズパウダー、またはマグマキューブ。"
	]
	quest.4200000000160327.title: "マグマクリーム"
	quest.4200000000160328.quest_desc: [
		"三つでウィザーを召喚する。一つでも棚に飾れば映える。",
		"手順: 爪の黒曜石のあと、ネザー要塞。頭蓋骨三つでウィザーが始まる。"
	]
	quest.4200000000160328.title: "ウィザースケルトンの頭蓋骨"
	quest.4200000000160329.quest_desc: [
		"ピグリンは金と交換する。金塊もインゴットと同じように使える。",
		"手順: インゴット一つで九つ。またはネザー金鉱石。"
	]
	quest.4200000000160329.title: "金塊の山"
	quest.420000000016032A.quest_desc: [
		"精錬すると金になり、名の元の鉱石より速く掘れる。",
		"手順: Mekanism のコンバイナー、金の原石八つにネザーラック。虚ろなネザーには鉱石がない。"
	]
	quest.420000000016032A.title: "ネザー金鉱石"
	quest.420000000016032B.quest_desc: [
		"明るく白い石。建材にもなり、コンパレーターの信号も通す。",
		"手順: ソウルサンドをふるう。またはピグリンとの物々交換。"
	]
	quest.420000000016032B.title: "クォーツ"
	quest.420000000016032C.quest_desc: [
		"投げると火がつく。ディスペンサーに入れても、同じ。",
		"手順: ブレイズパウダー、石炭、火薬。"
	]
	quest.420000000016032C.title: "ファイヤーチャージ"
	quest.4200000000178001.quest_desc: [
		"ポータル枠十二は浮島のクラフトではない。だからエンドはひと噛み先にある。",
		"食べると、エンドの黒曜石の浮島に立つ。残った半分を食べると、食べた場所へ帰れる。",
		"手順: エンダーパール五つ、骨二つ、ブレイズパウダー二つを作業台で。"
	]
	quest.4200000000178001.title: "エンドリンゴ"
	quest.420000000017032D.quest_desc: [
		"向こう側の青白い石。重く、飾り気なく、尽きない。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: コーラスフルーツとエンダーパール（縁歩きの屋台）を結束の結びの周りに。八つできる。エンド島はもうない。"
	]
	quest.420000000017032D.title: "エンドストーン"
	quest.420000000017032E.quest_desc: [
		"正方形に切ったエンドストーン。エンドの浮島できれいな線に。",
		"手順: エンドストーンを四つ四角に、または石切台。エンドストーンは結びのクラフト。"
	]
	quest.420000000017032E.title: "エンドストーンレンガ"
	quest.420000000017032F.quest_desc: [
		"コーラスフルーツから育て、それから建材の石に焼く。",
		"手順: 焼いたコーラスフルーツ四つ。コーラスフルーツは縁歩きの屋台。"
	]
	quest.420000000017032F.title: "プルパーブロックの蓄え"
	quest.4200000000170330.quest_desc: [
		"柱模様のプルパー。置いた向きのまま。",
		"手順: プルパーのハーフブロック二つ、または石切台。まず焼いたコーラス。"
	]
	quest.4200000000170330.title: "プルパーの柱"
	quest.4200000000170331.quest_desc: [
		"決してちらつかない冷たい光。レールの支柱にもなる。",
		"手順: ブレイズロッドに焼いたコーラス。ネザーは爪のあと。コーラスは縁歩きの屋台。"
	]
	quest.4200000000170331.title: "エンドロッド"
	quest.4200000000170332.quest_desc: [
		"食べると、短く読めない距離だけテレポートする。",
		"手順: /clowder hub の縁歩きの屋台。外側のエンド島はもうない。"
	]
	quest.4200000000170332.title: "コーラスフルーツ"
	quest.4200000000170333.quest_desc: [
		"調理したコーラスフルーツ。あなたをテレポートせず、プルパーと染料になる。",
		"手順: 縁歩きの屋台のコーラスフルーツを精錬する。"
	]
	quest.4200000000170333.title: "焼いたコーラス"
	quest.4200000000170334.quest_desc: [
		"投げると着地点に着く。体力は少し減る。",
		"手順: エンダーマン、または /clowder hub の縁歩きの露店。"
	]
	quest.4200000000170334.title: "エンダーパールの蓄え"
	quest.4200000000170335.quest_desc: [
		"エンダーアイの蓄え。",
		"手順: エンダーパール（縁歩きの露店 / エンダーマン）と、爪の黒曜石のあとネザー要塞のブレイズパウダー。目八つの備蓄は任意。エンドクリスタルも同じクラフト。"
	]
	quest.4200000000170335.title: "エンダーアイの蓄え"
	quest.4200000000170336.quest_desc: [
		"ポーション用のドラゴンブレス。",
		"手順: ガラス瓶をドラゴンに。エンドの島はもうない。任意。"
	]
	quest.4200000000170336.title: "ドラゴンブレスの蓄え"
	quest.4200000000170337.quest_desc: [
		"ドラゴンの唯一のトロフィー。クリックすると決してじっとしていない。",
		"まれな報酬：Clowder の共有ライフ一つ、チーム全体で一度きり。こうした報酬はキャンペーンに六つしかない。",
		"手順: ドラゴンはエンド島と一緒にいない。任意のトロフィー。エンダーチェストは塞がない。"
	]
	quest.4200000000170337.title: "ドラゴンエッグ展示"
	quest.4200000000170338.quest_desc: [
		"空を行くためのエリトラ。",
		"任意。虚空は一度も出さないかもしれない。",
		"手順: エンドシティはもうない。任意。"
	]
	quest.4200000000170338.title: "エリトラ展示"
	quest.4200000000170339.quest_desc: [
		"箱のためのシュルカーの殻。",
		"任意。ここにはシュルカーがいないので、パックが殻を作る。",
		"手順: パックのレシピ、プルプァブロック六つ、エンダーパール二つ、結束の結び一つ。シュルカーはここでは湧かない。任意。"
	]
	quest.4200000000170339.title: "シュルカーの殻の蓄え"
	quest.420000000017033A.quest_desc: [
		"壊しても中身が残る、持ち運べるチェスト。",
		"任意。Clowder ホールの縁歩きが一つ売る。",
		"手順: チェストの周りにシュルカーの殻二つ（殻はパックのレシピ）、または /clowder hub の縁歩きの屋台で糸のかせ 22（糸 198）。任意。"
	]
	quest.420000000017033A.title: "シュルカーボックス展示"
	quest.420000000017033B.quest_desc: [
		"エンドクリスタル。そっと扱う。",
		"手順: ガラス、エンダーアイ、ガストの涙。ネザーは爪の黒曜石のあと。卵は任意。"
	]
	quest.420000000017033B.title: "エンドクリスタル展示"
	quest.420000000017033C.quest_desc: [
		"どの浮島のエンダーチェストも、隠れた倉庫を一つ共有する。",
		"手順: エンダーアイの周りに黒曜石八つ。目はエンダーパールにブレイズパウダー。"
	]
	quest.420000000017033C.title: "エンダーチェストの披露"
	quest.420000000017033D.quest_desc: [
		"エンドストーンに植えると、コーラスフルーツが上へ育つ。",
		"手順: エンドの外島はもうない。コーラスフルーツは縁歩きの露店にある。任意。"
	]
	quest.420000000017033D.title: "コーラスフラワー"
	quest.420000000017033E.quest_desc: [
		"これを十二個、目で満たすと、エンドへの道が開く。",
		"手順: 浮島でのクラフトではない。任意。"
	]
	quest.420000000017033E.title: "エンドポータルの枠"
	quest.420000000017033F.quest_desc: [
		"固まったコンクリートパウダー。虚空のように暗く、固まればずっと残る。",
		"手順: コンクリートパウダーに水。パウダーは砂と砂利と染料。"
	]
	quest.420000000017033F.title: "黒色のコンクリート"
	quest.4200000000170340.quest_desc: [
		"静かで淡いバイオームに映える、派手な差し色。",
		"手順: コンクリートパウダーに水。パウダーは砂と砂利と染料。"
	]
	quest.4200000000170340.title: "紫色のコンクリート"
	quest.4200000000170341.quest_desc: [
		"水に触れて冷えた溶岩。爆発に強く、掘るのは遅い。",
		"手順: 溶岩源に水を（または水に溶岩を）。溶岩源は残す。"
	]
	quest.4200000000170341.title: "黒曜石の蓄え"
	quest.4200000000170342.quest_desc: [
		"かすかに光り、チャージするとリスポーンアンカーから飛ばす。",
		"手順: 砦のチェスト、ピグリンとの物々交換、または黒曜石を働かせる Draconic のハチ。荒廃したポータルはここでは生成されない。"
	]
	quest.4200000000170342.title: "泣く黒曜石の蓄え"
	quest.4200000000170343.quest_desc: [
		"グロウストーンでチャージし、ネザーのリスポーン地点を決める。",
		"手順: 泣く黒曜石にグロウストーン。リスポーンはネザーだけ。"
	]
	quest.4200000000170343.title: "リスポーンアンカーの披露"
	quest.4200000000170344.quest_desc: [
		"オフハンドに持つと、本来は致命の一撃を一度だけ無効にする。",
		"手順: クエスト報酬だけ。「時計を据える」と「印を据える」が一つずつくれ、後のストランドの結びの贈り物はさらに出す。襲撃とエヴォーカーは浮島に来ない。任意。"
	]
	quest.4200000000170344.title: "トーテムの披露"
	quest.4200000000170345.quest_desc: [
		"ウィザーが落とす唯一のもの。ビーコンは一つないと灯らない。",
		"手順: ウィザー（ソウルサンドに頭蓋骨三つ）、または /clowder hub の太鼓の心臓の屋台で一度、糸の反 12（糸 972）。任意のトロフィー。エンドもモブ農場の 100% も塞がない。"
	]
	quest.4200000000170345.title: "ネザースターの披露"
	quest.4200000000170346.quest_desc: [
		"鉱物ブロックのピラミッドで動き、範囲に立っている間バフを与える。",
		"手順: ネザースター、ガラス、黒曜石。任意のトロフィー — 海の枝は黒曜石の蓄えからぶら下がる。"
	]
	quest.4200000000170346.title: "ビーコンの披露"
	quest.4200000000170347.quest_desc: [
		"プリズマリンに囲まれると、水中で水中呼吸と採掘速度上昇を与える。",
		"任意。虚空は一度も出さないかもしれない。",
		"手順: 海洋の心とオウムガイが要る。海だけ。任意。"
	]
	quest.4200000000170347.title: "コンジットの披露"
	quest.4200000000170348.quest_desc: [
		"八個はコンジットを囲み、一個は海のコンパスになる。",
		"任意。虚空は一度も出さないかもしれない。",
		"手順: 海だけ。任意。"
	]
	quest.4200000000170348.title: "オウムガイの殻"
	quest.4200000000170349.quest_desc: [
		"ドラウンドのレアドロップ。投げるか、嵐の中で雷を導く。",
		"手順: ドラウンドだけ。任意。"
	]
	quest.4200000000170349.title: "トライデントの披露"
	quest.420000000018034A.quest_desc: [
		"基礎エッセンス。成長加速器にも再処理機にも等しく入る。",
		"九つの部族が次の Clowder のために物資を残した。執事の蔵で無作為の物資を開けるか、小さな蔵四つを中くらいに、中くらい三つを大きな蔵に作る。大きな封印ほど抽選が多く物資の幅も広く、別々に開けると基本の物資は増える。中に機械も進行の証も隠れていないが、どの封印にも糸の欠片の小さな確率と帰還の糸一本のごく小さな確率があり、大きな封印ほど当たりやすい。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000018034A.title: "Inferium の蓄え"
	quest.420000000018034B.quest_desc: [
		"未完成の種。エッセンスがないと何も育たない。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000018034B.title: "Prosperity の土台"
	quest.420000000018034C.quest_desc: [
		"一度消費すると、エッセンスを次の段階へ上げる。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000018034C.title: "注入のクリスタル"
	quest.420000000018034D.quest_desc: [
		"第二段階のエッセンス。Inferium のスタックから精製する。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000018034D.title: "Prudentium の蓄え"
	quest.420000000018034E.quest_desc: [
		"第三段階のエッセンス。Prudentium の一段上。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000018034E.title: "Tertium の蓄え"
	quest.420000000018034F.quest_desc: [
		"第四段階のエッセンス。鎖の上部に近い。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.420000000018034F.title: "Imperium の蓄え"
	quest.4200000000180350.quest_desc: [
		"第五段階のエッセンス。精製はほぼ限界。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000180350.title: "Supremium の蓄え"
	quest.4200000000180351.quest_desc: [
		"精製の頂点。最強の装備と種に必要。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000180351.title: "覚醒したエッセンス"
	quest.4200000000180352.quest_desc: [
		"エッセンスを最終形態へ覚醒させる中心の品。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000180352.title: "覚醒の祭壇"
	quest.4200000000180353.quest_desc: [
		"これらで祭壇を囲み、覚醒を終える。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000180353.title: "覚醒の台座"
	quest.4200000000180354.quest_desc: [
		"チャージが尽きない注入クリスタル。",
		"手順: JEI で Mystical Agriculture を作る。Inferium と Prosperity はふるいから。種は注入の祭壇で染み込ませる。"
	]
	quest.4200000000180354.title: "マスタークリスタル"
	quest.4200000000180355.quest_desc: [
		"エッセンスをまとめて蓄え、機械が枯れないようにする。",
