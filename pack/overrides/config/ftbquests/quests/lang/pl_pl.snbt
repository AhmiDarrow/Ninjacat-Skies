{
	chapter.3100000000000001.chapter_subtitle: [
		"Obudź się — przetrwaj, przejmij platformę, niech Kodeks się obudzi."
	]
	chapter.3100000000000001.title: "Nić: Gleba"
	chapter.3100000000000002.chapter_subtitle: [
		"Odzyskaj — ściągnij upadły świat z powrotem w materię."
	]
	chapter.3100000000000002.title: "Nić: Kamień"
	chapter.3100000000000003.chapter_subtitle: [
		"Zakorzeń — wyhoduj kotwice, żeby platforma przestała się strzępić."
	]
	chapter.3100000000000003.title: "Nić: Kiełek"
	chapter.3100000000000004.chapter_subtitle: [
		"Krawędź — zbierz sprzęt i zejdź z platformy celowo."
	]
	chapter.3100000000000004.title: "Nić: Pazur"
	chapter.3100000000000005.chapter_subtitle: [
		"Brzęcz — rytm i puls przed drutami."
	]
	chapter.3100000000000005.title: "Nić: Iskra"
	chapter.3100000000000006.chapter_subtitle: [
		"Wzór — fabryka jak pieśń, która niesie się sama."
	]
	chapter.3100000000000006.title: "Nić: Zegar"
	chapter.3100000000000007.chapter_subtitle: [
		"Kolonia — utrzymaj przy życiu coś, co trzyma przy życiu coś jeszcze."
	]
	chapter.3100000000000007.title: "Nić: Rój"
	chapter.3100000000000008.chapter_subtitle: [
		"Zwiąż — pieczęcie, obrzędy i dwie ścieżki splotu w jednym sznurze."
	]
	chapter.3100000000000008.title: "Nić: Pieczęć"
	chapter.3100000000000009.chapter_subtitle: [
		"Przetkaj — cyfrowe krosno, Marchia, Fragment."
	]
	chapter.3100000000000009.title: "Nić: Wrzeciono"
	chapter.310000000000000A.title: "Głębokie sito"
	chapter.310000000000000B.title: "Magazyn i plecaki"
	chapter.310000000000000C.title: "Zakłady Mekanism"
	chapter.310000000000000D.title: "Sieć Powah"
	chapter.310000000000000E.title: "Strona arkany"
	chapter.310000000000000F.chapter_subtitle: [
		"Drużyny, Sala, Słup i Strzęp."
	]
	chapter.310000000000000F.title: "Sala Clowder"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Linia kuchenna"
	chapter.3100000000000013.title: "Zaklęcia walki"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Wystrój platformy"
	chapter.3100000000000016.title: "Przyczółek Netheru"
	chapter.3100000000000017.title: "Przyczółek Endu"
	chapter.3100000000000018.title: "Pola esencji"
	chapter.3100000000000019.chapter_subtitle: [
		"Każde gniazdo to pierścień czegoś wokół kwiatu."
	]
	chapter.3100000000000019.title: "Pasieka Roju"
	chapter.310000000000001A.title: "Rurociągi"
	chapter.310000000000001B.title: "Inny świat"
	chapter.310000000000001C.title: "Głębokie mechanizmy zegara"
	chapter.310000000000001D.title: "Sieć Wrzeciona"
	chapter.310000000000001E.title: "Rzemiosło Pustki"
	chapter.310000000000001F.title: "Pakowane linie"
	chapter.3100000000000020.title: "QIO i szczyt Mek"
	chapter.3100000000000021.title: "Łowy i farma"
	chapter.3100000000000022.title: "Plemienny splot"
	chapter.3100000000000023.chapter_subtitle: [
		"Śpiewacy żwiru tną jeden kamień na sto sposobów."
	]
	chapter.3100000000000023.title: "Kamieniarz"
	chapter.3100000000000024.chapter_subtitle: [
		"Platforma to tylko półka, dopóki ktoś nie postawi na niej krzesła."
	]
	chapter.3100000000000024.title: "Wyposażenie"
	chapter.3100000000000025.chapter_subtitle: [
		"Małe maszyny, które zostawili zarządcy."
	]
	chapter.3100000000000025.title: "Małe zarządy"
	chapter.3100000000000026.chapter_subtitle: [
		"Puls Bębnoserc uczy się biec w miedzi."
	]
	chapter.3100000000000026.title: "Prąd"
	chapter.3100000000000027.chapter_subtitle: [
		"Cięcie zerwało trzynastu strażników. Napnij na nowo każdą Nić, pokonując jej strażnika."
	]
	chapter.3100000000000027.title: "Zerwani strażnicy"
	chapter.3100000000000028.chapter_subtitle: [
		"Przejdź Marchię. Oswój żółtego. Esther czeka w Sali, gdy już tam byłeś."
	]
	chapter.3100000000000028.title: "Biegacze platformy"
	chapter.3100000000000029.chapter_subtitle: [
		"Ogrody z sita. Ugotuj to, czego platforma pustki nigdy nie urosła."
	]
	chapter.3100000000000029.title: "Stół plonów"
	chapter.310000000000002A.chapter_subtitle: [
		"Patyki upraw, statystyki, nawadnianie. Na występie chwasty się nie trzymają."
	]
	chapter.310000000000002A.title: "Patyki upraw"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Wytwarzanie i napięcie"
	chapter_group.2100000000000003.title: "Przetkać"
	chapter_group.2100000000000004.title: "Boczne ścieżki"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"Obudziłeś się na występie. Spójrz w przepaść, potem kliknij tutaj.",
		"Grawis (`) to lista zadań. Kodeks Wąsów to Zacznij tutaj.",
		"Jak: kliknij zadanie. Potem uderz dąb."
	]
	quest.4200000000018001.title: "Spójrz w przepaść"
	quest.4200000000010001.quest_desc: [
		"Jesteś Skybound. To jest to, co nie spadło.",
		"Osiem kłód. Zacznij od drzewa; to ono zaczęło od ciebie.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: uderz dąb na swojej platformie. Osiem kłód zaczyna Przebudzenie."
	]
	quest.4200000000010001.title: "Przebudzenie na platformie"
	quest.4200000000010002.quest_desc: [
		"Ziemia to obietnica, którą platforma składa twoim butom.",
		"Szesnaście bloków. Poszerz obietnicę.",
		"Jak: skrzynia startowa, spust bruk+nić, resztki sita albo /clowder hub (Strażnicy platformy)."
	]
	quest.4200000000010002.title: "Coś pod stopami"
	quest.4200000000010003.quest_desc: [
		"Dłonie potrzebują powierzchni. Wszystko potem też jest powierzchnią.",
		"Jak: cztery deski w kwadrat."
	]
	quest.4200000000010003.title: "Zrób stół warsztatowy"
	quest.4200000000010004.quest_desc: [
		"Pazur przyjdzie później. Na razie drewno, które gryzie.",
		"Jak: trzy deski nad dwoma patykami."
	]
	quest.4200000000010004.title: "Drewniany kilof"
	quest.4200000000010005.quest_desc: [
		"Zieleń na tle przepaści.",
		"Zasadź go, zanim zgłodniejesz.",
		"Jak: zniszcz liście dębu albo /clowder hub Wiązacze korzeni (8 Nić za cztery)."
	]
	quest.4200000000010005.title: "Pierwsza sadzonka"
	quest.4200000000010006.quest_desc: [
		"Sześćdziesiąt cztery deski to platforma, która przestaje przypominać występ.",
		"Jak: jedna kłoda w siatce wytwarzania daje cztery."
	]
	quest.4200000000010006.title: "Zapas desek"
	quest.4200000000010007.quest_desc: [
		"Trzonki, ramy, kości narzędzi.",
		"Jak: dwie deski w kolumnie."
	]
	quest.4200000000010007.title: "Pęk patyków"
	quest.4200000000010008.quest_desc: [
		"Kładź rzeczy tam, gdzie zostaną. Clowder dzieli skrzynię, zanim podzieli cokolwiek innego.",
		"Jak: osiem desek wokół pustego środka."
	]
	quest.4200000000010008.title: "Skrzynia dla Clowder"
	quest.4200000000010009.quest_desc: [
		"Zobacz krawędź, zanim krawędź zobaczy ciebie.",
		"Jak: węgiel albo węgiel drzewny nad patykiem. Krewni w /clowder hub sprzedają paczkę."
	]
	quest.4200000000010009.title: "Linia pochodni"
	quest.420000000001000A.quest_desc: [
		"Lód i lawa robią kamień tam, gdzie go nie było.",
		"Platformy Normalny i Trudny przywożą oba. Strażnicy platformy w /clowder hub sprzedają wiadro.",
		"Jak: lawa obok wody (albo topniejący lód). Uderz kamień młotem. Stragan Śpiewaków żwiru w /clowder hub sprzedaje wiązkę."
	]
	quest.420000000001000A.title: "Zapas bruku"
	quest.420000000001000B.quest_desc: [
		"Ciepło, które jeszcze nie jest Iskrą.",
		"Strażnicy platformy nazwaliby to paleniskiem.",
		"Jak: osiem sztuk bruku wokół pustego środka."
	]
	quest.420000000001000B.title: "Żar pieca"
	quest.420000000001000C.quest_desc: [
		"Głód to miękka pustka. Osiem bochenków zamyka ją na chwilę.",
		"Jak: trzy pszenice w rzędzie albo /clowder hub Strażnik paleniska."
	]
	quest.420000000001000C.title: "Ugotuj posiłek"
	quest.420000000001000D.quest_desc: [
		"Postaw lawę, stop lód w źródło, napełnij wiadro.",
		"Łatwy przywozi wodę; Normalny i Trudny przywożą kawałki.",
		"Jak: puste wiadro na źródło wody. Normalny/Trudny: postaw lawę, stop lód, napełnij."
	]
	quest.420000000001000D.title: "Złap deszcz"
	quest.420000000001000E.quest_desc: [
		"Skrawki Krosna, które jeszcze trzymają. Każde zadanie oddaje trochę.",
		"Rozpleć jedną na sznurek albo wydaj je na straganach krewnych w /clowder hub.",
		"Jak: nagrody z zadań, ziemia z krzemienną siatką na Ramie krosna, skrytki zarządcy."
	]
	quest.420000000001000E.title: "Wystrzępiona waluta"
	quest.420000000001000F.quest_desc: [
		"Uszkodzony, ale wciąż uczy. Otwórz Zacznij tutaj.",
		"Prawy przycisk na książkę i otwórz Zacznij tutaj. Grawis (`): lista zadań.",
		"Jak: zestaw startowy / skrzynia doku. Prawy przycisk na książkę; grawis (`) to lista zadań."
	]
	quest.420000000001000F.title: "Kodeks w dłoni"
	quest.4200000000010010.quest_desc: [
		"Ustaw punkt odrodzenia.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010010.title: "Łóżko punktu"
	quest.4200000000010011.quest_desc: [
		"Schodź w głąb bez liny. Tania na tyle, by zostawić ją w każdym szybie.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010011.title: "Drabina w dół"
	quest.4200000000010012.quest_desc: [
		"Pajęczy jedwab odłożony na późniejsze siatki. Każde włókno kiedyś się przyda.",
		"Jak: rozpruj Wystrzępioną nić (1 → 3). Pająki. Meszek krosna przy Echo-wiązaniu. Odwrotny upust przędzy."
	]
	quest.4200000000010012.title: "Zapas sznurka"
	quest.4200000000010013.quest_desc: [
		"Przyspiesz zieleń.",
		"Jak: kości w kratce, albo upust Nić + zgniłe mięso, lub /clowder hub Strażnicy platformy."
	]
	quest.4200000000010013.title: "Zapas mączki kostnej"
	quest.4200000000010014.quest_desc: [
		"Poszerz platformę.",
		"Jak: skrzynia startowa, spust bruk+nić, resztki sita albo /clowder hub (Strażnicy platformy)."
	]
	quest.4200000000010014.title: "Ziemna platforma"
	quest.4200000000010015.quest_desc: [
		"Przytnij je teraz, kompostuj później. Na platformie nic się nie marnuje.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010015.title: "Liście dębu"
	quest.4200000000010016.quest_desc: [
		"Cichy kącik.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010016.title: "Doniczka"
	quest.4200000000010017.quest_desc: [
		"Beczka Ex Deorum: kompost i woda w glinę, powoli.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010017.title: "Beczka"
	quest.4200000000010018.quest_desc: [
		"Odpad w mączkę.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010018.title: "Kompostownik"
	quest.4200000000010019.quest_desc: [
		"Wydrap bruzdę.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010019.title: "Drewniana motyka"
	quest.420000000001001A.quest_desc: [
		"Ścina kłody szybciej niż gołe ręce. Pierwsze prawdziwe narzędzie, jakie ma Skybound.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001001A.title: "Drewniana siekiera"
	quest.420000000001001B.quest_desc: [
		"Zamienia ziemię i żwir w oczyszczony grunt. Wolna, ale działa.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001001B.title: "Drewniana łopata"
	quest.420000000001001C.quest_desc: [
		"Ledwo zatrzymuje zombie, ale zatrzymuje. Lepiej niż machać pięścią.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001001C.title: "Drewniany miecz"
	quest.420000000001001D.quest_desc: [
		"Pomieści zupę, gulasz i niewiele więcej. Prosta zastawa na prostą platformę.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001001D.title: "Miska"
	quest.420000000001001E.quest_desc: [
		"Oznacz platformę.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001001E.title: "Ramka"
	quest.420000000001001F.quest_desc: [
		"Zrób z tego dom.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001001F.title: "Obraz"
	quest.4200000000010020.quest_desc: [
		"Trzyma wiatr i potwory po właściwej stronie ściany.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010020.title: "Dębowe drzwi"
	quest.4200000000010021.quest_desc: [
		"Znaczy krawędź, nie zasłaniając widoku. Przydaje się tam, gdzie upadek jest prawdziwy.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010021.title: "Dębowy płot"
	quest.4200000000010022.quest_desc: [
		"Zamienia stromą ścianę w coś, po czym da się wejść.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010022.title: "Dębowe schody"
	quest.4200000000010023.quest_desc: [
		"Pół bloku, dwa razy więcej opcji podłogi. Przydatna w ciasnych miejscach.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010023.title: "Dębowa płyta"
	quest.4200000000010024.quest_desc: [
		"Klapy dostępu.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010024.title: "Dębowa klapa"
	quest.4200000000010025.quest_desc: [
		"Wysyła sygnał, gdy coś na nią nadepnie. Drzwi otwierają się same.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010025.title: "Dębowa płyta naciskowa"
	quest.4200000000010026.quest_desc: [
		"Przycisk do impulsów redstone.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010026.title: "Dębowy przycisk"
	quest.4200000000010027.quest_desc: [
		"Ogrodź krawędź platformy.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010027.title: "Furtka z patyków"
	quest.4200000000010028.quest_desc: [
		"Gotuje powoli, a dym widać na mile.",
		"Jak: kłody, patyki oraz węgiel albo węgiel drzewny."
	]
	quest.4200000000010028.title: "Ognisko"
	quest.4200000000010029.quest_desc: [
		"Wiesza światło tam, gdzie pochodnia wyglądałaby źle. Cieplejszy blask, ta sama robota.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010029.title: "Latarnia"
	quest.420000000001002A.quest_desc: [
		"Pali się bladoniebiesko i nie pozwala większości rzeczy pojawiać się w pobliżu.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001002A.title: "Latarnia dusz"
	quest.420000000001002B.quest_desc: [
		"Wspina się z tobą i znika, gdy pociągniesz. Budowanie wysoko przestaje straszyć.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001002B.title: "Rusztowanie"
	quest.420000000001002C.quest_desc: [
		"Łańcuch na wiszący akcent.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001002C.title: "Łańcuch"
	quest.420000000001002D.quest_desc: [
		"Zakratuj krawędź.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001002D.title: "Żelazne kraty"
	quest.420000000001002E.quest_desc: [
		"Szkło na okna platformy.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001002E.title: "Szyba"
	quest.420000000001002F.quest_desc: [
		"Miękka, łatwopalna i łatwa do farbowania. Każda platforma w końcu potrzebuje łóżka.",
		"Jak: ostrzyż owce po daniu trawy albo cztery sznurki."
	]
	quest.420000000001002F.title: "Biała wełna"
	quest.4200000000010030.quest_desc: [
		"Cienka warstwa wełny na podłogi, które nie potrzebują całego bloku.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010030.title: "Biały dywan"
	quest.4200000000010031.quest_desc: [
		"Wnosi trochę zieleni i różu na platformę z żwiru.",
		"Jak: mech plus dąb albo mączka kostna na mech. Pszczoły przyjmują kwiat."
	]
	quest.4200000000010031.title: "Kwitnąca azalia"
	quest.4200000000010032.quest_desc: [
		"Rozrasta się powoli i łagodzi wygląd surowych kamiennych platform.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010032.title: "Blok mchu"
	quest.4200000000010033.quest_desc: [
		"Wiszące korzenie pod platformą.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010033.title: "Wiszące korzenie"
	quest.4200000000010034.quest_desc: [
		"Przywiera do ścian i oświetla je bez ani jednej pochodni.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010034.title: "Świecący porost"
	quest.4200000000010035.quest_desc: [
		"Naciek na spiczasty akcent.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010035.title: "Spiczasty naciek"
	quest.4200000000010036.quest_desc: [
		"Ametyst w bloku. Pieczęć zechce odłamków później.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010036.title: "Blok ametystu"
	quest.4200000000010037.quest_desc: [
		"Dziewięć sztabek ściśniętych razem. Zielenieje, jeśli zostawisz na zewnątrz.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010037.title: "Blok miedzi"
	quest.4200000000010038.quest_desc: [
		"Dziewięć kawałków surowego żelaza ściśniętych razem, czekają na piec.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010038.title: "Blok surowego żelaza"
	quest.4200000000010039.quest_desc: [
		"Pali się dużo dłużej niż luźny węgiel. Nakarm piec i odejdź.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000010039.title: "Blok węgla"
	quest.420000000001003A.quest_desc: [
		"Karmi zwierzęta i hamuje upadek. Rolnicy trzymają go blisko z obu powodów.",
		"Jak: dziewięć pszenicy. Trzy pszenice dają też chleb."
	]
	quest.420000000001003A.title: "Blok siana"
	quest.420000000001003B.quest_desc: [
		"Dziewięć wodorostów sprasowanych w paliwo. Wytapia więcej, niż na to wygląda.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001003B.title: "Blok suszonych wodorostów"
	quest.420000000001003C.quest_desc: [
		"Papier i skóra czekają, aż staną się czymś z przepisem.",
		"Jak: trzy papiery plus skóra. Papier to trzcina cukrowa."
	]
	quest.420000000001003C.title: "Książka"
	quest.420000000001003D.quest_desc: [
		"Papier na książki i mapy.",
		"Jak: trzy trzciny cukrowe w rzędzie. Trzcina bierze się z przesiewania ziemi krzemienną siatką lub lepszą."
	]
	quest.420000000001003D.title: "Papier"
	quest.420000000001003E.quest_desc: [
		"Barwnik i książki potrzebują atramentu.",
		"Jak: węgiel drzewny plus szklana butelka. Kałamarnice nigdy się tu nie pojawiają."
	]
	quest.420000000001003E.title: "Worek z atramentem"
	quest.420000000001003F.quest_desc: [
		"Pióra do strzał i książek.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000001003F.title: "Pióro"
	quest.4200000000010040.quest_desc: [
		"Skóra do książek i zestawów.",
		"Jak: przetop zgniłe mięso albo upiecz je na ognisku. Przesiej ziemię krzemienną siatką. /clowder hub Strażnicy platformy sprzedają dwie za 18 Nić."
	]
	quest.4200000000010040.title: "Skóra"
	quest.4200000000010041.quest_desc: [
		"Warsztat, sadzonka, palenisko, woda, Kodeks. Platforma trzyma.",
		"Napnij Nić: Strażnicy platformy odpowiadają, a żeton jest twój do osadzenia.",
		"Odbierz i wybierz jeden dar plemienia: Nić Powrotu na jeszcze jedno wspólne życie albo zapasy.",
		"Jak: ukończ zadania powiązane z tym, potem odbierz je za żeton Nici. Osadź żeton na swoim Słupie napięcia."
	]
	quest.4200000000010041.quest_subtitle: "Przebudzenie"
	quest.4200000000010041.title: "Węzeł Gleby"
	quest.4200000000010042.quest_desc: [
		"Prawy przycisk żetonem na Słup napięcia swojego Clowder.",
		"Karb się zapala, plemię dźwięczy, platforma się zmienia.",
		"Jak: prawy przycisk na swój Słup napięcia z żetonem Nici w ręku."
	]
	quest.4200000000010042.title: "Osadź Glebę"
	quest.4200000000010043.quest_desc: [
		"Zombie na platformie bez jaskiń. Pustka przesyła pozdrowienia.",
		"Oświetl krawędzie.",
		"Jak: zabij zombie na platformie w nocy. Oświetl krawędzie."
	]
	quest.4200000000010043.title: "Coś wyszło"
	quest.4200000000020044.quest_desc: [
		"Nić, która pamięta, skąd przyszła.",
		"Rozpruj Nić w sznurek; cztery sznurki przędą dwie przędze.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: cztery sznurki → dwie przędze. Beczka napięcia: sznurek + perła. Cztery Meszki krosna."
	]
	quest.4200000000020044.title: "Wyciągnij Przędzę Pustki"
	quest.4200000000020045.quest_desc: [
		"Bruk i patyki. Rozbij spadły grys na żwir, piasek i pył.",
		"Jak: bruk + patyki. Rozbij grys na żwir, piasek i pył."
	]
	quest.4200000000020045.title: "Młot wrzeciona"
	quest.4200000000020046.quest_desc: [
		"Sznurek wokół przędzy. Łapie to, co upuściło Krosno — i wyczesuje Meszek krosna z ziemi.",
		"Jak: sznurek wokół przędzy. Stragan Śpiewaków żwiru sprzedaje jedną."
	]
	quest.4200000000020046.title: "Nawlecz siatkę"
	quest.4200000000020047.quest_desc: [
		"Wlej wodę; wiadro wraca od razu. Dodaj ziemię. Czekaj na glinę.",
		"Sznurek i perła w tej samej beczce dają przędzę.",
		"Jak: deski, sznurek i Przędza Pustki. Wlej wodę (wiadro wraca), dodaj ziemię → glina."
	]
	quest.4200000000020047.title: "Beczka napięcia"
	quest.4200000000020048.quest_desc: [
		"Szesnaście gliny z beczki. Ładuj osiem ziemi naraz.",
		"Jak: Beczka napięcia — woda + ziemia. Echołamacz młotkuje piasek w glinę."
	]
	quest.4200000000020048.title: "Kieszeń gliny"
	quest.4200000000020049.quest_desc: [
		"Glina i mączka kostna. Uformuj niewypalane wiadro.",
		"Jak: kulka gliny + mączka kostna, bez kształtu. Glina pochodzi z Beczki napięcia."
	]
	quest.4200000000020049.title: "Glina porcelanowa"
	quest.420000000002004A.quest_desc: [
		"Przetop to. Porcelana niesie lawę tam, gdzie żelazo wciąż jest plotką.",
		"Jak: uformuj z gliny porcelanowej niewypalane wiadro, potem je przetop."
	]
	quest.420000000002004A.title: "Porcelanowe narzędzie"
	quest.420000000002004B.quest_desc: [
		"Śpiewacy żwiru nazywali każdy odłamek od jego echa.",
		"Siej, aż usłyszysz żelazo.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.420000000002004B.title: "Przesiej spadły grys"
	quest.420000000002004C.quest_desc: [
		"Zapasowy zestaw uderzeń.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.420000000002004C.title: "Drewniany młot"
	quest.420000000002004D.quest_desc: [
		"Materia z grysu. Sześćdziesiąt cztery kamienie, które godzinę temu były pyłem.",
		"Jak: lawa obok wody (albo topniejący lód). Uderz kamień młotem. Stragan Śpiewaków żwiru w /clowder hub sprzedaje wiązkę."
	]
	quest.420000000002004D.title: "Kamyki"
	quest.420000000002004E.quest_desc: [
		"Pył Krosna czeka w żwirze. Krzemień też.",
		"Jak: młotkuj bruk (Młot wrzeciona albo Echołamacz)."
	]
	quest.420000000002004E.title: "Żwirowa ścieżka"
	quest.420000000002004F.quest_desc: [
		"Drobny grys. Szkło później i najlepszy połów żelaznej siatki.",
		"Jak: młotkuj żwir."
	]
	quest.420000000002004F.title: "Zapas piasku"
	quest.4200000000020050.quest_desc: [
		"Popiół upadłego świata. Redstone i proch kryją się w nim.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.4200000000020050.title: "Sterta pyłu"
	quest.4200000000020051.quest_desc: [
		"Przędza wokół szlamu. Kompost platformy robi szlam.",
		"Węzeł to miękka brama Krosna; zostaw dwa.",
		"Jak: pierścień Przędzy Pustki wokół kulki szlamu."
	]
	quest.4200000000020051.title: "Zawiąż Węzeł wiążący"
	quest.4200000000020052.quest_desc: [
		"Deski wokół Węzła. Naciągnij siatkę, załaduj grys i niech pracuje.",
		"Leje ją karmią. To pierwsza maszyna platformy.",
		"Jak: deski wokół Węzła wiążącego. Naciągnij siatkę, podaj grys lejem i postaw ją na leju."
	]
	quest.4200000000020052.title: "Wznieś Ramę krosna"
	quest.4200000000020053.quest_desc: [
		"Żelazo jest niskie i cierpliwe. Osiem bryłek z siatki.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.4200000000020053.title: "Bryłka rudy żelaza"
	quest.4200000000020054.quest_desc: [
		"Przesiany ze żwiru, po trochu. Siatka znajduje miedź wcześniej niż twoje oczy.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.4200000000020054.title: "Bryłka rudy miedzi"
	quest.4200000000020055.quest_desc: [
		"Złoto ledwo się fatyguje, żeby odpowiedzieć. Cztery wystarczą.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.4200000000020055.title: "Bryłka rudy złota"
	quest.4200000000020056.quest_desc: [
		"Zasil linię.",
		"Jak: przesiej żwir albo przetop rudę węgla."
	]
	quest.4200000000020056.title: "Węgiel"
	quest.4200000000020057.quest_desc: [
		"Z bryłek w surowiec. Przetapiaj dalej.",
		"Jak: przesiej żwir na bryłki rudy żelaza; cztery dają blok rudy żelaza, a kopanie go daje surowe żelazo."
	]
	quest.4200000000020057.title: "Surowe żelazo"
	quest.4200000000020058.quest_desc: [
		"Odzysk wypłaca. Szesnaście sztabek, których pustka nie chciała ci dać.",
		"Jak: przetop surowe żelazo / grys żelaza (piec albo Piec żaru). Przesiej żwir po kawałki."
	]
	quest.4200000000020058.title: "Sztabka żelaza"
	quest.4200000000020059.quest_desc: [
		"Drut i żarówki, a później plemienne rezonatory.",
		"Jak: przetop surową miedź / grys miedzi. Przesiej żwir."
	]
	quest.4200000000020059.title: "Sztabka miedzi"
	quest.420000000002005A.quest_desc: [
		"Złocone narzędzia i złote płyty dla Tkaczy wzorów.",
		"Jak: przetop surowe złoto / grys złota. Rzadszy połów sita."
	]
	quest.420000000002005A.title: "Sztabka złota"
	quest.420000000002005B.quest_desc: [
		"Ostrzejszy połów. Krzemienne siatki wytrząsają Wystrzępioną nić z grysu.",
		"Jak: krzemień wokół siatki Nici (sznurek)."
	]
	quest.420000000002005B.title: "Krzemienna siatka"
	quest.420000000002005C.quest_desc: [
		"Metalowa nić do cięższego pyłu. Żelazne siatki to miejsce, gdzie spada Włókno Nici.",
		"Jak: żelazo wokół siatki Nici (krzemień). Tu zaczyna się Włókno Nici."
	]
	quest.420000000002005C.title: "Żelazna siatka"
	quest.420000000002005D.quest_desc: [
		"Topi się i kapie. Z bruku w lawę, gdy dasz czas.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.420000000002005D.title: "Tygiel"
	quest.420000000002005E.quest_desc: [
		"Beczka Ex Deorum: kompost i woda w glinę, powoli.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.420000000002005E.title: "Beczka (kamień)"
	quest.420000000002005F.quest_desc: [
		"Twardsze ciosy, dłuższe życie.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.420000000002005F.title: "Kamienny młot"
	quest.4200000000020060.quest_desc: [
		"Kruszy rudę w żwir i grys, głośna sztuczka za sitem.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.4200000000020060.title: "Żelazny młot"
	quest.4200000000020061.quest_desc: [
		"Szersza siatka, dziewięć naraz.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.4200000000020061.title: "Sprasowane sito"
	quest.4200000000020062.quest_desc: [
		"Widać na wylot. Z piasku w szkło.",
		"Jak: przetop piasek. Młotem z bruku w żwir, ze żwiru w piasek, potem do pieca."
	]
	quest.4200000000020062.title: "Szkło"
	quest.4200000000020063.quest_desc: [
		"Teraz noś deszcz w żelazie.",
		"Jak: trzy sztabki żelaza albo /clowder hub Strażnicy platformy (8 Nici). Napełnij ze stopionego lodu."
	]
	quest.4200000000020063.title: "Wiadro"
	quest.4200000000020064.quest_desc: [
		"Żar z pustki, w dłoni.",
		"Jak: tygiel lawy Ex Deorum albo jeziorko lawy w Netherze po obsydianie Pazura."
	]
	quest.4200000000020064.title: "Wiadro lawy"
	quest.4200000000020065.quest_desc: [
		"Myśli o portalu. Woda na źródło lawy.",
		"Jak: woda na źródło lawy (albo lawa na wodę). Zostaw źródło lawy."
	]
	quest.4200000000020065.title: "Obsydian"
	quest.4200000000020066.quest_desc: [
		"Rzadkie szczęście grysu. Dwa to początek.",
		"Jak: przesiej żwir żelazną siatką albo lepszą, albo rudę diamentu w Echołamaczu."
	]
	quest.4200000000020066.title: "Diament"
	quest.4200000000020067.quest_desc: [
		"Paliwo ulepszenia siatki.",
		"Jak: żwir, albo upust Nić + żwir."
	]
	quest.4200000000020067.title: "Krzemień"
	quest.4200000000020068.quest_desc: [
		"Zrobiony z grysu i pyłu, nie zdjęty z creepera. Obchodź się ostrożnie.",
		"Jak: przesiej pył albo piasek dusz, albo creepery na platformie nocą. Trzymaj krawędzie oświetlone, gdy już trochę masz."
	]
	quest.4200000000020068.title: "Proch"
	quest.4200000000020069.quest_desc: [
		"Iskra będzie tego chcieć. Trzymaj w suchym miejscu.",
		"Jak: przesiej żwir albo rudę redstone w Echołamaczu po Odzysku."
	]
	quest.4200000000020069.title: "Redstone"
	quest.420000000002006A.quest_desc: [
		"Karmi stół zaklęć. Niebieski pył, przez który sprzęt lepiej słucha.",
		"Jak: przesiej żwir albo rudę lazurytu w Echołamaczu."
	]
	quest.420000000002006A.title: "Lapis lazuli"
	quest.420000000002006B.quest_desc: [
		"Zwykła mieszanka kamienia, przydatna głównie do budowania i do mieszania przepisów później.",
		"Jak: przesiej kamyki z ziemi/żwiru albo bruk plus dioryt w JEI."
	]
	quest.420000000002006B.title: "Andezyt"
	quest.420000000002006C.quest_desc: [
		"Cętkowany kamień, bardziej ozdoba niż konstrukcja. Śpiewacy żwiru zwali go głośnym.",
		"Jak: przesiej kamyki albo bruk plus kwarc Netheru."
	]
	quest.420000000002006C.title: "Dioryt"
	quest.420000000002006D.quest_desc: [
		"Gęsty i różowo nakrapiany, dobry na podłogę, która chce się wyróżniać.",
		"Jak: przesiej kamyki albo dioryt plus kwarc Netheru."
	]
	quest.420000000002006D.title: "Granit"
	quest.420000000002006E.quest_desc: [
		"Porowata skała z tamtego miejsca. Pali się bez końca, gdy chwyci ogień.",
		"Jak: Nether jest tu pustką, nie terenem. Wlej lawę do beczki Ex Deorum z wodą wiedźmy (beczka wody na grzybni; zarodniki grzybni przesiewasz z ziemi)."
	]
	quest.420000000002006E.title: "Netherrack"
	quest.420000000002006F.quest_desc: [
		"Hamuje każdy krok po sobie i karmi ogień dusz chłodniejszym błękitem.",
		"Jak: piasek do beczki Ex Deorum z wodą wiedźmy. Sale brodawek w fortecy trzymają trochę. Trzy czaszki na piasku dusz robią Withera."
	]
	quest.420000000002006F.title: "Piasek dusz"
	quest.4200000000020070.quest_desc: [
		"Zmielony ze świetlokamienia Netheru, przydatny do warzenia i do miększego światła.",
		"Jak: przesiej piasek dusz albo wiedźmy na platformie."
	]
	quest.4200000000020070.title: "Sproszkowany świetlokamień"
	quest.4200000000020071.quest_desc: [
		"Zrywa liście z drzewa, bez zamachu siekierą w pień.",
		"Jak: cztery patyki. Stragan Śpiewaków żwiru sprzedaje jeden."
	]
	quest.4200000000020071.title: "Pastorał"
	quest.4200000000020072.quest_desc: [
		"Z sita, w rosnących stosach. Na każdą siatkę zawsze trochę za mało.",
		"Jak: rozpruj Wystrzępioną nić (1 → 3). Pająki. Meszek krosna przy Echo-wiązaniu. Odwrotny upust przędzy."
	]
	quest.4200000000020072.title: "Sznurek"
	quest.4200000000020073.quest_desc: [
		"Spoiwo węzłów — albo przepis na kompost platformy.",
		"Jak: dwie ziemie + nasiona pszenicy + mączka kostna (kompost platformy), albo /clowder hub Strażnicy platformy."
	]
	quest.4200000000020073.title: "Kula szlamu"
	quest.4200000000020074.quest_desc: [
		"Na mączkę kostną albo w całości, by rozmnożyć następnego wilka stada.",
		"Jak: szkielety w nocy, albo /clowder hub Strażnicy platformy (16 Nić za 8)."
	]
	quest.4200000000020074.title: "Kość"
	quest.4200000000020075.quest_desc: [
		"Gorzki i lekko trujący. Idzie do warzenia, nikt nie je go na surowo.",
		"Jak: pająki na platformie w nocy."
	]
	quest.4200000000020075.title: "Oko pająka"
	quest.4200000000020076.quest_desc: [
		"Przędza, porcelana, działająca Rama krosna, żelazo w skrzyni.",
		"Napnij Nić: Śpiewacy żwiru odpowiadają.",
		"Odbierz i wybierz jeden dar plemienia: Nić Powrotu na jeszcze jedno wspólne życie albo zapasy.",
		"Jak: ukończ zadania powiązane z tym, potem odbierz je za żeton Nici. Osadź żeton na swoim Słupie napięcia."
	]
	quest.4200000000020076.quest_subtitle: "Odzysk"
	quest.4200000000020076.title: "Węzeł Kamienia"
	quest.4200000000020077.quest_desc: [
		"Prawy przycisk żetonem na Słup napięcia swojego Clowder.",
		"Karb się zapala, plemię dźwięczy, platforma się zmienia.",
		"Jak: prawy przycisk na swój Słup napięcia z żetonem Nici w ręku."
	]
	quest.4200000000020077.title: "Osadź Kamień"
	quest.4200000000020078.quest_desc: [
		"Creeper załatwiony. Proch wart więcej niż strach.",
		"Jak: zabij trzy creepery. Proch jest nagrodą."
	]
	quest.4200000000020078.title: "Bum, później"
	quest.4200000000030079.quest_desc: [
		"Wydrap rzędy w platformie.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: dwie sztabki żelaza nad patykiem."
	]
	quest.4200000000030079.title: "Żelazna motyka"
	quest.420000000003007A.quest_desc: [
		"Chleb to infrastruktura. Trzydzieści dwa pszenicy to pole, nie grządka.",
		"Jak: nasiona pszenicy na ziemię uprawną, potem mączka kostna. Nasiona z rozbijanej trawy albo ze skrzyni startowej."
	]
	quest.420000000003007A.title: "Pole pszenicy"
	quest.420000000003007B.quest_desc: [
		"Sadź to, co jesz.",
		"Jak: rozbijaj trawę albo przesiej ziemię siatką z krzemienia. Sadź na ziemi uprawnej; mączka kostna przyspiesza pierwsze pole."
	]
	quest.420000000003007B.title: "Sakiewka nasion"
	quest.420000000003007C.quest_desc: [
		"Szybkość to życzliwość. Kompost i kości.",
		"Jak: kości w kratce, albo upust Nić + zgniłe mięso, lub /clowder hub Strażnicy platformy."
	]
	quest.420000000003007C.title: "Silnik mączki kostnej"
	quest.420000000003007D.quest_desc: [
		"Przygotuj zbiory.",
		"Jak: receptura Farmer's Delight w JEI (stół rzemieślniczy, deska do krojenia albo garnek). Nasiona upraw biorą się z przesiewania ziemi."
	]
	quest.420000000003007D.title: "Nóż rolnika"
	quest.420000000003007E.quest_desc: [
		"Kuchnia zaczyna się tutaj.",
		"Jak: receptura Farmer's Delight w JEI (stół rzemieślniczy, deska do krojenia albo garnek). Nasiona upraw biorą się z przesiewania ziemi."
	]
	quest.420000000003007E.title: "Deska do krojenia"
	quest.420000000003007F.quest_desc: [
		"Ciepłe posiłki karmią więcej niż sam głód.",
		"Jak: receptura Farmer's Delight w JEI (stół rzemieślniczy, deska do krojenia albo garnek). Nasiona upraw biorą się z przesiewania ziemi."
	]
	quest.420000000003007F.title: "Garnek"
	quest.4200000000030080.quest_desc: [
		"Rośnie w równych główkach, lepiej ugotowana w coś niż surowa.",
		"Jak: receptura Farmer's Delight w JEI (stół rzemieślniczy, deska do krojenia albo garnek). Nasiona upraw biorą się z przesiewania ziemi."
	]
	quest.4200000000030080.title: "Kapusta"
	quest.4200000000030081.quest_desc: [
		"Wspina się po własnej kratce i dojrzewa na czerwono. Sos zaczyna się tutaj.",
		"Jak: receptura Farmer's Delight w JEI (stół rzemieślniczy, deska do krojenia albo garnek). Nasiona upraw biorą się z przesiewania ziemi."
	]
	quest.4200000000030081.title: "Pomidor"
	quest.4200000000030082.quest_desc: [
		"Łzy radości.",
		"Jak: receptura Farmer's Delight w JEI (stół rzemieślniczy, deska do krojenia albo garnek). Nasiona upraw biorą się z przesiewania ziemi."
	]
	quest.4200000000030082.title: "Cebula"
	quest.4200000000030083.quest_desc: [
		"Zaczyna się uprawa esencji. Szesnaście z pierwszego rzędu.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"Kręgosłup nasion. Przesiej albo wyhoduj.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Wznieś nasiona z esencji.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030085.title: "Ołtarz infuzji"
	quest.4200000000030086.quest_desc: [
		"Cztery wokół ołtarza.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030086.title: "Postument infuzji"
	quest.4200000000030087.quest_desc: [
		"Wyhoduj więcej platformy.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030087.title: "Nasiona ziemi"
	quest.4200000000030088.quest_desc: [
		"Wyhoduj koronę bez siekiery.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030088.title: "Nasiona drewna"
	quest.4200000000030089.quest_desc: [
		"Wyhodowane, nie wykopane. Zbieraj esencję zamiast machać kilofem.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030089.title: "Nasiona kamienia"
	quest.420000000003008A.quest_desc: [
		"Metal z uprawy. Drugi silnik Odzysku.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.420000000003008A.title: "Nasiona żelaza"
	quest.420000000003008B.quest_desc: [
		"Uprawa, która daje esencję miedzi zamiast rudy miedzi.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.420000000003008B.title: "Nasiona miedzi"
	quest.420000000003008C.quest_desc: [
		"Złocona uprawa, która hoduje esencję złota wprost na platformie.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.420000000003008C.title: "Nasiona złota"
	quest.420000000003008D.quest_desc: [
		"Zamienia grządkę w źródło paliwa, bez kopania.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.420000000003008D.title: "Nasiona węgla"
	quest.420000000003008E.quest_desc: [
		"Butelkowany deszcz z uprawy.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.420000000003008E.title: "Nasiona wody"
	quest.420000000003008F.quest_desc: [
		"Zwarty wzrost na małą platformę.",
		"Jak: terakotowy Botany Pot w JEI. Ziemia + nasiono w doniczce; mączka kostna wciąż pomaga."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"Doniczka, która zbiera sama.",
		"Jak: Botany Pot z lejkiem w JEI. Stoi na skrzyni/lejku i zbiera sam."
	]
	quest.4200000000030090.title: "Doniczka-lejek"
	quest.4200000000030091.quest_desc: [
		"Wyższy stopień. Nasiona robią się chciwsze i lepsze.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"Głębszy stopień esencji uprawy, silniejszy niż nasiona, od których zacząłeś.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Dziewięć mączki kostnej w blok. Magazyn dla silnika.",
		"Jak: dziewięć mączki kostnej. Kości ze szkieletów albo od Strażników platformy."
	]
	quest.4200000000030093.title: "Blok kości"
	quest.4200000000030094.quest_desc: [
		"Nadmiar Kiełka, w stosie.",
		"Jak: dziewięć pszenicy. Trzy pszenice dają też chleb."
	]
	quest.4200000000030094.title: "Silos siana"
	quest.4200000000030095.quest_desc: [
		"Lepsza rola. Wiązacze korzeni pochwaliliby to.",
		"Jak: postaw Kompost organiczny i czekaj; powoli dojrzewa w Bogatą glebę."
	]
	quest.4200000000030095.title: "Bogata gleba"
	quest.4200000000030096.quest_desc: [
		"Karm glebę, która karmi ciebie.",
		"Jak: receptura Farmer's Delight w JEI (stół rzemieślniczy, deska do krojenia albo garnek). Nasiona upraw biorą się z przesiewania ziemi."
	]
	quest.4200000000030096.title: "Kompost organiczny"
	quest.4200000000030097.quest_desc: [
		"Zasadź rząd, nakarm konia albo zjedz po prostu na surowo.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000030097.title: "Marchewka"
	quest.4200000000030098.quest_desc: [
		"Podstawowa uprawa: ziemniak.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000030098.title: "Ziemniak"
	quest.4200000000030099.quest_desc: [
		"Rośnie szybko i barwi na czerwono. Zupa, gulasz albo prosto z ziemi.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000030099.title: "Burak"
	quest.420000000003009A.quest_desc: [
		"Arbuz na jedzenie i handel.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000003009A.title: "Arbuz"
	quest.420000000003009B.quest_desc: [
		"Dynia do jedzenia i ozdoby.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000003009B.title: "Dynia"
	quest.420000000003009C.quest_desc: [
		"Papier i cukier.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000003009C.title: "Trzcina cukrowa"
	quest.420000000003009D.quest_desc: [
		"Rośnie bez wody i rani wszystko, co się o niego oprze.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000003009D.title: "Kaktus"
	quest.420000000003009E.quest_desc: [
		"Szybko pnie się w górę i pali się gorąco. Poręczne paliwo, gdy na platformie mało drzew.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000003009E.title: "Bambus"
	quest.420000000003009F.quest_desc: [
		"Jagody, gdy budujesz.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000003009F.title: "Słodkie jagody"
	quest.42000000000300A0.quest_desc: [
		"Uprawiane na pniach dżungli, mielone w brąz, który nadaje smak wszystkiemu, co słodkie.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000300A0.title: "Kakao"
	quest.42000000000300A1.quest_desc: [
		"Spada z liści dębu w swoim czasie. Darmowe jedzenie, w końcu.",
		"Jak: liście dębu dają kilka; jabłoń Pam's (sadzonka z ziemi z żelazną siatką) rodzi wiele."
	]
	quest.42000000000300A1.title: "Jabłko"
	quest.42000000000300A2.quest_desc: [
		"Jedna miska, bez stołu warsztatowego. Kolacja leniwego rolnika.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000300A2.title: "Zupa grzybowa"
	quest.42000000000300A3.quest_desc: [
		"Smak ula, zanim zacznie się głębsza praca z pszczołami.",
		"Jak: szklana butelka na pełny ul. Ognisko pod spodem."
	]
	quest.42000000000300A3.title: "Butelka miodu"
	quest.42000000000300A4.quest_desc: [
		"Rosną na jaskiniowych pnączach i oświetlają tunel, kiedy je jesz.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000300A4.title: "Świecące jagody"
	quest.42000000000300A5.quest_desc: [
		"Podstawa każdej mikstury, którą warto zabutelkować. Rośnie tylko na piasku dusz.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000300A5.title: "Netherowa brodawka"
	quest.42000000000300A6.quest_desc: [
		"Pole, kuchnia, esencja w górę.",
		"Napnij Nić: Wiązacze korzeni odpowiadają.",
		"Odbierz i wybierz jeden dar plemienia: Nić Powrotu na jeszcze jedno wspólne życie albo zapasy.",
		"Jak: ukończ zadania powiązane z tym, potem odbierz je za żeton Nici. Osadź żeton na swoim Słupie napięcia."
	]
	quest.42000000000300A6.quest_subtitle: "Korzeń"
	quest.42000000000300A6.title: "Węzeł Kiełka"
	quest.42000000000300A7.quest_desc: [
		"Prawy przycisk żetonem na Słup napięcia swojego Clowder.",
		"Karb się zapala, plemię dźwięczy, platforma się zmienia.",
		"Jak: prawy przycisk na swój Słup napięcia z żetonem Nici w ręku."
	]
	quest.42000000000300A7.title: "Osadź Kiełek"
	quest.42000000000300A8.quest_desc: [
		"Wiązacze korzeni prędzej czy później wyciągają po jednej.",
		"Nie jedz go. I też go nie wyrzucaj.",
		"Jak: rzadkie zbiory ziemniaka. Opcjonalny sekret Kiełka."
	]
	quest.42000000000300A8.title: "Nie ten ziemniak"
	quest.42000000000400A9.quest_desc: [
		"Tnij pustkę na swoich warunkach. Osiem arkuszy planów.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: cztery papiery i jeden niebieski barwnik, bez kształtu. Daje cztery arkusze."
	]
	quest.42000000000400A9.title: "Papier planów"
	quest.42000000000400AA.quest_desc: [
		"Plany w pudełku.",
		"Cztery Papier planów, bez kształtu — przejęcie platformy kasuje dar powitalny Silent Gear. Prawy przycisk, by rozpakować plany startowe.",
		"Jak: cztery Papier planów, bez kształtu. Prawy przycisk, by rozpakować plany startowe. Przejęcie platformy kasuje dar powitalny Silent Gear."
	]
	quest.42000000000400AA.title: "Paczka planów"
	quest.42000000000400AB.quest_desc: [
		"Szablon, od którego startuje modułowe narzędzie, zanim dodasz części.",
		"Jak: rozpakuj Paczkę planów albo JEI. Pazur nazywa linię narzędzi."
	]
	quest.42000000000400AB.title: "Plan pręta"
	quest.42000000000400AC.quest_desc: [
		"Ukształtuj kilof, który przeżyje swój metal.",
		"Jak: rozpakuj Paczkę planów albo JEI. Pazur nazywa linię narzędzi."
	]
	quest.42000000000400AC.title: "Plan kilofa"
	quest.42000000000400AD.quest_desc: [
		"Ukształtuj siekierę.",
		"Jak: rozpakuj Paczkę planów albo JEI. Pazur nazywa linię narzędzi."
	]
	quest.42000000000400AD.title: "Plan siekiery"
	quest.42000000000400AE.quest_desc: [
		"Ukształtuj łopatę.",
		"Jak: rozpakuj Paczkę planów albo JEI. Pazur nazywa linię narzędzi."
	]
	quest.42000000000400AE.title: "Plan łopaty"
	quest.42000000000400AF.quest_desc: [
		"Ukształtuj ostrze.",
		"Jak: rozpakuj Paczkę planów albo JEI. Pazur nazywa linię narzędzi."
	]
	quest.42000000000400AF.title: "Plan miecza"
	quest.42000000000400B0.quest_desc: [
		"Miejsce, by rosnąć.",
		"Jak: JEI po Papier planów. Pazur nazywa linię ulepszeń."
	]
	quest.42000000000400B0.title: "Podstawa ulepszenia"
	quest.42000000000400B1.quest_desc: [
		"Trzydzieści dwa sztabki materiału na części.",
		"Jak: przetop surowe żelazo / grys żelaza (piec albo Piec żaru). Przesiej żwir po kawałki."
	]
	quest.42000000000400B1.title: "Żelazna masa"
	quest.42000000000400B2.quest_desc: [
		"Ostrzy krawędź dalej, niż samo żelazo daje radę.",
		"Jak: przesiej żwir żelazną siatką albo lepszą, albo rudę diamentu w Echołamaczu."
	]
	quest.42000000000400B2.title: "Diamentowa końcówka"
	quest.42000000000400B3.quest_desc: [
		"Liście i wełna, a plastry później.",
		"Jak: dwie sztabki żelaza po skosie. Strzyż owce i gniazda pszczół."
	]
	quest.42000000000400B3.title: "Nożyce"
	quest.42000000000400B4.quest_desc: [
		"Platformy mają krawędzie. Potwory też.",
		"Jak: sześć desek wokół żelaza. Blok drugą ręką."
	]
	quest.42000000000400B4.title: "Tarcza"
	quest.42000000000400B5.quest_desc: [
		"Przetrwaj noc celowo.",
		"Jak: osiem sztabek żelaza. Przetop żwir sita."
	]
	quest.42000000000400B5.title: "Żelazny napierśnik"
	quest.42000000000400B6.quest_desc: [
		"Uważaj na spadek.",
		"Jak: pięć sztabek żelaza."
	]
	quest.42000000000400B6.title: "Żelazny hełm"
	quest.42000000000400B7.quest_desc: [
		"Najpierw osłania nogi. Większość obrażeń i tak leci z dołu.",
		"Jak: siedem sztabek żelaza."
	]
	quest.42000000000400B7.title: "Żelazne nogawice"
	quest.42000000000400B8.quest_desc: [
		"Umacnia stopę na występach, gdzie poślizg to pustka.",
		"Jak: cztery sztabki żelaza."
	]
	quest.42000000000400B8.title: "Żelazne buty"
	quest.42000000000400B9.quest_desc: [
		"Trzymaj potwory pustki na dystans.",
		"Jak: trzy sznurki i trzy patyki."
	]
	quest.42000000000400B9.title: "Łuk"
	quest.42000000000400BA.quest_desc: [
		"Sześćdziesiąt cztery powody, by trzymać dystans.",
		"Jak: krzemień, patyk, pióro. Szkielety zostawiają nadmiar."
	]
	quest.42000000000400BA.title: "Pęk strzał"
	quest.42000000000400BB.quest_desc: [
		"Oświetl drogę na wylot.",
		"Jak: sztabka żelaza plus krzemień."
	]
	quest.42000000000400BB.title: "Krzesiwo"
	quest.42000000000400BC.quest_desc: [
		"Dziesięć bloków. Drzwi, które Chodzący po krawędzi poznaliby.",
		"Jak: woda na źródło lawy (albo lawa na wodę). Zostaw źródło lawy."
	]
	quest.42000000000400BC.title: "Obsydianowa rama"
	quest.42000000000400BD.quest_desc: [
		"Przygotowanie oparcia. Gdzieś indziej istnieje.",
		"Jak: perła Endera (stragan Chodzących po krawędzi / endermany) plus płomienny proszek z fortecy Netheru po obsydianie Pazura. Zapas ośmiu oczu jest opcjonalny; kryształy Endu używają tego samego rzemiosła."
	]
	quest.42000000000400BD.title: "Oko Endera"
	quest.42000000000400BE.quest_desc: [
		"Miękka moc dla twardych narzędzi.",
		"Jak: dwa diamenty, cztery obsydiany, książka. Diamenty ze żwiru na żelaznej siatce."
	]
	quest.42000000000400BE.title: "Stół do zaklęć"
	quest.42000000000400BF.quest_desc: [
		"Napraw i nazwij to, co nosisz.",
		"Jak: trzy bloki żelaza nad czterema sztabkami."
	]
	quest.42000000000400BF.title: "Kowadło"
	quest.42000000000400C0.quest_desc: [
		"Nazwij swoim.",
		"Jak: łowienie / rzadkie skrzynie, albo stragan Rzeźbiarzy pieczęci w /clowder hub (24 Nić). Opcjonalnie."
	]
	quest.42000000000400C0.title: "Znacznik"
	quest.42000000000400C1.quest_desc: [
		"Szablon startowy modułowej motyki, budowanej część po części.",
		"Jak: rozpakuj Paczkę planów, albo JEI."
	]
	quest.42000000000400C1.title: "Plan motyki"
	quest.42000000000400C2.quest_desc: [
		"Czyści szeroki pas upraw jednym zamachem, zamiast jednej rośliny.",
		"Jak: rozpakuj Paczkę planów, albo JEI."
	]
	quest.42000000000400C2.title: "Plan sierpa"
	quest.42000000000400C3.quest_desc: [
		"Jedno narzędzie, które wydobywa, rąbie i kopie. Koniec z zamianą w ręce.",
		"Jak: rozpakuj Paczkę planów, albo JEI."
	]
	quest.42000000000400C3.title: "Plan Paxel"
	quest.42000000000400C4.quest_desc: [
		"Kruszy kamień trzy na trzy jednym uderzeniem.",
		"Jak: rozpakuj Paczkę planów, albo JEI."
	]
	quest.42000000000400C4.title: "Plan młota"
	quest.42000000000400C5.quest_desc: [
		"Kopi szerokie doły w ziemi i piasku szybciej niż jakakolwiek łopata.",
		"Jak: rozpakuj Paczkę planów, albo JEI."
	]
	quest.42000000000400C5.title: "Plan koparki"
	quest.42000000000400C6.quest_desc: [
		"Mały, szybki i precyzyjny. Zrobiony do pracy z bliska, nie do wojny.",
		"Jak: rozpakuj Paczkę planów, albo JEI."
	]
	quest.42000000000400C6.title: "Plan noża"
	quest.42000000000400C7.quest_desc: [
		"Miękkie płyty, łatwe do zaklęcia, warte więcej magią niż obroną.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000400C7.title: "Części złotej zbroi"
	quest.42000000000400C8.quest_desc: [
		"Morski pazur.",
		"Opcjonalne — pustka może nigdy go nie dać.",
		"Jak: tylko utopce. Opcjonalnie."
	]
	quest.42000000000400C8.title: "Trójząb"
	quest.42000000000400C9.quest_desc: [
		"Ładuje się wolno, uderza mocno i trzyma ładunek, aż będzie potrzebny.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000400C9.title: "Kusza"
	quest.42000000000400CA.quest_desc: [
		"Przeskanuj pustkę.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000400CA.title: "Luneta"
	quest.42000000000400CB.quest_desc: [
		"Plany, żelazo na plecach, drzwi na zewnątrz.",
		"Napnij Nić: Chodzący po krawędzi odpowiadają. Warkocz się otwiera.",
		"Odbierz i wybierz jeden dar plemienia: Nić Powrotu na jeszcze jedno wspólne życie albo zapasy.",
		"Jak: ukończ zadania powiązane z tym, potem odbierz je za żeton Nici. Osadź żeton na swoim Słupie napięcia."
	]
	quest.42000000000400CB.quest_subtitle: "Krawędź"
	quest.42000000000400CB.title: "Węzeł Pazura"
	quest.42000000000400CC.quest_desc: [
		"Prawy przycisk żetonem na Słup napięcia swojego Clowder.",
		"Karb się zapala, plemię dźwięczy, platforma się zmienia.",
		"Jak: prawy przycisk na swój Słup napięcia z żetonem Nici w ręku."
	]
	quest.42000000000400CC.title: "Osadź Pazur"
	quest.42000000000400CD.quest_desc: [
		"Coś wysokiego spojrzało z powrotem. Chodzący po krawędzi zwali ich strażnikami drzwi.",
		"Jak: zabij endermana. Perły Endera są też na straganie Chodzących po krawędzi."
	]
	quest.42000000000400CD.title: "Krawędź Krawędzi"
	quest.42000000000500CE.quest_desc: [
		"Krótki sygnał przed Pomrukiem. Sześćdziesiąt cztery pyłu.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: przesiej żwir albo rudę redstone w Echołamaczu po Odzysku."
	]
	quest.42000000000500CE.title: "Pył redstone"
	quest.42000000000500CF.quest_desc: [
		"Równoległe ciepło. Osiem to linia, nie piec.",
		"Jak: osiem sztuk bruku wokół pustego środka."
	]
	quest.42000000000500CF.title: "Rząd pieców"
	quest.42000000000500D0.quest_desc: [
		"Przesuń grys bez rąk.",
		"Jak: pięć żelaza wokół skrzyni. Posadź go pod Ramą krosna albo Beczką napięcia (wyciąga W DÓŁ)."
	]
	quest.42000000000500D0.title: "Linia lejów"
	quest.42000000000500D1.quest_desc: [
		"Zmierz takt.",
		"Jak: kwarc Netheru, pochodnia redstone, kamień. Kwarc przesiewasz z piasku dusz; bez wyprawy do Netheru."
	]
	quest.42000000000500D1.title: "Komparator"
	quest.42000000000500D2.quest_desc: [
		"Kość, sznurek, ametyst. Pierwszy takt.",
		"Daje dwa — zostaw jeden dla Kodeksu Duchów.",
		"Jak: jedna kość, sznurek, ametyst. /clowder hub Strażnicy platformy sprzedają kości. Brama Iskra / Pomruk."
	]
	quest.42000000000500D2.title: "Pomruk: Kościany dzwonek"
	quest.42000000000500D3.quest_desc: [
		"Odłamek starej pieśni plemienia. Potrzebuje dzwonka.",
		"Jak: Kościany dzwonek, ametyst i redstone, bez kształtu. Daje dwa."
	]
	quest.42000000000500D3.title: "Pomruk: Duchowy odłamek"
	quest.42000000000500D4.quest_desc: [
		"Miedź wokół dzwonka: metal nastrojony na ducha.",
		"Jak: miedź wokół Kościanego dzwonka. Daje dwa."
	]
	quest.42000000000500D4.title: "Pomruk: Miedziany rezonator"
	quest.42000000000500D5.quest_desc: [
		"Uderz. Trzymaj Puls. Słuchaj, zanim podłączysz cokolwiek.",
		"Dwa dzwonki, jeden odłamek, dwie skóry, cztery deski — Strażnicy platformy przy /clowder hub sprzedają skórę.",
		"Jak: dwa Kościane dzwonki, jeden Duchowy odłamek, dwie skóry i cztery deski. Uderz z pustymi rękami w rytm (17–23 ticków) za 24 Pulsu."
	]
	quest.42000000000500D5.title: "Pomruk: Bębnoserce"
	quest.42000000000500D6.quest_desc: [
		"Noś Puls do narzędzi, zaklęć i podróży — trzeba Rezonatora + Odłamka.",
		"Jak: wytwórz, potem napełnij z Bębnoserca (klik komórką). Narzędzia, zaklęcia i podróż czerpią z komórki."
	]
	quest.42000000000500D6.title: "Pomruk: Komórka Pulsu"
	quest.42000000000500D7.quest_desc: [
		"Ciągnij otaczającą ley w takty pod otwartym niebem. Głosy totemów dokładają; Bębnoserce nie jest potrzebne.",
		"Jak: postaw pod niebem, blisko wody/zieleni. Wolny Puls. Drabina Iskry."
	]
	quest.42000000000500D7.title: "Pomruk: Kolektor ley"
	quest.42000000000500D8.quest_desc: [
		"Osadź katalizator echa (zużywa się w pracy) i dwa różne totemy żywiołów. Obóz śpiewa własną moc; redstone wstrzymuje harmonię.",
		"Jak: osadź katalizator echa i dwa różne totemy w zasięgu 8. Redstone go wstrzymuje."
	]
	quest.42000000000500D8.title: "Pomruk: Rezonator Pulsu"
	quest.42000000000500D9.quest_desc: [
		"Bufor energii Forge — most od Pulsu do drutu, jeśli chcesz.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500D9.title: "Ogniwo startowe Powah"
	quest.42000000000500DA.quest_desc: [
		"Pal paliwo na energię Forge.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500DA.title: "Palnik Powah"
	quest.42000000000500DB.quest_desc: [
		"Prowadź energię dalej.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500DB.title: "Kabel Powah"
	quest.42000000000500DC.quest_desc: [
		"Moc nieba, na platformie, która jest samym niebem.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500DC.title: "Startowy panel słoneczny"
	quest.42000000000500DD.quest_desc: [
		"Spala różnicę ciepła na moc. Karm go gorącem z jednej strony, zimnem z drugiej.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500DD.title: "Generator cieplny"
	quest.42000000000500DE.quest_desc: [
		"Ładuje przedmioty w pierścieniu prętów.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500DE.title: "Kula zasilająca"
	quest.42000000000500DF.quest_desc: [
		"Nakarm kulę.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500DF.title: "Pręt zasilający"
	quest.42000000000500E0.quest_desc: [
		"Garść zmagazynowanej mocy.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500E0.title: "Bateria"
	quest.42000000000500E1.quest_desc: [
		"Obraca maszyny w miejscu, zamiast je niszczyć i stawiać od nowa.",
		"Jak: rozdział Sieć Powah — kula zasilająca i kable, gdy jest już Puls Iskry."
	]
	quest.42000000000500E1.title: "Klucz"
	quest.42000000000500E2.quest_desc: [
		"Przetapia rudę dwa razy szybciej niż zwykły piec, tylko rudę.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500E2.title: "Piec hutniczy"
	quest.42000000000500E3.quest_desc: [
		"Gotuje mięso dwa razy szybciej niż ognisko, tylko jedzenie.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500E3.title: "Wędzarka"
	quest.42000000000500E4.quest_desc: [
		"Dziewięć węgla, gęsto sprasowane. Jeden blok trwa dłużej niż cały stos bryłek.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500E4.title: "Blok węgla (Iskra)"
	quest.42000000000500E5.quest_desc: [
		"Popycha po jednym przedmiocie w to, co stoi przed nim.",
		"Jak: bruk wokół redstone."
	]
	quest.42000000000500E5.title: "Podajnik"
	quest.42000000000500E6.quest_desc: [
		"Pchnij z zamysłem.",
		"Jak: bruk, łuk i redstone."
	]
	quest.42000000000500E6.title: "Dozownik"
	quest.42000000000500E7.quest_desc: [
		"Popycha blok do przodu na sygnał, potem czeka na następny.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500E7.title: "Tłok"
	quest.42000000000500E8.quest_desc: [
		"Wypycha blok i wciąga go z powrotem, gdy sygnał gaśnie.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500E8.title: "Lepki tłok"
	quest.42000000000500E9.quest_desc: [
		"Obserwator czyta rytm.",
		"Jak: bruk, redstone i kwarc Netheru."
	]
	quest.42000000000500E9.title: "Obserwator"
	quest.42000000000500EA.quest_desc: [
		"Przekaźnik taktuje obwód.",
		"Jak: pochodnia redstone, redstone, kamień. Rozdział rur używa go do zegarów."
	]
	quest.42000000000500EA.title: "Przekaźnik"
	quest.42000000000500EB.quest_desc: [
		"Rejestruje trafienie z siłą sygnału zależną od bliskości środka.",
		"Jak: redstone wokół siana. Siano to trzy pszenice."
	]
	quest.42000000000500EB.title: "Cel"
	quest.42000000000500EC.quest_desc: [
		"Ściąga uderzenie z twojego dachu i uziemia ładunek.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500EC.title: "Piorunochron"
	quest.42000000000500ED.quest_desc: [
		"Czas na energię.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500ED.title: "Zegar"
	quest.42000000000500EE.quest_desc: [
		"Światło bez pochodni.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500EE.title: "Miedziana żarówka"
	quest.42000000000500EF.quest_desc: [
		"Zapala się od sygnału i gaśnie w chwili, gdy ten ustaje.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500EF.title: "Lampa redstone"
	quest.42000000000500F0.quest_desc: [
		"Czyta niebo i wysyła sygnał, który rośnie i maleje wraz ze słońcem.",
		"Jak: szkło, kwarc Netheru, drewniane płyty."
	]
	quest.42000000000500F0.title: "Detektor światła dziennego"
	quest.42000000000500F1.quest_desc: [
		"Włącza albo wyłącza sygnał ręcznie. Najstarszy przełącznik, jaki jest.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F1.title: "Dźwignia"
	quest.42000000000500F2.quest_desc: [
		"Przycisk daje impuls redstone.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F2.title: "Przycisk"
	quest.42000000000500F3.quest_desc: [
		"Wysyła sygnał, gdy stanie na niej coś cięższego od powietrza.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F3.title: "Płyta naciskowa"
	quest.42000000000500F4.quest_desc: [
		"Napięta sznurkiem w poprzek ścieżki, łapie wszystko, co ją przetnie.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F4.title: "Zaczep"
	quest.42000000000500F5.quest_desc: [
		"Gra jedną nutę na każdy rodzaj bloku pod spodem. Bębnoserca słyszą pieśń w ich rzędzie.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F5.title: "Blok dźwiękowy"
	quest.42000000000500F6.quest_desc: [
		"Szafa grająca dla morale platformy.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F6.title: "Szafa grająca"
	quest.42000000000500F7.quest_desc: [
		"Toczy się od grawitacji albo pchnięcia. Bez szyn nie ma jazdy.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F7.title: "Wagonik"
	quest.42000000000500F8.quest_desc: [
		"Tory przez przęsło pustki.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F8.title: "Tor"
	quest.42000000000500F9.quest_desc: [
		"Tory zasilane dla wagoników.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500F9.title: "Tory zasilane"
	quest.42000000000500FA.quest_desc: [
		"Czyta mijający wagonik i wysyła sygnał, gdy ten przetoczy się po nim.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000000500FA.title: "Tory z czujnikiem"
	quest.42000000000500FB.quest_desc: [
		"Zapasowy przepis solarny.",
		"Jak: trzy szkła, trzy lazuryty i trzy Lustra, rząd każdego."
	]
	quest.42000000000500FB.title: "Ogniwo Solar Flux"
	quest.42000000000500FC.quest_desc: [
		"Proste rury na przedmioty.",
		"Jak: żelazo + redstone. Ustaw ścianki kluczem Pipez."
	]
	quest.42000000000500FC.title: "Przedmioty Pipez"
	quest.42000000000500FD.quest_desc: [
		"Proste rury na płyny.",
		"Jak: żelazo + wiadra + redstone. Użycie w skradaniu kluczem na boku, by wyciągać; prawy przycisk na tym boku dla filtrów."
	]
	quest.42000000000500FD.title: "Płyny Pipez"
	quest.42000000000500FE.quest_desc: [
		"Zwykłe rury energii między maszynami.",
		"Jak: żelazo + redstone. Niesie FE między maszynami."
	]
	quest.42000000000500FE.title: "Energia Pipez"
	quest.42000000000500FF.quest_desc: [
		"Ustawia, które boki rury wyciągają z maszyny, albo odcina bok, bez łamania rury.",
		"Jak: dwa krzemienie i dwa patyki. Użycie w skradaniu boku rury przy maszynie, by wyciągała, jeszcze raz, by odciąć; prawy przycisk na wyciągającym boku dla filtrów."
	]
	quest.42000000000500FF.title: "Klucz Pipez"
	quest.4200000000050100.quest_desc: [
		"Znaczy linie kraty — potrzebny Duchowy odłamek.",
		"Jak: dwie mączki kostne, lazuryt i Duchowy odłamek, bez kształtu. Daje cztery."
	]
	quest.4200000000050100.title: "Kreda rytualna"
	quest.4200000000050101.quest_desc: [
		"Bęben uderzony, Puls utrzymany, rezonator osadzony.",
		"Napnij Nić: Bębnoserca odpowiadają.",
		"Odbierz i wybierz jeden dar plemienia: Nić Powrotu na jeszcze jedno wspólne życie albo zapasy.",
		"Jak: ukończ zadania powiązane z tym, potem odbierz je za żeton Nici. Osadź żeton na swoim Słupie napięcia."
	]
	quest.4200000000050101.quest_subtitle: "Pomruk"
	quest.4200000000050101.title: "Węzeł Iskry"
	quest.4200000000050102.quest_desc: [
		"Prawy przycisk żetonem na Słup napięcia swojego Clowder.",
		"Karb się zapala, plemię dźwięczy, platforma się zmienia.",
		"Jak: prawy przycisk na swój Słup napięcia z żetonem Nici w ręku."
	]
	quest.4200000000050102.title: "Osadź Iskrę"
	quest.4200000000050103.quest_desc: [
		"Podążaj za Plemiennym splotem przez rafinację echa aż do Rdzenia rezonansowego. Harmonijny energetyzator zamienia harmonię obozu w FE dla maszyn tego rozdziału. Przemiana bez rangi to 60 Pulsu na sekundę; podnieś rangę na stacjach echa, żeby było więcej. Nie może przyjmować FE. Redstone wstrzymuje i przemianę, i wywóz.",
		"Jak: pięć sztabek miedzi, trzy redstone i jeden Rdzeń rezonansowy."
	]
	quest.4200000000050103.title: "Szum staje się prądem"
	quest.4200000000050104.quest_desc: [
		"Wiedźma, na twojej platformie, nocą. Bębny cię nie ostrzegły.",
		"Jak: zabij wiedźmę na platformie nocą."
	]
	quest.4200000000050104.title: "Kłopot w butelce"
	quest.4200000000060105.quest_desc: [
		"Ręce, które pracują, kiedy śpisz. Trzydzieści dwa.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: andezyt + bryłka żelaza w stole rzemieślniczym (albo w mieszalniku)."
	]
	quest.4200000000060105.title: "Stop andezytowy"
	quest.4200000000060106.quest_desc: [
		"Kręgosłup obrotu.",
		"Jak: stop andezytowy w przepisie cięcia / wytwarzania, podanym w JEI."
	]
	quest.4200000000060106.title: "Wał"
	quest.4200000000060107.quest_desc: [
		"Jedna zębatka. Potem ta sama zębatka znowu.",
		"Jak: wał + deski."
	]
	quest.4200000000060107.title: "Zębatka"
	quest.4200000000060108.quest_desc: [
		"Więcej zębów, wolniejszy obrót.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.4200000000060108.title: "Duża zębatka"
	quest.4200000000060109.quest_desc: [
		"Andezytowa obudowa to rama Create.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.4200000000060109.title: "Andezytowa obudowa"
	quest.420000000006010A.quest_desc: [
		"Rzeka na niebie, w obrocie.",
		"Jak: osiem desek wokół wału. Obok potrzebny jest przepływ wody."
	]
	quest.420000000006010A.title: "Koło wodne"
	quest.420000000006010B.quest_desc: [
		"Daje obrót ręcznie, gdy nic innego jeszcze się nie kręci.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.420000000006010B.title: "Korba"
	quest.420000000006010C.quest_desc: [
		"Miel żwir na pył, bez młota.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.420000000006010C.title: "Żarno"
	quest.420000000006010D.quest_desc: [
		"Misa trzyma mieszanie Create.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.420000000006010D.title: "Misa"
	quest.420000000006010E.quest_desc: [
		"Płyty i ścieżki.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.420000000006010E.title: "Prasa mechaniczna"
	quest.420000000006010F.quest_desc: [
		"Przepisy hurtowo, szybko.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.420000000006010F.title: "Mieszalnik mechaniczny"
	quest.4200000000060110.quest_desc: [
