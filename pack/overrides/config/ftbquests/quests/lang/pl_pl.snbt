	chapter.310000000000002B.chapter_subtitle: [
		"Kawałki starego świata dryfują w górę aż do twojej platformy. Dotrzyj do nich, zanim się rozplotą."
	]
	chapter.310000000000002B.title: "Dryfujące wraki"
	quest.42000000002B0801.quest_desc: [
		"Gdy Gleba jest napięta, kawałki starego świata od czasu do czasu dryfują w górę do twojej platformy i zaczepiają się o twój wątek. Zarządca mówi całemu Clowder, gdy jeden przybywa.",
		"Nie zostają: wrak trzyma się przez chwilę czasu online twojego Clowder, a potem rozplata się z powrotem w pustkę. Nikt nie spada i nic, co zdobyłeś, nie przepada."
	]
	quest.42000000002B0801.title: "Coś dryfuje"
	quest.42000000002B0802.quest_desc: [
		"Stań na krawędzi swojej platformy, patrz na wrak i użyj Szpulki uwięzi: most z nici sam się kładzie, wspinając się półkrokami.",
		"Spadnij, a nić cię złapie, za trzy serca. Pustka jest scenerią, nie karą."
	]
	quest.42000000002B0802.title: "Przejdź przez pustkę"
	quest.42000000002B0803.quest_desc: [
		"Każdy wrak prosi o jedno: otwórz skrzynię serca, rozbij spawnery, przewlecz filary, odprowadź echo do domu albo utrzymaj szew.",
		"Skończ go, a każdy, kto na nim stanie, dostaje Ocalony wątek i Pieczęć. Rama zbieracza zamienia wątek w szpulki, przynęty, klucze i ozdoby."
	]
	quest.42000000002B0803.title: "Odzysk"
	quest.42000000002B0804.quest_desc: [
		"Atlas wraków trzyma miejsca każdego plemienia, które ukończyłeś: dziewięć Nici na sześć rodzajów miejsc. Pełna kolumna, pełny rząd, wszystkie stemple: każde daje mały, stały atut.",
		"Strony przychodzą z podaniem w Kodeksie. Strony wskazówki znalezione w skrzyniach otwierają ukryte pokoje. Otwórz Atlas wraków, by odhaczyć to."
	]
	quest.42000000002B0804.title: "Atlas"
	quest.42000000002B0805.quest_desc: [
		"Przynieś pięć Pieczęci wraku: pięć wraków ukończonych, przez kogokolwiek z twojego Clowder.",
		"Powtarzalne: oddawaj je, ile chcesz.",
		"Jak: ukończ zadanie dryfowraku. Każdy, kto na nim stanie, dostaje Pieczęć."
	]
	quest.42000000002B0805.title: "Pięć pieczęci"
	quest.42000000002B0806.quest_desc: [
		"Rozbij trzy wystrzępione spawnery i oddaj ich rdzenie.",
		"Powtarzalne: oddawaj je, ile chcesz.",
		"Jak: rozbij wystrzępiony spawner na dryfowraku; każdy upuszcza swój rdzeń."
	]
	quest.42000000002B0806.title: "Wystrzępione rdzenie"
	quest.42000000002B0807.quest_desc: [
		"Odłamek z załatanej Pozostałości. Oddaj go.",
		"Powtarzalne: oddawaj je, ile chcesz.",
		"Jak: otwórz zapieczętowaną szczelinę Twierdzy Kluczem wątku i załataj Pozostałość w środku."
	]
	quest.42000000002B0807.title: "Odłamek szczeliny"
	quest.42000000002B0808.quest_desc: [
		"Każdy rdzeń jednej Nici. Przynęty tego plemienia kosztują połowę, jego wraki przychodzą trochę częściej, a jego sztandar jest twój."
	]
	quest.42000000002B0808.title: "Cała kolumna"
	quest.42000000002B0809.quest_desc: [
		"Jeden rodzaj miejsca we wszystkich dziewięciu plemionach. Jego ukryte pokoje są już zawsze otwarte."
	]
	quest.42000000002B0809.title: "Cały rząd"
	quest.42000000002B080A.quest_desc: [
		"Ukończ wrak każdego modyfikatora. Twoje wraki trzymają się o ćwierć dłużej."
	]
	quest.42000000002B080A.title: "Sześć stempli"
	quest.42000000002B080B.quest_desc: [
		"Dwadzieścia pięć stron wypełnionych."
	]
	quest.42000000002B080B.title: "Połowa Atlasu"
	quest.42000000002B080C.quest_desc: [
		"Klucz wątku nacięty pod Nić tego wraku otwiera zapieczętowaną szczelinę Twierdzy. W środku coś małego i wystrzępionego przybiera postać Strażnika."
	]
	quest.42000000002B080C.title: "W szczelinę"
	quest.42000000002B080D.quest_desc: [
		"Załataj wszystkie dziewięć Pozostałości. Klucze wątku kosztują połowę."
	]
	quest.42000000002B080D.title: "Wszystkie Pozostałości"
	quest.42000000002B080E.quest_desc: [
		"Wszystkie pięćdziesiąt cztery strony. Gdzieś pod Skies serce starego świata zaczyna dryfować ku tobie."
	]
	quest.42000000002B080E.title: "Każda strona"
	quest.42000000002B080F.quest_desc: [
		"Stań w sercu starego świata i nawlecz je od nowa. Nie przychodzi dwa razy."
	]
	quest.42000000002B080F.title: "Serce splotu"
}
