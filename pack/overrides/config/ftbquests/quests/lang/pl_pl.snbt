	]
	quest.42000000001D048E.title: "Płaszczyzna anihilacji (Sieć)"
	quest.42000000001D048F.quest_desc: [
		"Niesie jeden kanał sieci przez przerwę w ciągu kabla.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D048F.title: "Tunel P2P"
	quest.42000000001D0490.quest_desc: [
		"Składa mały kawałek przestrzeni w przenośną komórkę.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D0490.title: "Przestrzeń 2"
	quest.42000000001D0491.quest_desc: [
		"Przeglądaj magazyn sieci skądkolwiek, ze wzmacniaczem w pobliżu.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D0491.title: "Terminal bezprzewodowy (Sieć)"
	quest.42000000001D0492.quest_desc: [
		"Wytwarzaj z sieci, bez powrotu pieszo do terminala.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D0492.title: "Wytwarzanie bezprzewodowe"
	quest.42000000001D0493.quest_desc: [
		"Strzela kulami materii; naładuj je, zanim będzie potrzebne.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D0493.title: "Działo materii"
	quest.42000000001D0494.quest_desc: [
		"Przezroczysty blok na skorupy kontrolera i ciągi kabli.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D0494.title: "Szkło kwarcowe"
	quest.42000000001D0495.quest_desc: [
		"Szkło, które świeci samo, pochodnia niepotrzebna.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D0495.title: "Jaskrawy kwarc"
	quest.42000000001D0496.quest_desc: [
		"Lity blok magazynu, cztery kryształy skondensowane w jeden.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D0496.title: "Blok Fluix"
	quest.42000000001D0497.quest_desc: [
		"Dzieli komórkę magazynową na kilka mniejszych pul.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001D0497.title: "Warsztat komórek"
	quest.42000000001E0498.quest_desc: [
		"Glina i mączka kostna, krok ku porcelanowym narzędziom.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: kulka gliny + mączka kostna, bez kształtu. Glina pochodzi z Beczki napięcia."
	]
	quest.42000000001E0498.title: "Glina porcelanowa (Rzemiosło Pustki)"
	quest.42000000001E0499.quest_desc: [
		"Lżejsze wiadro, łagodniejsze dla wczesnego budżetu żwiru.",
		"Jak: uformuj z gliny porcelanowej niewypalane wiadro, potem je przetop."
	]
	quest.42000000001E0499.title: "Porcelanowe wiadro"
	quest.42000000001E049A.quest_desc: [
		"Topi bloki w ciecz nad ogniem.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E049A.title: "Porcelanowy tygiel (Rzemiosło Pustki)"
	quest.42000000001E049B.quest_desc: [
		"Pierwsza siatka sita; wolna, ale działa.",
		"Jak: dziewięć sznurków w 3x3. Stragan Śpiewaków żwiru sprzedaje siatkę Nici (sznurek) Krosna Pustki, która przesiewa tak samo."
	]
	quest.42000000001E049B.title: "Siatka ze sznurka (Rzemiosło Pustki)"
	quest.42000000001E049C.quest_desc: [
		"Przesiewa szybciej niż sznurek, warto zrobić ulepszenie.",
		"Jak: cztery krzemienie i pięć sznurków w szachownicę. Krzemień jest z żwiru, albo Nić + żwir."
	]
	quest.42000000001E049C.title: "Krzemienna siatka (Rzemiosło Pustki)"
	quest.42000000001E049D.quest_desc: [
		"Solidna średnia siatka do równego przesiewania.",
		"Jak: cztery sztabki żelaza i pięć sznurków w szachownicę. Żaden stragan tego nie sprzedaje."
	]
	quest.42000000001E049D.title: "Żelazna siatka (Voidcraft)"
	quest.42000000001E049E.quest_desc: [
		"Daje rzadsze łupy niż żelazo.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E049E.title: "Złota siatka (Voidcraft)"
	quest.42000000001E049F.quest_desc: [
		"Przesiewa dość szybko, by karmić rząd lejów.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E049F.title: "Diamentowa siatka (Voidcraft)"
	quest.42000000001E04A0.quest_desc: [
		"Najlepsza siatka, jaką sito kiedykolwiek utrzyma.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04A0.title: "Netherytowa siatka (Voidcraft)"
	quest.42000000001E04A1.quest_desc: [
		"Uprzędziona ze sznurka, własne włókno Krosna.",
		"Jak: cztery sznurki → dwie przędze. Beczka napięcia: sznurek + perła. Cztery Meszki krosna."
	]
	quest.42000000001E04A1.title: "Zapas Przędzy Pustki"
	quest.42000000001E04A2.quest_desc: [
		"Miękka brama Krosna: słupy, prasy i kontrolery, każdy chce jednego.",
		"Jak: pierścień Przędzy Pustki wokół kulki szlamu."
	]
	quest.42000000001E04A2.title: "Zapas Węzła wiążącego"
	quest.42000000001E04A3.quest_desc: [
		"Wersja Krosna Pustki podstawowej siatki sita.",
		"Jak: sznurek wokół przędzy. Stragan Śpiewaków żwiru sprzedaje jedną."
	]
	quest.42000000001E04A3.title: "Siatka Nici (sznurek)"
	quest.42000000001E04A4.quest_desc: [
		"Siatka Krosna Pustki, szczebel wyżej niż zwykły sznurek.",
		"Jak: krzemień wokół siatki Nici (sznurek)."
	]
	quest.42000000001E04A4.title: "Siatka Nici (krzemień)"
	quest.42000000001E04A5.quest_desc: [
		"Siatka Krosna Pustki, zrobiona pod równy uzysk.",
		"Jak: żelazo wokół siatki Nici (krzemień). Tu zaczyna się Włókno Nici."
	]
	quest.42000000001E04A5.title: "Siatka Nici (żelazo)"
	quest.42000000001E04A6.quest_desc: [
		"Rozbija grys o stopień drobniej: bruk w żwir, żwir w piasek, piasek w pył.",
		"Jak: bruk + patyki. Rozbij grys na żwir, piasek i pył."
	]
	quest.42000000001E04A6.title: "Młot wrzeciona (Voidcraft)"
	quest.42000000001E04A7.quest_desc: [
		"Zdziera liście po sadzonki i jedwabniki.",
		"Jak: cztery patyki. Stragan Śpiewaków żwiru sprzedaje jeden."
	]
	quest.42000000001E04A7.title: "Pastorał wrzeciona"
	quest.42000000001E04A8.quest_desc: [
		"Rama sita Krosna: naciągnij na nią siatkę i karm grysem.",
		"Jak: deski wokół Węzła wiążącego. Naciągnij siatkę, podaj grys lejem i postaw ją na leju."
	]
	quest.42000000001E04A8.title: "Rama krosna"
	quest.42000000001E04A9.quest_desc: [
		"Woda i ziemia stają się gliną; sznurek i perła stają się przędzą.",
		"Jak: deski, sznurek i Przędza Pustki. Wlej wodę (wiadro wraca), dodaj ziemię → glina."
	]
	quest.42000000001E04A9.title: "Beczka napięcia (Voidcraft)"
	quest.42000000001E04AA.quest_desc: [
		"Dziewięć bloków ziemi złożonych w jeden, na drogę w górę.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04AA.title: "Sprasowana ziemia"
	quest.42000000001E04AB.quest_desc: [
		"Dziewięć bruku ściśnięte ciasno, tanio i bez końca.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04AB.title: "Sprasowany bruk (Voidcraft)"
	quest.42000000001E04AC.quest_desc: [
		"Dziewięć żwiru ubite; sprasowane sito bierze to w całości.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04AC.title: "Sprasowany żwir"
	quest.42000000001E04AD.quest_desc: [
		"Dziewięć bloków piasku sprasowanych w jeden, do dźwigania.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04AD.title: "Sprasowany piasek"
	quest.42000000001E04AE.quest_desc: [
		"Dziewięć bloków pyłu sprasowanych, z tego samego powodu.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04AE.title: "Sprasowany pył"
	quest.42000000001E04AF.quest_desc: [
		"Kamień Netheru ubity, dla lżejszego ekwipunku.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04AF.title: "Sprasowany Netherrack"
	quest.42000000001E04B0.quest_desc: [
		"Kamień Endu ubity, przydatny, gdy pustkę trzeba nakarmić.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04B0.title: "Sprasowany kamień Endu"
	quest.42000000001E04B1.quest_desc: [
		"Łupek ubity, dziewięć do jednego, a to wciąż tylko kamień.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04B1.title: "Sprasowany łupek"
	quest.42000000001E04B2.quest_desc: [
		"Rozbija naraz cały stos sprasowanych bloków.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04B2.title: "Sprasowany młot"
	quest.42000000001E04B3.quest_desc: [
		"Słabszy młot do rozbijania sprasowanych bloków.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04B3.title: "Sprasowany żelazny młot"
	quest.42000000001E04B4.quest_desc: [
		"Szerokie sito, kilka hałd żwiru naraz.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04B4.title: "Sprasowane sito (Voidcraft)"
	quest.42000000001E04B5.quest_desc: [
		"Przesiewa jak dębowe, tylko inne usłojenie.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04B5.title: "Brzozowe sito"
	quest.42000000001E04B6.quest_desc: [
		"Fermentuje tak samo jak każda inna beczka.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04B6.title: "Brzozowa beczka"
	quest.42000000001E04B7.quest_desc: [
		"Topi bloki tak samo jak każdy inny tygiel.",
		"Jak: sito, młot, tygiel albo beczka Ex Deorum. Dopasuj siatkę do grysu."
	]
	quest.42000000001E04B7.title: "Brzozowy tygiel"
	quest.42000000001E04B8.quest_desc: [
		"Waluta Nici: zarabiaj, wydawaj, nigdy nie marnuj.",
		"Jak: nagrody z zadań, ziemia z krzemienną siatką na Ramie krosna, skrytki zarządcy."
	]
	quest.42000000001E04B8.title: "Zapas Wystrzępionej nici"
	quest.42000000001E04B9.quest_desc: [
		"Strony archiwum i notatki.",
		"Jak: osadź Nić przy Słupie albo na straganie Rzeźbiarzy pieczęci w /clowder hub (8 Nić). Prawy przycisk, by czytać; zostają, nie są wydawane."
	]
	quest.42000000001E04B9.title: "Strony kodeksu"
	quest.42000000001E04BA.quest_desc: [
		"Prawy przycisk i otwórz Zacznij tutaj. Grawis (`): lista zadań. Książka nie przydziela zadań.",
		"Jak: zestaw startowy / skrzynia doku. Prawy przycisk na książkę; grawis (`) to lista zadań."
	]
	quest.42000000001E04BA.title: "Kodeks Wąsów"
	quest.42000000001F04BB.quest_desc: [
		"Papier w paczce, zanim zostanie szczelnie zamknięta.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: sztabki złota i deski wokół Oka Endera. Pierwsza receptura Packaged Auto."
	]
	quest.42000000001F04BB.title: "Składnik paczki"
	quest.42000000001F04BC.quest_desc: [
		"Opakowanie paczki zbudowane zamiast tego wokół zapisanego wzorca.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04BC.title: "Komponent paczki ME"
	quest.42000000001F04BD.quest_desc: [
		"Pieczętuje przedmioty w paczkę, żeby linia je ruszyła.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04BD.title: "Pakowarka (pakowana)"
	quest.42000000001F04BE.quest_desc: [
		"Dodaje pakowarce kolejne miejsce pakowania.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04BE.title: "Rozszerzenie pakowarki"
	quest.42000000001F04BF.quest_desc: [
		"Otwiera paczkę z powrotem na luźne przedmioty.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04BF.title: "Rozpakowywarka"
	quest.42000000001F04C0.quest_desc: [
		"Zapisuje przepis wytwarzania na wzorzec paczki.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04C0.title: "Koder"
	quest.42000000001F04C1.quest_desc: [
		"Składa paczkę według jej zakodowanego przepisu.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04C1.title: "Wytwarzacz"
	quest.42000000001F04C2.quest_desc: [
		"Kieruje paczki pod ten adres, który pasuje.",
		"Jak: Znacznik dystrybutora, komponent pakowania, dwie Skorupy shulkera, cztery perły Endera i blok żelaza. Skorupy: przepis modpaka, sześć bloków purpuru, dwie perły Endera i Węzeł wiążący."
	]
	quest.42000000001F04C2.title: "Dystrybutor"
	quest.42000000001F04C3.quest_desc: [
		"Oznacza cel, do którego dystrybutor może wysyłać paczki.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04C3.title: "Znacznik dystrybutora"
	quest.42000000001F04C4.quest_desc: [
		"Podaje gotowe paczki na linię do odbioru.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04C4.title: "Dostawca pakowania"
	quest.42000000001F04C5.quest_desc: [
		"Pozwala dalekiemu wytwarzaczowi zamawiać przez ten blok.",
		"Jak: Znacznik pośrednika, komponent pakowania, dwie Skorupy shulkera, dwie perły Endera, dwa płaczące obsydiany i blok żelaza. Skorupy: przepis modpaka, sześć bloków purpuru, dwie perły Endera i Węzeł wiążący."
	]
	quest.42000000001F04C5.title: "Pośrednik wytwarzania"
	quest.42000000001F04C6.quest_desc: [
		"Trzyma zestaw przepisów na paczki do ponownego użycia.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04C6.title: "Uchwyt przepisów"
	quest.42000000001F04C7.quest_desc: [
		"Kopiuje ustawienia jednego bloku na drugi i oszczędza mnóstwo klikania.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04C7.title: "Kloner ustawień"
	quest.42000000001F04C8.quest_desc: [
		"Napełnia paczkę płynem zamiast przedmiotów.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04C8.title: "Napełniacz paczek płynu"
	quest.42000000001F04C9.quest_desc: [
		"Zapieczętowana wiązka przedmiotów, gotowa do przeniesienia albo schowania.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04C9.title: "Przedmiot-paczka"
	quest.42000000001F04CA.quest_desc: [
		"Pakuje w jedną paczkę o wiele więcej niż zwykły rodzaj.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04CA.title: "Paczka objętości"
	quest.42000000001F04CB.quest_desc: [
		"Oznacza, dokąd ma sięgać pośrednik wytwarzania.",
		"Jak: komponent paczki, potem Pakowarka / Koder. Do części ME potrzeba sieci AE2."
	]
	quest.42000000001F04CB.title: "Znacznik pośrednika"
	quest.42000000001F04CC.quest_desc: [
		"Łączy linię pakowania z cyfrowym krosnem.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001F04CC.title: "Interfejs AE"
	quest.42000000001F04CD.quest_desc: [
		"Dostarcza wzorce wytwarzania na linię pakowania.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001F04CD.title: "Dostawca wzorców (pakowany)"
	quest.42000000001F04CE.quest_desc: [
		"Wytwarza przedmioty pod własne wzorce cyfrowego krosna.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001F04CE.title: "Asembler molekularny (pakowany)"
	quest.42000000001F04CF.quest_desc: [
		"Najpierw sieć cyfrowego krosna, bo inaczej to pakowanie nie ruszy.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001F04CF.title: "Kontroler ME"
	quest.42000000001F04D0.quest_desc: [
		"Prowadź energię albo sygnały.",
		"Jak: Sieć Wrzeciona — Certus z piasku, kontroler chce Węzła wiążącego."
	]
	quest.42000000001F04D0.title: "Kabel Fluix (pakowany)"
	quest.42000000001F04D1.quest_desc: [
		"Pakuje przedmioty po stronie Create, mechanicznie.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.42000000001F04D1.title: "Pakowarka Create"
	quest.42000000001F04D2.quest_desc: [
		"Zbiera rozdzielone paczki z powrotem w całe zamówienia.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.42000000001F04D2.title: "Przepakowarka Create"
	quest.42000000001F04D3.quest_desc: [
		"Zamawia zapakowane przedmioty z powiązanej sieci zapasów.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.42000000001F04D3.title: "Ticker zapasów (pakowany)"
	quest.42000000001F04D4.quest_desc: [
		"Duża skrzynia buforowa dla paczek czekających na swoją kolej.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.42000000001F04D4.title: "Skarbiec przedmiotów (pakowany)"
	quest.42000000002004D5.quest_desc: [
		"Podstawowy kwantowy dysk magazynowy dla sieci QIO.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004D5.title: "Baza dysku QIO"
	quest.42000000002004D6.quest_desc: [
		"Pakuje o wiele więcej miejsca na jeden dysk kwantowy.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004D6.title: "QIO hipergęsty"
	quest.42000000002004D7.quest_desc: [
		"Dysk kwantowy, który zamienia rozmiar na surową gęstość.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004D7.title: "QIO dylatacja czasu"
	quest.42000000002004D8.quest_desc: [
		"Największy dysk kwantowy, jaki wytwarza Mekanism.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004D8.title: "QIO supermasywny"
	quest.42000000002004D9.quest_desc: [
		"Trzyma kilka dysków kwantowych w jednej obudowie.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004D9.title: "Macierz napędów QIO"
	quest.42000000002004DA.quest_desc: [
		"Przejrzyj wszystko, co trzyma sieć QIO.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004DA.title: "Panel QIO"
	quest.42000000002004DB.quest_desc: [
		"Nosi panel QIO w twojej kieszeni.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004DB.title: "Przenośny QIO"
	quest.42000000002004DC.quest_desc: [
		"Podstawowa obudowa większości zaawansowanych maszyn Mekanism.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004DC.title: "Stalowa obudowa (QIO)"
	quest.42000000002004DD.quest_desc: [
		"Trzyma ogromny zapas mocy w jednym bloku.",
		"Rzadka nagroda: jedno wspólne życie Clowder, raz dla całej drużyny. W kampanii jest tylko sześć takich nagród.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004DD.title: "Absolutna kostka"
	quest.42000000002004DE.quest_desc: [
		"Trzyma ogromny stos jednego jedynego przedmiotu.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004DE.title: "Absolutny pojemnik"
	quest.42000000002004DF.quest_desc: [
		"Przetapia kilka stosów naraz, tak szybko, jak tylko potrafi Mekanism.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004DF.title: "Absolutna fabryka wytopu"
	quest.42000000002004E0.quest_desc: [
		"Wzbogaca rudę z największą prędkością, jaką daje Mekanism.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E0.title: "Absolutna fabryka wzbogacania"
	quest.42000000002004E1.quest_desc: [
		"Kruszy rudę z największą prędkością, jaką daje Mekanism.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E1.title: "Absolutna fabryka kruszenia"
	quest.42000000002004E2.quest_desc: [
		"Sam wykopuje cały chunk, prosto w pustkę.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E2.title: "Cyfrowy górnik (QIO)"
	quest.42000000002004E3.quest_desc: [
		"Modułowe narzędzie, które samo zmienia swoją głowicę.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E3.title: "Atomowy rozbieracz (QIO)"
	quest.42000000002004E4.quest_desc: [
		"Obraca ściany i kopiuje ustawienia między maszynami Mekanism.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E4.title: "Konfigurator (QIO)"
	quest.42000000002004E5.quest_desc: [
		"Przenosi cię natychmiast między dwiema połączonymi podstawami.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E5.title: "Teleporter (QIO)"
	quest.42000000002004E6.quest_desc: [
		"Obramowuje portal, który otwiera teleporter.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E6.title: "Rama teleportera"
	quest.42000000002004E7.quest_desc: [
		"Obudowa reaktora, który wytwarza antymaterię.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E7.title: "Obudowa SPS"
	quest.42000000002004E8.quest_desc: [
		"Podaje chemikalia i wyciąga antymaterię z reaktora.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E8.title: "Port SPS"
	quest.42000000002004E9.quest_desc: [
		"Przyspiesza uzysk reaktora antymaterii.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004E9.title: "Cewka superładowana"
	quest.42000000002004EA.quest_desc: [
		"Rozkręca izotopy osobno, do późnej chemii.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004EA.title: "Wirówka izotopowa"
	quest.42000000002004EB.quest_desc: [
		"Rozpuszcza rudę w chemiczną papkę.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004EB.title: "Rozpuszczanie chemiczne"
	quest.42000000002004EC.quest_desc: [
		"Myje papkę do czysta, zanim zostanie skrystalizowana.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004EC.title: "Płuczka chemiczna"
	quest.42000000002004ED.quest_desc: [
		"Zamienia substancję znów w stały kryształ.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004ED.title: "Krystalizator chemiczny"
	quest.42000000002004EE.quest_desc: [
		"Bombarduje materiał neutronami napędzanymi światłem słońca.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004EE.title: "Neutron słoneczny"
	quest.42000000002004EF.quest_desc: [
		"Zamienia moc wprost w ciepło dla kotła.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004EF.title: "Grzałka oporowa"
	quest.42000000002004F0.quest_desc: [
		"Spala drewno na ciepło, a nie na moc.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F0.title: "Grzałka na drewno"
	quest.42000000002004F1.quest_desc: [
		"Późna synteza materiałów, które inaczej byłyby niemożliwe.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F1.title: "Antyprotonowy"
	quest.42000000002004F2.quest_desc: [
		"Jedno modułowe narzędzie do wydobycia, kopania i nie tylko.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F2.title: "Narzędzie Meka"
	quest.42000000002004F3.quest_desc: [
		"Pancerz kombinezonu na głowę, ulepszany moduł po module.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F3.title: "Hełm Meka"
	quest.42000000002004F4.quest_desc: [
		"Pancerz kombinezonu na klatkę, ulepszany moduł po module.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F4.title: "Napierśnik Meka"
	quest.42000000002004F5.quest_desc: [
		"Pancerz kombinezonu na nogi, ulepszany moduł po module.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F5.title: "Spodnie Meka"
	quest.42000000002004F6.quest_desc: [
		"Pancerz kombinezonu na stopy, ulepszany moduł po module.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F6.title: "Buty Meka"
	quest.42000000002004F7.quest_desc: [
		"Skorupa do kotła parowego.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F7.title: "Obudowa kotła"
	quest.42000000002004F8.quest_desc: [
		"Przechowuje dużą ilość mocy.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F8.title: "Elitarna kostka energii"
	quest.42000000002004F9.quest_desc: [
		"Przechowuje umiarkowaną ilość mocy.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004F9.title: "Zaawansowana kostka energii"
	quest.42000000002004FA.quest_desc: [
		"Przechowuje mało mocy, dobre na początek.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004FA.title: "Podstawowa kostka energii (QIO)"
	quest.42000000002004FB.quest_desc: [
		"Nasącza metal chemikalią, by powstały nowe stopy.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004FB.title: "Infuzor metalurgiczny (QIO)"
	quest.42000000002004FC.quest_desc: [
		"Podwaja plon surowej rudy, zanim ją przetopisz.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004FC.title: "Komora wzbogacania (QIO)"
	quest.42000000002004FD.quest_desc: [
		"Miel albo krusz materiały luzem.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004FD.title: "Kruszarka (QIO)"
	quest.42000000002004FE.quest_desc: [
		"Przetapia szybciej niż piec, energią zamiast paliwa.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004FE.title: "Energetyczna wytapiarka (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Tnie drewno własnym precyzyjnym ostrzem Mekanism.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000002004FF.title: "Precyzyjny tartak"
	quest.4200000000200500.quest_desc: [
		"Rozdziela wodę na dwa składowe gazy.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.4200000000200500.title: "Separator elektrolityczny"
	quest.4200000000200501.quest_desc: [
		"Łączy dwie chemikalia w jedną nową.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.4200000000200501.title: "Infuzor chemiczny"
	quest.4200000000200502.quest_desc: [
		"Oczyść płyny albo rudy.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.4200000000200502.title: "Oczyszczanie"
	quest.4200000000200503.quest_desc: [
		"Wtryskuje chemikalię w rudę dla większego plonu.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.4200000000200503.title: "Wtrysk chemiczny"
	quest.4200000000200504.quest_desc: [
		"Sprasowuje osm na przedmioty, by sprzęt był twardszy.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.4200000000200504.title: "Kompresor osmu (QIO)"
	quest.4200000000200505.quest_desc: [
		"Składa kilka części w jeden gotowy element.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.4200000000200505.title: "Łącznik"
	quest.4200000000210506.quest_desc: [
		"Zombie to upuszczają, czy chcesz, czy nie.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: zabijaj zombie na platformie nocą albo w ciemnej dziurze."
	]
	quest.4200000000210506.title: "Zapas zgniłego mięsa"
	quest.4200000000210507.quest_desc: [
		"Szkielety zostawiają je; zmiel później na mączkę kostną.",
		"Jak: szkielety w nocy, albo /clowder hub Strażnicy platformy (16 Nić za 8)."
	]
	quest.4200000000210507.title: "Zapas kości"
	quest.4200000000210508.quest_desc: [
		"Creepery wypłacają to, czasem wybuchowo.",
		"Jak: przesiej pył albo piasek dusz, albo creepery na platformie nocą. Trzymaj krawędzie oświetlone, gdy już trochę masz."
	]
	quest.4200000000210508.title: "Zapas prochu"
	quest.4200000000210509.quest_desc: [
		"Pająki to upuszczają, a sito nigdy.",
		"Jak: rozpruj Wystrzępioną nić (1 → 3). Pająki. Meszek krosna przy Echo-wiązaniu. Odwrotny upust przędzy."
	]
	quest.4200000000210509.title: "Zapas sznurka"
	quest.420000000021050A.quest_desc: [
		"Warzy się w truciznę i zasila kilka dziwnych przepisów.",
		"Jak: pająki na platformie w nocy."
	]
	quest.420000000021050A.title: "Zapas oczu pająka"
	quest.420000000021050B.quest_desc: [
		"Endermany je upuszczają; farma bije żebranie o nie u pustki.",
		"Jak: endermany, albo stragan Chodzących po krawędzi w /clowder hub."
	]
	quest.420000000021050B.title: "Farma pereł Endera"
	quest.420000000021050C.quest_desc: [
		"Paliwo i dla statywów alchemicznych, i dla płomiennych palników.",
		"Jak: forteca Netheru po obsydianie Pazura. Warzenie chce różdżki; Ars i Occultism na nią nie czekają."
	]
	quest.420000000021050C.title: "Farma płomiennych różdżek"
	quest.420000000021050D.quest_desc: [
		"Rzadki łup, klucz do mikstur regeneracji.",
		"Jak: ghasty Netheru po obsydianie Pazura."
	]
	quest.420000000021050D.title: "Farma łez ghasta"
	quest.420000000021050E.quest_desc: [
		"Warzy się w odporność na ogień i zasila kilka wytworów.",
		"Jak: kula szlamu wrzucona do beczki lawy, szlam plus płomienny proszek albo magmowe sześciany."
	]
	quest.420000000021050E.title: "Farma magmowego kremu"
	quest.420000000021050F.quest_desc: [
		"Dość lepki na tłoki, bloki szlamu i smycze.",
		"Jak: dwie ziemie + nasiona pszenicy + mączka kostna (kompost platformy), albo /clowder hub Strażnicy platformy."
	]
	quest.420000000021050F.title: "Farma kulek szlamu"
	quest.4200000000210510.quest_desc: [
		"Trzy z nich przywołują bossa, o którego warto walczyć.",
		"Jak: forteca Netheru po obsydianie Pazura. Trzy czaszki zaczynają Withera."
	]
	quest.4200000000210510.title: "Czaszka witherowego szkieletu"
	quest.4200000000210511.quest_desc: [
		"Własny podatek withera, rzadki i ciężki od mocy.",
		"Jak: Wither (trzy czaszki na piasku dusz), albo stragan Bębnoserc przy /clowder hub raz, za 12 Zwojów Nici (972 Nici). Opcjonalne trofeum — nie blokuje Endu ani Farmy potworów na 100%."
	]
	quest.4200000000210511.title: "Gwiazda Netheru"
	quest.4200000000210512.quest_desc: [
		"Tworzy skrzynię shulkera, schowek, który przeżywa śmierć.",
		"Opcjonalne — tu nie ma shulkerów, więc paczka wytwarza skorupy.",
		"Jak: przepis modpaka, sześć bloków purpuru, dwie perły Endera i Węzeł wiążący. Shulkery nigdy tu się nie pojawiają. Opcjonalne."
	]
	quest.4200000000210512.title: "Farma skorup shulkera"
	quest.4200000000210513.quest_desc: [
		"Naprawia elytry, gdy nic innego nie da rady.",
		"Jak: pomiń sen przez trzy noce, potem zabij fantomy. Opcjonalne."
	]
	quest.4200000000210513.title: "Błona fantoma"
	quest.4200000000210514.quest_desc: [
		"Atrament kałamarnicy, przydatny do barwienia i staroświeckiego pisania.",
		"Jak: węgiel drzewny plus szklana butelka. Kałamarnice nigdy się tu nie pojawiają."
	]
	quest.4200000000210514.title: "Farma worków z atramentem"
	quest.4200000000210515.quest_desc: [
		"Sprawia, że tabliczki i ramki świecą w ciemności.",
		"Jak: świecące kałamarnice nigdy nie pojawiają się na platformie. Opcjonalne."
	]
	quest.4200000000210515.title: "Świecący atrament"
	quest.4200000000210516.quest_desc: [
		"Strażnicy upuszczają go, by zrobić bloki pryzmarynu i latarnie.",
		"Jak: oceaniczne monumenty zniknęły. Opcjonalne, chyba że wyhodujesz nasiono pryzmarynu."
	]
	quest.4200000000210516.title: "Odłamek pryzmarynu"
	quest.4200000000210517.quest_desc: [
		"Łup strażnika, który rozświetla morze i zasila kilka receptur.",
		"Jak: oceaniczne monumenty zniknęły. Opcjonalne."
	]
	quest.4200000000210517.title: "Kryształ pryzmarynu"
	quest.4200000000210518.quest_desc: [
		"Otacza przekaźnik; zbierz osiem, by domknąć ramę.",
		"Opcjonalne — pustka może nigdy go nie dać.",
		"Jak: tylko ocean. Opcjonalnie."
	]
	quest.4200000000210518.title: "Muszla łodzika (Polowanie)"
	quest.4200000000210519.quest_desc: [
		"Raz oszukuje śmierć, a potem znika.",
		"Jak: tylko nagrody zadań. Osadź Zegar i Osadź Pieczęć dają po jednym, a dary późnych Węzłów Nici dają więcej. Rajdy i przywoływacze nigdy nie przychodzą na platformę. Opcjonalnie."
	]
	quest.4200000000210519.title: "Totem (Polowanie)"
	quest.420000000021051A.quest_desc: [
		"Golemy gubią żelazo, stojąc na straży.",
		"Jak: przetop surowe żelazo / grys żelaza (piec albo Piec żaru). Przesiej żwir po kawałki."
	]
	quest.420000000021051A.title: "Dar żelaznego golema"
	quest.420000000021051B.quest_desc: [
		"Rzuca śnieżkami; przydatna amunicja, z wojownika niewiele.",
		"Jak: jeden lód (zestaw / generator lodu), bezkształtnie, w cztery śnieżki."
	]
	quest.420000000021051B.title: "Śnieżny golem"
	quest.420000000021051C.quest_desc: [
		"Szkielety trzymają platformę zaopatrzoną w amunicję.",
		"Jak: krzemień, patyk, pióro. Szkielety zostawiają nadmiar."
	]
	quest.420000000021051C.title: "Farma strzał"
	quest.420000000021051D.quest_desc: [
		"Znaczy wszystko, w co trafi, chwilowym blaskiem.",
		"Jak: pył świetlokamienia wokół strzały."
	]
	quest.420000000021051D.title: "Widmowa strzała"
	quest.420000000021051E.quest_desc: [
		"Wsiądź, gdy znajdziesz siodło.",
		"Opcjonalne — Strażnicy platformy w Sali Clowder sprzedają jedno.",
		"Jak: wymień blok diamentu u Strażników platformy w ich sklepie w Sali Clowder (/clowder hub). Siodło Chocobo to inny przedmiot."
	]
	quest.420000000021051E.title: "Siodło (Polowanie)"
	quest.420000000021051F.quest_desc: [
		"Nazywa moba, żeby nigdy nie zniknął.",
		"Opcjonalne — Rzeźbiarze pieczęci w Sali Clowder sprzedają jeden.",
		"Jak: łowienie / rzadkie skrzynie, albo stragan Rzeźbiarzy pieczęci w /clowder hub (24 Nić). Opcjonalnie."
	]
	quest.420000000021051F.title: "Farma znaczników"
	quest.4200000000210520.quest_desc: [
		"Uwiązuje ogniwo albo kabel.",
		"Jak: cztery sznurki wokół kulki szlamu. Szlam to kompost platformy (ziemia, nasiona, mączka kostna)."
	]
	quest.4200000000210520.title: "Smycz (Polowanie)"
	quest.4200000000210521.quest_desc: [
		"Kury znoszą je szybciej, niż zdążysz je zbierać.",
		"Jak: nasiona pszenicy kurom na platformie, albo kurnik z rozdziału Farma potworów."
	]
	quest.4200000000210521.title: "Zapas jaj"
	quest.4200000000210522.quest_desc: [
		"Zapas skóry i wołowiny.",
		"Jak: przetop zgniłe mięso albo upiecz je na ognisku. Przesiej ziemię krzemienną siatką. /clowder hub Strażnicy platformy sprzedają dwie za 18 Nić."
	]
	quest.4200000000210522.title: "Zapas skóry"
	quest.4200000000210523.quest_desc: [
		"Owce odrastają ją po strzyżeniu.",
		"Jak: ostrzyż owce po daniu trawy albo cztery sznurki."
	]
	quest.4200000000210523.title: "Zapas wełny"
	quest.4200000000210524.quest_desc: [
		"Zapas jedzenia do kuchni.",
		"Jak: pszenica krowom na platformie."
	]
	quest.4200000000210524.title: "Zapas wołowiny"
	quest.4200000000210525.quest_desc: [
		"Świnie ją dają; ugotuj, zanim zjesz.",
		"Jak: ziemniaki albo marchewki świniom na platformie."
	]
	quest.4200000000210525.title: "Zapas wieprzowiny"
	quest.4200000000210526.quest_desc: [
		"Kurczak do posiłków i piór.",
		"Jak: nasiona kurom na platformie."
	]
	quest.4200000000210526.title: "Zapas kurczaka"
	quest.4200000000210527.quest_desc: [
		"Baranina, lepsza pieczona niż surowa.",
		"Jak: pszenica owcom na platformie."
	]
	quest.4200000000210527.title: "Zapas baraniny"
	quest.4200000000210528.quest_desc: [
		"Warzy miksturę szczęścia, jeśli możesz jedną oddać.",
		"Opcjonalne — pustka może nigdy go nie dać.",
		"Jak: króliki nie pojawiają się na platformie. Opcjonalne."
	]
	quest.4200000000210528.title: "Królicza łapka"
	quest.4200000000210529.quest_desc: [
		"Eksponat wart postawienia obok jajka smoka.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000210529.title: "Głowa zombie"
	quest.420000000021052A.quest_desc: [
		"Dobrze pasuje do jajka smoka na półce.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000021052A.title: "Czaszka szkieleta"
	quest.420000000021052B.quest_desc: [
		"Kolejna głowa na półkę trofeów, przy jajku.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000021052B.title: "Głowa creepera"
	quest.420000000021052C.quest_desc: [
		"Jeszcze jedna głowa, u siebie przy jajku smoka.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000021052C.title: "Głowa piglina"
	quest.420000000021052D.quest_desc: [
		"Najrzadsza głowa, zdobyta dopiero gdy walka się kończy.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000021052D.title: "Głowa smoka"
	quest.420000000021052E.quest_desc: [
		"Tylko jeśli graczowi zdarzy się jedną upuścić.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.420000000021052E.title: "Głowa gracza"
	quest.420000000022052F.quest_desc: [
		"Pierwsze wytworzenie daje 2 — zostaw jeden na Kodeks później.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: jedna kość, sznurek, ametyst. /clowder hub Strażnicy platformy sprzedają kości. Brama Iskra / Pomruk."
	]
	quest.420000000022052F.title: "Kościany dzwonek"
	quest.4200000000220530.quest_desc: [
		"Odłamek starej pieśni plemienia — trzeba Kościanego dzwonka.",
		"Jak: Kościany dzwonek, ametyst i redstone, bez kształtu. Daje dwa."
	]
	quest.4200000000220530.title: "Duchowy odłamek"
	quest.4200000000220531.quest_desc: [
		"Nastrój metal na ducha — miedź wokół Kościanego dzwonka.",
		"Jak: miedź wokół Kościanego dzwonka. Daje dwa."
	]
	quest.4200000000220531.title: "Miedziany rezonator"
	quest.4200000000220532.quest_desc: [
		"Zaznacz linie kraty — kreda potrzebuje Odłamka.",
		"Jak: dwie mączki kostne, lazuryt i Duchowy odłamek, bez kształtu. Daje cztery."
	]
	quest.4200000000220532.title: "Kreda rytualna (plemienna)"
	quest.4200000000220533.quest_desc: [
		"Postaw serce — dwa Kościane dzwonki, Duchowy odłamek, dwie skóry i cztery deski (Strażnicy platformy sprzedają skórę).",
		"Jak: dwa Kościane dzwonki, jeden Duchowy odłamek, dwie skóry i cztery deski. Uderz z pustymi rękami w rytm (17–23 ticków) za 24 Pulsu."
	]
	quest.4200000000220533.title: "Uderzenie Bębnoserca"
	quest.4200000000220534.quest_desc: [
		"Dziewięć plemion raz zanuciło — potrzeba zapasowego Dzwonka i Odłamka.",
		"Jak: wytwórz albo weź jako nagrodę Iskry/Plemiennego splotu. Prawy klik: jak działa krata."
	]
	quest.4200000000220534.title: "Kodeks Duchów"
	quest.4200000000220535.quest_desc: [
		"Wciągnij ley w uderzenia.",
		"Jak: postaw pod niebem, blisko wody/zieleni. Wolny Puls. Drabina Iskry."
	]
	quest.4200000000220535.title: "Kolektor ley"
	quest.4200000000220536.quest_desc: [
		"Niesie Puls do narzędzi, zaklęć i podróży. Napełnij je przy Bębnosercu.",
		"Jak: wytwórz, potem napełnij z Bębnoserca (klik komórką). Narzędzia, zaklęcia i podróż czerpią z komórki."
	]
	quest.4200000000220536.title: "Ogniwo pulsu"
	quest.4200000000220537.quest_desc: [
		"Osadź katalizator Echa, który zużywa się w pracy; dodaj dwa różne głosy totemów w promieniu ośmiu bloków. Więcej głosów wzmacnia pieśń. Redstone wstrzymuje go.",
		"Jak: osadź katalizator echa i dwa różne totemy w zasięgu 8. Redstone go wstrzymuje."
	]
	quest.4200000000220537.title: "Rezonator pulsu"
	quest.4200000000220538.quest_desc: [
		"Plemię kamienia odpowiada.",
		"Jak: Kościany dzwonek, dwa pnie, ziemia i Miedziany rezonator."
	]
	quest.4200000000220538.title: "Totem Ziemi"
	quest.4200000000220539.quest_desc: [
		"Plemię płomienia odpowiada.",
		"Jak: Kościany dzwonek, dwa pnie, węgiel drzewny i Miedziany rezonator."
	]
	quest.4200000000220539.title: "Totem Ognia"
	quest.420000000022053A.quest_desc: [
		"Plemię przypływu odpowiada.",
		"Jak: Kościany dzwonek, dwa pnie, wiadro wody (albo porcelanowe wiadro wody) i Miedziany rezonator."
	]
	quest.420000000022053A.title: "Totem Wody"
	quest.420000000022053B.quest_desc: [
		"Plemię wiatru odpowiada.",
		"Jak: Kościany dzwonek, dwa pnie, pióro i Miedziany rezonator."
	]
	quest.420000000022053B.title: "Totem Powietrza"
	quest.420000000022053C.quest_desc: [
		"Piąte plemię — rdzeń zarządcy.",
		"Jak: Kościany dzwonek, dwa pnie, Duchowy odłamek i Miedziany rezonator."
	]
	quest.420000000022053C.title: "Totem Ducha"
	quest.420000000022053D.quest_desc: [
		"Zacznij pieśń kraty. Czeka na kamień albo przedmiot etapu Echa; surowy metal to grys w Echołamaczu.",
		"Jak: Kodeks Duchów + Plemienny splot. Osadź kamień albo przedmiot etapu Echa. Surowy metal należy do Echołamacza."
	]
	quest.420000000022053D.title: "Ława pieśni"
	quest.420000000022053E.quest_desc: [
		"Prowadź harmoniczne między totemami.",
		"Jak: cztery Miedziane rezonatory wokół redstone. Robi cztery."
	]
	quest.420000000022053E.title: "Przewodnik kraty"
	quest.420000000022053F.quest_desc: [
		"Zanuć etap pierwszy — krusz rudę. Kamień staje się odłamkami; bruk żwirem; surowy metal grysem. Kruszenie grysu trwa 4 sekundy przy 40 Puls/s.",
		"Jak: kamień + Kościany dzwonek + Miedziany rezonator. Totem Ziemi w zasięgu 8. Kamień → odłamki; bruk → żwir; surowy metal → grys. Cztery sekundy przy 40 Puls/s."
	]
	quest.420000000022053F.title: "Echołamacz"
	quest.4200000000220540.quest_desc: [
		"Odłamek, który usłyszał kruszenie.",
		"Jak: kamień w Echołamaczu (nie bruk). Kamień stopnia Źródła, albo kamień z jedwabnym dotykiem."
	]
	quest.4200000000220540.title: "Odłamek echa (plemienny)"
	quest.4200000000220541.quest_desc: [
		"Zanuć etap drugi — dostrój.",
		"Jak: siedem kamieni, Duchowy odłamek i Miedziany rezonator."
	]
	quest.4200000000220541.title: "Dostrojenie echa"
	quest.4200000000220542.quest_desc: [
		"Echo, które znalazło klucz.",
		"Jak: Kodeks Duchów + Plemienny splot. Stacja, totem i koszt Pulsu są na stronie Kodeksu."
	]
	quest.4200000000220542.title: "Dostrojone echo"
	quest.4200000000220543.quest_desc: [
		"Etap wiązania — zawiąż ducha na metal.",
		"Jak: siedem kamieni, odłamek ametystu i Miedziany rezonator."
	]
	quest.4200000000220543.title: "Więź echa"
	quest.4200000000220544.quest_desc: [
		"Echo, które się nie ześlizgnie.",
		"Jak: Kodeks Duchów + Plemienny splot. Stacja, totem i koszt Pulsu są na stronie Kodeksu."
	]
	quest.4200000000220544.title: "Związane echo"
	quest.4200000000220545.quest_desc: [
		"Etap przetkania — zawołaj sztabkę.",
		"Jak: pięć kamieni, sztabka złota, dwa Miedziane rezonatory i Duchowy odłamek."
	]
	quest.4200000000220545.title: "Echomanifest"
	quest.4200000000220546.quest_desc: [
		"Metal powołany do bytu przez Duchowy puls, nie przez piec.",
		"Jak: Kodeks Duchów + Plemienny splot. Stacja, totem i koszt Pulsu są na stronie Kodeksu."
	]
	quest.4200000000220546.title: "Przejawiona sztabka"
	quest.4200000000220547.quest_desc: [
		"Zachowaj to, co zostawiły plemiona.",
		"Jak: siedem desek, skrzynia i Kościany dzwonek."
	]
	quest.4200000000220547.title: "Skrytka przodków"
	quest.4200000000220548.quest_desc: [
		"Skarbiec powiązany ku Marchii.",
		"Jak: Skrytka przodków, cztery sztabki żelaza, Duchowy odłamek, dwa Miedziane rezonatory i Ogniwo pulsu."
	]
	quest.4200000000220548.title: "Głęboka skrytka"
	quest.4200000000220549.quest_desc: [
		"Nienapisana pieczęć, czeka, aż obrzęd ją wypełni.",
		"Jak: siedem papieru, Duchowy odłamek i Kościany dzwonek. Robi dwa."
	]
	quest.4200000000220549.title: "Pusta pieczęć"
	quest.420000000022054A.quest_desc: [
		"Pieczęć plemienia kamienia.",
		"Jak: Pusta pieczęć i ziemia, bez kształtu."
	]
	quest.420000000022054A.title: "Pieczęć Ziemi"
	quest.420000000022054B.quest_desc: [
		"Pieczęć plemienia płomienia.",
		"Jak: Pusta pieczęć i węgiel drzewny, bez kształtu."
	]
	quest.420000000022054B.title: "Pieczęć Ognia"
	quest.420000000022054C.quest_desc: [
		"Pieczęć plemienia przypływu.",
		"Jak: Pusta pieczęć i wiadro wody (albo porcelanowe wiadro wody), bez kształtu."
	]
	quest.420000000022054C.title: "Pieczęć Wody"
	quest.420000000022054D.quest_desc: [
		"Pieczęć plemienia wiatru.",
		"Jak: Pusta pieczęć i pióro, bez kształtu."
	]
	quest.420000000022054D.title: "Pieczęć Powietrza"
	quest.420000000022054E.quest_desc: [
		"Pieczęć plemienia zarządcy.",
		"Jak: Pusta pieczęć i Duchowy odłamek, bez kształtu."
	]
	quest.420000000022054E.title: "Pieczęć Ducha"
	quest.420000000022054F.quest_desc: [
		"Ofiaruj pieczęcie. Zapytaj Krosno.",
		"Jak: pięć kamieni, odłamek ametystu i Kościany dzwonek."
	]
	quest.420000000022054F.title: "Postument obrzędu"
	quest.4200000000220550.quest_desc: [
		"Użyj go z pustymi rękami i zagraj Rytuał bramy: trafiaj spadające uderzenia na A, S, D, F. Osiągnij 60%, a się otworzy; Puls niepotrzebny.",
		"Jak: użyj Bębna bramy z pustymi rękami i zagraj Rytuał bramy: trafiaj spadające uderzenia na A, S, D, F. Osiągnij 60%, a się otworzy; Puls niepotrzebny. Najpierw zwiąż kompas powrotu."
	]
	quest.4200000000220550.title: "Bęben bramy (plemienny)"
	quest.4200000000220551.quest_desc: [
		"Ubierz próg swojego obozu rzeźbioną ramą ducha. Kompasy i Bęben bramy odbywają podróż.",
		"Jak: cztery sztabki żelaza, dwa Duchowe odłamki, dwa Miedziane rezonatory i odłamek ametystu."
	]
	quest.4200000000220551.title: "Duchowe drzwi"
	quest.4200000000220552.quest_desc: [
		"Narzędzie, które zużywa Puls.",
		"Jak: trzy Przejawione sztabki, Kościany dzwonek i patyk."
	]
	quest.4200000000220552.title: "Kilof duchowego wyposażenia"
	quest.4200000000220553.quest_desc: [
		"Ostrze, które zużywa Puls.",
		"Jak: dwie Przejawione sztabki, Kościany dzwonek i patyk."
	]
	quest.4200000000220553.title: "Ostrze duchowego wyposażenia"
	quest.4200000000220554.quest_desc: [
		"Kamień z Marchii, pod stopami, w miejscu, którego nie powinno być.",
		"Jak: wytop Bruk Marchii. Wydobywaj go w Marchii, przez Bęben bramy."
	]
	quest.4200000000220554.title: "Kamień Marchii (plemienny)"
	quest.4200000000220555.quest_desc: [
		"Gruz z Marchii, zwykły, ale obfity.",
		"Jak: wydobywaj kamień Marchii w Marchii, przez Bęben bramy."
	]
	quest.4200000000220555.title: "Bruk Marchii"
	quest.4200000000220556.quest_desc: [
		"Drewno, które wyrosło tam, gdzie słońce nie sięga.",
		"Jak: ścinaj drzewa Marchii, przez Bęben bramy."
	]
	quest.4200000000220556.title: "Kłoda Marchii"
	quest.4200000000220557.quest_desc: [
		"Tarcica z Marchii, mocna mimo tego, skąd pochodzi.",
		"Jak: jedna Kłoda Marchii daje cztery deski."
	]
	quest.4200000000220557.title: "Deski Marchii"
	quest.4200000000220558.quest_desc: [
		"Liście, które szepczą nawet bez żadnego wiatru.",
		"Jak: drzewa Marchii, przez Bęben bramy. Nożyce albo jedwabny dotyk zachowują liście."
	]
	quest.4200000000220558.title: "Liść Marchii"
	quest.4200000000220559.quest_desc: [
		"Trzcina, która buczy resztką Duchowego pulsu.",
		"Jak: rośnie dziko w Marchii, leży w skrzyniach trzcinowej tamy, a Starszy Wiązaczy korzeni nim handluje."
	]
	quest.4200000000220559.title: "Trzcina ducha (plemienny)"
	quest.420000000022055A.quest_desc: [
		"Podaj surowe żelazo do Echołamacza obok Totemu Ziemi. Wychodzą dwa grysy; przetop je w piecu albo w piecu hutniczym na sztabki. Inne Mods mogą dostarczyć otagowane surowe metale.",
		"Jak: Kodeks Duchów + Plemienny splot. Stacja, totem i koszt Pulsu są na stronie Kodeksu."
	]
	quest.420000000022055A.title: "Ruda pamięta dwa razy"
	quest.420000000022055B.quest_desc: [
		"Woda wiąże wełnę w Duchową tkaninę. Karm stację z góry albo z boków i wyciągaj gotową pracę od dołu.",
		"Jak: Kodeks Duchów + Plemienny splot. Stacja, totem i koszt Pulsu są na stronie Kodeksu."
	]
	quest.420000000022055B.title: "Tkanina z głosem"
	quest.420000000022055C.quest_desc: [
		"Powołaj jeszcze raz Przejawioną sztabkę pod Duchem. Rdzeń rezonansowy otwiera mocniejszy ekwipunek i dalekie ścieżki.",
		"Jak: Kodeks Duchów + Plemienny splot. Stacja, totem i koszt Pulsu są na stronie Kodeksu."
	]
	quest.420000000022055C.title: "Żywe serce"
	quest.420000000022055D.quest_desc: [
		"Noś 4,800 Pulsu w jednej Większej komórce albo 19,200 w Wielkiej komórce. Naładuj ją przy Bębnosercu albo Rezonatorze, zanim ruszysz.",
		"Jak: jedna Komórka Pulsu, dwa Rdzenie rezonansowe i dwie Przejawione sztabki."
	]
	quest.420000000022055D.title: "Dłuższa pieśń"
	quest.420000000022055E.quest_desc: [
		"Szesnaście wiader w jednej cysternie. Wiadra i rury do płynów działają oba. Komparator czyta napełnienie; redstone blokuje napełnianie i opróżnianie. Rozbij ją, a płyn zostaje na bloku, który spada. Zbiorniki kamienia nieba wylewają.",
		"Jak: wytwórz, napełnij wiadrem albo rurą, podnieś — płyn zostaje. Zbiorniki kamienia nieba AE2 pustoszeją po rozbiciu."
	]
	quest.420000000022055E.title: "Deszcz trzymany w miedzi"
	quest.420000000022055F.quest_desc: [
		"Oznacz ścianę maszyny stroikiem, potem użyj go na płycie przekaźnika. Użyj go na innej maszynie, by podmienić znak. Nie oznaczaj płyty.",
		"Jak: Duchowy odłamek nad dwoma Miedzianymi rezonatorami."
	]
	quest.420000000022055F.title: "Nazwij daleki koniec"
	quest.4200000000220560.quest_desc: [
		"Wepnij płytkę w ściankę skrzyni albo maszyny. Sparuj dwie płytki tym samym niepowtarzalnym przedmiotem Więzi, albo powiąż cel stroikiem. Lokalny ładunek sięga 32 bloków, 16 przedmiotów na sekundę za 8 Pulsu. Redstone to wstrzymuje. Od 5.0 płytka chce czuwającego Totemu rezonansu powietrza w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, jakiego głosu brakuje.",
		"Jak: lej, Miedziany rezonator, dwie Kredy rytualne i Sztabka przejawiona."
	]
	quest.4200000000220560.title: "Droga dla zapasów"
	quest.4200000000220561.quest_desc: [
		"Wepnij płytkę w ściankę zbiornika. Sparuj dwie płytki albo powiąż cel stroikiem. Lokalny płyn sięga 32 bloków: 250 mB na sekundę za 8 Pulsu. Oba końce muszą być wczytane. Od 5.0 płytka chce czuwającego Totemu rezonansu powietrza w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, jakiego głosu brakuje.",
		"Jak: Cysterna Duchów, Miedziany rezonator, dwie Kredy rytualne i Sztabka przejawiona."
	]
	quest.4200000000220561.title: "Droga dla deszczu"
	quest.4200000000220562.quest_desc: [
		"Dalekozasięg nosi przedmioty do 128 bloków za 16 Pulsu na udane uderzenie. Używaj zwykłych ekwipunków z dowolnego zgodnego moda. Od 5.0 płytka chce czuwającego Totemu rezonansu powietrza w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, jakiego głosu brakuje.",
		"Jak: Przekaźnik przedmiotów, dwa Rdzenie rezonansowe i dwie perły Endera."
	]
	quest.4200000000220562.title: "Przez warsztat"
	quest.4200000000220563.quest_desc: [
		"Dalekozasięg nosi płyny do 128 bloków za 16 Pulsu na uderzenie. Pełne odbiorniki bezpiecznie stają; redstone może zablokować cysternę odbiorczą. Od 5.0 płytka chce czuwającego Totemu rezonansu powietrza w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, jakiego głosu brakuje.",
		"Jak: Przekaźnik płynów, dwa Rdzenie rezonansowe i dwie perły Endera."
	]
	quest.4200000000220563.title: "Przez wodociągi"
	quest.4200000000220564.quest_desc: [
		"Przerzuć Tribal Power do odbiorników energii Mekanism, Powah albo AE2. Każdy Puls staje się 100 FE. Konwersja bez rangi to 60 Puls na sekundę (6,000 FE/s); nadaj adapterowi rangę na stacjach Echa, a status z pustą ręką poda bieżące tempo. Nadal nie może przyjmować FE. Redstone zatrzymuje konwersję i eksport.",
		"Jak: pięć sztabek miedzi, trzy redstone i jeden Rdzeń rezonansowy."
	]
	quest.4200000000220564.title: "Rytm staje się prądem"
	quest.4200000000220565.quest_desc: [
		"Sześciokrotna laska. Użyj kucając, by przełączać Ziemię, Ogień, Wodę, Powietrze, Ducha i Krosno. Użyj, by rzucić; głos Krosna to Uwięź, która ciągnie cel osiem bloków ku tobie, a rzut z kucania bez celu to Ścieg, mignięcie o sześć bloków. Noś naładowane ogniwa; Kodeks Duchów wyjaśnia każde zaklęcie i jego koszt.",
		"Jak: Pieczęć ducha, Rdzeń rezonansowy, Objawiona sztabka i dwa pnie."
	]
	quest.4200000000220565.title: "Sześć głosów w jednej dłoni"
	quest.4200000000220566.quest_desc: [
		"W głównej ręce użyj kucając na licu kamienia: celowe cięcie trzy na trzy za 8 Puls na blok. Zwykła ochrona przed niszczeniem i wymagania narzędzia nadal obowiązują.",
		"Jak: dwie Objawione sztabki, Rdzeń rezonansowy i dwa Miedziane rezonatory."
	]
	quest.4200000000220566.title: "Kamień ustępuje przejściu"
	quest.4200000000220567.quest_desc: [
		"Kaptur pożycza widzenie w nocy, póki podtrzymują je naładowane ogniwa. Niepowiązane części ciągną 2 Puls co cztery sekundy; związany głos kosztuje 3.",
		"Jak: pięć Duchowych tkanin, w kształcie hełmu. Soczewka ley na nim później pozwala widzieć ley."
	]
	quest.4200000000220567.title: "Oczy w ciszy"
	quest.4200000000220568.quest_desc: [
		"Szata daje odporność. Noś ją do pracy i trzymaj ogniwa naładowane.",
		"Jak: siedem Duchowych tkanin i Rdzeń rezonansowy."
	]
	quest.4200000000220568.title: "Tkane schronienie"
	quest.4200000000220569.quest_desc: [
		"Tkane nogawice pożyczają szybkość. Ich koszt Pulsu jest osobny od innych części.",
		"Jak: sześć Duchowych tkanin i Rdzeń rezonansowy."
	]
	quest.4200000000220569.title: "Obóz dotrzymuje kroku"
	quest.420000000022056A.quest_desc: [
		"Buty mogą pożyczać powolne opadanie przy zejściu, póki zostaje Puls. Związana ścieżka powrotu wciąż warta noszenia.",
		"Jak: cztery Duchowe tkaniny, w kształcie buta."
	]
	quest.420000000022056A.title: "Łagodniejsze zejście"
	quest.420000000022056B.quest_desc: [
		"Osadź pieczęć wielokrotnego użytku obok pasującego totemu. Błogosławieństwo na sześć bloków kosztuje 8 Puls co dwie sekundy. Wysoki redstone je wstrzymuje; kucnij z pustymi rękami, by odzyskać pieczęć.",
		"Jak: dwie Objawione sztabki, dwie sztabki miedzi, Rdzeń rezonansowy i trzy kamienie."
	]
	quest.420000000022056B.title: "Błogosławieństwo, które zostaje"
	quest.420000000022056C.quest_desc: [
		"Użyj kucając wierzchu solidnej podłogi, by ją związać. Wróć w promieniu 128 bloków w tym samym świecie za 20 Puls. Zasil podłogę lądowania, by zablokować przybycia.",
		"Jak: kompas wewnątrz czterech Objawionych sztabek."
	]
	quest.420000000022056C.title: "Pierwsza ścieżka powrotu"
	quest.420000000022056D.quest_desc: [
		"Wróć na dowolną odległość w jednym wymiarze za 40 Puls. Zostaw suche lądowanie z dwoma wolnymi blokami nad nim.",
		"Jak: Kompas drogowskazu wewnątrz czterech Rdzeni rezonansowych."
	]
	quest.420000000022056D.title: "Za horyzontem"
	quest.420000000022056E.quest_desc: [
		"Szukaj Kryształu Marchii za Bębnem bramy. Astralne ścieżki ludzi, przedmiotów i płynów czerpią z tego samego późnego materiału.",
		"Jak: wydobywaj kryształ w grotach Marchii albo znajdź go w skrzyniach Marchii. Najpierw Bęben bramy."
	]
	quest.420000000022056E.title: "Głos za zasłoną"
	quest.420000000022056F.quest_desc: [
		"Ostateczny kompas przekracza wymiary za 100 Puls. Zwiąż bezpieczny powrót, zanim ruszysz badać. Podróż czeka pięć sekund między użyciami.",
		"Jak: Kompas horyzontu, dwie Pieczęcie ducha i dwa Kryształy Marchii."
	]
	quest.420000000022056F.title: "Ścieżka między światami"
	quest.4200000000220570.quest_desc: [
		"Astralny ładunek przekracza wymiary bez limitu odległości. Każde udane uderzenie kosztuje 32 Pulsu. Odbiorca musi być już wczytany; bez ukrytego wczytywania chunków. Od 5.0 płyta chce czuwający Totem rezonansu (Krosno) w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, którego głosu brakuje.",
		"Jak: Przekaźnik przedmiotów dalekiego zasięgu, dwie Pieczęcie Ducha i dwa Kryształy Marchii."
	]
	quest.4200000000220570.title: "Zapasy przez zasłonę"
	quest.4200000000220571.quest_desc: [
		"Astralny płyn idzie tym samym stopniem wymiaru co gracze i przedmioty. Trzymaj zbiornik celu wczytany. Pełny zbiornik albo niewczytany świat robi pauzę i nie zużywa ładunku. Od 5.0 płyta chce czuwający Totem rezonansu (Krosno) w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, którego głosu brakuje.",
		"Jak: Przekaźnik płynów dalekiego zasięgu, dwie Pieczęcie Ducha i dwa Kryształy Marchii."
	]
	quest.4200000000220571.title: "Deszcz przez zasłonę"
	quest.4200000000220572.quest_desc: [
		"Otwórz z drogi osobistą Głęboką skrytkę na 54 miejsca. To ten sam skarbiec, wspólny dla twoich skrytek i sakwy. Dostrojenie do Marchii zdejmuje koszt otwarcia.",
		"Jak: sześć Duchowych tkanin, dwa Rdzenie rezonansowe i Głęboka skrytka."
	]
	quest.4200000000220572.title: "Obóz pod twoją opieką"
	quest.4200000000220573.quest_desc: [
		"Brama otwiera się na żywą krainę. Jedne stworzenia wciąż niosą starą pieśń; inne strzegą jej połamanych kawałków. Wyszczotkuj łagodne. Stań wobec strażników z naładowanymi ogniwami pulsu i drogą powrotu.",
		"Jak: wytwórz albo weź jako nagrodę Iskry/Plemiennego splotu. Prawy klik: jak działa krata."
	]
	quest.4200000000220573.title: "Pieśń powrotu"
	quest.4200000000220574.quest_desc: [
		"Świtny roślinożerca, który niesie starą leśną pieśń w porożu. Rozmnażaj pszenicą; wyszczotkuj dorosłe po Aksamit świtu.",
		"Szukaj go w lasach zwykłego świata i w Marchii. Zwróć jego odczynnik do Więzi echa pod głosem Wody, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wyszczotkuj dorosłego Jelenia świtu. Rozmnażaj je pszenicą."
	]
	quest.4200000000220574.title: "Jeleń świtu: pieśń wróciła"
	quest.4200000000220575.quest_desc: [
		"Nieśmiały zbieracz zmierzchu, którego ogon znaczy bezpieczne ścieżki. Rozmnażaj słodkimi jagodami; wyszczotkuj dorosłe po Puch latarni.",
		"Szukaj go w lasach zwykłego świata i w Marchii. Zwróć jego odczynnik do Więzi echa pod głosem Wody, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wyszczotkuj dorosłego Lisa latarni. Rozmnażaj je słodkimi jagodami."
	]
	quest.4200000000220575.title: "Lis latarni: pieśń wróciła"
	quest.4200000000220576.quest_desc: [
		"Cierpliwy ogrodnik mokradeł z żywą skorupą. Rozmnażaj trawą morską; wyszczotkuj dorosłe po naturalnie zrzuconą Łuskę Mchogrzbietu.",
		"Szukaj go na bagnach zwykłego świata i w Marchii. Zwróć jego odczynnik do Więzi echa pod głosem Wody, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wyszczotkuj dorosłego Mchogrzbietu. Rozmnażaj je trawą morską."
	]
	quest.4200000000220576.title: "Mchogrzbiet: pieśń wróciła"
	quest.4200000000220577.quest_desc: [
		"Szczątki złamanego rytuału ognia. Jego ciosy wręcz na chwilę podpalają; trzymaj wodę blisko.",
		"Szukaj go w lasach zwykłego świata i w Marchii. Zwróć jego odczynnik do Dostrojenia echa pod głosem Ducha, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Popiołowiązu. Wrogie duchy potrzebują ciemności."
	]
	quest.4200000000220577.title: "Popiołowiąz: pieśń wróciła"
	quest.4200000000220578.quest_desc: [
		"Strażnik gaju, wykrzywiony przeciętą linią ley. Powolny, ale krzepki; ciosy na chwilę zakorzeniają wędrowców.",
		"Szukaj go w lasach zwykłego świata i w Marchii. Zwróć jego odczynnik do Dostrojenia echa pod głosem Ducha, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Korzeniowiązu. Wrogie duchy potrzebują ciemności."
	]
	quest.4200000000220578.title: "Korzeniowiąz: pieśń wróciła"
	quest.4200000000220579.quest_desc: [
		"Bagienny łowca, ukryty wśród trzciny ducha. Szybkie ciosy niosą krótką truciznę.",
		"Szukaj go na bagnach zwykłego świata i w Marchii. Zwróć jego odczynnik do Dostrojenia echa pod głosem Ducha, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Trzcinowego łowcy. Wrogie duchy potrzebują ciemności."
	]
	quest.4200000000220579.title: "Trzcinowy łowca: pieśń wróciła"
	quest.420000000022057A.quest_desc: [
		"Padlinożerca pól kryształu, opancerzony śpiewającym kamieniem. Trzymaj się z dala od ciężkiego pchnięcia.",
		"Szukaj go w Marchii. Zwróć jego odczynnik do Dostrojenia echa pod głosem Ducha, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Odłamkogrzbietu. Wrogie duchy potrzebują ciemności."
	]
	quest.420000000022057A.title: "Odłamkogrzbiet: pieśń wróciła"
	quest.420000000022057B.quest_desc: [
		"Pusty wartownik, który wciąż strzeże starożytnych dróg. Jego dotyk osłabia chwyt atakujących.",
		"Szukaj go w Marchii. Zwróć jego odczynnik do Dostrojenia echa pod głosem Ducha, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Wydrążonego strażnika. Wrogie duchy potrzebują ciemności."
	]
	quest.420000000022057B.title: "Wydrążony strażnik: pieśń wróciła"
	quest.420000000022057C.quest_desc: [
		"Duch karmiony burzą, o rozległych skrzydłach zasłony. Jasne zbiegowisko pyłków ostrzega przed podmuchem; osłona przerywa atak.",
		"Szukaj jej w Marchii. Zwróć jej odczynnik do Więzi echa pod głosem Wody, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Ćmy burzy. Wrogie duchy potrzebują ciemności."
	]
	quest.420000000022057C.title: "Ćma burzy: pieśń wróciła"
	quest.420000000022057D.quest_desc: [
		"Zwinny duch żaru. Zbiera iskry przed palącym pociskiem; czar nigdy nie zapala terenu.",
		"Szukaj go w Marchii. Zwróć jego odczynnik do Dostrojenia echa pod głosem Ducha, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada ze Skrzata żaru. Wrogie duchy potrzebują ciemności."
	]
	quest.420000000022057D.title: "Skrzat żaru: pieśń wróciła"
	quest.420000000022057E.quest_desc: [
		"Unosząca się relikwia, która pamięta zaginione plemiona. Jego zapowiedziany dźwięk spowalnia; schronienie przerywa pieśń.",
		"Szukaj go w Marchii. Zwróć jego odczynnik do Dostrojenia echa pod głosem Ducha, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Dzwonu żałoby. Wrogie duchy potrzebują ciemności."
	]
	quest.420000000022057E.title: "Dzwon żałoby: pieśń wróciła"
	quest.420000000022057F.quest_desc: [
		"Łowca, którego ciągną rozdarcia w kracie. Szybko skraca dystans, ale sam nie przechodzi między światami.",
		"Szukaj go w Marchii. Zwróć jego odczynnik do Dostrojenia echa pod głosem Ducha, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Ogara szczeliny. Wrogie duchy potrzebują ciemności."
	]
	quest.420000000022057F.title: "Ogar szczeliny: pieśń wróciła"
	quest.4200000000220580.quest_desc: [
		"Ośmionogi strażnik pękniętych pieśni. Ukąszenie spowalnia zdobycz, nie zostawiając pajęczyn i nie niszcząc obozu.",
		"Szukaj jej w Marchii. Zwróć jej odczynnik do Więzi echa pod głosem Wody, po przydatny materiał. Buduj oświetlone ścieżki; wrogie duchy wymagają ciemności.",
		"Jak: wypada z Tkacza echa. Wrogie duchy potrzebują ciemności."
	]
	quest.4200000000220580.title: "Tkacz echa: pieśń wróciła"
	quest.4200000000220581.quest_desc: [
		"Notatki polowe są kompletne. Łagodne zbiory i odzyskane relikty znów stały się tkaniną i Echami. Pod zasłoną nocy obóz odpowiada pełniejszą pieśnią.",
		"Rzadka nagroda: jedno wspólne życie Clowder, raz dla całej drużyny. W kampanii jest tylko sześć takich nagród.",
		"Jak: Kodeks Duchów + Plemienny splot. Stacja, totem i koszt Pulsu są na stronie Kodeksu."
	]
	quest.4200000000220581.title: "Trzynaście głosów, jedno niebo"
	quest.4200000000220582.quest_desc: [
		"Zawieś pieśń obozu w miedzi. Duchowa latarnia daje pełne światło bez paliwa; redstone ją przyciemnia. Oznacz bezpieczne ścieżki z powrotem z ciemności.",
		"Jak: trzy sztabki miedzi, jeden Duchowy odłamek i jedna deska."
	]
	quest.4200000000220582.title: "Światło dla wracających"
	quest.4200000000220583.quest_desc: [
		"Dzwonek jest naraz ozdobą i instrumentem. Jego komparator daje 0 przy czystym niebie, 8 w deszczu i 15 w burzy. Redstone go ucisza.",
		"Jak: trzy deski, trzy sztabki miedzi i jeden Kościany dzwonek."
	]
	quest.4200000000220583.title: "Słuchaj pogody"
	quest.4200000000220584.quest_desc: [
		"Rzeźbiony stół mieści 27 stosów. Zwykłe rury przedmiotów i przekaźniki mogą dzielić jego dary; komparatory czytają zapełnienie, a redstone zamyka dostęp.",
		"Jak: skrzynia, jedno Związane echo, dwie deski i dwa kamienie."
	]
	quest.4200000000220584.title: "Miejsce przy palenisku"
	quest.4200000000220585.quest_desc: [
		"Postaw Opiekuna gaju na wysokości uprawy, na grządce 9 na 9. Włóż nasiona w pierwszy rząd; zbiory wypełniają dwa dolne rzędy. Sadzenie kosztuje 4 Puls, zbiór i ponowne sadzenie kosztują 12. Dostarczaj energię w zasięgu ośmiu bloków. Pełne wyjście zachowuje uprawę; redstone wstrzymuje pracę. Od 5.0 chce czuwającego Totemu rezonansu Ziemi w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, którego głosu brakuje. Trzymaj też blisko totem Wody, a podleje każdą bruzdę grządki.",
		"Jak: żelazna motyka, Pieczęć Ziemi, Związane echo, dwie sztabki miedzi i dwie deski."
	]
	quest.4200000000220585.title: "Ogród wciąż śpiewa"
	quest.4200000000220586.quest_desc: [
		"Osiem Pulsu na sekundę powstrzymuje pojawianie się wrogich istot w zasięgu 24 bloków. Istniejące stworzenia zostają. Straż powstrzymuje też wrogie przyzwania Kołyski, więc trzymaj miejsce przyzywania na zewnątrz. Redstone od razu ucisza straż. Od 5.0 chce czuwającego Totemu rezonansu Ducha w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, którego głosu brakuje.",
		"Jak: Pieczęć Ducha, dwa Związane echa, Odłamek echa i trzy Deski Marchii."
	]
	quest.4200000000220586.title: "Cisza na skraju obozu"
	quest.4200000000220587.quest_desc: [
		"Kotwica drogi utrzymuje własny chunk obudzony za 16 Pulsu na sekundę. Postaw jedną przy dalekim odbiorniku przekaźnika i podtrzymuj jej lokalne zasilanie. Najwyżej 32 kotwice mogą działać w jednym wymiarze. Redstone albo pusty bufor puszcza chunk. Od 5.0 chce czuwającego Totemu rezonansu Ziemi w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, którego głosu brakuje.",
		"Jak: dwa Kryształy Marchii, Oko kresu, dwie Manifestowane sztabki, Rdzeń rezonansowy i trzy Kamienie Marchii."
	]
	quest.4200000000220587.title: "Obóz, który pamięta"
	quest.4200000000220588.quest_desc: [
		"Użyj, skradając się, nienaładowanej efigii na wspieranym stworzeniu, by wziąć nieszkodliwy odcisk. Efigia pamięta gatunek. Bossów nie da się związać; Kodeks wyjaśnia zgodne duchy i odnowienie.",
		"Jak: Kościany dzwonek, dwie Duchowe tkaniny, Rdzeń rezonansowy i Związane echo."
	]
	quest.4200000000220588.title: "Pożycz żywy głos"
	quest.4200000000220589.quest_desc: [
		"Osadź przebudzoną efigię w pierwszym slocie i Duchową tkaninę w drugim. Każde udane przywołanie zużywa 80 Pulsu, jedną Duchową tkaninę i jedną nić wiązania. Zostaw bezpieczną podłogę w zasięgu trzech bloków. Osiem istot w pobliżu wstrzymuje Kołyskę przywołania; redstone wstrzymuje całą pracę i automatyzację. Od 5.0 chce Totemu rezonansu Ducha trzymanego w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, którego głosu brakuje.",
		"Jak: dwie Objawione sztabki, Kryształ Marchii, dwa Związane echa, Rdzeń rezonansowy i trzy Deski Marchii."
	]
	quest.4200000000220589.title: "Palenisko dla pożyczonego życia"
	quest.420000000022058A.quest_desc: [
		"Wstaw Pieczęć Ducha w Rytualne palenisko. Przynieś totemy Ziemi, Powietrza i Ducha w zasięgu ośmiu bloków, 200 Pulsu w pobliżu i trzy Duchowe tkaniny w twoim ekwipunku. Użyj odciśniętej efigii na palenisku, by obudzić 512 nici przywołania. Gdy wszystkie się zużyją, powtórz ten obrzęd, by odnowić wiązanie.",
		"Jak: Pieczęć Ducha w Rytualnym palenisku; totemy Ziemi, Powietrza i Ducha w zasięgu 8; 200 Pulsu; trzy Duchowe tkaniny; użyj odciśniętej efigii."
	]
	quest.420000000022058A.title: "Trzy głosy budzą nić"
	quest.420000000022058B.quest_desc: [
		"Dokończ jedno udane przywołanie. Nieudane albo zablokowane próby nie zużywają nici ani ofiar. Każde wiązanie trwa 512 udanych przywołań; zbicie i postawienie Kołyski przywołania na nowo nigdy nie odnawia wiązania. Podpowiedź efigii pokazuje pozostałe użycia, a komparator czyta pozostałą siłę wiązania kołyski.",
		"Jak: dokończ jedno udane przywołanie z Kołyski przywołania. Nieudane próby nic nie zużywają."
	]
	quest.420000000022058B.title: "Odpowiedź z kołyski"
	quest.4200000000228001.quest_desc: [
		"Za Bębnem bramy step i wyżyny Marchii kryją zapadnięte Sale przodków. Wejście pieszo odhacza to. Cztery Tablice wiedzy stoją w każdej sali; przeczytaj każdą. Skrzynie trzymają Nić krosna, Echa, Duchową tkaninę i pieczęcie. Wydrążeni strażnicy wciąż stoją na warcie.",
		"Jak: Bęben bramy do Marchii i wejdź pieszo do Sali przodków; potem przeczytaj jej cztery Tablice wiedzy."
	]
	quest.4200000000228001.title: "Sale, które trzymały czas"
	quest.4200000000228002.quest_desc: [
		"Nić krosna to Krosno w dłoni: skrzynie Sal przodków trzymają od dwóch do czterech, Nieśpiewany wyrywa szesnaście albo więcej, a Starszy Szwaczy krosna wymienia jedną na stopniu Przyjaciel. To odczynnik szóstego głosu.",
		"Jak: skrzynie Sal przodków, Nieśpiewany albo Starszy Szwaczy krosna przy Przyjacielu."
	]
	quest.4200000000228002.title: "Nić z samej nici"
	quest.4200000000228003.quest_desc: [
		"Osiem Kamieni Marchii wokół Odłamka echa daje dwie Tablice wiedzy. Ustawiona tablica pokazuje fragment dziewięciu plemion; użycie w skradaniu w trybie kreatywnym przełącza, którą. Wyłóż nimi własną salę.",
		"Jak: osiem Kamieni Marchii wokół Odłamka echa. Wychodzą dwie."
	]
	quest.4200000000228003.title: "Wyrzeźb to, co czytasz"
	quest.4200000000228004.quest_desc: [
		"Skóra na Deskach Marchii, wokół Rdzenia rezonansowego. Krąg bębnów na wyżynach Marchii już trzyma jeden; ten osadzasz w domu. Uderz cztery razy, o oddech od siebie, i coś starego powstaje.",
		"Jak: trzy skóry, pięć Desek Marchii i Rdzeń rezonansowy."
	]
	quest.4200000000228004.title: "Bęben, który nie zabrzmi"
	quest.4200000000228005.quest_desc: [
		"Nieśpiewany to duch bębna o trzech fazach. Uderzenie: zaprzyj się, skradając się, przeciw jego fali uderzeniowej. Chór: zetnij Tkaczy echa, których wzywa. Cisza: nie da się go zranić, póki nie uderzysz w Cichy bęben tym samym rytmem czterech uderzeń, który go ogłusza i podwaja twoje obrażenia. Weź naładowane ogniwa pulsu i drogę powrotu.",
		"Jak: walcz z Nieśpiewanym przy Cichym bębnie. Skradaj się w Uderzeniu; cztery uderzenia w Ciszy."
	]
	quest.4200000000228005.title: "Bęben pamięta"
	quest.4200000000228006.quest_desc: [
		"Jedno Serce Nieśpiewanego na zabójstwo, obok Nici krosna i Rdzeni rezonansowych. Wytwarza totem Krosna i nic więcej, więc wydawaj je ostrożnie.",
		"Jak: Nieśpiewany przy Cichym bębnie upuszcza jedno na zabójstwo."
	]
	quest.4200000000228006.title: "Uciszony bęben"
	quest.4200000000228007.quest_desc: [
		"Serce Nieśpiewanego między Nicią krosna a Kryształem Marchii, na Deskach Marchii. Krosno dołącza do Ziemi, Ognia, Wody, Powietrza i Ducha: osobny głos dla Rezonatora pulsu i dostrojenie, o które proszą Rozplot echa i Więź ley.",
		"Jak: jedno Serce Nieśpiewanego, cztery Kryształy Marchii, dwie Nici krosna i dwie Deski Marchii."
	]
	quest.4200000000228007.title: "Szósty głos"
	quest.4200000000228008.quest_desc: [
		"Pusta pieczęć i Nić krosna. Osadzona w Rytualnym palenisku, Pieczęć krosna błogosławi napięcie: co dwie sekundy uzupełnia dwa Puls w noszonych ogniwach wszystkich w zasięgu i użycza Szczęścia.",
		"Jak: Pusta pieczęć i Nić krosna, bezkształtnie."
	]
	quest.4200000000228008.title: "Pieczęć napięcia"
	quest.4200000000228009.quest_desc: [
		"Nić krosna i Miedziane rezonatory na Kamieniu Marchii. Pod głosem Krosna Rozplot echa puszcza kratę wstecz: Manifestowany sztabek na dwa Związane echa, Związane na dwa Dostrojone, Dostrojone na dwa Odłamki, Duchowa tkanina na dwie wełny, Rdzeń rezonansowy na trzy Manifestowane sztabki, i każde zużyte narzędzie duchowego wyposażenia na jeden Manifestowany sztabek.",
		"Jak: pięć Kamieni Marchii, Nić krosna, dwa Miedziane rezonatory i Duchowy odłamek."
	]
	quest.4200000000228009.title: "Krata, wspak"
	quest.420000000022800A.quest_desc: [
		"Przekręć Kostur sześciokrotny na głos Krosna. Uwięź ciągnie cel osiem bloków ku tobie za sześć Pulsu; rzut ze skradania bez celu to Ścieg, mignięcie o sześć bloków przez powietrze za dziesięć. Odznacz to, gdy użyjesz obu.",
		"Jak: Kostur sześciokrotny na głosie Krosna. Uwięź cel, potem Ścieg ze skradania. Odznacz, gdy oba zadziałają."
	]
	quest.420000000022800A.title: "Uwięź i Ścieg"
	quest.420000000022800B.quest_desc: [
		"Dziewięć obozów plemion stoi w Marchii, po jednym na Nić: chaty, ognisko, Palenisko plemienia, totem, sztandar i czworo Krewniaków plemienia. Kliknij prawym palenisko tym, co ceni to plemię, albo naładowanym Ogniwem pulsu, a twoja reputacja u nich rośnie. Zranienie Krewniaka kosztuje 25. Zniszczenie sztandaru plemienia kosztuje 5, palenisko 40. Zwykłe bloki obozu nic nie kosztują.",
		"Jak: kliknij prawym Palenisko plemienia Marchii tym, co sprzyja temu plemieniu, albo naładowanym Ogniwem pulsu."
	]
	quest.420000000022800B.title: "W cieple"
	quest.420000000022800C.quest_desc: [
		"Gość przy 50, Przyjaciel przy 150, Krewniak przy 400, Głos przy 800. Zabójstwa przy palenisku i ukończone wymiany też się liczą. Starsi handlują dwiema ofertami na stopień: Śpiewacy żwiru sprzedają Echa za surową rudę, Rzeźbiarze pieczęci sprzedają pieczęcie i tabliczki obrzędu, Szwacze krosna sprzedają Nić krosna i Kompas drogowskazu, a przy Krewniaku Kotwicę krosna i Pieczęć krosna. `/tribalpower standing` wypisuje wszystkie dziewięć.",
		"Jak: osiągnij Przyjaciela (150) u plemienia. /tribalpower standing."
	]
	quest.420000000022800C.title: "W dobrej zgodzie"
	quest.420000000022800D.quest_desc: [
		"Przy pozycji Głos Starszy raz wciska ci w dłoń Znak plemienia. Otwiera stronę Kodeksu tego plemienia i jest tym składnikiem, bez którego Totem pokrewieństwa się nie obejdzie.",
		"Jak: Głos (800) u plemienia; Starszy raz daje Znak plemienia."
	]
	quest.420000000022800D.title: "Dziewięć zgodnych"
	quest.420000000022800E.quest_desc: [
		"Trzymaj Znak plemienia. Każdego plemienia jest inny; możliwych jest dziewięć.",
		"Jak: osiągnij Głos (800) u plemienia; jego Starszy raz daje Znak."
	]
	quest.420000000022800E.title: "Znak plemienia"
	quest.420000000022800F.quest_desc: [
		"Znak plemienia, Totem rezonansu dostrojenia tego plemienia i dwie Duchowe tkaniny. Totem pokrewieństwa liczy się jako dodatkowy, odrębny głos dla Rezonatora pulsu i użycza stacjom dostrojenia swojego plemienia, więc dziewięć plemion może unieść pieśń obozu do piętnastu głosów.",
		"Jak: Znak plemienia, Totem rezonansu tego plemienia i dwie Duchowe tkaniny w siatce wytwarzania."
	]
	quest.420000000022800F.title: "Głos, który głosem nie jest"
	quest.4200000000228010.quest_desc: [
		"Bębniarz obozu gra co kilka sekund; postaw Bębnoserce w zasięgu ośmiu bloków od jednego, a każde uderzenie daje mu dwa Puls. Odznacz to, gdy Bębniarz zasila twoją kratę.",
		"Jak: postaw Bębnoserce w zasięgu 8 od Bębniarza obozu; odznacz, gdy podaje Puls."
	]
	quest.4200000000228010.title: "Obóz trzyma takt"
	quest.4200000000228011.quest_desc: [
		"Dwa kamienie i odczynnik wokół pieczęci; pieczęć wraca do ciebie. Sękaty korzeń obok Pieczęci Ziemi; 600 Puls. Przez dwadzieścia minut uprawy, sadzonki i łodygi rosną szybciej w dziewięciu chunkach wokół paleniska. Użyj tabliczki obrzędu w skradaniu na Rytualnym palenisku z tą pieczęcią osadzoną, wewnątrz jego Kręgu obrzędu (cztery piedestały na przekątnych, kreda je łączy); Puls jest czerpany z kraty w promieniu ośmiu bloków.",
		"Jak: dwa kamienie, Sękaty korzeń i Pieczęć Ziemi, bez kształtu; pieczęć wraca."
	]
	quest.4200000000228011.title: "Tabliczka obrzędu: Zielone błogosławieństwo"
	quest.4200000000228012.quest_desc: [
		"Dwa kamienie i odczynnik wokół pieczęci; pieczęć wraca do ciebie. Trzcinowy kieł obok Pieczęci Wody; 400 Puls. Dwadzieścia minut deszczu, dla cystern i upraw. Użyj tabliczki obrzędu w skradaniu na Rytualnym palenisku z tą pieczęcią osadzoną, wewnątrz jego Kręgu obrzędu (cztery piedestały na przekątnych, kreda je łączy); Puls jest czerpany z kraty w promieniu ośmiu bloków.",
		"Jak: dwa kamienie, Trzcinowy kieł i Pieczęć Wody, bez kształtu; pieczęć wraca."
	]
	quest.4200000000228012.title: "Tabliczka obrzędu: Wezwanie deszczu"
	quest.4200000000228013.quest_desc: [
		"Dwa kamienie i odczynnik wokół pieczęci; pieczęć wraca do ciebie. Skrzydło burzy obok Pieczęci powietrza; 400 Pulsu. Czterdzieści minut czystego nieba. Użyj w skradaniu tablicy na Rytualnym palenisku z tą pieczęcią osadzoną, wewnątrz jego Kręgu obrzędu (cztery postumenty na przekątnych, kreda je łączy); Puls jest ciągnięty z kraty w promieniu ośmiu bloków.",
		"Jak: dwa kamienie, Skrzydło burzy i Pieczęć powietrza, bezkształtnie; pieczęć wraca."
	]
	quest.4200000000228013.title: "Tablica obrzędu: czyste niebo"
	quest.4200000000228014.quest_desc: [
		"Dwa kamienie i odczynnik wokół pieczęci; pieczęć wraca do ciebie. Serce żaru obok Pieczęci ognia; 800 Pulsu. Przyspiesza noc do następnego świtu dla całego świata. Użyj w skradaniu tablicy na Rytualnym palenisku z tą pieczęcią osadzoną, wewnątrz jego Kręgu obrzędu (cztery postumenty na przekątnych, kreda je łączy); Puls jest ciągnięty z kraty w promieniu ośmiu bloków.",
		"Jak: dwa kamienie, Serce żaru i Pieczęć ognia, bezkształtnie; pieczęć wraca."
	]
	quest.4200000000228014.title: "Tablica obrzędu: wołanie świtu"
	quest.4200000000228015.quest_desc: [
		"Dwa kamienie i odczynnik wokół pieczęci; pieczęć wraca do ciebie. Pieczęć strażnika obok Pieczęci ducha; 600 Pulsu. Piętnaście minut bez wrogich pojawów w zasięgu sześćdziesięciu czterech bloków. Użyj w skradaniu tablicy na Rytualnym palenisku z tą pieczęcią osadzoną, wewnątrz jego Kręgu obrzędu (cztery postumenty na przekątnych, kreda je łączy); Puls jest ciągnięty z kraty w promieniu ośmiu bloków.",
		"Jak: dwa kamienie, Pieczęć strażnika i Pieczęć ducha, bezkształtnie; pieczęć wraca."
	]
	quest.4200000000228015.title: "Tablica obrzędu: cicha noc"
	quest.4200000000228016.quest_desc: [
		"Dwa kamienie i odczynnik wokół pieczęci; pieczęć wraca do ciebie. Nić krosna obok Pieczęci krosna; 1 200 Pulsu. Łączy najbliższy totem z innym w zasięgu sześćdziesięciu czterech bloków trzydziestominutową linią ley, która prowadzi Puls między nimi. Użyj w skradaniu tablicy na Rytualnym palenisku z tą pieczęcią osadzoną, wewnątrz jego Kręgu obrzędu (cztery postumenty na przekątnych, kreda je łączy); Puls jest ciągnięty z kraty w promieniu ośmiu bloków.",
		"Jak: dwa kamienie, Nić krosna i Pieczęć krosna, bezkształtnie; pieczęć wraca."
	]
	quest.4200000000228016.title: "Tablica obrzędu: wiązanie ley"
	quest.4200000000228017.quest_desc: [
		"Odpraw dowolny obrzęd. Jeśli krata wokół paleniska trzyma za mało Pulsu, nic się nie zużywa, a palenisko o tym mówi.",
		"Jak: użyj w skradaniu dowolnej Tablicy obrzędu na Rytualnym palenisku w jego Kręgu obrzędu, z pasującą pieczęcią i Pulsem."
	]
	quest.4200000000228017.title: "Pierwszy obrzęd"
	quest.4200000000228018.quest_desc: [
		"Dwie Duchowe tkaniny, Duchowy odłamek i odczynnik gatunku. Użyj na dorosłym chowańcu. Zwierzęta: sześćdziesiąt procent, amulet zostaje przy porażce. Szczątki chcą Głosu u swojego plemienia, czterdzieści procent, amulet zużywa się przy porażce.",
		"Jak: dwie Duchowe tkaniny, Duchowy odłamek i jeden odczynnik chowańca (Aksamit świtu, Puch latarni, Skrzydło burzy i tym podobne)."
	]
	quest.4200000000228018.title: "Amulet dla dzikiej istoty"
	quest.4200000000228019.quest_desc: [
		"Związany chowaniec idzie za tobą, teleportuje się za tobą, nigdy nie znika, nie możesz go zranić i daje podwójnie, gdy go szczotkujesz. Od Lisa latarni, Mchogrzbietu i Jelenia świtu zaczynasz. Szczątki potrzebują Głosu. Może iść za tobą jeden wojownik i dwóch pomocników; siedzący się nie liczą.",
		"Jak: użyj Amuletu więzi na dorosłym chowańcu. Osiągnięcie wyzwala się przy pierwszej więzi."
	]
	quest.4200000000228019.title: "Przyjaciel w ciemności"
	quest.420000000022801A.quest_desc: [
		"Papier, Duchowa tkanina i Duchowy odłamek. Użyj karty na graczu, by zaprosić go do swojego obozu, albo w powietrzu, by zobaczyć obóz. `/tribalpower camp` tworzy, zaprasza, dołącza, opuszcza, wyrzuca i zmienia nazwę.",
		"Jak: papier, Duchowa tkanina i Duchowy odłamek, bez kształtu."
	]
	quest.420000000022801A.title: "Obóz wielu głosów"
	quest.420000000022801B.quest_desc: [
		"Członkowie obozu dzielą obozowy skarbiec na pięćdziesiąt cztery miejsca za każdą Głęboką skrytką i każdą Sakwą wędrowca, liczą się nawzajem za właścicieli swoich urządzeń, łączą dwanaście Kotwic drogi i odbijają na obóz ćwiartkę swojej pozycji u plemienia. Clowder to nie ten obóz — /tribalpower camp create <name> nim jest.",
		"Jak: /tribalpower camp create <name> (nie Clowder). Osiągnięcie wyzwala się przy pierwszym obozie."
	]
	quest.420000000022801B.title: "Jeden skarbiec, jeden budżet"
	quest.420000000022801C.quest_desc: [
		"Szyba nad Miedzianym rezonatorem i Duchowym odłamkiem. Trzymana soczewka pokazuje siłę ley tam, gdzie stoisz, i maluje ją na ziemi wokół ciebie; użycie w skradaniu na Kolektorze ley albo na chowańcu pokazuje jego liczby.",
		"Jak: szyba, Miedziany rezonator i Duchowy odłamek w kolumnie."
	]
	quest.420000000022801C.title: "Zobacz ley"
	quest.420000000022801D.quest_desc: [
		"Kwarc nad redstone i Miedzianym rezonatorem na Kamieniu Marchii. Skierowany na dowolny zasobnik Pulsu daje redstone od 0 do 15 proporcjonalnie do tego, co jest złożone.",
		"Jak: kwarc, dwa redstone, Miedziany rezonator i Kamień Marchii."
	]
	quest.420000000022801D.title: "Igła do Pulsu"
	quest.420000000022801E.quest_desc: [
		"Pochodnia redstone nad redstone i Miedzianym rezonatorem na Kamieniu Marchii. Wysyła sygnał, gdy zwrócony zasobnik jest na progu albo wyżej; prawy klik przełącza 25, 50, 75 i 100 procent. Części automatyzacji napędzanej Pulsem.",
		"Jak: pochodnia redstone, dwa redstone, Miedziany rezonator i Kamień Marchii."
	]
	quest.420000000022801E.title: "Wers w pieśni"
	quest.420000000022801F.quest_desc: [
		"Użyj w skradaniu Kodeksu Duchów na dowolnym bloku plemiennym, by dostać zwykły raport: zmagazynowany Puls, generatory, które go zasilają, dostrojenia w zasięgu ośmiu bloków, czego brakuje bieżącemu przepisowi, pełne wyjście, pauza redstone, niezaładowany koniec przekaźnika. Odznacz, gdy powiedział ci coś, czego nie wiedziałeś.",
		"Jak: użyj w skradaniu Kodeksu Duchów na bloku plemiennym; odznacz, gdy raport nazwie prawdziwą usterkę."
	]
	quest.420000000022801F.title: "Zapytaj Kodeks, dlaczego"
	quest.4200000000228020.quest_desc: [
		"Poproś Źródło Kamienia o bruk. Kamienia się nie robi; kamień prosi się, by został. Bruk potrzebuje tylko kształtu i Pulsu; Totem Ziemi w zasięgu ośmiu bloków pozwala prosić o kamień.",
		"Jak: pięć bruku, Odłamek echa i Bębnoserce."
	]
	quest.4200000000228020.title: "Źródło kamienia"
	quest.4200000000228021.quest_desc: [
		"Dokończ dowolny wzór. Ustawienie jest rytuałem: rozrzucone urządzenia to nie obrzęd.",
		"Jak: postaw wzór obrzędu z Kodeksu Duchów; osiągnięcie wyzwala się przy pierwszym pełnym kręgu."
	]
	quest.4200000000228021.title: "Narysuj krąg"
	quest.4200000000228022.quest_desc: [
		"Poproś Źródło Kamienia o pierwszy bruk. Kamienia się nie robi; kamień prosi się, by został.",
		"Jak: uruchom Źródło Kamienia, aż pojawi się bruk. Osiągnięcie przy pierwszym zostaniu."
	]
	quest.4200000000228022.title: "Kamień zostaje"
	quest.4200000000228023.quest_desc: [
		"Użyj w skradaniu Kodeksu Duchów na źródle, gdy pracuje. Odznacz, gdy raport nazwie zmagazynowany Puls albo brakujący totem.",
		"Jak: użyj w skradaniu Kodeksu Duchów na Źródle Kamienia; odznacz, gdy raport nazwie prawdziwą usterkę albo pełny bufor."
	]
	quest.4200000000228023.title: "Źródło odpowiada"
	quest.4200000000228024.quest_desc: [
		"Trzymaj naładowane ogniwo przy źródle, żeby prośba nie stanęła.",
		"Jak: napełnij Ogniwo pulsu przy Bębnosercu, potem odznacz, gdy źródło jest karmione."
	]
	quest.4200000000228024.title: "Ogniwo przy źródle"
	quest.4200000000228025.quest_desc: [
		"Siatka nie znajduje rudy; siatka daje rudzie gdzie osiąść. Osadź ją nad Dołem nasłuchu.",
		"Jak: cztery Kamienie Marchii, dwa Dostrojone echa, dwie Duchowe tkaniny i Miedziany rezonator."
	]
	quest.4200000000228025.title: "Siatka, która słucha"
	quest.4200000000228026.quest_desc: [
		"Cztery Kamienie kotwicy trzymają rogi dołu. Bez nich siatka nie ma gdzie stanąć.",
		"Jak: cztery Kamienie Marchii nad Odłamkiem echa. Wychodzą cztery."
	]
	quest.4200000000228026.title: "Cztery kotwice"
	quest.4200000000228027.quest_desc: [
		"Przywołaj pierwszą rudę w górę przez Dół nasłuchu.",
		"Jak: Siatka rezonansu nad dołem z Kamieniami kotwicy; osiągnięcie wyzwala się przy pierwszej rudzie."
	]
	quest.4200000000228027.title: "Zapytaj ziemię"
	quest.4200000000228028.quest_desc: [
		"Złoty grys z dołu to następny głos po żelazie.",
		"Jak: pytaj ziemię dalej; odznacz, gdy złoty grys jest w dłoni."
	]
	quest.4200000000228028.title: "Złoto z dołu"
	quest.4200000000228029.quest_desc: [
		"Dół zużywa Puls. Trzymaj ogniwo na siatce, żeby prośba nie stanęła.",
		"Jak: napełnij Ogniwo pulsu przy Bębnosercu i osadź je tam, gdzie pokazuje Kodeks."
	]
	quest.4200000000228029.title: "Dół trzyma rytm"
	quest.420000000022802A.quest_desc: [
		"Jedenaście Ram bramy i zwornik otaczają drogę. Brak ramy to brak kroku.",
		"Jak: sześć Kamieni Marchii, dwie sztabki miedzi i Odłamek echa. Wychodzą cztery."
	]
	quest.420000000022802A.title: "Rama dla drogi"
	quest.420000000022802B.quest_desc: [
		"Zwornik jest dwunastym kamieniem. Bez niego pierścień to tylko wzór.",
		"Jak: cztery Ramy bramy, Rdzeń rezonansowy, Duchowy odłamek i Ogniwo pulsu."
	]
	quest.420000000022802B.title: "Zwornik"
	quest.420000000022802C.quest_desc: [
		"Zapal Bramę drogi. Jedenaście ram, jeden zwornik i gdzieś, gdzie być.",
		"Jak: dokończ pierścień i zapal go; osiągnięcie wyzwala się, gdy droga się otwiera."
	]
	quest.420000000022802C.title: "Otwórz drogę"
	quest.420000000022802D.quest_desc: [
		"Użyj w skradaniu pieczęci na zworniku, by go zapisać. Użyj jej na drugim zworniku, by związać oba.",
		"Jak: Pusta pieczęć, Nić krosna i Duchowy odłamek, bezkształtnie."
	]
	quest.420000000022802D.title: "Zapisz cel"
	quest.420000000022802E.quest_desc: [
		"Podróżuj Daleką bramą z jednego wymiaru do drugiego. Krosno nigdy nie było jedną nicią.",
		"Jak: zwiąż dwa zworniki Pieczęcią bramy, potem przejdź daleką bramę."
	]
	quest.420000000022802E.title: "Długa nić"
	quest.420000000022802F.quest_desc: [
		"Generator ognia. Osadź go blisko jego totemu; Bębnoserce w dłoni nie uniesie tego głosu.",
		"Jak: trzy sztabki miedzi, Węzeł żaru, Pieczęć ognia i dwie Deski Marchii."
	]
	quest.420000000022802F.title: "Głos ognia"
	quest.4200000000228030.quest_desc: [
		"Generator wiatru. Osadź go blisko jego totemu, żeby szóstka mogła się słyszeć.",
		"Jak: cztery Duchowe tkaniny, Skrzydło burzy, Pieczęć powietrza i dwie Deski Marchii."
	]
	quest.4200000000228030.title: "Głos wiatru"
	quest.4200000000228031.quest_desc: [
		"Generator wody. Osadź go blisko jego totemu; cysterny i źródła słuchają tego głosu.",
		"Jak: dwie skóry, trzy Deski Marchii, Sękaty korzeń i Pieczęć Wody."
	]
	quest.4200000000228031.title: "Głos wody"
	quest.4200000000228032.quest_desc: [
		"Dzwon przebudzenia to długi ton ducha. Osadź go blisko jego totemu, z pozostałymi pięcioma.",
		"Jak: Fragment dzwonu, cztery sztabki miedzi, Pieczęć Ducha i Duchowy odłamek."
	]
	quest.4200000000228032.title: "Przebudzenie ziemi"
	quest.4200000000228033.quest_desc: [
		"Szósty generator. Głos Krosna potrzebuje Nici krosna; trzymają ją Nieśpiewany i Starsi Szwaczy krosna.",
		"Jak: cztery Kryształy Marchii, dwie Nici krosna, dwie Duchowe tkaniny i Rdzeń rezonansowy."
	]
	quest.4200000000228033.title: "Szósty generator"
	quest.4200000000228034.quest_desc: [
		"Kopiec trzyma Puls w polu, żeby sześć głosów dzieliło jeden bufor.",
		"Jak: sześć Kamieni Marchii, dwa Związane echa i Ogniwo pulsu."
	]
	quest.4200000000228034.title: "Kopiec Pulsu"
	quest.4200000000228035.quest_desc: [
		"Trzymaj wszystkie sześć generatorów w pracy w zasięgu 32 bloków od siebie, jeden na głos.",
		"Jak: Żarowy róg, Harfa wiatru, Bęben fal, Dzwon przebudzenia, Kotwica krosna i Bębnoserce w zasięgu 32. Postęp przy sześciu głosach."
	]
	quest.4200000000228035.title: "Sześć głosów śpiewa"
	quest.4200000000228036.quest_desc: [
		"Prosi cysternę, by dalej dawała. Dziesięć minut wody, i pieczęć zostaje.",
		"Jak: użyj w skradaniu tablicy na Rytualnym palenisku w jego Kręgu obrzędu, z pasującą pieczęcią i Pulsem."
	]
	quest.4200000000228036.title: "Źródło, które wciąż daje"
	quest.4200000000228037.quest_desc: [
		"Krąg bębnów, który Nieśpiewany wciąż pamięta. Opcjonalna pamiątka.",
		"Jak: Nieśpiewany przy Cichym bębnie może go upuścić. Opcjonalnie."
	]
	quest.4200000000228037.title: "Krąg bębnów"
	quest.4200000000228038.quest_desc: [
		"Pusta pieczęć po pierwszym obrzędzie, gotowa na następny krąg.",
		"Jak: Pierwszy obrzęd przy palenisku; odznacz, gdy zapasowa pusta pieczęć jest w dłoni."
	]
	quest.4200000000228038.title: "Zapasowa pieczęć"
	quest.4200000000228039.quest_desc: [
		"Warsztat ognia. Totem Ognia w zasięgu ośmiu i Puls prowadzą każdy przepis pieca, także grys mineralny. Bębnoserce w dłoni nie utrzyma tego pieca.",
		"Jak: piec + rezonatory + dzwonek. Totem Ognia. Przetapia grys za Puls — Bębnoserce w dłoni tego nie uruchomi."
	]
	quest.4200000000228039.title: "Grys w piecu"
	quest.420000000022803A.quest_desc: [
		"Utkaj Pieczęć przepisu na warsztat. Puste butelki wracają do slotu, który je trzymał. Boczne IO odmawia obserwatorom i innym obozom. Od 5.0 chce czuwający Totem rezonansu (Krosno) w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, którego głosu brakuje.",
		"Jak: Kodeks Duchów nazywa wytwarzanie Krosna pieczęci. Osadź butelki; wracają do tamtego slotu."
	]
	quest.420000000022803A.title: "Krosno do pieczęci"
	quest.420000000022803B.quest_desc: [
		"Cztery tanie lampy Pulsu (Świecąca trzcina, Lampa odłamka, Kinkiet echa, Żarowa misa) ciągną 1–2 Pulsu na sekundę z kraty. Redstone je przyciemnia.",
		"Jak: wytwórz Lampę odłamka, postaw ją w zasięgu ośmiu bloków od Pulsu, potem przyciemnij ją redstone, jeśli chcesz noc."
	]
	quest.420000000022803B.title: "Lampa, która pije Puls"
	quest.420000000022803C.quest_desc: [
		"Dziesięć amuletów ducha nosisz w trzech plemiennych slotach, bez Curios. Niebo z Powietrzem to kreatywny lot. Użyj w skradaniu Totemu rezonansu, by związać głos; Chór wiąże każdy bliski głos przy Palenisku.",
		"Jak: wytwórz Amulet nieba, potem użyj go w skradaniu na totemie Powietrza. Kodeks Duchów: amulety ducha."
	]
	quest.420000000022803C.title: "Amulet z głosem"
	quest.420000000022803D.quest_desc: [
		"Warsztat wody. Nadaj rangę na stacjach echa, tak samo jak duchowemu wyposażeniu; wyższa ranga zużywa więcej Pulsu, gdy przyspiesza. Ranga zostaje po podniesieniu. Od 5.0 chce czuwający Totem rezonansu Wody w zasięgu ośmiu bloków, inaczej stoi bezczynnie i mówi, którego głosu brakuje.",
		"Jak: strony warsztatu Kodeksu Duchów. Postaw Pompę pływu na ściance cysterny, potem użyj Kodeksu w skradaniu, jeśli milczy."
	]
	quest.420000000022803D.title: "Pompa do cysterny"
	quest.420000000022803E.quest_desc: [
		"Każdy Puls nadal staje się 100 FE. Konwersja bez rangi to 60 Pulsu na sekundę. Nadaj adapterowi rangę na Dostrojeniu echa, potem na Więzi echa, potem na Echomanifeście, a status z pustą ręką poda bieżące tempo. Nadal nie może przyjmować FE.",
		"Jak: użyj w skradaniu Harmonijnego energetyzatora na Dostrojeniu echa, potem na Więzi echa, potem na Echomanifeście. Odznacz, gdy diagnoza poda tempo powyżej 60."
	]
	quest.420000000022803E.title: "Ranga prądu"
	quest.420000000022803F.quest_desc: [
		"Użyj w skradaniu dowolnej części duchowego wyposażenia albo amuletu na postawionym Totemie rezonansu (40 Pulsu), by związać ten głos. Mieszane zestawy są zamierzone. Totem nie jest zużywany. Krosno potrzebuje totemu Krosna.",
		"Jak: użyj w skradaniu narzędzia, części zbroi albo amuletu na totemie z 40 Pulsu w pobliżu. Odznacz, gdy podpowiedź nazwie związany głos."
	]
	quest.420000000022803F.title: "Zwiąż głos"
	quest.4200000000228040.quest_desc: [
		"Lampa z trzciny. Tanie światło Pulsu na ścieżkę obozu. Opcjonalnie.",
		"Jak: wytwórz Świecącą trzcinę. Postaw ją blisko Pulsu. Opcjonalnie."
	]
	quest.4200000000228040.title: "Światło trzciny"
	quest.4200000000228041.quest_desc: [
		"Kinkiet, który pije Puls. Opcjonalnie.",
		"Jak: wytwórz Kinkiet echa i powieś go. Opcjonalnie."
	]
	quest.4200000000228041.title: "Kinkiet echa"
	quest.4200000000228042.quest_desc: [
		"Misa obozowego ognia na Pulsie. Opcjonalnie.",
		"Jak: wytwórz Żarową misę. Opcjonalnie."
	]
	quest.4200000000228042.title: "Żarowa misa"
	quest.4200000000228043.quest_desc: [
		"Zawieś amulet wiatru u sufitu. Meble obozu Marchii: stołek, stół, urna, mata, półka i ten. Opcjonalnie.",
		"Jak: wytwórz Amulet wiatru i powieś go. Opcjonalna pamiątka."
	]
	quest.4200000000228043.title: "Amulet na wietrze"
	quest.4200000000228044.quest_desc: [
		"Chór wiąże każdy bliski głos totemu przy Rytualnym palenisku. Opcjonalnie, gdy Niebo jest w ręce.",
		"Jak: wytwórz Amulet chóru, potem użyj go w skradaniu przy Palenisku, gdy głosy są w zasięgu. Opcjonalnie."
	]
	quest.4200000000228044.title: "Każdy bliski głos"
	quest.4200000000228045.quest_desc: [
		"Siekiera zużywa Puls jak kilof. Nadaj rangę na stacjach echa; użyj w skradaniu totemu, by związać głos. Opcjonalnie.",
		"Jak: wytwórz Siekierę duchowego wyposażenia. Opcjonalnie, gdy kilof już jest."
	]
	quest.4200000000228045.title: "Ostrze do drewna"
	quest.4200000000228046.quest_desc: [
		"Cegły i miska nad trzema miedzianymi. Postaw go nad płonącym ogniskiem, ogniem, magmą, lawą albo Żarową misą; wcale nie żąda Pulsu. Do czterech składników i miska, w dowolnej kolejności, około dwunastu sekund na posiłek. Leje podają mu z góry i z boków i zabierają posiłek od spodu.",
		"Jak: cegły i miska nad trzema miedzianymi. Postaw go nad ogniskiem, ogniem, magmą, lawą albo Żarową misą; bez Pulsu."
	]
	quest.4200000000228046.title: "Garnek do obozu"
	quest.4200000000228047.quest_desc: [
		"Gorąca czerwona bulwa z Żarowych pustkowi. To, co zbierzesz, jest nasionem; posadź je na roli jak ziemniaka. Motyka duchowego wyposażenia ścina i sadzi od nowa jednym cięciem.",
		"Jak: rośnie dziko na Żarowych pustkowiach, przez Bęben bramy. To, co zbierzesz, jest nasionem; posadź je na roli."
	]
	quest.4200000000228047.title: "Żarowy korzeń"
	quest.4200000000228048.quest_desc: [
		"Rośnie dziko na Trzcinowym bagnie. Zbierz kępę i posadź zebrane; cztery fazy na zoranej ziemi, a pszczoły je zapylają.",
		"Jak: rośnie dziko na Trzcinowym bagnie, przez Bęben bramy. Posadź zebrane na roli."
	]
	quest.4200000000228048.title: "Ryż moczarowy"
	quest.4200000000228049.quest_desc: [
		"Ze Śnieżnych pól. Liczy się też jako zioło do Duchowego czajnika.",
		"Jak: rośnie dziko na Śnieżnych polach, przez Bęben bramy. Posadź zebrane na roli."
	]
	quest.4200000000228049.title: "Jagoda szronu"
	quest.420000000022804A.quest_desc: [
		"Z Grani połysku. Zioło do czajnika, a zarazem uprawa.",
		"Jak: rośnie dziko na Grani połysku, przez Bęben bramy. Posadź zebrane na roli."
	]
	quest.420000000022804A.title: "Fasola połysku"
	quest.420000000022804B.quest_desc: [
		"Ze Stepu, i to ziarno, na którym opiera się większość dań plemion. Najpierw wyhoduj jego grządkę, potem resztę.",
		"Jak: rośnie dziko na Stepie, przez Bęben bramy. Posadź zebrane na roli."
	]
	quest.420000000022804B.title: "Ziarno stepu"
	quest.420000000022804C.quest_desc: [
		"Dwa Ziarna stepu i jeden Żelazny grys w Garnku paleniska. Zjedzenie dania plemienia niesie jego dar przez pięć minut; dar Śpiewaków żwiru kruszy więcej z rudy. Gdy plemię nazwie cię Przyjacielem, jego Krewniacy sprzedają danie za cztery swojej uprawy, a ofiarowanie plemieniu jego własnego dania przy jego palenisku daje sześć pozycji.",
		"Jak: dwa Ziarna stepu i jeden Żelazny grys w Garnku paleniska nad żarem. Krewniacy Śpiewaków żwiru sprzedają je przy pozycji Przyjaciel."
	]
	quest.420000000022804C.title: "Bochen Śpiewaków żwiru"
	quest.420000000022804D.quest_desc: [
		"Dwie Surowe zwierzyny i jeden Żarowy korzeń. Surowa zwierzyna wypada ze zwierzyny Marchii. Dar Chodzących po krawędzi: nigdy nie spadasz, gdy się skradasz. Każde plemię ma danie; JEI wymienia wszystkie dziewięć pod garnkiem.",
		"Jak: dwie Surowe zwierzyny i jeden Żarowy korzeń w Garnku paleniska. Surowa zwierzyna wypada ze zwierzyny Marchii."
	]
	quest.420000000022804D.title: "Susz Chodzących po krawędzi"
	quest.420000000022804E.quest_desc: [
		"Papka z korzenia strażnika, Chleb pieczony na grysie, Żarowy korzeń i Ziarno stepu do garnka. Postaw ucztę na solidnym bloku, a starczy na sześć porcji; każda nasyca cię i daje błogosławieństwo Ziemi na osiem minut — kopiesz szybciej, stoisz pewnie. Każdy głos ma ucztę ze swoich dań.",
		"Jak: Papka z korzenia strażnika, Chleb pieczony na grysie, Żarowy korzeń i Ziarno stepu w Garnku paleniska. Postaw je; sześć porcji."
	]
	quest.420000000022804E.title: "Stół dla obozu"
	quest.420000000022804F.quest_desc: [
		"Kości i żelazo wokół kotła, Kościany dzwonek pod spodem. Posadź go nad żarem. Trzy miejsca: surowy odczynnik z twojej sakwy, zioło Marchii i baza — szklana butelka daje dwie tynktury, plaster miodu dwie maści, węgiel drzewny cztery kadzidła. Partia to dziesięć sekund i 24 Pulsu z kraty. Najbliższy totem w ośmiu blokach śpiewa w war.",
		"Jak: kości i żelazo wokół kotła, Kościany dzwonek pod spodem. Posadź go nad żarem; totem w zasięgu 8 kształtuje war."
	]
	quest.420000000022804F.title: "Czajnik nad ogniem"
	quest.4200000000228050.quest_desc: [
		"Rodzina odczynnika wybiera lekarstwo: Podpałka to Siła, Chłodzenie to Odporność na ogień, Odtrutka zdejmuje zatrucie, Naprawa to Regeneracja, i tak dalej. Tynktura trwa trzy minuty i oddaje butelkę. Każde lekarstwo zdejmuje Chorobę ducha, Nieśpiewaną ciszę, Wystrzępienie i Chorobę ley.",
		"Jak: Duchowy czajnik — surowy odczynnik, zioło Marchii i szklana butelka. Dziesięć sekund, 24 Pulsu, dwie tynktury."
	]
	quest.4200000000228050.title: "Wypij"
	quest.4200000000228051.quest_desc: [
		"Plaster miodu jako baza. Użyj maści na sobie, albo na przyjacielu, osadniku lub swoim chowańcu: trzy serca naraz, każdy szkodliwy efekt znika, i lekarstwo przez połowę czasu tynktury. Stos takich to różnica między ciężką nocą w Marchii a spacerem do domu.",
		"Jak: Duchowy czajnik — surowy odczynnik, zioło Marchii i plaster miodu. Dwie maści na partię."
	]
	quest.4200000000228051.title: "Nałóż"
	quest.4200000000228052.quest_desc: [
		"Węgiel drzewny jako baza. Osadź kadzidło w Koszu rytualnym — do szesnastu pałeczek, bez pieczęci i bez Pulsu — i co dwie sekundy każdy w zasięgu ośmiu bloków dostaje lekarstwo, a chowańce są łatane o serce. Każda pałeczka pali się trzydzieści sekund. Redstone gasi je; skradaj się z pustymi rękami, by zabrać z powrotem.",
		"Jak: Duchowy czajnik — surowy odczynnik, zioło Marchii i węgiel drzewny. Cztery kadzidła na partię; spal je w Koszu rytualnym."
	]
	quest.4200000000228052.title: "Spal dla wszystkich"
	quest.4200000000228053.quest_desc: [
		"Dwa Kościane dzwonki wokół Przejawionej sztabki na patyku. Przytrzymaj Użyj, a co pół sekundy łata tego, na kogo patrzysz w zasięgu sześciu bloków, albo ciebie: trzy czwarte serca za 2 Puls. Dostaje rangę na stacjach Echa jak reszta duchowego wyposażenia; od Związanego każde potrząśnięcie zdejmuje Chorobę ducha o poziom.",
		"Jak: dwa Kościane dzwonki wokół Przejawionej sztabki na patyku. Przytrzymaj Użyj, by łatać tego, na kogo patrzysz."
	]
	quest.4200000000228053.title: "Potrząśnij"
	quest.4200000000228054.quest_desc: [
		"Bruk nad blokiem magmy daje cztery. Nad żarem parują. Prześpij całą noc w łóżku, z gorącymi kamieniami w pięciu blokach i dachem nad tobą: budzisz się w pełni uleczony i oczyszczony, z dziesięcioma minutami Duchowego błogosławieństwa, żeby choroba nie chwyciła.",
		"Jak: bruk nad blokiem magmy daje cztery. Postaw je nad żarem, w pięciu blokach od zadaszonego łóżka."
	]
	quest.4200000000228054.title: "Noc w chacie"
	quest.4200000000228055.quest_desc: [
		"Dwa kamienie, Łuska Mchogrzbietu i Trzcina ducha wokół Pieczęci ducha; pieczęć jest oddawana. Rzuć to na palenisko z osadzoną Pieczęcią ducha, w jego Kręgu obrzędu, za 500 Pulsu: wszyscy w dwunastu blokach odzyskują dziesięć serc, zostają oczyszczeni i pobłogosławieni, a krąg zostaje otwarty przez dziesięć minut. Najpierw połóż Duchową pozostałość poległego chowańca na postumencie, a wróci cały.",
		"Jak: dwa kamienie, Łuska Mchogrzbietu, Trzcina ducha i Pieczęć ducha, bezkształtnie; pieczęć wraca. Rzuć na zapieczętowane palenisko w jego Kręgu obrzędu."
	]
	quest.4200000000228055.title: "Tablica obrzędu: Krąg leczenia"
	quest.4200000000228056.quest_desc: [
		"Przejawiona sztabka, Kościany dzwonek i patyk po skosie. Siedem obrażeń, zasięg plus półtora, a pchnięcie w biegu trafia o 35 procent mocniej. Pod spodem jest Ostrze: dostaje rangę na stacjach Echa, wydaje Puls na uderzenia echa i bierze głos totemu. Trzyma Ogara szczeliny na wyciągnięcie ręki.",
		"Jak: Przejawiona sztabka, Kościany dzwonek i patyk po skosie. Dostaje rangę na stacjach Echa jak Ostrze."
	]
	quest.4200000000228056.title: "Najpierw zasięg"
	quest.4200000000228057.quest_desc: [
		"Cztery Przejawione sztabki w kształt T nad Kościanym dzwonkiem. Dziesięć obrażeń, zasięg plus pół, ciężkie — spowalnia krok, gdy jest w ręku — i najszersze, najsilniejsze cięcie w rodzinie. Halabarda, topór bojowy, młot bojowy, sztylet, kosa i trójząb robi się tak samo; każde wymienia zasięg, szybkość i ciężar wobec pozostałych.",
		"Jak: cztery Przejawione sztabki w kształt T nad Kościanym dzwonkiem. Ciężkie; najszersze cięcie."
	]
	quest.4200000000228057.title: "Najszersze cięcie"
	quest.4200000000228058.quest_desc: [
		"Nić i Miedziane rezonatory wokół Kościanego dzwonka. Strzela dźwiękowymi bełtami za Puls z ogniw, które nosisz, i bierze strzały wersetu. Szybko puszcza znowu, i pół naciągu, gdy się spieszysz.",
		"Jak: nić i Miedziane rezonatory wokół Kościanego dzwonka. Strzela dźwiękowymi bełtami z niesionego Pulsu."
	]
	quest.4200000000228058.title: "Łuk, który śpiewa"
	quest.4200000000228059.quest_desc: [
		"Przejawione sztabki po bokach Łuku pulsu, zaczep potykacza i patyki pod spodem. Przytrzymaj Użyj, by naładować — 10 Pulsu z góry, trochę dłużej niż pełny naciąg — potem użyj znów, by wystrzelić. Trafia około półtora raza tak mocno, leci prawie prosto i trzyma strzał, jak długo chcesz.",
		"Jak: Przejawione sztabki po bokach Łuku pulsu, zaczep potykacza i patyki pod spodem. Przytrzymaj Użyj, by naładować, użyj, by wystrzelić."
	]
	quest.4200000000228059.title: "Cięższa siostra łuku"
	quest.420000000022805A.quest_desc: [
		"Ława pieśni ma gniazdo na broń obok wyniku. Postaw totem w zasięgu z Pulsem w kracie, trzymaj Sakwę odczynników na pasku szybkiego wyboru z czterema wzmocnionymi odczynnikami jednego rodzaju, osadź broń duchowego wyposażenia, wybierz odczynnik i naciśnij Namaszczenie: cztery odczynniki i 32 Pulsu. Przypalenie pali, Zew burzy puszcza błyskawicę łukiem, Żądza krwi kradnie życie, Naprawa naprawia broń — jedenaście w sumie, jedno naraz; inny odczynnik je zastępuje. Tylko duchowe wyposażenie przyjmuje pracę ławy, chyba że paczka otworzy tribalpower:anointable. Zaznacz to, gdy broń niesie jedno.",
		"Jak: broń duchowego wyposażenia w gnieździe Ławy pieśni, cztery wzmocnione odczynniki w sakwie, 32 Pulsu; naciśnij Namaszczenie. Zaznacz, gdy jest namaszczona."
	]
	quest.420000000022805A.title: "Odczynnik w ostrzu"
	quest.420000000022805B.quest_desc: [
		"Pnącza wokół Trzciny ducha i perła Endera dają dwa. Postaw po jednym na każdym piętrze w tej samej kolumnie; znajdują się same, bez łączenia i bez energii. Skocz, by wznosić się do następnej windy wyżej, skradaj się, by opaść do tej niżej, do 48 bloków w każdą stronę. Winda z sufitem nad sobą jest pomijana.",
		"Jak: pnącza wokół Trzciny ducha i perła Endera dają dwa. Ustaw je w jednej kolumnie; skacz w górę, skradaj się w dół."
	]
	quest.420000000022805B.title: "W górę kolumny"
	quest.420000000022805C.quest_desc: [
		"Trzcina ducha pod sznurkiem. Użyj na stworzeniu, by je zabrać, i na bloku, by je postawić, całe i bezpieczne. Nigdy gracza, bossa ani elity Marchii. Tkana to dwa użycia — jedna droga; urny miedziane, przejawione i rezonansowe niosą więcej, a rezonansowa nigdy się nie zużywa. Nie zabierze stworzenia, gdy zostało jedno użycie.",
		"Jak: Trzcina ducha pod sznurkiem. Użyj na stworzeniu, by je zabrać, na bloku, by je postawić. Dwa użycia."
	]
	quest.420000000022805C.title: "Nieś stworzenie do domu"
	quest.420000000022805D.quest_desc: [
		"Skóra na deskach wokół bloku dźwiękowego. Rytuał bramy jako gra bez portalu na końcu: każdy utwór, jaki zawiera, grany na A, S, D, F, gdy uderzenia dochodzą do linii. Trzyma twój najlepszy wynik na utwór i tablicę pięciu najlepszych serwera. Poćwicz tutaj, zanim weźmiesz prawdziwy Bęben bramy.",
		"Jak: skóra na deskach wokół bloku dźwiękowego. Użyj go, by wybrać utwór i grać A, S, D, F."
	]
	quest.420000000022805D.title: "Bęben dla radości"
	quest.420000000022805E.quest_desc: [
		"Cztery świetlokamienie wokół Pieczęci Ducha, dwie Przejawione sztabki, złota marchewka i Duchowa tkanina. Użyj go, by go nosić; użycie w skradaniu otwiera trzy miejsca na amulety. Amulet latarni niesie głos Ducha: widzenie w ciemności, a każde błogosławieństwo głosu na tobie trwa o połowę dłużej. Noszone amulety kosztują 2 Puls na głos co dwie sekundy z niesionego Ogniwa pulsu.",
		"Jak: cztery świetlokamienie wokół Pieczęci Ducha, dwie Przejawione sztabki, złota marchewka i Duchowa tkanina. Użyj go, by go nosić; użycie w skradaniu otwiera miejsca."
	]
	quest.420000000022805E.title: "Światło do noszenia"
	quest.420000000022805F.quest_desc: [
		"Gdy plemię zwie cię Gościem, kliknij prawym jego Starszego i rozmawiaj. Poproś o pracę, a wręczą ci prośbę — trzy otwarte dziennie, jedna trzymana na plemię, każda płaci reputacją, a co trzecia Znakiem plemienia. Poproś o ich opowieść, a zaczyna się droga siedmiu kroków: Przyjaciel, rzecz, którą cenią, polowanie przy ich ogniskach, obrzęd w ich obozie, ich danie ugotowane i dokąd cię ślą. Ostatni krok to próba przeciw strażnikowi. Skończ jedną opowieść i trzymaj jej relikwię.",
		"Jak: kliknij prawym Starszego plemienia na Gościu lub wyżej i poproś o ich opowieść; siedem kroków kończy się na strażniku. Osiągnięcie wyzwala się przy pierwszej relikwii."
	]
	quest.420000000022805F.title: "Opowiedziana opowieść"
	quest.4200000000228060.quest_desc: [
		"Relikwia Strażników platformy. Ich opowieść kończy się na Duchu szarży, przy Zdeptanym pierścieniu na Stepie; wygraj próbę, a Starszy ją wręczy. Niesiona gdziekolwiek w ekwipunku utrzymuje przy tobie ich dar niezależnie od reputacji: nigdy nie depczesz pola.",
		"Jak: dokończ opowieść Strażników platformy z ich Starszym; próba to Duch szarży na Stepie."
	]
	quest.4200000000228060.title: "Strzeżony żar"
	quest.4200000000228061.quest_desc: [
		"Relikwia Śpiewaków żwiru. Ich opowieść kończy się przy Pryzmatycznym wężu, przy Śpiewającej szczelinie na Kryształowych polach; wygraj próbę, a Starszy wręczy ci relikwię. Niesiona gdziekolwiek w ekwipunku, utrzymuje przy tobie ich dar, jakiekolwiek masz poważanie: z rudy wypada ci więcej.",
		"Jak: dokończ opowieść Śpiewaków żwiru z ich Starszym; próba to Pryzmatyczny wąż na Kryształowych polach."
	]
	quest.4200000000228061.title: "Dźwięczący kamień"
	quest.4200000000228062.quest_desc: [
		"Relikwia Wiązaczy korzeni. Ich opowieść kończy się przy Bagiennej matronie, przy Utopionym korzeniu na Trzcinowym bagnie; wygraj próbę, a Starszy wręczy ci relikwię. Niesiona gdziekolwiek w ekwipunku, utrzymuje przy tobie ich dar, jakiekolwiek masz poważanie: uprawy śpieszą się wokół ciebie.",
		"Jak: dokończ opowieść Wiązaczy korzeni z ich Starszym; próba to Bagienna matrona na Trzcinowym bagnie."
	]
	quest.4200000000228062.title: "Pierwszy korzeń"
	quest.4200000000228063.quest_desc: [
		"Relikwia Chodzących po krawędzi. Ich opowieść kończy się przy Burzowym ruku, przy Grzędzie na Wyżynach; wygraj próbę, a Starszy wręczy ci relikwię. Niesiona gdziekolwiek w ekwipunku, utrzymuje przy tobie ich dar, jakiekolwiek masz poważanie: nie spadasz, póki się skradzasz.",
		"Jak: dokończ opowieść Chodzących po krawędzi z ich Starszym; próba to Burzowy ruk na Wyżynach."
	]
	quest.4200000000228063.title: "Gwóźdź mostu"
	quest.4200000000228064.quest_desc: [
		"Relikwia Bębnoserc. Ich opowieść kończy się przy Żużlowym tytanie, przy Żużlowym tronie na Żarowych pustkowiach; wygraj próbę, a Starszy wręczy ci relikwię. Niesiona gdziekolwiek w ekwipunku, utrzymuje przy tobie ich dar, jakiekolwiek masz poważanie: uderzasz szybciej.",
		"Jak: dokończ opowieść Bębnoserc z ich Starszym; próba to Żużlowy tytan na Żarowych pustkowiach."
	]
	quest.4200000000228064.title: "Równy bęben"
	quest.4200000000228065.quest_desc: [
		"Relikwia Tkaczy wzorów. Ich opowieść kończy się u Bębniarza przypływu, przy Kamieniu przypływu na Płyciznach; wygraj próbę, a Starszy ci ją wręczy. Niesiona gdziekolwiek w ekwipunku, utrzymuje przy tobie ich dar, jakiekolwiek masz poważanie: stacje Echa blisko ciebie pracują podwójnie.",
		"Jak: dokończ opowieść Tkaczy wzorów u ich Starszego; próba to Bębniarz przypływu na Płyciznach."
	]
	quest.4200000000228065.title: "Silent Gear"
	quest.4200000000228066.quest_desc: [
		"Relikwia Strażników kolonii. Ich opowieść kończy się u Upiora kurhanu, przy Pierścieniu kurhanu na Śnieżnych polach; wygraj próbę, a Starszy ci ją wręczy. Niesiona gdziekolwiek w ekwipunku, utrzymuje przy tobie ich dar, jakiekolwiek masz poważanie: nigdy cię nie żądlą.",
		"Jak: dokończ opowieść Strażników kolonii u ich Starszego; próba to Upiór kurhanu na Śnieżnych polach."
	]
	quest.4200000000228066.title: "Pieczęć ula"
	quest.4200000000228067.quest_desc: [
		"Relikwia Rzeźbiarzy pieczęci. Ich opowieść kończy się u Strażnika sklepienia, przy Zapieczętowanej bramie na Grani połysku; wygraj próbę, a Starszy ci ją wręczy. Niesiona gdziekolwiek w ekwipunku, utrzymuje przy tobie ich dar, jakiekolwiek masz poważanie: twoje amulety żądają połowy Pulsu.",
		"Jak: dokończ opowieść Rzeźbiarzy pieczęci u ich Starszego; próba to Strażnik sklepienia na Grani połysku."
	]
	quest.4200000000228067.title: "Uprzejma pieczęć"
	quest.4200000000228068.quest_desc: [
		"Relikwia Szwaczy krosna. Ich opowieść kończy się u Nieśpiewanego, przy Cichym bębnie; wygraj próbę, a Starszy ci ją wręczy. Niesiona gdziekolwiek w ekwipunku, utrzymuje przy tobie ich dar, jakiekolwiek masz poważanie: śpiewasz taniej.",
		"Jak: dokończ opowieść Szwaczy krosna u ich Starszego; próba to Nieśpiewany przy Cichym bębnie."
	]
	quest.4200000000228068.title: "Dziewiąta Nić"
	quest.4200000000228069.quest_desc: [
		"Każda opowieść plemienia skończona: stawiono czoła ośmiu strażnikom i Nieśpiewanemu. Gdy wszystkie dziewięć relikwii jest w ekwipunku, Dziewiąte Porozumienie jest w zasięgu. `/tribalpower standing` pokazuje, jak stoisz z każdym plemieniem.",
		"Jak: dokończ wszystkie dziewięć opowieści. Osiągnięcie wyzwala się, gdy dziewiąta relikwia jest w ręku."
	]
	quest.4200000000228069.title: "Dziewięć relikwii"
	quest.420000000022806A.quest_desc: [
		"Żużlowy tron na Żarowych pustkowiach: pierścień z kamienia z Ołtarzem strażnika w środku, na wypolerowanym łupku głębinowym, między czterema zapalonymi świecami, pod otwartym niebem. Użyj ołtarza skradając się z pustą ręką, a powie, czego chce — osiem Łusek magmy — a potem połóż je na wierzchu i cofnij się. Przykucnij, by oprzeć się jego uderzeniom; w szale pierścienie się zapalają, a Skrzaty żaru wstają z żużlu. Przy połowie zdrowia wpada w szał i wzywa stworzenia swojego kraju, które nic nie zostawiają. Zostaw go na pół minuty, a znów zaśnie; ołtarz odpoczywa dwadzieścia minut między wezwaniami. Zostawia Żużlowy rdzeń, a jego upadek kończy opowieść Bębnoserc.",
		"Jak: użyj Ołtarza strażnika kraju, skradając się z pustą ręką, połóż osiem tego odczynnika, który wymieni, i wygraj. Osiągnięcie wyzwala się przy zabiciu."
	]
	quest.420000000022806A.title: "Żużlowy tytan uciszony"
	quest.420000000022806B.quest_desc: [
		"Utopiony korzeń na Trzcinowym bagnie: pierścień z kamienia z Ołtarzem strażnika w środku, na wypolerowanym łupku głębinowym, między czterema zapalonymi świecami, pod otwartym niebem. Użyj ołtarza skradając się z pustą ręką, a powie, czego chce — osiem Trzcinowych kłów — a potem połóż je na wierzchu i cofnij się. Jej sidło wciąga cię i spowalnia; trzymaj się twardego gruntu i zetnij Trzcinowych łowców, których wzywa. Przy połowie zdrowia wpada w szał i wzywa stworzenia swojego kraju, które nic nie zostawiają. Zostaw ją na pół minuty, a znów zaśnie; ołtarz odpoczywa dwadzieścia minut między wezwaniami. Zostawia Serce bagna, a jej upadek kończy opowieść Wiązaczy korzeni.",
		"Jak: użyj Ołtarza strażnika kraju, skradając się z pustą ręką, połóż osiem tego odczynnika, który wymieni, i wygraj. Osiągnięcie wyzwala się przy zabiciu."
	]
	quest.420000000022806B.title: "Bagienna matrona uciszona"
	quest.420000000022806C.quest_desc: [
		"Pierścień kurhanu na Śnieżnych polach: pierścień z kamienia z Ołtarzem strażnika w środku, na wypolerowanym łupku głębinowym, między czterema zapalonymi świecami, pod otwartym niebem. Użyj ołtarza skradając się z pustą ręką, a powie, czego chce — osiem Żuwaczek szronu — a potem połóż je na wierzchu i cofnij się. Jego oddech mrozi wszystko przed nim. Zajdź od tyłu; Pełzaki szronu, które wzywa, są powolne. Przy połowie zdrowia wpada w szał i wzywa stworzenia swojego kraju, które nic nie zostawiają. Zostaw go na pół minuty, a znów zaśnie; ołtarz odpoczywa dwadzieścia minut między wezwaniami. Zostawia Kamień kurhanu, a jego upadek kończy opowieść Strażników kolonii.",
		"Jak: użyj Ołtarza strażnika kraju, skradając się z pustą ręką, połóż osiem tego odczynnika, który wymieni, i wygraj. Osiągnięcie wyzwala się przy zabiciu."
	]
	quest.420000000022806C.title: "Upiór kurhanu uciszony"
	quest.420000000022806D.quest_desc: [
		"Śpiewająca szczelina na Kryształowych polach: pierścień z kamienia z Ołtarzem strażnika w środku, na wypolerowanym łupku głębinowym, między czterema zapalonymi świecami, pod otwartym niebem. Użyj ołtarza skradając się z pustą ręką, a powie, czego chce — osiem Pryzmatycznych pancerzy — a potem połóż je na wierzchu i cofnij się. Strzela błyskawicami światła, które znaczą cię blaskiem. Chodź bokiem, podejdź i patrz na drugą błyskawicę, którą dodaje w szale. Przy połowie zdrowia wpada w szał i wzywa stworzenia swojego kraju, które nic nie zostawiają. Zostaw go na pół minuty, a znów zaśnie; ołtarz odpoczywa dwadzieścia minut między wezwaniami. Zostawia Pryzmatyczny rdzeń, a jego upadek kończy opowieść Śpiewaków żwiru.",
		"Jak: użyj Ołtarza strażnika kraju, skradając się z pustą ręką, połóż osiem tego odczynnika, który wymieni, i wygraj. Osiągnięcie wyzwala się przy zabiciu."
	]
	quest.420000000022806D.title: "Pryzmatyczny wąż uciszony"
	quest.420000000022806E.quest_desc: [
		"Zapieczętowana brama na Grani połysku: pierścień z kamienia z Ołtarzem strażnika w środku, na wypolerowanym łupku głębinowym, między czterema zapalonymi świecami, pod otwartym niebem. Użyj ołtarza skradając się z pustą ręką, a powie, czego chce — osiem Pieczęci strażnika — a potem połóż je na wierzchu i cofnij się. Najcięższy pancerz Marchii i zamach, który zrzuca cię z grani. W szale osłania się po trzy sekundy: przeczekaj. Przy połowie zdrowia wpada w szał i wzywa stworzenia swojego kraju, które nic nie zostawiają. Zostaw go na pół minuty, a znów zaśnie; ołtarz odpoczywa dwadzieścia minut między wezwaniami. Zostawia Pieczęć sklepienia, a jego upadek kończy opowieść Rzeźbiarzy pieczęci.",
		"Jak: użyj Ołtarza strażnika kraju, skradając się z pustą ręką, połóż osiem tego odczynnika, który wymieni, i wygraj. Osiągnięcie wyzwala się przy zabiciu."
	]
	quest.420000000022806E.title: "Strażnik sklepienia uciszony"
	quest.420000000022806F.quest_desc: [
		"Kamień przypływu na Płyciznach: pierścień z kamienia z Ołtarzem strażnika w środku, na wypolerowanym łupku głębinowym, między czterema zapalonymi świecami, pod otwartym niebem. Użyj ołtarza skradając się z pustą ręką, a nazwie, czego chce — osiem Kłów solanki — potem połóż je na nim i cofnij się. Każde uderzenie ciągnie wszystkich ku niemu i rani. Walcz z nim z brzegu, plecami do czegoś solidnego. Przy połowie zdrowia budzi się i wzywa stworzenia swojego kraju, które nic nie zostawiają. Zostaw go na pół minuty, a znów zaśnie; ołtarz odpoczywa dwadzieścia minut między wezwaniami. Zostawia Muszlę przypływu, a jego upadek kończy opowieść Tkaczy wzorów.",
		"Jak: użyj Ołtarza strażnika kraju, skradając się z pustą ręką, połóż osiem tego odczynnika, który wymieni, i wygraj. Osiągnięcie wyzwala się przy zabiciu."
	]
	quest.420000000022806F.title: "Bębniarz przypływu uciszony"
	quest.4200000000228070.quest_desc: [
		"Zdeptany pierścień na Stepie: pierścień z kamienia z Ołtarzem strażnika w środku, na wypolerowanym łupku głębinowym, między czterema zapalonymi świecami, pod otwartym niebem. Użyj ołtarza skradając się z pustą ręką, a nazwie, czego chce — osiem Ścięgien goleni — potem połóż je na nim i cofnij się. Szarżuje. Zejdź w bok i uderz, gdy mija; gdy Zgrzytacze z nory wychodzą, stań na bloku. Przy połowie zdrowia budzi się i wzywa stworzenia swojego kraju, które nic nie zostawiają. Zostaw go na pół minuty, a znów zaśnie; ołtarz odpoczywa dwadzieścia minut między wezwaniami. Zostawia Róg stada, a jego upadek kończy opowieść Strażników platformy.",
		"Jak: użyj Ołtarza strażnika kraju, skradając się z pustą ręką, połóż osiem tego odczynnika, który wymieni, i wygraj. Osiągnięcie wyzwala się przy zabiciu."
	]
	quest.4200000000228070.title: "Duch szarży uciszony"
	quest.4200000000228071.quest_desc: [
		"Grzęda na Wyżynach: pierścień z kamienia z Ołtarzem strażnika w środku, na wypolerowanym łupku głębinowym, między czterema zapalonymi świecami, pod otwartym niebem. Użyj ołtarza skradając się z pustą ręką, a nazwie, czego chce — osiem Skrzydeł burzy — potem połóż je na nim i cofnij się. Nurkuje i wyrzuca cię w powietrze; rozbudzony, za każdym lotem nurkowym idzie piorun. Łuk i dach pomagają bardziej niż tarcza. Przy połowie zdrowia budzi się i wzywa stworzenia swojego kraju, które nic nie zostawiają. Zostaw go na pół minuty, a znów zaśnie; ołtarz odpoczywa dwadzieścia minut między wezwaniami. Zostawia Pióro burzy, a jego upadek kończy opowieść Chodzących po krawędzi.",
		"Jak: użyj Ołtarza strażnika kraju, skradając się z pustą ręką, połóż osiem tego odczynnika, który wymieni, i wygraj. Osiągnięcie wyzwala się przy zabiciu."
	]
	quest.4200000000228071.title: "Burzowy ruk uciszony"
	quest.4200000000228072.quest_desc: [
		"Wszystkie osiem rdzeni strażnika i Serce Nieśpiewanego, bezkształtnie. Rdzeń z Nicią krosna dałby zamiast tego sześć Rdzeni rezonansowych, więc weź drugi zestaw łupów, jeśli chcesz obu. Pasek bossa każdego strażnika nosi kolor jego plemienia.",
		"Jak: wszystkie osiem rdzeni strażnika i Serce Nieśpiewanego, bezkształtnie. Rzuć ją w kręgu Krosna z dziewięcioma relikwiami przy sobie."
	]
	quest.4200000000228072.title: "Tabliczka dziewięciu"
	quest.4200000000228073.quest_desc: [
		"Narysuj krąg Krosna — Pieczęć krosna osadzona w palenisku wewnątrz jego Kręgu obrzędu — i rzuć tabliczkę ze wszystkimi dziewięcioma relikwiami przy sobie; obrzęd pobiera swój Puls, zanim chwyci. Dziewięć świateł wschodzi, po jednym w barwie każdego plemienia. Od tej pory każde plemię traktuje cię co najmniej jak Krewniaka, wszystkie dziewięć darów osiada na tobie na jakiś czas, a zorza płonie pełna każdej nocy, gdy stoisz pod nią. Raz na gracza; drugie rzucenie tylko zapala krąg.",
		"Jak: Pieczęć krosna w palenisku wewnątrz jego Kręgu obrzędu, dziewięć relikwii w ekwipunku; użyj w skradaniu tabliczki na palenisku."
	]
	quest.4200000000228073.title: "Krosno się zgadza"
	quest.4200000000228074.quest_desc: [
		"Szesnaście fragmentów historii Krosna wyryto w Marchii: osiem Rzeźbionych kamieni w ścianach jej ruin, osiem murali dwa na dwa na terenach strażników. Kliknij PPM na jednym, by je przeczytać; Kodeks Duchów je zachowuje, a dział Kroniki układa je po kolei. Przeczytaj wszystkie szesnaście, a historia jest cała.",
		"Jak: PPM na wszystkich ośmiu Rzeźbionych kamieniach w ruinach Marchii i na wszystkich ośmiu muralach na terenach strażników."
	]
	quest.4200000000228074.title: "Kronika w całości"
	quest.4200000000228075.quest_desc: [
		"Osadzony w ścianach ruin Marchii — stare dzieła, zatopiona kapliczka, kurhany, grobowce, skarbce. Przeczytaj tam, gdzie go znajdziesz, potem podnieś i postaw na własnej ścianie; co przeczytane, zostaje przeczytane.",
		"Jak: osadzony w ścianach ruin Marchii. Przeczytaj, potem rozbij go i postaw na własnej ścianie."
	]
	quest.4200000000228075.title: "Kamień, który pamięta"
	quest.4200000000228076.quest_desc: [
		"Dwa bloki szerokości i dwa wysokości na terenie każdego strażnika; każdy maluje kraj, w którym stoi. Czytanie dowolnej części czyta całość. Postawiony jako jedna całość, schodzi jako jedna; mural wycięty w trybie kreatywnym zmienia rozdział kliknięciem w skradaniu.",
		"Jak: stoi dwa na dwa na terenie każdego strażnika. Przeczytaj, potem zdejmij w całości i postaw w domu."
	]
	quest.4200000000228076.title: "Ściana, która maluje swój kraj"
	quest.4200000000228077.quest_desc: [
		"Marchia działa sama z siebie. Opad popiołu, Burza połysku, Biała zasłona i Trzcinowa mgła zamykają kraj i podnoszą duchy za dnia; każde karmi generatory jednego głosu i hamuje drugiego. Od czasu do czasu nici ley jednego głosu wzbierają: kolektory, które je niosą, dają dwa razy tyle, lecz stań na gołym skrzyżowaniu bez kolektora, a Choroba ley kołysze ziemię i osusza twój Puls. Każde plemię ma dzień święta po kolei — siądź do uczty po dar. Ciepłe światło, które dryfuje blisko, to wędrujący duch; dojdź do niego po linijkę historii jego kraju i mały dar. Burze i wezbrania ogłaszają się dwie minuty wcześniej, na czacie i nad paskiem szybkiego wyboru. Zaznacz, gdy jedno przetrwasz.",
		"Jak: bądź w Marchii podczas pogody, wezbrania albo dnia święta; zaznacz, gdy już tak będzie."
	]
	quest.4200000000228077.title: "Marchia oddycha"
	quest.420000000023058C.quest_desc: [
		"Śpiewacy żwiru nigdy nie tną kamienia dwa razy tak samo. Ten warsztat pamięta każde cięcie.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: kamień + części stołu w JEI. Włóż blok i wybierz wariant."
	]
	quest.420000000023058C.title: "Stół kamieniarza"
	quest.420000000023058D.quest_desc: [
		"Ta sama sztuczka dla drewna — sto desek z jednej.",
		"Jak: stół stolarza Chipped w JEI. Ten sam pomysł co stół kamieniarza, dla drewna."
	]
	quest.420000000023058D.title: "Stół stolarza"
	quest.420000000023058E.quest_desc: [
		"Piasek w szkło, potem szkło w każdy kształt, jaki przyjmie światło.",
		"Jak: stół Chipped w JEI (kamieniarz, stolarz, dmuchacz szkła…). Włóż blok do stołu i wybierz cięcie."
	]
	quest.420000000023058E.title: "Dmuchacz szkła"
	quest.420000000023058F.quest_desc: [
		"Wełna i sukno, przetkane — w sam raz, dla platformy, która łata Krosno.",
		"Jak: stół Chipped w JEI (kamieniarz, stolarz, dmuchacz szkła…). Włóż blok do stołu i wybierz cięcie."
	]
	quest.420000000023058F.title: "Stół Krosna"
	quest.4200000000230590.quest_desc: [
		"Liście, sadzonki i rzeczy rosnące, posortowane na warianty.",
		"Jak: stół Chipped w JEI (kamieniarz, stolarz, dmuchacz szkła…). Włóż blok do stołu i wybierz cięcie."
	]
	quest.4200000000230590.title: "Stół botanika"
	quest.4200000000230591.quest_desc: [
		"Kolorowe bloki i dziwniejszy kamień. Wybierz wariant; warsztat trzyma resztę.",
		"Jak: stół Chipped w JEI (kamieniarz, stolarz, dmuchacz szkła…). Włóż blok do stołu i wybierz cięcie."
	]
	quest.4200000000230591.title: "Stół alchemiczny"
	quest.4200000000230592.quest_desc: [
		"Metal i bloki o maszynowej twarzy, cięte pod gust.",
		"Jak: stół Chipped w JEI (kamieniarz, stolarz, dmuchacz szkła…). Włóż blok do stołu i wybierz cięcie."
	]
	quest.4200000000230592.title: "Stół majsterkowicza"
	quest.4200000000230593.quest_desc: [
		"Podaj blok do Stołu kamieniarza i wybierz ze ściany wariantów.",
		"Jak: cztery kamienie w kwadrat, albo przecinarka."
	]
	quest.4200000000230593.title: "Cięcie kamienia"
	quest.4200000000230594.quest_desc: [
		"Stół stolarza robi to samo dla drewna.",
		"Jak: jedna kłoda w siatce wytwarzania daje cztery."
	]
	quest.4200000000230594.title: "Cięcie desek"
	quest.4200000000230595.quest_desc: [
		"Każda szyba, jaką zna Dmuchacz szkła, zaczyna się tutaj.",
		"Jak: przetop piasek. Młotem z bruku w żwir, ze żwiru w piasek, potem do pieca."
	]
	quest.4200000000230595.title: "Cięcie szkła"
	quest.4200000000230596.quest_desc: [
		"Ulubiony kamień Śpiewaków żwiru, o który się kłócą.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000230596.title: "Odmiany głębokiego łupku"
	quest.4200000000230597.quest_desc: [
		"Wypalona glina, na sto sposobów.",
		"Jak: cztery przedmioty cegły. Kulki gliny przetapiają się w cegły."
	]
	quest.4200000000230597.title: "Odmiany cegieł"
	quest.4200000000230598.quest_desc: [
		"Żwir platformy, cięty drobno.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.4200000000230598.title: "Odmiany piaskowca"
	quest.4200000000240599.quest_desc: [
		"Pierwsza rzecz, która robi z platformy miejsce, gdzie ktoś mieszka.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: dębowe deski w JEI. Pierwszy mebel Handcrafted."
	]
	quest.4200000000240599.title: "Krzesło"
	quest.420000000024059A.quest_desc: [
		"Miejsce, by odłożyć Kodeks, kiedy myślisz.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.420000000024059A.title: "Stół"
	quest.420000000024059B.quest_desc: [
		"Miejsce, by Clowder usiadł, póki beczka pracuje.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.420000000024059B.title: "Ława"
	quest.420000000024059C.quest_desc: [
		"Na Strony kodeksu, które wciąż masz zamiar przeczytać jeszcze raz.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.420000000024059C.title: "Półka"
	quest.420000000024059D.quest_desc: [
		"Schowek Handcrafted, który wygląda, jakby tu pasował.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.420000000024059D.title: "Szafka"
	quest.420000000024059E.quest_desc: [
		"Strażnicy platformy spali dobrze. Śpij tak samo.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.420000000024059E.title: "Ozdobne łóżko"
	quest.420000000024059F.quest_desc: [
		"Latarnia, strona, miejsce dla obojga.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.420000000024059F.title: "Szafka nocna"
	quest.42000000002405A0.quest_desc: [
		"Wytnij ramę, potem ubierz ją w dowolny blok. Jeden kształt, każda skóra.",
		"Jak: sztabka żelaza nad trzema oprawionymi sześcianami. Tnie oprawione bloki."
	]
	quest.42000000002405A0.title: "Piła do ram"
	quest.42000000002405A1.quest_desc: [
		"Goły sześcian, który czeka na blok kamuflażu.",
		"Jak: piła ramowa, potem sześcian/płyta/schody w ramie. Kamuflaż to kliknięcie prawym z blokiem."
	]
	quest.42000000002405A1.title: "Sześcian w ramie"
	quest.42000000002405A2.quest_desc: [
		"Pół ramy; dwa razy więcej opcji.",
		"Jak: piła ramowa, potem sześcian/płyta/schody w ramie. Kamuflaż to kliknięcie prawym z blokiem."
	]
	quest.42000000002405A2.title: "Płyta w ramie"
	quest.42000000002405A3.quest_desc: [
		"Stopnie, które noszą ścianę, przy której stoją.",
		"Jak: piła ramowa, potem sześcian/płyta/schody w ramie. Kamuflaż to kliknięcie prawym z blokiem."
	]
	quest.42000000002405A3.title: "Schody w ramie"
	quest.42000000002405A4.quest_desc: [
		"Na dachy i linie dachów, których pustka nigdy ci nie dała.",
		"Jak: piła ramowa, potem sześcian/płyta/schody w ramie. Kamuflaż to kliknięcie prawym z blokiem."
	]
	quest.42000000002405A4.title: "Skos w ramie"
	quest.42000000002405A5.quest_desc: [
		"Chodzący po krawędzi spięli pustkę mniejszym. Dojdź do następnej platformy ze stylem.",
		"Jak: mosty Macaw z pasującego kamienia/drewna w JEI."
	]
	quest.42000000002405A5.title: "Most linowy"
	quest.42000000002405A6.quest_desc: [
		"Dach nad platformą. Deszcz tu, w górze, to zawsze tylko ambicja.",
		"Jak: dachy Macaw z pasującego drewna w JEI."
	]
	quest.42000000002405A6.title: "Dach strychu"
	quest.42000000002405A7.quest_desc: [
		"Wygoda to też infrastruktura.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.42000000002405A7.title: "Kanapa"
	quest.42000000002405A8.quest_desc: [
		"Kuchenna krawędź do serii Farmer's Delight.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.42000000002405A8.title: "Blat"
	quest.42000000002405A9.quest_desc: [
		"Gdzie Kodeks Wąsów dostaje swoje marginesy.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.42000000002405A9.title: "Biurko"
	quest.42000000002405AA.quest_desc: [
		"Mały schowek w komplecie ze stołem.",
		"Jak: meble Handcrafted z desek w JEI. Pierwsze krzesło jest dębowe."
	]
	quest.42000000002405AA.title: "Szuflada"
	quest.42000000002405AB.quest_desc: [
		"Próg, który chowa się w ścianie.",
		"Jak: piła ramowa, potem sześcian/płyta/schody w ramie. Kamuflaż to kliknięcie prawym z blokiem."
	]
	quest.42000000002405AB.title: "Drzwi w ramie"
	quest.42000000002405AC.quest_desc: [
		"Cienka osłona; pełne przebranie.",
		"Jak: piła ramowa, potem sześcian/płyta/schody w ramie. Kamuflaż to kliknięcie prawym z blokiem."
	]
	quest.42000000002405AC.title: "Panel w ramie"
	quest.42000000002405AD.quest_desc: [
		"Poręcz na krawędź, którą ubierzesz po swojemu.",
		"Jak: piła ramowa, potem sześcian/płyta/schody w ramie. Kamuflaż to kliknięcie prawym z blokiem."
	]
	quest.42000000002405AD.title: "Płot w ramie"
	quest.42000000002405AE.quest_desc: [
		"Szary i szczery, jak żwir, z którego powstał.",
		"Jak: mosty Macaw z pasującego kamienia/drewna w JEI."
	]
	quest.42000000002405AE.title: "Most z andezytu"
	quest.42000000002505AF.quest_desc: [
		"Światło na ścianę, nie pochodnia wetknięta ze wstydu. Zarządcy mieli wymagania.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: pochodnia + bryłki żelaza. Pierwsze wytwarzanie zarządów."
	]
	quest.42000000002505AF.title: "Kinkiet"
	quest.42000000002505B0.quest_desc: [
		"Piasek, który spada. Jedyny uczciwy zegar przed Nicią Zegara.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B0.title: "Klepsydra"
	quest.42000000002505B1.quest_desc: [
		"Kapnij płyn z bloku. Mały; dziwnie satysfakcjonujący.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B1.title: "Kran"
	quest.42000000002505B2.quest_desc: [
		"Kręć ją ręcznie. Bębnoserca też gdzieś zaczynały.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B2.title: "Korba"
	quest.42000000002505B3.quest_desc: [
		"Pochwal się czymś. Żeton, strona, trofeum.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B3.title: "Półka na przedmioty"
	quest.42000000002505B4.quest_desc: [
		"Worek, który trzyma worki. Bałagan Odzysku, ogarnięty.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B4.title: "Worek"
	quest.42000000002505B5.quest_desc: [
		"Zamknij Wystrzępioną nić z dala od własnych gorszych pomysłów.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B5.title: "Sejf"
	quest.42000000002505B6.quest_desc: [
		"Przypnij stronę tam, gdzie czyta ją cały Clowder.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B6.title: "Tablica ogłoszeń"
	quest.42000000002505B7.quest_desc: [
		"Doniczka z ambicjami. Upraw trochę tam, gdzie platforma jest cienka.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B7.title: "Donica"
	quest.42000000002505B8.quest_desc: [
		"Unieś Fragment krosna Wrzeciona tam, gdzie można go podziwiać.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B8.title: "Postument"
	quest.42000000002505B9.quest_desc: [
		"Schowaj ciasteczka, pszczoły albo małą godność porządku.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505B9.title: "Słój (37)"
	quest.42000000002505BA.quest_desc: [
		"Ustaw pojawienie, nie wlekąc całego łóżka po drabinie.",
		"Jak: wełna w JEI. Biały śpiwór; są barwione warianty. Ustawia pojawienie bez całego łóżka."
	]
	quest.42000000002505BA.title: "Śpiwór"
	quest.42000000002505BB.quest_desc: [
		"Prześpij dzień, żeby stworzenia spotkały wypoczętego Skybound.",
		"Jak: wełna + nić w JEI. Zawieś go na Linie i Gwoździu."
	]
	quest.42000000002505BB.title: "Hamak"
	quest.42000000002505BC.quest_desc: [
		"Zawieś hamak między dwoma słupkami, nad przepaścią, i zaryzykuj.",
		"Jak: sznurek i sztabka żelaza. Postaw dwa, potem zawieś hamak."
	]
	quest.42000000002505BC.title: "Lina i gwóźdź"
	quest.42000000002505BD.quest_desc: [
		"Równiejszy płomień na długie noce platformy.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505BD.title: "Świecznik"
	quest.42000000002505BE.quest_desc: [
		"Wspinaj się, zawieś się albo rzuć most. Chodzący po krawędzi przysięgali na nią.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505BE.title: "Lina (37)"
	quest.42000000002505BF.quest_desc: [
		"Podnoś i opuszczaj linę według kaprysu redstone.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505BF.title: "Blok krążka"
	quest.42000000002505C0.quest_desc: [
		"Spadnij na to, a pustka zapomni cię ukarać.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505C0.title: "Blok piór"
	quest.42000000002505C1.quest_desc: [
		"Naszkicuj kredą plan, o który może się spierać cały Clowder.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505C1.title: "Tablica"
	quest.42000000002505C2.quest_desc: [
		"Nieś coś małego, co wolałoby, żebyś tego nie robił.",
		"Jak: wytwarzanie Supplementaries w JEI (kinkiet, worek, sejf, lina…). Zarządy nazywają stanowisko."
	]
	quest.42000000002505C2.title: "Klatka"
	quest.42000000002605C3.quest_desc: [
		"Pierwszy drut. Puls, który trzymały Bębnoserca, ma już dokąd iść.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: walcuj blachy miedziane w walcarce. Bieżący rozdział zaczyna się tutaj."
	]
	quest.42000000002605C3.title: "Miedziany drut"
	quest.42000000002605C4.quest_desc: [
		"Obrót z jednej strony, energia Forge z drugiej. Dwie Nici ściskają sobie dłonie.",
		"Jak: Create Crafts & Additions — miedziany drut z walcarki, potem złącza i silnik."
	]
	quest.42000000002605C4.title: "Złącze"
	quest.42000000002605C5.quest_desc: [
		"Energia z powrotem w obrót. Nić Zegara działa teraz na Nici Iskry.",
		"Jak: Create Crafts & Additions — miedziany drut z walcarki, potem złącza i silnik."
	]
	quest.42000000002605C5.title: "Silnik elektryczny"
	quest.42000000002605C6.quest_desc: [
		"Trzymaj ładunek między drutem a robotą.",
		"Jak: Create Crafts & Additions — miedziany drut z walcarki, potem złącza i silnik."
	]
	quest.42000000002605C6.title: "Kondensator"
	quest.42000000002605C7.quest_desc: [
		"Ściana zgromadzonego prądu, tak duża, jak pozwala platforma.",
		"Jak: Create Crafts & Additions — miedziany drut z walcarki, potem złącza i silnik."
	]
	quest.42000000002605C7.title: "Akumulator modułowy"
	quest.42000000002605C8.quest_desc: [
		"Pręty i drut ze sztabek — odpowiedź Create na prasę.",
		"Jak: Create Crafts & Additions — miedziany drut z walcarki, potem złącza i silnik."
	]
	quest.42000000002605C8.title: "Walcarka"
	quest.42000000002605C9.quest_desc: [
		"Zaklinaj bez przesądu stołu. Nakarm go doświadczeniem, odbierz zamiar.",
		"Jak: Create Enchantment Industry po płomiennym palniku. JEI nazywa drukarkę i wiadro doświadczenia."
	]
	quest.42000000002605C9.title: "Płomienny zaklinacz"
	quest.42000000002605CA.quest_desc: [
		"Płynna praktyka, niesiona. Zarządcy uznaliby to za wulgarne i pożyteczne.",
		"Jak: Create Enchantment Industry po płomiennym palniku. JEI nazywa drukarkę i wiadro doświadczenia."
	]
	quest.42000000002605CA.title: "Wiadro doświadczenia"
	quest.42000000002605CB.quest_desc: [
		"Kopiuj książkę, plan, stronę. Kodeks Wąsów pochwala, cicho.",
		"Jak: Create Enchantment Industry po płomiennym palniku. JEI nazywa drukarkę i wiadro doświadczenia."
	]
	quest.42000000002605CB.title: "Drukarka"
	quest.42000000002605CC.quest_desc: [
		"Lawa i żar w energię. Most, a nie sam Pomruk.",
		"Jak: osm + piec + miedź. Pierwszy generator Mekanism."
	]
	quest.42000000002605CC.title: "Generator ciepła"
	quest.42000000002605CD.quest_desc: [
		"Na platformie, która jest samym niebem, słońce to jedyny zasób, którego nikt nie racjonuje.",
		"Jak: generatory Mekanism po linii Zakłady Mekanism. Generator ciepła to pierwsze wytworzenie."
	]
	quest.42000000002605CD.title: "Generator słoneczny"
	quest.42000000002605CE.quest_desc: [
		"Im wyżej platforma, tym mocniej się kręci. Buduj wysoko.",
		"Jak: generatory Mekanism po linii Zakłady Mekanism. Generator ciepła to pierwsze wytworzenie."
	]
	quest.42000000002605CE.title: "Generator wiatru"
	quest.42000000002605CF.quest_desc: [
		"Pal nadmiar Nici Kiełka. Na platformie nic nie jest odpadem.",
		"Jak: generatory Mekanism po linii Zakłady Mekanism. Generator ciepła to pierwsze wytworzenie."
	]
	quest.42000000002605CF.title: "Biogenerator"
	quest.42000000002605D0.quest_desc: [
		"Późna moc dla Clowder, które zeszło głęboko w Mekanism.",
		"Jak: generatory Mekanism po linii Zakłady Mekanism. Generator ciepła to pierwsze wytworzenie."
	]
	quest.42000000002605D0.title: "Generator gazowy"
	quest.42000000002605D1.quest_desc: [
		"Cyfrowe krosno, w kieszeni. Przetkaj z dowolnego miejsca na platformie.",
		"Jak: Terminal bezprzewodowy po sieci AE2 i naładowanym zestawie bezprzewodowym. JEI nazywa wytworzenie."
	]
	quest.42000000002605D1.title: "Terminal bezprzewodowy (38)"
	quest.42000000002605D2.quest_desc: [
		"Chemikalia Mekanism, trzymane w sieci AE2. Dwa późne filary, splecione.",
		"Jak: komórki chemiczne Applied Mekanistics po obudowie AE2 + chemikaliach Mekanism."
	]
	quest.42000000002605D2.title: "Komórka chemiczna"
	quest.42000000002605D3.quest_desc: [
		"Na wtedy, gdy miedziany drut nie uniesie całego pulsu.",
		"Jak: Create Crafts & Additions — miedziany drut z walcarki, potem złącza i silnik."
	]
	quest.42000000002605D3.title: "Duże złącze"
	quest.42000000002605D4.quest_desc: [
		"Ciasto, które podnosi ci poziom. Nie mów o tym linii kuchennej.",
		"Jak: Create Enchantment Industry po płomiennym palniku. JEI nazywa drukarkę i wiadro doświadczenia."
	]
	quest.42000000002605D4.title: "Ciasto doświadczenia"
	quest.42000000002605D5.quest_desc: [
		"Większy kęs tego samego darmowego nieba.",
		"Jak: generatory Mekanism po linii Zakłady Mekanism. Generator ciepła to pierwsze wytworzenie."
	]
	quest.42000000002605D5.title: "Zaawansowany solar"
	quest.42000000002605D6.quest_desc: [
		"Skorupa, której potrzebuje każda komórka chemiczna.",
		"Jak: komórki chemiczne Applied Mekanistics po obudowie AE2 + chemikaliach Mekanism."
	]
	quest.42000000002605D6.title: "Obudowa chemiczna"
	quest.42000000002605D7.quest_desc: [
		"Zabierz miarę gazu poza sieć.",
		"Jak: komórki chemiczne Applied Mekanistics po obudowie AE2 + chemikaliach Mekanism."
	]
	quest.42000000002605D7.title: "Przenośna komórka chemiczna"
	quest.42000000002705D8.quest_desc: [
		"Każda Nić ma strażnika, którego zerwało Cięcie: twór Krosna, który zdziczał. Nie mordujesz potwora; przywracasz napięcie Nici, pokonując go. Wytwórz jego Wystrzępiony totem, gdy Nić jest osadzona, użyj go gdziekolwiek poza areną, a ciebie i każdego towarzysza Clowder w promieniu 32 bloków wciąga na jego scenę. Wygraj, a każdy z was zaniesie do domu Tkaną relikwię tego strażnika. Przegraj, a zostajecie wypluci z powrotem, totem zużyty.",
		"Relikwie działają z miejsca relikwii Curios, drugiej ręki albo paska szybkiego wyboru: bierne, gdy noszone, i moc na prawy przycisk z czasem odnowienia. `/guardians leave` porzuca walkę; `/guardians status` pokazuje zapis Clowder.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: odhacz. Wytwórz każdy Wystrzępiony totem, gdy ta Nić jest osadzona; użyj go poza areną."
	]
	quest.42000000002705D8.title: "Odpowiedź za Cięcie"
	quest.42000000002705D9.quest_desc: [
		"Misa nory: zapadła misa z czterech stopni ziemi schodzących do jamy błota pod sześcioma łukami korzeni ciemnego dębu, siedem turkusowych szwów korzeni świeci na dnie jamy.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705D9.title: "Totem: Legowisko"
	quest.42000000002705DA.quest_desc: [
		"Co ćwierć jego zdrowia Legowisko uderza i zalewa dół warstwą ziemi, odporne w jej środku. Zapala się jeden z siedmiu szwów: wykop do niego kanał, odsłoń rdzeń i uderz go, by przerwać pogrzebanie. Pierwsza brama, i wyrozumiała.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705DA.title: "Przywróć napięcie: Legowisko"
	quest.42000000002705DB.quest_desc: [
		"Korzenioserce: otrzymywany odrzut spada o sześćdziesiąt procent i nic nie może cię przyciągnąć. W korzeń sadzi cię na pięć sekund za ośmioma sercami Absorpcji.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705DB.title: "Relikwia: Korzenioserce"
	quest.42000000002705DC.quest_desc: [
		"Dół żaren: kamieniołom z głębokiego łupku, z obracającym się pierścieniem osełek w podłodze i czterema zsypami kamiennych sit, które sypią żwir do środkowego dołu żwiru.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705DC.title: "Totem: Żarna"
	quest.42000000002705DD.quest_desc: [
		"Żarna są odporne, póki paszcza jest zamknięta. Każdy zsyp zrzuca blok żwiru co piętnaście sekund; zanieś jeden na pierścień i pozwól mu wjechać w otwór dołu, by zaciąć paszczę otwartą na dwanaście sekund. Pierścień odwraca się w każdej fazie i wpycha nieuważnego do dołu.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705DD.title: "Przywróć napięcie: Żarna"
	quest.42000000002705DE.quest_desc: [
		"Rdzeń żaren: odporność na Zmęczenie, a twoje sita w ręku dostają jeden dodatkowy rzut Szczęścia. Szarp zdejmuje dwa pancerza z następnej rzeczy, którą uderzysz.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705DE.title: "Relikwia: Rdzeń żaren"
	quest.42000000002705DF.quest_desc: [
		"Taras zarastania: cztery tarasy ogrodu pod baldachimem liści, osiem słupków kraty i cztery stanowiska przycinania na drugim poziomie.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705DF.title: "Totem: Cierniowa matka"
	quest.42000000002705E0.quest_desc: [
		"Cierniowa matka nigdy nie uderza; sieje cierniowy żywopłot, który się rozrasta i pali w dotyku, i leczy się, ilekroć stanowisko przycinania zarasta. Nożyce i siekiery to czyszczą. Skompostuj osiem żywopłotu na stanowisku, by puścić falę przycinania, która czyści ziemię i ją ogłusza — jedyne czyste okno obrażeń.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705E0.title: "Przywróć napięcie: Cierniowa matka"
	quest.42000000002705E1.quest_desc: [
		"Cierniowe nasiono: Ciernie i brak obrażeń od jagód albo kaktusa. Rozkwit wznosi pierścień żywopłotu i daje Regenerację II tobie i twojemu Clowder w środku.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705E1.title: "Relikwia: Cierniowe nasiono"
	quest.42000000002705E2.quest_desc: [
		"Odłamki nieba: dziesięć odłamków łupku unoszących się nad pustką, kruszące się mosty między nimi, złote ślady pazura na głównym odłamku, gdzie ląduje boss.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705E2.title: "Totem: Krawędziarz"
	quest.42000000002705E3.quest_desc: [
		"Czysty pojedynek. Krawędziarz skacze z odłamka na odłamek i rzuca się na tego, kto stoi najdalej od ściany; złoty ślad pazura pokazuje gdzie, oddech przed lądowaniem — zejdź stamtąd. Mosty kruszą się za tobą i wracają później. Upadek kosztuje sześć serc i powrót na twoją platformę.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705E3.title: "Przywróć napięcie: Krawędziarz"
	quest.42000000002705E4.quest_desc: [
		"Krok krawędzi: brak obrażeń od upadku z mniej niż dwunastu bloków i brak ześlizgu z krawędzi. Krok krawędzi robi zryw na sześć bloków, dwa razy, z mocniejszym ciosem na końcu.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705E4.title: "Relikwia: Krok krawędzi"
	quest.42000000002705E5.quest_desc: [
		"Bęben kuźni: mosiężny podest-bęben nad kraterem lawy, osiem młotów z miedzianych tłoków z podkładkami rytmu przed nimi, cztery kanały lawy przez podłogę.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705E5.title: "Totem: Bębnoserce"
	quest.42000000002705E6.quest_desc: [
		"Bębnoserce można zranić tylko przez chwilę po każdym czwartym uderzeniu. Stań na płycie taktu przy mocnej części, by naładować iskrę, która liczy się potrójnie; przy czwartym uderzeniu kanały lawy się podnoszą, więc stań na płytach, nie w kanałach. Tempo rośnie z każdą fazą.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705E6.title: "Przywróć napięcie: Bębnoserce"
	quest.42000000002705E7.quest_desc: [
		"Puls bębna: co czwarty cios zadaje dwa serca więcej. Mocna część taktu ogłusza i odrzuca wszystko w promieniu siedmiu bloków.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705E7.title: "Relikwia: Puls bębna"
	quest.42000000002705E8.quest_desc: [
		"Wychwyt: cztery obracające się miedziane pierścienie z płytkami sekwencji z ciemnego dębu wokół żelaznej piasty, sześć wież zębatek i wahadło na szesnaście bloków odmierzające czas.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705E8.title: "Totem: Zębatnik"
	quest.42000000002705E9.quest_desc: [
		"W każdej fazie Zębatnik nakręca: płytki zapalają się po kolei na obracających się pierścieniach, a ty masz dwanaście sekund, by stanąć na nich w kolejności. Sukces otwiera kadłub na osiem sekund; porażka każe strzelać każdej wieży zębatek. Wahadło jest metronomem; pierścienie odwracają się, gdy wychyla się daleko.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705E9.title: "Przywróć napięcie: Zębatnik"
	quest.42000000002705EA.quest_desc: [
		"Pętla zębatki: Pośpiech I, a narzędzia zużywają się o jedną piątą wolniej. Przewiń zeruje każdą inną relikwię, którą nosisz, i cofa cię tam, gdzie stałeś trzy sekundy temu.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705EA.title: "Relikwia: Pętla zębatki"
	quest.42000000002705EB.quest_desc: [
		"Plaster: sześciokątna woskowa arena z wznoszącymi się i opadającymi komórkami plastra, kałużami miodu i sześcioma komórkami trutni w ścianie.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705EB.title: "Totem: Umysł roju"
	quest.42000000002705EC.quest_desc: [
		"Umysł roju jest kruchy, lecz w każdej fali sześć jego komórek sypie trutnie. Ognisko ustawione na komórce trutnia pieczętuje ją na trzydzieści sekund; zapieczętuj wszystkie sześć, a komnata królewska otworzy się na dziesięć sekund. Twoje własne Productive Bees atakują trutnie od pierwszego wejrzenia.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705EC.title: "Napiąć na nowo: Umysł roju"
	quest.42000000002705ED.quest_desc: [
		"Zew ula: pszczoły nigdy nie zwracają się przeciw tobie, a ule w promieniu szesnastu bloków pracują o jedną dziesiątą szybciej. Wezwij Rój: wysyła cztery pszczoły-relikwie za tym, co uderzysz.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705ED.title: "Relikwia: Zew ula"
	quest.42000000002705EE.quest_desc: [
		"Krąg osłony: kamienne sanktuarium ze złotych kręgów i dziewięciu filarów glifów z ametystowymi iglicami, pośrodku dziewięcioboczny podest ze złotych kołków.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705EE.title: "Totem: Łamacz pieczęci"
	quest.42000000002705EF.quest_desc: [
		"Łamacz pieczęci kryje się za trzema czynnymi osłonami. Kołki podestu zapalają kolejność raz na fazę — najpierw patrz. Rozprosz filary w tej kolejności rozproszeniem Ars albo dowolnym przedmiotem Nici Pieczęci; zły zbroi znów wszystkie trzy, a szkło osłony kąsa. Trzy trafione, i jest otwarty przez dwanaście sekund. Późniejsze fazy tasują runy i dokładają wabik.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705EF.title: "Napiąć na nowo: Łamacz pieczęci"
	quest.42000000002705F0.quest_desc: [
		"Znak pieczęci: otrzymywane obrażenia magiczne maleją o jedną piątą. Znak pieczęci osłania ciebie albo towarzysza Clowder, na którego patrzysz, przed jednym ciężkim ciosem.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705F0.title: "Relikwia: Znak pieczęci"
	quest.42000000002705F1.quest_desc: [
		"Zapadające się krosno: krosno szerokie na sześćdziesiąt sześć bloków, którego podłoga jest osnową — pasy desek, które prują się w mosty z nici, gdy opadają listwy nicielnic.",
		"Cztery sztuki Wystrzępionej nici i cztery bloki Nici wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705F1.title: "Totem: Nietkany"
	quest.42000000002705F2.quest_desc: [
		"Pięć faz. Każda przez trzydzieści sekund cytuje dwie z pozostałych ośmiu mechanik, potem spada listwa nicielnic i prują się trzy kolejne pasy. W prawdziwej postaci zostają ostatnie cztery pasy, a nici osnowy są jedyną drogą w górę, na belkę, gdzie stoi. Zabij go tam: Przetkanie.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705F2.title: "Napiąć na nowo: Nietkany"
	quest.42000000002705F3.quest_desc: [
		"Nić krosna: dwa napięcia Krosna więcej dla twojego Clowder i wolniejszy rozpad. Nić krosna wiąże twój Clowder u twojego boku. To zwornik prawdziwego Przetkania i klucz do dwóch zapieczętowanych aren.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705F3.title: "Relikwia: Nić krosna"
	quest.42000000002705F4.quest_desc: [
		"Śmietnik Doku: kąt samego Doku — dziedziniec z desek, sznur z płóciennymi prześcieradłami, kosze wełny, czerwony dywan.",
		"Cztery Wystrzępione nici i cztery wełny wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705F4.title: "Totem: Golem z meszku"
	quest.42000000002705F5.quest_desc: [
		"Jedyna walka bez ryzyka. Golem rzuca kulami meszku, które oślepiają tylko na chwilę, i chowa się za praniem; wyklep dywan, a on kichnie i się zatoczy. Uczy totemu, areny i bramy.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705F5.title: "Napiąć na nowo: Golem z meszku"
	quest.42000000002705F6.quest_desc: [
		"Kosmyk meszku: odporność na obrażenia od kaktusa, jagód i żywopłotu oraz na popychanie. Obłok oślepia pobliskie stwory, żebyś mógł uciec.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705F6.title: "Relikwia: Kosmyk meszku"
	quest.42000000002705F7.quest_desc: [
		"Ogród węzłów: trawiasta wyspa pod czterema pierścieniami labiryntu z żywopłotu, z lukami i ostrogami, ścieżkami z bruku i pierścieniami węzłów z liny zawieszonymi nad nimi.",
		"Cztery Wystrzępione nici i cztery liście wokół Przędzy Pustki.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705F7.title: "Totem: Splątanie"
	quest.42000000002705F8.quest_desc: [
		"Pająk zamyka ścieżki za tobą węzłami z liny, które trzeba ciąć trzema uderzeniami, i gryzie tego, kto jest sam w ślepym zaułku. Trzymaj się razem w labiryncie. Opcjonalne, w połowie gry, kosmetyczna nagroda.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705F8.title: "Napiąć na nowo: Splątanie"
	quest.42000000002705F9.quest_desc: [
		"Amulet węzła: brak spowolnienia na pajęczynie, piasku dusz, miodzie lub sypkim śniegu i o połowę mniej ślizgu na lodzie. Splątanie zakorzenia pierwszego moba, którego trafi.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705F9.title: "Relikwia: Amulet węzła"
	quest.42000000002705FA.quest_desc: [
		"Dwie szalone areny czekają za drzwiami, które otwiera tylko Przetkanie. Ich totemy potrzebują relikwii Nić krosna na siatce wytwarzania i odpowiadają tylko Clowderowi, który zamknął swoje niebo. Bossowie są od dziesięciu do dwudziestu razy więksi od ciebie. Zabierz wszystkich.",
		"Jak: osadź wszystkie dziewięć Nici, potem przetkaj. Osiągnięcie wyzwala się, gdy niebo się zamyka."
	]
	quest.42000000002705FA.title: "Zapieczętowane drzwi"
	quest.42000000002705FB.quest_desc: [
		"Odcięcie: wielki odłamek obsydianu przecięty świecącym Cięciem, dwadzieścia odłamków świata dryfujących wokół, turkusowe łzy pustki w powietrzu.",
		"Wystrzępiona nić i obsydian wokół relikwii Nić krosna; relikwia jest zwracana.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705FB.title: "Totem: Pierwsze cięcie"
	quest.42000000002705FC.quest_desc: [
		"Kształt, który Cięcie zostawiło na odłamku, nie wyznanie, kto się zamachnął. Co dwadzieścia sekund tnie linię w poprzek odłamka, a bloki odpadają na piętnaście sekund; szew daje Szybkość, ale jego promień idzie za szwem. Dryfujące odłamki miażdżą, łzy pustki ciągną, a przy jednej piątej zdrowia odłamek pęka na dwoje wzdłuż Cięcia. Dopiero po Przetkaniu.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705FC.title: "Przywrócić napięcie: Pierwsze cięcie"
	quest.42000000002705FD.quest_desc: [
		"Odłamek Pierwszego cięcia: przecina fazy osłony. Najlepsze w paczce, dla tych, którzy przeszli.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705FD.title: "Relikwia: Odłamek Pierwszego cięcia"
	quest.42000000002705FE.quest_desc: [
		"Krosno u góry: splot z purpuru, dziewięć mostów Nici ku dziewięciu platformom na filarach, dwadzieścia siedem nici katedry do zwornika sześćdziesiąt cztery bloki w górę.",
		"Wystrzępiona nić i purpur wokół relikwii Nić krosna; relikwia wraca do ciebie.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.42000000002705FE.title: "Totem: Nadtkacz"
	quest.42000000002705FF.quest_desc: [
		"Twoje własne odnowione Krosno zwróciło się przeciw tobie. Nadtkacz rzuca cienie dziewięciu strażników na ich Nici; zabij cień, a jego nić napię się na dwadzieścia pięć sekund i dopiero wtedy samo krosno da się zranić. Później rzuca trzy, potem wszystkie dziewięć.",
		"Jak: użyj pasującego Wystrzępionego totemu, potem wygraj arenę. Osiągnięcie kończy to."
	]
	quest.42000000002705FF.title: "Przywrócić napięcie: Nadtkacz"
	quest.4200000000270600.quest_desc: [
		"Czółenko Nadtkacza: echo każdej relikwii Nici w jednym, i przetka poległego towarzysza Clowder.",
		"Po jednym na członka Clowder obecnego przy wygranej, prosto do ekwipunku.",
		"Jak: Kodeks Wąsów, Zerwani strażnicy — totem, arena, relikwia. Totem odpowiada na platformie."
	]
	quest.4200000000270600.title: "Relikwia: Czółenko Nadtkacza"
	quest.42000000002805E3.quest_desc: [
		"Dzikie biegacze platformy nie pojawiają się na platformie pustki. Zagraj Rytuał bramy na Bębnie bramy (użyj go z pustymi rękami, trafiaj uderzenia na A, S, D, F) i przejdź Marchię. Żółte pasą się na Stepie i na Trzcinowym bagnie. Wyżyny skłaniają się ku stopniowi Świetny. Śnieżne pola kryją stopnie Cudowne. Żarowe pustkowia trzymają ptaki Płomienia.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: użyj Bębna bramy z pustymi rękami i zagraj Rytuał bramy: trafiaj spadające uderzenia na A, S, D, F. Osiągnij 60%, a się otworzy; Puls niepotrzebny. Najpierw zwiąż kompas powrotu."
	]
	quest.42000000002805E3.title: "Brama do Marchii"
	quest.42000000002805E4.quest_desc: [
		"Dziki Gysahl rośnie na Trzcinowym bagnie, na Stepie i na Wyżynach, najgęściej na bagnie. Zbiór daje też nasiona, a Liść Marchii albo trawa rozbite motyką sypią więcej. Posadź nasiona w domu na polu uprawnym.",
		"Jak: zbieraj dziki Gysahl w Marchii (Trzcinowe bagno jest najgęstsze). Zbiór daje też nasiona; posadź je w domu na polu uprawnym."
	]
	quest.42000000002805E4.title: "Zieleń Gysahl"
	quest.42000000002805E5.quest_desc: [
		"Książka i liść Gysahl. Użyj go gdziekolwiek: strony wymieniają kolor, stopień, klasę, wygrane w wyścigach i ostatni orzech każdego z twoich ptaków.",
		"Jak: książka i Gysahl. Użyj go gdziekolwiek; strony wymieniają twoje ptaki."
	]
	quest.42000000002805E5.title: "Almanach Chocobo"
	quest.42000000002805E6.quest_desc: [
		"Nakarm Gysahl, by oswoić dzikiego żółtego. Zrób siodło ze skóry, nici i żelaza, potem dosiądź. Sprint daje szarżę; puść, by odzyskać wytrzymałość.",
		"Jak: skóra, nić i żelazo. Oswój dzikiego żółtego za pomocą Gysahl, potem go osiodłaj."
	]
	quest.42000000002805E6.title: "Siodło Chocobo"
	quest.42000000002805E7.quest_desc: [
		"Złote samorodki wokół zegara, z Gysahl. Nakręcony niesie cię do Wiatru Wąsów i z powrotem. Po przejściu Marchii Esther stoi też w Sali Clowder: dojedź do niej na osiodłanym ptaku albo spytaj przewodnika Wiatru Wąsów.",
		"Jak: złote samorodki wokół zegara, z Gysahl. Użyj go, by nakręcić się do Wiatru Wąsów i z powrotem; osiodłany ptak jedzie z tobą."
	]
	quest.42000000002805E7.title: "Zegarek kieszonkowy Chocobo"
	quest.42000000002805E8.quest_desc: [
		"Przynęta w ręku wabi dzikie ptaki i rysuje ich obrys na całym polu.",
		"Jak: zrób przynętę. Trzymaj ją, by znaleźć żółte z Marchii."
	]
	quest.42000000002805E8.title: "Przynęta Chocobo"
	quest.42000000002805E9.quest_desc: [
		"Posadź nasiona Gysahl na polu uprawnym. Grządka w domu to początek linii farmy.",
		"Jak: zbiór dzikiego Gysahl daje nasiona, a trawa i Liść Marchii rozbite motyką też. Sadź na polu uprawnym."
	]
	quest.42000000002805E9.title: "Nasiona Gysahl"
	quest.42000000002805EA.quest_desc: [
		"Nakarm orzechem Carob dwoje dorosłych przeciwnej płci. Dwa Żółte stopnia Dobry albo lepszego plus Carob mogą się wykluć jako Zielony albo Niebieski. Każdy rodzic potrzebuje 5 pierwszych miejsc wygranych w klasie C; 16 łącznie czyni kolor pewnym. Zielony stopnia Świetny i Niebieski stopnia Świetny, każdy z 8 pierwszymi miejscami klasy B, wykluwają się jako Czarny (pudło to Biały; 24 łącznie na pewny rzut).",
		"Jak: Bilo, strażnik orzechów, na Wietrze Wąsów sprzedaje Carob. Wyścigi klasy A też go wypłacają."
	]
	quest.42000000002805EA.title: "Orzech Carob"
	quest.42000000002805EB.quest_desc: [
		"Zielenina w połowie drabiny. Trenuj szybkość, wytrzymałość, inteligencję albo współpracę; ptak nasyca się każdym rodzajem.",
		"Jak: mędrzec Wynn na Wietrze Wąsów."
	]
	quest.42000000002805EB.title: "Zielenina Curiel"
	quest.42000000002805EC.quest_desc: [
		"Najwyższa zielenina treningowa. Wspinaj się po drabinie, gdy ptak nasyci się tańszymi liśćmi.",
		"Jak: mędrzec Wynn na Wietrze Wąsów albo nagroda wyścigu klasy S."
	]
	quest.42000000002805EC.title: "Zielenina Sylkis"
	quest.42000000002805ED.quest_desc: [
		"Złoty nigdy nie wykluwa się bez Zeio. Czarny stopnia Cudowny plus Żółty stopnia Cudowny, każdy z 10 pierwszymi miejscami wygranymi w klasie A (32 łącznie na pewny rzut).",
		"Jak: Bilo, strażnik orzechów, na Wietrze Wąsów sprzedaje Zeio. Wyścigi klasy S rzadko go wypłacają."
	]
	quest.42000000002805ED.title: "Orzech Zeio"
	quest.42000000002805EE.quest_desc: [
		"GP wygrane na torze. Stragany na Placu wyceniają wszystko w GP.",
		"Jak: wejdź do pierwszej trójki biegu na Wietrze Wąsów. Dojedź do Esther na osiodłanym ptaku, żeby się zapisać."
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"Pierwszy orzech do rozmnażania. Talent idzie z orzecha; kolor idzie od rodziców, chyba że wchodzą Carob albo Zeio.",
		"Jak: Bilo, strażnik orzechów, na Wietrze Wąsów sprzedaje Pepio. Wygrana w klasie C też może go wypłacić."
	]
	quest.42000000002805EF.title: "Orzech Pepio"
	quest.42000000002805F0.quest_desc: [
		"Dwa Gysahl i mączka kostna. Pierwszy stopień ponad zwykłą zieleniną.",
		"Jak: bez kształtu — dwa Gysahl i mączka kostna."
	]
	quest.42000000002805F0.title: "Zielenina Krakka"
	quest.42000000002805F1.quest_desc: [
		"Następna zielenina treningowa. Opcjonalna, gdy farma już działa.",
		"Jak: mędrzec Wynn albo receptura z listy w JEI."
	]
	quest.42000000002805F1.title: "Zielenina Tantal"
	quest.42000000002805F2.quest_desc: [
		"Kolejna zielenina treningowa. Opcjonalna.",
		"Jak: mędrzec Wynn na Placu."
	]
	quest.42000000002805F2.title: "Zielenina Pahsana"
	quest.42000000002805F3.quest_desc: [
		"Kolejna zielenina treningowa. Opcjonalna.",
		"Jak: mędrzec Wynn na Placu."
	]
	quest.42000000002805F3.title: "Zielenina Mimett"
	quest.42000000002805F4.quest_desc: [
		"Kolejna zielenina treningowa. Opcjonalna.",
		"Jak: mędrzec Wynn na Placu."
	]
	quest.42000000002805F4.title: "Zielenina Reagan"
	quest.42000000002805F5.quest_desc: [
		"Średni orzech. Opcjonalny.",
		"Jak: Bilo, strażnik orzechów, na Wietrze Wąsów sprzedaje Luchile."
	]
	quest.42000000002805F5.title: "Orzech Luchile"
	quest.42000000002805F6.quest_desc: [
		"Średni orzech. Opcjonalny.",
		"Jak: Bilo, strażnik orzechów, na Wietrze Wąsów sprzedaje Saraha."
	]
	quest.42000000002805F6.title: "Orzech Saraha"
	quest.42000000002805F7.quest_desc: [
		"Średni orzech. Opcjonalny.",
		"Jak: Bilo, strażnik orzechów, na Wietrze Wąsów sprzedaje Lasan."
	]
	quest.42000000002805F7.title: "Orzech Lasan"
	quest.42000000002805F8.quest_desc: [
		"Orzech do rozmnażania ze środka ku końcowi. Opcjonalny. Sprzedaje go Bilo, strażnik orzechów.",
		"Jak: Bilo, strażnik orzechów, na Wietrze Wąsów sprzedaje Pram."
	]
	quest.42000000002805F8.title: "Orzech Pram"
	quest.42000000002805F9.quest_desc: [
		"Stoisko Jarmarku na Wietrze Wąsów sprzedaje fajerwerki, smycze, zegarki kieszonkowe i Almanach Chocobo za GP.",
		"Jak: papier plus proch. Opcjonalny wybuch."
	]
	quest.42000000002805F9.title: "Fajerwerki Jarmarku"
	quest.42000000002805FA.quest_desc: [
		"Późny orzech do rozmnażania. Opcjonalny.",
		"Jak: Bilo, strażnik orzechów, na Wietrze Wąsów sprzedaje Porov."
	]
	quest.42000000002805FA.title: "Orzech Porov"
	quest.42000000002905FB.quest_desc: [
		"Pustka nigdy nie wyhodowała krzewów Pam's. Przesiej ziemię siatką ze sznurka. Rozbij ogród po suche nasiona — chili, kukurydza, owoc kaktusa.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: przesiej ziemię siatką ze sznurka albo lepszą (Ex Deorum albo Krosno Pustki)."
	]
	quest.42000000002905FB.title: "Suchy ogród"
	quest.42000000002905FC.quest_desc: [
		"Zimne uprawy z tej samej ziemi. Rozbij krzew; posadź, czego potrzebujesz.",
		"Jak: przesiej ziemię siatką ze sznurka albo lepszą."
	]
	quest.42000000002905FC.title: "Mroźny ogród"
	quest.42000000002905FD.quest_desc: [
		"Uprawy spod liści. To samo sito, inny krzew.",
		"Jak: przesiej ziemię siatką ze sznurka albo lepszą."
	]
	quest.42000000002905FD.title: "Zacieniony ogród"
	quest.42000000002905FE.quest_desc: [
		"Mokre uprawy. Ryż i reszta nasion o bagnistym usposobieniu mieszkają tutaj.",
		"Jak: przesiej ziemię siatką ze sznurka albo lepszą."
	]
	quest.42000000002905FE.title: "Grząski ogród"
	quest.42000000002905FF.quest_desc: [
		"Ciepłe uprawy. Trzymaj krzew w skrzyni; i tak się rozrosną, jeśli je posadzisz.",
		"Jak: przesiej ziemię siatką ze sznurka albo lepszą."
	]
	quest.42000000002905FF.title: "Tropikalny ogród"
	quest.4200000000290600.quest_desc: [
		"Ostatni z sześciu. Każde nasiono HarvestCraft na platformie zaczyna jako jeden z tych krzewów.",
		"Jak: przesiej ziemię siatką ze sznurka albo lepszą."
	]
	quest.4200000000290600.title: "Wietrzny ogród"
	quest.4200000000290601.quest_desc: [
		"To nie deska do krojenia z Farmer's Delight. Miedź, patyk i deska. Przygotuj owoce i warzywa, zanim trafią do garnka.",
		"Jak: miedź, patyk i deska. To nie deska do krojenia z Farmer's Delight."
	]
	quest.4200000000290601.title: "Tablica zbiorów"
	quest.4200000000290602.quest_desc: [
		"Zupy, gulasze i bulion. Miedź i patyk. Garnek wraca po każdym wytworzeniu.",
		"Jak: miedź i patyk. Garnek wraca po każdym gotowaniu bez kształtu."
	]
	quest.4200000000290602.title: "Garnek zbiorów"
	quest.4200000000290603.quest_desc: [
		"Dania z patelni. Miedź i patyki. Inny wyrób niż patelnia Delight; JEI je rozróżnia.",
		"Jak: miedź i patyki. Inna niż patelnia Delight."
	]
	quest.4200000000290603.title: "Patelnia zbiorów"
	quest.4200000000290604.quest_desc: [
		"Sosy i redukcje. Miedź i patyk. Trzymaj go obok garnka.",
		"Jak: miedź i patyk."
	]
	quest.4200000000290604.title: "Rondelek"
	quest.4200000000290605.quest_desc: [
		"Pierścień z terakoty. Ciasta, chleby i wszystko, co chce formy do pieca.",
		"Jak: osiem terakoty wokół pustego środka."
	]
	quest.4200000000290605.title: "Forma"
	quest.4200000000290606.quest_desc: [
		"Deski i patyk. Ciasta lejne, ciasta i sałatki. Cicha stacja.",
		"Jak: deski i patyk."
	]
	quest.4200000000290606.title: "Miska"
	quest.4200000000290607.quest_desc: [
		"Terakota. Owoc do środka, sok na zewnątrz. Postaw przy drzewie, nie przy grządce.",
		"Jak: terakota. Cztery w T."
	]
	quest.4200000000290607.title: "Wyciskarka"
	quest.4200000000290608.quest_desc: [
		"Patyki i kłoda. Rozpłaszcz ciasto. Forma czeka.",
		"Jak: patyki po obu stronach kłody."
	]
	quest.4200000000290608.title: "Wałek"
	quest.4200000000290609.quest_desc: [
		"Kamyki andezytu z krzemiennego sita, potem patyk. Mąka, przyprawy, pasty.",
		"Jak: andezyt (kamyki z ziemi lub żwiru z krzemiennego sita) i patyk."
	]
	quest.4200000000290609.title: "Młynek"
	quest.420000000029060A.quest_desc: [
		"Wiadro wody podzielone na osiem. Większość przepisów chce tego, nie waniliowego wiadra.",
		"Jak: jedno wiadro wody → osiem słodkiej wody."
	]
	quest.420000000029060A.title: "Słodka woda"
	quest.420000000029060B.quest_desc: [
		"Na platformie nie ma krów. Kokos (ziemia na żelaznej siatce) plus słodka woda, albo później podziel wiadro mleka.",
		"Jak: kokos (ziemia na żelaznej siatce) plus słodka woda, albo podziel wiadro mleka."
	]
	quest.420000000029060B.title: "Świeże mleko"
	quest.420000000029060C.quest_desc: [
		"Woda w garnku albo mielenie. Prawie każdy wytrawny przepis o to prosi.",
		"Jak: garnek plus woda albo słodka woda. Garnek wraca."
	]
	quest.420000000029060C.title: "Sól"
	quest.420000000029060D.quest_desc: [
		"Pszenica przez młynek. Ciasto zaczyna się tutaj.",
		"Jak: młynek plus pszenica (albo inna roślina na mąkę). Młynek wraca."
	]
	quest.420000000029060D.title: "Mąka"
	quest.420000000029060E.quest_desc: [
		"Mąka, sól i słodka woda. Ciasta i chleby dzielą tę bryłkę.",
		"Jak: miska, mąka, woda, sól."
	]
	quest.420000000029060E.title: "Ciasto"
	quest.420000000029060F.quest_desc: [
		"Kości albo warzywa w garnku. Zupy chcą butelki tego, nie mglistego wywaru.",
		"Jak: garnek plus kość (Strażnicy platformy sprzedają kości) albo resztki warzyw."
	]
	quest.420000000029060F.title: "Bulion"
	quest.4200000000290610.quest_desc: [
		"Ziemia na żelaznej siatce. Uprawiaj na platformie; waniliowy dąb nie da jabłek Pam's.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.4200000000290610.title: "Jabłoń"
	quest.4200000000290611.quest_desc: [
		"Kwas do sosów i ryby. To samo żelazne sito.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.4200000000290611.title: "Drzewo cytrynowe"
	quest.4200000000290612.quest_desc: [
		"Przyprawa z kory. Wypieki i herbaty.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.4200000000290612.title: "Drzewo cynamonowe"
	quest.4200000000290613.quest_desc: [
		"Mleko, olej i kuchnia tropikalna.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.4200000000290613.title: "Palma kokosowa"
	quest.4200000000290614.quest_desc: [
		"Strąki do słodyczy. Posadź jak pozostałe.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.4200000000290614.title: "Pnącze wanilii"
	quest.4200000000290615.quest_desc: [
		"Jabłoń Pam's rodzi zwykłe jabłka, dużo więcej, niż sypią liście dębu. Wyciskarka i forma chcą właśnie ich.",
		"Jak: liście dębu dają kilka; jabłoń Pam's (sadzonka z ziemi z żelazną siatką) rodzi wiele."
	]
	quest.4200000000290615.title: "Jabłko Pam's"
	quest.4200000000290616.quest_desc: [
		"Forma, ciasto, cukier, jabłka. Pierwszy gotowy wypiek HarvestCraft.",
		"Jak: forma, ciasto, cukier, jabłka Pam's z jabłoni."
	]
	quest.4200000000290616.title: "Szarlotka (Zbiory)"
	quest.4200000000290617.quest_desc: [
		"Wyciskarka plus mieszane owoce. Napój z platformy, a nie sok z arbuza.",
		"Jak: sokowirówka i mieszane owoce."
	]
	quest.4200000000290617.title: "Poncz owocowy"
	quest.4200000000290618.quest_desc: [
		"Patelnia, chleb, ser. Szybki obiad, póki rosną drzewa.",
		"Jak: patelnia, chleb, masło i ser — wszystko ze słodkiej wody, mleka kokosowego i mąki."
	]
	quest.4200000000290618.title: "Tost z serem"
	quest.4200000000290619.quest_desc: [
		"Suche papryczki, pomidor, cebula, fasola, liść przyprawy oraz mięso albo jedwabiste tofu. Food Extended zaczyna się opłacać.",
		"Jak: garnek, suche chili, pomidor, cebula, fasola, liść przyprawy i mięso albo jedwabiste tofu."
	]
	quest.4200000000290619.title: "Miska chili"
	quest.420000000029061A.quest_desc: [
		"Przyprawy z młynka, warzywa z ogrodów, robota przy garnku.",
		"Jak: rondelek, ryż, kokos, chili, czarny pieprz, proszek curry (liść przyprawy + musztarda + cynamon)."
	]
	quest.420000000029061A.title: "Talerz curry"
	quest.420000000029061B.quest_desc: [
		"Ciasto, sos, mięso. Forma do pieczenia. Pełny posiłek HarvestCraft.",
		"Jak: forma do pieczenia, ciasto, pomidor, ser, pepperoni (bekon wieprzowy albo bekon z tofu z klonu + soi)."
	]
	quest.420000000029061B.title: "Pizza pepperoni"
	quest.420000000029061C.quest_desc: [
		"Ryż z grząskiego ogrodu, marchew, cebula, groszek i jajko — jedwabiste tofu zastępuje je, póki nie ma kur.",
		"Jak: patelnia, ryż z grząskiego ogrodu, marchew, cebula, groszek i jajko — jedwabiste tofu liczy się jako jajko."
	]
	quest.420000000029061C.title: "Smażony ryż z ogrodu"
	quest.420000000029061D.quest_desc: [
		"Liść herbaty i liść przyprawy w garnku. Cienisty ogród i grząski dają oba.",
		"Jak: garnek, liść herbaty i liść przyprawy. Cienisty ogród upuszcza i herbatę, i przyprawę."
	]
	quest.420000000029061D.title: "Zielona herbata"
	quest.420000000029061E.quest_desc: [
		"Olej i wytrawny owoc. Opcjonalny połów żelaznej siatki.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.420000000029061E.title: "Drzewo oliwne"
	quest.420000000029061F.quest_desc: [
		"Sok i skórka. Opcjonalne.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.420000000029061F.title: "Drzewo pomarańczowe"
	quest.4200000000290620.quest_desc: [
		"Letni owoc. Opcjonalne.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.4200000000290620.title: "Drzewo brzoskwini"
	quest.4200000000290621.quest_desc: [
		"Pieprz do młynka. Opcjonalne.",
		"Jak: przesiej ziemię żelazną siatką po sadzonki kuchenne, potem upraw owoc."
	]
	quest.4200000000290621.title: "Drzewo pieprzu"
	quest.4200000000290622.quest_desc: [
		"Tłuszcz do smażenia. Opcjonalny zapas.",
		"Jak: wytłocz nasiona albo oliwki w JEI. Opcjonalny zapas."
	]
	quest.4200000000290622.title: "Olej kuchenny"
	quest.4200000000290623.quest_desc: [
		"Mleko i sól. Opcjonalny zapas.",
		"Jak: garnek i mleko (mleko kokosowe na słodkiej wodzie działa)."
	]
	quest.4200000000290623.title: "Masło"
	quest.4200000000290624.quest_desc: [
		"Jajko przez sokowirówkę. Opcjonalne.",
		"Jak: sokowirówka i jajko (jedwabiste tofu się liczy). Opcjonalne."
	]
	quest.4200000000290624.title: "Majonez"
	quest.4200000000290625.quest_desc: [
		"Deska do krojenia, mieszane owoce. Opcjonalne.",
		"Jak: deska do krojenia i mieszane owoce. Opcjonalne."
	]
	quest.4200000000290625.title: "Sałatka owocowa"
	quest.4200000000290626.quest_desc: [
		"Wieczór z makaronem. Opcjonalne.",
		"Jak: ogrody i drzewa owocowe dają składniki. Tofu sojowe zastępuje mięso i jajko. JEI podaje stanowisko."
	]
	quest.4200000000290626.title: "Kolacja spaghetti"
	quest.4200000000290627.quest_desc: [
		"Śniadanie na pokaz. Opcjonalne.",
		"Jak: ogrody i drzewa owocowe dają składniki. Tofu sojowe zastępuje mięso i jajko. JEI podaje stanowisko."
	]
	quest.4200000000290627.title: "Naleśniki z bekonem"
	quest.4200000000290628.quest_desc: [
		"Ziemia na żelaznej siatce pod sadzonkę awokado, potem patelnia, tost, sól, czosnek, liść przyprawy.",
		"Jak: sadzonka awokado z żelaznej siatki, potem patelnia z tostem, solą, czosnkiem, liściem przyprawy."
	]
	quest.4200000000290628.title: "Tost z awokado"
	quest.4200000000290629.quest_desc: [
		"To nie hamburger Delight. Opcjonalne.",
		"Jak: ogrody i drzewa owocowe dają składniki. Tofu sojowe zastępuje mięso i jajko. JEI podaje stanowisko."
	]
	quest.4200000000290629.title: "Burger z cebulą"
	quest.420000000029062A.quest_desc: [
		"Sokowirówka, jabłka. Opcjonalne.",
		"Jak: sokowirówka i jabłka Pam's. Opcjonalne."
	]
	quest.420000000029062A.title: "Sok jabłkowy"
	quest.420000000029062B.quest_desc: [
		"Patelnia, chleb i masło. Opcjonalne.",
		"Jak: patelnia, chleb i masło. Opcjonalne."
	]
	quest.420000000029062B.title: "Kromka tosta"
	quest.42000000002A062C.quest_desc: [
		"Cztery patyki w kwadrat. Postaw je na roli. Waniliowe nasiona zmieniają się, gdy je sadzisz — nasiona Mystical Agriculture nie.",
		"Włóż drugi zestaw patyków w ten sam blok, by zrobić uprawę krzyżową — pustą parę, która bierze po tym, co dojrzałe obok. Otocz ją rodzicami z czterech stron, a sama się zasieje w kilka minut; mączka kostna na krzyżówce wymusza próbę od razu.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: cztery patyki w kwadrat. Postaw na roli, potem zasadź nasiono."
	]
	quest.42000000002A062C.title: "Drewniane patyki uprawne"
	quest.42000000002A062D.quest_desc: [
		"Książka i pióro (książka, worek z atramentem, pióro) plus nasiona pszenicy. Zostaw ją w analizatorze.",
		"Jak: książka i pióro (książka, worek z atramentem, pióro) plus nasiona pszenicy. Węgiel drzewny plus szklana butelka dają atrament."
	]
	quest.42000000002A062D.title: "Dziennik upraw"
	quest.42000000002A062E.quest_desc: [
		"Szyba i patyki. Spójrz na uprawę, by odczytać wzrost, plon i siłę bez zbierania.",
		"Jak: szyba między patykami, potem trzonek z patyka. Spójrz na zasadzoną uprawę."
	]
	quest.42000000002A062E.title: "Lupa"
	quest.42000000002A062F.quest_desc: [
		"Szkło, kamienna płyta, deski, patyki. Włóż nasiono z dziennikiem. Hodowla staje się widoczna.",
		"Płodność to statystyka, która napędza krzyżowanie: świeże nasiono ma 1 z 10, a każdy punkt zwiększa szansę, że roślina zostanie rodzicem. Analizuj, sadź najlepsze od nowa, a krzyżówki przychodzą szybciej.",
		"Jak: szyby, kamienna płyta, deski i patyki. Osadź dziennik, potem nasiono."
	]
	quest.42000000002A062F.title: "Analizator nasion"
	quest.42000000002A0630.quest_desc: [
		"Chwasty są wyłączone w tej paczce, ale grabie i tak zdejmują patyk. Noś je i tak.",
		"Jak: drewniany płot nad patykiem. Chwasty są wyłączone; i tak zdejmuje patyk."
	]
	quest.42000000002A0630.title: "Drewniane grabie"
	quest.42000000002A0631.quest_desc: [
		"Podnieś roślinę i postaw ją z nietkniętymi statystykami. Przenieś 10-10, nie psując go.",
		"Jak: dwie sztabki żelaza i patyk. Podnieś roślinę z nietkniętymi statystykami."
	]
	quest.42000000002A0631.title: "Łopatka"
	quest.42000000002A0632.quest_desc: [
		"Przytnij dojrzałą roślinę po produkt cięcia i zresetuj ją. Kwiaty i niektóre uprawy HarvestCraft.",
		"Jak: nożyce, żelazo i patyk. Przytnij dojrzałą roślinę i zresetuj ją."
	]
	quest.42000000002A0632.title: "Sekator"
	quest.42000000002A0633.quest_desc: [
		"Noś linię hodowlaną. Napełnij ją z analizatora, wysyp na patyki.",
		"Jak: skóra i sznurek. Napełnij z analizatora."
	]
	quest.42000000002A0633.title: "Worek nasion"
	quest.42000000002A0634.quest_desc: [
		"Solidniejsze patyki. Te same zasady sadzenia, mniej kłopotu, gdy je trącisz.",
		"Jak: dwie bryłki żelaza w kolumnie dają osiem."
	]
	quest.42000000002A0634.title: "Żelazne patyki uprawne"
	quest.42000000002A0635.quest_desc: [
		"Lepsze grabie. Wciąż nawyk, nawet gdy chwastów już nie ma.",
		"Jak: żelazne kraty nad patykiem."
	]
	quest.42000000002A0635.title: "Żelazne grabie"
	quest.42000000002A0636.quest_desc: [
		"Trzyma wodę do kanałów. Farma na platformie, która nie nosi wiader co rano.",
		"Jak: deski. Trzyma wodę do kanałów."
	]
	quest.42000000002A0636.title: "Zbiornik nawadniania"
	quest.42000000002A0637.quest_desc: [
		"Prowadź wodę ze zbiornika wzdłuż rzędu. Uprawy piją z kanału, nie od ciebie.",
		"Jak: bez kształtu ze zbiornika — jeden zbiornik daje osiem kanałów."
	]
	quest.42000000002A0637.title: "Kanał nawadniania"
	quest.42000000002A0638.quest_desc: [
		"Zatrzymuj i uruchamiaj linię, nie rozbijając zbiornika.",
		"Jak: żelazne kraty, czerwony barwnik i sztabka żelaza. Zatrzymuj i uruchamiaj linię, nie rozbijając zbiornika."
	]
	quest.42000000002A0638.title: "Zawór kanału"
	quest.42000000002A0639.quest_desc: [
		"Deszcz w kwadracie. Osadź go na kanale nad patykami.",
		"Jak: osadź go na kanale nad patykami. JEI podaje recepturę."
	]
	quest.42000000002A0639.title: "Zraszacz"
	quest.42000000002A063A.quest_desc: [
		"Przykryj kanał, żeby przejść wzdłuż rzędu.",
		"Jak: przykryj kanał, żeby przejść wzdłuż rzędu."
	]
	quest.42000000002A063A.title: "Krata kanału"
	quest.42000000002A063B.quest_desc: [
		"Odczytaj pomieszczenie. Światło, wilgotność, powód, dla którego uprawa stanęła.",
		"Jak: wytwórz, potem postaw w pomieszczeniu, by czytać światło i wilgotność."
	]
	quest.42000000002A063B.title: "Monitor szklarni"
	quest.42000000002A063C.quest_desc: [
		"Późne patyki. Ognioodporne, uparte, dla roślin, które za dużo wymagają od drewna. Dwie sąsiednie dojrzałe uprawy mogą się krzyżować.",
		"Jak: dwa obsydiany w kolumnie dają osiem. Dwie sąsiednie dojrzałe uprawy mogą się krzyżować."
	]
	quest.42000000002A063C.title: "Obsydianowe patyki uprawne"
	quest.42000000002A063D.quest_desc: [
		"Kanał, po którym da się chodzić. Opcjonalne.",
		"Jak: kanał, po którym da się chodzić. Opcjonalne."
	]
	quest.42000000002A063D.title: "Wydrążony kanał"
	quest.42000000002A063E.quest_desc: [
		"Uprawy rudy dają to. Opcjonalna linia hodowlana.",
		"Jak: drewniane patyki uprawne z patyków; dziennik to książka i pióro plus nasiona; analizator to szkło i drewno. Sadź na roli."
	]
	quest.42000000002A063E.title: "Uprawa bryłki miedzi"
	quest.42000000002A063F.quest_desc: [
		"Kwarc z patyka. Opcjonalne.",
		"Jak: drewniane patyki uprawne z patyków; dziennik to książka i pióro plus nasiona; analizator to szkło i drewno. Sadź na roli."
	]
	quest.42000000002A063F.title: "Uprawa odłamka kwarcu"
	quest.42000000002A0640.quest_desc: [
		"Paliwo z uprawy. Opcjonalne.",
		"Jak: drewniane patyki uprawne z patyków; dziennik to książka i pióro plus nasiona; analizator to szkło i drewno. Sadź na roli."
	]
	quest.42000000002A0640.title: "Węglowy kamyk"
	quest.42000000002A0641.quest_desc: [
		"Późna uprawa rudy. Opcjonalna.",
		"Jak: drewniane patyki uprawne z patyków; dziennik to książka i pióro plus nasiona; analizator to szkło i drewno. Sadź na roli."
	]
	quest.42000000002A0641.title: "Uprawa odłamka szmaragdu"
	quest.42000000002A0642.quest_desc: [
		"Późna uprawa rudy. Opcjonalna.",
		"Jak: drewniane patyki uprawne z patyków; dziennik to książka i pióro plus nasiona; analizator to szkło i drewno. Sadź na roli."
	]
	quest.42000000002A0642.title: "Uprawa odłamka diamentu"
	quest.42000000002A0643.quest_desc: [
		"Szczytowa uprawa rudy. Opcjonalna i wolna.",
		"Jak: drewniane patyki uprawne z patyków; dziennik to książka i pióro plus nasiona; analizator to szkło i drewno. Sadź na roli."
	]
	quest.42000000002A0643.title: "Drzazga netherytu"
	quest.42000000002A0644.quest_desc: [
		"Własny kwiat AgriCraft. Opcjonalny.",
		"Jak: drewniane patyki uprawne z patyków; dziennik to książka i pióro plus nasiona; analizator to szkło i drewno. Sadź na roli."
	]
	quest.42000000002A0644.title: "Płatek Amathyllis"
	reward.5000000000060135.title: "Nić powrotu: +1 życie Clowder"
	reward.5000000000080193.title: "Nić powrotu: +1 życie Clowder"
