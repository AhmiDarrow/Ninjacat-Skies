	quest.4200000000180390.quest_desc: [
		"Najtwardsza uprawa na farmie, całkiem dosłownie.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000180390.title: "Esencja diamentu"
	quest.4200000000180391.quest_desc: [
		"Uprawia paliwo na polu, zamiast w pokładzie.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000180391.title: "Esencja węgla"
	quest.4200000000180392.quest_desc: [
		"Uprawia miedź na polu, zamiast w żyle.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000180392.title: "Esencja miedzi"
	quest.4200000000180393.quest_desc: [
		"Uprawia pył na roślinie, zamiast pod ziemią.",
		"Jak: receptura Mystical Agriculture w JEI. Inferium i Prosperity biorą się z sita; nasiona nasącza się na Ołtarzu infuzji."
	]
	quest.4200000000180393.title: "Esencja redstone"
	quest.4200000000190394.quest_desc: [
		"Wskazuje gniazda, które postawiłeś i o nich zapomniałeś.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.4200000000190394.title: "Lokalizator gniazd"
	quest.4200000000190395.quest_desc: [
		"Brzozowe kłody wokół kwiatu: pszczoły cieśle innego koloru.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.4200000000190395.title: "Brzozowy pierścień"
	quest.4200000000190396.quest_desc: [
		"Świerk wokół kwiatu: pszczoły żywiczne.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.4200000000190396.title: "Świerkowy pierścień"
	quest.4200000000190397.quest_desc: [
		"Ciemny dąb wokół kwiatu: pszczoły z niebieską pręgą.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.4200000000190397.title: "Pierścień ciemnego dębu"
	quest.4200000000190398.quest_desc: [
		"Świetlokamień wokół kwiatu: pszczoły, które się świecą.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.4200000000190398.title: "Pierścień świetlokamienia"
	quest.4200000000190399.quest_desc: [
		"Kwarc wokół kwiatu: krystaliczne pszczoły, korzeń linii rud.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.4200000000190399.title: "Pierścień kwarcu"
	quest.420000000019039A.quest_desc: [
		"Cegły Netheru wokół kwiatu: magmowe.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.420000000019039A.title: "Pierścień cegły Netheru"
	quest.420000000019039B.quest_desc: [
		"Piasek dusz wokół kwiatu: upiorne.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.420000000019039B.title: "Pierścień piasku dusz"
	quest.420000000019039C.quest_desc: [
		"Kamień Endu wokół kwiatu: pszczoły ender, i daleki kres hodowli.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.420000000019039C.title: "Pierścień kamienia Endu"
	quest.420000000019039D.quest_desc: [
		"Obsydian wokół kwiatu: smocze. Nie pytaj, co to je.",
		"Jak: pierścień z materiału gniazda wokół małego kwiatu. Postaw go, potem prawy przycisk małym kwiatem, żeby go obudzić; pszczoły wylatują po chwili."
	]
	quest.420000000019039D.title: "Obsydianowy pierścień"
	quest.420000000019039E.quest_desc: [
		"Prawdziwy ul, z większą liczbą miejsc niż dzikie gniazdo.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.420000000019039E.title: "Zaawansowany dębowy ul"
	quest.420000000019039F.quest_desc: [
		"Przykręca się do ula, żeby dać pszczołom więcej miejsca do życia.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.420000000019039F.title: "Skrzynka rozszerzenia (Pasieka)"
	quest.42000000001903A0.quest_desc: [
		"Łapie pszczołę w szkle, żeby dało się ją nosić.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A0.title: "Słoik dębu"
	quest.42000000001903A1.quest_desc: [
		"Zamykaj pszczoły w klatce, by przenosić ule.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A1.title: "Klatka na pszczołę (Pasieka)"
	quest.42000000001903A2.quest_desc: [
		"Trzyma pszczołę bezpiecznie do przewozu między platformami.",
		"Jak: tylko w skrzyniach wioski, a pustka nie ma wiosek. Opcjonalne."
	]
	quest.42000000001903A2.title: "Solidna klatka"
	quest.42000000001903A3.quest_desc: [
		"Sam zgarnia pszczoły do słoików, siatka niepotrzebna.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A3.title: "Łapacz (Pasieka)"
	quest.42000000001903A4.quest_desc: [
		"Utrzymuje ul nakarmiony, żeby pszczoły dalej pracowały.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A4.title: "Karmnik"
	quest.42000000001903A5.quest_desc: [
		"Napełnia butelki miodem zebranym w ulu.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A5.title: "Butelkarka (Pasieka)"
	quest.42000000001903A6.quest_desc: [
		"Wiruje plaster miodu, rozdzielając go na miód, wosk i plastry.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A6.title: "Wirówka (Pasieka)"
	quest.42000000001903A7.quest_desc: [
		"Wirówka, która kręci się sama, gdy dostanie energię.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A7.title: "Wirówka energetyczna (Pasieka)"
	quest.42000000001903A8.quest_desc: [
		"Kręci się szybciej, gdy zasila ją źródło ciepła.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A8.title: "Podgrzewana wirówka"
	quest.42000000001903A9.quest_desc: [
		"Wykluwa larwy pszczół w nowe pszczoły o przydatnych cechach.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903A9.title: "Inkubator (Pasieka)"
	quest.42000000001903AA.quest_desc: [
		"Paruje dwie pszczoły i daje potomstwo o mieszanych cechach.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903AA.title: "Komora hodowli (Pasieka)"
	quest.42000000001903AB.quest_desc: [
		"Odczytuje cechy pszczoły i zapisuje je do hodowli.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903AB.title: "Indeksator genów (Pasieka)"
	quest.42000000001903AC.quest_desc: [
		"Spala miód na powolny, równy strumyczek energii.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903AC.title: "Generator miodu (Pasieka)"
	quest.42000000001903AD.quest_desc: [
		"Przekąska, która trzyma pszczołę w klatce spokojną i zdrową.",
		"Jak: plaster miodu plus butelka miodu, bez kształtu."
	]
	quest.42000000001903AD.title: "Miodowy przysmak (Pasieka)"
	quest.42000000001903AE.quest_desc: [
		"Pełne wiadro miodu, gotowe do wlania albo spalenia.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903AE.title: "Wiadro miodu"
	quest.42000000001903AF.quest_desc: [
		"Topi się na świece albo uszczelnia ramkę ula.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903AF.title: "Zapas wosku"
	quest.42000000001903B0.quest_desc: [
		"Plaster miodu, który da się dostroić do dowolnej pszczoły.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903B0.title: "Konfigurowalny plaster"
	quest.42000000001903B1.quest_desc: [
		"Cechy pszczoły, wyciągnięte i gotowe do butelkowania.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903B1.title: "Próbka genu"
	quest.42000000001903B2.quest_desc: [
		"Genetyka jednej pszczoły, schowana do późniejszej hodowli.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903B2.title: "Butelka genu"
	quest.42000000001903B3.quest_desc: [
		"Cztery plastry sprasowane na twardo, głównie do budowania.",
		"Jak: cztery plastry miodu."
	]
	quest.42000000001903B3.title: "Blok plastra miodu"
	quest.42000000001903B4.quest_desc: [
		"Spowalnia upadki i ruch. Lepki pod stopami, słodki w leju.",
		"Jak: cztery butelki miodu. Butelki wracają."
	]
	quest.42000000001903B4.title: "Blok miodu (pasieka)"
	quest.42000000001903B5.quest_desc: [
		"Dziki ul. Zadym go, aż się uspokoi, zanim weźmiesz plaster.",
		"Jak: trzy plastry miodu i sześć desek. Ognisko pod spodem je uspokaja."
	]
	quest.42000000001903B5.title: "Ul podstawowy"
	quest.42000000001903B6.quest_desc: [
		"Dym od spodu uspokaja pszczoły przy zbiorze.",
		"Jak: kłody, patyki oraz węgiel albo węgiel drzewny."
	]
	quest.42000000001903B6.title: "Ognisko pod spodem"
	quest.42000000001903B7.quest_desc: [
		"Kwiaty do pracy pszczół.",
		"Jak: mączka kostna na trawę albo mały kwiat do dębowego gniazda."
	]
	quest.42000000001903B7.title: "Dywan z kwiatów"
	quest.42000000001903B8.quest_desc: [
		"Więcej kwiatów w pobliżu to więcej pyłku dla ula.",
		"Jak: mączka kostna na trawę. Pszczoły chcą dowolnego małego kwiatu."
	]
	quest.42000000001903B8.title: "Pole mniszków"
	quest.42000000001903B9.quest_desc: [
		"Efektowniejszy kwiat, który część pszczół woli od mniszków.",
		"Jak: mech plus dąb albo mączka kostna na mech. Pszczoły przyjmują kwiat."
	]
	quest.42000000001903B9.title: "Rozkwit azalii"
	quest.42000000001903BA.quest_desc: [
		"Owoc z Endu, z którego część pszczół chętnie zbiera.",
		"Jak: stragan Chodzących po krawędzi przy /clowder hub. Zewnętrzne wyspy Endu zniknęły."
	]
	quest.42000000001903BA.title: "Przekąska z refrenu"
	quest.42000000001903BB.quest_desc: [
		"Dziwny faworyt paru twardszych pszczół.",
		"Jak: woda na źródło lawy (albo lawa na wodę). Zostaw źródło lawy."
	]
	quest.42000000001903BB.title: "Obsydianowy przysmak"
	quest.42000000001903BC.quest_desc: [
		"Więcej pomieszczeń dla ula, tym razem wyciętych z brzozy.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903BC.title: "Rozbudowa z brzozy"
	quest.42000000001903BD.quest_desc: [
		"Pomieszczenia wyłożone świerkiem, przykręcone do ula.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903BD.title: "Rozbudowa ze świerku"
	quest.42000000001903BE.quest_desc: [
		"Boazeria z ciemnego dębu, ten sam cel: więcej pomieszczeń dla pszczół.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903BE.title: "Rozbudowa z ciemnego dębu"
	quest.42000000001903BF.quest_desc: [
		"Pomieszczenia z akacji dla ula, który przerósł sam siebie.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903BF.title: "Rozbudowa z akacji"
	quest.42000000001903C0.quest_desc: [
		"Pomieszczenia z drewna dżunglowego, równie przestronne jak reszta.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903C0.title: "Rozbudowa z dżungli"
	quest.42000000001903C1.quest_desc: [
		"Pomieszczenia wyłożone wiśnią, czysta kwestia stylu.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903C1.title: "Rozbudowa z wiśni"
	quest.42000000001903C2.quest_desc: [
		"Pomieszczenia wyłożone szkarłatem dla ula, który poszedł w Nether.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903C2.title: "Szkarłatna rozbudowa"
	quest.42000000001903C3.quest_desc: [
		"Pomieszczenia wyłożone spaczonym drewnem, niebieska połowa pary.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903C3.title: "Spaczona rozbudowa"
	quest.42000000001903C4.quest_desc: [
		"Bambusowe pomieszczenia, lżejsze i równie praktyczne.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903C4.title: "Rozbudowa z bambusa"
	quest.42000000001903C5.quest_desc: [
		"Pomieszczenia z namorzynu, najnowsze drewno na liście.",
		"Jak: receptury Productive Bees są w JEI. Rój nazywa ul, wirówkę i kroki hodowli."
	]
	quest.42000000001903C5.title: "Rozbudowa z namorzynu"
	quest.42000000001903C6.quest_desc: [
		"Miód, który pijesz prosto z butelki.",
		"Jak: szklana butelka na pełny ul. Ognisko pod spodem."
	]
	quest.42000000001903C6.title: "Zapas butelek miodu"
	quest.42000000001903C7.quest_desc: [
		"Trafia do smakołyków i ciast dla głodnego Clowder.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000001903C7.title: "Zapas cukru"
	quest.42000000001903C8.quest_desc: [
		"Puste i czekają na miód, mikstury albo doświadczenie.",
		"Jak: wytwórz, przetop, przesiej albo weź z potwora. JEI wymienia każde źródło na platformie."
	]
	quest.42000000001903C8.title: "Zapas butelek"
	quest.42000000001903C9.quest_desc: [
		"Zapasowa para do cięcia plastra bez ranienia pszczół.",
		"Jak: dwie sztabki żelaza po skosie. Strzyż owce i gniazda pszczół."
	]
	quest.42000000001903C9.title: "Zapasowe nożyce"
	quest.42000000001A03CA.quest_desc: [
		"Jeden blok, który przenosi przedmioty tam, gdzie mu każesz — układ nerwowy platformy.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: sztabki żelaza i żelazne kraty wokół pustego modułu; daje cztery. Moduły wchodzą do routera."
	]
	quest.42000000001A03CA.title: "Modułowy router"
	quest.42000000001A03CB.quest_desc: [
		"Karta, na której zapisuje się każde zachowanie routera.",
		"Jak: modułowy router plus puste moduły w JEI. Wyciągacz/nadawca/łamacz siedzą w routerze."
	]
	quest.42000000001A03CB.title: "Pusty moduł"
	quest.42000000001A03CC.quest_desc: [
		"Wyciąga przedmioty z sąsiada do routera.",
		"Jak: modułowy router plus puste moduły w JEI. Wyciągacz/nadawca/łamacz siedzą w routerze."
	]
	quest.42000000001A03CC.title: "Moduł wyciągający"
	quest.42000000001A03CD.quest_desc: [
		"Wpychaj przedmioty w oznaczone miejsce po drugiej stronie platformy.",
		"Jak: modułowy router plus puste moduły w JEI. Wyciągacz/nadawca/łamacz siedzą w routerze."
	]
	quest.42000000001A03CD.title: "Moduł wysyłający"
	quest.42000000001A03CE.quest_desc: [
		"Rozbij blok przed routerem i zostaw sobie to, co spadnie.",
		"Jak: modułowy router plus puste moduły w JEI. Wyciągacz/nadawca/łamacz siedzą w routerze."
	]
	quest.42000000001A03CE.title: "Moduł kruszący"
	quest.42000000001A03CF.quest_desc: [
		"Postaw blok tam, gdzie wskazuje router.",
		"Jak: modułowy router plus puste moduły w JEI. Wyciągacz/nadawca/łamacz siedzą w routerze."
	]
	quest.42000000001A03CF.title: "Moduł stawiający"
	quest.42000000001A03D0.quest_desc: [
		"Wyślij redstone, gdy zawartość routera przekroczy próg.",
		"Jak: modułowy router plus puste moduły w JEI. Wyciągacz/nadawca/łamacz siedzą w routerze."
	]
	quest.42000000001A03D0.title: "Moduł detektora"
	quest.42000000001A03D1.quest_desc: [
		"Niesie przedmioty między skrzyniami, maszynami i platformami.",
		"Jak: żelazo + redstone. Ustaw ścianki kluczem Pipez."
	]
	quest.42000000001A03D1.title: "Rura na przedmioty"
	quest.42000000001A03D2.quest_desc: [
		"Niesie płyny między zbiornikami a maszynami, bez biegania z wiadrem.",
		"Jak: żelazo + wiadra + redstone. Użycie w skradaniu kluczem na boku, by wyciągać; prawy przycisk na tym boku dla filtrów."
	]
	quest.42000000001A03D2.title: "Rura na płyny"
	quest.42000000001A03D3.quest_desc: [
		"Niesie energię między maszynami, które ją robią, a tymi, które jej potrzebują.",
		"Jak: żelazo + redstone. Niesie FE między maszynami."
	]
	quest.42000000001A03D3.title: "Rura energii"
	quest.42000000001A03D4.quest_desc: [
		"Niesie chemikalia między maszynami, które je obsługują.",
		"Jak: rury z żelaza + redstone w JEI. Użycie w skradaniu kluczem ustawia wyciągające boki; prawy przycisk na jednym dla filtrów. Rozdział rur to cała drabina."
	]
	quest.42000000001A03D4.title: "Rura gazowa"
	quest.42000000001A03D5.quest_desc: [
		"Jedna rura, wiele zadań.",
		"Jak: rury z żelaza + redstone w JEI. Użycie w skradaniu kluczem ustawia wyciągające boki; prawy przycisk na jednym dla filtrów. Rozdział rur to cała drabina."
	]
	quest.42000000001A03D5.title: "Rura uniwersalna"
	quest.42000000001A03D6.quest_desc: [
		"Użyj w skradaniu boku rury, żeby wyciągała z maszyny, albo żeby go odciąć.",
		"Jak: dwa krzemienie i dwa patyki. Użycie w skradaniu boku rury przy maszynie, by wyciągała, jeszcze raz, by odciąć; prawy przycisk na wyciągającym boku dla filtrów."
	]
	quest.42000000001A03D6.title: "Klucz do rur"
	quest.42000000001A03D7.quest_desc: [
		"Ulepszenie prędkości do rury.",
		"Jak: rury z żelaza + redstone w JEI. Użycie w skradaniu kluczem ustawia wyciągające boki; prawy przycisk na jednym dla filtrów. Rozdział rur to cała drabina."
	]
	quest.42000000001A03D7.title: "Podstawowe ulepszenie"
	quest.42000000001A03D8.quest_desc: [
		"Włóż ją w rurę, by na tick szło więcej.",
		"Jak: rury z żelaza + redstone w JEI. Użycie w skradaniu kluczem ustawia wyciągające boki; prawy przycisk na jednym dla filtrów. Rozdział rur to cała drabina."
	]
	quest.42000000001A03D8.title: "Poprawione ulepszenie"
	quest.42000000001A03D9.quest_desc: [
		"Mocniejsze ulepszenie, na linię pod dużym obciążeniem.",
		"Jak: rury z żelaza + redstone w JEI. Użycie w skradaniu kluczem ustawia wyciągające boki; prawy przycisk na jednym dla filtrów. Rozdział rur to cała drabina."
	]
	quest.42000000001A03D9.title: "Zaawansowane ulepszenie"
	quest.42000000001A03DA.quest_desc: [
		"Najwyższy poziom przepustowości Pipez.",
		"Jak: rury z żelaza + redstone w JEI. Użycie w skradaniu kluczem ustawia wyciągające boki; prawy przycisk na jednym dla filtrów. Rozdział rur to cała drabina."
	]
	quest.42000000001A03DA.title: "Ostateczne ulepszenie"
	quest.42000000001A03DB.quest_desc: [
		"Zdejmij limity tempa Pipez.",
		"Jak: tylko kreatywny; Pipez nie ma receptury przetrwania. Opcjonalnie."
	]
	quest.42000000001A03DB.title: "Nieskończone ulepszenie"
	quest.42000000001A03DC.quest_desc: [
		"Ustawia, które przedmioty koniec rury przyjmie albo pominie.",
		"Jak: rury z żelaza + redstone w JEI. Użycie w skradaniu kluczem ustawia wyciągające boki; prawy przycisk na jednym dla filtrów. Rozdział rur to cała drabina."
	]
	quest.42000000001A03DC.title: "Narzędzie filtra"
	quest.42000000001A03DD.quest_desc: [
		"Ten pierwszy przenośnik. Wolny, tani i zawsze przydatny.",
		"Jak: pięć żelaza wokół skrzyni. Posadź go pod Ramą krosna albo Beczką napięcia (wyciąga W DÓŁ)."
	]
	quest.42000000001A03DD.title: "Zapasowy lej (Rury)"
	quest.42000000001A03DE.quest_desc: [
		"Linia podajników do logistyki.",
		"Jak: bruk wokół redstone."
	]
	quest.42000000001A03DE.title: "Linia podajników"
	quest.42000000001A03DF.quest_desc: [
		"Wystrzeliwuje albo stawia to, co załadowane, gdy dostanie sygnał.",
		"Jak: bruk, łuk i redstone."
	]
	quest.42000000001A03DF.title: "Linia dozowników"
	quest.42000000001A03E0.quest_desc: [
		"Czyta, jak pełny jest pojemnik, i wysyła sygnał.",
		"Jak: kwarc Netheru, pochodnia redstone, kamień. Kwarc przesiewasz z piasku dusz; bez wyprawy do Netheru."
	]
	quest.42000000001A03E0.title: "Komparator (Rury)"
	quest.42000000001A03E1.quest_desc: [
		"Obserwator czyta rytm.",
		"Jak: bruk, redstone i kwarc Netheru."
	]
	quest.42000000001A03E1.title: "Linia obserwatorów"
	quest.42000000001A03E2.quest_desc: [
		"Źródło sygnału, które jest zawsze włączone, albo inwerter obok dźwigni.",
		"Jak: redstone nad patykiem."
	]
	quest.42000000001A03E2.title: "Pochodnia redstone"
	quest.42000000001A03E3.quest_desc: [
		"Przekaźnik taktuje obwód.",
		"Jak: pochodnia redstone, redstone, kamień. Rozdział rur używa go do zegarów."
	]
	quest.42000000001A03E3.title: "Przekaźnik (Rury)"
	quest.42000000001A03E4.quest_desc: [
		"Trafiony pociskiem, wysyła sygnał według siły.",
		"Jak: redstone wokół siana. Siano to trzy pszenice."
	]
	quest.42000000001A03E4.title: "Cel"
	quest.42000000001A03E5.quest_desc: [
		"Czyta niebo i daje sygnał według światła albo pory.",
		"Jak: szkło, kwarc Netheru, drewniane płyty."
	]
	quest.42000000001A03E5.title: "Detektor światła dziennego (Rury)"
	quest.42000000001A03E6.quest_desc: [
		"Trzyma książkę i daje sygnał, gdy kartka się przewraca.",
		"Jak: drewniane płyty wokół biblioteczki."
	]
	quest.42000000001A03E6.title: "Pulpit (Rury)"
	quest.42000000001A03E7.quest_desc: [
		"Daje sygnał, póki otwarty, jak skrzynia z potykaczem.",
		"Jak: zaczep potykacza plus skrzynia."
	]
	quest.42000000001A03E7.title: "Skrzynia-pułapka"
	quest.42000000001A03E8.quest_desc: [
		"Ładuje taśmę albo ściąga z niej przedmioty, zależnie od strony.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.42000000001A03E8.title: "Lejek Create"
	quest.42000000001A03E9.quest_desc: [
		"Lejek, który potrafi filtrować to, co przenosi.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.42000000001A03E9.title: "Mosiężny lejek"
	quest.42000000001A03EA.quest_desc: [
		"Zrzuca przedmioty prosto w dół, między piętrami.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.42000000001A03EA.title: "Zsyp (Rury)"
	quest.42000000001A03EB.quest_desc: [
		"Zsyp, który potrafi filtrować przedmioty i je wstrzymywać.",
		"Jak: wytwarzanie Create w JEI (stół rzemieślniczy, prasa, mieszalnik albo rozmieszczacz). Stop andezytowy i koło wodne zaczynają linię."
	]
	quest.42000000001A03EB.title: "Inteligentny zsyp"
	quest.42000000001A03EC.quest_desc: [
		"Sortuje i przenosi przedmioty, z ustawianym priorytetem na każdą stronę.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000001A03EC.title: "Logistyka Mek"
	quest.42000000001A03ED.quest_desc: [
		"Przenosi płyny ciśnieniem, więc w górę idzie tak łatwo, jak w dół.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000001A03ED.title: "Rura Mek"
	quest.42000000001A03EE.quest_desc: [
		"Niesie energię między maszynami, na kilku poziomach przepustowości.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000001A03EE.title: "Kabel Mek"
	quest.42000000001A03EF.quest_desc: [
		"Przenosi chemikalia i gazy szczelną linią.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000001A03EF.title: "Rurka Mek"
	quest.42000000001A03F0.quest_desc: [
		"Szybsza linia, by przenosić przedmioty po ruchliwej platformie.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000001A03F0.title: "Zaawansowany transporter"
	quest.42000000001A03F1.quest_desc: [
		"Jeszcze szybciej, dla sieci, której podstawy już nie starczą.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000001A03F1.title: "Elitarny transporter"
	quest.42000000001A03F2.quest_desc: [
		"Najszybsza linia przedmiotów, dla platformy na maksimum.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000001A03F2.title: "Ostateczny transporter"
	quest.42000000001A03F3.quest_desc: [
		"Linia energii o najwyższej przepustowości, do ciężkich hal maszyn.",
		"Jak: rozdział Zakłady Mekanism — bryłki rudy z sita, potem linia fabryki."
	]
	quest.42000000001A03F3.title: "Ostateczny kabel"
	quest.42000000001B03F4.quest_desc: [
		"Wymienia każdego ducha, którego możesz związać, i czego mu trzeba.",
		"Dziewięć plemion zostawiło zapasy dla następnego Clowder. Użyj skrytki zarządcy, by rozpakować losowe zapasy, albo zrób z czterech małych jedną średnią, a z trzech średnich jedną dużą. Większe pieczęcie mają więcej rzutów i szerszą pulę zapasów; otwieranie osobno daje więcej podstawowych zapasów. W środku nie kryją się maszyny ani żetony postępu, ale każda pieczęć ma małą szansę na Odłamek Nici i bardzo małą na całą Nić powrotu; większe pieczęcie mają lepsze szanse.",
		"Jak: książka i Nasiona demonicznego snu, bezkształtnie. Przeczytaj; potem Duchowy ogień."
	]
	quest.42000000001B03F4.title: "Słownik duchów"
	quest.42000000001B03F5.quest_desc: [
		"Płonie na fioletowo i nigdy się nie rozchodzi. Służy do zapalania rytuałów.",
		"Jak: zapal Duchowy ogień, jak pokazuje Słownik duchów (Płonie!), potem wrzuć andezyt."
	]
	quest.42000000001B03F5.title: "Ogień duchów (Zaświaty)"
	quest.42000000001B03F6.quest_desc: [
		"Wskazuje zakopaną rudę albo ukryte budowle w pobliżu.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03F6.title: "Różdżka wróżebna"
	quest.42000000001B03F7.quest_desc: [
		"Ściera rytualną kredę z ziemi, gdy skończysz.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03F7.title: "Szczotka"
	quest.42000000001B03F8.quest_desc: [
		"Rośnie w drzewo, które nie należy do tego świata.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03F8.title: "Sadzonka Zaświatów"
	quest.42000000001B03F9.quest_desc: [
		"Drewno z obcego drzewa, do rytuałów wiązania.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03F9.title: "Pień Zaświatów"
	quest.42000000001B03FA.quest_desc: [
		"Trzyma ofiarę, póki trwa rytuał wiązania.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03FA.title: "Misa ofiarna"
	quest.42000000001B03FB.quest_desc: [
		"Złocona misa, która przyspiesza rytuał, w którym stoi.",
		"Jak: złoto wokół ofiarnej misy. Słownik nazywa rytuał."
	]
	quest.42000000001B03FB.title: "Złota misa"
	quest.42000000001B03FC.quest_desc: [
		"Niepodpisany kontrakt, który czeka na imię ducha.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03FC.title: "Pusta księga wiązania"
	quest.42000000001B03FD.quest_desc: [
		"Wiąże najsłabszą klasę duchów, dobra pierwsza próba.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03FD.title: "Księga Foliot"
	quest.42000000001B03FE.quest_desc: [
		"Wiąże ducha średniej mocy, mocniejsza praca niż foliot.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03FE.title: "Księga Djinni"
	quest.42000000001B03FF.quest_desc: [
		"Wiąże srogiego ducha. Rytuał wymaga więcej przygotowania.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B03FF.title: "Księga Afrit"
	quest.42000000001B0400.quest_desc: [
		"Wiąże najsilniejszego ducha ze słownika.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B0400.title: "Księga Marid"
	quest.42000000001B0401.quest_desc: [
		"Fokus, który pomaga rytuałowi trzymać kształt.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B0401.title: "Klejnot nastrojony na duchy"
	quest.42000000001B0402.quest_desc: [
		"Ruda spoza tego świata, wytapiana w Iesnium.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B0402.title: "Surowy Iesnium"
	quest.42000000001B0403.quest_desc: [
		"Metal, który jest tylko po drugiej stronie.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B0403.title: "Sztabka Iesnium"
	quest.42000000001B0404.quest_desc: [
		"Wysyła związanych duchowych górników do Zaświatów, by kopali.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B0404.title: "Szyb wymiarowy"
	quest.42000000001B0405.quest_desc: [
		"Najsłabszy duch, posłany kopać pod ziemią.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B0405.title: "Górnik Foliot"
	quest.42000000001B0406.quest_desc: [
		"Łączy słoje do przechowywania duchów w jedną sieć do przeszukiwania.",
		"Jak: Słownik duchów, potem Ogień duchów i misy. Rozdział Zaświaty nazywa obrzędy."
	]
	quest.42000000001B0406.title: "Kontroler magazynu (Zaświaty)"
	quest.42000000001B0407.quest_desc: [
		"Przyciąga niektóre duchy do kręgu rytualnego.",
		"Jak: sito, albo pączkujący ametyst, jeśli uprawiasz linię geod. Occultism chce odłamków."
	]
	quest.42000000001B0407.title: "Ametystowy fokus"
	quest.42000000001B0408.quest_desc: [
		"Topi się na złote misy i inny rytualny sprzęt.",
		"Jak: przetop surowe złoto / grys złota. Rzadszy połów sita."
	]
	quest.42000000001B0408.title: "Zapas sztabki złota"
	quest.42000000001B0409.quest_desc: [
		"Puste strony, gotowe stać się księgą wiązania.",
		"Jak: trzy papiery plus skóra. Papier to trzcina cukrowa."
	]
	quest.42000000001B0409.title: "Zapas książek"
	quest.42000000001B040A.quest_desc: [
		"Barwi rytualną kredę, by oznaczyć krąg przyzwania.",
		"Jak: niebieski plus czerwony, albo fioletowy kwiat. Occultism tego chce."
	]
	quest.42000000001B040A.title: "Fioletowy barwnik"
	quest.42000000001B040B.quest_desc: [
		"Barwi rytualną kredę, znak prostszy niż fiolet.",
		"Jak: mączka kostna w siatce, albo biały kwiat."
	]
	quest.42000000001B040B.title: "Biały barwnik"
	quest.42000000001B040C.quest_desc: [
		"Barwi rytualną kredę pod ciemniejszy krąg.",
		"Jak: węgiel drzewny albo worek z atramentem (węgiel drzewny plus szklana butelka)."
	]
	quest.42000000001B040C.title: "Czarny barwnik"
	quest.42000000001B040D.quest_desc: [
		"Rytualne podłoże o fakturze, którą rytuały zdają się lubić.",
		"Jak: piasek do beczki Ex Deorum z wodą wiedźmy. Sale brodawek w fortecy trzymają trochę. Trzy czaszki na piasku dusz robią Withera."
	]
	quest.42000000001B040D.title: "Zapas piasku dusz (Inny świat)"
	quest.42000000001B040E.quest_desc: [
		"Warstwa bazowa dla rytuałów, które ciążą ku ogniowi.",
		"Jak: Nether jest tu pustką, nie terenem. Wlej lawę do beczki Ex Deorum z wodą wiedźmy (beczka wody na grzybni; zarodniki grzybni przesiewasz z ziemi)."
	]
	quest.42000000001B040E.title: "Zapas Netherrack (Inny świat)"
	quest.42000000001B040F.quest_desc: [
		"Ciemna, stabilna rama dla kręgu rytualnego.",
		"Jak: woda na źródło lawy (albo lawa na wodę). Zostaw źródło lawy."
	]
	quest.42000000001B040F.title: "Zapas obsydianu (Inny świat)"
	quest.42000000001B0410.quest_desc: [
		"Dar, ku któremu ciągnie niektóre duchy.",
		"Jak: endermany, albo stragan Chodzących po krawędzi w /clowder hub."
	]
	quest.42000000001B0410.title: "Zapas pereł Endera (Inny świat)"
	quest.42000000001B0411.quest_desc: [
		"Dar wielkiej wartości na wymagający rytuał.",
		"Jak: przesiej żwir żelazną siatką albo lepszą, albo rudę diamentu w Echołamaczu."
	]
	quest.42000000001B0411.title: "Zapas diamentów"
	quest.42000000001B0412.quest_desc: [
		"Księga wiązania, w której Foliot jest już zapieczętowany.",
