	quest.C2000000000D0221.title: "Solar Basic"
	quest.C2000000000D0222.quest_desc: [
		"Generates power from the gap between hot and cold nearby blocks."
	]
	quest.C2000000000D0222.title: "Thermo Basic"
	quest.C2000000000D0223.quest_desc: [
		"Burns solid fuel steadily for a strong, dependable trickle of power."
	]
	quest.C2000000000D0223.title: "Reactor Basic"
	quest.C2000000000D0224.quest_desc: [
		"Moves more power per tick than the starting cable."
	]
	quest.C2000000000D0224.title: "Energy Cable Basic"
	quest.C2000000000D0225.quest_desc: [
		"Charges the player directly, no wires or slots required."
	]
	quest.C2000000000D0225.title: "Player Transmitter Basic"
	quest.C2000000000D0226.quest_desc: [
		"Feeds power into nearby machines the way a hopper feeds items."
	]
	quest.C2000000000D0226.title: "Energy Hopper Basic"
	quest.C2000000000D0227.quest_desc: [
		"Charges energizing cells faster when placed beside the crystal setup."
	]
	quest.C2000000000D0227.title: "Energizing Rod Basic"
