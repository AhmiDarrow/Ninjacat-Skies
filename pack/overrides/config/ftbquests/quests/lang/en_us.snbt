		"A softer way to farm light than mining the Nether ceiling."
	]
	quest.C200000000070150.title: "Glowstone Seeds"
	quest.C200000000070151.quest_desc: [
		"Hardened leaves that yield obsidian essence without a lava bucket in sight."
	]
	quest.C200000000070151.title: "Obsidian Seeds"
	quest.C200000000070152.quest_desc: [
		"High essence. The fields are industry now."
	]
	quest.C200000000070152.title: "Imperium"
	quest.C200000000070153.quest_desc: [
		"The last essence tier. Whatever you're building, this is the good version."
	]
	quest.C200000000070153.title: "Supremium"
	quest.C200000000070154.quest_desc: [
		"Swarm surplus, stacked."
	]
	quest.C200000000070154.title: "Honey Block"
	quest.C200000000070155.quest_desc: [
		"A bee that did not exist before you built the nest.",
		"Mining, mason, digger, carpenter \u2014 look at one."
	]
	quest.C200000000070155.subtitle: "Colony"
	quest.C200000000070155.title: "Something New Hums"
	quest.C200000000070156.quest_desc: [
		"Sand around a flower. Ashy and chocolate miners."
	]
	quest.C200000000070156.title: "Ring of Sand"
	quest.C200000000070157.quest_desc: [
		"Sugar cane around a flower. Reed bees and masons."
	]
	quest.C200000000070157.title: "Ring of Reed"
	quest.C200000000070158.quest_desc: [
		"Slime blocks around a flower. Guess."
	]
	quest.C200000000070158.title: "Ring of Slime"
	quest.C200000000070159.quest_desc: [
		"Hay around a flower. Bumble bees, and plain bees too."
	]
	quest.C200000000070159.title: "Ring of Hay"
	quest.C20000000007015A.quest_desc: [
		"Snow around a flower. Sweat bees, oddly."
	]
	quest.C20000000007015A.title: "Ring of Snow"
	quest.C20000000007015B.quest_desc: [
		"Burns honey for power. A hive doing double duty."
	]
	quest.C20000000007015B.title: "Honey Generator"
	quest.C20000000007015C.quest_desc: [
		"Holds one bee on display, wings and all, without a hive attached."
	]
	quest.C20000000007015C.title: "Jar"
	quest.C20000000007015D.quest_desc: [
		"Calms a hive full of bees before you go digging for honeycomb."
	]
	quest.C20000000007015D.title: "Campfire (Swarm)"
	quest.C20000000007015E.quest_desc: [
		"Feeds bees and blooms twice a year, evergreen the rest of the time."
	]
