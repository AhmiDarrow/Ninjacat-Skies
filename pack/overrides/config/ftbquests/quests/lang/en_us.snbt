	quest.42000000001E04A8.quest_desc: [
		"Marks a void-loom crafting station.",
		"How: planks around a Binding Knot. Stretch a mesh, hopper grit in, sit it on a hopper."
	]
	quest.42000000001E04A8.title: "Loomframe"
	quest.42000000001E04A9.quest_desc: [
		"Holds strain so a sieve line doesn't snap under load.",
		"How: barrels + Binding Knot. Pour water (bucket returns), add dirt → clay."
	]
	quest.42000000001E04A9.title: "Tension Barrel (Voidcraft)"
	quest.42000000001E04AA.quest_desc: [
		"Nine blocks of dirt folded into one for the trip up.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04AA.title: "Compressed Dirt"
	quest.42000000001E04AB.quest_desc: [
		"Nine cobblestone packed tight, cheap and endless.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04AB.title: "Compressed Cobble (Voidcraft)"
	quest.42000000001E04AC.quest_desc: [
		"Nine gravel compacted for storage, not for sieving.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04AC.title: "Compressed Gravel"
	quest.42000000001E04AD.quest_desc: [
		"Nine sand blocks pressed into one for hauling.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04AD.title: "Compressed Sand"
	quest.42000000001E04AE.quest_desc: [
		"Nine dust blocks pressed down for the same reason.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04AE.title: "Compressed Dust"
	quest.42000000001E04AF.quest_desc: [
		"Nether stone compacted for a lighter inventory.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04AF.title: "Compressed Netherrack"
	quest.42000000001E04B0.quest_desc: [
		"End stone compacted, useful once the void needs feeding.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B0.title: "Compressed End Stone"
	quest.42000000001E04B1.quest_desc: [
		"Deepslate compacted nine to one, still just stone.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B1.title: "Compressed Deepslate"
	quest.42000000001E04B2.quest_desc: [
		"Smashes a whole stack of compressed blocks apart at once.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B2.title: "Compressed Hammer"
	quest.42000000001E04B3.quest_desc: [
		"A weaker hammer for breaking compressed blocks.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B3.title: "Compressed Iron Hammer"
	quest.42000000001E04B4.quest_desc: [
		"A wide sieve, several gravel piles at a time.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B4.title: "Compressed Sieve (Voidcraft)"
	quest.42000000001E04B5.quest_desc: [
		"Sieves the same as oak, just a different grain.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B5.title: "Birch Sieve"
	quest.42000000001E04B6.quest_desc: [
		"Ferments the same as any other barrel.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B6.title: "Birch Barrel"
	quest.42000000001E04B7.quest_desc: [
		"Melts blocks the same as any other crucible.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B7.title: "Birch Crucible"
	quest.42000000001E04B8.quest_desc: [
		"The Strand's currency; earn it, spend it, never waste it.",
		"How: quest rewards, flint-mesh dirt on a Loomframe, steward caches."
	]
	quest.42000000001E04B8.title: "Frayed Thread Stock"
	quest.42000000001E04B9.quest_desc: [
		"Archive pages and notes.",
		"How: pack item — Codex, Knot, token, or Thread. Earlier Strand nodes name the seat."
	]
	quest.42000000001E04B9.title: "Codex Pages"
	quest.42000000001E04BA.quest_desc: [
		"Assigns quests and tracks a Clowder's progress.",
		"How: starter kit / dock chest. Right-click the book; Grave (`) is the assignment list."
	]
	quest.42000000001E04BA.title: "Whisker Codex"
	quest.42000000001F04BB.quest_desc: [
		"The paper inside a package, before it's sealed shut.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: make or find Package Component. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04BB.title: "Package Component"
	quest.42000000001F04BC.quest_desc: [
		"A package wrapper built around a stored pattern instead.",
		"How: make or find ME Package Comp. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04BC.title: "ME Package Comp"
	quest.42000000001F04BD.quest_desc: [
		"Seals items into a package for the line to move.",
		"How: make or find Packager (Packaged). JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04BD.title: "Packager (Packaged)"
	quest.42000000001F04BE.quest_desc: [
		"Adds another packaging slot to a packager.",
		"How: make or find Packager Ext. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04BE.title: "Packager Ext"
	quest.42000000001F04BF.quest_desc: [
		"Opens a package back into loose items.",
		"How: make or find Unpackager. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04BF.title: "Unpackager"
	quest.42000000001F04C0.quest_desc: [
		"Writes a crafting recipe onto a package pattern.",
		"How: make or find Encoder. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C0.title: "Encoder"
	quest.42000000001F04C1.quest_desc: [
		"Assembles a package by following its encoded recipe.",
		"How: make or find Crafter. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C1.title: "Crafter"
	quest.42000000001F04C2.quest_desc: [
		"Routes packages toward whichever address matches.",
		"How: make or find Distributor. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C2.title: "Distributor"
	quest.42000000001F04C3.quest_desc: [
		"Marks a destination a distributor can route packages to.",
		"How: make or find Distributor Marker. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C3.title: "Distributor Marker"
	quest.42000000001F04C4.quest_desc: [
		"Feeds finished packages into the line for pickup.",
		"How: make or find Packaging Provider. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C4.title: "Packaging Provider"
	quest.42000000001F04C5.quest_desc: [
		"Lets a distant crafter request through this block instead.",
		"How: make or find Crafting Proxy. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C5.title: "Crafting Proxy"
	quest.42000000001F04C6.quest_desc: [
		"Stores a batch of package recipes for reuse.",
		"How: make or find Recipe Holder. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C6.title: "Recipe Holder"
	quest.42000000001F04C7.quest_desc: [
		"Copies one block's settings onto another, saves a lot of clicking.",
		"How: make or find Settings Cloner. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C7.title: "Settings Cloner"
	quest.42000000001F04C8.quest_desc: [
		"Fills a package with fluid instead of items.",
		"How: make or find Fluid Package Filler. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C8.title: "Fluid Package Filler"
	quest.42000000001F04C9.quest_desc: [
		"A sealed bundle of items, ready to move or store.",
		"How: make or find Package Item. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04C9.title: "Package Item"
	quest.42000000001F04CA.quest_desc: [
		"Packs far more into one package than the basic kind.",
		"How: make or find Volume Package. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04CA.title: "Volume Package"
	quest.42000000001F04CB.quest_desc: [
		"Marks where a crafting proxy should reach.",
		"How: make or find Proxy Marker. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001F04CB.title: "Proxy Marker"
	quest.42000000001F04CC.quest_desc: [
		"Links the packaging line to the digital loom.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04CC.title: "AE Interface"
	quest.42000000001F04CD.quest_desc: [
		"Supplies crafting patterns to the packaging line.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04CD.title: "Pattern Provider (Packaged)"
	quest.42000000001F04CE.quest_desc: [
		"Crafts items for the digital loom's own patterns.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04CE.title: "Molecular Assembler (Packaged)"
	quest.42000000001F04CF.quest_desc: [
		"A digital loom network first, or none of this packaging runs.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04CF.title: "ME Controller"
	quest.42000000001F04D0.quest_desc: [
		"Wire power or signals.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04D0.title: "Fluix Cable (Packaged)"
	quest.42000000001F04D1.quest_desc: [
		"Packs Create-side items the mechanical way.",
		"How: Create — bench, millstone, mixer, or press. JEI, then the Clock chapter."
	]
	quest.42000000001F04D1.title: "Create Packager"
	quest.42000000001F04D2.quest_desc: [
		"Turns packages back into a labeled drawer.",
		"How: Create — bench, millstone, mixer, or press. JEI, then the Clock chapter."
	]
	quest.42000000001F04D2.title: "Create Repackager"
	quest.42000000001F04D3.quest_desc: [
		"Requests packaged items with a lever pull.",
		"How: Create — bench, millstone, mixer, or press. JEI, then the Clock chapter."
	]
	quest.42000000001F04D3.title: "Stock Ticker (Packaged)"
	quest.42000000001F04D4.quest_desc: [
		"A bulk buffer chest for packages waiting their turn.",
		"How: Create — bench, millstone, mixer, or press. JEI, then the Clock chapter."
	]
	quest.42000000001F04D4.title: "Item Vault (Packaged)"
	quest.42000000002004D5.quest_desc: [
		"A basic quantum storage disk for the QIO network.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D5.title: "QIO Drive Base"
	quest.42000000002004D6.quest_desc: [
		"Packs far more storage onto one quantum disk.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D6.title: "QIO Hyper Dense"
	quest.42000000002004D7.quest_desc: [
		"A quantum disk that trades size for raw density.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D7.title: "QIO Time Dilating"
	quest.42000000002004D8.quest_desc: [
		"The largest quantum disk Mekanism makes.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D8.title: "QIO Supermassive"
	quest.42000000002004D9.quest_desc: [
		"Holds several quantum disks in one housing.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D9.title: "QIO Drive Array"
	quest.42000000002004DA.quest_desc: [
		"Browse everything the QIO network is storing.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DA.title: "QIO Dashboard"
	quest.42000000002004DB.quest_desc: [
		"Carries the QIO dashboard in your pocket.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DB.title: "Portable QIO"
	quest.42000000002004DC.quest_desc: [
		"The basic shell for most advanced Mekanism machines.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DC.title: "Steel Casing (QIO)"
	quest.42000000002004DD.quest_desc: [
		"Stores an enormous amount of power in one block.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DD.title: "Ultimate Cube"
	quest.42000000002004DE.quest_desc: [
		"Holds a huge stack of one single item.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DE.title: "Ultimate Bin"
	quest.42000000002004DF.quest_desc: [
		"Smelts several stacks at once, as fast as Mekanism gets.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DF.title: "Ult Smelt Factory"
	quest.42000000002004E0.quest_desc: [
		"Enriches ore at the fastest speed Mekanism offers.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E0.title: "Ult Enrich Factory"
	quest.42000000002004E1.quest_desc: [
		"Crushes ore at the fastest speed Mekanism offers.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E1.title: "Ult Crush Factory"
	quest.42000000002004E2.quest_desc: [
		"Mines out a chunk automatically, straight into the void.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E2.title: "Digital Miner (QIO)"
	quest.42000000002004E3.quest_desc: [
		"A modular tool that swaps its own working head.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E3.title: "Atomic Disassembler (QIO)"
	quest.42000000002004E4.quest_desc: [
		"Rotates faces and copies settings between Mekanism machines.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E4.title: "Configurator (QIO)"
	quest.42000000002004E5.quest_desc: [
		"Jumps you instantly between two linked pads.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E5.title: "Teleporter (QIO)"
	quest.42000000002004E6.quest_desc: [
		"Frames the portal a teleporter opens.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E6.title: "Teleporter Frame"
	quest.42000000002004E7.quest_desc: [
		"Shell for the reactor that produces antimatter.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E7.title: "SPS Casing"
	quest.42000000002004E8.quest_desc: [
		"Feeds chemicals in and pulls antimatter out of the reactor.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E8.title: "SPS Port"
	quest.42000000002004E9.quest_desc: [
		"Speeds up an antimatter reactor's output.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E9.title: "Supercharged Coil"
	quest.42000000002004EA.quest_desc: [
		"Spins isotopes apart for late-game chemistry.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EA.title: "Isotopic Centrifuge"
	quest.42000000002004EB.quest_desc: [
		"Dissolves ore into a chemical slurry.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EB.title: "Chem Dissolution"
	quest.42000000002004EC.quest_desc: [
		"Washes slurry clean before it's crystallized.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EC.title: "Chem Washer"
	quest.42000000002004ED.quest_desc: [
		"Turns a chemical back into a solid crystal.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004ED.title: "Chem Crystallizer"
	quest.42000000002004EE.quest_desc: [
		"Bombards material with sunlight-driven neutrons.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EE.title: "Solar Neutron"
	quest.42000000002004EF.quest_desc: [
		"Turns power directly into heat for a boiler.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EF.title: "Resistive Heater"
	quest.42000000002004F0.quest_desc: [
		"Burns wood for heat instead of power.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F0.title: "Fuelwood Heater"
	quest.42000000002004F1.quest_desc: [
		"Late-game synthesis of otherwise impossible materials.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F1.title: "Antiprotonic"
	quest.42000000002004F2.quest_desc: [
		"One modular tool for mining, digging, and more.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F2.title: "Meka Tool"
	quest.42000000002004F3.quest_desc: [
		"Suit armor for the head, upgraded module by module.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F3.title: "Meka Helmet"
	quest.42000000002004F4.quest_desc: [
		"Suit armor for the chest, upgraded module by module.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F4.title: "Meka Body"
	quest.42000000002004F5.quest_desc: [
		"Suit armor for the legs, upgraded module by module.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F5.title: "Meka Pants"
	quest.42000000002004F6.quest_desc: [
		"Suit armor for the feet, upgraded module by module.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F6.title: "Meka Boots"
	quest.42000000002004F7.quest_desc: [
		"Shell for a steam boiler.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F7.title: "Boiler Casing"
	quest.42000000002004F8.quest_desc: [
		"Stores a large amount of power.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F8.title: "Elite Energy Cube"
	quest.42000000002004F9.quest_desc: [
		"Stores a moderate amount of power.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F9.title: "Adv Energy Cube"
	quest.42000000002004FA.quest_desc: [
		"Stores a small amount of power, good for starting out.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FA.title: "Basic Energy Cube (QIO)"
	quest.42000000002004FB.quest_desc: [
		"Infuses metal with a chemical for new alloys.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FB.title: "Metallurgic Infuser (QIO)"
	quest.42000000002004FC.quest_desc: [
		"Doubles the output of raw ore before it's smelted.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FC.title: "Enrichment Chamber (QIO)"
	quest.42000000002004FD.quest_desc: [
		"Mill or crush bulk materials.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FD.title: "Crusher (QIO)"
	quest.42000000002004FE.quest_desc: [
		"Smelts faster than a furnace, on power instead of fuel.",
