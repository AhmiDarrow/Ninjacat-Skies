	quest.420000000008016D.title: "Bookshelf"
	quest.420000000008016E.quest_desc: [
		"Heals deeply and grants a shine that fades after a minute.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
