		"The structural frame most multiblock machines are built around."
	]
	quest.C2000000000C0219.title: "Steel Casing"
	quest.C2000000000C021A.quest_desc: [
		"Links two points so stepping through skips the walk between."
	]
	quest.C2000000000C021A.title: "Teleporter"
	quest.C2000000000C021B.quest_desc: [
		"Mines a wide radius automatically and sorts the output for you."
	]
	quest.C2000000000C021B.title: "Digital Miner"
	quest.C2000000000D021C.quest_desc: [
		"A sticky base ingredient behind most of the grid's machines."
	]
	quest.C2000000000D021C.title: "Dielectric Paste"
