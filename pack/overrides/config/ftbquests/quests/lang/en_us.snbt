	quest.C2000000000F0258.quest_desc: [
		"For the day someone builds a sea. Optional."
	]
	quest.C2000000000F0258.title: "Boat"
	quest.C200000000100259.quest_desc: [
		"The Desk opens. Saplings for the pad."
	]
