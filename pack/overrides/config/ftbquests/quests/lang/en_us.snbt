{
	chapter.3100000000000001.subtitle: [
		"Wake — survive, claim the pad, let the Codex wake."
	]
	chapter.3100000000000001.title: "Strand: Soil"
	chapter.3100000000000002.subtitle: [
		"Recover — pull the fallen world back into matter."
	]
	chapter.3100000000000002.title: "Strand: Stone"
	chapter.3100000000000003.subtitle: [
		"Root — grow anchors so the pad stops fraying."
	]
	chapter.3100000000000003.title: "Strand: Sprout"
	chapter.3100000000000004.subtitle: [
		"Edge — kit up and leave the pad on purpose."
	]
	chapter.3100000000000004.title: "Strand: Claw"
	chapter.3100000000000005.subtitle: [
		"Hum — rhythm and pulse before wires."
	]
	chapter.3100000000000005.title: "Strand: Spark"
	chapter.3100000000000006.subtitle: [
		"Pattern — a factory as a song that carries itself."
	]
	chapter.3100000000000006.title: "Strand: Clock"
	chapter.3100000000000007.subtitle: [
		"Colony — keep something alive that keeps something else alive."
	]
	chapter.3100000000000007.title: "Strand: Swarm"
	chapter.3100000000000008.subtitle: [
		"Bind — seals, rites, and two braid paths in a cord."
	]
	chapter.3100000000000008.title: "Strand: Sigil"
	chapter.3100000000000009.subtitle: [
		"Reweave — the digital loom, the March, the Fragment."
	]
	chapter.3100000000000009.title: "Strand: Spindle"
	chapter.310000000000000A.title: "Deep Sieve"
	chapter.310000000000000B.title: "Storage and Packs"
	chapter.310000000000000C.title: "Mekanism Works"
	chapter.310000000000000D.title: "Powah Grid"
	chapter.310000000000000E.title: "Arcane Side"
	chapter.310000000000000F.subtitle: [
		"Teams, the Hall, the Post, and the Fray."
	]
	chapter.310000000000000F.title: "Clowder Hall"
	chapter.3100000000000010.subtitle: [
		"Spend Thread. No dependencies, no order."
	]
	chapter.3100000000000010.title: "Frayed Thread Desk"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Kitchen Line"
	chapter.3100000000000013.title: "Battle Spells"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Pad Decor"
	chapter.3100000000000016.title: "Nether Foothold"
	chapter.3100000000000017.title: "End Foothold"
	chapter.3100000000000018.title: "Essence Fields"
	chapter.3100000000000019.subtitle: [
		"Every nest is a ring of something around a flower."
	]
	chapter.3100000000000019.title: "Swarm Apiary"
	chapter.310000000000001A.title: "Pipeworks"
	chapter.310000000000001B.title: "Otherworld"
	chapter.310000000000001C.title: "Clockworks Deep"
	chapter.310000000000001D.title: "Spindle Network"
	chapter.310000000000001E.title: "Voidcraft"
	chapter.310000000000001F.title: "Packaged Lines"
	chapter.3100000000000020.title: "QIO and Mek Peak"
	chapter.3100000000000021.title: "Hunt and Farm"
	chapter.3100000000000022.title: "Tribal Weave"
	chapter.3100000000000023.subtitle: [
		"Grit-singers cut one stone a hundred ways."
	]
	chapter.3100000000000023.title: "Stonemason"
	chapter.3100000000000024.subtitle: [
		"A pad is a ledge until someone puts a chair on it."
	]
	chapter.3100000000000024.title: "Furnishings"
	chapter.3100000000000025.subtitle: [
		"The little machines the stewards left."
	]
	chapter.3100000000000025.title: "Small Stewardries"
	chapter.3100000000000026.subtitle: [
		"The Drumhearts' pulse learns to run in copper."
	]
	chapter.3100000000000026.title: "The Current"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Craft and Tension"
	chapter_group.2100000000000003.title: "Reweave"
	chapter_group.2100000000000004.title: "Side Paths"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000010001.quest_desc: [
		"You are Skybound. This is what did not fall.",
		"Eight logs. Start with the tree; it started with you."
	]
	quest.4200000000010001.title: "Wake on a Pad"
	quest.4200000000010002.quest_desc: [
		"Dirt is a promise the pad makes to your boots.",
		"Sixteen blocks. Widen the promise."
	]
	quest.4200000000010002.title: "Something to Stand On"
	quest.4200000000010003.quest_desc: [
		"Hands need a surface. Everything after this is a surface."
	]
	quest.4200000000010003.title: "Craft a Bench"
	quest.4200000000010004.quest_desc: [
		"Claw comes later. For now, wood that bites."
	]
	quest.4200000000010004.title: "Wooden Pick"
	quest.4200000000010005.quest_desc: [
		"Green against the drop.",
		"Plant it before you are hungry."
	]
	quest.4200000000010005.title: "First Sapling"
	quest.4200000000010006.quest_desc: [
		"Sixty-four planks is a pad that stops feeling like a ledge."
	]
	quest.4200000000010006.title: "Plank Stock"
	quest.4200000000010007.quest_desc: [
		"Handles, frames, the bones of tools."
	]
	quest.4200000000010007.title: "Stick Bundle"
	quest.4200000000010008.quest_desc: [
		"Put things where they stay. A Clowder shares a chest before it shares anything else."
	]
	quest.4200000000010008.title: "Chest for the Clowder"
	quest.4200000000010009.quest_desc: [
		"See the edge before the edge sees you."
	]
	quest.4200000000010009.title: "Torch Line"
	quest.420000000001000A.quest_desc: [
		"Ice and lava make stone where there was none.",
		"Normal and Hard pads ship both. The Desk sells a bucket."
	]
	quest.420000000001000A.title: "Cobble Cache"
	quest.420000000001000B.quest_desc: [
		"Warmth that is not yet Spark.",
		"The Pad-keepers would have called this a hearth."
	]
	quest.420000000001000B.title: "Furnace Heat"
	quest.420000000001000C.quest_desc: [
		"Hunger is a soft void. Eight loaves closes it for a while."
	]
	quest.420000000001000C.title: "Cook a Meal"
	quest.420000000001000D.quest_desc: [
		"Place lava, melt ice into a source, fill the bucket.",
		"Easy ships water; Normal and Hard ship the pieces."
	]
	quest.420000000001000D.title: "Catch the Rain"
	quest.420000000001000E.quest_desc: [
		"Scraps of the Loom that still hold. Every quest returns some.",
		"Unravel one for string, or spend them at the Desk."
	]
	quest.420000000001000E.title: "Frayed Currency"
	quest.420000000001000F.quest_desc: [
		"Damaged, but it still assigns work.",
		"Right-click to open. Sneak-click when you are lost."
	]
	quest.420000000001000F.title: "Codex in Hand"
	quest.4200000000010010.quest_desc: [
		"Set a spawn."
	]
	quest.4200000000010010.title: "Bed Claim"
	quest.4200000000010011.quest_desc: [
		"Climb into the depths without a rope. Cheap enough to leave in every shaft."
	]
	quest.4200000000010011.title: "Ladder Down"
	quest.4200000000010012.quest_desc: [
		"Spider silk saved for later meshes. Every strand gets used eventually."
	]
	quest.4200000000010012.title: "String Cache"
	quest.4200000000010013.quest_desc: [
		"Speed the green."
	]
	quest.4200000000010013.title: "Bone Meal Stock"
	quest.4200000000010014.quest_desc: [
		"Widen the pad."
	]
	quest.4200000000010014.title: "Dirt Platform"
	quest.4200000000010015.quest_desc: [
		"Trim them now, compost them later. Nothing on a pad goes to waste."
	]
	quest.4200000000010015.title: "Oak Leaves"
	quest.4200000000010016.quest_desc: [
		"A quiet corner."
	]
	quest.4200000000010016.title: "Flower Pot"
	quest.4200000000010017.quest_desc: [
		"Ex Deorum's barrel: compost, and water into clay the slow way."
	]
	quest.4200000000010017.title: "Barrel"
	quest.4200000000010018.quest_desc: [
		"Waste to meal."
	]
	quest.4200000000010018.title: "Composter"
	quest.4200000000010019.quest_desc: [
		"Scratch a row."
	]
	quest.4200000000010019.title: "Wooden Hoe"
	quest.420000000001001A.quest_desc: [
		"Fells logs quicker than bare hands. The first real tool a Skybound owns."
	]
	quest.420000000001001A.title: "Wooden Axe"
	quest.420000000001001B.quest_desc: [
		"Turns dirt and gravel into cleared ground. Slow, but it works."
	]
	quest.420000000001001B.title: "Wooden Shovel"
	quest.420000000001001C.quest_desc: [
		"Barely stops a zombie, but it stops one. Better than swinging a fist."
	]
	quest.420000000001001C.title: "Wooden Sword"
	quest.420000000001001D.quest_desc: [
		"Holds soup, stew, and not much else. Simple crockery for a simple pad."
	]
	quest.420000000001001D.title: "Bowl"
	quest.420000000001001E.quest_desc: [
		"Label the pad."
	]
	quest.420000000001001E.title: "Item Frame"
	quest.420000000001001F.quest_desc: [
		"Make it home."
	]
	quest.420000000001001F.title: "Painting"
	quest.4200000000010020.quest_desc: [
		"Keeps the wind and the mobs on the correct side of the wall."
	]
	quest.4200000000010020.title: "Oak Door"
	quest.4200000000010021.quest_desc: [
		"Marks an edge without blocking the view. Handy where the drop is real."
	]
	quest.4200000000010021.title: "Oak Fence"
	quest.4200000000010022.quest_desc: [
		"Turns a sheer wall into something you can actually climb."
	]
	quest.4200000000010022.title: "Oak Stairs"
	quest.4200000000010023.quest_desc: [
		"Half a block, twice the flooring options. Useful in tight spaces."
	]
	quest.4200000000010023.title: "Oak Slab"
	quest.4200000000010024.quest_desc: [
		"Trapdoor access hatches."
	]
	quest.4200000000010024.title: "Oak Trapdoor"
	quest.4200000000010025.quest_desc: [
		"Trips a signal when something steps on it. Doors open themselves."
	]
	quest.4200000000010025.title: "Oak Pressure Plate"
	quest.4200000000010026.quest_desc: [
		"Button for redstone taps."
	]
	quest.4200000000010026.title: "Oak Button"
	quest.4200000000010027.quest_desc: [
		"Fence the pad edge."
	]
	quest.4200000000010027.title: "Stick Fence Gate"
	quest.4200000000010028.quest_desc: [
		"Cooks food slowly and keeps the smoke visible for miles."
	]
	quest.4200000000010028.title: "Campfire"
	quest.4200000000010029.quest_desc: [
		"Hangs light wherever a torch would look wrong. Warmer glow, same job."
	]
	quest.4200000000010029.title: "Lantern"
	quest.420000000001002A.quest_desc: [
		"Burns pale blue and keeps most things from spawning nearby."
	]
	quest.420000000001002A.title: "Soul Lantern"
	quest.420000000001002B.quest_desc: [
		"Climbs with you and vanishes when pulled. Building high stops being scary."
	]
	quest.420000000001002B.title: "Scaffolding"
	quest.420000000001002C.quest_desc: [
		"Chain for hanging flair."
	]
	quest.420000000001002C.title: "Chain"
	quest.420000000001002D.quest_desc: [
		"Cage the edge."
	]
	quest.420000000001002D.title: "Iron Bars"
	quest.420000000001002E.quest_desc: [
		"Glass for pad windows."
	]
	quest.420000000001002E.title: "Glass Pane"
	quest.420000000001002F.quest_desc: [
		"Soft, flammable, and easy to dye. Every pad needs a bed eventually."
	]
	quest.420000000001002F.title: "White Wool"
	quest.4200000000010030.quest_desc: [
		"A thin layer of wool for floors that don't need a whole block."
	]
	quest.4200000000010030.title: "White Carpet"
	quest.4200000000010031.quest_desc: [
		"Brings a little green and pink to a pad made of grit."
	]
	quest.4200000000010031.title: "Flowering Azalea"
	quest.4200000000010032.quest_desc: [
		"Spreads slowly and softens the look of raw stone platforms."
	]
	quest.4200000000010032.title: "Moss Block"
	quest.4200000000010033.quest_desc: [
		"Hanging roots under the pad."
	]
	quest.4200000000010033.title: "Hanging Roots"
	quest.4200000000010034.quest_desc: [
		"Clings to walls and lights them without a single torch."
	]
	quest.4200000000010034.title: "Glow Lichen"
	quest.4200000000010035.quest_desc: [
		"Dripstone for pointed flair."
	]
	quest.4200000000010035.title: "Pointed Dripstone"
	quest.4200000000010036.quest_desc: [
		"Amethyst in a block. Sigil will want shards later."
	]
	quest.4200000000010036.title: "Amethyst Block"
	quest.4200000000010037.quest_desc: [
		"Nine ingots pressed together. Weathers green if you leave it outside."
	]
	quest.4200000000010037.title: "Copper Block"
	quest.4200000000010038.quest_desc: [
		"Nine chunks of raw iron stacked tight, waiting on a furnace."
	]
	quest.4200000000010038.title: "Raw Iron Block"
	quest.4200000000010039.quest_desc: [
		"Burns far longer than loose coal. Feed the furnace and walk away."
	]
	quest.4200000000010039.title: "Coal Block"
	quest.420000000001003A.quest_desc: [
		"Feeds animals and slows a fall. Farmers keep it close for both."
	]
	quest.420000000001003A.title: "Hay Block"
	quest.420000000001003B.quest_desc: [
		"Nine kelp pressed into fuel. Smelts more than it looks like it should."
	]
	quest.420000000001003B.title: "Dried Kelp Block"
	quest.420000000001003C.quest_desc: [
		"Paper and leather, waiting to become something with a recipe attached."
	]
	quest.420000000001003C.title: "Book"
	quest.420000000001003D.quest_desc: [
		"Paper for books and maps."
	]
	quest.420000000001003D.title: "Paper"
	quest.420000000001003E.quest_desc: [
		"Dye and books need ink."
	]
	quest.420000000001003E.title: "Ink Sac"
	quest.420000000001003F.quest_desc: [
		"Feathers for arrows and books."
	]
	quest.420000000001003F.title: "Feather"
	quest.4200000000010040.quest_desc: [
		"Leather for books and kits."
	]
	quest.4200000000010040.title: "Leather"
	quest.4200000000010041.quest_desc: [
		"Bench, sapling, hearth, water, Codex. The pad holds.",
		"Tension the Strand: the Pad-keepers answer, and the token is yours to seat."
	]
	quest.4200000000010041.subtitle: "Wake"
	quest.4200000000010041.title: "Soil Knot"
	quest.4200000000010042.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.4200000000010042.title: "Seat Soil"
	quest.4200000000010043.quest_desc: [
		"A zombie on a pad with no caves. The void sends its regards.",
		"Light the edges."
	]
	quest.4200000000010043.title: "Something Came Up"
	quest.4200000000020044.quest_desc: [
		"Thread that remembers where it came from.",
		"Unravel Thread to string; four string spin two yarn."
	]
	quest.4200000000020044.title: "Pull Void Yarn"
	quest.4200000000020045.quest_desc: [
		"Cobble and sticks. Break fallen grit into gravel, sand, dust."
	]
	quest.4200000000020045.title: "Spindle Hammer"
	quest.4200000000020046.quest_desc: [
		"String around yarn. It catches what the Loom dropped — and combs Loom Lint out of dirt."
	]
	quest.4200000000020046.title: "Thread the Mesh"
	quest.4200000000020047.quest_desc: [
		"Pour water; the bucket comes straight back. Add dirt. Wait for clay.",
		"String and a pearl in the same barrel make yarn."
	]
	quest.4200000000020047.title: "Tension Barrel"
	quest.4200000000020048.quest_desc: [
		"Sixteen clay from the barrel. Load eight dirt at a time."
	]
	quest.4200000000020048.title: "Clay Pocket"
	quest.4200000000020049.quest_desc: [
		"Clay and bone meal. Shape the unfired bucket."
	]
	quest.4200000000020049.title: "Porcelain Clay"
	quest.420000000002004A.quest_desc: [
		"Smelt it. Porcelain carries lava where iron is still a rumour."
	]
	quest.420000000002004A.title: "Porcelain Tool"
	quest.420000000002004B.quest_desc: [
		"Grit-singers named every shard by its echo.",
		"Sieve until you can hear the iron."
	]
	quest.420000000002004B.title: "Sift Fallen Grit"
	quest.420000000002004C.quest_desc: [
		"A spare set of hits."
	]
	quest.420000000002004C.title: "Wooden Hammer"
	quest.420000000002004D.quest_desc: [
		"Matter from grit. Sixty-four stones that were dust an hour ago."
	]
	quest.420000000002004D.title: "Pebbles"
	quest.420000000002004E.quest_desc: [
		"Loom dust waits in gravel. So does flint."
	]
	quest.420000000002004E.title: "Gravel Path"
	quest.420000000002004F.quest_desc: [
		"Fine grit. Glass later, and the iron mesh's best catch."
	]
	quest.420000000002004F.title: "Sand Cache"
	quest.4200000000020050.quest_desc: [
		"Ash of the fallen world. Redstone and gunpowder hide in it."
	]
	quest.4200000000020050.title: "Dust Pile"
	quest.4200000000020051.quest_desc: [
		"Yarn around slime. Pad compost makes the slime.",
		"The Knot is the Loom's soft gate; keep two."
	]
	quest.4200000000020051.title: "Tie Binding Knot"
	quest.4200000000020052.quest_desc: [
		"Planks around a Knot. Stretch a mesh, load grit, let it work.",
		"Hoppers feed it. This is the pad's first machine."
	]
	quest.4200000000020052.title: "Raise Loomframe"
	quest.4200000000020053.quest_desc: [
		"Iron is low and patient. Eight chunks from the mesh."
	]
	quest.4200000000020053.title: "Iron Ore Chunk"
	quest.4200000000020054.quest_desc: [
		"Sieved from gravel bit by bit. The mesh finds copper before your eyes do."
	]
	quest.4200000000020054.title: "Copper Ore Chunk"
	quest.4200000000020055.quest_desc: [
		"Gold barely bothers to answer. Four is enough."
	]
	quest.4200000000020055.title: "Gold Ore Chunk"
	quest.4200000000020056.quest_desc: [
		"Fuel the line."
	]
	quest.4200000000020056.title: "Coal"
	quest.4200000000020057.quest_desc: [
		"Chunks to raw. Smelt onward."
	]
	quest.4200000000020057.title: "Raw Iron"
	quest.4200000000020058.quest_desc: [
		"Recover pays out. Sixteen bars the void did not want you to have."
	]
	quest.4200000000020058.title: "Iron Ingot"
	quest.4200000000020059.quest_desc: [
		"Wire and bulbs, and Tribal resonators later."
	]
	quest.4200000000020059.title: "Copper Ingot"
	quest.420000000002005A.quest_desc: [
		"Gilded tools, and gold plates for the pattern-weavers."
	]
	quest.420000000002005A.title: "Gold Ingot"
	quest.420000000002005B.quest_desc: [
		"Sharper catch. Flint meshes shake Frayed Thread out of grit."
	]
	quest.420000000002005B.title: "Flint Mesh"
	quest.420000000002005C.quest_desc: [
		"Metal thread for heavier dust. Iron meshes are where Strand Filament falls."
	]
	quest.420000000002005C.title: "Iron Mesh"
	quest.420000000002005D.quest_desc: [
		"Melt and drip. Cobble to lava, given time."
	]
	quest.420000000002005D.title: "Crucible"
	quest.420000000002005E.quest_desc: [
		"Ex Deorum's barrel: compost, and water into clay the slow way."
	]
	quest.420000000002005E.title: "Barrel (Stone)"
	quest.420000000002005F.quest_desc: [
		"Harder hits, longer life."
	]
	quest.420000000002005F.title: "Stone Hammer"
	quest.4200000000020060.quest_desc: [
		"Crushes ore into gravel and grit, the noisy trick behind the sieve."
	]
	quest.4200000000020060.title: "Iron Hammer"
	quest.4200000000020061.quest_desc: [
		"Wider mesh, nine at a time."
	]
	quest.4200000000020061.title: "Compressed Sieve"
	quest.4200000000020062.quest_desc: [
		"See through. Sand to glass."
	]
	quest.4200000000020062.title: "Glass"
	quest.4200000000020063.quest_desc: [
		"Carry the rain in iron now."
	]
	quest.4200000000020063.title: "Bucket"
	quest.4200000000020064.quest_desc: [
		"Heat from the void, in hand."
	]
	quest.4200000000020064.title: "Lava Bucket"
	quest.4200000000020065.quest_desc: [
		"Portal thoughts. Water on lava source."
	]
	quest.4200000000020065.title: "Obsidian"
	quest.4200000000020066.quest_desc: [
		"Rare grit luck. Two is a start."
	]
	quest.4200000000020066.title: "Diamond"
	quest.4200000000020067.quest_desc: [
		"Mesh upgrade fuel."
	]
	quest.4200000000020067.title: "Flint"
	quest.4200000000020068.quest_desc: [
		"Made from grit and dust, not looted from a creeper. Handle it carefully."
	]
	quest.4200000000020068.title: "Gunpowder"
	quest.4200000000020069.quest_desc: [
		"Spark will want this. Keep it dry."
	]
	quest.4200000000020069.title: "Redstone"
	quest.420000000002006A.quest_desc: [
		"Feeds the enchanting table. Blue dust that makes gear listen better."
	]
	quest.420000000002006A.title: "Lapis"
	quest.420000000002006B.quest_desc: [
		"A common stone blend, useful mostly for building and for mixing recipes later."
	]
	quest.420000000002006B.title: "Andesite"
	quest.420000000002006C.quest_desc: [
		"Speckled stone, decorative more than structural. Grit-singers called it the loud one."
	]
	quest.420000000002006C.title: "Diorite"
	quest.420000000002006D.quest_desc: [
		"Dense and pink-flecked, good for a floor that wants to stand out."
	]
	quest.420000000002006D.title: "Granite"
	quest.420000000002006E.quest_desc: [
		"Porous rock from the other place. Burns forever once it catches."
	]
	quest.420000000002006E.title: "Netherrack"
	quest.420000000002006F.quest_desc: [
		"Slows every step that crosses it and feeds soul fire a colder blue."
	]
	quest.420000000002006F.title: "Soul Sand"
	quest.4200000000020070.quest_desc: [
		"Ground from Nether glowstone, useful for brewing and for softer light sources."
	]
	quest.4200000000020070.title: "Glowstone Dust"
	quest.4200000000020071.quest_desc: [
		"Strips leaves off a tree without swinging an axe at the trunk."
	]
	quest.4200000000020071.title: "Crook"
	quest.4200000000020072.quest_desc: [
		"Pulled from the sieve in growing piles. Never quite enough for every mesh."
	]
	quest.4200000000020072.title: "String"
	quest.4200000000020073.quest_desc: [
		"Knot binder — or pad compost recipe."
	]
	quest.4200000000020073.title: "Slimeball"
	quest.4200000000020074.quest_desc: [
		"Ground down for meal, or kept whole to breed the pack's next wolf."
	]
	quest.4200000000020074.title: "Bone"
	quest.4200000000020075.quest_desc: [
		"Bitter and faintly toxic. Brewers use it, nobody eats it plain."
	]
	quest.4200000000020075.title: "Spider Eye"
	quest.4200000000020076.quest_desc: [
		"Yarn, porcelain, a Loomframe working, iron in the chest.",
		"Tension the Strand: the Grit-singers answer."
	]
	quest.4200000000020076.subtitle: "Recover"
	quest.4200000000020076.title: "Stone Knot"
	quest.4200000000020077.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.4200000000020077.title: "Seat Stone"
	quest.4200000000020078.quest_desc: [
		"A creeper, dealt with. Gunpowder is worth more than the fright."
	]
	quest.4200000000020078.title: "Boom, Later"
	quest.4200000000030079.quest_desc: [
		"Scratch rows into the pad."
	]
	quest.4200000000030079.title: "Iron Hoe"
	quest.420000000003007A.quest_desc: [
		"Bread is infrastructure. Thirty-two wheat is a field, not a patch."
	]
	quest.420000000003007A.title: "Wheat Field"
	quest.420000000003007B.quest_desc: [
		"Plant what you eat."
	]
	quest.420000000003007B.title: "Seed Pouch"
	quest.420000000003007C.quest_desc: [
		"Speed is kindness. Compost and bones."
	]
	quest.420000000003007C.title: "Bone Meal Engine"
	quest.420000000003007D.quest_desc: [
		"Prep the harvest."
	]
	quest.420000000003007D.title: "Farmers Knife"
	quest.420000000003007E.quest_desc: [
		"A kitchen starts here."
	]
	quest.420000000003007E.title: "Cutting Board"
	quest.420000000003007F.quest_desc: [
		"Warm meals feed more than hunger."
	]
	quest.420000000003007F.title: "Cooking Pot"
	quest.4200000000030080.quest_desc: [
		"Grows in tidy heads, better cooked into something than eaten raw."
	]
	quest.4200000000030080.title: "Cabbage"
	quest.4200000000030081.quest_desc: [
		"Climbs its own trellis and ripens red. Sauce starts here."
	]
	quest.4200000000030081.title: "Tomato"
	quest.4200000000030082.quest_desc: [
		"Tears of joy."
	]
	quest.4200000000030082.title: "Onion"
	quest.4200000000030083.quest_desc: [
		"Essence farming begins. Sixteen from the first row."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"The seed backbone. Sieve or grow it."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Raise seeds from essence."
	]
	quest.4200000000030085.title: "Infusion Altar"
	quest.4200000000030086.quest_desc: [
		"Four around the altar."
	]
	quest.4200000000030086.title: "Infusion Pedestal"
	quest.4200000000030087.quest_desc: [
		"Grow more pad."
	]
	quest.4200000000030087.title: "Dirt Seeds"
	quest.4200000000030088.quest_desc: [
		"Grow canopy without the axe."
	]
	quest.4200000000030088.title: "Wood Seeds"
	quest.4200000000030089.quest_desc: [
		"Grown, not mined. Harvest essence instead of swinging a pickaxe."
	]
	quest.4200000000030089.title: "Stone Seeds"
	quest.420000000003008A.quest_desc: [
		"Metal from leaves. Recover's second engine."
	]
	quest.420000000003008A.title: "Iron Seeds"
	quest.420000000003008B.quest_desc: [
		"A crop that yields copper essence instead of copper ore."
	]
	quest.420000000003008B.title: "Copper Seeds"
	quest.420000000003008C.quest_desc: [
		"Gilded leaves that grow gold essence right on the pad."
	]
	quest.420000000003008C.title: "Gold Seeds"
	quest.420000000003008D.quest_desc: [
		"Turns a farm plot into a fuel source, no mining required."
	]
	quest.420000000003008D.title: "Coal Seeds"
	quest.420000000003008E.quest_desc: [
		"Bottled rain from a crop."
	]
	quest.420000000003008E.title: "Water Seeds"
	quest.420000000003008F.quest_desc: [
		"Compact growth for a small pad."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"The pot that harvests itself."
	]
	quest.4200000000030090.title: "Hopper Pot"
	quest.4200000000030091.quest_desc: [
		"Tier up. The seeds get greedier and better."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"A deeper grade of crop essence, stronger than the seeds you started with."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Nine meal to a block. Storage for the engine."
	]
	quest.4200000000030093.title: "Bone Block"
	quest.4200000000030094.quest_desc: [
		"Sprout surplus, stacked."
	]
	quest.4200000000030094.title: "Hay Silo"
	quest.4200000000030095.quest_desc: [
		"Better farmland. Rootbinders would approve."
	]
	quest.4200000000030095.title: "Rich Soil"
	quest.4200000000030096.quest_desc: [
		"Feed the soil that feeds you."
	]
	quest.4200000000030096.title: "Organic Compost"
	quest.4200000000030097.quest_desc: [
		"Plant a row, feed a horse, or just eat it raw."
	]
	quest.4200000000030097.title: "Carrot"
	quest.4200000000030098.quest_desc: [
		"Potato staple crop."
	]
	quest.4200000000030098.title: "Potato"
	quest.4200000000030099.quest_desc: [
		"Grows fast and dyes red. Soup, stew, or straight from the ground."
	]
	quest.4200000000030099.title: "Beetroot"
	quest.420000000003009A.quest_desc: [
		"Melon for food and trades."
	]
	quest.420000000003009A.title: "Melon"
	quest.420000000003009B.quest_desc: [
		"Pumpkin for food and decor."
	]
	quest.420000000003009B.title: "Pumpkin"
	quest.420000000003009C.quest_desc: [
		"Paper and sugar."
	]
	quest.420000000003009C.title: "Sugar Cane"
	quest.420000000003009D.quest_desc: [
		"Grows without water and hurts anything that leans on it."
	]
	quest.420000000003009D.title: "Cactus"
	quest.420000000003009E.quest_desc: [
		"Shoots up fast and burns hot. Handy fuel for a pad short on trees."
	]
	quest.420000000003009E.title: "Bamboo"
	quest.420000000003009F.quest_desc: [
		"Berries while you build."
	]
	quest.420000000003009F.title: "Sweet Berries"
	quest.42000000000300A0.quest_desc: [
		"Grown on jungle logs, ground into the brown that flavors everything sweet."
	]
	quest.42000000000300A0.title: "Cocoa"
	quest.42000000000300A1.quest_desc: [
		"Falls from oak leaves on its own time. Free food, eventually."
	]
	quest.42000000000300A1.title: "Apple"
	quest.42000000000300A2.quest_desc: [
		"One bowl, no crafting table. The lazy farmer's dinner."
	]
	quest.42000000000300A2.title: "Mushroom Stew"
	quest.42000000000300A3.quest_desc: [
		"A taste of the hive before the deeper work with bees begins."
	]
	quest.42000000000300A3.title: "Honey Bottle"
	quest.42000000000300A4.quest_desc: [
		"Grow on cave vines and light the tunnel while you eat them."
	]
	quest.42000000000300A4.title: "Glow Berries"
	quest.42000000000300A5.quest_desc: [
		"The base of every potion worth bottling. Grows only on soul sand."
	]
	quest.42000000000300A5.title: "Nether Wart"
	quest.42000000000300A6.quest_desc: [
		"A field, a kitchen, essence rising.",
		"Tension the Strand: the Rootbinders answer."
	]
	quest.42000000000300A6.subtitle: "Root"
	quest.42000000000300A6.title: "Sprout Knot"
	quest.42000000000300A7.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.42000000000300A7.title: "Seat Sprout"
	quest.42000000000300A8.quest_desc: [
		"Every Rootbinder pulls one eventually.",
		"Do not eat it. Do not throw it away either."
	]
	quest.42000000000300A8.title: "Wrong Potato"
	quest.42000000000400A9.quest_desc: [
		"Cut the void on your terms. Eight sheets of plans."
	]
	quest.42000000000400A9.title: "Blueprint Paper"
	quest.42000000000400AA.quest_desc: [
		"Plans in a box."
	]
	quest.42000000000400AA.title: "Blueprint Package"
	quest.42000000000400AB.quest_desc: [
		"The template a modular tool starts from before you add its parts."
	]
	quest.42000000000400AB.title: "Rod Blueprint"
	quest.42000000000400AC.quest_desc: [
		"Shape a pick that outlives its metal."
	]
	quest.42000000000400AC.title: "Pick Blueprint"
	quest.42000000000400AD.quest_desc: [
		"Shape an axe."
	]
	quest.42000000000400AD.title: "Axe Blueprint"
	quest.42000000000400AE.quest_desc: [
		"Shape a shovel."
	]
	quest.42000000000400AE.title: "Shovel Blueprint"
	quest.42000000000400AF.quest_desc: [
		"Shape a blade."
	]
	quest.42000000000400AF.title: "Sword Blueprint"
	quest.42000000000400B0.quest_desc: [
		"Room to grow."
	]
	quest.42000000000400B0.title: "Upgrade Base"
	quest.42000000000400B1.quest_desc: [
		"Thirty-two bars of material for parts."
	]
	quest.42000000000400B1.title: "Iron Mass"
	quest.42000000000400B2.quest_desc: [
		"Sharpens a blade's edge past what iron alone can manage."
	]
	quest.42000000000400B2.title: "Diamond Tip"
	quest.42000000000400B3.quest_desc: [
		"Leaves and wool, and combs later."
	]
	quest.42000000000400B3.title: "Shears"
	quest.42000000000400B4.quest_desc: [
		"Pads have edges. So do mobs."
	]
	quest.42000000000400B4.title: "Shield"
	quest.42000000000400B5.quest_desc: [
		"Survive the night on purpose."
	]
	quest.42000000000400B5.title: "Iron Chestplate"
	quest.42000000000400B6.quest_desc: [
		"Mind the drop."
	]
	quest.42000000000400B6.title: "Iron Helmet"
	quest.42000000000400B7.quest_desc: [
		"Covers the legs first. Most damage comes from below anyway."
	]
	quest.42000000000400B7.title: "Iron Leggings"
	quest.42000000000400B8.quest_desc: [
		"Steadies your footing on ledges where a slip means the void."
	]
	quest.42000000000400B8.title: "Iron Boots"
	quest.42000000000400B9.quest_desc: [
		"Keep the void's mobs at a distance."
	]
	quest.42000000000400B9.title: "Bow"
	quest.42000000000400BA.quest_desc: [
		"Sixty-four reasons to keep distance."
	]
	quest.42000000000400BA.title: "Arrow Bundle"
	quest.42000000000400BB.quest_desc: [
		"Light the way through."
	]
	quest.42000000000400BB.title: "Flint and Steel"
	quest.42000000000400BC.quest_desc: [
		"Ten blocks. A door the Edge-walkers would recognise."
	]
	quest.42000000000400BC.title: "Obsidian Frame"
	quest.42000000000400BD.quest_desc: [
		"Foothold prep. Somewhere else exists."
	]
	quest.42000000000400BD.title: "Ender Eye"
	quest.42000000000400BE.quest_desc: [
		"Soft power for hard tools."
	]
	quest.42000000000400BE.title: "Enchanting Table"
	quest.42000000000400BF.quest_desc: [
		"Repair and name what you carry."
	]
	quest.42000000000400BF.title: "Anvil"
	quest.42000000000400C0.quest_desc: [
		"Call it yours."
	]
	quest.42000000000400C0.title: "Name Tag"
	quest.42000000000400C1.quest_desc: [
		"The starting template for a modular hoe, built part by part."
	]
	quest.42000000000400C1.title: "Hoe Blueprint"
	quest.42000000000400C2.quest_desc: [
		"Clears a wide swath of crops in one swing instead of one plant."
	]
	quest.42000000000400C2.title: "Sickle Blueprint"
	quest.42000000000400C3.quest_desc: [
		"One tool that mines, chops, and digs. No more swapping in your hand."
	]
	quest.42000000000400C3.title: "Paxel Blueprint"
	quest.42000000000400C4.quest_desc: [
		"Breaks a three by three block of stone in a single hit."
	]
	quest.42000000000400C4.title: "Hammer Blueprint"
	quest.42000000000400C5.quest_desc: [
		"Clears wide holes in dirt and sand faster than any shovel."
	]
	quest.42000000000400C5.title: "Excavator Blueprint"
	quest.42000000000400C6.quest_desc: [
		"Small, fast, and precise. Built for close work, not for war."
	]
	quest.42000000000400C6.title: "Knife Blueprint"
	quest.42000000000400C7.quest_desc: [
		"Soft plating, easily enchanted, worth more for its magic than its defense."
	]
	quest.42000000000400C7.title: "Gold Armor Bits"
	quest.42000000000400C8.quest_desc: [
		"Sea claw.",
		"Optional — the void may never offer one."
	]
	quest.42000000000400C8.title: "Trident"
	quest.42000000000400C9.quest_desc: [
		"Loads slow, hits hard, and holds its charge until you need it."
	]
	quest.42000000000400C9.title: "Crossbow"
	quest.42000000000400CA.quest_desc: [
		"Scan the void."
	]
	quest.42000000000400CA.title: "Spyglass"
	quest.42000000000400CB.quest_desc: [
		"Plans, iron on your back, a door out.",
		"Tension the Strand: the Edge-walkers answer. The braid opens."
	]
	quest.42000000000400CB.subtitle: "Edge"
	quest.42000000000400CB.title: "Claw Knot"
	quest.42000000000400CC.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.42000000000400CC.title: "Seat Claw"
	quest.42000000000400CD.quest_desc: [
		"Something tall looked back. Edge-walkers called them door-wardens."
	]
	quest.42000000000400CD.title: "Edge of the Edge"
	quest.42000000000500CE.quest_desc: [
		"A brief signal before the Hum. Sixty-four dust."
	]
	quest.42000000000500CE.title: "Redstone Dust"
	quest.42000000000500CF.quest_desc: [
		"Parallel heat. Eight is a line, not a furnace."
	]
	quest.42000000000500CF.title: "Furnace Array"
	quest.42000000000500D0.quest_desc: [
		"Move the grit without hands."
	]
	quest.42000000000500D0.title: "Hopper Line"
	quest.42000000000500D1.quest_desc: [
		"Measure the beat."
	]
	quest.42000000000500D1.title: "Comparator"
	quest.42000000000500D2.quest_desc: [
		"Bone, string, amethyst. The first beat.",
		"It yields two — keep one for the Spirit Codex."
	]
	quest.42000000000500D2.title: "Hum: Bone Chime"
	quest.42000000000500D3.quest_desc: [
		"A shard of old tribe song. Needs a Chime."
	]
	quest.42000000000500D3.title: "Hum: Spirit Shard"
	quest.42000000000500D4.quest_desc: [
		"Copper around a Chime: metal tuned to spirit."
	]
	quest.42000000000500D4.title: "Hum: Copper Resonator"
	quest.42000000000500D5.quest_desc: [
		"Strike it. Hold a Pulse. Listen before you wire anything.",
		"Chime, Shard, leather — the Desk sells leather."
	]
	quest.42000000000500D5.title: "Hum: Drumheart"
	quest.42000000000500D6.quest_desc: [
		"Carry Pulse between drum and lattice."
	]
	quest.42000000000500D6.title: "Hum: Pulse Cell"
	quest.42000000000500D7.quest_desc: [
		"Draw ambient ley into beats near a Drumheart."
	]
	quest.42000000000500D7.title: "Hum: Ley Collector"
	quest.42000000000500D8.quest_desc: [
		"Seat a reusable Echo catalyst and two different elemental totems. The camp sings its own power; redstone pauses the harmony."
	]
	quest.42000000000500D8.title: "Hum: Pulse Resonator"
	quest.42000000000500D9.quest_desc: [
		"A buffer for Forge Energy — the bridge from Pulse to wire, if you want one."
	]
	quest.42000000000500D9.title: "Powah Starter Cell"
	quest.42000000000500DA.quest_desc: [
		"Burn fuel for Forge Energy."
	]
	quest.42000000000500DA.title: "Powah Furnator"
	quest.42000000000500DB.quest_desc: [
		"Move energy along."
	]
	quest.42000000000500DB.title: "Powah Cable"
	quest.42000000000500DC.quest_desc: [
		"Sky power, on a pad that is all sky."
	]
	quest.42000000000500DC.title: "Solar Panel Starter"
	quest.42000000000500DD.quest_desc: [
		"Burns a heat difference into power. Feed it hot on one side, cold on the other."
	]
	quest.42000000000500DD.title: "Thermo Generator"
	quest.42000000000500DE.quest_desc: [
		"Charge items in a ring of rods."
	]
	quest.42000000000500DE.title: "Energizing Orb"
	quest.42000000000500DF.quest_desc: [
		"Feed the orb."
	]
	quest.42000000000500DF.title: "Energizing Rod"
	quest.42000000000500E0.quest_desc: [
		"A pocketful of stored power."
	]
	quest.42000000000500E0.title: "Battery"
	quest.42000000000500E1.quest_desc: [
		"Rotates machines in place instead of breaking and replacing them."
	]
	quest.42000000000500E1.title: "Wrench"
	quest.42000000000500E2.quest_desc: [
		"Smelts ore twice as fast as a regular furnace, ore only."
	]
	quest.42000000000500E2.title: "Blast Furnace"
	quest.42000000000500E3.quest_desc: [
		"Cooks meat twice as fast as a campfire, food only."
	]
	quest.42000000000500E3.title: "Smoker"
	quest.42000000000500E4.quest_desc: [
		"Nine coal pressed dense. One block outlasts a whole stack of lumps."
	]
	quest.42000000000500E4.title: "Coal Block (Spark)"
	quest.42000000000500E5.quest_desc: [
		"Nudges one item at a time into whatever sits in front of it."
	]
	quest.42000000000500E5.title: "Dropper"
	quest.42000000000500E6.quest_desc: [
		"Push with purpose."
	]
	quest.42000000000500E6.title: "Dispenser"
	quest.42000000000500E7.quest_desc: [
		"Pushes a block forward on a signal, then waits for the next one."
	]
	quest.42000000000500E7.title: "Piston"
	quest.42000000000500E8.quest_desc: [
		"Pushes a block out and pulls it back when the signal drops."
	]
	quest.42000000000500E8.title: "Sticky Piston"
	quest.42000000000500E9.quest_desc: [
		"Observer reads the beat."
	]
	quest.42000000000500E9.title: "Observer"
	quest.42000000000500EA.quest_desc: [
		"Repeater times the circuit."
	]
	quest.42000000000500EA.title: "Repeater"
	quest.42000000000500EB.quest_desc: [
		"Registers a hit with signal strength based on how close to center."
	]
	quest.42000000000500EB.title: "Target"
	quest.42000000000500EC.quest_desc: [
		"Draws a strike away from your roof and grounds the charge."
	]
	quest.42000000000500EC.title: "Lightning Rod"
	quest.42000000000500ED.quest_desc: [
		"Time for power."
	]
	quest.42000000000500ED.title: "Clock"
	quest.42000000000500EE.quest_desc: [
		"Light without torches."
	]
	quest.42000000000500EE.title: "Copper Bulb"
	quest.42000000000500EF.quest_desc: [
		"Lights up on a signal and goes dark the moment it stops."
	]
	quest.42000000000500EF.title: "Redstone Lamp"
	quest.42000000000500F0.quest_desc: [
		"Reads the sky and sends a signal that rises and falls with the sun."
	]
	quest.42000000000500F0.title: "Daylight Detector"
	quest.42000000000500F1.quest_desc: [
		"Flips a signal on or off by hand. The oldest switch there is."
	]
	quest.42000000000500F1.title: "Lever"
	quest.42000000000500F2.quest_desc: [
		"Button taps a redstone pulse."
	]
	quest.42000000000500F2.title: "Button"
	quest.42000000000500F3.quest_desc: [
		"Sends a signal when something heavier than air stands on it."
	]
	quest.42000000000500F3.title: "Pressure Plate"
	quest.42000000000500F4.quest_desc: [
		"Strung with string across a path, it catches anything that crosses."
	]
	quest.42000000000500F4.title: "Tripwire Hook"
	quest.42000000000500F5.quest_desc: [
		"Plays one note per block type beneath it. Drumhearts hear a song in a row of them."
	]
	quest.42000000000500F5.title: "Note Block"
	quest.42000000000500F6.quest_desc: [
		"Jukebox for pad morale."
	]
	quest.42000000000500F6.title: "Jukebox"
	quest.42000000000500F7.quest_desc: [
		"Rolls along track under gravity or a push. No rails, no ride."
	]
	quest.42000000000500F7.title: "Minecart"
	quest.42000000000500F8.quest_desc: [
		"Rails across the void span."
	]
	quest.42000000000500F8.title: "Rail"
	quest.42000000000500F9.quest_desc: [
		"Powered rail for carts."
	]
	quest.42000000000500F9.title: "Powered Rail"
	quest.42000000000500FA.quest_desc: [
		"Reads a passing cart and fires a signal as it rolls over."
	]
	quest.42000000000500FA.title: "Detector Rail"
	quest.42000000000500FB.quest_desc: [
		"Alt solar craft."
	]
	quest.42000000000500FB.title: "Solar Flux Cell"
	quest.42000000000500FC.quest_desc: [
		"Simple item pipes."
	]
	quest.42000000000500FC.title: "Pipez Item"
	quest.42000000000500FD.quest_desc: [
		"Simple fluid pipes."
	]
	quest.42000000000500FD.title: "Pipez Fluid"
	quest.42000000000500FE.quest_desc: [
		"Plain energy pipes between machines."
	]
	quest.42000000000500FE.title: "Pipez Energy"
	quest.42000000000500FF.quest_desc: [
		"Sets a pipe's filter and direction without breaking it off the wall."
	]
	quest.42000000000500FF.title: "Pipez Wrench"
	quest.4200000000050100.quest_desc: [
		"Mark lattice lines — needs a Spirit Shard."
	]
	quest.4200000000050100.title: "Ritual Chalk"
	quest.4200000000050101.quest_desc: [
		"A drum struck, a Pulse held, a resonator burning.",
		"Tension the Strand: the Drumhearts answer."
	]
	quest.4200000000050101.subtitle: "Hum"
	quest.4200000000050101.title: "Spark Knot"
	quest.4200000000050102.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.4200000000050102.title: "Seat Spark"
	quest.4200000000050103.quest_desc: [
		"Follow Tribal Weave through Echo refinement to a Resonant Core. The Pulse Adapter turns the camp's reusable harmony into FE for this chapter's machines. Redstone pauses both conversion and export."
	]
	quest.4200000000050103.title: "Hum becomes current"
	quest.4200000000050104.quest_desc: [
		"A witch, on your pad, at night. The drums did not warn you."
	]
	quest.4200000000050104.title: "Bottled Trouble"
	quest.4200000000060105.quest_desc: [
		"Hands that work while you sleep. Thirty-two."
	]
	quest.4200000000060105.title: "Andesite Alloy"
	quest.4200000000060106.quest_desc: [
		"The rotation spine."
	]
	quest.4200000000060106.title: "Shaft"
	quest.4200000000060107.quest_desc: [
		"One cog. Then the same cog again."
	]
	quest.4200000000060107.title: "Cogwheel"
	quest.4200000000060108.quest_desc: [
		"More teeth, slower turn."
	]
	quest.4200000000060108.title: "Large Cog"
	quest.4200000000060109.quest_desc: [
		"Andesite casing frames Create."
	]
	quest.4200000000060109.title: "Andesite Casing"
	quest.420000000006010A.quest_desc: [
		"A river in the sky, turning."
	]
	quest.420000000006010A.title: "Water Wheel"
	quest.420000000006010B.quest_desc: [
		"Turns rotation by hand when nothing else is spinning yet."
	]
	quest.420000000006010B.title: "Hand Crank"
	quest.420000000006010C.quest_desc: [
		"Mill grit into dust without a hammer."
	]
	quest.420000000006010C.title: "Millstone"
	quest.420000000006010D.quest_desc: [
		"Basin holds Create mixing."
	]
	quest.420000000006010D.title: "Basin"
	quest.420000000006010E.quest_desc: [
		"Plates and paths."
	]
	quest.420000000006010E.title: "Mechanical Press"
	quest.420000000006010F.quest_desc: [
		"Bulk recipes, fast."
	]
	quest.420000000006010F.title: "Mechanical Mixer"
	quest.4200000000060110.quest_desc: [
		"A flat surface that holds an item still for the belt or press."
	]
	quest.4200000000060110.title: "Depot"
	quest.4200000000060111.quest_desc: [
		"Belts move items along shafts."
	]
	quest.4200000000060111.title: "Belt Connector"
	quest.4200000000060112.quest_desc: [
		"Drops items straight down between machines, no belt required."
	]
	quest.4200000000060112.title: "Chute"
	quest.4200000000060113.quest_desc: [
		"Washing, drying, and gravel into sand."
	]
	quest.4200000000060113.title: "Encased Fan"
	quest.4200000000060114.quest_desc: [
		"A hand on a shaft."
	]
	quest.4200000000060114.title: "Deployer"
	quest.4200000000060115.quest_desc: [
		"Cuts logs to planks or trees to lumber, given enough rotation."
	]
	quest.4200000000060115.title: "Mechanical Saw"
	quest.4200000000060116.quest_desc: [
		"Drill through grit blocks."
	]
	quest.4200000000060116.title: "Mechanical Drill"
	quest.4200000000060117.quest_desc: [
		"Cut crops in a spinning arc."
	]
	quest.4200000000060117.title: "Mechanical Harvester"
	quest.4200000000060118.quest_desc: [
		"Loads or empties a stopped train's cargo without you lifting a single chest."
	]
	quest.4200000000060118.title: "Portable Storage Interface"
	quest.4200000000060119.quest_desc: [
		"Stacks nine chests worth of storage into one large block."
	]
	quest.4200000000060119.title: "Item Vault"
	quest.420000000006011A.quest_desc: [
		"Holds liquid in bulk and links with its neighbors to hold more."
	]
	quest.420000000006011A.title: "Fluid Tank"
	quest.420000000006011B.quest_desc: [
		"Spout fluids into basins."
	]
	quest.420000000006011B.title: "Spout"
	quest.420000000006011C.quest_desc: [
		"Pump fluids from a source."
	]
	quest.420000000006011C.title: "Hose Pulley"
	quest.420000000006011D.quest_desc: [
		"Marks the fluid-handling side of a build, andesite's fancier cousin."
	]
	quest.420000000006011D.title: "Copper Casing"
	quest.420000000006011E.quest_desc: [
		"Covers the precise machines, the ones rotation alone can't satisfy."
	]
	quest.420000000006011E.title: "Brass Casing"
	quest.420000000006011F.quest_desc: [
		"Clockwork heart. Wants a Binding Knot at its centre.",
		"The Loom, asking to be included."
	]
	quest.420000000006011F.title: "Precision Mechanism"
	quest.4200000000060120.quest_desc: [
		"Control rotation speed."
	]
	quest.4200000000060120.title: "Rotation Speed Controller"
	quest.4200000000060121.quest_desc: [
		"Turn the corner."
	]
	quest.4200000000060121.title: "Gearbox"
	quest.4200000000060122.quest_desc: [
		"Clutch stops a shaft line."
	]
	quest.4200000000060122.title: "Clutch"
	quest.4200000000060123.quest_desc: [
		"Gearshift flips rotation."
	]
	quest.4200000000060123.title: "Gearshift"
	quest.4200000000060124.quest_desc: [
		"Programmed spin. The pattern-weavers' song, written down."
	]
	quest.4200000000060124.title: "Sequenced Gearshift"
	quest.4200000000060125.quest_desc: [
		"Mixes ingredients in a basin when spun fast enough."
	]
	quest.4200000000060125.title: "Whisk"
	quest.4200000000060126.quest_desc: [
		"Spins on a shaft and pushes air, or a boat, depending where it's mounted."
	]
	quest.4200000000060126.title: "Propeller"
	quest.4200000000060127.quest_desc: [
		"Catches wind on a windmill and dyes easily if you want a pattern."
	]
	quest.4200000000060127.title: "White Sail"
	quest.4200000000060128.quest_desc: [
		"Turns a ring of sails into rotation pulled straight from the sky."
	]
	quest.4200000000060128.title: "Windmill Bearing"
	quest.4200000000060129.quest_desc: [
		"Spins an entire structure around a fixed point, walls and all."
	]
	quest.4200000000060129.title: "Mechanical Bearing"
	quest.420000000006012A.quest_desc: [
		"Gantry slides along a rail."
	]
	quest.420000000006012A.title: "Gantry Carriage"
	quest.420000000006012B.quest_desc: [
		"Turns a stationary build into one that rides the rails."
	]
	quest.420000000006012B.title: "Cart Assembler"
	quest.420000000006012C.quest_desc: [
		"Links two carts so they travel as a single train."
	]
	quest.420000000006012C.title: "Minecart Coupling"
	quest.420000000006012D.quest_desc: [
		"Lays the path a cart or contraption travels along."
	]
	quest.420000000006012D.title: "Track"
	quest.420000000006012E.quest_desc: [
		"Train door for carriages."
	]
	quest.420000000006012E.title: "Train Door"
	quest.420000000006012F.quest_desc: [
		"Schedule train routes."
	]
	quest.420000000006012F.title: "Schedule"
	quest.4200000000060130.quest_desc: [
		"Shows a number from elsewhere on a block you can actually see."
	]
	quest.4200000000060130.title: "Display Link"
	quest.4200000000060131.quest_desc: [
		"Display board shows data."
	]
	quest.4200000000060131.title: "Display Board"
	quest.4200000000060132.quest_desc: [
		"Fires a potato hard enough to knock something back. Mostly for laughs."
	]
	quest.4200000000060132.title: "Potato Cannon"
	quest.4200000000060133.quest_desc: [
		"Reaches and breaks blocks from further away than your arm allows."
	]
	quest.4200000000060133.title: "Extendo Grip"
	quest.4200000000060134.quest_desc: [
		"A wheel, a press, a mixer, a fan, a clockwork heart.",
		"Tension the Strand: the Pattern-weavers answer."
	]
	quest.4200000000060134.subtitle: "Pattern"
	quest.4200000000060134.title: "Clock Knot"
	quest.4200000000060135.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign."
	]
	quest.4200000000060135.title: "Seat Clock"
	quest.4200000000060136.quest_desc: [
		"Twenty skeletons. The pattern holds if you keep the lights on."
	]
	quest.4200000000060136.title: "Rattle in the Gears"
	quest.4200000000070137.quest_desc: [
		"Place the oak nest on the pad and wait. Something with wings will come out of the wood.",
		"Look at it. That counts."
	]
	quest.4200000000070137.subtitle: "Colony"
	quest.4200000000070137.title: "First Wings"
	quest.4200000000070138.quest_desc: [
		"Eight oak logs around a small flower. Place it; the wood remembers wings."
	]
	quest.4200000000070138.title: "Ring of Oak"
	quest.4200000000070139.quest_desc: [
		"Bone meal on grass. Bees will not stay where nothing blooms."
	]
	quest.4200000000070139.title: "A Flower to Argue Over"
	quest.420000000007013A.quest_desc: [
		"Planks and flowers — a home a wild bee will move into."
	]
	quest.420000000007013A.title: "Bee Nest"
	quest.420000000007013B.quest_desc: [
		"Colonies in the wind. The Desk sells comb if none drift by."
	]
	quest.420000000007013B.title: "Honeycomb"
	quest.420000000007013C.quest_desc: [
		"A home for workers."
	]
	quest.420000000007013C.title: "Beehive"
	quest.420000000007013D.quest_desc: [
		"Sweet, sticky, and worth more to a furnace than to your stomach."
	]
	quest.420000000007013D.title: "Honey Bottle (Swarm)"
	quest.420000000007013E.quest_desc: [
		"A snack that calms an agitated bee before you reach into the hive."
	]
	quest.420000000007013E.title: "Honey Treat"
	quest.420000000007013F.quest_desc: [
		"Gravel around a flower. Mining bees and diggers like the dust."
	]
	quest.420000000007013F.title: "Ring of Grit"
	quest.4200000000070140.quest_desc: [
		"Coarse dirt around a flower. Leafcutters and ashy miners."
	]
	quest.4200000000070140.title: "Ring of Coarse Dirt"
	quest.4200000000070141.quest_desc: [
		"Stone around a flower. Mason bees, and diggers that eat rock."
	]
	quest.4200000000070141.title: "Ring of Stone"
	quest.4200000000070142.quest_desc: [
		"A productive home."
	]
	quest.4200000000070142.title: "Advanced Beehive"
	quest.4200000000070143.quest_desc: [
		"Gives a hive more room before it swarms looking for a new one."
	]
	quest.4200000000070143.title: "Expansion Box"
	quest.4200000000070144.quest_desc: [
		"Bottles the yield without a hand on it."
	]
	quest.4200000000070144.title: "Bottler"
	quest.4200000000070145.quest_desc: [
		"Spin combs into everything they hide."
	]
	quest.4200000000070145.title: "Centrifuge"
	quest.4200000000070146.quest_desc: [
		"The same, faster, on power."
	]
	quest.4200000000070146.title: "Powered Centrifuge"
	quest.4200000000070147.quest_desc: [
		"Nets a bee out of the air without a single sting."
	]
	quest.4200000000070147.title: "Catcher"
	quest.4200000000070148.quest_desc: [
		"Carry a bee like a lantern."
	]
	quest.4200000000070148.title: "Bee Cage"
	quest.4200000000070149.quest_desc: [
		"Hatch the genes you want."
	]
	quest.4200000000070149.title: "Incubator"
	quest.420000000007014A.quest_desc: [
		"Pair two colonies on purpose."
	]
	quest.420000000007014A.title: "Breeding Chamber"
	quest.420000000007014B.quest_desc: [
		"Sort traits like seed."
	]
	quest.420000000007014B.title: "Gene Indexer"
	quest.420000000007014C.quest_desc: [
		"A stack of treats: the colony's payroll."
	]
	quest.420000000007014C.title: "Feed Upgrade"
	quest.420000000007014D.quest_desc: [
		"One of the deeper essence crops, grown far past the basics."
	]
	quest.420000000007014D.title: "Diamond Seeds"
	quest.420000000007014E.quest_desc: [
		"A farm plot that yields dust instead of digging for it."
	]
	quest.420000000007014E.title: "Redstone Seeds"
	quest.420000000007014F.quest_desc: [
		"Grows the blue essence enchanting tables are always hungry for."
	]
	quest.420000000007014F.title: "Lapis Seeds"
	quest.4200000000070150.quest_desc: [
		"Quartz grown on leaves instead of dug from Nether caves."
	]
	quest.4200000000070150.title: "Nether Quartz Seeds"
	quest.4200000000070151.quest_desc: [
		"A softer way to farm light than mining the Nether ceiling."
	]
	quest.4200000000070151.title: "Glowstone Seeds"
	quest.4200000000070152.quest_desc: [
		"Hardened leaves that yield obsidian essence without a lava bucket in sight."
	]
	quest.4200000000070152.title: "Obsidian Seeds"
	quest.4200000000070153.quest_desc: [
		"High essence. The fields are industry now."
	]
	quest.4200000000070153.title: "Imperium"
	quest.4200000000070154.quest_desc: [
		"The last essence tier. Whatever you're building, this is the good version."
	]
	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"Swarm surplus, stacked."
	]
	quest.4200000000070155.title: "Honey Block"
	quest.4200000000070156.quest_desc: [
		"A bee that did not exist before you built the nest.",
		"Mining, mason, digger, carpenter — look at one."
	]
	quest.4200000000070156.subtitle: "Colony"
	quest.4200000000070156.title: "Something New Hums"
	quest.4200000000070157.quest_desc: [
		"Sand around a flower. Ashy and chocolate miners."
	]
	quest.4200000000070157.title: "Ring of Sand"
	quest.4200000000070158.quest_desc: [
		"Sugar cane around a flower. Reed bees and masons."
	]
	quest.4200000000070158.title: "Ring of Reed"
	quest.4200000000070159.quest_desc: [
		"Slime blocks around a flower. Guess."
	]
	quest.4200000000070159.title: "Ring of Slime"
	quest.420000000007015A.quest_desc: [
		"Hay around a flower. Bumble bees, and plain bees too."
	]
	quest.420000000007015A.title: "Ring of Hay"
	quest.420000000007015B.quest_desc: [
		"Snow around a flower. Sweat bees, oddly."
	]
	quest.420000000007015B.title: "Ring of Snow"
	quest.420000000007015C.quest_desc: [
		"Burns honey for power. A hive doing double duty."
	]
	quest.420000000007015C.title: "Honey Generator"
	quest.420000000007015D.quest_desc: [
		"Holds one bee on display, wings and all, without a hive attached."
	]
	quest.420000000007015D.title: "Jar"
	quest.420000000007015E.quest_desc: [
		"Calms a hive full of bees before you go digging for honeycomb."
	]
	quest.420000000007015E.title: "Campfire (Swarm)"
	quest.420000000007015F.quest_desc: [
		"Feeds bees and blooms twice a year, evergreen the rest of the time."
	]
	quest.420000000007015F.title: "Flowering Azalea (Swarm)"
	quest.4200000000070160.quest_desc: [
		"Tall, yellow, and always facing the sun. Bees find it easily."
	]
	quest.4200000000070160.title: "Sunflower"
	quest.4200000000070161.quest_desc: [
		"Two blocks of purple bloom that bees will cross a pad to reach."
	]
	quest.4200000000070161.title: "Lilac"
	quest.4200000000070162.quest_desc: [
		"A tall flower bees favor, and one more color for the garden."
	]
	quest.4200000000070162.title: "Rose Bush"
	quest.4200000000070163.quest_desc: [
		"Pink and full, planted wherever a hive needs more forage nearby."
	]
	quest.4200000000070163.title: "Peony"
	quest.4200000000070164.quest_desc: [
		"A short, single flower, but bees don't care about height."
	]
	quest.4200000000070164.title: "Orange Tulip"
	quest.4200000000070165.quest_desc: [
		"A nest you built, a hive you moved, a centrifuge, an incubator, essence fields.",
		"Tension the Strand: the Colony-keepers answer."
	]
	quest.4200000000070165.subtitle: "Colony"
	quest.4200000000070165.title: "Swarm Knot"
	quest.4200000000070166.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.4200000000070166.title: "Seat Swarm"
	quest.4200000000070167.quest_desc: [
		"You killed a bee.",
		"The Colony-keepers would like a word. Here is a bottle; think about it."
	]
	quest.4200000000070167.title: "Regret"
	quest.4200000000080168.quest_desc: [
		"The stewards left tricks in crystal. Thirty-two shards."
	]
	quest.4200000000080168.title: "Amethyst"
	quest.4200000000080169.quest_desc: [
		"Right-click the Tension Post with a Strand Filament once two of Clock, Swarm, or Spark are seated.",
		"Bind begins here."
	]
	quest.4200000000080169.title: "Braid Cord"
	quest.420000000008016A.quest_desc: [
		"Write the rite before you carve it."
	]
	quest.420000000008016A.title: "Book and Quill"
	quest.420000000008016B.quest_desc: [
		"Soft power for hard tools."
	]
	quest.420000000008016B.title: "Enchanting Table (Sigil)"
	quest.420000000008016C.quest_desc: [
		"Fuel the table."
	]
	quest.420000000008016C.title: "Lapis Block"
	quest.420000000008016D.quest_desc: [
		"Surrounds an enchanting table to unlock its strongest enchantments."
	]
	quest.420000000008016D.title: "Bookshelf"
	quest.420000000008016E.quest_desc: [
		"Heals deeply and grants a shine that fades after a minute."
	]
	quest.420000000008016E.title: "Golden Apple"
	quest.420000000008016F.quest_desc: [
		"Skip the drop."
	]
	quest.420000000008016F.title: "Ender Pearl"
	quest.4200000000080170.quest_desc: [
		"Turns water bottles into something with an actual effect."
	]
	quest.4200000000080170.title: "Brewing Stand"
	quest.4200000000080171.quest_desc: [
		"Heat for potions."
	]
	quest.4200000000080171.title: "Blaze Powder"
	quest.4200000000080172.quest_desc: [
		"Fuels the brewing stand and proves you've already faced the Nether."
	]
	quest.4200000000080172.title: "Blaze Rod"
	quest.4200000000080173.quest_desc: [
		"Twists a potion's effect into something worse, on purpose."
	]
	quest.4200000000080173.title: "Fermented Eye"
	quest.4200000000080174.quest_desc: [
		"Glowstone dust for recipes."
	]
	quest.4200000000080174.title: "Glowstone Dust (Sigil)"
	quest.4200000000080175.quest_desc: [
		"Breath of the thing that guards the End."
	]
	quest.4200000000080175.title: "Dragon Breath"
	quest.4200000000080176.quest_desc: [
		"One more chance.",
		"Optional — the void may never offer one."
	]
	quest.4200000000080176.title: "Totem"
	quest.4200000000080177.quest_desc: [
		"Stores Source, the fuel spells burn through."
	]
	quest.4200000000080177.title: "Source Gem"
	quest.4200000000080178.quest_desc: [
		"Grown, not found. Wood for casting tools and spell pedestals."
	]
	quest.4200000000080178.title: "Archwood"
	quest.4200000000080179.quest_desc: [
		"First spells. Peer magic, if you want it beside the rites."
	]
	quest.4200000000080179.title: "Novice Spell Book"
	quest.420000000008017A.quest_desc: [
		"An arcane crop, grown for its cloth as much as its magic."
	]
	quest.420000000008017A.title: "Mage Bloom"
	quest.420000000008017B.quest_desc: [
		"Brazier for ritual work."
	]
	quest.420000000008017B.title: "Ritual Brazier"
	quest.420000000008017C.quest_desc: [
		"Displays a reagent and feeds it into whatever ritual needs it."
	]
	quest.420000000008017C.title: "Arcane Pedestal"
	quest.420000000008017D.quest_desc: [
		"Scribe spells and pages."
	]
	quest.420000000008017D.title: "Scribes Table"
	quest.420000000008017E.quest_desc: [
		"Imbue reagents with source."
	]
	quest.420000000008017E.title: "Imbuement Chamber"
	quest.420000000008017F.quest_desc: [
		"Stores extra Source so a spell never runs dry mid-cast."
	]
	quest.420000000008017F.title: "Source Jar"
	quest.4200000000080180.quest_desc: [
		"Call spirits by their names."
	]
	quest.4200000000080180.title: "Occultism Dictionary"
	quest.4200000000080181.quest_desc: [
		"A cold flame used in rituals that regular fire won't finish."
	]
	quest.4200000000080181.title: "Spirit Fire"
	quest.4200000000080182.quest_desc: [
		"A focus for summoning. The rites are patient."
	]
	quest.4200000000080182.title: "Golden Sacrificial Bowl"
	quest.4200000000080183.quest_desc: [
		"The heart of aura-based crafting, tuned to the land around it."
	]
	quest.4200000000080183.title: "Nature Altar"
	quest.4200000000080184.quest_desc: [
		"A plant infused by high aura, spun into something rarer."
	]
	quest.4200000000080184.title: "Gold Fiber"
	quest.4200000000080185.quest_desc: [
		"Aura-touched material, more valuable than it looks lying on the ground."
	]
	quest.4200000000080185.title: "Gold Leaf"
	quest.4200000000080186.quest_desc: [
		"Iron that's soaked up ambient aura until it's worth more than the ore."
	]
	quest.4200000000080186.title: "Infused Iron"
	quest.4200000000080187.quest_desc: [
		"Lets you see the aura level of the land around you."
	]
	quest.4200000000080187.title: "Eye"
	quest.4200000000080188.quest_desc: [
		"Raises the aura of the area it's placed in."
	]
	quest.4200000000080188.title: "Token Joy"
	quest.4200000000080189.quest_desc: [
		"Spell parchment stock."
	]
	quest.4200000000080189.title: "Spell Parchment"
	quest.420000000008018A.quest_desc: [
		"Marks a spot to return to with a word, not a walk."
	]
	quest.420000000008018A.title: "Warp Scroll"
	quest.420000000008018B.quest_desc: [
		"Plant it, tend it, and harvest cloth soaked in low magic."
	]
	quest.420000000008018B.title: "Magebloom Crop"
	quest.420000000008018C.quest_desc: [
		"The empty page a spell gets written onto."
	]
	quest.420000000008018C.title: "Blank Glyph"
	quest.420000000008018D.quest_desc: [
		"Casts combat spells without ever touching a wand."
	]
	quest.420000000008018D.title: "Iron's Spell Book"
	quest.420000000008018E.quest_desc: [
		"The fuel spellcasters burn through, spell after spell."
	]
	quest.420000000008018E.title: "Arcane Essence"
	quest.420000000008018F.quest_desc: [
		"Inscribes a spell onto a book, one tier at a time."
	]
	quest.420000000008018F.title: "Ink Common"
	quest.4200000000080190.quest_desc: [
		"Color for rites."
	]
	quest.4200000000080190.title: "Mystical Flower"
	quest.4200000000080191.quest_desc: [
		"Deep dark echo.",
		"Optional — the void may never offer one."
	]
	quest.4200000000080191.title: "Echo Shard"
	quest.4200000000080192.quest_desc: [
		"A braid spun, potions bottled, spells and spirits called.",
		"Tension the Strand: the Seal-carvers answer."
	]
	quest.4200000000080192.subtitle: "Bind"
	quest.4200000000080192.title: "Sigil Knot"
	quest.4200000000080193.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign."
	]
	quest.4200000000080193.title: "Seat Sigil"
	quest.4200000000080194.quest_desc: [
		"An apple the stewards never ate. Neither should you, probably."
	]
	quest.4200000000080194.title: "Old Gold"
	quest.4200000000090195.quest_desc: [
		"An iron mesh, gravel or sand, patience.",
		"Strand Filament is the Loom's own thread. The braid is spun from it."
	]
	quest.4200000000090195.title: "Spin the Filament"
	quest.4200000000090196.quest_desc: [
		"Two braid paths seated, one Filament, one right-click on the Post.",
		"Bind has begun; Reweave starts here."
	]
	quest.4200000000090196.title: "Splice a Braid"
	quest.4200000000090197.quest_desc: [
		"Certus quartz — the cold thread of a digital loom."
	]
	quest.4200000000090197.title: "Cold Weft"
	quest.4200000000090198.quest_desc: [
		"Ground quartz, the base material the digital loom is built from."
	]
	quest.4200000000090198.title: "Certus Dust"
	quest.4200000000090199.quest_desc: [
		"The shell block for every network machine, quarried from certus deposits."
	]
	quest.4200000000090199.title: "Sky Stone"
	quest.420000000009019A.quest_desc: [
		"Fluix — certus, quartz, and redstone charged in water."
	]
	quest.420000000009019A.title: "Charged Warp"
	quest.420000000009019B.quest_desc: [
		"A blend of quartz, redstone, and glass, ground fine for network crafting."
	]
	quest.420000000009019B.title: "Fluix Dust"
	quest.420000000009019C.quest_desc: [
		"Silicon for AE2 processors."
	]
	quest.420000000009019C.title: "Silicon"
	quest.420000000009019D.quest_desc: [
		"The inscriber presses circuits the way a loom presses cloth."
	]
	quest.420000000009019D.title: "Press the Pattern"
	quest.420000000009019E.quest_desc: [
		"Stamps a silicon plate the way a loom presses cloth."
	]
	quest.420000000009019E.title: "Inscriber Silicon Press"
	quest.420000000009019F.quest_desc: [
		"Stamps the die for a logic processor, one press at a time."
	]
	quest.420000000009019F.title: "Logic Press"
	quest.42000000000901A0.quest_desc: [
		"Stamps the die for a calculation processor."
	]
	quest.42000000000901A0.title: "Calculation Press"
	quest.42000000000901A1.quest_desc: [
		"Engineering die craft."
	]
	quest.42000000000901A1.title: "Engineering Press"
	quest.42000000000901A2.quest_desc: [
		"Logic processor for AE2."
	]
	quest.42000000000901A2.title: "Logic Processor"
	quest.42000000000901A3.quest_desc: [
		"A component in autocrafting patterns, made from silicon and certus quartz."
	]
	quest.42000000000901A3.title: "Calculation Processor"
	quest.42000000000901A4.quest_desc: [
		"A denser processor, needed for the network's more demanding parts."
	]
	quest.42000000000901A4.title: "Engineering Processor"
	quest.42000000000901A5.quest_desc: [
		"Houses the cells that hold everything the network remembers."
	]
	quest.42000000000901A5.title: "ME Drive"
	quest.42000000000901A6.quest_desc: [
		"The shell a storage cell is built inside."
	]
	quest.42000000000901A6.title: "Item Cell Housing"
	quest.42000000000901A7.quest_desc: [
		"First digital chest."
	]
	quest.42000000000901A7.title: "1k Item Cell"
	quest.42000000000901A8.quest_desc: [
		"See the net."
	]
	quest.42000000000901A8.title: "ME Terminal"
	quest.42000000000901A9.quest_desc: [
		"Lets you craft directly from whatever the network already holds."
	]
	quest.42000000000901A9.title: "Crafting Terminal"
	quest.42000000000901AA.quest_desc: [
		"The controller. Wants a Binding Knot at its centre.",
		"Spindle core."
	]
	quest.42000000000901AA.title: "Digital Loom"
	quest.42000000000901AB.quest_desc: [
		"Strike it open. The March is on the other side."
	]
	quest.42000000000901AB.title: "Gate Drum"
	quest.42000000000901AC.quest_desc: [
		"Footing from beyond the gate. Bring one home."
	]
	quest.42000000000901AC.title: "March Stone"
	quest.42000000000901AD.quest_desc: [
		"Carries the network's channels from one machine to the next."
	]
	quest.42000000000901AD.title: "Fluix Cable"
	quest.42000000000901AE.quest_desc: [
		"Pull items into storage."
	]
	quest.42000000000901AE.title: "Import Bus"
	quest.42000000000901AF.quest_desc: [
		"Pushes items out of the network into a chest or machine."
	]
	quest.42000000000901AF.title: "Export Bus"
	quest.42000000000901B0.quest_desc: [
		"Reads an outside inventory into the network as if it were a cell."
	]
	quest.42000000000901B0.title: "Storage Bus"
	quest.42000000000901B1.quest_desc: [
		"Adds bulk crafting capacity to the network's autocrafting."
	]
	quest.42000000000901B1.title: "Crafting Unit"
	quest.42000000000901B2.quest_desc: [
		"Speeds up how many crafting jobs run at once."
	]
	quest.42000000000901B2.title: "Crafting Co-Processing Unit"
	quest.42000000000901B3.quest_desc: [
		"Holds patterns for the network to draw on while it crafts."
	]
	quest.42000000000901B3.title: "1k Crafting Storage"
	quest.42000000000901B4.quest_desc: [
		"Feeds patterns to machines the way a loom feeds thread to the shuttle."
	]
	quest.42000000000901B4.title: "Pattern Provider"
	quest.42000000000901B5.quest_desc: [
		"Builds from patterns. Wants a Braid Cord at its heart."
	]
	quest.42000000000901B5.title: "Molecular Assembler"
	quest.42000000000901B6.quest_desc: [
		"An empty pattern, waiting to be encoded with a recipe."
	]
	quest.42000000000901B6.title: "Blank Pattern"
	quest.42000000000901B7.quest_desc: [
		"Feed power into the digital loom."
	]
	quest.42000000000901B7.title: "Energy Acceptor"
	quest.42000000000901B8.quest_desc: [
		"Burn for AE — optional power branch."
	]
	quest.42000000000901B8.title: "Vibration Chamber"
	quest.42000000000901B9.quest_desc: [
		"A storage cell with more room than the last size."
	]
	quest.42000000000901B9.title: "4k Item Cell"
	quest.42000000000901BA.quest_desc: [
		"Holds far more than any chest, the densest cell before the drive fills up."
	]
	quest.42000000000901BA.title: "16k Item Cell"
	quest.42000000000901BB.quest_desc: [
		"The shell a fluid storage cell is built inside."
	]
	quest.42000000000901BB.title: "Fluid Cell Housing"
	quest.42000000000901BC.quest_desc: [
		"A digital tank, storing liquid the network can pull from anywhere."
	]
	quest.42000000000901BC.title: "1k Fluid Cell"
	quest.42000000000901BD.quest_desc: [
		"Places blocks from the network the way a hand would, without one."
	]
	quest.42000000000901BD.title: "Formation Plane"
	quest.42000000000901BE.quest_desc: [
		"Breaks blocks in front of it and feeds them into the network."
	]
	quest.42000000000901BE.title: "Annihilation Plane"
	quest.42000000000901BF.quest_desc: [
		"Redstone from net."
	]
	quest.42000000000901BF.title: "Level Emitter"
	quest.42000000000901C0.quest_desc: [
		"Connects the network to the world, trading items across the edge."
	]
	quest.42000000000901C0.title: "Interface"
	quest.42000000000901C1.quest_desc: [
		"Links two networks across distance the ordinary cable can't reach."
	]
	quest.42000000000901C1.title: "Quantum Ring"
	quest.42000000000901C2.quest_desc: [
		"The paired half of a quantum ring, tying two networks together."
	]
	quest.42000000000901C2.title: "Quantum Link"
	quest.42000000000901C3.quest_desc: [
		"Reaches the network from anywhere in range, no cable underfoot."
	]
	quest.42000000000901C3.title: "Wireless Terminal"
	quest.42000000000901C4.quest_desc: [
		"Copies one machine's settings onto another without retyping them."
	]
	quest.42000000000901C4.title: "Memory Card"
	quest.42000000000901C5.quest_desc: [
		"Network tool for AE2."
	]
	quest.42000000000901C5.title: "Network Tool"
	quest.42000000000901C6.quest_desc: [
		"Charges certus quartz until it's ready for finer crafting."
	]
	quest.42000000000901C6.title: "Charger"
	quest.42000000000901C7.quest_desc: [
		"Speeds a growing crystal bud toward a full-sized cluster."
	]
	quest.42000000000901C7.title: "Crystal Growth Accelerator"
	quest.42000000000901C8.quest_desc: [
		"March canopy proof — optional Reweave souvenir."
	]
	quest.42000000000901C8.title: "Spirit Reed"
	quest.42000000000901C9.quest_desc: [
		"A braid, a digital loom, a gate, a stone from the March.",
		"Tension the ninth Strand. Then the Fragment, then the Post."
	]
	quest.42000000000901C9.subtitle: "Reweave"
	quest.42000000000901C9.title: "Spindle Knot"
	quest.42000000000901CA.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.42000000000901CA.title: "Seat Spindle"
	quest.42000000000901CB.quest_desc: [
		"Nine seated, one March stone, one right-click on the Post: the Fragment.",
		"Seat it. The cut closes above your pad."
	]
	quest.42000000000901CB.subtitle: "Reweave"
	quest.42000000000901CB.title: "Loom Fragment"
	quest.42000000000901CC.quest_desc: [
		"Seat the Fragment at the Tension Post.",
		"Nine tribes, one thread. Go and see what the March kept for you.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign."
	]
	quest.42000000000901CC.subtitle: "The cut, closed"
	quest.42000000000901CC.title: "Reweave"
	quest.42000000000901CD.quest_desc: [
		"A wither, on a pad, in the sky. The Loom-stitchers would have been impressed and then furious."
	]
	quest.42000000000901CD.title: "A Star, Somehow"
	quest.42000000000A01CE.quest_desc: [
		"Leaves drop more saplings."
	]
	quest.42000000000A01CE.title: "Crook Basics"
	quest.42000000000A01CF.quest_desc: [
		"Sifts faster than the wooden crook, and lasts far longer."
	]
	quest.42000000000A01CF.title: "Bone Crook"
	quest.42000000000A01D0.quest_desc: [
		"The plainest mesh. Everything you sieve starts by passing through this."
	]
	quest.42000000000A01D0.title: "String Mesh"
	quest.42000000000A01D1.quest_desc: [
		"Catches finer shards than string. Fewer scraps slip through the weave."
	]
	quest.42000000000A01D1.title: "Flint Mesh (Sieve)"
	quest.42000000000A01D2.quest_desc: [
		"Iron threads catch heavier grit and pull rarer scraps from the pile."
	]
	quest.42000000000A01D2.title: "Iron Mesh (Sieve)"
	quest.42000000000A01D3.quest_desc: [
		"Gold tier mesh. Odds shift toward the ores that matter."
	]
	quest.42000000000A01D3.title: "Golden Mesh"
	quest.42000000000A01D4.quest_desc: [
		"Sieve gravel with this and diamonds turn up far more often."
	]
	quest.42000000000A01D4.title: "Diamond Mesh"
	quest.42000000000A01D5.quest_desc: [
		"The finest mesh made. Nothing sieves better than netherite thread."
	]
	quest.42000000000A01D5.title: "Netherite Mesh"
	quest.42000000000A01D6.quest_desc: [
		"Clay refined smooth, ready to fire into a crucible that holds real heat."
	]
	quest.42000000000A01D6.title: "Porcelain Clay (Sieve)"
	quest.42000000000A01D7.quest_desc: [
		"Fuel a furnace generator."
	]
	quest.42000000000A01D7.title: "Unfired Crucible"
	quest.42000000000A01D8.quest_desc: [
		"Holds molten heat without cracking. Smelt what the sieve turned up."
	]
	quest.42000000000A01D8.title: "Porcelain Crucible"
	quest.42000000000A01D9.quest_desc: [
		"Splashes water across crops without trampling the rows."
	]
	quest.42000000000A01D9.title: "Watering Can Wood"
	quest.42000000000A01DA.quest_desc: [
		"Wider splash and a deeper tank. Water more of the pad per trip."
	]
	quest.42000000000A01DA.title: "Watering Can Iron"
	quest.42000000000A01DB.quest_desc: [
		"Set loose on leaves, it spins silk while it feeds."
	]
	quest.42000000000A01DB.title: "Silkworm"
	quest.42000000000A01DC.quest_desc: [
		"Strange water that nudges saplings and seeds toward stranger crops."
	]
	quest.42000000000A01DC.title: "Witch Water Bucket"
	quest.42000000000A01DD.quest_desc: [
		"Scatter these and mycelium creeps outward, block by patient block."
	]
	quest.42000000000A01DD.title: "Mycelium Spores"
	quest.42000000000A01DE.quest_desc: [
		"Toss on dirt and grass spreads without waiting on the rain."
	]
	quest.42000000000A01DE.title: "Grass Seeds"
	quest.42000000000A01DF.quest_desc: [
		"Cobblestone's replacement grit. Feed it back to the hammer for more."
	]
	quest.42000000000A01DF.title: "Stone Pebble"
	quest.42000000000A01E0.quest_desc: [
		"Nine pebbles packed tight into storage stone for a growing pad."
	]
	quest.42000000000A01E0.title: "Compressed Cobble"
	quest.42000000000A01E1.quest_desc: [
		"Breaks cobble into pebbles faster than any hammer before it."
	]
	quest.42000000000A01E1.title: "Netherite Hammer"
	quest.42000000000A01E2.quest_desc: [
		"Nether stone, crushed fine. Basalt and blackstone both start here."
	]
	quest.42000000000A01E2.title: "Blackstone Pebble"
	quest.42000000000A01E3.quest_desc: [
		"Deepslate crushed down to grit, ready for the sieve again."
	]
	quest.42000000000A01E3.title: "Deepslate Pebble"
	quest.42000000000A01E4.quest_desc: [
		"Pale stone pulled from deep sieving, mostly good for building."
	]
	quest.42000000000A01E4.title: "Calcite"
	quest.42000000000A01E5.quest_desc: [
		"Grey stone from the depths, plain and easy to shape."
	]
	quest.42000000000A01E5.title: "Tuff"
	quest.42000000000A01E6.quest_desc: [
		"Grows slow underground; stack it and let it drip into stalactites again."
	]
	quest.42000000000A01E6.title: "Dripstone"
	quest.42000000000A01E7.quest_desc: [
		"Soaks up standing water fast, handy after a flooded farm."
	]
	quest.42000000000A01E7.title: "Sponge"
	quest.42000000000B01E8.quest_desc: [
		"Links every drawer on the pad into one searchable network."
	]
	quest.42000000000B01E8.title: "Storage Controller"
	quest.42000000000B01E9.quest_desc: [
		"A barrel that upgrades: filters, hoppers, magnets, void."
	]
	quest.42000000000B01E9.title: "Copper Barrel"
	quest.42000000000B01EA.quest_desc: [
		"More slots, more upgrade rows."
	]
	quest.42000000000B01EA.title: "Iron Barrel"
	quest.42000000000B01EB.quest_desc: [
		"Pull dropped items straight into the barrel from across the pad."
	]
	quest.42000000000B01EB.title: "Stack Upgrade"
	quest.42000000000B01EC.quest_desc: [
		"In one side, out the other, no hopper block needed."
	]
	quest.42000000000B01EC.title: "Hopper Upgrade"
	quest.42000000000B01ED.quest_desc: [
		"Deletes anything past capacity so the drawer never jams."
	]
	quest.42000000000B01ED.title: "Void Upgrade"
	quest.42000000000B01EE.quest_desc: [
		"Sucks nearby drops straight into the backpack as you walk."
	]
	quest.42000000000B01EE.title: "Pickup Upgrade"
	quest.42000000000B01EF.quest_desc: [
		"One slot, sorted and visible. The simplest way to store bulk items."
	]
	quest.42000000000B01EF.title: "Oak Drawer 1x1"
	quest.42000000000B01F0.quest_desc: [
		"Two slots side by side for keeping similar items apart."
	]
	quest.42000000000B01F0.title: "Oak Drawer 1x2"
	quest.42000000000B01F1.quest_desc: [
		"Four slots in one frame. Dense storage for a small footprint."
	]
	quest.42000000000B01F1.title: "Oak Drawer 2x2"
	quest.42000000000B01F2.quest_desc: [
		"Automatically compacts what it holds into blocks as it fills."
	]
	quest.42000000000B01F2.title: "Compacting Drawer"
	quest.42000000000B01F3.quest_desc: [
		"Links every drawer on the pad into one searchable network."
	]
	quest.42000000000B01F3.title: "Storage Controller (Storage)"
	quest.42000000000B01F4.quest_desc: [
		"Pulls nearby item drops straight into the drawer."
	]
	quest.42000000000B01F4.title: "Collector Upgrade"
	quest.42000000000B01F5.quest_desc: [
		"Pulls items out of the chest or machine set beside it."
	]
	quest.42000000000B01F5.title: "Puller Upgrade"
	quest.42000000000B01F6.quest_desc: [
		"Pushes stored items into whatever inventory sits next to it."
	]
	quest.42000000000B01F6.title: "Pusher Upgrade"
	quest.42000000000B01F7.quest_desc: [
		"Deletes anything past capacity so the drawer never jams."
	]
	quest.42000000000B01F7.title: "Void Upgrade (Storage)"
	quest.42000000000B01F8.quest_desc: [
		"A portable inventory that frees up hotbar and pocket space."
	]
	quest.42000000000B01F8.title: "Backpack"
	quest.42000000000B01F9.quest_desc: [
		"More slots than the plain backpack, and a slot to upgrade it."
	]
	quest.42000000000B01F9.title: "Iron Backpack"
	quest.42000000000B01FA.quest_desc: [
		"Roomier still, with slots left over for useful upgrades."
	]
	quest.42000000000B01FA.title: "Gold Backpack"
	quest.42000000000B01FB.quest_desc: [
		"The deepest pockets before enchanting takes the storage further still."
	]
	quest.42000000000B01FB.title: "Diamond Backpack"
	quest.42000000000B01FC.quest_desc: [
		"Sucks nearby drops straight into the backpack as you walk."
	]
	quest.42000000000B01FC.title: "Pickup Upgrade (Storage)"
	quest.42000000000B01FD.quest_desc: [
		"Filter what enters packs."
	]
	quest.42000000000B01FD.title: "Filter Upgrade"
	quest.42000000000B01FE.quest_desc: [
		"Lets the backpack craft from whatever it already has stored."
	]
	quest.42000000000B01FE.title: "Crafting Upgrade"
	quest.42000000000B01FF.quest_desc: [
		"Feeds you automatically from its stores when hunger runs low."
	]
	quest.42000000000B01FF.title: "Feeding Upgrade"
	quest.42000000000B0200.quest_desc: [
		"Swaps a broken tool for a fresh one from the pack."
	]
	quest.42000000000B0200.title: "Restock Upgrade"
	quest.42000000000B0201.quest_desc: [
		"Empties the backpack into nearby chests when you get close."
	]
	quest.42000000000B0201.title: "Deposit Upgrade"
	quest.42000000000B0202.quest_desc: [
		"Adds a fluid tank inside the backpack for hauling liquids."
	]
	quest.42000000000B0202.title: "Tank Upgrade"
	quest.42000000000C0203.quest_desc: [
		"The backbone metal behind most machines and casings on this line."
	]
	quest.42000000000C0203.title: "Steel Ingot"
	quest.42000000000C0204.quest_desc: [
		"The core metal behind most cables, tanks, and early machines."
	]
	quest.42000000000C0204.title: "Osmium Ingot"
	quest.42000000000C0205.quest_desc: [
		"A hard alloy pressed from obsidian dust for tougher gear."
	]
	quest.42000000000C0205.title: "Refined Obsidian"
	quest.42000000000C0206.quest_desc: [
		"The simplest logic board. Most early machines need a few."
	]
	quest.42000000000C0206.title: "Basic Control Circuit"
	quest.42000000000C0207.quest_desc: [
		"A sharper logic board for the machines a step up the line."
	]
	quest.42000000000C0207.title: "Advanced Control Circuit"
	quest.42000000000C0208.quest_desc: [
		"The sharpest logic board, reserved for the line's top machines."
	]
	quest.42000000000C0208.title: "Elite Control Circuit"
	quest.42000000000C0209.quest_desc: [
		"Infuses metals with carbon, redstone, or diamond dust before smelting."
	]
	quest.42000000000C0209.title: "Metallurgic Infuser"
	quest.42000000000C020A.quest_desc: [
		"Doubles most raw ores into two dusts instead of one."
	]
	quest.42000000000C020A.title: "Enrichment Chamber"
	quest.42000000000C020B.quest_desc: [
		"Mill or crush bulk materials."
	]
	quest.42000000000C020B.title: "Crusher"
	quest.42000000000C020C.quest_desc: [
		"Smelts ores on power instead of fuel, and a little faster too."
	]
	quest.42000000000C020C.title: "Energized Smelter"
	quest.42000000000C020D.quest_desc: [
		"Purifies enriched ore with oxygen for a third output, sometimes more."
	]
	quest.42000000000C020D.title: "Purification Chamber"
	quest.42000000000C020E.quest_desc: [
		"Injects gas into ore for the richest output the line offers."
	]
	quest.42000000000C020E.title: "Chemical Injection"
	quest.42000000000C020F.quest_desc: [
		"Compresses osmium dust into ingots faster than a furnace alone."
	]
	quest.42000000000C020F.title: "Osmium Compressor"
	quest.42000000000C0210.quest_desc: [
		"A single stack slot that holds far more than a chest can."
	]
	quest.42000000000C0210.title: "Basic Bin"
	quest.42000000000C0211.quest_desc: [
		"Stores a deep pool of one fluid in a single block."
	]
	quest.42000000000C0211.title: "Basic Fluid Tank"
	quest.42000000000C0212.quest_desc: [
		"Buffers power between machines so surges don't stall the line."
	]
	quest.42000000000C0212.title: "Basic Energy Cube"
	quest.42000000000C0213.quest_desc: [
		"Carries power to machines. The most common cable on the pad."
	]
	quest.42000000000C0213.title: "Basic Universal Cable"
	quest.42000000000C0214.quest_desc: [
		"Moves fluids between tanks and machines along the pad."
	]
	quest.42000000000C0214.title: "Basic Mechanical Pipe"
	quest.42000000000C0215.quest_desc: [
		"Moves items automatically between connected inventories."
	]
	quest.42000000000C0215.title: "Basic Logistical Transporter"
	quest.42000000000C0216.quest_desc: [
		"Rotates, wrenches, and reconfigures machine faces with one tool."
	]
	quest.42000000000C0216.title: "Configurator"
	quest.42000000000C0217.quest_desc: [
		"Mek jetpack — optional lift."
	]
	quest.42000000000C0217.title: "Jetpack"
	quest.42000000000C0218.quest_desc: [
		"Softens fall damage and buys a second before the void claims you."
	]
	quest.42000000000C0218.title: "Free Runners"
	quest.42000000000C0219.quest_desc: [
		"One tool that mines, cuts, and fights, sharper with every upgrade."
	]
	quest.42000000000C0219.title: "Atomic Disassembler"
	quest.42000000000C021A.quest_desc: [
		"The structural frame most multiblock machines are built around."
	]
	quest.42000000000C021A.title: "Steel Casing"
	quest.42000000000C021B.quest_desc: [
		"Links two points so stepping through skips the walk between."
	]
	quest.42000000000C021B.title: "Teleporter"
	quest.42000000000C021C.quest_desc: [
		"Mines a wide radius automatically and sorts the output for you."
	]
	quest.42000000000C021C.title: "Digital Miner"
	quest.42000000000D021D.quest_desc: [
		"A sticky base ingredient behind most of the grid's machines."
	]
	quest.42000000000D021D.title: "Dielectric Paste"
	quest.42000000000D021E.quest_desc: [
		"Store a measure of power."
	]
	quest.42000000000D021E.title: "Capacitor Basic"
	quest.42000000000D021F.quest_desc: [
		"Stores a deep reserve of power for the machines around it."
	]
	quest.42000000000D021F.title: "Energy Cell Basic"
	quest.42000000000D0220.quest_desc: [
		"Burns fuel into power more efficiently than a plain furnace."
	]
	quest.42000000000D0220.title: "Furnator Basic"
	quest.42000000000D0221.quest_desc: [
		"Turns lava into steady power for as long as the lava lasts."
	]
	quest.42000000000D0221.title: "Magmator Basic"
	quest.42000000000D0222.quest_desc: [
		"Generates power from daylight, more than a single cell manages alone."
	]
	quest.42000000000D0222.title: "Solar Basic"
	quest.42000000000D0223.quest_desc: [
		"Generates power from the gap between hot and cold nearby blocks."
	]
	quest.42000000000D0223.title: "Thermo Basic"
	quest.42000000000D0224.quest_desc: [
		"Burns solid fuel steadily for a strong, dependable trickle of power."
	]
	quest.42000000000D0224.title: "Reactor Basic"
	quest.42000000000D0225.quest_desc: [
		"Moves more power per tick than the starting cable."
	]
	quest.42000000000D0225.title: "Energy Cable Basic"
	quest.42000000000D0226.quest_desc: [
		"Charges the player directly, no wires or slots required."
	]
	quest.42000000000D0226.title: "Player Transmitter Basic"
	quest.42000000000D0227.quest_desc: [
		"Feeds power into nearby machines the way a hopper feeds items."
	]
	quest.42000000000D0227.title: "Energy Hopper Basic"
	quest.42000000000D0228.quest_desc: [
		"Charges energizing cells faster when placed beside the crystal setup."
	]
	quest.42000000000D0228.title: "Energizing Rod Basic"
	quest.42000000000D0229.quest_desc: [
		"A pocket reserve of power to carry between machines by hand."
	]
	quest.42000000000D0229.title: "Battery Basic"
	quest.42000000000D022A.quest_desc: [
		"The first crystal tier for the energizing rod's cell chamber."
	]
	quest.42000000000D022A.title: "Niotic Crystal"
	quest.42000000000D022B.quest_desc: [
		"A stronger crystal tier, further along the energizing chamber's build."
	]
	quest.42000000000D022B.title: "Spirited Crystal"
	quest.42000000000D022C.quest_desc: [
		"The strongest crystal tier the energizing chamber can hold."
	]
	quest.42000000000D022C.title: "Nitro Crystal"
	quest.42000000000E022D.quest_desc: [
		"Spun from magebloom, and woven into robes and spell gear."
	]
	quest.42000000000E022D.title: "Mage Fiber"
	quest.42000000000E022E.quest_desc: [
		"A flower that regrows its fiber on the stem after harvest."
	]
	quest.42000000000E022E.title: "Magebloom"
	quest.42000000000E022F.quest_desc: [
		"Stores a dense pool of source, the fuel behind every spell."
	]
	quest.42000000000E022F.title: "Source Gem Block"
	quest.42000000000E0230.quest_desc: [
		"Holds more glyphs than the starting book allows."
	]
	quest.42000000000E0230.title: "Apprentice Spell Book"
	quest.42000000000E0231.quest_desc: [
		"The largest spell book, room enough for a full arsenal of glyphs."
	]
	quest.42000000000E0231.title: "Archmage Spell Book"
	quest.42000000000E0232.quest_desc: [
		"Casts a bound spell automatically whenever it senses a target."
	]
	quest.42000000000E0232.title: "Spell Turret"
	quest.42000000000E0233.quest_desc: [
		"Casts its bound spell on a steady timer instead of on sight."
	]
	quest.42000000000E0233.title: "Timer Spell Turret"
	quest.42000000000E0234.quest_desc: [
		"The centerpiece for crafting spell books, wands, and other arcane gear."
	]
	quest.42000000000E0234.title: "Enchanting Apparatus"
	quest.42000000000E0235.quest_desc: [
		"Sits inside the enchanting apparatus and drives its recipes."
	]
	quest.42000000000E0235.title: "Arcane Core"
	quest.42000000000E0236.quest_desc: [
		"Carries source between an arcane spot and a linked jar or spell."
	]
	quest.42000000000E0236.title: "Relay"
	quest.42000000000E0237.quest_desc: [
		"Splits one source line so it feeds several places at once."
	]
	quest.42000000000E0237.title: "Relay Splitter"
	quest.42000000000E0238.quest_desc: [
		"Converts nearby crop growth into a slow trickle of source."
	]
	quest.42000000000E0238.title: "Agronomic Sourcelink"
	quest.42000000000E0239.quest_desc: [
		"Converts nearby lava heat into a steady trickle of source."
	]
	quest.42000000000E0239.title: "Volcanic Sourcelink"
	quest.42000000000E023A.quest_desc: [
		"Summons a wixie that crafts recipes for you while you work elsewhere."
	]
	quest.42000000000E023A.title: "Wixie Charm"
	quest.42000000000E023B.quest_desc: [
		"Summons a starbuncle that fetches items from storage on command."
	]
	quest.42000000000E023B.title: "Starbuncle Charm"
	quest.42000000000E023C.quest_desc: [
		"Summons a drygmy that slowly generates a chosen resource nearby."
	]
	quest.42000000000E023C.title: "Drygmy Charm"
	quest.42000000000E023D.quest_desc: [
		"Summons a whirlisprig that tends and grows crops on its own."
	]
	quest.42000000000E023D.title: "Whirlisprig Charm"
	quest.42000000000E023E.quest_desc: [
		"Summons a golem that harvests amethyst buds without lifting a pick."
	]
	quest.42000000000E023E.title: "Amethyst Golem Charm"
	quest.42000000000E023F.quest_desc: [
		"Picks up and places blocks remotely, wiring machines together at range."
