{
	chapter.B100000000000001.subtitle: [
		"Wake \u2014 survive, claim the pad, let the Codex wake."
	]
	chapter.B100000000000001.title: "Strand: Soil"
	chapter.B100000000000002.subtitle: [
		"Recover \u2014 pull the fallen world back into matter."
	]
	chapter.B100000000000002.title: "Strand: Stone"
	chapter.B100000000000003.subtitle: [
		"Root \u2014 grow anchors so the pad stops fraying."
	]
	chapter.B100000000000003.title: "Strand: Sprout"
	chapter.B100000000000004.subtitle: [
		"Edge \u2014 kit up and leave the pad on purpose."
	]
	chapter.B100000000000004.title: "Strand: Claw"
	chapter.B100000000000005.subtitle: [
		"Hum \u2014 rhythm and pulse before wires."
	]
	chapter.B100000000000005.title: "Strand: Spark"
	chapter.B100000000000006.subtitle: [
		"Pattern \u2014 a factory as a song that carries itself."
	]
	chapter.B100000000000006.title: "Strand: Clock"
	chapter.B100000000000007.subtitle: [
		"Colony \u2014 keep something alive that keeps something else alive."
	]
	chapter.B100000000000007.title: "Strand: Swarm"
	chapter.B100000000000008.subtitle: [
		"Bind \u2014 seals, rites, and two braid paths in a cord."
	]
	chapter.B100000000000008.title: "Strand: Sigil"
	chapter.B100000000000009.subtitle: [
		"Reweave \u2014 the digital loom, the March, the Fragment."
	]
	chapter.B100000000000009.title: "Strand: Spindle"
	chapter.B10000000000000A.title: "Deep Sieve"
	chapter.B10000000000000B.title: "Storage & Packs"
	chapter.B10000000000000C.title: "Mekanism Works"
	chapter.B10000000000000D.title: "Powah Grid"
	chapter.B10000000000000E.title: "Arcane Side"
	chapter.B10000000000000F.subtitle: [
		"Teams, the Hall, the Post, and the Fray."
	]
	chapter.B10000000000000F.title: "Clowder Hall"
	chapter.B100000000000010.subtitle: [
		"Spend Thread. No dependencies, no order."
	]
	chapter.B100000000000010.title: "Frayed Thread Desk"
	chapter.B100000000000011.title: "Nature's Aura"
	chapter.B100000000000012.title: "Kitchen Line"
	chapter.B100000000000013.title: "Battle Spells"
	chapter.B100000000000014.title: "Solar Flux"
	chapter.B100000000000015.title: "Pad Decor"
	chapter.B100000000000016.title: "Nether Foothold"
	chapter.B100000000000017.title: "End Foothold"
	chapter.B100000000000018.title: "Essence Fields"
	chapter.B100000000000019.subtitle: [
		"Every nest is a ring of something around a flower."
	]
	chapter.B100000000000019.title: "Swarm Apiary"
	chapter.B10000000000001A.title: "Pipeworks"
	chapter.B10000000000001B.title: "Otherworld"
	chapter.B10000000000001C.title: "Clockworks Deep"
	chapter.B10000000000001D.title: "Spindle Network"
	chapter.B10000000000001E.title: "Voidcraft"
	chapter.B10000000000001F.title: "Packaged Lines"
	chapter.B100000000000020.title: "QIO & Mek Peak"
	chapter.B100000000000021.title: "Hunt & Farm"
	chapter.B100000000000022.title: "Tribal Weave"
	chapter.B100000000000023.subtitle: [
		"Grit-singers cut one stone a hundred ways."
	]
	chapter.B100000000000023.title: "Stonemason"
	chapter.B100000000000024.subtitle: [
		"A pad is a ledge until someone puts a chair on it."
	]
	chapter.B100000000000024.title: "Furnishings"
	chapter.B100000000000025.subtitle: [
		"The little machines the stewards left."
	]
	chapter.B100000000000025.title: "Small Stewardries"
	chapter.B100000000000026.subtitle: [
		"The Drumhearts' pulse learns to run in copper."
	]
	chapter.B100000000000026.title: "The Current"
	chapter_group.A100000000000001.title: "Skybound"
	chapter_group.A100000000000002.title: "Craft & Tension"
	chapter_group.A100000000000003.title: "Reweave"
	chapter_group.A100000000000004.title: "Side Paths"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.C200000000010001.quest_desc: [
		"You are Skybound. This is what did not fall.",
		"Eight logs. Start with the tree; it started with you."
	]
	quest.C200000000010001.title: "Wake on a Pad"
	quest.C200000000010002.quest_desc: [
		"Dirt is a promise the pad makes to your boots.",
		"Sixteen blocks. Widen the promise."
	]
	quest.C200000000010002.title: "Something to Stand On"
	quest.C200000000010003.quest_desc: [
		"Hands need a surface. Everything after this is a surface."
	]
	quest.C200000000010003.title: "Craft a Bench"
	quest.C200000000010004.quest_desc: [
		"Claw comes later. For now, wood that bites."
	]
	quest.C200000000010004.title: "Wooden Pick"
	quest.C200000000010005.quest_desc: [
		"Green against the drop.",
		"Plant it before you are hungry."
	]
	quest.C200000000010005.title: "First Sapling"
	quest.C200000000010006.quest_desc: [
		"Sixty-four planks is a pad that stops feeling like a ledge."
	]
	quest.C200000000010006.title: "Plank Stock"
	quest.C200000000010007.quest_desc: [
		"Handles, frames, the bones of tools."
	]
	quest.C200000000010007.title: "Stick Bundle"
	quest.C200000000010008.quest_desc: [
		"Put things where they stay. A Clowder shares a chest before it shares anything else."
	]
	quest.C200000000010008.title: "Chest for the Clowder"
	quest.C200000000010009.quest_desc: [
		"See the edge before the edge sees you."
	]
	quest.C200000000010009.title: "Torch Line"
	quest.C20000000001000A.quest_desc: [
		"Ice and lava make stone where there was none.",
		"Normal and Hard pads ship both. The Desk sells a bucket."
	]
	quest.C20000000001000A.title: "Cobble Cache"
	quest.C20000000001000B.quest_desc: [
		"Warmth that is not yet Spark.",
		"The Pad-keepers would have called this a hearth."
	]
	quest.C20000000001000B.title: "Furnace Heat"
	quest.C20000000001000C.quest_desc: [
		"Hunger is a soft void. Eight loaves closes it for a while."
	]
	quest.C20000000001000C.title: "Cook a Meal"
	quest.C20000000001000D.quest_desc: [
		"Place lava, melt ice into a source, fill the bucket.",
		"Easy ships water; Normal and Hard ship the pieces."
	]
	quest.C20000000001000D.title: "Catch the Rain"
	quest.C20000000001000E.quest_desc: [
		"Scraps of the Loom that still hold. Every quest returns some.",
		"Unravel one for string, or spend them at the Desk."
	]
	quest.C20000000001000E.title: "Frayed Currency"
	quest.C20000000001000F.quest_desc: [
		"Damaged, but it still assigns work.",
		"Right-click to open. Sneak-click when you are lost."
	]
	quest.C20000000001000F.title: "Codex in Hand"
	quest.C200000000010010.quest_desc: [
		"Set a spawn."
	]
	quest.C200000000010010.title: "Bed Claim"
	quest.C200000000010011.quest_desc: [
		"Climb into the depths without a rope. Cheap enough to leave in every shaft."
	]
	quest.C200000000010011.title: "Ladder Down"
	quest.C200000000010012.quest_desc: [
		"Spider silk saved for later meshes. Every strand gets used eventually."
	]
	quest.C200000000010012.title: "String Cache"
	quest.C200000000010013.quest_desc: [
		"Speed the green."
	]
	quest.C200000000010013.title: "Bone Meal Stock"
	quest.C200000000010014.quest_desc: [
		"Widen the pad."
	]
	quest.C200000000010014.title: "Dirt Platform"
	quest.C200000000010015.quest_desc: [
		"Trim them now, compost them later. Nothing on a pad goes to waste."
	]
	quest.C200000000010015.title: "Oak Leaves"
	quest.C200000000010016.quest_desc: [
		"A quiet corner."
	]
	quest.C200000000010016.title: "Flower Pot"
	quest.C200000000010017.quest_desc: [
		"Ex Deorum's barrel: compost, and water into clay the slow way."
	]
	quest.C200000000010017.title: "Barrel"
	quest.C200000000010018.quest_desc: [
		"Waste to meal."
	]
	quest.C200000000010018.title: "Composter"
	quest.C200000000010019.quest_desc: [
		"Scratch a row."
	]
	quest.C200000000010019.title: "Wooden Hoe"
	quest.C20000000001001A.quest_desc: [
		"Fells logs quicker than bare hands. The first real tool a Skybound owns."
	]
	quest.C20000000001001A.title: "Wooden Axe"
	quest.C20000000001001B.quest_desc: [
		"Turns dirt and gravel into cleared ground. Slow, but it works."
	]
	quest.C20000000001001B.title: "Wooden Shovel"
	quest.C20000000001001C.quest_desc: [
		"Barely stops a zombie, but it stops one. Better than swinging a fist."
	]
	quest.C20000000001001C.title: "Wooden Sword"
	quest.C20000000001001D.quest_desc: [
		"Holds soup, stew, and not much else. Simple crockery for a simple pad."
	]
	quest.C20000000001001D.title: "Bowl"
	quest.C20000000001001E.quest_desc: [
		"Label the pad."
	]
	quest.C20000000001001E.title: "Item Frame"
	quest.C20000000001001F.quest_desc: [
		"Make it home."
	]
	quest.C20000000001001F.title: "Painting"
	quest.C200000000010020.quest_desc: [
		"Keeps the wind and the mobs on the correct side of the wall."
	]
	quest.C200000000010020.title: "Oak Door"
	quest.C200000000010021.quest_desc: [
		"Marks an edge without blocking the view. Handy where the drop is real."
	]
	quest.C200000000010021.title: "Oak Fence"
	quest.C200000000010022.quest_desc: [
		"Turns a sheer wall into something you can actually climb."
	]
	quest.C200000000010022.title: "Oak Stairs"
	quest.C200000000010023.quest_desc: [
		"Half a block, twice the flooring options. Useful in tight spaces."
	]
	quest.C200000000010023.title: "Oak Slab"
	quest.C200000000010024.quest_desc: [
		"Trapdoor access hatches."
	]
	quest.C200000000010024.title: "Oak Trapdoor"
	quest.C200000000010025.quest_desc: [
		"Trips a signal when something steps on it. Doors open themselves."
	]
	quest.C200000000010025.title: "Oak Pressure Plate"
	quest.C200000000010026.quest_desc: [
		"Button for redstone taps."
	]
	quest.C200000000010026.title: "Oak Button"
	quest.C200000000010027.quest_desc: [
		"Fence the pad edge."
	]
	quest.C200000000010027.title: "Stick Fence Gate"
	quest.C200000000010028.quest_desc: [
		"Cooks food slowly and keeps the smoke visible for miles."
	]
	quest.C200000000010028.title: "Campfire"
	quest.C200000000010029.quest_desc: [
		"Hangs light wherever a torch would look wrong. Warmer glow, same job."
	]
	quest.C200000000010029.title: "Lantern"
	quest.C20000000001002A.quest_desc: [
		"Burns pale blue and keeps most things from spawning nearby."
	]
	quest.C20000000001002A.title: "Soul Lantern"
	quest.C20000000001002B.quest_desc: [
		"Climbs with you and vanishes when pulled. Building high stops being scary."
	]
	quest.C20000000001002B.title: "Scaffolding"
	quest.C20000000001002C.quest_desc: [
		"Chain for hanging flair."
	]
	quest.C20000000001002C.title: "Chain"
	quest.C20000000001002D.quest_desc: [
		"Cage the edge."
	]
	quest.C20000000001002D.title: "Iron Bars"
	quest.C20000000001002E.quest_desc: [
		"Glass for pad windows."
	]
	quest.C20000000001002E.title: "Glass Pane"
	quest.C20000000001002F.quest_desc: [
		"Soft, flammable, and easy to dye. Every pad needs a bed eventually."
	]
	quest.C20000000001002F.title: "White Wool"
	quest.C200000000010030.quest_desc: [
		"A thin layer of wool for floors that don't need a whole block."
	]
	quest.C200000000010030.title: "White Carpet"
	quest.C200000000010031.quest_desc: [
		"Brings a little green and pink to a pad made of grit."
	]
	quest.C200000000010031.title: "Flowering Azalea"
	quest.C200000000010032.quest_desc: [
		"Spreads slowly and softens the look of raw stone platforms."
	]
	quest.C200000000010032.title: "Moss Block"
	quest.C200000000010033.quest_desc: [
		"Hanging roots under the pad."
	]
	quest.C200000000010033.title: "Hanging Roots"
	quest.C200000000010034.quest_desc: [
		"Clings to walls and lights them without a single torch."
	]
	quest.C200000000010034.title: "Glow Lichen"
	quest.C200000000010035.quest_desc: [
		"Dripstone for pointed flair."
	]
	quest.C200000000010035.title: "Pointed Dripstone"
	quest.C200000000010036.quest_desc: [
		"Amethyst in a block. Sigil will want shards later."
	]
	quest.C200000000010036.title: "Amethyst Block"
	quest.C200000000010037.quest_desc: [
		"Nine ingots pressed together. Weathers green if you leave it outside."
	]
	quest.C200000000010037.title: "Copper Block"
	quest.C200000000010038.quest_desc: [
		"Nine chunks of raw iron stacked tight, waiting on a furnace."
	]
	quest.C200000000010038.title: "Raw Iron Block"
	quest.C200000000010039.quest_desc: [
		"Burns far longer than loose coal. Feed the furnace and walk away."
	]
	quest.C200000000010039.title: "Coal Block"
	quest.C20000000001003A.quest_desc: [
		"Feeds animals and slows a fall. Farmers keep it close for both."
	]
	quest.C20000000001003A.title: "Hay Block"
	quest.C20000000001003B.quest_desc: [
		"Nine kelp pressed into fuel. Smelts more than it looks like it should."
	]
	quest.C20000000001003B.title: "Dried Kelp Block"
	quest.C20000000001003C.quest_desc: [
		"Paper and leather, waiting to become something with a recipe attached."
	]
	quest.C20000000001003C.title: "Book"
	quest.C20000000001003D.quest_desc: [
		"Paper for books and maps."
	]
	quest.C20000000001003D.title: "Paper"
	quest.C20000000001003E.quest_desc: [
		"Dye and books need ink."
	]
	quest.C20000000001003E.title: "Ink Sac"
	quest.C20000000001003F.quest_desc: [
		"Feathers for arrows and books."
	]
	quest.C20000000001003F.title: "Feather"
	quest.C200000000010040.quest_desc: [
		"Leather for books and kits."
	]
	quest.C200000000010040.title: "Leather"
	quest.C200000000010041.quest_desc: [
		"Bench, sapling, hearth, water, Codex. The pad holds.",
		"Tension the Strand: the Pad-keepers answer, and the token is yours to seat."
	]
	quest.C200000000010041.subtitle: "Wake"
	quest.C200000000010041.title: "Soil Knot"
	quest.C200000000010042.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.C200000000010042.title: "Seat Soil"
	quest.C200000000010043.quest_desc: [
		"A zombie on a pad with no caves. The void sends its regards.",
		"Light the edges."
	]
	quest.C200000000010043.title: "Something Came Up"
	quest.C200000000020044.quest_desc: [
		"Thread that remembers where it came from.",
		"Unravel Thread to string; four string spin two yarn."
	]
	quest.C200000000020044.title: "Pull Void Yarn"
	quest.C200000000020045.quest_desc: [
		"Cobble and sticks. Break fallen grit into gravel, sand, dust."
	]
	quest.C200000000020045.title: "Spindle Hammer"
	quest.C200000000020046.quest_desc: [
		"String around yarn. It catches what the Loom dropped \u2014 and combs Loom Lint out of dirt."
	]
	quest.C200000000020046.title: "Thread the Mesh"
	quest.C200000000020047.quest_desc: [
		"Pour water; the bucket comes straight back. Add dirt. Wait for clay.",
		"String and a pearl in the same barrel make yarn."
	]
	quest.C200000000020047.title: "Tension Barrel"
	quest.C200000000020048.quest_desc: [
		"Sixteen clay from the barrel. Load eight dirt at a time."
	]
	quest.C200000000020048.title: "Clay Pocket"
	quest.C200000000020049.quest_desc: [
		"Clay and bone meal. Shape the unfired bucket."
	]
	quest.C200000000020049.title: "Porcelain Clay"
	quest.C20000000002004A.quest_desc: [
		"Smelt it. Porcelain carries lava where iron is still a rumour."
	]
	quest.C20000000002004A.title: "Porcelain Tool"
	quest.C20000000002004B.quest_desc: [
		"Grit-singers named every shard by its echo.",
		"Sieve until you can hear the iron."
	]
	quest.C20000000002004B.title: "Sift Fallen Grit"
	quest.C20000000002004C.quest_desc: [
		"A spare set of hits."
	]
	quest.C20000000002004C.title: "Wooden Hammer"
	quest.C20000000002004D.quest_desc: [
		"Matter from grit. Sixty-four stones that were dust an hour ago."
	]
	quest.C20000000002004D.title: "Pebbles"
	quest.C20000000002004E.quest_desc: [
		"Loom dust waits in gravel. So does flint."
	]
	quest.C20000000002004E.title: "Gravel Path"
	quest.C20000000002004F.quest_desc: [
		"Fine grit. Glass later, and the iron mesh's best catch."
	]
	quest.C20000000002004F.title: "Sand Cache"
	quest.C200000000020050.quest_desc: [
		"Ash of the fallen world. Redstone and gunpowder hide in it."
	]
	quest.C200000000020050.title: "Dust Pile"
	quest.C200000000020051.quest_desc: [
		"Yarn around slime. Pad compost makes the slime.",
		"The Knot is the Loom's soft gate; keep two."
	]
	quest.C200000000020051.title: "Tie Binding Knot"
	quest.C200000000020052.quest_desc: [
		"Planks around a Knot. Stretch a mesh, load grit, let it work.",
		"Hoppers feed it. This is the pad's first machine."
	]
	quest.C200000000020052.title: "Raise Loomframe"
	quest.C200000000020053.quest_desc: [
		"Iron is low and patient. Eight chunks from the mesh."
	]
	quest.C200000000020053.title: "Iron Ore Chunk"
	quest.C200000000020054.quest_desc: [
		"Sieved from gravel bit by bit. The mesh finds copper before your eyes do."
	]
	quest.C200000000020054.title: "Copper Ore Chunk"
	quest.C200000000020055.quest_desc: [
		"Gold barely bothers to answer. Four is enough."
	]
	quest.C200000000020055.title: "Gold Ore Chunk"
	quest.C200000000020056.quest_desc: [
		"Fuel the line."
	]
	quest.C200000000020056.title: "Coal"
	quest.C200000000020057.quest_desc: [
		"Chunks to raw. Smelt onward."
	]
	quest.C200000000020057.title: "Raw Iron"
	quest.C200000000020058.quest_desc: [
		"Recover pays out. Sixteen bars the void did not want you to have."
	]
	quest.C200000000020058.title: "Iron Ingot"
	quest.C200000000020059.quest_desc: [
		"Wire and bulbs, and Tribal resonators later."
	]
	quest.C200000000020059.title: "Copper Ingot"
	quest.C20000000002005A.quest_desc: [
		"Gilded tools, and gold plates for the pattern-weavers."
	]
	quest.C20000000002005A.title: "Gold Ingot"
	quest.C20000000002005B.quest_desc: [
		"Sharper catch. Flint meshes shake Frayed Thread out of grit."
	]
	quest.C20000000002005B.title: "Flint Mesh"
	quest.C20000000002005C.quest_desc: [
		"Metal thread for heavier dust. Iron meshes are where Strand Filament falls."
	]
	quest.C20000000002005C.title: "Iron Mesh"
	quest.C20000000002005D.quest_desc: [
		"Melt and drip. Cobble to lava, given time."
	]
	quest.C20000000002005D.title: "Crucible"
	quest.C20000000002005E.quest_desc: [
		"Ex Deorum's barrel: compost, and water into clay the slow way."
	]
	quest.C20000000002005E.title: "Barrel (Stone)"
	quest.C20000000002005F.quest_desc: [
		"Harder hits, longer life."
	]
	quest.C20000000002005F.title: "Stone Hammer"
	quest.C200000000020060.quest_desc: [
		"Crushes ore into gravel and grit, the noisy trick behind the sieve."
	]
	quest.C200000000020060.title: "Iron Hammer"
	quest.C200000000020061.quest_desc: [
		"Wider mesh, nine at a time."
	]
	quest.C200000000020061.title: "Compressed Sieve"
	quest.C200000000020062.quest_desc: [
		"See through. Sand to glass."
	]
	quest.C200000000020062.title: "Glass"
	quest.C200000000020063.quest_desc: [
		"Carry the rain in iron now."
	]
	quest.C200000000020063.title: "Bucket"
	quest.C200000000020064.quest_desc: [
		"Heat from the void, in hand."
	]
	quest.C200000000020064.title: "Lava Bucket"
	quest.C200000000020065.quest_desc: [
		"Portal thoughts. Water on lava source."
	]
	quest.C200000000020065.title: "Obsidian"
	quest.C200000000020066.quest_desc: [
		"Rare grit luck. Two is a start."
	]
	quest.C200000000020066.title: "Diamond"
	quest.C200000000020067.quest_desc: [
		"Mesh upgrade fuel."
	]
	quest.C200000000020067.title: "Flint"
	quest.C200000000020068.quest_desc: [
		"Made from grit and dust, not looted from a creeper. Handle it carefully."
	]
	quest.C200000000020068.title: "Gunpowder"
	quest.C200000000020069.quest_desc: [
		"Spark will want this. Keep it dry."
	]
	quest.C200000000020069.title: "Redstone"
	quest.C20000000002006A.quest_desc: [
		"Feeds the enchanting table. Blue dust that makes gear listen better."
	]
	quest.C20000000002006A.title: "Lapis"
	quest.C20000000002006B.quest_desc: [
		"A common stone blend, useful mostly for building and for mixing recipes later."
	]
	quest.C20000000002006B.title: "Andesite"
	quest.C20000000002006C.quest_desc: [
		"Speckled stone, decorative more than structural. Grit-singers called it the loud one."
	]
	quest.C20000000002006C.title: "Diorite"
	quest.C20000000002006D.quest_desc: [
		"Dense and pink-flecked, good for a floor that wants to stand out."
	]
	quest.C20000000002006D.title: "Granite"
	quest.C20000000002006E.quest_desc: [
		"Porous rock from the other place. Burns forever once it catches."
	]
	quest.C20000000002006E.title: "Netherrack"
	quest.C20000000002006F.quest_desc: [
		"Slows every step that crosses it and feeds soul fire a colder blue."
	]
	quest.C20000000002006F.title: "Soul Sand"
	quest.C200000000020070.quest_desc: [
		"Ground from Nether glowstone, useful for brewing and for softer light sources."
	]
	quest.C200000000020070.title: "Glowstone Dust"
	quest.C200000000020071.quest_desc: [
		"Strips leaves off a tree without swinging an axe at the trunk."
	]
	quest.C200000000020071.title: "Crook"
	quest.C200000000020072.quest_desc: [
		"Pulled from the sieve in growing piles. Never quite enough for every mesh."
	]
	quest.C200000000020072.title: "String"
	quest.C200000000020073.quest_desc: [
		"Knot binder \u2014 or pad compost recipe."
	]
	quest.C200000000020073.title: "Slimeball"
	quest.C200000000020074.quest_desc: [
		"Ground down for meal, or kept whole to breed the pack's next wolf."
	]
	quest.C200000000020074.title: "Bone"
	quest.C200000000020075.quest_desc: [
		"Bitter and faintly toxic. Brewers use it, nobody eats it plain."
	]
	quest.C200000000020075.title: "Spider Eye"
	quest.C200000000020076.quest_desc: [
		"Yarn, porcelain, a Loomframe working, iron in the chest.",
		"Tension the Strand: the Grit-singers answer."
	]
	quest.C200000000020076.subtitle: "Recover"
	quest.C200000000020076.title: "Stone Knot"
	quest.C200000000020077.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.C200000000020077.title: "Seat Stone"
	quest.C200000000020078.quest_desc: [
		"A creeper, dealt with. Gunpowder is worth more than the fright."
	]
	quest.C200000000020078.title: "Boom, Later"
	quest.C200000000030079.quest_desc: [
		"Scratch rows into the pad."
	]
	quest.C200000000030079.title: "Iron Hoe"
	quest.C20000000003007A.quest_desc: [
		"Bread is infrastructure. Thirty-two wheat is a field, not a patch."
	]
	quest.C20000000003007A.title: "Wheat Field"
	quest.C20000000003007B.quest_desc: [
		"Plant what you eat."
	]
	quest.C20000000003007B.title: "Seed Pouch"
	quest.C20000000003007C.quest_desc: [
		"Speed is kindness. Compost and bones."
	]
	quest.C20000000003007C.title: "Bone Meal Engine"
	quest.C20000000003007D.quest_desc: [
		"Prep the harvest."
	]
	quest.C20000000003007D.title: "Farmers Knife"
	quest.C20000000003007E.quest_desc: [
		"A kitchen starts here."
	]
	quest.C20000000003007E.title: "Cutting Board"
	quest.C20000000003007F.quest_desc: [
		"Warm meals feed more than hunger."
	]
	quest.C20000000003007F.title: "Cooking Pot"
	quest.C200000000030080.quest_desc: [
		"Grows in tidy heads, better cooked into something than eaten raw."
	]
	quest.C200000000030080.title: "Cabbage"
	quest.C200000000030081.quest_desc: [
		"Climbs its own trellis and ripens red. Sauce starts here."
	]
	quest.C200000000030081.title: "Tomato"
	quest.C200000000030082.quest_desc: [
		"Tears of joy."
	]
	quest.C200000000030082.title: "Onion"
	quest.C200000000030083.quest_desc: [
		"Essence farming begins. Sixteen from the first row."
	]
	quest.C200000000030083.title: "Inferium"
	quest.C200000000030084.quest_desc: [
		"The seed backbone. Sieve or grow it."
	]
	quest.C200000000030084.title: "Prosperity"
	quest.C200000000030085.quest_desc: [
		"Raise seeds from essence."
	]
	quest.C200000000030085.title: "Infusion Altar"
	quest.C200000000030086.quest_desc: [
		"Four around the altar."
	]
	quest.C200000000030086.title: "Infusion Pedestal"
	quest.C200000000030087.quest_desc: [
		"Grow more pad."
	]
	quest.C200000000030087.title: "Dirt Seeds"
	quest.C200000000030088.quest_desc: [
		"Grow canopy without the axe."
	]
	quest.C200000000030088.title: "Wood Seeds"
	quest.C200000000030089.quest_desc: [
		"Grown, not mined. Harvest essence instead of swinging a pickaxe."
	]
	quest.C200000000030089.title: "Stone Seeds"
	quest.C20000000003008A.quest_desc: [
		"Metal from leaves. Recover's second engine."
	]
	quest.C20000000003008A.title: "Iron Seeds"
	quest.C20000000003008B.quest_desc: [
		"A crop that yields copper essence instead of copper ore."
	]
	quest.C20000000003008B.title: "Copper Seeds"
	quest.C20000000003008C.quest_desc: [
		"Gilded leaves that grow gold essence right on the pad."
	]
	quest.C20000000003008C.title: "Gold Seeds"
	quest.C20000000003008D.quest_desc: [
		"Turns a farm plot into a fuel source, no mining required."
	]
	quest.C20000000003008D.title: "Coal Seeds"
	quest.C20000000003008E.quest_desc: [
		"Bottled rain from a crop."
	]
	quest.C20000000003008E.title: "Water Seeds"
	quest.C20000000003008F.quest_desc: [
		"Compact growth for a small pad."
	]
	quest.C20000000003008F.title: "Botany Pot"
	quest.C200000000030090.quest_desc: [
		"The pot that harvests itself."
	]
	quest.C200000000030090.title: "Hopper Pot"
	quest.C200000000030091.quest_desc: [
		"Tier up. The seeds get greedier and better."
	]
	quest.C200000000030091.title: "Prudentium"
	quest.C200000000030092.quest_desc: [
		"A deeper grade of crop essence, stronger than the seeds you started with."
	]
	quest.C200000000030092.title: "Tertium"
	quest.C200000000030093.quest_desc: [
		"Nine meal to a block. Storage for the engine."
	]
	quest.C200000000030093.title: "Bone Block"
	quest.C200000000030094.quest_desc: [
		"Sprout surplus, stacked."
	]
	quest.C200000000030094.title: "Hay Silo"
	quest.C200000000030095.quest_desc: [
		"Better farmland. Rootbinders would approve."
	]
	quest.C200000000030095.title: "Rich Soil"
	quest.C200000000030096.quest_desc: [
		"Feed the soil that feeds you."
	]
	quest.C200000000030096.title: "Organic Compost"
	quest.C200000000030097.quest_desc: [
		"Plant a row, feed a horse, or just eat it raw."
	]
	quest.C200000000030097.title: "Carrot"
	quest.C200000000030098.quest_desc: [
		"Potato staple crop."
	]
	quest.C200000000030098.title: "Potato"
	quest.C200000000030099.quest_desc: [
		"Grows fast and dyes red. Soup, stew, or straight from the ground."
	]
	quest.C200000000030099.title: "Beetroot"
	quest.C20000000003009A.quest_desc: [
		"Melon for food and trades."
	]
	quest.C20000000003009A.title: "Melon"
	quest.C20000000003009B.quest_desc: [
		"Pumpkin for food and decor."
	]
	quest.C20000000003009B.title: "Pumpkin"
	quest.C20000000003009C.quest_desc: [
		"Paper and sugar."
	]
	quest.C20000000003009C.title: "Sugar Cane"
	quest.C20000000003009D.quest_desc: [
		"Grows without water and hurts anything that leans on it."
	]
	quest.C20000000003009D.title: "Cactus"
	quest.C20000000003009E.quest_desc: [
		"Shoots up fast and burns hot. Handy fuel for a pad short on trees."
	]
	quest.C20000000003009E.title: "Bamboo"
	quest.C20000000003009F.quest_desc: [
		"Berries while you build."
	]
	quest.C20000000003009F.title: "Sweet Berries"
	quest.C2000000000300A0.quest_desc: [
		"Grown on jungle logs, ground into the brown that flavors everything sweet."
	]
	quest.C2000000000300A0.title: "Cocoa"
	quest.C2000000000300A1.quest_desc: [
		"Falls from oak leaves on its own time. Free food, eventually."
	]
	quest.C2000000000300A1.title: "Apple"
	quest.C2000000000300A2.quest_desc: [
		"One bowl, no crafting table. The lazy farmer's dinner."
	]
	quest.C2000000000300A2.title: "Mushroom Stew"
	quest.C2000000000300A3.quest_desc: [
		"A taste of the hive before the deeper work with bees begins."
	]
	quest.C2000000000300A3.title: "Honey Bottle"
	quest.C2000000000300A4.quest_desc: [
		"Grow on cave vines and light the tunnel while you eat them."
	]
	quest.C2000000000300A4.title: "Glow Berries"
	quest.C2000000000300A5.quest_desc: [
		"The base of every potion worth bottling. Grows only on soul sand."
	]
	quest.C2000000000300A5.title: "Nether Wart"
	quest.C2000000000300A6.quest_desc: [
		"A field, a kitchen, essence rising.",
		"Tension the Strand: the Rootbinders answer."
	]
	quest.C2000000000300A6.subtitle: "Root"
	quest.C2000000000300A6.title: "Sprout Knot"
	quest.C2000000000300A7.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.C2000000000300A7.title: "Seat Sprout"
	quest.C2000000000300A8.quest_desc: [
		"Every Rootbinder pulls one eventually.",
		"Do not eat it. Do not throw it away either."
	]
	quest.C2000000000300A8.title: "Wrong Potato"
	quest.C2000000000400A9.quest_desc: [
		"Cut the void on your terms. Eight sheets of plans."
	]
	quest.C2000000000400A9.title: "Blueprint Paper"
	quest.C2000000000400AA.quest_desc: [
		"Plans in a box."
	]
	quest.C2000000000400AA.title: "Blueprint Package"
	quest.C2000000000400AB.quest_desc: [
		"The template a modular tool starts from before you add its parts."
	]
	quest.C2000000000400AB.title: "Rod Blueprint"
	quest.C2000000000400AC.quest_desc: [
		"Shape a pick that outlives its metal."
	]
	quest.C2000000000400AC.title: "Pick Blueprint"
	quest.C2000000000400AD.quest_desc: [
		"Shape an axe."
	]
	quest.C2000000000400AD.title: "Axe Blueprint"
	quest.C2000000000400AE.quest_desc: [
		"Shape a shovel."
	]
	quest.C2000000000400AE.title: "Shovel Blueprint"
	quest.C2000000000400AF.quest_desc: [
		"Shape a blade."
	]
	quest.C2000000000400AF.title: "Sword Blueprint"
	quest.C2000000000400B0.quest_desc: [
		"Room to grow."
	]
	quest.C2000000000400B0.title: "Upgrade Base"
	quest.C2000000000400B1.quest_desc: [
		"Thirty-two bars of material for parts."
	]
	quest.C2000000000400B1.title: "Iron Mass"
	quest.C2000000000400B2.quest_desc: [
		"Sharpens a blade's edge past what iron alone can manage."
	]
	quest.C2000000000400B2.title: "Diamond Tip"
	quest.C2000000000400B3.quest_desc: [
		"Leaves and wool, and combs later."
	]
	quest.C2000000000400B3.title: "Shears"
	quest.C2000000000400B4.quest_desc: [
		"Pads have edges. So do mobs."
	]
	quest.C2000000000400B4.title: "Shield"
	quest.C2000000000400B5.quest_desc: [
		"Survive the night on purpose."
	]
	quest.C2000000000400B5.title: "Iron Chestplate"
	quest.C2000000000400B6.quest_desc: [
		"Mind the drop."
	]
	quest.C2000000000400B6.title: "Iron Helmet"
	quest.C2000000000400B7.quest_desc: [
		"Covers the legs first. Most damage comes from below anyway."
	]
	quest.C2000000000400B7.title: "Iron Leggings"
	quest.C2000000000400B8.quest_desc: [
		"Steadies your footing on ledges where a slip means the void."
	]
	quest.C2000000000400B8.title: "Iron Boots"
	quest.C2000000000400B9.quest_desc: [
		"Keep the void's mobs at a distance."
	]
	quest.C2000000000400B9.title: "Bow"
	quest.C2000000000400BA.quest_desc: [
		"Sixty-four reasons to keep distance."
	]
	quest.C2000000000400BA.title: "Arrow Bundle"
	quest.C2000000000400BB.quest_desc: [
		"Light the way through."
	]
	quest.C2000000000400BB.title: "Flint and Steel"
	quest.C2000000000400BC.quest_desc: [
		"Ten blocks. A door the Edge-walkers would recognise."
	]
	quest.C2000000000400BC.title: "Obsidian Frame"
	quest.C2000000000400BD.quest_desc: [
		"Foothold prep. Somewhere else exists."
	]
	quest.C2000000000400BD.title: "Ender Eye"
	quest.C2000000000400BE.quest_desc: [
		"Soft power for hard tools."
	]
	quest.C2000000000400BE.title: "Enchanting Table"
	quest.C2000000000400BF.quest_desc: [
		"Repair and name what you carry."
	]
	quest.C2000000000400BF.title: "Anvil"
	quest.C2000000000400C0.quest_desc: [
		"Call it yours."
	]
	quest.C2000000000400C0.title: "Name Tag"
	quest.C2000000000400C1.quest_desc: [
		"The starting template for a modular hoe, built part by part."
	]
	quest.C2000000000400C1.title: "Hoe Blueprint"
	quest.C2000000000400C2.quest_desc: [
		"Clears a wide swath of crops in one swing instead of one plant."
	]
	quest.C2000000000400C2.title: "Sickle Blueprint"
	quest.C2000000000400C3.quest_desc: [
		"One tool that mines, chops, and digs. No more swapping in your hand."
	]
	quest.C2000000000400C3.title: "Paxel Blueprint"
	quest.C2000000000400C4.quest_desc: [
		"Breaks a three by three block of stone in a single hit."
	]
	quest.C2000000000400C4.title: "Hammer Blueprint"
	quest.C2000000000400C5.quest_desc: [
		"Clears wide holes in dirt and sand faster than any shovel."
	]
	quest.C2000000000400C5.title: "Excavator Blueprint"
	quest.C2000000000400C6.quest_desc: [
		"Small, fast, and precise. Built for close work, not for war."
	]
	quest.C2000000000400C6.title: "Knife Blueprint"
	quest.C2000000000400C7.quest_desc: [
		"Soft plating, easily enchanted, worth more for its magic than its defense."
	]
	quest.C2000000000400C7.title: "Gold Armor Bits"
	quest.C2000000000400C8.quest_desc: [
		"Sea claw.",
		"Optional \u2014 the void may never offer one."
	]
	quest.C2000000000400C8.title: "Trident"
	quest.C2000000000400C9.quest_desc: [
		"Loads slow, hits hard, and holds its charge until you need it."
	]
	quest.C2000000000400C9.title: "Crossbow"
	quest.C2000000000400CA.quest_desc: [
		"Scan the void."
	]
	quest.C2000000000400CA.title: "Spyglass"
	quest.C2000000000400CB.quest_desc: [
		"Plans, iron on your back, a door out.",
		"Tension the Strand: the Edge-walkers answer. The braid opens."
	]
	quest.C2000000000400CB.subtitle: "Edge"
	quest.C2000000000400CB.title: "Claw Knot"
	quest.C2000000000400CC.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.C2000000000400CC.title: "Seat Claw"
	quest.C2000000000400CD.quest_desc: [
		"Something tall looked back. Edge-walkers called them door-wardens."
	]
	quest.C2000000000400CD.title: "Edge of the Edge"
	quest.C2000000000500CE.quest_desc: [
		"A brief signal before the Hum. Sixty-four dust."
	]
	quest.C2000000000500CE.title: "Redstone Dust"
	quest.C2000000000500CF.quest_desc: [
		"Parallel heat. Eight is a line, not a furnace."
	]
	quest.C2000000000500CF.title: "Furnace Array"
	quest.C2000000000500D0.quest_desc: [
		"Move the grit without hands."
	]
	quest.C2000000000500D0.title: "Hopper Line"
	quest.C2000000000500D1.quest_desc: [
		"Measure the beat."
	]
	quest.C2000000000500D1.title: "Comparator"
	quest.C2000000000500D2.quest_desc: [
		"Bone, string, amethyst. The first beat.",
		"It yields two \u2014 keep one for the Spirit Codex."
	]
	quest.C2000000000500D2.title: "Hum: Bone Chime"
	quest.C2000000000500D3.quest_desc: [
		"A shard of old tribe song. Needs a Chime."
	]
	quest.C2000000000500D3.title: "Hum: Spirit Shard"
	quest.C2000000000500D4.quest_desc: [
		"Copper around a Chime: metal tuned to spirit."
	]
	quest.C2000000000500D4.title: "Hum: Copper Resonator"
	quest.C2000000000500D5.quest_desc: [
		"Strike it. Hold a Pulse. Listen before you wire anything.",
		"Chime, Shard, leather \u2014 the Desk sells leather."
	]
	quest.C2000000000500D5.title: "Hum: Drumheart"
	quest.C2000000000500D6.quest_desc: [
		"Carry Pulse between drum and lattice."
	]
	quest.C2000000000500D6.title: "Hum: Pulse Cell"
	quest.C2000000000500D7.quest_desc: [
		"Draw ambient ley into beats near a Drumheart."
	]
	quest.C2000000000500D7.title: "Hum: Ley Collector"
	quest.C2000000000500D8.quest_desc: [
		"Burn coal for denser beats beside Drumheart and Ley."
	]
	quest.C2000000000500D8.title: "Hum: Pulse Resonator"
	quest.C2000000000500D9.quest_desc: [
		"A buffer for Forge Energy \u2014 the bridge from Pulse to wire, if you want one."
	]
	quest.C2000000000500D9.title: "Powah Starter Cell"
	quest.C2000000000500DA.quest_desc: [
		"Burn fuel for Forge Energy."
	]
	quest.C2000000000500DA.title: "Powah Furnator"
	quest.C2000000000500DB.quest_desc: [
		"Move energy along."
	]
	quest.C2000000000500DB.title: "Powah Cable"
	quest.C2000000000500DC.quest_desc: [
		"Sky power, on a pad that is all sky."
	]
	quest.C2000000000500DC.title: "Solar Panel Starter"
	quest.C2000000000500DD.quest_desc: [
		"Burns a heat difference into power. Feed it hot on one side, cold on the other."
	]
	quest.C2000000000500DD.title: "Thermo Generator"
	quest.C2000000000500DE.quest_desc: [
		"Charge items in a ring of rods."
	]
	quest.C2000000000500DE.title: "Energizing Orb"
	quest.C2000000000500DF.quest_desc: [
		"Feed the orb."
	]
	quest.C2000000000500DF.title: "Energizing Rod"
	quest.C2000000000500E0.quest_desc: [
		"A pocketful of stored power."
	]
	quest.C2000000000500E0.title: "Battery"
	quest.C2000000000500E1.quest_desc: [
		"Rotates machines in place instead of breaking and replacing them."
	]
	quest.C2000000000500E1.title: "Wrench"
	quest.C2000000000500E2.quest_desc: [
		"Smelts ore twice as fast as a regular furnace, ore only."
	]
	quest.C2000000000500E2.title: "Blast Furnace"
	quest.C2000000000500E3.quest_desc: [
		"Cooks meat twice as fast as a campfire, food only."
	]
	quest.C2000000000500E3.title: "Smoker"
	quest.C2000000000500E4.quest_desc: [
		"Nine coal pressed dense. One block outlasts a whole stack of lumps."
	]
	quest.C2000000000500E4.title: "Coal Block (Spark)"
	quest.C2000000000500E5.quest_desc: [
		"Nudges one item at a time into whatever sits in front of it."
	]
	quest.C2000000000500E5.title: "Dropper"
	quest.C2000000000500E6.quest_desc: [
		"Push with purpose."
	]
	quest.C2000000000500E6.title: "Dispenser"
	quest.C2000000000500E7.quest_desc: [
		"Pushes a block forward on a signal, then waits for the next one."
	]
	quest.C2000000000500E7.title: "Piston"
	quest.C2000000000500E8.quest_desc: [
		"Pushes a block out and pulls it back when the signal drops."
	]
	quest.C2000000000500E8.title: "Sticky Piston"
	quest.C2000000000500E9.quest_desc: [
		"Observer reads the beat."
	]
	quest.C2000000000500E9.title: "Observer"
	quest.C2000000000500EA.quest_desc: [
		"Repeater times the circuit."
	]
	quest.C2000000000500EA.title: "Repeater"
	quest.C2000000000500EB.quest_desc: [
		"Registers a hit with signal strength based on how close to center."
	]
	quest.C2000000000500EB.title: "Target"
	quest.C2000000000500EC.quest_desc: [
		"Draws a strike away from your roof and grounds the charge."
	]
	quest.C2000000000500EC.title: "Lightning Rod"
	quest.C2000000000500ED.quest_desc: [
		"Time for power."
	]
	quest.C2000000000500ED.title: "Clock"
	quest.C2000000000500EE.quest_desc: [
		"Light without torches."
	]
	quest.C2000000000500EE.title: "Copper Bulb"
	quest.C2000000000500EF.quest_desc: [
		"Lights up on a signal and goes dark the moment it stops."
	]
	quest.C2000000000500EF.title: "Redstone Lamp"
	quest.C2000000000500F0.quest_desc: [
		"Reads the sky and sends a signal that rises and falls with the sun."
	]
	quest.C2000000000500F0.title: "Daylight Detector"
	quest.C2000000000500F1.quest_desc: [
		"Flips a signal on or off by hand. The oldest switch there is."
	]
	quest.C2000000000500F1.title: "Lever"
	quest.C2000000000500F2.quest_desc: [
		"Button taps a redstone pulse."
	]
	quest.C2000000000500F2.title: "Button"
	quest.C2000000000500F3.quest_desc: [
		"Sends a signal when something heavier than air stands on it."
	]
	quest.C2000000000500F3.title: "Pressure Plate"
	quest.C2000000000500F4.quest_desc: [
		"Strung with string across a path, it catches anything that crosses."
	]
	quest.C2000000000500F4.title: "Tripwire Hook"
	quest.C2000000000500F5.quest_desc: [
		"Plays one note per block type beneath it. Drumhearts hear a song in a row of them."
	]
	quest.C2000000000500F5.title: "Note Block"
	quest.C2000000000500F6.quest_desc: [
		"Jukebox for pad morale."
	]
	quest.C2000000000500F6.title: "Jukebox"
	quest.C2000000000500F7.quest_desc: [
		"Rolls along track under gravity or a push. No rails, no ride."
	]
	quest.C2000000000500F7.title: "Minecart"
	quest.C2000000000500F8.quest_desc: [
		"Rails across the void span."
	]
	quest.C2000000000500F8.title: "Rail"
	quest.C2000000000500F9.quest_desc: [
		"Powered rail for carts."
	]
	quest.C2000000000500F9.title: "Powered Rail"
	quest.C2000000000500FA.quest_desc: [
		"Reads a passing cart and fires a signal as it rolls over."
	]
	quest.C2000000000500FA.title: "Detector Rail"
	quest.C2000000000500FB.quest_desc: [
		"Alt solar craft."
	]
	quest.C2000000000500FB.title: "Solar Flux Cell"
