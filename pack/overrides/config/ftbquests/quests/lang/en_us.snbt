		"Stores a deep reserve of power for the machines around it."
	]
	quest.C2000000000D021E.title: "Energy Cell Basic"
	quest.C2000000000D021F.quest_desc: [
		"Burns fuel into power more efficiently than a plain furnace."
	]
	quest.C2000000000D021F.title: "Furnator Basic"
