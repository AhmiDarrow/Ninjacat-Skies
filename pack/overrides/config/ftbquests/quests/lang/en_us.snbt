	quest.C20000000006012D.title: "Train Door"
	quest.C20000000006012E.quest_desc: [
		"Schedule train routes."
	]
	quest.C20000000006012E.title: "Schedule"
	quest.C20000000006012F.quest_desc: [
		"Shows a number from elsewhere on a block you can actually see."
	]
	quest.C20000000006012F.title: "Display Link"
	quest.C200000000060130.quest_desc: [
		"Display board shows data."
	]
	quest.C200000000060130.title: "Display Board"
	quest.C200000000060131.quest_desc: [
		"Fires a potato hard enough to knock something back. Mostly for laughs."
	]
	quest.C200000000060131.title: "Potato Cannon"
	quest.C200000000060132.quest_desc: [
		"Reaches and breaks blocks from further away than your arm allows."
	]
	quest.C200000000060132.title: "Extendo Grip"
	quest.C200000000060133.quest_desc: [
		"A wheel, a press, a mixer, a fan, a clockwork heart.",
		"Tension the Strand: the Pattern-weavers answer."
	]
	quest.C200000000060133.subtitle: "Pattern"
	quest.C200000000060133.title: "Clock Knot"
	quest.C200000000060134.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.C200000000060134.title: "Seat Clock"
	quest.C200000000060135.quest_desc: [
		"Twenty skeletons. The pattern holds if you keep the lights on."
	]
	quest.C200000000060135.title: "Rattle in the Gears"
	quest.C200000000070136.quest_desc: [
		"Place the oak nest on the pad and wait. Something with wings will come out of the wood.",
		"Look at it. That counts."
	]
	quest.C200000000070136.subtitle: "Colony"
	quest.C200000000070136.title: "First Wings"
	quest.C200000000070137.quest_desc: [
		"Eight oak logs around a small flower. Place it; the wood remembers wings."
	]
	quest.C200000000070137.title: "Ring of Oak"
	quest.C200000000070138.quest_desc: [
		"Bone meal on grass. Bees will not stay where nothing blooms."
	]
	quest.C200000000070138.title: "A Flower to Argue Over"
	quest.C200000000070139.quest_desc: [
		"Planks and flowers \u2014 a home a wild bee will move into."
	]
	quest.C200000000070139.title: "Bee Nest"
	quest.C20000000007013A.quest_desc: [
		"Colonies in the wind. The Desk sells comb if none drift by."
	]
	quest.C20000000007013A.title: "Honeycomb"
	quest.C20000000007013B.quest_desc: [
		"A home for workers."
	]
	quest.C20000000007013B.title: "Beehive"
	quest.C20000000007013C.quest_desc: [
		"Sweet, sticky, and worth more to a furnace than to your stomach."
	]
	quest.C20000000007013C.title: "Honey Bottle (Swarm)"
	quest.C20000000007013D.quest_desc: [
		"A snack that calms an agitated bee before you reach into the hive."
	]
	quest.C20000000007013D.title: "Honey Treat"
	quest.C20000000007013E.quest_desc: [
		"Gravel around a flower. Mining bees and diggers like the dust."
	]
	quest.C20000000007013E.title: "Ring of Grit"
	quest.C20000000007013F.quest_desc: [
		"Coarse dirt around a flower. Leafcutters and ashy miners."
	]
	quest.C20000000007013F.title: "Ring of Coarse Dirt"
	quest.C200000000070140.quest_desc: [
		"Stone around a flower. Mason bees, and diggers that eat rock."
	]
	quest.C200000000070140.title: "Ring of Stone"
	quest.C200000000070141.quest_desc: [
		"A productive home."
	]
	quest.C200000000070141.title: "Advanced Beehive"
	quest.C200000000070142.quest_desc: [
		"Gives a hive more room before it swarms looking for a new one."
	]
	quest.C200000000070142.title: "Expansion Box"
	quest.C200000000070143.quest_desc: [
		"Bottles the yield without a hand on it."
	]
	quest.C200000000070143.title: "Bottler"
	quest.C200000000070144.quest_desc: [
		"Spin combs into everything they hide."
	]
	quest.C200000000070144.title: "Centrifuge"
	quest.C200000000070145.quest_desc: [
		"The same, faster, on power."
	]
	quest.C200000000070145.title: "Powered Centrifuge"
	quest.C200000000070146.quest_desc: [
		"Nets a bee out of the air without a single sting."
	]
	quest.C200000000070146.title: "Catcher"
	quest.C200000000070147.quest_desc: [
		"Carry a bee like a lantern."
	]
	quest.C200000000070147.title: "Bee Cage"
	quest.C200000000070148.quest_desc: [
		"Hatch the genes you want."
	]
	quest.C200000000070148.title: "Incubator"
	quest.C200000000070149.quest_desc: [
		"Pair two colonies on purpose."
	]
	quest.C200000000070149.title: "Breeding Chamber"
	quest.C20000000007014A.quest_desc: [
		"Sort traits like seed."
	]
	quest.C20000000007014A.title: "Gene Indexer"
	quest.C20000000007014B.quest_desc: [
		"A stack of treats: the colony's payroll."
	]
	quest.C20000000007014B.title: "Feed Upgrade"
	quest.C20000000007014C.quest_desc: [
		"One of the deeper essence crops, grown far past the basics."
	]
	quest.C20000000007014C.title: "Diamond Seeds"
	quest.C20000000007014D.quest_desc: [
		"A farm plot that yields dust instead of digging for it."
	]
	quest.C20000000007014D.title: "Redstone Seeds"
	quest.C20000000007014E.quest_desc: [
		"Grows the blue essence enchanting tables are always hungry for."
	]
	quest.C20000000007014E.title: "Lapis Seeds"
	quest.C20000000007014F.quest_desc: [
		"Quartz grown on leaves instead of dug from Nether caves."
	]
	quest.C20000000007014F.title: "Nether Quartz Seeds"
