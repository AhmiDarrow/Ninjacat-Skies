		"Drill through grit blocks."
	]
	quest.C200000000060115.title: "Mechanical Drill"
	quest.C200000000060116.quest_desc: [
		"Cut crops in a spinning arc."
	]
	quest.C200000000060116.title: "Mechanical Harvester"
