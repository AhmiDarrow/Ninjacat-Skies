	quest.42000000000E023F.title: "Dominion Wand"
	quest.42000000000E0240.quest_desc: [
		"Marks an item as allowed when set into a filter."
	]
	quest.42000000000E0240.title: "Allow Scroll"
	quest.42000000000E0241.quest_desc: [
		"Marks an item as denied when set into a filter."
	]
	quest.42000000000E0241.title: "Deny Scroll"
	quest.42000000000F0242.quest_desc: [
		"Logs around a Binding Knot, Thread on top. Place it on the pad.",
		"Stand near it: the pad starts mending you once a Strand is seated."
	]
	quest.42000000000F0242.title: "Raise the Post"
	quest.42000000000F0243.quest_desc: [
		"Hub Key in hand, or /clowder hub. Every Clowder on the server meets here.",
		"/clowder return brings you home."
	]
	quest.42000000000F0243.title: "Enter the Hall"
	quest.42000000000F0244.quest_desc: [
		"Above the Dock stands a slow dark column: the cut itself.",
		"It thins as Clowders seat Strands. Come back and check it now and then."
	]
	quest.42000000000F0244.title: "Look at the Fray"
	quest.42000000000F0245.quest_desc: [
		"Name a pad as yours."
	]
	quest.42000000000F0245.title: "Island Charter"
	quest.42000000000F0246.quest_desc: [
		"Opens the way back to the Clowder Hall from anywhere on the Strand."
	]
	quest.42000000000F0246.title: "Hub Key"
	quest.42000000000F0247.quest_desc: [
		"A banner pattern that marks how far your Strand has come."
	]
	quest.42000000000F0247.title: "Strand Banner"
	quest.42000000000F0248.quest_desc: [
		"Open the Codex path."
	]
	quest.42000000000F0248.title: "Quest Book"
	quest.42000000000F0249.quest_desc: [
		"Stay fed on claim runs."
	]
	quest.42000000000F0249.title: "Chunk Claim Snack"
	quest.42000000000F024A.quest_desc: [
		"Charts the pads around you as your Clowder spreads outward."
	]
