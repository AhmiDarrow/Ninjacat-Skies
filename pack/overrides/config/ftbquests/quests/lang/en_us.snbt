	quest.42000000002004E9.title: "Supercharged Coil"
	quest.42000000002004EA.quest_desc: [
		"Spins isotopes apart for late-game chemistry."
	]
	quest.42000000002004EA.title: "Isotopic Centrifuge"
	quest.42000000002004EB.quest_desc: [
		"Dissolves ore into a chemical slurry."
	]
	quest.42000000002004EB.title: "Chem Dissolution"
	quest.42000000002004EC.quest_desc: [
		"Washes slurry clean before it's crystallized."
	]
	quest.42000000002004EC.title: "Chem Washer"
	quest.42000000002004ED.quest_desc: [
		"Turns a chemical back into a solid crystal."
	]
	quest.42000000002004ED.title: "Chem Crystallizer"
	quest.42000000002004EE.quest_desc: [
		"Bombards material with sunlight-driven neutrons."
	]
	quest.42000000002004EE.title: "Solar Neutron"
	quest.42000000002004EF.quest_desc: [
		"Turns power directly into heat for a boiler."
	]
	quest.42000000002004EF.title: "Resistive Heater"
	quest.42000000002004F0.quest_desc: [
		"Burns wood for heat instead of power."
	]
	quest.42000000002004F0.title: "Fuelwood Heater"
	quest.42000000002004F1.quest_desc: [
		"Late-game synthesis of otherwise impossible materials."
	]
	quest.42000000002004F1.title: "Antiprotonic"
	quest.42000000002004F2.quest_desc: [
		"One modular tool for mining, digging, and more."
	]
	quest.42000000002004F2.title: "Meka Tool"
	quest.42000000002004F3.quest_desc: [
		"Suit armor for the head, upgraded module by module."
	]
	quest.42000000002004F3.title: "Meka Helmet"
	quest.42000000002004F4.quest_desc: [
		"Suit armor for the chest, upgraded module by module."
	]
	quest.42000000002004F4.title: "Meka Body"
	quest.42000000002004F5.quest_desc: [
		"Suit armor for the legs, upgraded module by module."
	]
	quest.42000000002004F5.title: "Meka Pants"
	quest.42000000002004F6.quest_desc: [
		"Suit armor for the feet, upgraded module by module."
	]
	quest.42000000002004F6.title: "Meka Boots"
	quest.42000000002004F7.quest_desc: [
		"Shell for a steam boiler."
	]
	quest.42000000002004F7.title: "Boiler Casing"
	quest.42000000002004F8.quest_desc: [
		"Stores a large amount of power."
	]
	quest.42000000002004F8.title: "Elite Energy Cube"
	quest.42000000002004F9.quest_desc: [
		"Stores a moderate amount of power."
	]
	quest.42000000002004F9.title: "Adv Energy Cube"
	quest.42000000002004FA.quest_desc: [
		"Stores a small amount of power, good for starting out."
	]
	quest.42000000002004FA.title: "Basic Energy Cube (QIO)"
	quest.42000000002004FB.quest_desc: [
		"Infuses metal with a chemical for new alloys."
	]
	quest.42000000002004FB.title: "Metallurgic Infuser (QIO)"
	quest.42000000002004FC.quest_desc: [
		"Doubles the output of raw ore before it's smelted."
	]
	quest.42000000002004FC.title: "Enrichment Chamber (QIO)"
	quest.42000000002004FD.quest_desc: [
		"Mill or crush bulk materials."
	]
	quest.42000000002004FD.title: "Crusher (QIO)"
	quest.42000000002004FE.quest_desc: [
		"Smelts faster than a furnace, on power instead of fuel."
	]
	quest.42000000002004FE.title: "Energized Smelter (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Cuts wood with Mekanism's own precision blade."
	]
	quest.42000000002004FF.title: "Precision Sawmill"
	quest.4200000000200500.quest_desc: [
		"Splits water into its two component gases."
	]
	quest.4200000000200500.title: "Electrolytic Sep"
	quest.4200000000200501.quest_desc: [
		"Combines two chemicals into a new one."
	]
	quest.4200000000200501.title: "Chemical Infuser"
	quest.4200000000200502.quest_desc: [
		"Purify fluids or ores."
	]
	quest.4200000000200502.title: "Purification"
	quest.4200000000200503.quest_desc: [
		"Injects a chemical into ore for extra yield."
	]
	quest.4200000000200503.title: "Chem Injection"
	quest.4200000000200504.quest_desc: [
		"Compresses osmium onto items for tougher gear."
	]
	quest.4200000000200504.title: "Osmium Compressor (QIO)"
	quest.4200000000200505.quest_desc: [
		"Combines several components into one finished piece."
	]
	quest.4200000000200505.title: "Combiner"
	quest.4200000000210506.quest_desc: [
		"Zombies drop it whether you want it or not."
	]
	quest.4200000000210506.title: "Rotten Flesh Stock"
	quest.4200000000210507.quest_desc: [
		"Skeletons leave these behind; grind them for meal later."
	]
	quest.4200000000210507.title: "Bone Stock"
	quest.4200000000210508.quest_desc: [
		"Creepers pay this out, sometimes explosively."
	]
	quest.4200000000210508.title: "Gunpowder Stock"
	quest.4200000000210509.quest_desc: [
		"Spiders drop it, and a sieve never will."
	]
	quest.4200000000210509.title: "String Stock"
	quest.420000000021050A.quest_desc: [
		"Brews poison and feeds a few odd recipes."
	]
	quest.420000000021050A.title: "Spider Eye Stock"
	quest.420000000021050B.quest_desc: [
		"Endermen drop these; a farm beats begging the void for them."
	]
	quest.420000000021050B.title: "Ender Pearl Farm"
	quest.420000000021050C.quest_desc: [
		"Fuel for brewing stands and blaze burners alike."
	]
	quest.420000000021050C.title: "Blaze Rod Farm"
	quest.420000000021050D.quest_desc: [
		"A rare drop, key for regeneration potions."
	]
	quest.420000000021050D.title: "Ghast Tear Farm"
	quest.420000000021050E.quest_desc: [
		"Brews fire resistance and feeds a few crafts."
	]
	quest.420000000021050E.title: "Magma Cream Farm"
	quest.420000000021050F.quest_desc: [
		"Sticky enough for pistons, slime blocks, and leads."
	]
	quest.420000000021050F.title: "Slimeball Farm"
	quest.4200000000210510.quest_desc: [
		"Three of these summon a boss worth fighting for."
	]
	quest.4200000000210510.title: "Wither Skull"
	quest.4200000000210511.quest_desc: [
		"The wither's own tax, rare and heavy with power."
	]
	quest.4200000000210511.title: "Nether Star"
	quest.4200000000210512.quest_desc: [
		"Crafts a shulker box, storage that survives death."
	]
	quest.4200000000210512.title: "Shulker Shell Farm"
	quest.4200000000210513.quest_desc: [
		"Repairs elytra when nothing else will."
	]
	quest.4200000000210513.title: "Phantom Membrane"
	quest.4200000000210514.quest_desc: [
		"Squid ink, useful for dye and old-fashioned writing."
	]
	quest.4200000000210514.title: "Ink Sac Farm"
	quest.4200000000210515.quest_desc: [
		"Makes signs and item frames glow in the dark."
	]
	quest.4200000000210515.title: "Glow Ink"
	quest.4200000000210516.quest_desc: [
		"Guardians drop it for prismarine blocks and lanterns."
	]
	quest.4200000000210516.title: "Prismarine Shard"
	quest.4200000000210517.quest_desc: [
		"Guardian drop that lights the sea and fuels a few crafts."
	]
	quest.4200000000210517.title: "Prismarine Crystal"
	quest.4200000000210518.quest_desc: [
		"Rings a conduit; gather eight to finish the frame."
	]
	quest.4200000000210518.title: "Nautilus Shell (Hunt)"
	quest.4200000000210519.quest_desc: [
		"Cheats death once, then it's gone."
	]
	quest.4200000000210519.title: "Totem (Hunt)"
	quest.420000000021051A.quest_desc: [
		"Golems shed iron while they stand guard."
	]
	quest.420000000021051A.title: "Iron Golem Gift"
	quest.420000000021051B.quest_desc: [
		"Throws snowballs; useful ammunition, not much of a fighter."
	]
	quest.420000000021051B.title: "Snow Golem"
	quest.420000000021051C.quest_desc: [
		"Skeletons keep the pad stocked with ammunition."
	]
	quest.420000000021051C.title: "Arrow Farm"
	quest.420000000021051D.quest_desc: [
		"Marks whatever it hits with a temporary glow."
	]
	quest.420000000021051D.title: "Spectral Arrow"
	quest.420000000021051E.quest_desc: [
		"Mount when you find a saddle.",
		"Optional — the void may never offer one."
	]
	quest.420000000021051E.title: "Saddle (Hunt)"
	quest.420000000021051F.quest_desc: [
		"Names a mob so it never despawns."
	]
	quest.420000000021051F.title: "Name Tag Farm"
	quest.4200000000210520.quest_desc: [
		"Tether a link or cable."
	]
	quest.4200000000210520.title: "Lead (Hunt)"
	quest.4200000000210521.quest_desc: [
		"Chickens lay them faster than you can collect."
	]
	quest.4200000000210521.title: "Egg Stock"
	quest.4200000000210522.quest_desc: [
		"Leather and beef stock."
	]
	quest.4200000000210522.title: "Leather Stock"
	quest.4200000000210523.quest_desc: [
		"Sheep grow it back after a trim."
	]
	quest.4200000000210523.title: "Wool Stock"
	quest.4200000000210524.quest_desc: [
		"Food stock for the kitchen."
	]
	quest.4200000000210524.title: "Beef Stock"
	quest.4200000000210525.quest_desc: [
		"Pigs provide it, cook it before eating."
	]
	quest.4200000000210525.title: "Pork Stock"
	quest.4200000000210526.quest_desc: [
		"Chicken for meals and feathers."
	]
	quest.4200000000210526.title: "Chicken Stock"
	quest.4200000000210527.quest_desc: [
		"Sheep meat, better roasted than raw."
	]
	quest.4200000000210527.title: "Mutton Stock"
	quest.4200000000210528.quest_desc: [
		"Brews a potion of luck, if you can spare one."
	]
	quest.4200000000210528.title: "Rabbit Foot"
	quest.4200000000210529.quest_desc: [
		"A showpiece worth setting beside a dragon egg."
	]
	quest.4200000000210529.title: "Zombie Head"
	quest.420000000021052A.quest_desc: [
		"Pairs nicely with a dragon egg on a shelf."
	]
	quest.420000000021052A.title: "Skeleton Skull"
	quest.420000000021052B.quest_desc: [
		"Another head for the trophy shelf by the egg."
	]
	quest.420000000021052B.title: "Creeper Head"
	quest.420000000021052C.quest_desc: [
		"One more head, at home near a dragon egg."
	]
	quest.420000000021052C.title: "Piglin Head"
	quest.420000000021052D.quest_desc: [
		"The rarest head, earned only after the fight is over."
	]
	quest.420000000021052D.title: "Dragon Head"
	quest.420000000021052E.quest_desc: [
		"Only if a player happens to drop one."
	]
	quest.420000000021052E.title: "Player Head"
	quest.420000000022052F.quest_desc: [
		"First craft yields 2 — keep one for Codex later."
	]
	quest.420000000022052F.title: "Bone Chime"
	quest.4200000000220530.quest_desc: [
		"Shard of old tribe song — needs a Chime."
	]
	quest.4200000000220530.title: "Spirit Shard"
	quest.4200000000220531.quest_desc: [
		"Tune metal to spirit — copper around a Chime."
	]
	quest.4200000000220531.title: "Copper Resonator"
	quest.4200000000220532.quest_desc: [
		"Mark the lattice lines — chalk needs a Shard."
	]
	quest.4200000000220532.title: "Ritual Chalk (Tribal)"
	quest.4200000000220533.quest_desc: [
		"Place the heart — Chime + Shard + leather (Desk sells leather)."
	]
	quest.4200000000220533.title: "Drumheart Beat"
	quest.4200000000220534.quest_desc: [
		"Nine tribes hummed once — needs a spare Chime + Shard."
	]
	quest.4200000000220534.title: "Spirit Codex"
	quest.4200000000220535.quest_desc: [
		"Draw ley into beats."
	]
	quest.4200000000220535.title: "Ley Collector"
	quest.4200000000220536.quest_desc: [
		"Carry a measure of Pulse."
	]
	quest.4200000000220536.title: "Pulse Cell"
	quest.4200000000220537.quest_desc: [
		"Seat a reusable Echo catalyst; add two different totem voices within eight blocks. More voices strengthen the song. Redstone pauses it."
	]
	quest.4200000000220537.title: "Pulse Resonator"
	quest.4200000000220538.quest_desc: [
		"Tribe of stone answers."
	]
	quest.4200000000220538.title: "Earth Totem"
	quest.4200000000220539.quest_desc: [
		"Tribe of flame answers."
	]
	quest.4200000000220539.title: "Fire Totem"
	quest.420000000022053A.quest_desc: [
		"Tribe of tide answers."
	]
	quest.420000000022053A.title: "Water Totem"
	quest.420000000022053B.quest_desc: [
		"Tribe of wind answers."
	]
	quest.420000000022053B.title: "Air Totem"
	quest.420000000022053C.quest_desc: [
		"Fifth tribe — steward core."
	]
	quest.420000000022053C.title: "Spirit Totem"
	quest.420000000022053D.quest_desc: [
		"Start the lattice song."
	]
	quest.420000000022053D.title: "Song Bench"
	quest.420000000022053E.quest_desc: [
		"Route harmonics between totems."
	]
	quest.420000000022053E.title: "Lattice Conductor"
	quest.420000000022053F.quest_desc: [
		"Hum stage one — break the ore."
	]
	quest.420000000022053F.title: "Echo Shatter"
	quest.4200000000220540.quest_desc: [
		"Shard that heard the shatter."
	]
	quest.4200000000220540.title: "Echo Shard (Tribal)"
	quest.4200000000220541.quest_desc: [
		"Hum stage two — attune."
	]
	quest.4200000000220541.title: "Echo Attune"
	quest.4200000000220542.quest_desc: [
		"Echo that found a key."
	]
	quest.4200000000220542.title: "Attuned Echo"
	quest.4200000000220543.quest_desc: [
		"Bind stage — knot spirit to metal."
	]
	quest.4200000000220543.title: "Echo Bind"
	quest.4200000000220544.quest_desc: [
		"Echo that will not slip."
	]
	quest.4200000000220544.title: "Bound Echo"
	quest.4200000000220545.quest_desc: [
		"Reweave stage — call the ingot."
	]
	quest.4200000000220545.title: "Echo Manifest"
	quest.4200000000220546.quest_desc: [
		"Metal willed into being by Spirit Pulse instead of a furnace."
	]
	quest.4200000000220546.title: "Manifested Ingot"
	quest.4200000000220547.quest_desc: [
		"Keep what the tribes left."
	]
	quest.4200000000220547.title: "Ancestral Cache"
	quest.4200000000220548.quest_desc: [
		"Vault linked toward The March."
	]
	quest.4200000000220548.title: "Deep Cache"
	quest.4200000000220549.quest_desc: [
		"An unwritten seal, waiting for a rite to fill it."
	]
	quest.4200000000220549.title: "Blank Seal"
	quest.420000000022054A.quest_desc: [
		"Seal of the stone tribe."
	]
	quest.420000000022054A.title: "Earth Seal"
	quest.420000000022054B.quest_desc: [
		"Seal of the flame tribe."
	]
	quest.420000000022054B.title: "Fire Seal"
	quest.420000000022054C.quest_desc: [
		"Seal of the tide tribe."
	]
	quest.420000000022054C.title: "Water Seal"
	quest.420000000022054D.quest_desc: [
		"Seal of the wind tribe."
	]
	quest.420000000022054D.title: "Air Seal"
	quest.420000000022054E.quest_desc: [
		"Seal of the steward tribe."
	]
	quest.420000000022054E.title: "Spirit Seal"
	quest.420000000022054F.quest_desc: [
		"Offer seals. Ask the Loom."
	]
	quest.420000000022054F.title: "Rite Pedestal"
	quest.4200000000220550.quest_desc: [
		"Strike open The March."
	]
	quest.4200000000220550.title: "Gate Drum (Tribal)"
	quest.4200000000220551.quest_desc: [
		"Dress your camp's threshold with a carved spirit frame. Compasses and the Gate Drum perform travel."
	]
	quest.4200000000220551.title: "Spirit Door"
	quest.4200000000220552.quest_desc: [
		"Tool that spends Pulse."
	]
	quest.4200000000220552.title: "Spiritgear Pick"
	quest.4200000000220553.quest_desc: [
		"Edge that spends Pulse."
	]
	quest.4200000000220553.title: "Spiritgear Blade"
	quest.4200000000220554.quest_desc: [
		"Stone from the March, underfoot in a place that shouldn't exist."
	]
	quest.4200000000220554.title: "March Stone (Tribal)"
	quest.4200000000220555.quest_desc: [
		"Rubble from the March, plain but plentiful."
	]
	quest.4200000000220555.title: "March Cobble"
	quest.4200000000220556.quest_desc: [
		"Wood grown somewhere the sun doesn't reach."
	]
	quest.4200000000220556.title: "March Log"
	quest.4200000000220557.quest_desc: [
		"Sawn timber from the March, sturdy despite where it came from."
	]
	quest.4200000000220557.title: "March Planks"
	quest.4200000000220558.quest_desc: [
		"Leaves that murmur even without any wind."
	]
	quest.4200000000220558.title: "March Leaf"
	quest.4200000000220559.quest_desc: [
		"A reed that hums with leftover Spirit Pulse."
	]
	quest.4200000000220559.title: "Spirit Reed (Tribal)"
	quest.420000000022055A.quest_desc: [
		"Feed raw iron into Echo Shatter beside an Earth Totem. Two grits emerge; smelt or blast them into ingots. Other mods can supply tagged raw metals."
	]
	quest.420000000022055A.title: "Ore remembers twice"
	quest.420000000022055B.quest_desc: [
		"Water binds wool into Spiritweave. Feed the station above or from its sides and draw finished work out below."
	]
	quest.420000000022055B.title: "Cloth with a voice"
	quest.420000000022055C.quest_desc: [
		"Manifest a Manifested Ingot again under Spirit. The Resonant Core opens stronger equipment and distant paths."
	]
	quest.420000000022055C.title: "The living heart"
	quest.420000000022055D.quest_desc: [
		"Carry 1,200 Pulse in one Greater Cell. Charge it at a Drumheart or Resonator before setting out."
	]
	quest.420000000022055D.title: "A longer song"
	quest.420000000022055E.quest_desc: [
		"Sixteen buckets in one cistern. Buckets and fluid pipes both work. A comparator reads fullness; redstone locks filling and draining."
	]
	quest.420000000022055E.title: "Rain held in copper"
	quest.420000000022055F.quest_desc: [
		"Touch the destination face with the tuner, then touch a relay. Sneak-use to replace your marked destination."
	]
	quest.420000000022055F.title: "Name the far end"
	quest.4200000000220560.quest_desc: [
		"Place above a source inventory. Local cargo reaches 32 blocks, moving up to 16 items each second for 4 Pulse. Redstone pauses the relay."
	]
	quest.4200000000220560.title: "A path for supplies"
	quest.4200000000220561.quest_desc: [
		"Place above a source tank and bind a receiving face. Local fluid reaches 32 blocks: 250 mB per second for 4 Pulse. Both ends must be loaded."
	]
	quest.4200000000220561.title: "A path for rain"
	quest.4200000000220562.quest_desc: [
		"Longreach carries items up to 128 blocks for 8 Pulse per successful beat. Use standard inventories from any compatible mod."
	]
	quest.4200000000220562.title: "Across the workshop"
	quest.4200000000220563.quest_desc: [
		"Longreach carries fluids up to 128 blocks for 8 Pulse per beat. Full receivers pause safely; redstone can lock the receiving cistern."
	]
	quest.4200000000220563.title: "Across the waterworks"
	quest.4200000000220564.quest_desc: [
		"Bridge Tribal Power into Mekanism, Powah or AE2 energy acceptors. Each Pulse becomes 100 FE, up to 2,000 FE per second. Redstone stops conversion and export."
	]
	quest.4200000000220564.title: "The beat becomes current"
	quest.4200000000220565.quest_desc: [
		"Sneak-use to cycle Earth, Fire, Water, Air and Spirit. Use to cast. Carry charged cells; the Spirit Codex explains each spell and its cost."
	]
	quest.4200000000220565.title: "Five voices in one hand"
	quest.4200000000220566.quest_desc: [
		"Main hand, sneak-use a stone face: a deliberate three-by-three cut at 8 Pulse per block. Normal breaking protection and tool requirements still apply."
	]
	quest.4200000000220566.title: "Stone yields a doorway"
	quest.4200000000220567.quest_desc: [
		"The hood lends night sight while charged cells sustain it. Each active Spiritweave piece draws 2 Pulse every four seconds."
	]
	quest.4200000000220567.title: "Eyes in the quiet"
	quest.4200000000220568.quest_desc: [
		"The robe grants resistance. Wear it into the work and keep your cells charged."
	]
	quest.4200000000220568.title: "A woven shelter"
	quest.4200000000220569.quest_desc: [
		"Woven leggings lend speed. Their Pulse cost is separate from the other pieces."
	]
	quest.4200000000220569.title: "The camp keeps pace"
	quest.420000000022056A.quest_desc: [
		"Boots can lend slow falling during descent while Pulse remains. A bound return path is still worth carrying."
	]
	quest.420000000022056A.title: "A gentler descent"
	quest.420000000022056B.quest_desc: [
		"Seat a reusable seal beside its matching totem. A six-block blessing costs 8 Pulse every two seconds. High redstone pauses it; sneak empty-handed to recover the seal."
	]
	quest.420000000022056B.title: "A blessing that stays"
	quest.420000000022056C.quest_desc: [
		"Sneak-use the top of a solid floor to bind it. Return within 128 blocks in the same world for 20 Pulse. Power the landing floor to lock arrivals."
	]
	quest.420000000022056C.title: "The first return path"
	quest.420000000022056D.quest_desc: [
		"Return across any distance within one dimension for 40 Pulse. Leave a dry landing with two clear blocks above it."
	]
	quest.420000000022056D.title: "Beyond the horizon"
	quest.420000000022056E.quest_desc: [
		"Seek March Crystal beyond the Gate Drum. Astral paths for people, items and fluids all draw on the same late-game material."
	]
	quest.420000000022056E.title: "A voice beyond the veil"
	quest.420000000022056F.quest_desc: [
		"The final compass crosses dimensions for 100 Pulse. Bind a safe return before exploring. Travel waits five seconds between uses."
	]
	quest.420000000022056F.title: "A path between worlds"
	quest.4200000000220570.quest_desc: [
		"Astral cargo crosses dimensions without a distance limit. Each successful beat costs 16 Pulse. The receiver must already be loaded; no hidden chunk loading."
	]
	quest.4200000000220570.title: "Supplies cross the veil"
	quest.4200000000220571.quest_desc: [
		"Astral fluid follows the same dimensional tier as players and items. Keep the destination tank loaded. A full tank or unloaded world pauses without consuming cargo."
	]
	quest.4200000000220571.title: "Rain crosses the veil"
	quest.4200000000220572.quest_desc: [
		"Open your personal 54-slot Deep Cache from the road. This is the same vault, shared between your caches and satchel. March attunement removes its opening cost."
	]
	quest.4200000000220572.title: "The camp in your keeping"
	quest.4200000000220573.quest_desc: [
		"The Gate opens onto a living country. Some creatures still carry the old song; others guard its broken pieces. Brush the gentle ones. Face the guardians with charged cells and a return route."
	]
	quest.4200000000220573.title: "The Returning Song"
	quest.4200000000220574.quest_desc: [
		"A dawn grazer that carries the old forest song in its antlers. Breed with wheat; brush adults for Dawn Velvet.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.4200000000220574.title: "Dawn Stag: a song returned"
	quest.4200000000220575.quest_desc: [
		"A shy dusk forager whose tail marks safe paths. Breed with sweet berries; brush adults for Lantern Down.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.4200000000220575.title: "Lantern Fox: a song returned"
	quest.4200000000220576.quest_desc: [
		"A patient wetland gardener with a living shell. Breed with seagrass; brush adults for a naturally shed Mossback Scale.",
		"Seek it in Overworld swamps and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.4200000000220576.title: "Mossback: a song returned"
	quest.4200000000220577.quest_desc: [
		"The remains of a broken fire rite. Its melee strikes briefly ignite; keep water close.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.4200000000220577.title: "Ashbound: a song returned"
	quest.4200000000220578.quest_desc: [
		"A grove guardian twisted by a severed ley line. Slow but sturdy; its blows root travellers briefly.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.4200000000220578.title: "Rootbound: a song returned"
	quest.4200000000220579.quest_desc: [
		"A marsh hunter concealed among spirit reeds. Fast strikes carry a short poison.",
		"Seek it in Overworld swamps and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.4200000000220579.title: "Reed Stalker: a song returned"
	quest.420000000022057A.quest_desc: [
		"A crystal-field scavenger armored in singing stone. Keep your distance from its heavy shove.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.420000000022057A.title: "Shardback: a song returned"
	quest.420000000022057B.quest_desc: [
		"An empty watchman that still guards the ancient roads. Its touch weakens the grip of attackers.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.420000000022057B.title: "Hollow Sentinel: a song returned"
	quest.420000000022057C.quest_desc: [
		"A storm-fed spirit with vast veil wings. A bright gathering of motes warns of its gust; cover breaks the attack.",
		"Seek it in the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.420000000022057C.title: "Storm Moth: a song returned"
	quest.420000000022057D.quest_desc: [
		"A nimble ember spirit. It gathers sparks before a burning bolt; the spell never ignites terrain.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.420000000022057D.title: "Cinder Imp: a song returned"
	quest.420000000022057E.quest_desc: [
		"A floating relic that remembers the lost tribes. Its telegraphed chime slows; shelter interrupts the song.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.420000000022057E.title: "Mourning Bell: a song returned"
	quest.420000000022057F.quest_desc: [
		"A hunter drawn to tears in the lattice. It closes distance quickly but cannot cross worlds by itself.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.420000000022057F.title: "Rift Hound: a song returned"
	quest.4200000000220580.quest_desc: [
		"An eight-legged keeper of broken songs. Its bite slows prey without placing webs or damaging the camp.",
		"Seek it in the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness."
	]
	quest.4200000000220580.title: "Echo Weaver: a song returned"
	quest.4200000000220581.quest_desc: [
		"The field notes are complete. The gentle harvests and recovered relics have become cloth and Echoes again. Beneath the night veil, the camp answers with a fuller song.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign."
	]
	quest.4200000000220581.title: "Thirteen voices, one sky"
	quest.4200000000220582.quest_desc: [
		"Hang the camp's song in copper. A Spirit Lantern gives full light without fuel; redstone dims it. Mark safe paths back from the dark."
	]
	quest.4200000000220582.title: "A light for the returning"
	quest.4200000000220583.quest_desc: [
		"The chime is both ornament and instrument. Its comparator gives 0 in clear skies, 8 in rain and 15 in thunder. Redstone silences it."
	]
	quest.4200000000220583.title: "Listen to the weather"
	quest.4200000000220584.quest_desc: [
		"A carved table holds 27 stacks. Standard item pipes and relays can share its offerings; comparators read fullness and redstone locks access."
	]
	quest.4200000000220584.title: "A place at the hearth"
	quest.4200000000220585.quest_desc: [
		"Place the tender at crop height in a 9-by-9 bed. Put seeds in the first row; harvests fill the lower two rows. Planting costs 4 Pulse, harvest and replant costs 12. Supply power within eight blocks. A full output preserves the crop; redstone pauses the work."
	]
	quest.4200000000220585.title: "The garden keeps singing"
	quest.4200000000220586.quest_desc: [
		"Eight Pulse each second wards hostile spawning within 24 blocks. Existing creatures remain. The ward also prevents hostile cradle summons, so keep your summoning ground outside it. Redstone immediately silences the ward."
	]
	quest.4200000000220586.title: "Quiet at the camp edge"
	quest.4200000000220587.quest_desc: [
		"The Wayanchor holds its own chunk awake for 16 Pulse each second. Place one at a distant relay receiver and sustain its local power supply. At most 32 anchors may run in one dimension. Redstone or an empty buffer releases the chunk."
	]
	quest.4200000000220587.title: "A camp that remembers"
	quest.4200000000220588.quest_desc: [
		"Sneak-use an uncharged effigy on a supported creature to take a harmless imprint. The effigy remembers the species. Bosses cannot be bound; the Codex explains compatible spirits and renewal."
	]
	quest.4200000000220588.title: "Borrow a living voice"
	quest.4200000000220589.quest_desc: [
		"Seat an awakened effigy in the first slot and Spiritweave in the second. Each successful summon uses 80 Pulse, one Spiritweave and one binding thread. Leave safe flooring within three blocks. Eight nearby mobs pause the cradle; redstone pauses all work and automation."
	]
	quest.4200000000220589.title: "A hearth for borrowed life"
	quest.420000000022058A.quest_desc: [
		"Set a Spirit Seal in a Ritual Brazier. Bring Earth, Air and Spirit Totems within eight blocks, 200 nearby Pulse and three Spiritweave in your inventory. Use the imprinted effigy on the brazier to awaken 512 summon threads. When all are spent, repeat this ritual to renew the binding."
	]
	quest.420000000022058A.title: "Three voices awaken the thread"
	quest.420000000022058B.quest_desc: [
		"Complete one successful summoning. Failed or blocked attempts consume no threads or offerings. Each binding lasts 512 successful summons; breaking and replacing the cradle never renews it. The effigy tooltip shows uses left, and a comparator reads the cradle's remaining binding strength."
	]
	quest.420000000022058B.title: "An answer from the cradle"
	quest.420000000023058C.quest_desc: [
		"Grit-singers never cut a stone the same way twice. This bench remembers every cut."
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"The same trick for wood — a hundred planks from one."
	]
	quest.420000000023058D.title: "Carpenter's Table"
	quest.420000000023058E.quest_desc: [
		"Sand into glass, then glass into every shape the light will take."
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"Wool and cloth, rewoven — fitting, for a pad that is mending a loom."
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"Leaves, saplings, and growing things, sorted into their variations."
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"Coloured blocks and stranger stone. Pick a variant; the bench holds the rest."
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"Metal and machine-facing blocks, cut to taste."
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"Feed a block into the Mason Table and choose from the wall of variants."
	]
	quest.4200000000230593.title: "A Cut of Stone"
	quest.4200000000230594.quest_desc: [
		"The Carpenter's Table does the same for wood."
	]
	quest.4200000000230594.title: "A Cut of Planks"
	quest.4200000000230595.quest_desc: [
		"Every pane the Glassblower knows starts here."
	]
	quest.4200000000230595.title: "A Cut of Glass"
	quest.4200000000230596.quest_desc: [
		"Grit-singers' favourite stone to argue over."
	]
	quest.4200000000230596.title: "Deepslate Variety"
	quest.4200000000230597.quest_desc: [
		"Fired clay, a hundred ways."
	]
	quest.4200000000230597.title: "Bricks Variety"
	quest.4200000000230598.quest_desc: [
		"Pad grit, cut fine."
	]
	quest.4200000000230598.title: "Sandstone Variety"
	quest.4200000000240599.quest_desc: [
		"The first thing that turns a pad into a place someone lives."
	]
	quest.4200000000240599.title: "A Chair"
	quest.420000000024059A.quest_desc: [
		"Somewhere to put the Codex down while you think."
	]
	quest.420000000024059A.title: "A Table"
	quest.420000000024059B.quest_desc: [
		"Room for a Clowder to sit while the barrel works."
	]
	quest.420000000024059B.title: "A Bench"
	quest.420000000024059C.quest_desc: [
		"For the Codex Pages you keep meaning to reread."
	]
	quest.420000000024059C.title: "A Shelf"
	quest.420000000024059D.quest_desc: [
		"Handcrafted storage that looks like it belongs."
	]
	quest.420000000024059D.title: "A Cupboard"
	quest.420000000024059E.quest_desc: [
		"The Pad-keepers slept well. So should you."
	]
	quest.420000000024059E.title: "A Fancy Bed"
	quest.420000000024059F.quest_desc: [
		"A lantern, a page, a place for both."
	]
	quest.420000000024059F.title: "A Nightstand"
	quest.42000000002405A0.quest_desc: [
		"Cut a frame, then dress it in any block. One shape, every skin."
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"A blank cube waiting for a camouflage block."
	]
	quest.42000000002405A1.title: "Framed Cube"
	quest.42000000002405A2.quest_desc: [
		"Half a frame; twice the options."
	]
	quest.42000000002405A2.title: "Framed Slab"
	quest.42000000002405A3.quest_desc: [
		"Steps that wear whatever wall they sit in."
	]
	quest.42000000002405A3.title: "Framed Stairs"
	quest.42000000002405A4.quest_desc: [
		"For roofs and rooflines the void never gave you."
	]
	quest.42000000002405A4.title: "Framed Slope"
	quest.42000000002405A5.quest_desc: [
		"Edge-walkers spanned the void with less. Reach the next pad in style."
	]
	quest.42000000002405A5.title: "Rope Bridge"
	quest.42000000002405A6.quest_desc: [
		"A roof over the pad. The rain up here is only ever ambition."
	]
	quest.42000000002405A6.title: "Attic Roof"
	quest.42000000002405A7.quest_desc: [
		"Comfort is infrastructure too."
	]
	quest.42000000002405A7.title: "Couch"
	quest.42000000002405A8.quest_desc: [
		"A kitchen edge for the Farmer's Delight line."
	]
	quest.42000000002405A8.title: "Counter"
	quest.42000000002405A9.quest_desc: [
		"Where the Whisker Codex gets its margins."
	]
	quest.42000000002405A9.title: "Desk"
	quest.42000000002405AA.quest_desc: [
		"Small storage that matches the table."
	]
	quest.42000000002405AA.title: "Drawer"
	quest.42000000002405AB.quest_desc: [
		"A threshold that hides in the wall."
	]
	quest.42000000002405AB.title: "Framed Door"
	quest.42000000002405AC.quest_desc: [
		"Thin cover; full disguise."
	]
	quest.42000000002405AC.title: "Framed Panel"
	quest.42000000002405AD.quest_desc: [
		"An edge rail you can dress to taste."
	]
	quest.42000000002405AD.title: "Framed Fence"
	quest.42000000002405AE.quest_desc: [
		"Grey and honest, like the grit it came from."
	]
	quest.42000000002405AE.title: "Andesite Bridge"
	quest.42000000002505AF.quest_desc: [
		"A wall light that is not a torch stuck in shame. The stewards had standards."
	]
	quest.42000000002505AF.title: "Sconce"
	quest.42000000002505B0.quest_desc: [
		"Sand, falling. The only honest clock before the Clock Strand."
	]
	quest.42000000002505B0.title: "Hourglass"
	quest.42000000002505B1.quest_desc: [
		"Drip a fluid out of a block. Small; oddly satisfying."
	]
	quest.42000000002505B1.title: "Faucet"
	quest.42000000002505B2.quest_desc: [
		"Turn it by hand. The Drumhearts started somewhere too."
	]
	quest.42000000002505B2.title: "Crank"
	quest.42000000002505B3.quest_desc: [
		"Show a thing off. A token, a page, a trophy."
	]
	quest.42000000002505B3.title: "Item Shelf"
	quest.42000000002505B4.quest_desc: [
		"A bag that holds bags. Recover's clutter, tidied."
	]
	quest.42000000002505B4.title: "Sack"
	quest.42000000002505B5.quest_desc: [
		"Lock the Frayed Thread away from your own worse ideas."
	]
	quest.42000000002505B5.title: "Safe"
	quest.42000000002505B6.quest_desc: [
		"Pin a page where the whole Clowder reads it."
	]
	quest.42000000002505B6.title: "Notice Board"
	quest.42000000002505B7.quest_desc: [
		"A pot with ambitions. Grow a little where the pad is thin."
	]
	quest.42000000002505B7.title: "Planter"
	quest.42000000002505B8.quest_desc: [
		"Raise the Spindle Loom Fragment where it can be admired."
	]
	quest.42000000002505B8.title: "Pedestal"
	quest.42000000002505B9.quest_desc: [
		"Store cookies, bees, or the small dignity of order."
	]
	quest.42000000002505B9.title: "Jar (37)"
	quest.42000000002505BA.quest_desc: [
		"Set a spawn without hauling a whole bed up the ladder."
	]
	quest.42000000002505BA.title: "Sleeping Bag"
	quest.42000000002505BB.quest_desc: [
		"Sleep through the day so the mobs meet a rested Skybound."
	]
	quest.42000000002505BB.title: "Hammock"
	quest.42000000002505BC.quest_desc: [
		"Hang the hammock between two posts, over the drop, and dare it."
	]
	quest.42000000002505BC.title: "Rope and Nail"
	quest.42000000002505BD.quest_desc: [
		"A steadier flame for the pad's long nights."
	]
	quest.42000000002505BD.title: "Candle Holder"
	quest.42000000002505BE.quest_desc: [
		"Climb, hang, or bridge. Edge-walkers swore by it."
	]
	quest.42000000002505BE.title: "Rope (37)"
	quest.42000000002505BF.quest_desc: [
		"Raise and lower the rope on a redstone whim."
	]
	quest.42000000002505BF.title: "Pulley Block"
	quest.42000000002505C0.quest_desc: [
		"Fall onto it and the void forgets to punish you."
	]
	quest.42000000002505C0.title: "Feather Block"
	quest.42000000002505C1.quest_desc: [
		"Chalk a plan the whole Clowder can argue with."
	]
	quest.42000000002505C1.title: "Blackboard"
	quest.42000000002505C2.quest_desc: [
		"Carry a small thing that would rather you didn't."
	]
	quest.42000000002505C2.title: "Cage"
	quest.42000000002605C3.quest_desc: [
		"The first wire. The pulse the Drumhearts kept now has somewhere to go."
	]
	quest.42000000002605C3.title: "Copper Wire"
	quest.42000000002605C4.quest_desc: [
		"Rotation on one side, Forge Energy on the other. Two Strands shaking hands."
	]
	quest.42000000002605C4.title: "Connector"
	quest.42000000002605C5.quest_desc: [
		"Energy back into rotation. The Clock Strand runs on the Spark Strand now."
	]
	quest.42000000002605C5.title: "Electric Motor"
	quest.42000000002605C6.quest_desc: [
		"Hold a charge between the wire and the work."
	]
	quest.42000000002605C6.title: "Capacitor"
	quest.42000000002605C7.quest_desc: [
		"A wall of stored current, built as big as the pad allows."
	]
	quest.42000000002605C7.title: "Modular Accumulator"
	quest.42000000002605C8.quest_desc: [
		"Rods and wire from ingots — Create's answer to the press."
	]
	quest.42000000002605C8.title: "Rolling Mill"
	quest.42000000002605C9.quest_desc: [
		"Enchant without the table's superstition. Feed it experience, get intent."
	]
	quest.42000000002605C9.title: "Blaze Enchanter"
	quest.42000000002605CA.quest_desc: [
		"Liquid practice, carried. The stewards would have found this vulgar and useful."
	]
	quest.42000000002605CA.title: "Experience Bucket"
	quest.42000000002605CB.quest_desc: [
		"Copy a book, a plan, a page. The Codex approves, quietly."
	]
	quest.42000000002605CB.title: "Printer"
	quest.42000000002605CC.quest_desc: [
		"Lava and heat into power. A bridge, not the Hum itself."
	]
	quest.42000000002605CC.title: "Heat Generator"
	quest.42000000002605CD.quest_desc: [
		"On a pad that is all sky, the sun is the one resource nobody rations."
	]
	quest.42000000002605CD.title: "Solar Generator"
	quest.42000000002605CE.quest_desc: [
		"The higher the pad, the harder it turns. Build tall."
	]
	quest.42000000002605CE.title: "Wind Generator"
	quest.42000000002605CF.quest_desc: [
		"Burn the Sprout Strand's surplus. Nothing on a pad is waste."
	]
	quest.42000000002605CF.title: "Bio Generator"
	quest.42000000002605D0.quest_desc: [
		"Late power for a Clowder that went deep on Mekanism."
	]
	quest.42000000002605D0.title: "Gas-Burning Generator"
	quest.42000000002605D1.quest_desc: [
		"The digital loom, in your pocket. Reweave from anywhere on the pad."
	]
	quest.42000000002605D1.title: "Wireless Terminal (38)"
	quest.42000000002605D2.quest_desc: [
		"Mekanism's chemicals, stored in the AE2 network. Two late pillars, braided."
	]
	quest.42000000002605D2.title: "Chemical Cell"
	quest.42000000002605D3.quest_desc: [
		"For when the copper wire cannot carry the whole pulse."
	]
	quest.42000000002605D3.title: "Large Connector"
	quest.42000000002605D4.quest_desc: [
		"A cake that levels you. Do not tell the Kitchen line."
	]
	quest.42000000002605D4.title: "Experience Cake"
	quest.42000000002605D5.quest_desc: [
		"A bigger bite of the same free sky."
	]
	quest.42000000002605D5.title: "Advanced Solar"
	quest.42000000002605D6.quest_desc: [
		"The shell every chemical cell needs."
	]
	quest.42000000002605D6.title: "Chemical Housing"
	quest.42000000002605D7.quest_desc: [
		"Carry a measure of gas off the network."
	]
	quest.42000000002605D7.title: "Portable Chemical Cell"
	reward.5000000000060135.title: "Thread of Return: +1 Clowder life"
	reward.5000000000080193.title: "Thread of Return: +1 Clowder life"
	reward.50000000000901CC.title: "Thread of Return: +1 Clowder life"
	reward.5000000000170337.title: "Thread of Return: +1 Clowder life"
	reward.50000000002004DD.title: "Thread of Return: +1 Clowder life"
	reward.5000000000220581.title: "Thread of Return: +1 Clowder life"
}
