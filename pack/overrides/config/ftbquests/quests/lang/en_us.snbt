	quest.42000000001903C9.title: "Shears Spare"
	quest.42000000001A03CA.quest_desc: [
		"One block that moves items where you tell it — the pad's nervous system.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: make or find Modular Router. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001A03CA.title: "Modular Router"
	quest.42000000001A03CB.quest_desc: [
		"The card every router behaviour is written onto.",
		"How: make or find Blank Module. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001A03CB.title: "Blank Module"
	quest.42000000001A03CC.quest_desc: [
		"Pull items out of a neighbour into the router.",
		"How: make or find Puller Module. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001A03CC.title: "Puller Module"
	quest.42000000001A03CD.quest_desc: [
		"Push items to a marked spot across the pad.",
		"How: make or find Sender Module. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001A03CD.title: "Sender Module"
	quest.42000000001A03CE.quest_desc: [
		"Break a block in front of the router and keep the drop.",
		"How: make or find Breaker Module. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001A03CE.title: "Breaker Module"
	quest.42000000001A03CF.quest_desc: [
		"Place a block where the router points.",
		"How: make or find Placer Module. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001A03CF.title: "Placer Module"
	quest.42000000001A03D0.quest_desc: [
		"Emit redstone when the router's contents cross a threshold.",
		"How: make or find Detector Module. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000001A03D0.title: "Detector Module"
	quest.42000000001A03D1.quest_desc: [
