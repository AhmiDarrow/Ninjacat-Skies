	quest.C2000000000F0247.quest_desc: [
		"Open the Codex path."
	]
	quest.C2000000000F0247.title: "Quest Book"
	quest.C2000000000F0248.quest_desc: [
		"Stay fed on claim runs."
	]
	quest.C2000000000F0248.title: "Chunk Claim Snack"
