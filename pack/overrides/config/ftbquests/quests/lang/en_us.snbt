		"A pocket reserve of power to carry between machines by hand."
	]
	quest.C2000000000D0228.title: "Battery Basic"
	quest.C2000000000D0229.quest_desc: [
		"The first crystal tier for the energizing rod's cell chamber."
	]
	quest.C2000000000D0229.title: "Niotic Crystal"
	quest.C2000000000D022A.quest_desc: [
		"A stronger crystal tier, further along the energizing chamber's build."
	]
	quest.C2000000000D022A.title: "Spirited Crystal"
	quest.C2000000000D022B.quest_desc: [
		"The strongest crystal tier the energizing chamber can hold."
	]
	quest.C2000000000D022B.title: "Nitro Crystal"
	quest.C2000000000E022C.quest_desc: [
		"Spun from magebloom, and woven into robes and spell gear."
	]
	quest.C2000000000E022C.title: "Mage Fiber"
	quest.C2000000000E022D.quest_desc: [
		"A flower that regrows its fiber on the stem after harvest."
	]
	quest.C2000000000E022D.title: "Magebloom"
	quest.C2000000000E022E.quest_desc: [
		"Stores a dense pool of source, the fuel behind every spell."
	]
	quest.C2000000000E022E.title: "Source Gem Block"
	quest.C2000000000E022F.quest_desc: [
		"Holds more glyphs than the starting book allows."
	]
	quest.C2000000000E022F.title: "Apprentice Spell Book"
	quest.C2000000000E0230.quest_desc: [
		"The largest spell book, room enough for a full arsenal of glyphs."
	]
	quest.C2000000000E0230.title: "Archmage Spell Book"
	quest.C2000000000E0231.quest_desc: [
		"Casts a bound spell automatically whenever it senses a target."
	]
	quest.C2000000000E0231.title: "Spell Turret"
	quest.C2000000000E0232.quest_desc: [
		"Casts its bound spell on a steady timer instead of on sight."
	]
