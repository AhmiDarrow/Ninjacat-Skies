	quest.C200000000060128.title: "Mechanical Bearing"
	quest.C200000000060129.quest_desc: [
		"Gantry slides along a rail."
	]
	quest.C200000000060129.title: "Gantry Carriage"
	quest.C20000000006012A.quest_desc: [
		"Turns a stationary build into one that rides the rails."
