	]
	quest.420000000022055C.title: "The living heart"
	quest.420000000022055D.quest_desc: [
		"Carry 1,200 Pulse in one Greater Cell. Charge it at a Drumheart or Resonator before setting out.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022055D.title: "A longer song"
	quest.420000000022055E.quest_desc: [
		"Sixteen buckets in one cistern. Buckets and fluid pipes both work. A comparator reads fullness; redstone locks filling and draining.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022055E.title: "Rain held in copper"
	quest.420000000022055F.quest_desc: [
		"Touch the destination face with the tuner, then touch a relay. Sneak-use to replace your marked destination.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022055F.title: "Name the far end"
	quest.4200000000220560.quest_desc: [
		"Place above a source inventory. Local cargo reaches 32 blocks, moving up to 16 items each second for 4 Pulse. Redstone pauses the relay.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220560.title: "A path for supplies"
	quest.4200000000220561.quest_desc: [
		"Place above a source tank and bind a receiving face. Local fluid reaches 32 blocks: 250 mB per second for 4 Pulse. Both ends must be loaded.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220561.title: "A path for rain"
	quest.4200000000220562.quest_desc: [
		"Longreach carries items up to 128 blocks for 8 Pulse per successful beat. Use standard inventories from any compatible mod.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220562.title: "Across the workshop"
	quest.4200000000220563.quest_desc: [
		"Longreach carries fluids up to 128 blocks for 8 Pulse per beat. Full receivers pause safely; redstone can lock the receiving cistern.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220563.title: "Across the waterworks"
	quest.4200000000220564.quest_desc: [
		"Bridge Tribal Power into Mekanism, Powah or AE2 energy acceptors. Each Pulse becomes 100 FE, up to 2,000 FE per second. Redstone stops conversion and export.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220564.title: "The beat becomes current"
	quest.4200000000220565.quest_desc: [
		"The Sixfold Staff. Sneak-use to cycle Earth, Fire, Water, Air, Spirit and Loom. Use to cast; the Loom voice is Tether, pulling a target eight blocks toward you, and a sneak-cast with no target is Stitch, a six-block blink. Carry charged cells; the Spirit Codex explains each spell and its cost.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220565.title: "Six voices in one hand"
	quest.4200000000220566.quest_desc: [
		"Main hand, sneak-use a stone face: a deliberate three-by-three cut at 8 Pulse per block. Normal breaking protection and tool requirements still apply.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220566.title: "Stone yields a doorway"
	quest.4200000000220567.quest_desc: [
		"The hood lends night sight while charged cells sustain it. Each active Spiritweave piece draws 2 Pulse every four seconds.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220567.title: "Eyes in the quiet"
	quest.4200000000220568.quest_desc: [
		"The robe grants resistance. Wear it into the work and keep your cells charged.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220568.title: "A woven shelter"
	quest.4200000000220569.quest_desc: [
		"Woven leggings lend speed. Their Pulse cost is separate from the other pieces.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220569.title: "The camp keeps pace"
	quest.420000000022056A.quest_desc: [
		"Boots can lend slow falling during descent while Pulse remains. A bound return path is still worth carrying.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022056A.title: "A gentler descent"
	quest.420000000022056B.quest_desc: [
		"Seat a reusable seal beside its matching totem. A six-block blessing costs 8 Pulse every two seconds. High redstone pauses it; sneak empty-handed to recover the seal.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022056B.title: "A blessing that stays"
	quest.420000000022056C.quest_desc: [
		"Sneak-use the top of a solid floor to bind it. Return within 128 blocks in the same world for 20 Pulse. Power the landing floor to lock arrivals.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022056C.title: "The first return path"
	quest.420000000022056D.quest_desc: [
		"Return across any distance within one dimension for 40 Pulse. Leave a dry landing with two clear blocks above it.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022056D.title: "Beyond the horizon"
	quest.420000000022056E.quest_desc: [
		"Seek March Crystal beyond the Gate Drum. Astral paths for people, items and fluids all draw on the same late-game material.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022056E.title: "A voice beyond the veil"
	quest.420000000022056F.quest_desc: [
		"The final compass crosses dimensions for 100 Pulse. Bind a safe return before exploring. Travel waits five seconds between uses.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022056F.title: "A path between worlds"
	quest.4200000000220570.quest_desc: [
		"Astral cargo crosses dimensions without a distance limit. Each successful beat costs 16 Pulse. The receiver must already be loaded; no hidden chunk loading.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220570.title: "Supplies cross the veil"
	quest.4200000000220571.quest_desc: [
		"Astral fluid follows the same dimensional tier as players and items. Keep the destination tank loaded. A full tank or unloaded world pauses without consuming cargo.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220571.title: "Rain crosses the veil"
	quest.4200000000220572.quest_desc: [
		"Open your personal 54-slot Deep Cache from the road. This is the same vault, shared between your caches and satchel. March attunement removes its opening cost.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220572.title: "The camp in your keeping"
	quest.4200000000220573.quest_desc: [
		"The Gate opens onto a living country. Some creatures still carry the old song; others guard its broken pieces. Brush the gentle ones. Face the guardians with charged cells and a return route.",
		"How: craft or Spark/Tribal Weave reward. Right-click: how the lattice works."
	]
	quest.4200000000220573.title: "The Returning Song"
	quest.4200000000220574.quest_desc: [
		"A dawn grazer that carries the old forest song in its antlers. Breed with wheat; brush adults for Dawn Velvet.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220574.title: "Dawn Stag: a song returned"
	quest.4200000000220575.quest_desc: [
		"A shy dusk forager whose tail marks safe paths. Breed with sweet berries; brush adults for Lantern Down.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220575.title: "Lantern Fox: a song returned"
	quest.4200000000220576.quest_desc: [
		"A patient wetland gardener with a living shell. Breed with seagrass; brush adults for a naturally shed Mossback Scale.",
		"Seek it in Overworld swamps and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220576.title: "Mossback: a song returned"
	quest.4200000000220577.quest_desc: [
		"The remains of a broken fire rite. Its melee strikes briefly ignite; keep water close.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220577.title: "Ashbound: a song returned"
	quest.4200000000220578.quest_desc: [
		"A grove guardian twisted by a severed ley line. Slow but sturdy; its blows root travellers briefly.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220578.title: "Rootbound: a song returned"
	quest.4200000000220579.quest_desc: [
		"A marsh hunter concealed among spirit reeds. Fast strikes carry a short poison.",
		"Seek it in Overworld swamps and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220579.title: "Reed Stalker: a song returned"
	quest.420000000022057A.quest_desc: [
		"A crystal-field scavenger armored in singing stone. Keep your distance from its heavy shove.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022057A.title: "Shardback: a song returned"
	quest.420000000022057B.quest_desc: [
		"An empty watchman that still guards the ancient roads. Its touch weakens the grip of attackers.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022057B.title: "Hollow Sentinel: a song returned"
	quest.420000000022057C.quest_desc: [
		"A storm-fed spirit with vast veil wings. A bright gathering of motes warns of its gust; cover breaks the attack.",
		"Seek it in the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022057C.title: "Storm Moth: a song returned"
	quest.420000000022057D.quest_desc: [
		"A nimble ember spirit. It gathers sparks before a burning bolt; the spell never ignites terrain.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022057D.title: "Cinder Imp: a song returned"
	quest.420000000022057E.quest_desc: [
		"A floating relic that remembers the lost tribes. Its telegraphed chime slows; shelter interrupts the song.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022057E.title: "Mourning Bell: a song returned"
	quest.420000000022057F.quest_desc: [
		"A hunter drawn to tears in the lattice. It closes distance quickly but cannot cross worlds by itself.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022057F.title: "Rift Hound: a song returned"
	quest.4200000000220580.quest_desc: [
		"An eight-legged keeper of broken songs. Its bite slows prey without placing webs or damaging the camp.",
		"Seek it in the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220580.title: "Echo Weaver: a song returned"
	quest.4200000000220581.quest_desc: [
		"The field notes are complete. The gentle harvests and recovered relics have become cloth and Echoes again. Beneath the night veil, the camp answers with a fuller song.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220581.title: "Thirteen voices, one sky"
	quest.4200000000220582.quest_desc: [
		"Hang the camp's song in copper. A Spirit Lantern gives full light without fuel; redstone dims it. Mark safe paths back from the dark.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220582.title: "A light for the returning"
	quest.4200000000220583.quest_desc: [
		"The chime is both ornament and instrument. Its comparator gives 0 in clear skies, 8 in rain and 15 in thunder. Redstone silences it.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220583.title: "Listen to the weather"
	quest.4200000000220584.quest_desc: [
		"A carved table holds 27 stacks. Standard item pipes and relays can share its offerings; comparators read fullness and redstone locks access.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220584.title: "A place at the hearth"
	quest.4200000000220585.quest_desc: [
		"Place the tender at crop height in a 9-by-9 bed. Put seeds in the first row; harvests fill the lower two rows. Planting costs 4 Pulse, harvest and replant costs 12. Supply power within eight blocks. A full output preserves the crop; redstone pauses the work.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220585.title: "The garden keeps singing"
	quest.4200000000220586.quest_desc: [
		"Eight Pulse each second wards hostile spawning within 24 blocks. Existing creatures remain. The ward also prevents hostile cradle summons, so keep your summoning ground outside it. Redstone immediately silences the ward.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220586.title: "Quiet at the camp edge"
	quest.4200000000220587.quest_desc: [
		"The Wayanchor holds its own chunk awake for 16 Pulse each second. Place one at a distant relay receiver and sustain its local power supply. At most 32 anchors may run in one dimension. Redstone or an empty buffer releases the chunk.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220587.title: "A camp that remembers"
	quest.4200000000220588.quest_desc: [
		"Sneak-use an uncharged effigy on a supported creature to take a harmless imprint. The effigy remembers the species. Bosses cannot be bound; the Codex explains compatible spirits and renewal.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220588.title: "Borrow a living voice"
	quest.4200000000220589.quest_desc: [
		"Seat an awakened effigy in the first slot and Spiritweave in the second. Each successful summon uses 80 Pulse, one Spiritweave and one binding thread. Leave safe flooring within three blocks. Eight nearby mobs pause the cradle; redstone pauses all work and automation.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220589.title: "A hearth for borrowed life"
	quest.420000000022058A.quest_desc: [
		"Set a Spirit Seal in a Ritual Brazier. Bring Earth, Air and Spirit Totems within eight blocks, 200 nearby Pulse and three Spiritweave in your inventory. Use the imprinted effigy on the brazier to awaken 512 summon threads. When all are spent, repeat this ritual to renew the binding.",
		"How: make or find Three voices awaken the thread. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022058A.title: "Three voices awaken the thread"
	quest.420000000022058B.quest_desc: [
		"Complete one successful summoning. Failed or blocked attempts consume no threads or offerings. Each binding lasts 512 successful summons; breaking and replacing the cradle never renews it. The effigy tooltip shows uses left, and a comparator reads the cradle's remaining binding strength.",
		"How: make or find An answer from the cradle. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022058B.title: "An answer from the cradle"
	quest.4200000000228001.quest_desc: [
		"Beyond the Gate Drum, the March steppe and highlands hide sunken Ancestor Halls. Twelve Lore Tablets line their walls; read every one. The chests keep Loom Thread, Echoes, Spiritweave and seals. Hollow Sentinels still stand guard.",
		"How: make or find The halls that kept time. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228001.title: "The halls that kept time"
	quest.4200000000228002.quest_desc: [
		"Loom Thread is the Loom, in hand: Ancestor Hall chests hold two to four, The Unsung tears loose sixteen or more, and a Loom-stitcher Elder trades one at Friend standing. It is the reagent of the sixth voice.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228002.title: "A strand of the thread itself"
	quest.4200000000228003.quest_desc: [
		"Eight March Stone around an Echo Shard makes two Lore Tablets. Placed, a tablet shows a fragment of the nine tribes; a Creative sneak-use cycles which one. Line your own hall with them.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228003.title: "Carve what you read"
	quest.4200000000228004.quest_desc: [
		"Leather over March Planks around a Resonant Core. The Drum Circle in the March highlands holds one already; this is yours to seat at home. Strike it four times, a breath apart, and something old rises.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228004.title: "A drum that will not sound"
	quest.4200000000228005.quest_desc: [
		"The Unsung is a three-phase drum-spirit. Beat: brace by sneaking against its shockwave. Chorus: cut down the Echo Weavers it calls. Silence: it cannot be hurt until you strike the Silent Drum with the same four-beat rhythm, which stuns it and doubles your damage. Bring charged cells and a return path.",
		"How: make or find The Drum Remembers. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228005.title: "The Drum Remembers"
	quest.4200000000228006.quest_desc: [
		"One Unsung Heart per kill, beside Loom Thread and Resonant Cores. It crafts the Loom totem and nothing else, so spend it with care.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228006.title: "The stilled drum"
	quest.4200000000228007.quest_desc: [
		"An Unsung Heart between Loom Thread and March Crystal, on March Planks. Loom joins Earth, Fire, Water, Air and Spirit: a distinct voice for the Pulse Resonator and the attunement the Echo Unweave and Ley Binding ask for.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228007.title: "The sixth voice"
	quest.4200000000228008.quest_desc: [
		"Blank Seal, Loom Thread and a Spirit Shard. Seated in a Ritual Brazier the Loom Seal blesses Tension: every two seconds it refills two Pulse into the carried cells of everyone in range, and lends Luck.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228008.title: "A seal of tension"
	quest.4200000000228009.quest_desc: [
		"Loom Thread and Copper Resonators on March Stone. Under a Loom voice the Echo Unweave runs the lattice backwards: a Manifested Ingot to two Bound Echo, Bound to two Attuned, Attuned to two Shards, Spiritweave to two Wool, a Resonant Core to three Manifested Ingots, and any worn Spiritgear tool to one Manifested Ingot.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228009.title: "The lattice, reversed"
	quest.420000000022800A.quest_desc: [
		"Cycle the Sixfold Staff to its Loom voice. Tether pulls a target eight blocks toward you for six Pulse; a sneak-cast with no target is Stitch, a six-block blink through air for ten. Tick this when you have used both.",
		"How: make or find Tether and Stitch. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022800A.title: "Tether and Stitch"
	quest.420000000022800B.quest_desc: [
		"Nine tribe camps stand in the March, one per Strand: huts, a fire, a Tribe Hearth, a totem, a banner and four Tribal Kin. Right-click a hearth with what that tribe favours, or with a charged Pulse Cell, and your standing with them rises. Hurting Kin or breaking camp blocks costs far more than it gains.",
		"How: make or find Kept warm. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022800B.title: "Kept warm"
	quest.420000000022800C.quest_desc: [
		"Guest at 50, Friend at 150, Kin at 400, Voice at 800. Kills near a hearth and completed trades count too. Elders trade two offers per rank: Grit-singers sell Echoes for raw ore, Seal-carvers sell seals and rite tablets, Loom-stitchers sell Loom Thread and, at Kin, a Horizon Compass. `/tribalpower standing` prints all nine.",
		"How: make or find On good terms. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022800C.title: "On good terms"
	quest.420000000022800D.quest_desc: [
		"At Voice standing an Elder presses a Tribe Mark into your hand, once. It opens that tribe's Codex page and is the one ingredient a Kinship Totem cannot do without.",
		"How: make or find Nine agreeing. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022800D.title: "Nine agreeing"
	quest.420000000022800E.quest_desc: [
		"Hold a Tribe Mark. Each tribe's is different; nine are possible.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022800E.title: "Mark of the tribe"
	quest.420000000022800F.quest_desc: [
		"A Tribe Mark, the Resonance Totem of that tribe's attunement and two Spiritweave. A Kinship Totem counts as an extra distinct voice for the Pulse Resonator and lends its tribe's attunement to stations, so nine tribes can carry the camp's song to fifteen voices.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022800F.title: "A voice that is not a voice"
	quest.4200000000228010.quest_desc: [
		"A camp's Drummer plays every few seconds; place a Drumheart within eight blocks of one and each beat feeds it two Pulse. Tick this when a Drummer is feeding your lattice.",
		"How: make or find The camp keeps the beat. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228010.title: "The camp keeps the beat"
	quest.4200000000228011.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Knotted Root beside an Earth Seal; 600 Pulse. For twenty minutes crops, saplings and stems in the nine chunks around the brazier grow faster. Sneak-use the tablet on a Ritual Brazier with that seal seated. A tablet rite wants a Rite Circle: brazier in the middle, four Rite Pedestals on the diagonals, chalk joining them. Seat four matching totems on the cardinals and the rite costs a quarter less and lasts twice as long. Brazier blessings still need only the seal. Pulse comes from the lattice within eight blocks.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228011.title: "Rite Tablet: Green Blessing"
	quest.4200000000228012.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Reed Fang beside a Water Seal; 400 Pulse. Twenty minutes of rain, for the cisterns and the crops. Sneak-use the tablet on a Ritual Brazier with that seal seated. A tablet rite wants a Rite Circle: brazier in the middle, four Rite Pedestals on the diagonals, chalk joining them. Seat four matching totems on the cardinals and the rite costs a quarter less and lasts twice as long. Brazier blessings still need only the seal. Pulse comes from the lattice within eight blocks.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228012.title: "Rite Tablet: Rain Calling"
	quest.4200000000228013.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Storm Wing beside an Air Seal; 400 Pulse. Forty minutes of clear sky. Sneak-use the tablet on a Ritual Brazier with that seal seated. A tablet rite wants a Rite Circle: brazier in the middle, four Rite Pedestals on the diagonals, chalk joining them. Seat four matching totems on the cardinals and the rite costs a quarter less and lasts twice as long. Brazier blessings still need only the seal. Pulse comes from the lattice within eight blocks.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228013.title: "Rite Tablet: Sky Clearing"
	quest.4200000000228014.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Ember Heart beside a Fire Seal; 800 Pulse. Hurries the night to the next sunrise for the whole world. Sneak-use the tablet on a Ritual Brazier with that seal seated. A tablet rite wants a Rite Circle: brazier in the middle, four Rite Pedestals on the diagonals, chalk joining them. Seat four matching totems on the cardinals and the rite costs a quarter less and lasts twice as long. Brazier blessings still need only the seal. Pulse comes from the lattice within eight blocks.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228014.title: "Rite Tablet: Dawn Calling"
	quest.4200000000228015.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Sentinel Sigil beside a Spirit Seal; 600 Pulse. Fifteen minutes without hostile spawns within sixty-four blocks. Sneak-use the tablet on a Ritual Brazier with that seal seated. A tablet rite wants a Rite Circle: brazier in the middle, four Rite Pedestals on the diagonals, chalk joining them. Seat four matching totems on the cardinals and the rite costs a quarter less and lasts twice as long. Brazier blessings still need only the seal. Pulse comes from the lattice within eight blocks.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228015.title: "Rite Tablet: Still Night"
	quest.4200000000228016.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Loom Thread beside a Loom Seal; 1,200 Pulse. Joins the nearest totem to another within sixty-four blocks with a thirty-minute ley line that routes Pulse between them. Sneak-use the tablet on a Ritual Brazier with that seal seated. A tablet rite wants a Rite Circle: brazier in the middle, four Rite Pedestals on the diagonals, chalk joining them. Seat four matching totems on the cardinals and the rite costs a quarter less and lasts twice as long. Brazier blessings still need only the seal. Pulse comes from the lattice within eight blocks.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228016.title: "Rite Tablet: Ley Binding"
	quest.4200000000228017.quest_desc: [
		"Perform any rite. Tablet rites need the Rite Circle; a seated blessing does not. If the lattice around the brazier holds too little Pulse, nothing is consumed and the brazier says so.",
		"How: make or find First Rite. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228017.title: "First Rite"
	quest.4200000000228018.quest_desc: [
		"Two Spiritweave, a Spirit Shard and the reagent of the species. Use it on an adult Lantern Fox, Mossback or Dawn Stag: a sixty-percent chance to bond, and the charm is kept on failure.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228018.title: "A charm for a wild thing"
	quest.4200000000228019.quest_desc: [
		"A bonded animal follows, teleports after you, never despawns, cannot be hurt by you and yields double when brushed. The Lantern Fox lights the way and marks ore; the Mossback carries a nine-slot saddlebag; the Dawn Stag is ridden without a saddle. Sneak-use toggles stay.",
		"How: make or find A friend in the dark. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228019.title: "A friend in the dark"
	quest.420000000022801A.quest_desc: [
		"Paper, Spiritweave and a Spirit Shard. Use the charter on a player to invite them to your camp, or in the air to see it. `/tribalpower camp` creates, invites, joins, leaves, kicks, renames.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022801A.title: "A camp of many voices"
	quest.420000000022801B.quest_desc: [
		"Camp members share a fifty-four-slot camp vault behind every Deep Cache and Wayfarer Satchel, count as owners of each other's devices, pool twelve Wayanchors, and mirror a quarter of their tribe standing to the camp. Your Clowder is the natural camp.",
		"How: make or find One vault, one budget. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022801B.title: "One vault, one budget"
	quest.420000000022801C.quest_desc: [
		"A glass pane over a Copper Resonator and a Spirit Shard. Held, the lens shows the ley strength where you stand and paints it on the ground around you; sneak-use it on a Ley Collector for the exact breakdown.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022801C.title: "See the ley"
	quest.420000000022801D.quest_desc: [
		"Quartz over redstone and a Copper Resonator on March Stone. Faced at any Pulse holder it puts out redstone 0 to 15 in proportion to what is stored.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022801D.title: "A needle for Pulse"
	quest.420000000022801E.quest_desc: [
		"A redstone torch over redstone and a Copper Resonator on March Stone. It emits when the faced holder is at or above its threshold; right-click cycles 25, 50, 75 and 100 percent. The pieces of a Pulse-driven automation.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022801E.title: "A line in the song"
	quest.420000000022801F.quest_desc: [
		"Sneak-use the Spirit Codex on any Tribal block for a plain report: stored Pulse, the generators feeding it, the attunements within eight blocks, what is missing for the current recipe, a full output, a redstone pause, an unloaded relay end. On a pattern anchor it names the tier, the facing, and the first three things missing, with particle ghosts where they should go. Tick this when it has told you something you did not know.",
		"How: make or find Ask the Codex why. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022801F.title: "Ask the Codex why"
	quest.4200000000228020.quest_desc: [
		"Echo Shards and cobble around a Drumheart. A font and four chalk marks asks for cobblestone at 4 Pulse a second — slow enough to run on a hand-drummed Drumheart. Brace it with Anchor Stones and bring Earth for stone. Add Fire and Water for obsidian at 24 Pulse a second, or feed 250 mB water and 250 mB lava for the same obsidian at 6. The Pad-keepers keep one working at their camp.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228020.title: "Ask the stone to stay"
	quest.4200000000228021.quest_desc: [
		"Complete any pattern. Placement is the ritual: scattered devices are not a rite. Seven shapes, all rotation-independent. Sneak-use the Spirit Codex on the anchor and it names the tier, the facing, and the first three things missing, with particle ghosts where they should go.",
		"How: make or find Draw the Circle. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228021.title: "Draw the Circle"
	quest.4200000000228022.quest_desc: [
		"Let the Stone Font finish one craft. Held redstone stills it; a struck pulse calls it once. A comparator reads its progress. Camp members count as owners.",
		"How: make or find Stone Stays. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228022.title: "Stone Stays"
	quest.4200000000228023.quest_desc: [
		"Sneak-use the Spirit Codex on a Stone Font, a Resonance Mesh or a gate keystone. The ghosts are the pattern. Tick this when it has shown you a gap.",
		"How: make or find See the missing pieces. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228023.title: "See the missing pieces"
	quest.4200000000228024.quest_desc: [
		"The Drumheart now pays by the same tempo the hand already used: 24 Pulse on a 17-to-23-tick rising edge, 10 otherwise, nothing closer than 8 ticks. A one-second clock is a large buff. A fast spam clock is a nerf. Tick this when you have retuned a farm, or when a hand strike still feels right.",
		"How: make or find Keep the tempo. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228024.title: "Keep the tempo"
	quest.4200000000228025.quest_desc: [
		"March Stone, Attuned Echo, Spiritweave and a Copper Resonator. Seat it at the centre of a Listening Pit: stone underfoot, four Anchor Stones at the corners, chalk from each edge to the middle, an Ancestral Cache beside it and the Earth voice in reach. It calls up exactly what a silk-touch mining trip would — the raw item for a metal, the ore block for a gem. The Grit-singers keep a whole pit at their camp.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228025.title: "The Grit-singers' machine"
	quest.4200000000228026.quest_desc: [
		"Four from March Stone and an Echo Shard. They brace a Stone Font, a Listening Pit and a Far Gate. Without them the pattern will not close.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228026.title: "Brace the corners"
	quest.4200000000228027.quest_desc: [
		"Run one Listening Pit cycle. Four bands: common (coal, copper, iron), deep (gold, redstone, lapis), hot (Nether quartz and gold, never debris) and rare (diamond, emerald, and whatever the pack added). Deep Listening is seven-by-seven; the Grit-singers gate those bands by standing — Friend, Kin, then Voice with their Kinship Totem inside the pattern. A sample on top is a filter, never an ingredient. Mining stays cheaper; the pit buys walking away from it.",
		"How: make or find Ask the Ground. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228027.title: "Ask the Ground"
	quest.4200000000228028.quest_desc: [
		"A metal goes raw or silk-touched ore to grit to ingot in any furnace. A gem skips the fire: silk-touched ore shatters straight into the gem at twice the ore's own drop. The gem itself is never an input. Modded metals ride one Mineral Grit that names its material. Tick this when a furnace has eaten grit, or when a gem came out of the pit without one.",
		"How: make or find Grit is the metal; gems skip the fire. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228028.title: "Grit is the metal; gems skip the fire"
	quest.4200000000228029.quest_desc: [
		"Water washes for 250 mB and an extra output every third cycle. Air quickens the cycle so Pulse per item does not move. Fire opens the hot band at twice the Pulse. Spirit listens a band deeper. The Loom halves the substrate. Tick this when a second voice has changed what the pit gave you.",
		"How: make or find Every voice trades, none multiply. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228029.title: "Every voice trades, none multiply"
	quest.420000000022802A.quest_desc: [
		"March Stone, copper and an Echo Shard make four frames. A Way Gate is a five-by-five ring without its corners, keystone at the bottom centre. Players, mobs and dropped items all pass.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022802A.title: "A ring of the way"
	quest.420000000022802B.quest_desc: [
		"Frames around a Resonant Core, with a Spirit Shard and a Pulse Cell. 400 Pulse to light a Way Gate out of its own 600; 20 Pulse per traveller. Link with a bound Waystone Compass or with chalk, within 64 blocks. A comparator reads 0 unlinked, 1 to 14 stored Pulse, 15 mid-transit. Break a keystone and its partner is released. `/tribalpower gate list` and `/tribalpower gate unlink`.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022802B.title: "The stone that remembers both ends"
	quest.420000000022802C.quest_desc: [
		"Light a Way Gate. It lands you inside the far gate's own interior and never terraforms; if there is nowhere to stand, the trip refuses and the Pulse comes back. The far end is held loaded around your arrival.",
		"How: make or find Open the Way. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022802C.title: "Open the Way"
	quest.420000000022802D.quest_desc: [
		"Blank Seal, Loom Thread and a Spirit Shard. The Far Gate is a taller frame braced by four Anchor Stones, with the Loom voice nearby — so crossing dimensions sits behind The Unsung. Linked with a Gate Sigil; 120 Pulse per traveller. The astral relay still needs no frame.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022802D.title: "A name for the long thread"
	quest.420000000022802E.quest_desc: [
		"Travel a Far Gate. Crossing dimensions is a built rite, not a compass trick. Camp members count as owners of the keystones.",
		"How: make or find The Long Thread. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000022802E.title: "The Long Thread"
	quest.420000000022802F.quest_desc: [
		"Copper, a Cinder Knot, a Fire Seal and March Planks. Burns furnace fuel for up to 20 Pulse a second while lit. Uncapped on purpose — it spends something. The Drumhearts keep one at their camp.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022802F.title: "Fire keeps a furnace"
	quest.4200000000228030.quest_desc: [
		"Spiritweave, a Storm Wing, an Air Seal and March Planks. 2 Pulse a second at y 80 under open sky, up to 6 high in a storm. Harps within 12 blocks divide the wind. The Pattern-weavers keep one at their camp.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228030.title: "Air sings the altitude"
	quest.4200000000228031.quest_desc: [
		"Leather, March Planks, a Knotted Root and a Water Seal. 3 Pulse a second beside water, 10 for 100 mB a second, doubled in rain. Passive drums within 8 blocks divide the water; a piped drum is uncapped. The Rootbinders keep one at their camp.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228031.title: "Water keeps time"
	quest.4200000000228032.quest_desc: [
		"A Bell Fragment, copper, a Spirit Seal and a Spirit Shard. 20 Pulse a hostile death, 5 a passive, tolled out at no more than 8 a second. A 2,000 reservoir, then it idles. The Seal-carvers keep one at their camp.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228032.title: "Spirit tolls the dead"
	quest.4200000000228033.quest_desc: [
		"March Crystal, Loom Thread, Spiritweave and a Resonant Core. 1 Pulse a second per distinct nearby voice, max 6, doubled during a Ley Binding. The Crystal Spire keeps one.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228033.title: "The Loom counts the choir"
	quest.4200000000228034.quest_desc: [
		"March Stone, Bound Echo and a Pulse Cell. 4,000 Pulse each, five to a column. Turns a mob farm's bursty Wake Bell into the steady draw a pit wants. A held signal stills every generator; a comparator reads the buffer.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228034.title: "Hold the burst"
	quest.4200000000228035.quest_desc: [
		"Have all six generators producing within 32 blocks of each other, one per voice: Drumheart, Ember Horn, Wind Harp, Wave Drum, Wake Bell, Loom Anchor. No automatable loop is net positive. Coal through the pit and back costs more than it returns.",
		"How: make or find Six Voices Singing. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228035.title: "Six Voices Singing"
	quest.4200000000228036.quest_desc: [
		"Two stone and Spirit Reed around a Water Seal; the seal is handed back. 300 Pulse marks an adjacent Spirit Cistern a spring, refilling 100 mB a second for ten minutes. It is where the water for a Wave Drum, for Washing, and for anything else that drinks comes from. March-side lava stays a manual haul.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228036.title: "Rite Tablet: Spring Calling"
	quest.4200000000228037.quest_desc: [
		"One Drum Circle record sits in a chest at the circle; The Unsung carries another. Play it in a jukebox. There is no craft — the March kept the song.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000228037.title: "The circle still plays"
	quest.4200000000228038.quest_desc: [
		"Rite Pedestals now hold and show one item; a comparator reads occupied. That is an automatic rite loop: a relay restocks a pedestal, a clock strikes the brazier, the tablet fires, the comparator reports empty. No fake players. Tick this when a circle has stood, or when a comparator has told you a pedestal is empty.",
		"How: make or find Four pedestals, chalk, a brazier. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000228038.title: "Four pedestals, chalk, a brazier"
	quest.420000000023058C.quest_desc: [
		"Grit-singers never cut a stone the same way twice. This bench remembers every cut.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: make or find Mason Table. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"The same trick for wood — a hundred planks from one.",
		"How: make or find Carpenter's Table. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000023058D.title: "Carpenter's Table"
	quest.420000000023058E.quest_desc: [
		"Sand into glass, then glass into every shape the light will take.",
		"How: make or find Glassblower. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"Wool and cloth, rewoven — fitting, for a pad that is mending a loom.",
		"How: make or find Loom Table. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"Leaves, saplings, and growing things, sorted into their variations.",
		"How: make or find Botanist Workbench. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"Coloured blocks and stranger stone. Pick a variant; the bench holds the rest.",
		"How: make or find Alchemy Bench. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"Metal and machine-facing blocks, cut to taste.",
		"How: make or find Tinkering Table. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"Feed a block into the Mason Table and choose from the wall of variants.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000230593.title: "A Cut of Stone"
	quest.4200000000230594.quest_desc: [
		"The Carpenter's Table does the same for wood.",
		"How: one log in the crafting grid makes four."
	]
	quest.4200000000230594.title: "A Cut of Planks"
	quest.4200000000230595.quest_desc: [
		"Every pane the Glassblower knows starts here.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000230595.title: "A Cut of Glass"
	quest.4200000000230596.quest_desc: [
		"Grit-singers' favourite stone to argue over.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000230596.title: "Deepslate Variety"
	quest.4200000000230597.quest_desc: [
		"Fired clay, a hundred ways.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000230597.title: "Bricks Variety"
	quest.4200000000230598.quest_desc: [
		"Pad grit, cut fine.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000230598.title: "Sandstone Variety"
	quest.4200000000240599.quest_desc: [
		"The first thing that turns a pad into a place someone lives.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: make or find A Chair. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.4200000000240599.title: "A Chair"
	quest.420000000024059A.quest_desc: [
		"Somewhere to put the Codex down while you think.",
		"How: make or find A Table. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000024059A.title: "A Table"
	quest.420000000024059B.quest_desc: [
		"Room for a Clowder to sit while the barrel works.",
		"How: make or find A Bench. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000024059B.title: "A Bench"
	quest.420000000024059C.quest_desc: [
		"For the Codex Pages you keep meaning to reread.",
		"How: make or find A Shelf. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000024059C.title: "A Shelf"
	quest.420000000024059D.quest_desc: [
		"Handcrafted storage that looks like it belongs.",
		"How: make or find A Cupboard. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000024059D.title: "A Cupboard"
	quest.420000000024059E.quest_desc: [
		"The Pad-keepers slept well. So should you.",
		"How: make or find A Fancy Bed. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000024059E.title: "A Fancy Bed"
	quest.420000000024059F.quest_desc: [
		"A lantern, a page, a place for both.",
		"How: make or find A Nightstand. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.420000000024059F.title: "A Nightstand"
	quest.42000000002405A0.quest_desc: [
		"Cut a frame, then dress it in any block. One shape, every skin.",
		"How: make or find Framing Saw. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"A blank cube waiting for a camouflage block.",
		"How: make or find Framed Cube. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A1.title: "Framed Cube"
	quest.42000000002405A2.quest_desc: [
		"Half a frame; twice the options.",
		"How: make or find Framed Slab. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A2.title: "Framed Slab"
	quest.42000000002405A3.quest_desc: [
		"Steps that wear whatever wall they sit in.",
		"How: make or find Framed Stairs. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A3.title: "Framed Stairs"
	quest.42000000002405A4.quest_desc: [
		"For roofs and rooflines the void never gave you.",
		"How: make or find Framed Slope. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A4.title: "Framed Slope"
	quest.42000000002405A5.quest_desc: [
		"Edge-walkers spanned the void with less. Reach the next pad in style.",
		"How: make or find Rope Bridge. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A5.title: "Rope Bridge"
	quest.42000000002405A6.quest_desc: [
		"A roof over the pad. The rain up here is only ever ambition.",
		"How: make or find Attic Roof. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A6.title: "Attic Roof"
	quest.42000000002405A7.quest_desc: [
		"Comfort is infrastructure too.",
		"How: make or find Couch. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A7.title: "Couch"
	quest.42000000002405A8.quest_desc: [
		"A kitchen edge for the Farmer's Delight line.",
		"How: make or find Counter. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A8.title: "Counter"
	quest.42000000002405A9.quest_desc: [
		"Where the Whisker Codex gets its margins.",
		"How: make or find Desk. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405A9.title: "Desk"
	quest.42000000002405AA.quest_desc: [
		"Small storage that matches the table.",
		"How: make or find Drawer. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405AA.title: "Drawer"
	quest.42000000002405AB.quest_desc: [
		"A threshold that hides in the wall.",
		"How: make or find Framed Door. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405AB.title: "Framed Door"
	quest.42000000002405AC.quest_desc: [
		"Thin cover; full disguise.",
		"How: make or find Framed Panel. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405AC.title: "Framed Panel"
	quest.42000000002405AD.quest_desc: [
		"An edge rail you can dress to taste.",
		"How: make or find Framed Fence. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405AD.title: "Framed Fence"
	quest.42000000002405AE.quest_desc: [
		"Grey and honest, like the grit it came from.",
		"How: make or find Andesite Bridge. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002405AE.title: "Andesite Bridge"
	quest.42000000002505AF.quest_desc: [
		"A wall light that is not a torch stuck in shame. The stewards had standards.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: make or find Sconce. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505AF.title: "Sconce"
	quest.42000000002505B0.quest_desc: [
		"Sand, falling. The only honest clock before the Clock Strand.",
		"How: make or find Hourglass. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B0.title: "Hourglass"
	quest.42000000002505B1.quest_desc: [
		"Drip a fluid out of a block. Small; oddly satisfying.",
		"How: make or find Faucet. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B1.title: "Faucet"
	quest.42000000002505B2.quest_desc: [
		"Turn it by hand. The Drumhearts started somewhere too.",
		"How: make or find Crank. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B2.title: "Crank"
	quest.42000000002505B3.quest_desc: [
		"Show a thing off. A token, a page, a trophy.",
		"How: make or find Item Shelf. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B3.title: "Item Shelf"
	quest.42000000002505B4.quest_desc: [
		"A bag that holds bags. Recover's clutter, tidied.",
		"How: make or find Sack. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B4.title: "Sack"
	quest.42000000002505B5.quest_desc: [
		"Lock the Frayed Thread away from your own worse ideas.",
		"How: make or find Safe. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B5.title: "Safe"
	quest.42000000002505B6.quest_desc: [
		"Pin a page where the whole Clowder reads it.",
		"How: make or find Notice Board. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B6.title: "Notice Board"
	quest.42000000002505B7.quest_desc: [
		"A pot with ambitions. Grow a little where the pad is thin.",
		"How: make or find Planter. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B7.title: "Planter"
	quest.42000000002505B8.quest_desc: [
		"Raise the Spindle Loom Fragment where it can be admired.",
		"How: make or find Pedestal. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B8.title: "Pedestal"
	quest.42000000002505B9.quest_desc: [
		"Store cookies, bees, or the small dignity of order.",
		"How: make or find Jar (37). JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505B9.title: "Jar (37)"
	quest.42000000002505BA.quest_desc: [
		"Set a spawn without hauling a whole bed up the ladder.",
		"How: make or find Sleeping Bag. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505BA.title: "Sleeping Bag"
	quest.42000000002505BB.quest_desc: [
		"Sleep through the day so the mobs meet a rested Skybound.",
		"How: make or find Hammock. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505BB.title: "Hammock"
	quest.42000000002505BC.quest_desc: [
		"Hang the hammock between two posts, over the drop, and dare it.",
		"How: make or find Rope and Nail. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505BC.title: "Rope and Nail"
	quest.42000000002505BD.quest_desc: [
		"A steadier flame for the pad's long nights.",
		"How: make or find Candle Holder. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505BD.title: "Candle Holder"
	quest.42000000002505BE.quest_desc: [
		"Climb, hang, or bridge. Edge-walkers swore by it.",
		"How: make or find Rope (37). JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505BE.title: "Rope (37)"
	quest.42000000002505BF.quest_desc: [
		"Raise and lower the rope on a redstone whim.",
		"How: make or find Pulley Block. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505BF.title: "Pulley Block"
	quest.42000000002505C0.quest_desc: [
		"Fall onto it and the void forgets to punish you.",
		"How: make or find Feather Block. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505C0.title: "Feather Block"
	quest.42000000002505C1.quest_desc: [
		"Chalk a plan the whole Clowder can argue with.",
		"How: make or find Blackboard. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505C1.title: "Blackboard"
	quest.42000000002505C2.quest_desc: [
		"Carry a small thing that would rather you didn't.",
		"How: make or find Cage. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002505C2.title: "Cage"
	quest.42000000002605C3.quest_desc: [
		"The first wire. The pulse the Drumhearts kept now has somewhere to go.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: make or find Copper Wire. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605C3.title: "Copper Wire"
	quest.42000000002605C4.quest_desc: [
		"Rotation on one side, Forge Energy on the other. Two Strands shaking hands.",
		"How: make or find Connector. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605C4.title: "Connector"
	quest.42000000002605C5.quest_desc: [
		"Energy back into rotation. The Clock Strand runs on the Spark Strand now.",
		"How: make or find Electric Motor. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605C5.title: "Electric Motor"
	quest.42000000002605C6.quest_desc: [
		"Hold a charge between the wire and the work.",
		"How: make or find Capacitor. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605C6.title: "Capacitor"
	quest.42000000002605C7.quest_desc: [
		"A wall of stored current, built as big as the pad allows.",
		"How: make or find Modular Accumulator. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605C7.title: "Modular Accumulator"
	quest.42000000002605C8.quest_desc: [
		"Rods and wire from ingots — Create's answer to the press.",
		"How: make or find Rolling Mill. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605C8.title: "Rolling Mill"
	quest.42000000002605C9.quest_desc: [
		"Enchant without the table's superstition. Feed it experience, get intent.",
		"How: make or find Blaze Enchanter. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605C9.title: "Blaze Enchanter"
	quest.42000000002605CA.quest_desc: [
		"Liquid practice, carried. The stewards would have found this vulgar and useful.",
		"How: make or find Experience Bucket. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605CA.title: "Experience Bucket"
	quest.42000000002605CB.quest_desc: [
		"Copy a book, a plan, a page. The Codex approves, quietly.",
		"How: make or find Printer. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605CB.title: "Printer"
	quest.42000000002605CC.quest_desc: [
		"Lava and heat into power. A bridge, not the Hum itself.",
		"How: make or find Heat Generator. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605CC.title: "Heat Generator"
	quest.42000000002605CD.quest_desc: [
		"On a pad that is all sky, the sun is the one resource nobody rations.",
		"How: make or find Solar Generator. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605CD.title: "Solar Generator"
	quest.42000000002605CE.quest_desc: [
		"The higher the pad, the harder it turns. Build tall.",
		"How: make or find Wind Generator. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605CE.title: "Wind Generator"
	quest.42000000002605CF.quest_desc: [
		"Burn the Sprout Strand's surplus. Nothing on a pad is waste.",
		"How: make or find Bio Generator. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605CF.title: "Bio Generator"
	quest.42000000002605D0.quest_desc: [
		"Late power for a Clowder that went deep on Mekanism.",
		"How: make or find Gas-Burning Generator. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605D0.title: "Gas-Burning Generator"
	quest.42000000002605D1.quest_desc: [
		"The digital loom, in your pocket. Reweave from anywhere on the pad.",
		"How: make or find Wireless Terminal (38). JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605D1.title: "Wireless Terminal (38)"
	quest.42000000002605D2.quest_desc: [
		"Mekanism's chemicals, stored in the AE2 network. Two late pillars, braided.",
		"How: make or find Chemical Cell. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605D2.title: "Chemical Cell"
	quest.42000000002605D3.quest_desc: [
		"For when the copper wire cannot carry the whole pulse.",
		"How: make or find Large Connector. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605D3.title: "Large Connector"
	quest.42000000002605D4.quest_desc: [
		"A cake that levels you. Do not tell the Kitchen line.",
		"How: make or find Experience Cake. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605D4.title: "Experience Cake"
	quest.42000000002605D5.quest_desc: [
		"A bigger bite of the same free sky.",
		"How: make or find Advanced Solar. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605D5.title: "Advanced Solar"
	quest.42000000002605D6.quest_desc: [
		"The shell every chemical cell needs.",
		"How: make or find Chemical Housing. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605D6.title: "Chemical Housing"
	quest.42000000002605D7.quest_desc: [
		"Carry a measure of gas off the network.",
		"How: make or find Portable Chemical Cell. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002605D7.title: "Portable Chemical Cell"
	quest.42000000002705D8.quest_desc: [
		"Each Strand has a guardian the Cut snapped: a Loom-construct gone feral. You do not murder a monster; you re-tension the Strand by beating it. Craft its Frayed Totem once the Strand is seated, use it anywhere outside an arena, and you and every Clowder mate within 32 blocks are pulled into its stage. Win, and every one of you carries home that guardian's Woven Relic. Lose, and you are spat back out with the totem spent.",
		"Relics work from the Curios relic slot, the off-hand or the hotbar: a passive while worn and a right-click power on a cooldown. `/guardians leave` abandons a fight; `/guardians status` shows the Clowder's record.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: make or find Answer for the Cut. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705D8.title: "Answer for the Cut"
	quest.42000000002705D9.quest_desc: [
		"The Burrow Bowl: a sunken bowl of four soil tiers stepping down to a mud pit under six dark-oak root arches, seven teal root-seams glowing across the pit floor.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705D9.title: "Totem: the Beddown"
	quest.42000000002705DA.quest_desc: [
		"Every quarter of its health the Beddown slams and floods the pit with a layer of dirt, immune inside it. One of the seven seams lights: dig a channel to it, expose the core and hit it to break the burial. The first gate, and a forgiving one.",
		"How: make or find Re-tension: the Beddown. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705DA.title: "Re-tension: the Beddown"
	quest.42000000002705DB.quest_desc: [
		"Rootheart: knockback taken is cut by sixty percent and nothing can pull you. Root Down plants you for five seconds behind eight hearts of absorption.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705DB.title: "Relic: Rootheart"
	quest.42000000002705DC.quest_desc: [
		"The Millpit: a deepslate quarry with a rotating grindstone ring in the floor and four stone sieve chutes pouring gravel into the central grit pit.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705DC.title: "Totem: the Grindmaw"
	quest.42000000002705DD.quest_desc: [
		"The Grindmaw is immune while its maw is closed. Each chute drops a grit block every fifteen seconds; carry one onto the ring and let it ride into the pit's mouth to jam the maw open for twelve seconds. The ring reverses every phase and shoves the careless into the pit.",
		"How: make or find Re-tension: the Grindmaw. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705DD.title: "Re-tension: the Grindmaw"
	quest.42000000002705DE.quest_desc: [
		"Grindcore: immune to Mining Fatigue, and your hand sieves get one extra fortune roll. Shred strips two armour from the next thing you hit.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705DE.title: "Relic: Grindcore"
	quest.42000000002705DF.quest_desc: [
		"The Overgrowth Terrace: four garden terraces under a leaf canopy, eight trellis posts, and four pruning stations on the second tier.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705DF.title: "Totem: the Thornmother"
	quest.42000000002705E0.quest_desc: [
		"The Thornmother never strikes; she seeds thorn-hedge that spreads and burns to the touch, and heals whenever a pruning station is overgrown. Shears and axes clear it. Compost eight hedge at a station to fire a prune wave that clears the ground and stuns her — the only clean damage window.",
		"How: make or find Re-tension: the Thornmother. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705E0.title: "Re-tension: the Thornmother"
	quest.42000000002705E1.quest_desc: [
		"Thornseed: Thorns and no berry or cactus damage. Bloom raises a ring of hedge and gives Regeneration II to you and your Clowder inside it.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E1.title: "Relic: Thornseed"
	quest.42000000002705E2.quest_desc: [
		"The Sky Shards: ten deepslate shards floating over the void, crumbling bridges between them, gold claw-marks on the main shard where the boss lands.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E2.title: "Totem: the Edgewalker"
	quest.42000000002705E3.quest_desc: [
		"A pure duel. The Edgewalker leaps shard to shard and pounces whoever stands furthest from a wall; a gold claw-mark shows where, a breath before it lands — step off it. Bridges crumble behind you and return later. Falling costs six hearts and a trip back to your pad.",
		"How: make or find Re-tension: the Edgewalker. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705E3.title: "Re-tension: the Edgewalker"
	quest.42000000002705E4.quest_desc: [
		"Edgestep: no fall damage under twelve blocks and no slipping off edges. Edgestep dashes six blocks, twice, with a stronger hit at the end.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E4.title: "Relic: Edgestep"
	quest.42000000002705E5.quest_desc: [
		"The Forge Drum: a brass drum-platform over a lava crater, eight copper piston hammers with beat pads before them, four lava channels through the floor.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E5.title: "Totem: the Drumheart"
	quest.42000000002705E6.quest_desc: [
		"The Drumheart can only be hurt for a moment after every fourth beat. Stand on a beat pad at the downbeat to charge a spark that counts triple; on beat four the lava channels rise, so be on the pads, not in the channels. The tempo climbs every phase.",
		"How: make or find Re-tension: the Drumheart. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705E6.title: "Re-tension: the Drumheart"
	quest.42000000002705E7.quest_desc: [
		"Drumpulse: every fourth hit lands two extra hearts. Downbeat stuns and throws back everything within seven blocks.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E7.title: "Relic: Drumpulse"
	quest.42000000002705E8.quest_desc: [
		"The Escapement: four rotating copper rings carrying dark-oak sequence tiles around an iron hub, six gear-towers and a sixteen-block pendulum keeping time.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E8.title: "Totem: the Cogwright"
	quest.42000000002705E9.quest_desc: [
		"Every phase the Cogwright winds: tiles light in sequence across the turning rings and you have twelve seconds to step them in order. Success opens its chassis for eight seconds; failure fires every gear-tower. The pendulum is the metronome; the rings reverse when it swings far.",
		"How: make or find Re-tension: the Cogwright. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705E9.title: "Re-tension: the Cogwright"
	quest.42000000002705EA.quest_desc: [
		"Cogloop: Haste I, and tools wear a fifth slower. Rewind resets every other relic you carry and snaps you back three seconds.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705EA.title: "Relic: Cogloop"
	quest.42000000002705EB.quest_desc: [
		"The Comb: a hexagonal wax arena of rising and falling comb cells, honey pools, and six drone cells in the wall.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705EB.title: "Totem: the Hivemind"
	quest.42000000002705EC.quest_desc: [
		"The Hivemind is fragile but every wave its six cells pour drones. A campfire set on a drone cell seals it for thirty seconds; seal all six and the royal chamber opens for ten. Your own Productive Bees attack the drones on sight.",
		"How: make or find Re-tension: the Hivemind. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705EC.title: "Re-tension: the Hivemind"
	quest.42000000002705ED.quest_desc: [
		"Hivecall: bees never turn on you, and hives within sixteen blocks work a tenth faster. Call the Swarm sends four relic-bees after whatever you hit.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705ED.title: "Relic: Hivecall"
	quest.42000000002705EE.quest_desc: [
		"The Ward Circle: a stone sanctum of gold circles and nine glyph pillars with amethyst spires, a nine-sided dais of gold pegs at the centre.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705EE.title: "Totem: the Sealbreaker"
	quest.42000000002705EF.quest_desc: [
		"The Sealbreaker hides behind three active wards. The dais pegs light the order once per phase — watch first. Dispel the pillars in that order with an Ars dispel or any Sigil-strand item; a wrong one re-arms all three and the ward-glass bites. Three right and it is open for twelve seconds. Later phases shuffle the runes and add a decoy.",
		"How: make or find Re-tension: the Sealbreaker. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705EF.title: "Re-tension: the Sealbreaker"
	quest.42000000002705F0.quest_desc: [
		"Sealmark: magic damage taken is cut by a fifth. Sealmark wards you, or a Clowder mate you look at, against one heavy hit.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F0.title: "Relic: Sealmark"
	quest.42000000002705F1.quest_desc: [
		"The Collapsing Loom: a loom sixty-six blocks wide whose floor is the warp — plank strips that unravel into thread bridges as the heddle bars drop.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F1.title: "Totem: the Unwoven"
	quest.42000000002705F2.quest_desc: [
		"Five phases. Each quotes two of the other eight mechanics for thirty seconds, then a heddle bar drops and three more strips unravel. In its true form the last four strips remain and the warp threads are the only way up to the beam where it stands. Kill it there: the Reweave.",
		"How: make or find Re-tension: the Unwoven. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705F2.title: "Re-tension: the Unwoven"
	quest.42000000002705F3.quest_desc: [
		"Loomthread: two more Loom Tension for your Clowder and slower decay. Loomthread tethers your Clowder to your side. It is the keystone for the true Reweave and the key to the two sealed arenas.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F3.title: "Relic: Loomthread"
	quest.42000000002705F4.quest_desc: [
		"The Dock Dustbin: a corner of the Dock itself — a plank yard, a washing line of cloth sheets, baskets of wool, a red rug.",
		"Four Frayed Thread and four wool around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F4.title: "Totem: the Lint Golem"
	quest.42000000002705F5.quest_desc: [
		"The one fight with no risk. The golem throws lint balls that only blind for a moment and hides behind the washing; beat the rug and it sneezes and staggers. It teaches totem, arena and gate.",
		"How: make or find Re-tension: the Lint Golem. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705F5.title: "Re-tension: the Lint Golem"
	quest.42000000002705F6.quest_desc: [
		"Lintwisp: immune to cactus, berry and hedge damage and to being pushed. Puff blinds nearby mobs for an escape.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F6.title: "Relic: Lintwisp"
	quest.42000000002705F7.quest_desc: [
		"The Knotgarden: a grass island under four rings of hedge maze with gaps and spurs, cobble paths, rope-knot rings hung over them.",
		"Four Frayed Thread and four leaves around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F7.title: "Totem: the Tangle"
	quest.42000000002705F8.quest_desc: [
		"The spider strings the paths shut behind you with rope-knots that take three hits to cut, and bites whoever is alone in a dead end. Stay together in the maze. Optional, mid-game, a cosmetic prize.",
		"How: make or find Re-tension: the Tangle. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705F8.title: "Re-tension: the Tangle"
	quest.42000000002705F9.quest_desc: [
		"Knotcharm: no slowdown on cobweb, soul sand, honey or powder snow, and half the slip on ice. Tangle roots the first mob it hits.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F9.title: "Relic: Knotcharm"
	quest.42000000002705FA.quest_desc: [
		"The two insane arenas wait behind a door only the Reweave opens. Their totems need the Loomthread relic on the crafting grid, and answer only a Clowder that has closed its sky. The bosses are ten to twenty times your size. Bring everyone.",
		"How: make or find The sealed door. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705FA.title: "The sealed door"
	quest.42000000002705FB.quest_desc: [
		"The Severance: a great obsidian shard crossed by the glowing Cut, twenty world-shards drifting around it, teal void-tears in the air.",
		"Frayed Thread and obsidian around the Loomthread relic; the relic is handed back.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705FB.title: "Totem: the First Cut"
	quest.42000000002705FC.quest_desc: [
		"What severed the Loom. Every twenty seconds it cuts a line across the shard and the blocks fall away for fifteen; the seam gives Speed but its beam follows the seam. Drifting shards crush, void-tears pull, and at a fifth of its health the shard splits in two along the Cut. After the Reweave only.",
		"How: make or find Re-tension: the First Cut. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705FC.title: "Re-tension: the First Cut"
	quest.42000000002705FD.quest_desc: [
		"Shard of the First Cut: cuts through ward phases. Best-in-pack, reserved for those who passed.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705FD.title: "Relic: Firstcut Shard"
	quest.42000000002705FE.quest_desc: [
		"The Loom Above: a purpur weave, nine strand-bridges to nine pillared platforms, twenty-seven cathedral threads to a keystone sixty-four blocks up.",
		"Frayed Thread and obsidian around the Loomthread relic; the relic is handed back.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705FE.title: "Totem: the Overweaver"
	quest.42000000002705FF.quest_desc: [
		"Your own restored Loom turned against you. The Overweaver throws shades of the nine guardians onto their strands; kill a shade and its thread pulls taut for twenty-five seconds, and only then can the loom itself be hurt. Later it throws three, then all nine.",
		"How: make or find Re-tension: the Overweaver. JEI names the recipe; earlier quests in this chapter name the station and inputs."
	]
	quest.42000000002705FF.title: "Re-tension: the Overweaver"
	quest.4200000000270600.quest_desc: [
		"The Overweaver's Shuttle: an echo of every Strand relic in one, and it reweaves a fallen Clowder mate.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.4200000000270600.title: "Relic: Overweaver Shuttle"
	reward.5000000000060135.title: "Thread of Return: +1 Clowder life"
	reward.5000000000080193.title: "Thread of Return: +1 Clowder life"
	reward.50000000000901CC.title: "Thread of Return: +1 Clowder life"
	reward.5000000000170337.title: "Thread of Return: +1 Clowder life"
