		"Second-tier essence, refined from stacks of inferium."
	]
	quest.C20000000018034C.title: "Prudentium Stock"
	quest.C20000000018034D.quest_desc: [
		"Third-tier essence, a rung above prudentium."
	]
	quest.C20000000018034D.title: "Tertium Stock"
	quest.C20000000018034E.quest_desc: [
		"Fourth-tier essence, close to the top of the chain."
	]
	quest.C20000000018034E.title: "Imperium Stock"
	quest.C20000000018034F.quest_desc: [
		"Fifth-tier essence, nearly as refined as it gets."
	]
	quest.C20000000018034F.title: "Supremium Stock"
