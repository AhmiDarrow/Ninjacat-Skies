	quest.C20000000007015F.quest_desc: [
		"Tall, yellow, and always facing the sun. Bees find it easily."
	]
	quest.C20000000007015F.title: "Sunflower"
	quest.C200000000070160.quest_desc: [
		"Two blocks of purple bloom that bees will cross a pad to reach."
	]
	quest.C200000000070160.title: "Lilac"
	quest.C200000000070161.quest_desc: [
		"A tall flower bees favor, and one more color for the garden."
	]
	quest.C200000000070161.title: "Rose Bush"
	quest.C200000000070162.quest_desc: [
		"Pink and full, planted wherever a hive needs more forage nearby."
	]
	quest.C200000000070162.title: "Peony"
	quest.C200000000070163.quest_desc: [
		"A short, single flower, but bees don't care about height."
	]
	quest.C200000000070163.title: "Orange Tulip"
	quest.C200000000070164.quest_desc: [
		"A nest you built, a hive you moved, a centrifuge, an incubator, essence fields.",
		"Tension the Strand: the Colony-keepers answer."
	]
	quest.C200000000070164.subtitle: "Colony"
	quest.C200000000070164.title: "Swarm Knot"
	quest.C200000000070165.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.C200000000070165.title: "Seat Swarm"
	quest.C200000000070166.quest_desc: [
		"You killed a bee.",
		"The Colony-keepers would like a word. Here is a bottle; think about it."
	]
	quest.C200000000070166.title: "Regret"
	quest.C200000000080167.quest_desc: [
		"The stewards left tricks in crystal. Thirty-two shards."
	]
	quest.C200000000080167.title: "Amethyst"
	quest.C200000000080168.quest_desc: [
		"Right-click the Tension Post with a Strand Filament once two of Clock, Swarm, or Spark are seated.",
		"Bind begins here."
	]
	quest.C200000000080168.title: "Braid Cord"
	quest.C200000000080169.quest_desc: [
		"Write the rite before you carve it."
	]
	quest.C200000000080169.title: "Book and Quill"
	quest.C20000000008016A.quest_desc: [
		"Soft power for hard tools."
	]
	quest.C20000000008016A.title: "Enchanting Table (Sigil)"
	quest.C20000000008016B.quest_desc: [
		"Fuel the table."
	]
	quest.C20000000008016B.title: "Lapis Block"
	quest.C20000000008016C.quest_desc: [
		"Surrounds an enchanting table to unlock its strongest enchantments."
	]
	quest.C20000000008016C.title: "Bookshelf"
	quest.C20000000008016D.quest_desc: [
		"Heals deeply and grants a shine that fades after a minute."
	]
	quest.C20000000008016D.title: "Golden Apple"
	quest.C20000000008016E.quest_desc: [
		"Skip the drop."
	]
	quest.C20000000008016E.title: "Ender Pearl"
	quest.C20000000008016F.quest_desc: [
		"Turns water bottles into something with an actual effect."
	]
	quest.C20000000008016F.title: "Brewing Stand"
	quest.C200000000080170.quest_desc: [
		"Heat for potions."
	]
	quest.C200000000080170.title: "Blaze Powder"
	quest.C200000000080171.quest_desc: [
		"Fuels the brewing stand and proves you've already faced the Nether."
	]
	quest.C200000000080171.title: "Blaze Rod"
	quest.C200000000080172.quest_desc: [
		"Twists a potion's effect into something worse, on purpose."
	]
	quest.C200000000080172.title: "Fermented Eye"
	quest.C200000000080173.quest_desc: [
		"Glowstone dust for recipes."
	]
	quest.C200000000080173.title: "Glowstone Dust (Sigil)"
	quest.C200000000080174.quest_desc: [
		"Breath of the thing that guards the End."
	]
	quest.C200000000080174.title: "Dragon Breath"
	quest.C200000000080175.quest_desc: [
		"One more chance.",
		"Optional \u2014 the void may never offer one."
	]
	quest.C200000000080175.title: "Totem"
	quest.C200000000080176.quest_desc: [
		"Stores Source, the fuel spells burn through."
	]
	quest.C200000000080176.title: "Source Gem"
	quest.C200000000080177.quest_desc: [
		"Grown, not found. Wood for casting tools and spell pedestals."
	]
	quest.C200000000080177.title: "Archwood"
	quest.C200000000080178.quest_desc: [
		"First spells. Peer magic, if you want it beside the rites."
	]
	quest.C200000000080178.title: "Novice Spell Book"
	quest.C200000000080179.quest_desc: [
		"An arcane crop, grown for its cloth as much as its magic."
	]
	quest.C200000000080179.title: "Mage Bloom"
	quest.C20000000008017A.quest_desc: [
		"Brazier for ritual work."
	]
	quest.C20000000008017A.title: "Ritual Brazier"
	quest.C20000000008017B.quest_desc: [
		"Displays a reagent and feeds it into whatever ritual needs it."
	]
	quest.C20000000008017B.title: "Arcane Pedestal"
	quest.C20000000008017C.quest_desc: [
		"Scribe spells and pages."
	]
	quest.C20000000008017C.title: "Scribes Table"
	quest.C20000000008017D.quest_desc: [
		"Imbue reagents with source."
	]
	quest.C20000000008017D.title: "Imbuement Chamber"
	quest.C20000000008017E.quest_desc: [
		"Stores extra Source so a spell never runs dry mid-cast."
	]
	quest.C20000000008017E.title: "Source Jar"
	quest.C20000000008017F.quest_desc: [
		"Call spirits by their names."
	]
	quest.C20000000008017F.title: "Occultism Dictionary"
	quest.C200000000080180.quest_desc: [
		"A cold flame used in rituals that regular fire won't finish."
	]
	quest.C200000000080180.title: "Spirit Fire"
	quest.C200000000080181.quest_desc: [
		"A focus for summoning. The rites are patient."
	]
	quest.C200000000080181.title: "Golden Sacrificial Bowl"
	quest.C200000000080182.quest_desc: [
		"The heart of aura-based crafting, tuned to the land around it."
	]
	quest.C200000000080182.title: "Nature Altar"
	quest.C200000000080183.quest_desc: [
		"A plant infused by high aura, spun into something rarer."
	]
	quest.C200000000080183.title: "Gold Fiber"
	quest.C200000000080184.quest_desc: [
		"Aura-touched material, more valuable than it looks lying on the ground."
	]
	quest.C200000000080184.title: "Gold Leaf"
	quest.C200000000080185.quest_desc: [
		"Iron that's soaked up ambient aura until it's worth more than the ore."
	]
	quest.C200000000080185.title: "Infused Iron"
	quest.C200000000080186.quest_desc: [
		"Lets you see the aura level of the land around you."
	]
	quest.C200000000080186.title: "Eye"
	quest.C200000000080187.quest_desc: [
		"Raises the aura of the area it's placed in."
	]
	quest.C200000000080187.title: "Token Joy"
	quest.C200000000080188.quest_desc: [
		"Spell parchment stock."
	]
	quest.C200000000080188.title: "Spell Parchment"
	quest.C200000000080189.quest_desc: [
		"Marks a spot to return to with a word, not a walk."
	]
	quest.C200000000080189.title: "Warp Scroll"
	quest.C20000000008018A.quest_desc: [
		"Plant it, tend it, and harvest cloth soaked in low magic."
	]
	quest.C20000000008018A.title: "Magebloom Crop"
	quest.C20000000008018B.quest_desc: [
		"The empty page a spell gets written onto."
	]
	quest.C20000000008018B.title: "Blank Glyph"
	quest.C20000000008018C.quest_desc: [
		"Casts combat spells without ever touching a wand."
	]
	quest.C20000000008018C.title: "Iron's Spell Book"
	quest.C20000000008018D.quest_desc: [
		"The fuel spellcasters burn through, spell after spell."
	]
	quest.C20000000008018D.title: "Arcane Essence"
	quest.C20000000008018E.quest_desc: [
		"Inscribes a spell onto a book, one tier at a time."
	]
	quest.C20000000008018E.title: "Ink Common"
	quest.C20000000008018F.quest_desc: [
		"Color for rites."
	]
	quest.C20000000008018F.title: "Mystical Flower"
	quest.C200000000080190.quest_desc: [
		"Deep dark echo.",
		"Optional \u2014 the void may never offer one."
	]
	quest.C200000000080190.title: "Echo Shard"
	quest.C200000000080191.quest_desc: [
		"A braid spun, potions bottled, spells and spirits called.",
		"Tension the Strand: the Seal-carvers answer."
	]
	quest.C200000000080191.subtitle: "Bind"
	quest.C200000000080191.title: "Sigil Knot"
	quest.C200000000080192.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.C200000000080192.title: "Seat Sigil"
	quest.C200000000080193.quest_desc: [
		"An apple the stewards never ate. Neither should you, probably."
	]
	quest.C200000000080193.title: "Old Gold"
	quest.C200000000090194.quest_desc: [
		"An iron mesh, gravel or sand, patience.",
		"Strand Filament is the Loom's own thread. The braid is spun from it."
	]
	quest.C200000000090194.title: "Spin the Filament"
	quest.C200000000090195.quest_desc: [
		"Two braid paths seated, one Filament, one right-click on the Post.",
		"Bind has begun; Reweave starts here."
	]
	quest.C200000000090195.title: "Splice a Braid"
	quest.C200000000090196.quest_desc: [
		"Certus quartz \u2014 the cold thread of a digital loom."
	]
	quest.C200000000090196.title: "Cold Weft"
	quest.C200000000090197.quest_desc: [
		"Ground quartz, the base material the digital loom is built from."
	]
	quest.C200000000090197.title: "Certus Dust"
	quest.C200000000090198.quest_desc: [
		"The shell block for every network machine, quarried from certus deposits."
	]
	quest.C200000000090198.title: "Sky Stone"
	quest.C200000000090199.quest_desc: [
		"Fluix \u2014 certus, quartz, and redstone charged in water."
	]
	quest.C200000000090199.title: "Charged Warp"
	quest.C20000000009019A.quest_desc: [
		"A blend of quartz, redstone, and glass, ground fine for network crafting."
	]
	quest.C20000000009019A.title: "Fluix Dust"
	quest.C20000000009019B.quest_desc: [
		"Silicon for AE2 processors."
	]
	quest.C20000000009019B.title: "Silicon"
	quest.C20000000009019C.quest_desc: [
		"The inscriber presses circuits the way a loom presses cloth."
	]
	quest.C20000000009019C.title: "Press the Pattern"
	quest.C20000000009019D.quest_desc: [
		"Stamps a silicon plate the way a loom presses cloth."
	]
	quest.C20000000009019D.title: "Inscriber Silicon Press"
	quest.C20000000009019E.quest_desc: [
		"Stamps the die for a logic processor, one press at a time."
	]
	quest.C20000000009019E.title: "Logic Press"
	quest.C20000000009019F.quest_desc: [
		"Stamps the die for a calculation processor."
	]
	quest.C20000000009019F.title: "Calculation Press"
	quest.C2000000000901A0.quest_desc: [
		"Engineering die craft."
	]
	quest.C2000000000901A0.title: "Engineering Press"
	quest.C2000000000901A1.quest_desc: [
		"Logic processor for AE2."
	]
	quest.C2000000000901A1.title: "Logic Processor"
	quest.C2000000000901A2.quest_desc: [
		"A component in autocrafting patterns, made from silicon and certus quartz."
	]
	quest.C2000000000901A2.title: "Calculation Processor"
	quest.C2000000000901A3.quest_desc: [
		"A denser processor, needed for the network's more demanding parts."
	]
	quest.C2000000000901A3.title: "Engineering Processor"
	quest.C2000000000901A4.quest_desc: [
		"Houses the cells that hold everything the network remembers."
	]
	quest.C2000000000901A4.title: "ME Drive"
	quest.C2000000000901A5.quest_desc: [
		"The shell a storage cell is built inside."
	]
	quest.C2000000000901A5.title: "Item Cell Housing"
	quest.C2000000000901A6.quest_desc: [
		"First digital chest."
	]
	quest.C2000000000901A6.title: "1k Item Cell"
	quest.C2000000000901A7.quest_desc: [
		"See the net."
	]
	quest.C2000000000901A7.title: "ME Terminal"
	quest.C2000000000901A8.quest_desc: [
		"Lets you craft directly from whatever the network already holds."
	]
	quest.C2000000000901A8.title: "Crafting Terminal"
	quest.C2000000000901A9.quest_desc: [
		"The controller. Wants a Binding Knot at its centre.",
		"Spindle core."
	]
	quest.C2000000000901A9.title: "Digital Loom"
	quest.C2000000000901AA.quest_desc: [
		"Strike it open. The March is on the other side."
	]
	quest.C2000000000901AA.title: "Gate Drum"
	quest.C2000000000901AB.quest_desc: [
		"Footing from beyond the gate. Bring one home."
	]
	quest.C2000000000901AB.title: "March Stone"
	quest.C2000000000901AC.quest_desc: [
		"Carries the network's channels from one machine to the next."
	]
	quest.C2000000000901AC.title: "Fluix Cable"
	quest.C2000000000901AD.quest_desc: [
		"Pull items into storage."
	]
	quest.C2000000000901AD.title: "Import Bus"
	quest.C2000000000901AE.quest_desc: [
		"Pushes items out of the network into a chest or machine."
	]
	quest.C2000000000901AE.title: "Export Bus"
	quest.C2000000000901AF.quest_desc: [
		"Reads an outside inventory into the network as if it were a cell."
	]
	quest.C2000000000901AF.title: "Storage Bus"
	quest.C2000000000901B0.quest_desc: [
		"Adds bulk crafting capacity to the network's autocrafting."
	]
	quest.C2000000000901B0.title: "Crafting Unit"
	quest.C2000000000901B1.quest_desc: [
		"Speeds up how many crafting jobs run at once."
	]
	quest.C2000000000901B1.title: "Crafting Co-Processing Unit"
	quest.C2000000000901B2.quest_desc: [
		"Holds patterns for the network to draw on while it crafts."
	]
	quest.C2000000000901B2.title: "1k Crafting Storage"
	quest.C2000000000901B3.quest_desc: [
		"Feeds patterns to machines the way a loom feeds thread to the shuttle."
	]
	quest.C2000000000901B3.title: "Pattern Provider"
	quest.C2000000000901B4.quest_desc: [
		"Builds from patterns. Wants a Braid Cord at its heart."
	]
	quest.C2000000000901B4.title: "Molecular Assembler"
	quest.C2000000000901B5.quest_desc: [
		"An empty pattern, waiting to be encoded with a recipe."
	]
	quest.C2000000000901B5.title: "Blank Pattern"
	quest.C2000000000901B6.quest_desc: [
		"Feed power into the digital loom."
	]
	quest.C2000000000901B6.title: "Energy Acceptor"
	quest.C2000000000901B7.quest_desc: [
		"Burn for AE \u2014 optional power branch."
	]
	quest.C2000000000901B7.title: "Vibration Chamber"
	quest.C2000000000901B8.quest_desc: [
		"A storage cell with more room than the last size."
	]
	quest.C2000000000901B8.title: "4k Item Cell"
	quest.C2000000000901B9.quest_desc: [
		"Holds far more than any chest, the densest cell before the drive fills up."
	]
	quest.C2000000000901B9.title: "16k Item Cell"
	quest.C2000000000901BA.quest_desc: [
		"The shell a fluid storage cell is built inside."
	]
	quest.C2000000000901BA.title: "Fluid Cell Housing"
	quest.C2000000000901BB.quest_desc: [
		"A digital tank, storing liquid the network can pull from anywhere."
	]
	quest.C2000000000901BB.title: "1k Fluid Cell"
	quest.C2000000000901BC.quest_desc: [
		"Places blocks from the network the way a hand would, without one."
	]
	quest.C2000000000901BC.title: "Formation Plane"
	quest.C2000000000901BD.quest_desc: [
		"Breaks blocks in front of it and feeds them into the network."
	]
	quest.C2000000000901BD.title: "Annihilation Plane"
	quest.C2000000000901BE.quest_desc: [
		"Redstone from net."
	]
	quest.C2000000000901BE.title: "Level Emitter"
	quest.C2000000000901BF.quest_desc: [
		"Connects the network to the world, trading items across the edge."
	]
	quest.C2000000000901BF.title: "Interface"
	quest.C2000000000901C0.quest_desc: [
		"Links two networks across distance the ordinary cable can't reach."
	]
	quest.C2000000000901C0.title: "Quantum Ring"
	quest.C2000000000901C1.quest_desc: [
		"The paired half of a quantum ring, tying two networks together."
	]
	quest.C2000000000901C1.title: "Quantum Link"
	quest.C2000000000901C2.quest_desc: [
		"Reaches the network from anywhere in range, no cable underfoot."
	]
	quest.C2000000000901C2.title: "Wireless Terminal"
	quest.C2000000000901C3.quest_desc: [
		"Copies one machine's settings onto another without retyping them."
	]
	quest.C2000000000901C3.title: "Memory Card"
	quest.C2000000000901C4.quest_desc: [
		"Network tool for AE2."
	]
	quest.C2000000000901C4.title: "Network Tool"
	quest.C2000000000901C5.quest_desc: [
		"Charges certus quartz until it's ready for finer crafting."
	]
	quest.C2000000000901C5.title: "Charger"
	quest.C2000000000901C6.quest_desc: [
		"Speeds a growing crystal bud toward a full-sized cluster."
	]
	quest.C2000000000901C6.title: "Crystal Growth Accelerator"
	quest.C2000000000901C7.quest_desc: [
		"March canopy proof \u2014 optional Reweave souvenir."
	]
	quest.C2000000000901C7.title: "Spirit Reed"
	quest.C2000000000901C8.quest_desc: [
		"A braid, a digital loom, a gate, a stone from the March.",
		"Tension the ninth Strand. Then the Fragment, then the Post."
	]
	quest.C2000000000901C8.subtitle: "Reweave"
	quest.C2000000000901C8.title: "Spindle Knot"
	quest.C2000000000901C9.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes."
	]
	quest.C2000000000901C9.title: "Seat Spindle"
	quest.C2000000000901CA.quest_desc: [
		"Nine seated, one March stone, one right-click on the Post: the Fragment.",
		"Seat it. The cut closes above your pad."
	]
	quest.C2000000000901CA.subtitle: "Reweave"
	quest.C2000000000901CA.title: "Loom Fragment"
	quest.C2000000000901CB.quest_desc: [
		"Seat the Fragment at the Tension Post.",
		"Nine tribes, one thread. Go and see what the March kept for you."
	]
	quest.C2000000000901CB.subtitle: "The cut, closed"
	quest.C2000000000901CB.title: "Reweave"
	quest.C2000000000901CC.quest_desc: [
		"A wither, on a pad, in the sky. The Loom-stitchers would have been impressed and then furious."
	]
	quest.C2000000000901CC.title: "A Star, Somehow"
	quest.C2000000000A01CD.quest_desc: [
		"Leaves drop more saplings."
	]
	quest.C2000000000A01CD.title: "Crook Basics"
	quest.C2000000000A01CE.quest_desc: [
		"Sifts faster than the wooden crook, and lasts far longer."
	]
	quest.C2000000000A01CE.title: "Bone Crook"
	quest.C2000000000A01CF.quest_desc: [
		"The plainest mesh. Everything you sieve starts by passing through this."
	]
	quest.C2000000000A01CF.title: "String Mesh"
	quest.C2000000000A01D0.quest_desc: [
		"Catches finer shards than string. Fewer scraps slip through the weave."
	]
	quest.C2000000000A01D0.title: "Flint Mesh (Sieve)"
	quest.C2000000000A01D1.quest_desc: [
		"Iron threads catch heavier grit and pull rarer scraps from the pile."
	]
	quest.C2000000000A01D1.title: "Iron Mesh (Sieve)"
	quest.C2000000000A01D2.quest_desc: [
		"Gold tier mesh. Odds shift toward the ores that matter."
	]
	quest.C2000000000A01D2.title: "Golden Mesh"
	quest.C2000000000A01D3.quest_desc: [
		"Sieve gravel with this and diamonds turn up far more often."
	]
	quest.C2000000000A01D3.title: "Diamond Mesh"
	quest.C2000000000A01D4.quest_desc: [
		"The finest mesh made. Nothing sieves better than netherite thread."
	]
	quest.C2000000000A01D4.title: "Netherite Mesh"
	quest.C2000000000A01D5.quest_desc: [
		"Clay refined smooth, ready to fire into a crucible that holds real heat."
	]
	quest.C2000000000A01D5.title: "Porcelain Clay (Sieve)"
	quest.C2000000000A01D6.quest_desc: [
		"Fuel a furnace generator."
	]
	quest.C2000000000A01D6.title: "Unfired Crucible"
	quest.C2000000000A01D7.quest_desc: [
		"Holds molten heat without cracking. Smelt what the sieve turned up."
	]
	quest.C2000000000A01D7.title: "Porcelain Crucible"
	quest.C2000000000A01D8.quest_desc: [
		"Splashes water across crops without trampling the rows."
	]
	quest.C2000000000A01D8.title: "Watering Can Wood"
	quest.C2000000000A01D9.quest_desc: [
		"Wider splash and a deeper tank. Water more of the pad per trip."
	]
	quest.C2000000000A01D9.title: "Watering Can Iron"
	quest.C2000000000A01DA.quest_desc: [
		"Set loose on leaves, it spins silk while it feeds."
	]
	quest.C2000000000A01DA.title: "Silkworm"
	quest.C2000000000A01DB.quest_desc: [
		"Strange water that nudges saplings and seeds toward stranger crops."
	]
	quest.C2000000000A01DB.title: "Witch Water Bucket"
	quest.C2000000000A01DC.quest_desc: [
		"Scatter these and mycelium creeps outward, block by patient block."
	]
	quest.C2000000000A01DC.title: "Mycelium Spores"
	quest.C2000000000A01DD.quest_desc: [
		"Toss on dirt and grass spreads without waiting on the rain."
	]
	quest.C2000000000A01DD.title: "Grass Seeds"
	quest.C2000000000A01DE.quest_desc: [
		"Cobblestone's replacement grit. Feed it back to the hammer for more."
	]
	quest.C2000000000A01DE.title: "Stone Pebble"
	quest.C2000000000A01DF.quest_desc: [
		"Nine pebbles packed tight into storage stone for a growing pad."
	]
	quest.C2000000000A01DF.title: "Compressed Cobble"
	quest.C2000000000A01E0.quest_desc: [
		"Breaks cobble into pebbles faster than any hammer before it."
	]
	quest.C2000000000A01E0.title: "Netherite Hammer"
	quest.C2000000000A01E1.quest_desc: [
		"Nether stone, crushed fine. Basalt and blackstone both start here."
	]
	quest.C2000000000A01E1.title: "Blackstone Pebble"
	quest.C2000000000A01E2.quest_desc: [
		"Deepslate crushed down to grit, ready for the sieve again."
	]
	quest.C2000000000A01E2.title: "Deepslate Pebble"
	quest.C2000000000A01E3.quest_desc: [
		"Pale stone pulled from deep sieving, mostly good for building."
	]
	quest.C2000000000A01E3.title: "Calcite"
	quest.C2000000000A01E4.quest_desc: [
		"Grey stone from the depths, plain and easy to shape."
	]
	quest.C2000000000A01E4.title: "Tuff"
	quest.C2000000000A01E5.quest_desc: [
		"Grows slow underground; stack it and let it drip into stalactites again."
	]
	quest.C2000000000A01E5.title: "Dripstone"
	quest.C2000000000A01E6.quest_desc: [
		"Soaks up standing water fast, handy after a flooded farm."
	]
	quest.C2000000000A01E6.title: "Sponge"
	quest.C2000000000B01E7.quest_desc: [
		"Links every drawer on the pad into one searchable network."
	]
	quest.C2000000000B01E7.title: "Storage Controller"
	quest.C2000000000B01E8.quest_desc: [
		"A barrel that upgrades: filters, hoppers, magnets, void."
	]
	quest.C2000000000B01E8.title: "Copper Barrel"
	quest.C2000000000B01E9.quest_desc: [
		"More slots, more upgrade rows."
	]
	quest.C2000000000B01E9.title: "Iron Barrel"
	quest.C2000000000B01EA.quest_desc: [
		"Pull dropped items straight into the barrel from across the pad."
	]
	quest.C2000000000B01EA.title: "Stack Upgrade"
	quest.C2000000000B01EB.quest_desc: [
		"In one side, out the other, no hopper block needed."
	]
	quest.C2000000000B01EB.title: "Hopper Upgrade"
	quest.C2000000000B01EC.quest_desc: [
		"Deletes anything past capacity so the drawer never jams."
	]
	quest.C2000000000B01EC.title: "Void Upgrade"
	quest.C2000000000B01ED.quest_desc: [
		"Sucks nearby drops straight into the backpack as you walk."
	]
	quest.C2000000000B01ED.title: "Pickup Upgrade"
	quest.C2000000000B01EE.quest_desc: [
		"One slot, sorted and visible. The simplest way to store bulk items."
	]
	quest.C2000000000B01EE.title: "Oak Drawer 1x1"
	quest.C2000000000B01EF.quest_desc: [
		"Two slots side by side for keeping similar items apart."
	]
	quest.C2000000000B01EF.title: "Oak Drawer 1x2"
	quest.C2000000000B01F0.quest_desc: [
		"Four slots in one frame. Dense storage for a small footprint."
	]
	quest.C2000000000B01F0.title: "Oak Drawer 2x2"
	quest.C2000000000B01F1.quest_desc: [
		"Automatically compacts what it holds into blocks as it fills."
	]
	quest.C2000000000B01F1.title: "Compacting Drawer"
	quest.C2000000000B01F2.quest_desc: [
		"Links every drawer on the pad into one searchable network."
	]
	quest.C2000000000B01F2.title: "Storage Controller (Storage)"
	quest.C2000000000B01F3.quest_desc: [
		"Pulls nearby item drops straight into the drawer."
	]
	quest.C2000000000B01F3.title: "Collector Upgrade"
	quest.C2000000000B01F4.quest_desc: [
		"Pulls items out of the chest or machine set beside it."
	]
	quest.C2000000000B01F4.title: "Puller Upgrade"
	quest.C2000000000B01F5.quest_desc: [
		"Pushes stored items into whatever inventory sits next to it."
	]
	quest.C2000000000B01F5.title: "Pusher Upgrade"
	quest.C2000000000B01F6.quest_desc: [
		"Deletes anything past capacity so the drawer never jams."
	]
	quest.C2000000000B01F6.title: "Void Upgrade (Storage)"
	quest.C2000000000B01F7.quest_desc: [
		"A portable inventory that frees up hotbar and pocket space."
	]
	quest.C2000000000B01F7.title: "Backpack"
	quest.C2000000000B01F8.quest_desc: [
		"More slots than the plain backpack, and a slot to upgrade it."
	]
	quest.C2000000000B01F8.title: "Iron Backpack"
	quest.C2000000000B01F9.quest_desc: [
		"Roomier still, with slots left over for useful upgrades."
	]
	quest.C2000000000B01F9.title: "Gold Backpack"
	quest.C2000000000B01FA.quest_desc: [
		"The deepest pockets before enchanting takes the storage further still."
	]
	quest.C2000000000B01FA.title: "Diamond Backpack"
	quest.C2000000000B01FB.quest_desc: [
		"Sucks nearby drops straight into the backpack as you walk."
	]
	quest.C2000000000B01FB.title: "Pickup Upgrade (Storage)"
	quest.C2000000000B01FC.quest_desc: [
		"Filter what enters packs."
	]
	quest.C2000000000B01FC.title: "Filter Upgrade"
	quest.C2000000000B01FD.quest_desc: [
		"Lets the backpack craft from whatever it already has stored."
	]
	quest.C2000000000B01FD.title: "Crafting Upgrade"
	quest.C2000000000B01FE.quest_desc: [
		"Feeds you automatically from its stores when hunger runs low."
	]
	quest.C2000000000B01FE.title: "Feeding Upgrade"
	quest.C2000000000B01FF.quest_desc: [
		"Swaps a broken tool for a fresh one from the pack."
	]
	quest.C2000000000B01FF.title: "Restock Upgrade"
	quest.C2000000000B0200.quest_desc: [
		"Empties the backpack into nearby chests when you get close."
	]
	quest.C2000000000B0200.title: "Deposit Upgrade"
	quest.C2000000000B0201.quest_desc: [
		"Adds a fluid tank inside the backpack for hauling liquids."
	]
	quest.C2000000000B0201.title: "Tank Upgrade"
	quest.C2000000000C0202.quest_desc: [
		"The backbone metal behind most machines and casings on this line."
	]
	quest.C2000000000C0202.title: "Steel Ingot"
	quest.C2000000000C0203.quest_desc: [
		"The core metal behind most cables, tanks, and early machines."
	]
	quest.C2000000000C0203.title: "Osmium Ingot"
	quest.C2000000000C0204.quest_desc: [
		"A hard alloy pressed from obsidian dust for tougher gear."
	]
	quest.C2000000000C0204.title: "Refined Obsidian"
	quest.C2000000000C0205.quest_desc: [
		"The simplest logic board. Most early machines need a few."
	]
	quest.C2000000000C0205.title: "Basic Control Circuit"
	quest.C2000000000C0206.quest_desc: [
		"A sharper logic board for the machines a step up the line."
	]
	quest.C2000000000C0206.title: "Advanced Control Circuit"
	quest.C2000000000C0207.quest_desc: [
		"The sharpest logic board, reserved for the line's top machines."
	]
	quest.C2000000000C0207.title: "Elite Control Circuit"
	quest.C2000000000C0208.quest_desc: [
		"Infuses metals with carbon, redstone, or diamond dust before smelting."
	]
	quest.C2000000000C0208.title: "Metallurgic Infuser"
	quest.C2000000000C0209.quest_desc: [
		"Doubles most raw ores into two dusts instead of one."
	]
	quest.C2000000000C0209.title: "Enrichment Chamber"
	quest.C2000000000C020A.quest_desc: [
		"Mill or crush bulk materials."
	]
	quest.C2000000000C020A.title: "Crusher"
	quest.C2000000000C020B.quest_desc: [
		"Smelts ores on power instead of fuel, and a little faster too."
	]
	quest.C2000000000C020B.title: "Energized Smelter"
	quest.C2000000000C020C.quest_desc: [
		"Purifies enriched ore with oxygen for a third output, sometimes more."
	]
	quest.C2000000000C020C.title: "Purification Chamber"
	quest.C2000000000C020D.quest_desc: [
		"Injects gas into ore for the richest output the line offers."
	]
	quest.C2000000000C020D.title: "Chemical Injection"
	quest.C2000000000C020E.quest_desc: [
		"Compresses osmium dust into ingots faster than a furnace alone."
	]
	quest.C2000000000C020E.title: "Osmium Compressor"
	quest.C2000000000C020F.quest_desc: [
		"A single stack slot that holds far more than a chest can."
	]
	quest.C2000000000C020F.title: "Basic Bin"
	quest.C2000000000C0210.quest_desc: [
		"Stores a deep pool of one fluid in a single block."
	]
	quest.C2000000000C0210.title: "Basic Fluid Tank"
	quest.C2000000000C0211.quest_desc: [
		"Buffers power between machines so surges don't stall the line."
	]
	quest.C2000000000C0211.title: "Basic Energy Cube"
	quest.C2000000000C0212.quest_desc: [
		"Carries power to machines. The most common cable on the pad."
	]
	quest.C2000000000C0212.title: "Basic Universal Cable"
	quest.C2000000000C0213.quest_desc: [
		"Moves fluids between tanks and machines along the pad."
	]
	quest.C2000000000C0213.title: "Basic Mechanical Pipe"
	quest.C2000000000C0214.quest_desc: [
		"Moves items automatically between connected inventories."
	]
	quest.C2000000000C0214.title: "Basic Logistical Transporter"
	quest.C2000000000C0215.quest_desc: [
		"Rotates, wrenches, and reconfigures machine faces with one tool."
	]
	quest.C2000000000C0215.title: "Configurator"
	quest.C2000000000C0216.quest_desc: [
		"Mek jetpack \u2014 optional lift."
	]
	quest.C2000000000C0216.title: "Jetpack"
	quest.C2000000000C0217.quest_desc: [
		"Softens fall damage and buys a second before the void claims you."
	]
	quest.C2000000000C0217.title: "Free Runners"
