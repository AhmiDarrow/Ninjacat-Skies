	quest.42000000002004FE.title: "Energized Smelter (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Cuts wood with Mekanism's own precision blade.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FF.title: "Precision Sawmill"
	quest.4200000000200500.quest_desc: [
		"Splits water into its two component gases.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200500.title: "Electrolytic Sep"
	quest.4200000000200501.quest_desc: [
		"Combines two chemicals into a new one.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200501.title: "Chemical Infuser"
	quest.4200000000200502.quest_desc: [
		"Purify fluids or ores.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200502.title: "Purification"
	quest.4200000000200503.quest_desc: [
		"Injects a chemical into ore for extra yield.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200503.title: "Chem Injection"
	quest.4200000000200504.quest_desc: [
		"Compresses osmium onto items for tougher gear.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200504.title: "Osmium Compressor (QIO)"
	quest.4200000000200505.quest_desc: [
		"Combines several components into one finished piece.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200505.title: "Combiner"
	quest.4200000000210506.quest_desc: [
		"Zombies drop it whether you want it or not.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines, progression tokens or extra lives hide inside.",
		"How: kill zombies on the pad at night, or a dark hole."
