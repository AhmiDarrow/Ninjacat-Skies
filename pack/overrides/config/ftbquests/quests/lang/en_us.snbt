	quest.4200000000220530.quest_desc: [
		"Shard of old tribe song — needs a Chime.",
		"How: Echo Attune line / Unweave. Spark quest names it."
	]
	quest.4200000000220530.title: "Spirit Shard"
	quest.4200000000220531.quest_desc: [
		"Tune metal to spirit — copper around a Chime.",
		"How: copper + echo bits. Spark ladder."
	]
	quest.4200000000220531.title: "Copper Resonator"
	quest.4200000000220532.quest_desc: [
		"Mark the lattice lines — chalk needs a Shard.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220532.title: "Ritual Chalk (Tribal)"
	quest.4200000000220533.quest_desc: [
		"Place the heart — Chime + Shard + leather (Desk sells leather). A rising edge 17 to 23 ticks after the last is 24 Pulse; anything else 10; nothing closer than 8 ticks counts. A one-second clock is a buff; a fast spam clock is a nerf.",
		"How: Chime + Shard + leather. Strike empty-handed on tempo (17–23 ticks) for 24 Pulse."
	]
	quest.4200000000220533.title: "Drumheart Beat"
	quest.4200000000220534.quest_desc: [
		"Nine tribes hummed once — needs a spare Chime + Shard.",
		"How: craft or Spark/Tribal Weave reward. Right-click: how the lattice works."
	]
	quest.4200000000220534.title: "Spirit Codex"
	quest.4200000000220535.quest_desc: [
		"Draw ley into beats.",
		"How: place under sky near water/green. Slow Pulse. Spark ladder."
	]
