	quest.C2000000000F0251.quest_desc: [
		"Shield ready for banners."
	]
	quest.C2000000000F0251.title: "Shield Banner Ready"
	quest.C2000000000F0252.quest_desc: [
		"Set these off when a Strand finally comes back together."
