	quest.C200000000170333.title: "Ender Pearl Stock"
	quest.C200000000170334.quest_desc: [
		"Eyes of Ender stock."
	]
	quest.C200000000170334.title: "Eye of Ender Stock"
	quest.C200000000170335.quest_desc: [
		"Dragon breath for potions."
	]
	quest.C200000000170335.title: "Dragon Breath Stock"
