	quest.C20000000006011C.quest_desc: [
		"Marks the fluid-handling side of a build, andesite's fancier cousin."
	]
	quest.C20000000006011C.title: "Copper Casing"
	quest.C20000000006011D.quest_desc: [
		"Covers the precise machines, the ones rotation alone can't satisfy."
	]
	quest.C20000000006011D.title: "Brass Casing"
	quest.C20000000006011E.quest_desc: [
		"Clockwork heart. Wants a Binding Knot at its centre.",
		"The Loom, asking to be included."
	]
	quest.C20000000006011E.title: "Precision Mechanism"
	quest.C20000000006011F.quest_desc: [
		"Control rotation speed."
	]
	quest.C20000000006011F.title: "Rotation Speed Controller"
	quest.C200000000060120.quest_desc: [
		"Turn the corner."
	]
	quest.C200000000060120.title: "Gearbox"
	quest.C200000000060121.quest_desc: [
		"Clutch stops a shaft line."
	]
	quest.C200000000060121.title: "Clutch"
	quest.C200000000060122.quest_desc: [
		"Gearshift flips rotation."
	]
	quest.C200000000060122.title: "Gearshift"
	quest.C200000000060123.quest_desc: [
		"Programmed spin. The pattern-weavers' song, written down."
	]
	quest.C200000000060123.title: "Sequenced Gearshift"
	quest.C200000000060124.quest_desc: [
		"Mixes ingredients in a basin when spun fast enough."
