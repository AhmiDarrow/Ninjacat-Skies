		"Threshold for spirit traffic."
	]
	quest.C200000000220550.title: "Spirit Door"
	quest.C200000000220551.quest_desc: [
		"Tool that spends Pulse."
	]
	quest.C200000000220551.title: "Spiritgear Pick"
	quest.C200000000220552.quest_desc: [
		"Edge that spends Pulse."
	]
	quest.C200000000220552.title: "Spiritgear Blade"
	quest.C200000000220553.quest_desc: [
		"Stone from the March, underfoot in a place that shouldn't exist."
	]
	quest.C200000000220553.title: "March Stone (Tribal)"
	quest.C200000000220554.quest_desc: [
		"Rubble from the March, plain but plentiful."
	]
	quest.C200000000220554.title: "March Cobble"
	quest.C200000000220555.quest_desc: [
		"Wood grown somewhere the sun doesn't reach."
	]
	quest.C200000000220555.title: "March Log"
	quest.C200000000220556.quest_desc: [
		"Sawn timber from the March, sturdy despite where it came from."
	]
	quest.C200000000220556.title: "March Planks"
	quest.C200000000220557.quest_desc: [
		"Leaves that murmur even without any wind."
	]
	quest.C200000000220557.title: "March Leaf"
	quest.C200000000220558.quest_desc: [
		"A reed that hums with leftover Spirit Pulse."
	]
	quest.C200000000220558.title: "Spirit Reed (Tribal)"
	quest.C200000000230559.quest_desc: [
		"Grit-singers never cut a stone the same way twice. This bench remembers every cut."
	]
	quest.C200000000230559.title: "Mason Table"
	quest.C20000000023055A.quest_desc: [
		"The same trick for wood \u2014 a hundred planks from one."
	]
	quest.C20000000023055A.title: "Carpenter's Table"
	quest.C20000000023055B.quest_desc: [
		"Sand into glass, then glass into every shape the light will take."
	]
	quest.C20000000023055B.title: "Glassblower"
	quest.C20000000023055C.quest_desc: [
		"Wool and cloth, rewoven \u2014 fitting, for a pad that is mending a loom."
	]
	quest.C20000000023055C.title: "Loom Table"
	quest.C20000000023055D.quest_desc: [
		"Leaves, saplings, and growing things, sorted into their variations."
	]
	quest.C20000000023055D.title: "Botanist Workbench"
	quest.C20000000023055E.quest_desc: [
		"Coloured blocks and stranger stone. Pick a variant; the bench holds the rest."
	]
	quest.C20000000023055E.title: "Alchemy Bench"
	quest.C20000000023055F.quest_desc: [
		"Metal and machine-facing blocks, cut to taste."
	]
	quest.C20000000023055F.title: "Tinkering Table"
	quest.C200000000230560.quest_desc: [
		"Feed a block into the Mason Table and choose from the wall of variants."
	]
	quest.C200000000230560.title: "A Cut of Stone"
	quest.C200000000230561.quest_desc: [
		"The Carpenter's Table does the same for wood."
	]
	quest.C200000000230561.title: "A Cut of Planks"
	quest.C200000000230562.quest_desc: [
		"Every pane the Glassblower knows starts here."
	]
	quest.C200000000230562.title: "A Cut of Glass"
	quest.C200000000230563.quest_desc: [
		"Grit-singers' favourite stone to argue over."
	]
	quest.C200000000230563.title: "Deepslate Variety"
	quest.C200000000230564.quest_desc: [
		"Fired clay, a hundred ways."
	]
	quest.C200000000230564.title: "Bricks Variety"
	quest.C200000000230565.quest_desc: [
		"Pad grit, cut fine."
	]
	quest.C200000000230565.title: "Sandstone Variety"
	quest.C200000000240566.quest_desc: [
		"The first thing that turns a pad into a place someone lives."
	]
	quest.C200000000240566.title: "A Chair"
	quest.C200000000240567.quest_desc: [
		"Somewhere to put the Codex down while you think."
	]
	quest.C200000000240567.title: "A Table"
	quest.C200000000240568.quest_desc: [
		"Room for a Clowder to sit while the barrel works."
	]
	quest.C200000000240568.title: "A Bench"
	quest.C200000000240569.quest_desc: [
		"For the Codex Pages you keep meaning to reread."
	]
	quest.C200000000240569.title: "A Shelf"
	quest.C20000000024056A.quest_desc: [
		"Handcrafted storage that looks like it belongs."
	]
	quest.C20000000024056A.title: "A Cupboard"
	quest.C20000000024056B.quest_desc: [
		"The Pad-keepers slept well. So should you."
	]
	quest.C20000000024056B.title: "A Fancy Bed"
	quest.C20000000024056C.quest_desc: [
		"A lantern, a page, a place for both."
	]
	quest.C20000000024056C.title: "A Nightstand"
	quest.C20000000024056D.quest_desc: [
		"Cut a frame, then dress it in any block. One shape, every skin."
	]
	quest.C20000000024056D.title: "Framing Saw"
	quest.C20000000024056E.quest_desc: [
		"A blank cube waiting for a camouflage block."
	]
	quest.C20000000024056E.title: "Framed Cube"
	quest.C20000000024056F.quest_desc: [
		"Half a frame; twice the options."
	]
	quest.C20000000024056F.title: "Framed Slab"
	quest.C200000000240570.quest_desc: [
		"Steps that wear whatever wall they sit in."
	]
	quest.C200000000240570.title: "Framed Stairs"
	quest.C200000000240571.quest_desc: [
		"For roofs and rooflines the void never gave you."
	]
	quest.C200000000240571.title: "Framed Slope"
	quest.C200000000240572.quest_desc: [
		"Edge-walkers spanned the void with less. Reach the next pad in style."
	]
	quest.C200000000240572.title: "Rope Bridge"
	quest.C200000000240573.quest_desc: [
		"A roof over the pad. The rain up here is only ever ambition."
	]
	quest.C200000000240573.title: "Attic Roof"
	quest.C200000000240574.quest_desc: [
		"Comfort is infrastructure too."
	]
	quest.C200000000240574.title: "Couch"
	quest.C200000000240575.quest_desc: [
		"A kitchen edge for the Farmer's Delight line."
	]
	quest.C200000000240575.title: "Counter"
	quest.C200000000240576.quest_desc: [
		"Where the Whisker Codex gets its margins."
	]
	quest.C200000000240576.title: "Desk"
	quest.C200000000240577.quest_desc: [
		"Small storage that matches the table."
	]
	quest.C200000000240577.title: "Drawer"
	quest.C200000000240578.quest_desc: [
		"A threshold that hides in the wall."
	]
	quest.C200000000240578.title: "Framed Door"
	quest.C200000000240579.quest_desc: [
		"Thin cover; full disguise."
	]
	quest.C200000000240579.title: "Framed Panel"
	quest.C20000000024057A.quest_desc: [
		"An edge rail you can dress to taste."
	]
	quest.C20000000024057A.title: "Framed Fence"
	quest.C20000000024057B.quest_desc: [
		"Grey and honest, like the grit it came from."
	]
	quest.C20000000024057B.title: "Andesite Bridge"
	quest.C20000000025057C.quest_desc: [
		"A wall light that is not a torch stuck in shame. The stewards had standards."
	]
	quest.C20000000025057C.title: "Sconce"
	quest.C20000000025057D.quest_desc: [
		"Sand, falling. The only honest clock before the Clock Strand."
	]
	quest.C20000000025057D.title: "Hourglass"
	quest.C20000000025057E.quest_desc: [
		"Drip a fluid out of a block. Small; oddly satisfying."
	]
	quest.C20000000025057E.title: "Faucet"
	quest.C20000000025057F.quest_desc: [
		"Turn it by hand. The Drumhearts started somewhere too."
	]
	quest.C20000000025057F.title: "Crank"
	quest.C200000000250580.quest_desc: [
		"Show a thing off. A token, a page, a trophy."
	]
	quest.C200000000250580.title: "Item Shelf"
	quest.C200000000250581.quest_desc: [
		"A bag that holds bags. Recover's clutter, tidied."
	]
	quest.C200000000250581.title: "Sack"
	quest.C200000000250582.quest_desc: [
		"Lock the Frayed Thread away from your own worse ideas."
	]
	quest.C200000000250582.title: "Safe"
	quest.C200000000250583.quest_desc: [
		"Pin a page where the whole Clowder reads it."
	]
	quest.C200000000250583.title: "Notice Board"
	quest.C200000000250584.quest_desc: [
		"A pot with ambitions. Grow a little where the pad is thin."
	]
	quest.C200000000250584.title: "Planter"
	quest.C200000000250585.quest_desc: [
		"Raise the Spindle Loom Fragment where it can be admired."
	]
	quest.C200000000250585.title: "Pedestal"
	quest.C200000000250586.quest_desc: [
		"Store cookies, bees, or the small dignity of order."
	]
	quest.C200000000250586.title: "Jar (37)"
	quest.C200000000250587.quest_desc: [
		"Set a spawn without hauling a whole bed up the ladder."
	]
	quest.C200000000250587.title: "Sleeping Bag"
	quest.C200000000250588.quest_desc: [
		"Sleep through the day so the mobs meet a rested Skybound."
	]
	quest.C200000000250588.title: "Hammock"
	quest.C200000000250589.quest_desc: [
		"Hang the hammock between two posts, over the drop, and dare it."
	]
	quest.C200000000250589.title: "Rope and Nail"
	quest.C20000000025058A.quest_desc: [
		"A steadier flame for the pad's long nights."
	]
	quest.C20000000025058A.title: "Candle Holder"
	quest.C20000000025058B.quest_desc: [
		"Climb, hang, or bridge. Edge-walkers swore by it."
	]
	quest.C20000000025058B.title: "Rope (37)"
	quest.C20000000025058C.quest_desc: [
		"Raise and lower the rope on a redstone whim."
	]
	quest.C20000000025058C.title: "Pulley Block"
	quest.C20000000025058D.quest_desc: [
		"Fall onto it and the void forgets to punish you."
	]
	quest.C20000000025058D.title: "Feather Block"
	quest.C20000000025058E.quest_desc: [
		"Chalk a plan the whole Clowder can argue with."
	]
	quest.C20000000025058E.title: "Blackboard"
	quest.C20000000025058F.quest_desc: [
		"Carry a small thing that would rather you didn't."
	]
	quest.C20000000025058F.title: "Cage"
	quest.C200000000260590.quest_desc: [
		"The first wire. The pulse the Drumhearts kept now has somewhere to go."
	]
	quest.C200000000260590.title: "Copper Wire"
	quest.C200000000260591.quest_desc: [
		"Rotation on one side, Forge Energy on the other. Two Strands shaking hands."
	]
	quest.C200000000260591.title: "Connector"
	quest.C200000000260592.quest_desc: [
		"Energy back into rotation. The Clock Strand runs on the Spark Strand now."
	]
	quest.C200000000260592.title: "Electric Motor"
	quest.C200000000260593.quest_desc: [
		"Hold a charge between the wire and the work."
	]
	quest.C200000000260593.title: "Capacitor"
	quest.C200000000260594.quest_desc: [
		"A wall of stored current, built as big as the pad allows."
	]
	quest.C200000000260594.title: "Modular Accumulator"
	quest.C200000000260595.quest_desc: [
		"Rods and wire from ingots \u2014 Create's answer to the press."
	]
	quest.C200000000260595.title: "Rolling Mill"
	quest.C200000000260596.quest_desc: [
		"Enchant without the table's superstition. Feed it experience, get intent."
	]
	quest.C200000000260596.title: "Blaze Enchanter"
	quest.C200000000260597.quest_desc: [
		"Liquid practice, carried. The stewards would have found this vulgar and useful."
	]
	quest.C200000000260597.title: "Experience Bucket"
	quest.C200000000260598.quest_desc: [
		"Copy a book, a plan, a page. The Codex approves, quietly."
	]
	quest.C200000000260598.title: "Printer"
	quest.C200000000260599.quest_desc: [
		"Lava and heat into power. A bridge, not the Hum itself."
	]
	quest.C200000000260599.title: "Heat Generator"
	quest.C20000000026059A.quest_desc: [
		"On a pad that is all sky, the sun is the one resource nobody rations."
	]
	quest.C20000000026059A.title: "Solar Generator"
	quest.C20000000026059B.quest_desc: [
		"The higher the pad, the harder it turns. Build tall."
	]
	quest.C20000000026059B.title: "Wind Generator"
	quest.C20000000026059C.quest_desc: [
		"Burn the Sprout Strand's surplus. Nothing on a pad is waste."
	]
	quest.C20000000026059C.title: "Bio Generator"
	quest.C20000000026059D.quest_desc: [
		"Late power for a Clowder that went deep on Mekanism."
	]
	quest.C20000000026059D.title: "Gas-Burning Generator"
	quest.C20000000026059E.quest_desc: [
		"The digital loom, in your pocket. Reweave from anywhere on the pad."
	]
	quest.C20000000026059E.title: "Wireless Terminal (38)"
	quest.C20000000026059F.quest_desc: [
		"Mekanism's chemicals, stored in the AE2 network. Two late pillars, braided."
	]
	quest.C20000000026059F.title: "Chemical Cell"
	quest.C2000000002605A0.quest_desc: [
		"For when the copper wire cannot carry the whole pulse."
	]
	quest.C2000000002605A0.title: "Large Connector"
	quest.C2000000002605A1.quest_desc: [
		"A cake that levels you. Do not tell the Kitchen line."
	]
	quest.C2000000002605A1.title: "Experience Cake"
	quest.C2000000002605A2.quest_desc: [
		"A bigger bite of the same free sky."
	]
	quest.C2000000002605A2.title: "Advanced Solar"
	quest.C2000000002605A3.quest_desc: [
		"The shell every chemical cell needs."
	]
	quest.C2000000002605A3.title: "Chemical Housing"
	quest.C2000000002605A4.quest_desc: [
		"Carry a measure of gas off the network."
	]
	quest.C2000000002605A4.title: "Portable Chemical Cell"
}
