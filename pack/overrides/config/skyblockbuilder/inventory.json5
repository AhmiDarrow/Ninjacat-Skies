{
  // Wipe other mods' free guide books on first join so kits stay intentional.
  // Silent Gear's Blueprint Package is one of those gifts; kubejs silentgear.js crafts it from four Blueprint Paper.
  "clearInitialInventory": true,

  "dropItems": true,

  // Give the global starter inventory when a player joins a team (island create).
  // Per-difficulty kits live in island chests — this file is shared across templates.
  "initialInventoryType": "team"
}
