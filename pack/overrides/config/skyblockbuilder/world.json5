{
  // Void overworld biomes: deny oceans / mushroom so land animals can spawn on islands.
  "biomes": {
    "minecraft:overworld": {
      "allow_list": false,
      "elements": [
        "minecraft:*ocean*",
        "minecraft:mushroom_fields"
      ]
    },
    "minecraft:the_nether": {
      "allow_list": false,
      "elements": []
    }
  },

  "carvers": {
    "minecraft:overworld": {
      "allow_list": true,
      "elements": []
    },
    "minecraft:the_nether": {
      "allow_list": true,
      "elements": []
    },
    "minecraft:the_end": {
      "allow_list": true,
      "elements": []
    }
  },

  // Multiplayer spacing — islands stay far apart on the void grid.
  "islandDistance": 4096,

  "leaveToOverworld": false,

  "preventScheduledTicks": true,

  "seaHeight": 63,

  // True void — no flat surface under islands.
  "surface": false,

  "surfaceSettings": {
    "minecraft:overworld": [],
    "minecraft:the_nether": [],
    "minecraft:the_end": []
  }
}
